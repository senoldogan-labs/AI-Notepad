<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AINotepadAccountScopedData</key>
	<true/>
	<key>AINotepadDataFolderName</key>
	<string>$(HOSTED_DATA_FOLDER_NAME)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.senoldogan.AINotepad.hosted.process.*</string>
		<string>com.senoldogan.AINotepad.hosted.resume</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.senoldogan.AINotepad.hosted.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gistsmith</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>HostedAPIBase</key>
	<string>$(HOSTED_API_BASE)</string>
	<key>HostedKeychainService</key>
	<string>$(HOSTED_KEYCHAIN_SERVICE)</string>
	<key>HostedSiteBase</key>
	<string>$(HOSTED_SITE_BASE)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Gistsmith sıradaki toplantılarını gösterir ve kaydı süren toplantının adı ve katılımcılarıyla kaydeder.</string>
	<key>NSCameraUsageDescription</key>
	<string>Gistsmith toplantıya tahtanın, slaytın ya da bir krokinin fotoğrafını eklemek için kamerayı kullanır.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Gistsmith · Made by Senol Dogan</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Gistsmith toplantı notundaki görevleri istediğinde Anımsatıcılar'a ekler.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>UIAppFonts</key>
	<array>
		<string>InterVariable.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>record.circle</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Kaydı başlat</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.senoldogan.AINotepad.hosted.record</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>lifepreserver</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Gistsmith'i silmeden önce</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Desteğe yaz</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.senoldogan.AINotepad.hosted.support</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>trash</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Başarısız yerel kayıtları sil</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Depolamayı temizle</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.senoldogan.AINotepad.hosted.clearStorage</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
</dict>
</plist>
