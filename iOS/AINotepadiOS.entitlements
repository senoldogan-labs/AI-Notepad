<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Evrensel bağlantılar: https://gistsmith.com/m/<kimlik> ve /open/<yol> uygulamada açılır. Site dosyası
	     web/public/.well-known/apple-app-site-association; ayrıştırıcı Packages/AINotepadCore/.../Meeting/AppLinks.swift. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gistsmith.com</string>
	</array>
	<!-- Gistsmith Klavye'yle paylaşılan klasör (sesle yazma devri, klavye ayarları, isteğe bağlı toplantı listesi). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.senoldogan.AINotepad.hosted</string>
	</array>
</dict>
</plist>
