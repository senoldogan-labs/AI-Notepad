---
// Bir rakiple karşılaştırma sayfası (/vs/granola, /vs/otter, /vs/fireflies, /vs/poffle): gezinti izi (JSON-LD), giriş ve
// kaynak satırı, ürünü seçmek için nedenler (vurgulu), yan yana tablo (ilk sütun bizim), "kim hangisini seçmeli" (önce
// bizim kutu), bizim güçlü yanlarımızın altında kısa "rakibin güçlü olduğu yerler" ve indirme çağrısı. Metinler ve değerler copy.ts `compare`'den.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import ComparisonTable from "./ComparisonTable.astro";
import CtaBand from "./CtaBand.astro";
import Icon from "./Icon.astro";
import WhyUs from "./WhyUs.astro";
import { productName } from "../config";
import { copy, type CompareCopy, type Competitor, type CompetitorCopy, type ComparisonTopic, type PickCopy } from "../copy";
import { infoPageStructuredData, structuredDataJson } from "../lib/structured-data";
import { type PageKey, pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

interface Props {
  readonly page: PageKey;
  readonly competitor: Competitor;
}
const { page, competitor } = Astro.props;
const text: CompareCopy = copy.compare;
const them: CompetitorCopy = text.competitors[competitor];
const topics: readonly ComparisonTopic[] = Object.keys(text.topics) as ComparisonTopic[];
const picks: readonly PickCopy[] = [them.pickUs, them.pickCompetitor];
/** Kaynak bağlantısının metni: alan adı (www'suz) ve yol, ör. granola.ai/pricing; kök adreste yalnızca alan adı (poffle.app). */
const pricingAddress: URL = new URL(them.pricingUrl);
const sourceLabel: string = `${pricingAddress.host.replace(/^www\./, "")}${pricingAddress.pathname.replace(/^\/$/, "")}`;
/** Gezinti izi: ana sayfa › karşılaştırma › bu sayfa (JSON-LD). */
const structuredData: string = structuredDataJson(
  infoPageStructuredData(
    siteConfig,
    [
      { name: text.eyebrow, url: pageUrl("compare", siteConfig.siteOrigin) },
      { name: them.title, url: pageUrl(page, siteConfig.siteOrigin) },
    ],
    [],
  ),
);
---

<Base page={page} meta={them.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="page narrow-intro">
    <a class="back-link" href={routes.compare}><Icon name="arrow-right" size={14} class="back-link__arrow" />{text.eyebrow}</a>
    <h1 class="title-xl">{them.title}</h1>
    <p class="lead">{them.lead}</p>
    <p class="small muted vs-source">
      {text.checked}
      <span>
        {text.source}: <a href={them.pricingUrl} rel="noopener">{sourceLabel}</a>
      </span>
    </p>
  </section>

  <WhyUs id="vs-why-title" />

  <section class="page vs-section" aria-labelledby="vs-table-title">
    <h2 class="title-l" id="vs-table-title">{text.tableTitle}</h2>
    <ComparisonTable
      caption={them.title}
      topics={topics}
      columns={[
        { name: productName, values: text.us },
        { name: them.name, values: them.values },
      ]}
    />
    <p class="small muted">{text.missingNote}</p>
  </section>

  <section class="page vs-section" aria-labelledby="vs-pick-title">
    <h2 class="title-l" id="vs-pick-title">{text.pickTitle}</h2>
    <div class="vs-picks">
      {
        picks.map((pick: PickCopy, index: number) => (
          <article class:list={["card vs-pick", { "vs-pick--us": index === 0 }]}>
            <h3 class="title-m">{pick.title}</h3>
            <ul>
              {pick.points.map((point: string) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="page vs-section vs-section--compact" aria-labelledby="vs-strengths-title">
    <h2 class="vs-strengths__title" id="vs-strengths-title">{them.strengthsTitle}</h2>
    <ul class="vs-strengths small">
      {
        them.strengths.map((item: string) => (
          <li>
            <Icon name="check" size={14} class="vs-strengths__check" />
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand id="vs-cta-title" title={text.ctaTitle} text={text.ctaText} photo="red-mountain" />

  <p class="page small muted vs-trademarks">{text.trademarks}</p>
</Base>

<style>
  .narrow-intro {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-block: clamp(48px, 8vw, 96px) clamp(24px, 4vw, 40px);
  }

  /* Breadcrumb back to the comparison overview (the arrow points left). */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .back-link :global(.back-link__arrow) {
    transform: scaleX(-1);
  }

  .vs-source {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .vs-source a {
    overflow-wrap: anywhere;
  }

  .vs-section {
    display: grid;
    gap: 20px;
    margin-top: clamp(56px, 8vw, 104px);
  }

  .vs-section--compact {
    gap: 12px;
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--line);
  }

  .vs-strengths__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .vs-strengths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .vs-strengths li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .vs-strengths :global(.vs-strengths__check) {
    flex: none;
    transform: translateY(2px);
    color: var(--muted);
  }

  .vs-picks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .vs-pick {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  /* Bizim kutu önce ve vurgulu (karşılaştırma tablosundaki bizim sütunla aynı vurgu). */
  .vs-pick--us {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    background: color-mix(in srgb, var(--accent) 7%, var(--card));
  }

  .vs-pick.vs-pick--us ul {
    color: var(--ink);
  }

  .vs-pick ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
    color: var(--muted);
  }

  .vs-trademarks {
    margin-top: 32px;
  }

  @media (max-width: 760px) {
    .vs-strengths,
    .vs-picks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
