---
// The product film on the home page: a heading and one line beside the video, which stands like a product shot (no
// player chrome, muted, looping). It plays when it scrolls into view and stops when it leaves; with reduced motion only
// the poster shows (src/client/launch-video.ts). It loads only when it plays (preload="none"); the size is reserved, so
// nothing shifts. The film is English, so only the English home page shows it.
// Source: promo/film (Remotion), rendered at 1920×1080; the site copy is re-encoded without the sound track
// (`ffmpeg -i gistsmith-promo-final.mp4 -an -c:v libx264 -preset slow -crf 25 -pix_fmt yuv420p -movflags +faststart`).
// The poster is the end card at 33.5 s (`ffmpeg -ss 33.5 -frames:v 1 -q:v 2`).
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import type { HomeCopy } from "../copy";
import filmPoster from "../assets/video/film-poster.jpg";

interface Props {
  readonly text: HomeCopy["launchVideo"];
}
const { text } = Astro.props;
const filmSrc: string = "/video/gistsmith-film-1080p.mp4";
---

<section class="page film-section" aria-labelledby="film-title">
  <div class="film-section__text">
    <h2 class="title-l reveal" id="film-title">{text.title}</h2>
    <p class="film-section__lead reveal">{text.lead}</p>
  </div>
  <div class="film-section__frame">
    <Picture
      src={filmPoster}
      alt=""
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1920]}
      sizes="(max-width: 860px) calc(100vw - 40px), 760px"
      quality={70}
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: "film-section__poster" }}
    />
    <video
      id="launch-video"
      class="film-section__video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      width="1920"
      height="1080"
      aria-label={text.description}
    >
      <source src={filmSrc} type="video/mp4" />
      <p>
        {text.fallback} <a href={filmSrc}>{text.fallbackLink}</a>
      </p>
    </video>
    <button
      id="launch-video-toggle"
      class="film-section__toggle"
      type="button"
      hidden
      aria-controls="launch-video"
      aria-label={text.pause}
      title={text.pause}
      data-label-pause={text.pause}
      data-label-play={text.play}
    >
      <Icon name="pause" size={16} class="film-section__pause" />
      <Icon name="play" size={15} class="film-section__play" />
    </button>
  </div>
</section>

<script>
  import "../client/launch-video";
</script>

<style>
  .film-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-top: clamp(64px, 9vw, 128px);
  }

  .film-section__text {
    display: grid;
    gap: 18px;
  }

  .film-section__lead {
    max-width: 30rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .film-section__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--soft);
    box-shadow: var(--shadow-window);
  }

  .film-section__poster,
  .film-section__poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .film-section__poster :global(img) {
    object-fit: cover;
  }

  /* No player chrome: clicks and taps do not reach the video (no picture-in-picture or play overlays either). */
  .film-section__video {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    pointer-events: none;
  }

  .film-section__video::-webkit-media-controls,
  .film-section__video::-webkit-media-controls-start-playback-button {
    display: none !important;
  }

  /* Pause/play: the film plays on its own while on screen, so it can always be stopped (WCAG 2.2.2). */
  .film-section__toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #0a0a0a;
    box-shadow: var(--shadow-chip);
    cursor: pointer;
  }

  .film-section__toggle[hidden] {
    display: none;
  }

  .film-section__toggle :global(.icon) {
    grid-area: 1 / 1;
  }

  .film-section__toggle :global(.film-section__play),
  .film-section__toggle[data-state="paused"] :global(.film-section__pause) {
    display: none;
  }

  .film-section__toggle[data-state="paused"] :global(.film-section__play) {
    display: block;
  }

  @media (max-width: 860px) {
    .film-section {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
