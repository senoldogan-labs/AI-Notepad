---
// Closing call on every page that sells (home, pricing, compare, blog posts, feature pages): one page-width card with
// a soft warm gradient, the horizon waveform, the serif title, one line and the two ways to get the app at the same
// height and weight on every device (GetApp.astro).
import GetApp from "./GetApp.astro";
import Horizon from "./Horizon.astro";
import type { CommonCopy } from "../copy";

interface Props {
  readonly id: string;
  readonly title: string;
  readonly text: string;
  /** Shared text (button, badge), English or Finnish. */
  readonly common: CommonCopy;
  /**
   * Where the Mac button goes: the counted DMG download (`macDownloadUrl`, on pages whose source the server allows) or
   * the download page. Only the direct download carries the device check (MacOnlyDialog.astro).
   */
  readonly macHref: string;
}
const { id, title, text, common, macHref } = Astro.props;
---

<section class="page closing" aria-labelledby={id}>
  <div class="closing__card">
    <Horizon seed={title} class="closing__horizon" />
    <h2 class="title-xl closing__title reveal" id={id}>{title}</h2>
    <p class="closing__text reveal">{text}</p>
    <GetApp common={common} macHref={macHref} size="large" class="closing__actions reveal" />
  </div>
</section>

<style>
  .closing {
    margin-top: clamp(64px, 9vw, 128px);
  }

  /* Paper with a warm light rising from the bottom edge; static (nothing blurred animates). */
  .closing__card {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding: clamp(56px, 7vw, 96px) clamp(24px, 6vw, 80px);
    border: 1px solid var(--line);
    border-radius: 24px;
    background:
      radial-gradient(90% 120% at 50% 120%, var(--closing-glow) 0%, transparent 70%),
      radial-gradient(60% 80% at 100% 0%, var(--closing-lilac) 0%, transparent 70%),
      var(--card);
    text-align: center;
    --closing-glow: light-dark(#f8d2bb, #3b2216);
    --closing-lilac: light-dark(#ece3f7, #231f2c);
  }

  .closing :global(.closing__horizon) {
    width: min(320px, 70%);
  }

  .closing :global(.closing__horizon)::before {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .closing__title {
    max-width: 16ch;
  }

  .closing__text {
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .closing :global(.closing__actions) {
    justify-content: center;
    margin-top: 6px;
  }
</style>
