---
// Closing download call on inner pages (compare, blog, MCP, languages, integrations), in the closing band: a
// photograph, a paper panel with the serif title, a short text, the download button and the App Store badge, and a
// second photograph. Below 860 px the panel sits under the first photograph and the second one is hidden.
// No direct DMG link: the download source (`?src=`) is on the server's allow-list.
import AppStoreBadge from "./AppStoreBadge.astro";
import Icon from "./Icon.astro";
import PhotoPanel from "./PhotoPanel.astro";
import { copy } from "../copy";
import { halfPhotoWidths, type PhotoName } from "../lib/photos";
import { routes } from "../routes";

interface Props {
  readonly id: string;
  readonly title: string;
  readonly text: string;
  readonly photo: PhotoName;
}
const { id, title, text, photo } = Astro.props;
/** The picture on the right: a soft wave landscape next to every photograph (and a pale dune next to a wave). */
const partner: PhotoName = photo.startsWith("wave-") ? "dune-pale" : "wave-dawn";
/** The photograph covers a column about 29vw wide and up to 600 px tall (3:2 source): its width follows the height. */
const sizes: string = "(max-width: 860px) 100vw, min(66vw, 900px)";
---

<section class="split-band cta-band" aria-labelledby={id}>
  <PhotoPanel photo={photo} focus="center" widths={halfPhotoWidths} sizes={sizes} priority="lazy" class="split-band__photo" />
  <div class="split-band__paper">
    <h2 class="title-xl reveal" id={id}>{title}</h2>
    <p class="reveal">{text}</p>
    <div class="split-band__actions reveal">
      <a class="button button--primary" href={routes.download}>
        <Icon name="apple" size={16} class="button__apple" />
        {copy.common.downloadCta}
      </a>
      <AppStoreBadge language={copy.common.appStoreBadge.language} label={copy.common.appStoreBadge.label} height={52} class="" />
    </div>
  </div>
  <PhotoPanel photo={partner} focus="center" widths={halfPhotoWidths} sizes={sizes} priority="lazy" class="split-band__photo" />
</section>

<style>
  .cta-band {
    margin-top: clamp(80px, 10vw, 140px);
  }

  .cta-band :global(.title-xl) {
    font-size: clamp(2.5rem, 1.4rem + 3.4vw, 4rem);
  }
</style>
