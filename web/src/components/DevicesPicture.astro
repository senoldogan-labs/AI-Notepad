---
// The rendered picture of Gistsmith on a Mac, an iPhone and an Apple Watch (promo/blender/devices.py, real screens on
// the Warm Ember background). Landscape on wider screens, the portrait framing below 641 px so the devices stay large
// on phones (art direction through `<source media>`; each source carries its own size so the space stays reserved).
// Served as AVIF with a WebP fallback. The same picture in both themes: its dark background is part of the render.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import wide from "../assets/devices/devices-wide.webp";
import portrait from "../assets/devices/devices-portrait.webp";

interface Props {
  readonly alt: string;
  /** `sizes` of the landscape picture; the portrait one fills the phone's width (`mobileSizes`). */
  readonly sizes: string;
  readonly mobileSizes: string;
  readonly class: string;
}
const { alt, sizes, mobileSizes, class: extraClass } = Astro.props;
/** A soft render with grain: 70 keeps the screens' text crisp without the grain costing much. */
const quality: number = 70;

/** One framing's AVIF and WebP srcsets and its WebP fallback. */
interface Variant {
  readonly avif: string;
  readonly webp: string;
  readonly fallback: string;
  readonly width: number;
  readonly height: number;
}

async function variant(image: ImageMetadata, widths: readonly number[]): Promise<Variant> {
  const usable: number[] = widths.filter((width: number): boolean => width <= image.width);
  const avif = await getImage({ src: image, widths: usable, format: "avif", quality });
  const webp = await getImage({ src: image, widths: usable, format: "webp", quality });
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: webp.src, width: image.width, height: image.height };
}

const main: Variant = await variant(wide, [800, 1200, 1600, 2400]);
const small: Variant = await variant(portrait, [540, 810, 1080]);
---

<picture class:list={["devices-picture", extraClass]}>
  <source media="(max-width: 640px)" type="image/avif" srcset={small.avif} sizes={mobileSizes} width={small.width} height={small.height} />
  <source media="(max-width: 640px)" type="image/webp" srcset={small.webp} sizes={mobileSizes} width={small.width} height={small.height} />
  <source type="image/avif" srcset={main.avif} sizes={sizes} width={main.width} height={main.height} />
  <img src={main.fallback} srcset={main.webp} sizes={sizes} width={main.width} height={main.height} alt={alt} loading="lazy" decoding="async" />
</picture>

<style>
  .devices-picture,
  .devices-picture img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
