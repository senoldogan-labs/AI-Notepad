---
// Home page view: hero (serif headline, lead, actions; the Mac note window over the dusk-lake photograph) and recent
// meeting cards, the launch video (muted, looping product shot in a plain frame), a still row of integration logos,
// the meeting in four rows (before, during, after as the animated demo, later: real screens on photographs),
// features (pastel covers) and the capabilities in every plan, integrations (MCP chat window and integration chips on
// the desk photograph), privacy on the night band, price, FAQ and the closing card over the dusk archipelago. Each
// message appears once on the page: strengthen the existing section before adding one that says the same thing.
// Text comes from props: the English home page (`/`, copy.home) and the Finnish page (`/fi`, copy-fi.ts) share this
// view; the page shell (Base, header, footer) lives in the pages.
import { Picture } from "astro:assets";
import AppShot, { type ShotCallout } from "./AppShot.astro";
import BrandTile from "./BrandTile.astro";
import Faq from "./Faq.astro";
import HeroDemo from "./HeroDemo.astro";
import Horizon from "./Horizon.astro";
import Icon from "./Icon.astro";
import McpChat from "./McpChat.astro";
import MeetingCard from "./MeetingCard.astro";
import PhotoPanel from "./PhotoPanel.astro";
import { macDownloadUrl } from "../config";
import type { CommonCopy, HomeCopy, IconText, LibraryMeeting } from "../copy";
import { type Brand, brands, marqueeBrands } from "../lib/brands";
import type { IconName } from "../lib/icons";
import { homeStructuredData, structuredDataJson } from "../lib/structured-data";
import { operator } from "../legal/operator";
import { routes } from "../routes";
import { siteConfig } from "../site";
import launchPoster from "../assets/video/launch-poster.jpg";
import askShot from "../assets/screenshots/ask.webp";
import homeShot from "../assets/screenshots/home.webp";
import liveShot from "../assets/screenshots/live.webp";
import noteShot from "../assets/screenshots/note.webp";

interface Props {
  /** The page's text. */
  readonly text: HomeCopy;
  /** Shared text (buttons, price, requirements). */
  readonly common: CommonCopy;
  /** The page this view is drawn on: structured-data address and pricing links follow from it. */
  readonly page: "home" | "fi";
  /** Target of the "pricing" links; the Finnish page stays in its own pricing section (`#pricing`). */
  readonly pricingHref?: string | undefined;
}
const { text, common, page, pricingHref = routes.pricing } = Astro.props;
const heroDownloadUrl: string = macDownloadUrl(siteConfig, "home-hero");
const ctaDownloadUrl: string = macDownloadUrl(siteConfig, "home-cta");
/** Not ekranındaki açıklama balonları (konumları stilde, note.webp'deki öğelere göre). */
const noteCallouts: readonly ShotCallout[] = [
  { text: text.noteCallouts.transcript, class: "note-callout--transcript", side: "right" },
  { text: text.noteCallouts.dueDate, class: "note-callout--due", side: "right" },
];
/** Integration groups and their icons (the AI group closes the list with the MCP link). */
const integrationGroups: readonly { readonly key: "notes" | "tasks" | "files"; readonly icon: IconName }[] = [
  { key: "notes", icon: "message" },
  { key: "tasks", icon: "check-circle" },
  { key: "files", icon: "disk" },
];
/** Chips on the integrations photograph: tools the app really connects to (notes, tasks, files, calendar). */
const chipBrands: readonly Brand[] = ["notion", "slack", "linear", "obsidian", "calendar"];
/** Tanıtım videosu (public/video; 1280×720, 66 sn; sessiz oynatılır). Kapak karesi src/assets/video/launch-poster.jpg. */
const launchVideo: { readonly src: string } = {
  src: "/video/gistsmith-launch-720p.mp4",
};
/** Arama motorları için uygulama ve işletme bilgisi (JSON-LD). */
const structuredData: string = structuredDataJson(
  homeStructuredData(siteConfig, operator, { common, meta: text.meta, faq: text.faq, features: text.featureList, trial: common.trial, page }),
);
---

  {/* Data block: Astro does not process or bundle it (`is:inline`), the browser does not run it; no CSP issue. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="hero page">
    <div class="hero__text">
      <h1 class="display hero__title">{text.title}</h1>
      <div class="hero__side">
        <p class="lead"><strong>{text.eyebrow}.</strong> {text.lead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={heroDownloadUrl} data-mac-download>
            <Icon name="apple" size={16} class="button__apple" />
            {common.downloadCta}
          </a>
          <a class="button button--secondary" href={pricingHref}>{text.secondaryCta}</a>
        </div>
        <ul class="hero__assurances small">
          {
            text.assurances.map((item: string) => (
              <li>
                <Icon name="check" size={15} class="hero__check" />
                {item}
              </li>
            ))
          }
          <li class="muted">{common.requirementsShort}</li>
        </ul>
      </div>
    </div>

    <AppShot
      image={noteShot}
      alt={text.showcase.note.alt}
      photo="summer-lake"
      focus="bottom"
      variant="window"
      widths={[720, 1200, 1680, 2160]}
      sizes="(max-width: 640px) calc(175vw - 126px), min(1080px, 88vw)"
      photoSizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)"
      priority="wide-lcp"
      class="hero__shot"
      callouts={noteCallouts}
    />

    <section class="library" aria-label={text.library.label}>
      <h2 class="library__label">{text.library.label}</h2>
      <div class="library__grid">
        {
          text.library.meetings.map((meeting: LibraryMeeting) => (
            <MeetingCard meeting={meeting} />
          ))
        }
      </div>
    </section>
  </section>

  {/* The launch video stands like a product shot: no player chrome, muted, looping; it plays when it scrolls into view
      and stops when it leaves, and with reduced motion only the poster shows (src/client/launch-video.ts). It loads
      only when it plays (preload="none"); the size is given, so nothing shifts. The cover frame is a lazy AVIF/WebP image
      under the video (a `poster` attribute would be fetched with the first screen), visible until the video draws its
      first frame and whenever it never plays (reduced motion). A plain frame, no cover. */}
  <section class="page launch" aria-labelledby="launch-title">
    <h2 class="title-l launch__title reveal" id="launch-title"><span class="tone">{text.launchVideo.eyebrow}.</span> {text.launchVideo.title}</h2>
    <div class="launch__frame">
      <Picture
        src={launchPoster}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 960, 1280]}
        sizes="min(1240px, 100vw - 40px)"
        quality={60}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: "launch__poster" }}
      />
      <video
        id="launch-video"
        class="launch__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        width="1280"
        height="720"
        aria-label={text.launchVideo.description}
      >
        <source src={launchVideo.src} type="video/mp4" />
        <p>
          {text.launchVideo.fallback} <a href={launchVideo.src}>{text.launchVideo.fallbackLink}</a>
        </p>
      </video>
      <button
        id="launch-video-toggle"
        class="launch__toggle"
        type="button"
        hidden
        aria-controls="launch-video"
        aria-label={text.launchVideo.pause}
        title={text.launchVideo.pause}
        data-label-pause={text.launchVideo.pause}
        data-label-play={text.launchVideo.play}
      >
        <Icon name="pause" size={16} class="launch__pause" />
        <Icon name="play" size={15} class="launch__play" />
      </button>
    </div>
  </section>

  {/* Integration logos as a calm, still row (no marquee: nothing moves on its own). */}
  <section class="page logos" aria-labelledby="logos-label">
    <p class="logos__label" id="logos-label">{text.marqueeLabel}</p>
    <ul class="logos__row">
      {
        marqueeBrands.map((brand: Brand) => (
          <li class="logos__item">
            <BrandTile brand={brand} size="small" />
            <span>{brands[brand].name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* The meeting, in order: before, during, after and later. Each row is a two-tone heading and a real screen on a
      photograph; the panels alternate sides. "After" is the product demo (the note writes itself) at full width. */}
  <section class="section page showcase" aria-labelledby="showcase-title">
    <div class="section-head reveal">
      <h2 class="title-xl" id="showcase-title"><span class="tone">{text.showcase.eyebrow}.</span> {text.showcase.title}</h2>
      <p class="lead">{text.showcase.lead}</p>
    </div>

    <article class="row">
      <div class="row__text reveal">
        <Horizon seed={text.showcase.home.label} class="" />
        <h3 class="title-l row__title"><span class="tone">{text.showcase.home.label}.</span> {text.showcase.home.title}.</h3>
      </div>
      <AppShot
        image={homeShot}
        alt={text.showcase.home.alt}
        photo="archipelago-aerial"
        focus="center"
        variant="window"
        widths={[640, 800, 960, 1360, 1680]}
        sizes="(max-width: 640px) calc(112vw - 45px), (max-width: 960px) 86vw, 760px"
        photoSizes="(max-width: 960px) calc(100vw - 40px), 820px"
        priority="lazy"
        class="row__shot showcase__home"
        callouts={[]}
      />
    </article>

    <article class="row row--flip">
      <div class="row__text reveal">
        <Horizon seed={text.showcase.live.label} class="" />
        <h3 class="title-l row__title"><span class="tone">{text.showcase.live.label}.</span> {text.showcase.live.title}.</h3>
      </div>
      <AppShot
        image={liveShot}
        alt={text.showcase.live.alt}
        photo="lake-pier"
        focus="center"
        variant="panel"
        widths={[360, 560, 840]}
        sizes="(max-width: 640px) calc(74vw - 30px), 340px"
        photoSizes="(max-width: 960px) calc(100vw - 40px), 820px"
        priority="lazy"
        class="row__shot showcase__live"
        callouts={[]}
      />
    </article>

    <article class="row row--wide">
      <div class="row__text reveal">
        <Horizon seed={text.showcase.note.label} class="" />
        <h3 class="title-l row__title"><span class="tone">{text.showcase.note.label}.</span> {text.showcase.note.title}.</h3>
      </div>
      <PhotoPanel photo="autumn-birches" focus="center" widths={[480, 720, 960, 1280, 1680, 2400]} sizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)" priority="lazy" class="demo-panel">
        <HeroDemo demo={text.demo} />
      </PhotoPanel>
    </article>

    <article class="row">
      <div class="row__text reveal">
        <Horizon seed={text.showcase.ask.label} class="" />
        <h3 class="title-l row__title"><span class="tone">{text.showcase.ask.label}.</span> {text.showcase.ask.title}.</h3>
      </div>
      <AppShot
        image={askShot}
        alt={text.showcase.ask.alt}
        photo="sunlit-pines"
        focus="center"
        variant="window"
        widths={[640, 960, 1360]}
        sizes="(max-width: 640px) calc(120vw - 48px), (max-width: 960px) 86vw, 680px"
        photoSizes="(max-width: 960px) calc(100vw - 40px), 820px"
        priority="lazy"
        class="row__shot showcase__ask"
        callouts={[]}
      />
    </article>
  </section>

  <section class="section page features-section" id="features" aria-labelledby="features-title">
    <div class="section-head reveal">
      <h2 class="title-xl" id="features-title"><span class="tone">{text.featuresEyebrow}.</span> {text.featuresTitle}</h2>
      <p class="lead">{text.featuresLead}</p>
    </div>
    <div class="features">
      <article class="feature feature--wide reveal">
        <div class="film film--ocean film--clouds-right feature__cover">
          <div class="mock-card bubble-stack">
            <p class="bubble-stack__original">{text.features.live.original}</p>
            <p class="bubble-stack__translation"><Icon name="corner-down-right" size={15} class="translation-mark" />{text.features.live.translation}</p>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.live.title}</h3>
        <p class="muted">{text.features.live.text}</p>
      </article>

      <article class="feature feature--wide reveal">
        <div class="film film--coral film--clouds-left feature__cover">
          <ul class="mock-card sample-tasks">
            {
              text.features.tasks.sample.map((task: string) => (
                <li class="sample-tasks__item">
                  <span class="sample-tasks__box" aria-hidden="true" />
                  {task}
                </li>
              ))
            }
          </ul>
        </div>
        <h3 class="feature__title title-m">{text.features.tasks.title}</h3>
        <p class="muted">{text.features.tasks.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--rose film--streaks feature__cover">
          <div class="missed">
            <span class="mock-card missed__button">{text.features.missed.button}</span>
            <p class="mock-card missed__answer">{text.features.missed.answer}</p>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.missed.title}</h3>
        <p class="muted">{text.features.missed.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--violet film--clouds-left feature__cover">
          <div class="ask">
            <p class="mock-card ask__question">{text.features.ask.question}</p>
            <p class="ask__source">{text.features.ask.source}</p>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.ask.title}</h3>
        <p class="muted">{text.features.ask.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--mint film--clouds-right feature__cover">
          <div class="follow-up">
            <span class="mock-card follow-up__recipe"><Icon name="sparkle" size={14} class="" />{text.features.followUp.recipe}</span>
            <div class="mock-card follow-up__mail">
              <p class="follow-up__subject">{text.features.followUp.subject}</p>
              {text.features.followUp.lines.map((line: string) => <p class="follow-up__line">{line}</p>)}
            </div>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.followUp.title}</h3>
        <p class="muted">{text.features.followUp.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--sunset film--streaks feature__cover">
          <ul class="templates">
            {
              text.features.templates.sample.map((template: string) => (
                <li class="mock-card templates__item">{template}</li>
              ))
            }
          </ul>
        </div>
        <h3 class="feature__title title-m">{text.features.templates.title}</h3>
        <p class="muted">{text.features.templates.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--ocean film--clouds-left feature__cover">
          <div class="voice">
            <span class="mock-card voice__keys"><Icon name="mic" size={14} class="" />{text.features.voiceTyping.shortcut}</span>
            <p class="mock-card voice__field">{text.features.voiceTyping.sample}<span class="voice__caret" aria-hidden="true" /></p>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.voiceTyping.title}</h3>
        <p class="muted">{text.features.voiceTyping.text}</p>
      </article>

      <article class="feature feature--third reveal">
        <div class="film film--violet film--streaks feature__cover">
          <div class="screens">
            <div class="mock-card screens__frame" aria-hidden="true">
              <span class="screens__bar" />
              <span class="screens__block" />
              <span class="screens__line" />
              <span class="screens__line screens__line--short" />
            </div>
            <p class="mock-card screens__pin">
              <span class="screens__meta"><Icon name="image" size={12} class="" />{text.features.screens.frame} · {text.features.screens.time}</span>
              {text.features.screens.quote}
            </p>
          </div>
        </div>
        <h3 class="feature__title title-m">{text.features.screens.title}</h3>
        <p class="muted">{text.features.screens.text}</p>
      </article>
    </div>

    <div class="capabilities reveal">
      <h3 class="capabilities__title">{text.capabilities.title}</h3>
      <ul class="capabilities__grid">
        {
          text.capabilities.items.map((item: IconText) => (
            <li class="capability">
              <span class="icon-chip icon-chip--small"><Icon name={item.icon} size={18} class="" /></span>
              <div>
                <h4 class="capability__title">{item.title}</h4>
                <p class="muted">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section page integrations-section" id="integrations" aria-labelledby="integrations-title">
    <div class="split">
      <div class="split__text">
        <h2 class="title-xl reveal" id="integrations-title"><span class="tone">{text.integrations.eyebrow}.</span> {text.integrations.title}</h2>
        <p class="lead reveal">{text.integrations.lead}</p>
        <dl class="groups">
          {
            integrationGroups.map((group) => (
              <div class="group reveal">
                <dt class="group__title"><Icon name={group.icon} size={18} class="group__icon" />{text.integrations[group.key].title}</dt>
                <dd class="muted">{text.integrations[group.key].text}</dd>
              </div>
            ))
          }
          <div class="group reveal">
            <dt class="group__title"><Icon name="sparkle" size={18} class="group__icon" />{text.integrations.ai.title}</dt>
            <dd class="muted">
              {text.integrations.ai.text}
              <a class="text-link group__link" href={routes.mcp}>{text.integrations.mcpLink} <Icon name="arrow-right" size={16} class="" /></a>
            </dd>
          </div>
        </dl>
      </div>
      <PhotoPanel photo="aurora-lake" focus="bottom" widths={[480, 720, 960, 1280, 1680]} sizes="(max-width: 960px) calc(100vw - 40px), 640px" priority="lazy" class="split__panel integrations__panel">
        <div class="integrations__window">
          <McpChat demo={text.integrations.mcpDemo} />
        </div>
        <ul class="integrations__chips" aria-hidden="true">
          {
            chipBrands.map((brand: Brand) => (
              <li class:list={["chip", `integrations__chip--${brand}`]}>
                <BrandTile brand={brand} size="small" />
                {brands[brand].name}
              </li>
            ))
          }
        </ul>
      </PhotoPanel>
    </div>
  </section>

  {/* Privacy on the night band: the same dark surface in both themes, with an inset photograph. */}
  <section class="night" aria-labelledby="trust-title">
    <div class="page night__inner">
      <div class="night__head">
        <h2 class="title-xl reveal" id="trust-title"><span class="night__tone">{text.trust.eyebrow}.</span> {text.trust.title}</h2>
        <p class="lead night__lead reveal">{text.trust.lead}</p>
        <a class="text-link night__link reveal" href={routes.privacy}>{text.trust.link} <Icon name="arrow-right" size={16} class="" /></a>
      </div>
      <ul class="trust">
        {
          text.trust.items.map((item: IconText) => (
            <li class="trust__item reveal">
              <Icon name={item.icon} size={20} class="trust__icon" />
              <h3 class="trust__title">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section page" id="pricing" aria-labelledby="pricing-title">
    <div class="split split--price">
      <div class="split__text">
        <h2 class="title-xl reveal" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead reveal">{text.pricingLead}</p>
        <div class="split__links reveal">
          <a class="text-link" href={routes.pricing}>{text.pricingCta} <Icon name="arrow-right" size={16} class="" /></a>
          <a class="text-link" href={routes.compare}>{text.pricingCompare} <Icon name="arrow-right" size={16} class="" /></a>
        </div>
      </div>
      <PhotoPanel photo="midsummer-sunset" focus="center" widths={[480, 720, 960, 1280, 1680]} sizes="(max-width: 960px) calc(100vw - 40px), 640px" priority="lazy" class="split__panel price-panel">
        <div class="price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.price}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__tax">{common.renewalNote}</p>
        </div>
      </PhotoPanel>
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="faq-title">
    <div class="faq-layout">
      <h2 class="title-l reveal" id="faq-title">{text.faqTitle}</h2>
      <Faq items={text.faq} />
    </div>
  </section>

  <section class="page final" aria-labelledby="final-title">
    <PhotoPanel photo="sunset-archipelago" focus="center" widths={[480, 720, 960, 1280, 1680, 2400]} sizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)" priority="lazy" class="final__photo">
      <div class="final__card reveal">
        <Horizon seed={text.finalTitle} class="final__horizon" />
        <h2 class="title-xl" id="final-title">{text.finalTitle}</h2>
        <p class="final__lead">{text.finalLead}</p>
        <div class="hero__actions final__actions">
          <a class="button button--primary" href={ctaDownloadUrl} data-mac-download>
            <Icon name="apple" size={16} class="button__apple" />
            {common.downloadCta}
          </a>
        </div>
      </div>
    </PhotoPanel>
  </section>

{/* The home page's own behaviour in one module: the product demo (HeroDemo.astro) and the launch video. */}
<script>
  import "../client/hero-demo";
  import "../client/launch-video";
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(56px, 9vw, 120px);
  }

  /* Headline on the left, lead and actions bottom-aligned on the right; one column below 960 px. */
  .hero__text {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px clamp(32px, 5vw, 80px);
    align-items: end;
  }

  .hero__title {
    max-width: 13ch;
  }

  .hero__side {
    display: grid;
    gap: 22px;
    padding-bottom: 6px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Assurances under the buttons: a small flowing list with check marks. */
  .hero__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__assurances li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .hero__assurances :global(.hero__check) {
    color: var(--accent);
  }

  .hero :global(.hero__shot) {
    margin-top: clamp(40px, 6vw, 72px);
    --shot-ratio: 16 / 9;
    --shot-top: clamp(28px, 6%, 72px);
    --shot-side: clamp(18px, 8%, 120px);
  }

  /* Callouts on the note window: positions of the elements in note.webp (percent of the image). */
  .hero :global(.note-callout--transcript) {
    left: 66.8%;
    top: 59%;
  }

  .hero :global(.note-callout--due) {
    left: 60.2%;
    top: 73.4%;
  }

  .library {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .library__label {
    font-size: 0.875rem;
    font-weight: 600;
