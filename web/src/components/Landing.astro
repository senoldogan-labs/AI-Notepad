---
// Home page view. Order: hero (the orange horizon waveform, serif headline, one line, both ways to get the app,
// assurances and both requirements; beside it the Mac note window with the iPhone in front, on a soft wave render), the factual trust strip,
// the brand line on the paper band with the product demo, the film (English page only), two feature rows with real
// screens (live translation, Ask), the details as six equal dark cards on the night band, the iPhone app, integrations,
// privacy on the night band, price with the FAQ, and the closing card. Each message appears once on the page, and each
// backdrop photograph at most once. Body text keeps to the reading measure (`--measure`); pictures use the page width.
// Text comes from props: the English home page (`/`, copy.home) and the Finnish page (`/fi`, copy-fi.ts) share this
// view; the page shell (Base, header, footer) lives in the pages. Mac and iPhone stand as equals: the hero shows both
// apps and offers the Mac download and the App Store side by side on every device (GetApp.astro).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import AppShot from "./AppShot.astro";
import AppStoreBadge from "./AppStoreBadge.astro";
import GetApp from "./GetApp.astro";
import BrandTile from "./BrandTile.astro";
import CtaBand from "./CtaBand.astro";
import Faq from "./Faq.astro";
import HeroDemo from "./HeroDemo.astro";
import Horizon from "./Horizon.astro";
import Icon from "./Icon.astro";
import ImagePreload from "./ImagePreload.astro";
import LaunchFilm from "./LaunchFilm.astro";
import McpChat from "./McpChat.astro";
import PhotoPanel from "./PhotoPanel.astro";
import SocialProof from "./SocialProof.astro";
import ThemedShot from "./ThemedShot.astro";
import { macDownloadUrl } from "../config";
import { copy, type CommonCopy, type HomeCopy, type IconText } from "../copy";
import { type Brand, brands } from "../lib/brands";
import { proTextAttributes } from "../lib/plans";
import type { IconName } from "../lib/icons";
import { fullPhotoWidths, halfPhotoWidths } from "../lib/photos";
import { homeStructuredData, structuredDataJson } from "../lib/structured-data";
import { operator } from "../legal/operator";
import { routes } from "../routes";
import { siteConfig } from "../site";
import askShot from "../assets/screenshots/ask.webp";
import askShotDark from "../assets/screenshots/ask-dark.webp";
import liveShot from "../assets/screenshots/live.webp";
import liveShotDark from "../assets/screenshots/live-dark.webp";
import notePane from "../assets/screenshots/note-pane.webp";
import notePaneDark from "../assets/screenshots/note-pane-dark.webp";
import iphoneAskShot from "../assets/screenshots/iphone-ask.webp";
import iphoneHomeShot from "../assets/screenshots/iphone-home.webp";
import iphoneLiveShot from "../assets/screenshots/iphone-live.webp";

interface Props {
  /** The page's text. */
  readonly text: HomeCopy;
  /** Shared text (buttons, price, requirements). */
  readonly common: CommonCopy;
  /** The page this view is drawn on: structured-data address, pricing links and the (English) film follow from it. */
  readonly page: "home" | "fi";
  /** Target of the "pricing" links; the Finnish page stays in its own pricing section (`#pricing`). */
  readonly pricingHref: string;
}
const { text, common, page, pricingHref } = Astro.props;
/**
 * Whether the price band describes Pro once the server offers it (English page only): the lead and limit lines carry
 * their Pro templates and src/client/home-pricing.ts fills them with the server's Pro hours.
 */
const describesPro: boolean = text.pricingLeadPro !== null || text.pricingLimitsPro !== null;
const heroDownloadUrl: string = macDownloadUrl(siteConfig, "home-hero");
const ctaDownloadUrl: string = macDownloadUrl(siteConfig, "home-cta");
/** The hero note pane: its widths and `sizes` (the preload uses the same, so the preloaded file is the one shown). */
const heroShotWidths: readonly number[] = [680, 1000, 1340];
const heroShotSizes: string = "(max-width: 767px) 84vw, (max-width: 960px) 44vw, 600px";
const heroShotQuality: number = 62;
/** Integration groups and their icons (the AI group closes the list with the MCP link). */
const integrationGroups: readonly { readonly key: "notes" | "tasks" | "files"; readonly icon: IconName }[] = [
  { key: "notes", icon: "message" },
  { key: "tasks", icon: "check-circle" },
  { key: "files", icon: "disk" },
];
/** Chips on the integrations photograph: tools the app really connects to (notes, tasks, files, calendar). */
const chipBrands: readonly Brand[] = ["notion", "slack", "linear", "obsidian", "calendar"];
/** iPhone screens (scripts/make-iphone-shots.ts): two, large enough to read; on phones only the first. */
const iphoneShots: readonly { readonly image: ImageMetadata; readonly alt: string }[] = [
  { image: iphoneLiveShot, alt: text.iphone.alt.live },
  { image: iphoneHomeShot, alt: text.iphone.alt.home },
];
/** Arama motorları için uygulama ve işletme bilgisi (JSON-LD). */
const structuredData: string = structuredDataJson(
  homeStructuredData(siteConfig, operator.email, { common, meta: text.meta, faq: text.faq, features: text.featureList, trial: common.trial, page }),
);
---

  {/* Data block: Astro does not process or bundle it (`is:inline`), the browser does not run it; no CSP issue. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />

  <section class="hero page">
    <div class="hero__text">
      <Horizon seed={text.title} class="hero__horizon" />
      <h1 class="display hero__title">{text.title}</h1>
      <p class="hero__lead">{text.lead}</p>
      <GetApp common={common} macHref={heroDownloadUrl} size="large" class="hero__actions" />
      <p class="hero__assurance small"><Icon name="check-circle" size={16} class="hero__assurance-icon" />{text.assurances.join(" · ")}</p>
      <p class="hero__platforms small"><span>{common.platformsShort[0]}</span> · <span>{common.platformsShort[1]}</span></p>
    </div>
    {/* Both apps in one picture, on every screen: the Mac note window (light or dark capture with the theme, a drawn
        title bar) on a soft wave render, and the iPhone home screen standing in front of its lower corner. The Mac
        window is the largest paint on wide screens, so it is preloaded there; on phones the headline is, and a static
        lilac gradient stands in for the wave render (a hidden lazy image is never fetched) so it stays that way. */}
    <div class="hero__visual">
      <PhotoPanel photo="wave-lilac" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) 90vw, 600px" priority="lazy" class="hero__backdrop" />
      <ImagePreload image={notePane} widths={heroShotWidths} sizes={heroShotSizes} quality={heroShotQuality} media="(min-width: 641px)" />
      <div class="hero__mac">
        <div class="hero__mac-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <ThemedShot
          light={notePane}
          dark={notePaneDark}
          mobile={null}
          alt={text.showcase.note.alt}
          widths={heroShotWidths}
          sizes={heroShotSizes}
          loading="eager"
          class="hero__shot"
        />
      </div>
      <Picture
        src={iphoneHomeShot}
        alt={text.iphone.alt.home}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[240, 360, 480, 720]}
        sizes="(max-width: 767px) 40vw, 210px"
        quality={66}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: "hero__phone" }}
      />
    </div>
  </section>

  <ul class="proof page small">
    {text.proof.map((item: string) => <li><Icon name="check" size={15} class="proof__icon" />{item}</li>)}
    <li>
      <Icon name="sparkle" size={15} class="proof__icon" />
      <a class="proof__link" href={text.directory.href} rel="noopener">{text.directory.text}</a>
    </li>
  </ul>

  {/* The brand line on the paper band: heading and one line, then the product demo across the page width. */}
  <section class="brandline" id="features" aria-labelledby="features-title">
    <div class="page">
      <div class="section-intro">
        <h2 class="title-l reveal" id="features-title"><span class="tone">{text.showcase.eyebrow}.</span> {text.showcase.title}</h2>
        <p class="section-intro__lead reveal">{text.showcase.lead}</p>
      </div>
      <PhotoPanel photo="red-rock-glow" focus="center" widths={fullPhotoWidths} sizes="(max-width: 640px) 100vw, min(1240px, 100vw - 80px)" priority="lazy" class="demo-panel">
        <HeroDemo demo={text.demo} />
      </PhotoPanel>
    </div>
  </section>

  {page === "home" && <LaunchFilm text={text.launchVideo} />}

  {/* Two feature rows: a hairline, the title left, one line right, the screen on a photograph below. */}
  <section class="section page moments" aria-label={text.showcase.title}>
    <article class="frow">
      <div class="frow__head">
        <h3 class="frow__title reveal"><span class="tone">{text.showcase.live.label}.</span> {text.showcase.live.title}.</h3>
        <p class="frow__text reveal">{text.showcase.live.text}</p>
      </div>
      <AppShot
        image={liveShot}
        dark={liveShotDark}
        mobile={{ image: iphoneLiveShot, widths: [480, 720, 888], sizes: "78vw" }}
        alt={text.showcase.live.alt}
        photo="lilac-peaks"
        focus="center"
        variant="panel"
        widths={[360, 560, 840]}
        sizes="(max-width: 640px) calc(100vw - 88px), 340px"
        photoSizes="(max-width: 640px) 100vw, min(1240px, 100vw - 80px)"
        priority="lazy"
        class="moments__shot moments__live"
        callouts={[]}
      />
    </article>
    <article class="frow">
      <div class="frow__head">
        <h3 class="frow__title reveal"><span class="tone">{text.showcase.ask.label}.</span> {text.showcase.ask.title}.</h3>
        <p class="frow__text reveal">{text.showcase.ask.text}</p>
      </div>
      <AppShot
        image={askShot}
        dark={askShotDark}
        mobile={{ image: iphoneAskShot, widths: [480, 720, 888], sizes: "78vw" }}
        alt={text.showcase.ask.alt}
        photo="wave-ocean"
        focus="center"
        variant="window"
        widths={[640, 960, 1360, 1880]}
        sizes="(max-width: 640px) calc(100vw - 56px), min(980px, 80vw)"
        photoSizes="(max-width: 640px) 100vw, min(1240px, 100vw - 80px)"
        priority="lazy"
        class="moments__shot moments__ask"
        callouts={[]}
      />
    </article>
  </section>

  {/* The details on the night band: six equal cards (a small label, the example in the serif, the feature, one line);
      the sixth lists what else is included. */}
  <section class="band band--night details" aria-labelledby="details-title">
    <div class="page">
      <h2 class="title-l details__title reveal" id="details-title">{text.featuresTitle}</h2>
      <div class="dcards">
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="mail" size={16} class="" />{text.features.followUp.subject}</p>
          <blockquote class="dcard__quote">“{text.features.followUp.lines.join(" ")}”</blockquote>
          <h3 class="dcard__title">{text.features.followUp.title}</h3>
          <p class="dcard__text">{text.features.followUp.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="rewind" size={16} class="" />{text.features.missed.button}</p>
          <blockquote class="dcard__quote">“{text.features.missed.answer}”</blockquote>
          <h3 class="dcard__title">{text.features.missed.title}</h3>
          <p class="dcard__text">{text.features.missed.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="image" size={16} class="" />{text.features.screens.frame} · {text.features.screens.time}</p>
          <blockquote class="dcard__quote">“{text.features.screens.quote}”</blockquote>
          <h3 class="dcard__title">{text.features.screens.title}</h3>
          <p class="dcard__text">{text.features.screens.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="note" size={16} class="" />{text.features.templates.title}</p>
          <ul class="dcard__chips">
            {text.features.templates.sample.map((template: string) => <li>{template}</li>)}
          </ul>
          <h3 class="dcard__title visually-hidden">{text.features.templates.title}</h3>
          <p class="dcard__text">{text.features.templates.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="mic" size={16} class="" />{text.features.voiceTyping.shortcut}</p>
          <blockquote class="dcard__quote">“{text.features.voiceTyping.sample}”</blockquote>
          <h3 class="dcard__title">{text.features.voiceTyping.title}</h3>
          <p class="dcard__text">{text.features.voiceTyping.text}</p>
          <a class="dcard__link" href={routes.voiceTyping}>{text.features.voiceTyping.link} <Icon name="arrow-right" size={16} class="" /></a>
        </article>
        <article class="dcard dcard--list reveal">
          <p class="dcard__label"><Icon name="check-circle" size={16} class="" />{text.capabilities.title}</p>
          <ul class="dcard__list">
            {text.capabilities.items.map((item: string) => <li>{item}</li>)}
          </ul>
          <a class="dcard__link" href={pricingHref}>{text.capabilities.link} <Icon name="arrow-right" size={16} class="" /></a>
        </article>
      </div>
    </div>
  </section>

  {/* The iPhone app: title and lead with the badge, two real screens on a wide photograph, the four points. */}
  <section class="section page iphone" id="iphone" aria-labelledby="iphone-title">
    <div class="frow">
      <div class="frow__head">
        <h2 class="title-l reveal" id="iphone-title"><span class="tone">{text.iphone.eyebrow}.</span> {text.iphone.title}</h2>
        <div class="iphone__intro reveal">
          <p class="frow__text">{text.iphone.lead}</p>
          <div class="iphone__get">
            <AppStoreBadge language={common.appStoreBadge.language} label={common.appStoreBadge.label} height={48} class="" />
            <span class="small muted">{common.iphoneRequirementsShort}</span>
          </div>
        </div>
      </div>
      <PhotoPanel photo="dune-blush" focus="center" widths={fullPhotoWidths} sizes="(max-width: 640px) 100vw, min(1240px, 100vw - 80px)" priority="lazy" class="iphone__panel">
        <div class="phones">
          {
            iphoneShots.map((shot) => (
              <Picture
                src={shot.image}
                alt={shot.alt}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[300, 480, 720, 888]}
                sizes="(max-width: 640px) 64vw, 300px"
                quality={66}
                loading="lazy"
                decoding="async"
                pictureAttributes={{ class: "phones__item" }}
              />
            ))
          }
        </div>
      </PhotoPanel>
      <dl class="points">
        {
          text.iphone.points.map((point: IconText) => (
            <div class="points__item reveal">
              <dt class="points__title"><Icon name={point.icon} size={20} class="points__icon" />{point.title}</dt>
              <dd class="muted">{point.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Integrations on the paper band: heading and lead, the four groups beside the MCP chat on a photograph. */}
  <section class="band band--surface integrations-section" id="integrations" aria-labelledby="integrations-title">
    <div class="page">
      <div class="frow__head integrations__head">
        <h2 class="title-l reveal" id="integrations-title"><span class="tone">{text.integrations.eyebrow}.</span> {text.integrations.title}</h2>
        <p class="frow__text reveal">{text.integrations.lead}</p>
      </div>
      <div class="split">
        <dl class="groups">
          {
            integrationGroups.map((group) => (
              <div class="group reveal">
                <dt class="group__title"><Icon name={group.icon} size={20} class="group__icon" />{text.integrations[group.key].title}</dt>
                <dd class="muted">{text.integrations[group.key].text}</dd>
              </div>
            ))
          }
          <div class="group reveal">
            <dt class="group__title"><Icon name="sparkle" size={20} class="group__icon" />{text.integrations.ai.title}</dt>
            <dd class="muted">
              {text.integrations.ai.text}
              <a class="text-link group__link" href={routes.mcp}>{text.integrations.mcpLink} <Icon name="arrow-right" size={16} class="" /></a>
            </dd>
          </div>
        </dl>
        <PhotoPanel photo="wave-coral" focus="bottom" widths={halfPhotoWidths} sizes="(max-width: 960px) 100vw, 640px" priority="lazy" class="split__panel integrations__panel">
          <div class="integrations__window">
            <McpChat demo={text.integrations.mcpDemo} />
          </div>
          <ul class="integrations__chips" aria-hidden="true">
            {
              chipBrands.map((brand: Brand) => (
                <li class:list={["chip", `integrations__chip--${brand}`]}>
                  <BrandTile brand={brand} size="small" />
                  {brands[brand].name}
                </li>
              ))
            }
          </ul>
        </PhotoPanel>
      </div>
    </div>
  </section>

  {/* Privacy on the night band: one big centred line, the lead, and the facts wall. */}
  <section class="band band--night trust-band" aria-labelledby="trust-title">
    <div class="page">
      <h2 class="title-xl trust-band__title reveal" id="trust-title"><span class="trust-band__tone">{text.trust.eyebrow}.</span> {text.trust.title}</h2>
      <p class="lead trust-band__lead reveal">{text.trust.lead}</p>
      <ul class="wall trust-band__wall">
        {
          text.trust.items.map((item: IconText) => (
            <li class="wall__item reveal">
              <Icon name={item.icon} size={24} class="" />
              <h3 class="trust-band__item-title">{item.title}</h3>
              <p class="trust-band__item-text">{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="trust-band__more reveal"><a class="text-link" href={routes.privacy}>{text.trust.link} <Icon name="arrow-right" size={16} class="" /></a></p>
    </div>
  </section>

  {/* Quotes and the App Store rating from src/testimonials.ts: renders nothing until the owner adds real ones. */}
  <SocialProof language={page === "fi" ? "fi" : "en"} />

  {/* Price (with the usage limits) and the questions people ask before they pay, in one section. */}
  <section
    class="section page"
    id="pricing"
    aria-labelledby="pricing-title"
    data-meeting-hours={describesPro ? copy.pricing.pro.meetingLength.hours : undefined}
    data-meeting-minutes={describesPro ? copy.pricing.pro.meetingLength.minutes : undefined}
  >
    <div class="split split--price">
      <div class="split__text">
        <h2 class="title-l reveal" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead reveal" {...proTextAttributes(text.pricingLeadPro)}>{text.pricingLead}</p>
        <div class="split__links reveal">
          <a class="text-link" href={routes.pricing}>{text.pricingCta} <Icon name="arrow-right" size={16} class="" /></a>
          <a class="text-link" href={routes.compare}>{text.pricingCompare} <Icon name="arrow-right" size={16} class="" /></a>
        </div>
      </div>
      <PhotoPanel photo="dune-pale" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) 100vw, 640px" priority="lazy" class="split__panel price-panel">
        <div class="price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.priceDisplay}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__limits" {...proTextAttributes(text.pricingLimitsPro)}>{text.pricingLimits}</p>
          <p class="price-tag__tax">{common.renewalNote}</p>
        </div>
      </PhotoPanel>
    </div>
    <div class="faq-block">
      <h2 class="title-l faq-block__title reveal" id="faq-title">{text.faqTitle}</h2>
      <Faq items={text.faq} />
    </div>
  </section>

  <CtaBand id="final-title" title={text.finalTitle} text={text.finalLead} common={common} macHref={ctaDownloadUrl} />

{/* The home page's own behaviour: the product demo (HeroDemo.astro). The film has its own module (LaunchFilm.astro). */}
<script>
  import "../client/hero-demo";
  import "../client/home-pricing";
</script>

<style>
  /* ---------- Hero: text left, the note on a wave render right (one column below 768 px) ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 4.5vw, 64px);
    min-height: min(820px, calc(100svh - 84px));
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .hero__text {
    display: grid;
    justify-items: start;
    gap: 26px;
  }

  .hero :global(.hero__horizon) {
    width: min(220px, 60%);
  }

  .hero__title {
    max-width: 11ch;
    hyphens: manual;
    -webkit-hyphens: manual;
  }

  /* Finnish words are long: let the browser hyphenate the headline so it never runs into the picture. */
  :global(html[lang="fi"]) .hero__title {
    max-width: 100%;
    font-size: clamp(2.75rem, 1rem + 4.4vw, 5.25rem);
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
  }

  .hero__lead {
    max-width: 30rem;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.45;
    color: var(--muted);
  }

  .hero__assurance {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    max-width: 34rem;
    margin-top: -6px;
    color: var(--muted);
  }

  .hero__assurance :global(.hero__assurance-icon) {
    flex: none;
    margin-top: 3px;
  }

  .hero__platforms {
    margin-top: -20px;
    padding-left: 24px;
    color: var(--muted);
  }

  .hero__platforms span {
    white-space: nowrap;
  }

  /* The wave render sits behind the upper right of the Mac window, which overlaps it to the left and below; the
     iPhone stands in front of the window's lower right corner, beside the task list (whose lines end before the
     middle), so both apps read as one picture and neither hides the other's text. */
  .hero__visual {
    position: relative;
    padding: 40px clamp(48px, 5vw, 72px) 0 0;
  }

  .hero__visual :global(.hero__backdrop) {
    position: absolute;
    inset: 0 -24px 64px 120px;
    border-radius: 20px;
  }

  .hero__mac {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: light-dark(#fafafa, #1c1c1c);
    box-shadow: var(--shadow-window);
  }

  /* A Mac title bar drawn above the note pane: the three window buttons. */
  .hero__mac-bar {
    display: flex;
    gap: 7px;
    padding: 12px 14px 4px;
  }

  .hero__mac-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: light-dark(#dcdcdc, #3d3d3d);
  }

  .hero__visual :global(.hero__phone) {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: -52px;
    display: block;
    width: clamp(120px, 12vw, 172px);
  }

  .hero__visual :global(.hero__phone img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.16)) drop-shadow(0 22px 36px rgb(0 0 0 / 0.3));
  }

  /* ---------- Trust strip: one quiet row; a 2 × 2 grid on narrow phones ---------- */
  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 32px;
    margin: 0 auto;
    padding: 12px 0 clamp(48px, 7vw, 88px);
    list-style: none;
    color: var(--muted);
    font-weight: 500;
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
