---
// Home page view: hero (serif headline, one line, one download button, one line of assurances; a collage of a desert
// photograph and a wave render with the Mac note window and the live panel; a factual trust strip), the brand line on
// the paper band with the product demo, the launch video on a wave render, feature rows with real screens, the small
// things as dark cards on the night band, the iPhone app, integrations (MCP chat window and chips), privacy on the
// night band, price with the FAQ, and the closing band (photograph · paper · wave render). Each message appears once
// on the page: strengthen the existing section before adding one that says the same thing. Body text keeps to the
// reading measure (`--measure`); photographs and windows use the page width.
// Text comes from props: the English home page (`/`, copy.home) and the Finnish page (`/fi`, copy-fi.ts) share this
// view; the page shell (Base, header, footer) lives in the pages.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import AppShot from "./AppShot.astro";
import AppStoreBadge from "./AppStoreBadge.astro";
import BrandTile from "./BrandTile.astro";
import Faq from "./Faq.astro";
import HeroDemo from "./HeroDemo.astro";
import Horizon from "./Horizon.astro";
import Icon from "./Icon.astro";
import McpChat from "./McpChat.astro";
import ImagePreload from "./ImagePreload.astro";
import PhotoPanel from "./PhotoPanel.astro";
import { macDownloadUrl } from "../config";
import type { CommonCopy, HomeCopy, IconText } from "../copy";
import { type Brand, brands } from "../lib/brands";
import type { IconName } from "../lib/icons";
import { fullPhotoWidths, halfPhotoWidths } from "../lib/photos";
import { homeStructuredData, structuredDataJson } from "../lib/structured-data";
import { operator } from "../legal/operator";
import { routes } from "../routes";
import { siteConfig } from "../site";
import launchPoster from "../assets/video/launch-poster.jpg";
import askShot from "../assets/screenshots/ask.webp";
import liveShot from "../assets/screenshots/live.webp";
import noteShot from "../assets/screenshots/note.webp";
import iphoneAskShot from "../assets/screenshots/iphone-ask.webp";
import iphoneHomeShot from "../assets/screenshots/iphone-home.webp";
import iphoneLiveShot from "../assets/screenshots/iphone-live.webp";

interface Props {
  /** The page's text. */
  readonly text: HomeCopy;
  /** Shared text (buttons, price, requirements). */
  readonly common: CommonCopy;
  /** The page this view is drawn on: structured-data address and pricing links follow from it. */
  readonly page: "home" | "fi";
  /** Target of the "pricing" links; the Finnish page stays in its own pricing section (`#pricing`). */
  readonly pricingHref?: string | undefined;
}
const { text, common, page, pricingHref = routes.pricing } = Astro.props;
const heroDownloadUrl: string = macDownloadUrl(siteConfig, "home-hero");
const ctaDownloadUrl: string = macDownloadUrl(siteConfig, "home-cta");
/** The hero note window: its widths and `sizes` (the preload uses the same, so the preloaded file is the one shown). */
const heroShotWidths: readonly number[] = [720, 1200, 1680];
const heroShotSizes: string = "(max-width: 640px) 88vw, (max-width: 960px) 74vw, 520px";
/** Integration groups and their icons (the AI group closes the list with the MCP link). */
const integrationGroups: readonly { readonly key: "notes" | "tasks" | "files"; readonly icon: IconName }[] = [
  { key: "notes", icon: "message" },
  { key: "tasks", icon: "check-circle" },
  { key: "files", icon: "disk" },
];
/** Chips on the integrations photograph: tools the app really connects to (notes, tasks, files, calendar). */
const chipBrands: readonly Brand[] = ["notion", "slack", "linear", "obsidian", "calendar"];
/** iPhone ekranları (scripts/make-iphone-shots.ts): ortadaki önde ve büyük, yandakiler arkada. */
const iphoneShots: readonly { readonly image: ImageMetadata; readonly alt: string; readonly position: "side" | "front" }[] = [
  { image: iphoneLiveShot, alt: text.iphone.alt.live, position: "side" },
  { image: iphoneHomeShot, alt: text.iphone.alt.home, position: "front" },
  { image: iphoneAskShot, alt: text.iphone.alt.ask, position: "side" },
];
/**
 * The launch video (public/video; 1280×720, 66 s, plays muted). Its cover is src/assets/video/launch-poster.jpg: the
 * title frame at 2 s, enlarged to 2560×1440 for Retina screens with ffmpeg
 * (`-ss 2 -vf scale=2560:1440:flags=lanczos,unsharp=5:5:0.6:5:5:0`); the video itself is 720p, so there is no sharper source.
 */
const launchVideo: { readonly src: string } = {
  src: "/video/gistsmith-launch-720p.mp4",
};
/** Arama motorları için uygulama ve işletme bilgisi (JSON-LD). */
const structuredData: string = structuredDataJson(
  homeStructuredData(siteConfig, operator, { common, meta: text.meta, faq: text.faq, features: text.featureList, trial: common.trial, page }),
);
---

  {/* Data block: Astro does not process or bundle it (`is:inline`), the browser does not run it; no CSP issue. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  {/* Hero: the headline, one line, one button and the assurances on the left; on the right a collage
      of two photographs with the Mac note window and the live panel in front. The note window is the largest paint on
      wide screens (preloaded there); on phones the headline is. */}
  <section class="hero page">
    <div class="hero__text">
      <h1 class="display hero__title">{text.title}</h1>
      <p class="hero__lead"><strong>{text.eyebrow}.</strong> {text.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={heroDownloadUrl} data-mac-download>
          <Icon name="apple" size={16} class="button__apple" />
          {common.downloadCta}
        </a>
        <a class="text-link hero__iphone" href="#iphone">{text.iphone.heroLink} <Icon name="arrow-right" size={16} class="" /></a>
      </div>
      <p class="hero__assurance small"><Icon name="check-circle" size={16} class="hero__assurance-icon" />{[...text.assurances, common.requirementsShort].join(" · ")}</p>
    </div>
    <div class="collage">
      <PhotoPanel photo="dune-ridge" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) 62vw, 560px" priority="lazy" class="collage__poster collage__poster--a" />
      <PhotoPanel photo="wave-lilac" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) 62vw, 560px" priority="lazy" class="collage__poster collage__poster--b" />
      <ImagePreload image={noteShot} widths={heroShotWidths} sizes={heroShotSizes} quality={62} media="(min-width: 641px)" />
      <Picture
        src={noteShot}
        alt={text.showcase.note.alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[...heroShotWidths]}
        sizes={heroShotSizes}
        quality={62}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        pictureAttributes={{ class: "collage__window" }}
      />
      <Picture
        src={liveShot}
        alt={text.showcase.live.alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[240, 360, 480]}
        sizes="(max-width: 960px) 21vw, 150px"
        quality={62}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: "collage__tile" }}
      />
    </div>
  </section>

  <ul class="proof page small">
    {text.proof.map((item: string) => <li><Icon name="check" size={15} class="proof__icon" />{item}</li>)}
  </ul>

  {/* The brand line on the paper band, opened by the horizon waveform (the logo's sound crossing still water): the
      meeting in three steps on the left, the product demo (listening → live transcript → the note) on the right. */}
  <section class="brandline" id="features" aria-labelledby="features-title">
    <div class="page brandline__grid">
      <div class="brandline__text">
        <Horizon seed={text.showcase.title} class="brandline__horizon" />
        <h2 class="title-l reveal" id="features-title"><span class="tone">{text.showcase.eyebrow}.</span> {text.showcase.title}</h2>
        <ol class="steps">
          {
            [text.showcase.live, text.showcase.note, text.showcase.ask].map((step, index: number) => (
              <li class="steps__item reveal">
                <span class="steps__number">{index + 1}</span>
                <span><strong>{step.label}.</strong> {step.title}.</span>
              </li>
            ))
          }
        </ol>
      </div>
      {/* The panel is taller than the photograph: it covers about 760 px of width on phones and 960 px on wide screens. */}
      <PhotoPanel photo="red-rock-glow" focus="center" widths={fullPhotoWidths} sizes="(max-width: 640px) 760px, (max-width: 960px) calc(100vw - 40px), 960px" priority="lazy" class="demo-panel">
        <HeroDemo demo={text.demo} />
      </PhotoPanel>
    </div>
  </section>

  {/* The launch video stands like a product shot: no player chrome, muted, looping; it plays when it scrolls into view
      and stops when it leaves, and with reduced motion only the poster shows (src/client/launch-video.ts). It loads
      only when it plays (preload="none"); the size is given, so nothing shifts. */}
  <section class="page launch" aria-label={text.launchVideo.description}>
    <PhotoPanel photo="wave-sunset" focus="center" widths={fullPhotoWidths} sizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)" priority="lazy" class="launch__panel">
    <div class="launch__frame">
      <Picture
        src={launchPoster}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="(max-width: 640px) calc(100vw - 80px), min(1096px, 90vw - 80px)"
        quality={70}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: "launch__poster" }}
      />
      <video
        id="launch-video"
        class="launch__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        width="1280"
        height="720"
        aria-label={text.launchVideo.description}
      >
        <source src={launchVideo.src} type="video/mp4" />
        <p>
          {text.launchVideo.fallback} <a href={launchVideo.src}>{text.launchVideo.fallbackLink}</a>
        </p>
      </video>
      <button
        id="launch-video-toggle"
        class="launch__toggle"
        type="button"
        hidden
        aria-controls="launch-video"
        aria-label={text.launchVideo.pause}
        title={text.launchVideo.pause}
        data-label-pause={text.launchVideo.pause}
        data-label-play={text.launchVideo.play}
      >
        <Icon name="pause" size={16} class="launch__pause" />
        <Icon name="play" size={15} class="launch__play" />
      </button>
    </div>
    </PhotoPanel>
  </section>

  {/* During and later, as feature rows: a hairline, the title left, one line right, the screen on a
      photograph below. */}
  <section class="section page moments" aria-label={text.showcase.title}>
    <article class="frow">
      <div class="frow__head">
        <h3 class="frow__title reveal"><span class="tone">{text.showcase.live.label}.</span> {text.showcase.live.title}.</h3>
        <p class="frow__text reveal">{text.showcase.live.text}</p>
      </div>
      <AppShot
        image={liveShot}
        alt={text.showcase.live.alt}
        photo="lilac-peaks"
        focus="center"
        variant="panel"
        widths={[360, 560, 840]}
        sizes="(max-width: 640px) calc(74vw - 30px), 340px"
        photoSizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)"
        priority="lazy"
        class="moments__shot moments__live"
        callouts={[]}
      />
    </article>
    <article class="frow">
      <div class="frow__head">
        <h3 class="frow__title reveal"><span class="tone">{text.showcase.ask.label}.</span> {text.showcase.ask.title}.</h3>
        <p class="frow__text reveal">{text.showcase.ask.text}</p>
      </div>
      <AppShot
        image={askShot}
        alt={text.showcase.ask.alt}
        photo="wave-ocean"
        focus="center"
        variant="window"
        widths={[640, 960, 1360, 1880]}
        sizes="(max-width: 640px) calc(120vw - 48px), min(980px, 80vw)"
        photoSizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)"
        priority="lazy"
        class="moments__shot moments__ask"
        callouts={[]}
      />
    </article>
  </section>

  {/* The small things, on the night band: feature cards with one sentence each and one line for
      the rest of the plan. */}
  <section class="band band--night details" aria-labelledby="details-title">
    <div class="page">
      <h2 class="title-l details__title reveal" id="details-title">{text.featuresTitle}</h2>
      {/* Dark cards: a small label with its icon, the example in the serif, then the feature and one line. */}
      <div class="dcards">
        <article class="dcard dcard--wide reveal">
          <p class="dcard__label"><Icon name="mail" size={16} class="" />{text.features.followUp.subject}</p>
          <blockquote class="dcard__quote">“{text.features.followUp.lines.join(" ")}”</blockquote>
          <h3 class="dcard__title">{text.features.followUp.title}</h3>
          <p class="dcard__text">{text.features.followUp.text}</p>
        </article>
        <article class="dcard dcard--wide reveal">
          <p class="dcard__label"><Icon name="image" size={16} class="" />{text.features.screens.frame} · {text.features.screens.time}</p>
          <blockquote class="dcard__quote">“{text.features.screens.quote}”</blockquote>
          <h3 class="dcard__title">{text.features.screens.title}</h3>
          <p class="dcard__text">{text.features.screens.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="rewind" size={16} class="" />{text.features.missed.button}</p>
          <blockquote class="dcard__quote">“{text.features.missed.answer}”</blockquote>
          <h3 class="dcard__title">{text.features.missed.title}</h3>
          <p class="dcard__text">{text.features.missed.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="note" size={16} class="" />{text.features.templates.title}</p>
          <ul class="dcard__chips">
            {text.features.templates.sample.map((template: string) => <li>{template}</li>)}
          </ul>
          <h3 class="dcard__title visually-hidden">{text.features.templates.title}</h3>
          <p class="dcard__text">{text.features.templates.text}</p>
        </article>
        <article class="dcard reveal">
          <p class="dcard__label"><Icon name="mic" size={16} class="" />{text.features.voiceTyping.shortcut}</p>
          <blockquote class="dcard__quote">“{text.features.voiceTyping.sample}”</blockquote>
          <h3 class="dcard__title">{text.features.voiceTyping.title}</h3>
          <p class="dcard__text">{text.features.voiceTyping.text}</p>
          <a class="dcard__link" href={routes.voiceTyping}>{text.features.voiceTyping.link} <Icon name="arrow-right" size={16} class="" /></a>
        </article>
      </div>

      <p class="capabilities">
        <strong>{text.capabilities.title}:</strong> {text.capabilities.items.join(" · ")}.
        <a class="text-link capabilities__link" href={pricingHref}>{text.capabilities.link} <Icon name="arrow-right" size={16} class="" /></a>
      </p>
    </div>
  </section>

  {/* The iPhone app as a feature row: title and lead side by side, three real screens on a wide photograph,
      the four points in a row, the App Store badge. */}
  <section class="section page iphone" id="iphone" aria-labelledby="iphone-title">
    <div class="frow">
      <div class="frow__head">
        <h2 class="title-l reveal" id="iphone-title"><span class="tone">{text.iphone.eyebrow}.</span> {text.iphone.title}</h2>
        <div class="iphone__intro reveal">
          <p class="frow__text">{text.iphone.lead}</p>
          <div class="iphone__get">
            <AppStoreBadge language={common.appStoreBadge.language} label={common.appStoreBadge.label} height={48} class="" />
            <span class="small muted">{common.iphoneRequirementsShort}</span>
          </div>
        </div>
      </div>
      <PhotoPanel photo="dune-blush" focus="center" widths={fullPhotoWidths} sizes="(max-width: 640px) calc(100vw - 40px), min(1240px, 100vw - 80px)" priority="lazy" class="iphone__panel">
        <div class="phones">
          {
            iphoneShots.map((shot) => (
              <Picture
                src={shot.image}
                alt={shot.alt}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[240, 360, 480, 720]}
                sizes={shot.position === "front" ? "(max-width: 960px) 34vw, 280px" : "(max-width: 960px) 28vw, 240px"}
                quality={62}
                loading="lazy"
                decoding="async"
                pictureAttributes={{ class: `phones__item phones__item--${shot.position}` }}
              />
            ))
          }
        </div>
      </PhotoPanel>
      <dl class="points">
        {
          text.iphone.points.map((point: IconText) => (
            <div class="points__item reveal">
              <dt class="points__title"><Icon name={point.icon} size={20} class="points__icon" />{point.title}</dt>
              <dd class="muted">{point.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="small muted iphone__note reveal">{text.iphone.note}</p>
    </div>
  </section>

  {/* Integrations on the paper band: heading and lead, the four groups beside the MCP chat on a
      photograph. */}
  <section class="band band--surface integrations-section" id="integrations" aria-labelledby="integrations-title">
    <div class="page">
      <div class="frow__head integrations__head">
        <h2 class="title-l reveal" id="integrations-title"><span class="tone">{text.integrations.eyebrow}.</span> {text.integrations.title}</h2>
        <p class="frow__text reveal">{text.integrations.lead}</p>
      </div>
      <div class="split">
        <dl class="groups">
          {
            integrationGroups.map((group) => (
              <div class="group reveal">
                <dt class="group__title"><Icon name={group.icon} size={20} class="group__icon" />{text.integrations[group.key].title}</dt>
                <dd class="muted">{text.integrations[group.key].text}</dd>
              </div>
            ))
          }
          <div class="group reveal">
            <dt class="group__title"><Icon name="sparkle" size={20} class="group__icon" />{text.integrations.ai.title}</dt>
            <dd class="muted">
              {text.integrations.ai.text}
              <a class="text-link group__link" href={routes.mcp}>{text.integrations.mcpLink} <Icon name="arrow-right" size={16} class="" /></a>
            </dd>
          </div>
        </dl>
        <PhotoPanel photo="wave-coral" focus="bottom" widths={halfPhotoWidths} sizes="(max-width: 960px) calc(100vw - 40px), 640px" priority="lazy" class="split__panel integrations__panel">
          <div class="integrations__window">
            <McpChat demo={text.integrations.mcpDemo} />
          </div>
          <ul class="integrations__chips" aria-hidden="true">
            {
              chipBrands.map((brand: Brand) => (
                <li class:list={["chip", `integrations__chip--${brand}`]}>
                  <BrandTile brand={brand} size="small" />
                  {brands[brand].name}
                </li>
              ))
            }
          </ul>
        </PhotoPanel>
      </div>
    </div>
  </section>

  {/* Privacy on the night band: one big centred line, the lead, and the facts wall. */}
  <section class="band band--night trust-band" aria-labelledby="trust-title">
    <div class="page">
      <h2 class="title-xl trust-band__title reveal" id="trust-title"><span class="trust-band__tone">{text.trust.eyebrow}.</span> {text.trust.title}</h2>
      <p class="lead trust-band__lead reveal">{text.trust.lead}</p>
      <ul class="wall trust-band__wall">
        {
          text.trust.items.map((item: IconText) => (
            <li class="wall__item reveal">
              <Icon name={item.icon} size={24} class="" />
              <h3 class="trust-band__item-title">{item.title}</h3>
              <p class="trust-band__item-text">{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="trust-band__more reveal"><a class="text-link" href={routes.privacy}>{text.trust.link} <Icon name="arrow-right" size={16} class="" /></a></p>
    </div>
  </section>

  {/* Price and the questions people ask before they pay, in one section. */}
  <section class="section page" id="pricing" aria-labelledby="pricing-title">
    <div class="split split--price">
      <div class="split__text">
        <h2 class="title-l reveal" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead reveal">{text.pricingLead}</p>
        <div class="split__links reveal">
          <a class="text-link" href={routes.pricing}>{text.pricingCta} <Icon name="arrow-right" size={16} class="" /></a>
          <a class="text-link" href={routes.compare}>{text.pricingCompare} <Icon name="arrow-right" size={16} class="" /></a>
        </div>
      </div>
      <PhotoPanel photo="dune-pale" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) calc(100vw - 40px), 640px" priority="lazy" class="split__panel price-panel">
        <div class="price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.price}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__tax">{common.renewalNote}</p>
        </div>
      </PhotoPanel>
    </div>
    <div class="faq-block">
      <h3 class="title-l faq-block__title reveal" id="faq-title">{text.faqTitle}</h3>
      <Faq items={text.faq} />
    </div>
  </section>

  {/* Closing band: photograph · paper · photograph. */}
  <section class="split-band final" aria-labelledby="final-title">
    <PhotoPanel photo="red-mountain" focus="center" widths={halfPhotoWidths} sizes="(max-width: 860px) 100vw, min(66vw, 900px)" priority="lazy" class="split-band__photo" />
    <div class="split-band__paper">
      <h2 class="title-xl final__title reveal" id="final-title">{text.finalTitle}</h2>
      <p class="reveal">{text.finalLead}</p>
      <div class="split-band__actions reveal">
        <a class="button button--primary" href={ctaDownloadUrl} data-mac-download>
          <Icon name="apple" size={16} class="button__apple" />
          {common.downloadCta}
        </a>
        <AppStoreBadge language={common.appStoreBadge.language} label={common.appStoreBadge.label} height={52} class="" />
      </div>
    </div>
    <PhotoPanel photo="wave-lilac" focus="center" widths={halfPhotoWidths} sizes="(max-width: 860px) 100vw, min(66vw, 900px)" priority="lazy" class="split-band__photo" />
  </section>

{/* The home page's own behaviour in one module: the product demo (HeroDemo.astro) and the launch video. */}
<script>
  import "../client/hero-demo";
  import "../client/launch-video";
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(56px, 9vw, 120px);
  }

  /* One column: headline, one line, one button, one line of assurances. */
  .hero__text {
    display: grid;
    justify-items: start;
    gap: 28px;
    max-width: var(--measure);
  }

  .hero__title {
    max-width: 12ch;
  }

  .hero__lead {
    margin-top: 4px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__actions :global(.hero__iphone) {
    align-self: center;
  }

  .hero__assurance {
    margin-top: -12px;
    color: var(--muted);
  }

  /* The factual trust strip: one quiet line under the panel. */
  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 0;
    margin: clamp(24px, 3vw, 32px) 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-weight: 500;
  }

  .proof li + li::before {
    content: "·";
    margin-inline: 12px;
    color: var(--accent);
  }

  /* ---------- Launch video ----------
     No cover, only the video's own frame (site radius, hairline, soft shadow; both themes). 16:9 space is reserved.
     No player chrome: clicks and taps do not reach the video (no picture-in-picture or play overlays either). */
  .launch__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--soft);
    box-shadow: var(--elevation);
  }

  .launch__poster,
  .launch__poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .launch__poster :global(img) {
    object-fit: cover;
  }

  .launch__video {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    pointer-events: none;
  }

  .launch__video::-webkit-media-controls {
    display: none !important;
  }

  .launch__video::-webkit-media-controls-start-playback-button {
    display: none !important;
  }

  /* Pause/play: the video plays on its own while on screen, so it can always be stopped (WCAG 2.2.2). Shown by
     src/client/launch-video.ts; hidden under reduced motion, where the video never plays. */
  .launch__toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #0a0a0a;
    box-shadow: var(--shadow-chip);
    cursor: pointer;
  }

  .launch__toggle[hidden] {
    display: none;
  }

  .launch__toggle :global(.icon) {
    grid-area: 1 / 1;
  }

  .launch__toggle :global(.launch__play),
  .launch__toggle[data-state="paused"] :global(.launch__pause) {
    display: none;
  }

  .launch__toggle[data-state="paused"] :global(.launch__play) {
    display: block;
  }

  /* ---------- The meeting, in rows ---------- */
  .showcase {
    display: grid;
    gap: clamp(64px, 9vw, 128px);
    padding-bottom: 0;
  }

  .showcase > .section-head {
    margin-bottom: 0;
  }

  /* Text column (4 of 12) and panel (8 of 12); `--flip` swaps sides, `--wide` stacks the heading over a full-width
     panel. */
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 28px clamp(20px, 3vw, 40px);
    align-items: center;
  }

  .row__text {
    grid-column: 1 / span 4;
    display: grid;
    gap: 22px;
  }

  /* The third and smallest serif step on the page (display, section title, row title). */
  .row__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--step-3);
    letter-spacing: -0.015em;
    line-height: 1.12;
  }

  .row__text p {
    margin: 0;
    max-width: 36ch;
  }

  /* The product demo floats on the desert photograph; the photograph never moves. */
  .row :global(.demo-panel) {
    display: grid;
    align-items: center;
    min-height: clamp(400px, 46vw, 580px);
    padding: clamp(16px, 3vw, 40px);
  }

  /* Özellikler: üstte iki geniş, altta dört kart; başlıklar kapakların altında, başlığın önünde simge. */
  .features {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 44px) clamp(16px, 2.2vw, 28px);
  }

  .feature {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
  }

  .missed {
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
  }

  /* Şablonlar: kart etiketler. */
  .templates {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 260px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Sesle yazma: basılı tutulan kısayol ve imlecin olduğu alana yazılan cümle (imleç durağan, animasyonsuz). */
  .voice {
    display: grid;
    gap: 12px;
    justify-items: center;
    width: min(100%, 340px);
  }

  /* Paylaşılan ekran: küçük bir tasarım çerçevesi ve ona iğnelenmiş, o sırada söylenen cümle (durağan). */
  .screens {
    display: grid;
    gap: 10px;
    justify-items: center;
    width: min(100%, 300px);
  }

  /* The rest of the plan in one line under the cards. */
  .capabilities {
    max-width: var(--measure);
    margin: 0;
    padding-top: clamp(28px, 3vw, 36px);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .capabilities strong {
    color: var(--ink);
    font-weight: 600;
  }

  .capabilities__link {
    display: inline-flex;
    margin-left: 6px;
  }

  /* ---------- iPhone: text and points beside three phones on a photograph ---------- */
  .iphone__get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 4px;
  }

  .iphone__note {
    max-width: 44ch;
    margin: 0;
  }

  .iphone :global(.iphone__panel) {
    display: grid;
    place-items: center;
    min-height: clamp(460px, 52vw, 680px);
    padding: clamp(28px, 5vw, 56px) clamp(12px, 3vw, 36px);
  }

  /* Three phones side by side: the middle one in front and larger, the side ones overlap behind it (static). */
  .phones {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    width: min(100%, 600px);
  }

  .phones :global(.phones__item) {
    display: block;
    min-width: 0;
  }

  .phones :global(.phones__item--side) {
    position: relative;
    z-index: 0;
  }

  .phones :global(.phones__item--side:first-child) {
    margin-right: -14%;
  }

  .phones :global(.phones__item--side:last-child) {
    margin-left: -14%;
  }

  .phones :global(.phones__item--front) {
    position: relative;
    z-index: 1;
  }

  /* The shadow follows the frame's transparent rounded corners (as on the Mac windows). */
  .phones :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.16)) drop-shadow(0 24px 40px rgb(0 0 0 / 0.34));
  }

  /* ---------- Integrations: text and groups beside the desk photograph ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .split__text {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .split__links {
    display: grid;
    justify-items: start;
    gap: 10px;
  }

  .groups {
    display: grid;
    gap: 0;
    margin: 8px 0 0;
  }

  .group {
    display: grid;
    gap: 6px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }

  .group__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .group :global(.group__icon) {
    color: var(--accent);
  }

  .group dd {
    margin: 0 0 0 28px;
  }

  .group__link {
    display: flex;
    width: fit-content;
    margin-top: 8px;
  }

  .integrations-section :global(.integrations__panel) {
    display: grid;
    place-items: center;
    min-height: clamp(460px, 48vw, 620px);
    padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 48px);
  }

  .integrations__window {
    width: min(100%, 420px);
  }

  /* Chips on the photograph's edges, as if laid around the window on the desk. */
  .integrations__chips {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .integrations__chips > li {
    position: absolute;
  }

  .integrations__chip--notion {
    left: 6%;
    top: 9%;
  }

  .integrations__chip--slack {
    right: 7%;
    top: 16%;
  }

  .integrations__chip--linear {
    left: 4%;
    bottom: 20%;
  }

  .integrations__chip--obsidian {
    right: 5%;
    bottom: 11%;
  }

  .integrations__chip--calendar {
    left: 34%;
    bottom: 4%;
  }

  /* ---------- Privacy on the night band ---------- */
  .night {
    padding-block: clamp(80px, 10vw, 136px);
    background: var(--night);
    color: var(--on-night);
  }

  .night :focus-visible {
    outline-color: #8fb5d8;
  }

  .trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 4vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Price ---------- */
  #pricing :global(.price-panel) {
    display: grid;
    place-items: center;
    min-height: clamp(340px, 36vw, 440px);
    padding: 28px;
  }

  .price-tag {
    display: grid;
    gap: 6px;
    width: min(100%, 360px);
    padding: 28px 32px;
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow-window);
  }

  .price-tag__amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--serif);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .price-tag__per {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .price-tag__offer {
    font-weight: 600;
  }

  .price-tag__tax {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ---------- FAQ (under the price) and closing card ---------- */
  .faq-block {
    display: grid;
    gap: 20px;
    margin-top: clamp(64px, 8vw, 112px);
  }

  .faq-block__title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* ---------- Narrower screens ---------- */
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row__text {
      grid-column: 1;
      grid-row: auto;
    }

    .feature {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {

    .trust {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature {
      grid-column: 1 / -1;
    }

    .hero__actions .button {
      flex: 1 1 auto;
    }

    /* On a phone the three phones fill the panel's width with a tighter overlap. */
    .iphone :global(.iphone__panel) {
      min-height: 0;
      padding: 32px 10px;
    }

    .phones {
      width: 100%;
    }

    .phones :global(.phones__item--side:first-child) {
      margin-right: -22%;
    }

    .phones :global(.phones__item--side:last-child) {
      margin-left: -22%;
    }

    /* Chips would cover the chat window on a phone: only two stay, at the edges. */
    .integrations__chip--linear,
    .integrations__chip--obsidian,
    .integrations__chip--calendar {
      display: none;
    }

    .integrations__chip--notion {
      left: 4%;
      top: 4%;
    }

    .integrations__chip--slack {
      right: 4%;
      top: auto;
      bottom: 4%;
    }
  }
  /* ================= Two-column layout (overrides the one-column rules above) ================= */

  /* Hero: text left, collage right. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    min-height: min(820px, calc(100svh - 84px));
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .hero__text {
    display: grid;
    justify-items: start;
    gap: 28px;
    max-width: none;
  }

  .hero__title {
    max-width: 11ch;
    hyphens: manual;
    -webkit-hyphens: manual;
  }

  .hero__lead {
    max-width: 26rem;
    margin-top: 2px;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.33;
    color: var(--muted);
  }

  .hero__lead strong {
    color: var(--ink);
    font-weight: 500;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .hero__assurance {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    max-width: 34rem;
    margin-top: -8px;
    color: var(--muted);
  }

  .hero__assurance :global(.hero__assurance-icon) {
    flex: none;
    margin-top: 2px;
  }

  /* Collage: two photographs as offset posters (the desert top left, the wave bottom right), each showing about a third
     of itself around the note window; the live panel overlaps the window's lower left corner. Percentages of the
     collage box, so phones get the same composition. */
  .collage {
    position: relative;
    aspect-ratio: 1.1 / 1;
    width: 100%;
  }

  .collage :global(.collage__poster) {
    position: absolute;
    border-radius: var(--radius-panel);
  }

  .collage :global(.collage__poster--a) {
    left: 0;
    top: 0;
    width: 44%;
    height: 66%;
  }

  .collage :global(.collage__poster--b) {
    right: 0;
    top: 36%;
    width: 46%;
    height: 64%;
  }

  .collage :global(.collage__window) {
    position: absolute;
    z-index: 2;
    left: 14%;
    top: 22%;
    width: 74%;
  }

  /* On phones the note window takes more of the width so its text stays legible; the posters still show at the
     corners. */
  @media (max-width: 640px) {
    .collage :global(.collage__window) {
      left: 6%;
      top: 20%;
      width: 88%;
    }

    .collage :global(.collage__tile) {
      left: 0;
      width: 24%;
    }
  }

  .collage :global(.collage__window img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--shadow-window);
  }

  .collage :global(.collage__tile) {
    position: absolute;
    z-index: 3;
    left: 4%;
    bottom: 0;
    width: 21%;
  }

  .collage :global(.collage__tile img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--shadow-window);
  }

  /* The factual trust strip: one quiet row with ticks. */
  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 32px;
    margin: 0 auto;
    padding: 8px 0 clamp(48px, 7vw, 88px);
    list-style: none;
    color: var(--muted);
    font-weight: 500;
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .proof li + li::before {
    content: none;
  }

  .proof :global(.proof__icon) {
    color: var(--accent);
  }

  /* Paper band with the brand line and the product demo. */
  .brandline {
    position: relative;
    padding-block: clamp(72px, 9vw, 128px);
    background: var(--card);
  }

  .brandline :global(.brandline__horizon) {
    justify-content: flex-start;
  }

  .brandline__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .brandline__text {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .steps__item {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted);
  }

  .steps__item strong {
    color: var(--ink);
    font-weight: 600;
  }

  .steps__number {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1;
    color: var(--accent);
  }

  .brandline :global(.demo-panel) {
    display: grid;
    align-items: center;
    min-height: clamp(420px, 44vw, 600px);
    padding: clamp(14px, 2.4vw, 32px);
  }

  .launch {
    padding-top: clamp(72px, 9vw, 128px);
  }

  /* During and later: feature rows; the screens float on wide photographs. */
  .moments {
    padding-bottom: 0;
  }

  .moments :global(.moments__shot) {
    width: 100%;
  }

  .moments :global(.moments__live) {
    --shot-ratio: 16 / 8.6;
    --shot-top: clamp(24px, 6%, 56px);
    --shot-side: 36%;
  }

  .moments :global(.moments__ask) {
    --shot-ratio: 16 / 8.6;
    --shot-top: clamp(24px, 6%, 64px);
    --shot-side: 10%;
  }

  /* The small things on the night band. */
  .details {
    margin-top: var(--section);
  }

  .details .capabilities {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--night-line);
    color: var(--on-night-muted);
  }

  .details .capabilities strong,
  .details .capabilities :global(a) {
    color: var(--on-night);
  }

  /* iPhone: a feature row with the phones on a wide photograph and the four points in a row. */
  .iphone__intro {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .iphone__get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .iphone :global(.iphone__panel) {
    min-height: clamp(420px, 48vw, 640px);
    display: grid;
    place-items: center;
    padding: clamp(24px, 4vw, 56px) 16px 0;
    overflow: hidden;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    margin: clamp(32px, 4vw, 48px) 0 0;
  }

  .points__item {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .points__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .points dd {
    margin: 0;
  }

  .points :global(.points__icon) {
    flex: none;
    color: var(--accent);
  }

  .iphone__note {
    margin-top: 24px;
  }

  /* Integrations on the paper band. */
  .integrations__head {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .integrations-section .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  /* Privacy: centred on the night band. */
  .trust-band {
    text-align: center;
  }

  .trust-band__title {
    max-width: 16ch;
    margin-inline: auto;
    color: var(--on-night);
  }

  .trust-band__tone {
    color: var(--on-night-muted);
  }

  .trust-band__lead {
    margin: 22px auto clamp(40px, 5vw, 64px);
  }

  .trust-band__wall {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--night-line);
  }

  .trust-band__wall .wall__item {
    align-content: start;
    min-height: 0;
    padding: 32px 22px;
  }

  .trust-band__wall .wall__item + .wall__item {
    border-left: 1px solid var(--night-line);
  }

  .trust-band__item-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--on-night);
  }

  .trust-band__item-text {
    font-size: 0.9375rem;
    color: var(--on-night-muted);
  }

  .trust-band__more {
    margin-top: 32px;
  }

  .trust-band__more :global(a) {
    color: var(--on-night);
  }

  /* Closing band. */
  .final {
    margin-top: var(--section);
  }

  .final .final__title {
    font-size: clamp(2.5rem, 1.4rem + 3.4vw, 4rem);
  }

  @media (max-width: 960px) {
    .hero,
    .brandline__grid,
    .integrations-section .split {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
    }

    .collage {
      max-width: 560px;
      margin-inline: auto;
    }

    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-band__wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-band__wall .wall__item:nth-child(odd) {
      border-left: 0;
    }
  }

  @media (max-width: 560px) {
    .points,
    .trust-band__wall {
      grid-template-columns: 1fr;
    }

    .trust-band__wall .wall__item + .wall__item {
      border-left: 0;
      border-top: 1px solid var(--night-line);
    }
  }

  /* Questions: centred title over one centred column. */
  .faq-block {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(80px, 10vw, 128px);
  }

  .faq-block .faq-block__title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 400;
    color: var(--ink);
    text-align: center;
  }

  .faq-block > :global(.faq) {
    width: min(820px, 100%);
  }

  /* ---------- Round two: the collage, the video on a photograph, the dark cards ---------- */
  /* Two columns only on wide screens; below 961 px the hero stays one column (text, then the collage). */
  @media (min-width: 961px) {
