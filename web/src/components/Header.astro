---
// Header: a floating pill with the logo, the main links, the theme switch, an outline "Sign in" pill and the orange
// "Get the app" pill (the download page, with both apps). Below 860 px the links, Sign in, the theme switch and both
// ways to get the app (GetApp.astro) fold into a `<details>` sheet under the pill; "Get the app" stays visible.
// src/client/theme.js binds every theme switch (without the script they are hidden and the theme follows the system).
// With a session in the tab the "Sign in" links turn into "Account" (src/client/header.ts). Text comes from the page
// (`/fi` in Finnish); the language choice is in the footer (Footer.astro).
import GetApp from "./GetApp.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { productName } from "../config";
import { copy, type CommonCopy } from "../copy";
import { type PageKey, routes } from "../routes";

interface Props {
  readonly page: PageKey;
  /** Interface text; English by default. */
  readonly text?: CommonCopy;
  /** Target of the "Features" link; the home page's features section by default. */
  readonly featuresHref?: string | undefined;
  /** Target of the "Pricing" link; the pricing page by default. */
  readonly pricingHref?: string | undefined;
}
const { page, text = copy.common, featuresHref = `${routes.home}#features`, pricingHref = routes.pricing } = Astro.props;
const menu: readonly { readonly href: string; readonly label: string }[] = [
  { href: featuresHref, label: text.nav.features },
  { href: routes.voiceTyping, label: text.nav.voiceTyping },
  { href: pricingHref, label: text.nav.pricing },
  { href: routes.compare, label: text.nav.compare },
  { href: routes.blog, label: text.nav.blog },
];
/** Extra links in the phone menu only (the wide header keeps four). */
const menuExtras: readonly { readonly href: string; readonly label: string }[] = [
  { href: routes.integrations, label: text.nav.integrations },
  { href: routes.mcp, label: text.nav.mcp },
];
const currentPath: string = routes[page];
---
<header id="site-header" class="site-header" data-account-href={routes.account} data-account-label={text.nav.account}>
  <div class="page site-header__pill">
    <a class="brand" href={routes.home} aria-label={text.homeLabel}>
      <Logo size={28} />
      <span class="brand__name">{productName}</span>
    </a>

    <nav class="nav" aria-label={text.navLabel}>
      <ul class="nav__list">
        {
          menu.map((link) => (
            <li>
              <a class="nav__link" href={link.href} aria-current={link.href === currentPath ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="theme-toggle site-header__theme" type="button" data-theme-toggle aria-pressed="false" aria-label={text.darkMode} title={text.darkMode}>
        <Icon name="moon" size={18} class="theme-toggle__icon theme-toggle__moon" />
        <Icon name="sun" size={18} class="theme-toggle__icon theme-toggle__sun" />
      </button>
      <a
        class="button button--secondary button--small site-header__sign-in"
        href={routes.signIn}
        data-session-link
        aria-current={routes.signIn === currentPath ? "page" : undefined}
      >
        {text.nav.signIn}
      </a>
      {/* The same pill on every device: the download page, with the Mac app and the iPhone app side by side. */}
      <a class="button button--primary button--small header-cta" href={routes.download} aria-current={routes.download === currentPath ? "page" : undefined}>
        <Icon name="apple" size={15} class="button__apple" />
        {text.headerGetApp}
      </a>
      <details class="menu">
        <summary class="menu__button">
          <span class="visually-hidden">{text.navLabel}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="menu__sheet">
          <ul class="menu__list">
            {
              menu.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.href === currentPath ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            {
              menuExtras.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.href === currentPath ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={routes.signIn} data-session-link>{text.nav.signIn}</a>
            </li>
          </ul>
          <GetApp common={text} macHref={routes.download} size="small" class="menu__get" />
          <button class="menu__theme" type="button" data-theme-toggle aria-pressed="false">
            <span class="theme-toggle__icons" aria-hidden="true">
              <Icon name="moon" size={16} class="theme-toggle__icon theme-toggle__moon" />
              <Icon name="sun" size={16} class="theme-toggle__icon theme-toggle__sun" />
            </span>
            {text.darkMode}
          </button>
        </div>
      </details>
    </div>
  </div>
</header>


<style>
  /* The header itself is transparent; only the pill is drawn. It stays 12 px from the top while the page scrolls. */
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    margin-top: 12px;
    pointer-events: none;
  }

  /* Once the page scrolls, a soft fade of the page colour fills the 12 px gap above the pill and its rounded corners,
     so content does not show through there. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: -12px 0 auto;
    height: 52px;
    background: linear-gradient(var(--bg) 40%, color-mix(in srgb, var(--bg) 0%, transparent));
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  /* Header: at the top of the page the links sit on the page itself; once the page scrolls the bar becomes a
     floating pill (src/client/header.ts sets `is-scrolled`). The links are centred between the logo and the actions. */
  .site-header__pill {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 20px;
    /* The pill is wider than the page by its own padding, so the logo and the Download pill line up with the content. */
    width: calc(var(--page) + 28px);
    height: 60px;
    padding: 0 13px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    pointer-events: auto;
    transition:
      background-color 240ms ease,
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .site-header.is-scrolled .site-header__pill {
    border-color: var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow:
      0 1px 2px var(--shadow-near),
      0 10px 30px -12px var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
    border-radius: 8px;
  }

  .nav {
    justify-self: center;
  }

  .nav__list {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: var(--ink);
    background: var(--soft);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  /* Theme switch: moon (light theme) and sun (dark theme) stacked; switching only rotates, scales and fades. */
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--soft);
    color: var(--ink);
  }

  :global(:root:not([data-theme])) [data-theme-toggle] {
    display: none;
  }

  .site-header :global(.theme-toggle__icon) {
    grid-area: 1 / 1;
    transition:
      transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 240ms ease;
  }

  .site-header :global(.theme-toggle__sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global(:root[data-theme="dark"]) .site-header :global(.theme-toggle__moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(:root[data-theme="dark"]) .site-header :global(.theme-toggle__sun) {
    opacity: 1;
    transform: none;
  }

  /* On the sign-in page the Sign in pill shows it is the current page. */
  .site-header__sign-in[aria-current="page"] {
    background: var(--soft);
    border-color: color-mix(in srgb, var(--ink) 40%, transparent);
  }

  .header-cta :global(.button__apple) {
    margin-top: -2px;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu__button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    cursor: pointer;
    list-style: none;
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  /* The sheet hangs under the pill's right end. */
  .menu__sheet {
    position: absolute;
    right: -10px;
    top: calc(100% + 18px);
    display: grid;
    gap: 6px;
    width: min(300px, calc(100vw - 2 * var(--gutter)));
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: var(--elevation);
  }

  .menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__list a,
  .menu__theme {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .menu__list a:hover,
  .menu__list a[aria-current="page"],
  .menu__theme:hover {
    background: var(--soft);
  }

  .menu__theme {
    border-top: 1px solid var(--line);
    border-radius: 0 0 12px 12px;
    color: var(--muted);
  }

  .menu :global(.menu__get) {
    gap: 8px;
    padding: 8px 6px 6px;
    border-top: 1px solid var(--line);
  }

  .theme-toggle__icons {
    display: grid;
  }

  @media (max-width: 860px) {
    .site-header__pill {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    /* Touch screens: every control in the bar is at least 44 px. */
    .site-header :global(.button--small),
    .menu__button {
      min-height: 44px;
    }

    .menu__button {
      width: 44px;
      height: 44px;
    }

    .nav,
    .site-header__sign-in,
    .site-header__theme {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 400px) {
    .site-header__pill {
      gap: 12px;
      padding-left: 14px;
    }

    .brand__name {
      font-size: 1rem;
    }
  }
</style>
