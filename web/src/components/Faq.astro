---
// Sık sorulan sorular: <details> ile açılır (betik yok), klavyeyle erişilebilir. Fiyat sayfasında Pro sunulunca değişebilen
// yanıt `data-tier-slot` adını taşır (src/client/pro-offer.ts).
import type { Faq, PricingFaq } from "../copy";
import { tierSlotAttributes } from "../lib/plans";

interface Props {
  readonly items: readonly (Faq | PricingFaq)[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item: Faq | PricingFaq) => (
      <details class="faq__item reveal">
        <summary class="faq__question">
          <span>{item.question}</span>
          <svg class="faq__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 8h10M8 3v10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <p class="faq__answer muted" {...tierSlotAttributes("answerSlot" in item ? item.answerSlot : null)}>{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* Questions are set in Inter (the serif is for headings); the plus is the accent orange. */
  .faq__icon {
    flex: none;
    color: var(--accent);
    transition: transform 200ms ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 40px 22px 0;
  }
</style>
