---
// A graded photograph panel (`.photo` in global.css) with a slot for what floats on it: an app window, a card or chips.
// The photograph is decorative (empty alt); Astro serves it as AVIF with a WebP fallback in the given widths. Only the
// first panel on a page loads eagerly (at normal priority, so it never competes with the fonts and the text that is
// the page's largest paint); the rest load lazily.
import { Picture } from "astro:assets";
import { type PhotoFocus, type PhotoName, photos } from "../lib/photos";

interface Props {
  readonly photo: PhotoName;
  readonly focus: PhotoFocus;
  /** Generated image widths (pixels). */
  readonly widths: readonly number[];
  /** The `sizes` attribute: the panel's width on the page. */
  readonly sizes: string;
  readonly priority: "high" | "lazy";
  readonly class: string;
}
const { photo, focus, widths, sizes, priority, class: extraClass } = Astro.props;
---

<div class:list={["photo", focus === "center" ? null : `photo--${focus}`, extraClass]}>
  <Picture
    src={photos[photo]}
    alt=""
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[...widths]}
    sizes={sizes}
    quality={46}
    loading={priority === "high" ? "eager" : "lazy"}
    decoding="async"
    pictureAttributes={{ class: "photo__media" }}
  />
  <slot />
</div>
