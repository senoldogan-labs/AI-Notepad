---
// Footer on the mist surface: the flip-book band (FooterFlipbook.astro), then the brand line set in the serif and where it is made, then product, learn (compare, languages, integrations,
// blog, MCP), account and company (contact, legal, font licences) links; a horizon rule; at the bottom the copyright
// line and the language choice (routes.ts `siteLanguages`: each language goes to its own home page, the current one is
// plain text). The operator's identity and address are on the privacy, terms and contact pages (single source:
// legal/operator.ts).
import FooterFlipbook from "./FooterFlipbook.astro";
import Horizon from "./Horizon.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { productName } from "../config";
import { copy, type CommonCopy } from "../copy";
import { type SiteLang, routes, siteLanguages } from "../routes";

interface Props {
  /** Alt bilginin metinleri; varsayılan İngilizce (`/fi` Fince geçer). */
  readonly text?: CommonCopy;
  /** "Ominaisuudet" bağlantısının hedefi; varsayılan ana sayfanın özellikler bölümü. */
  readonly featuresHref?: string | undefined;
  /** Sayfanın dili: dil seçiminde bağlantısız gösterilir. */
  readonly lang: SiteLang;
}
const { text = copy.common, featuresHref = `${routes.home}#features`, lang } = Astro.props;
const columns: readonly { readonly title: string; readonly links: readonly { readonly href: string; readonly label: string }[] }[] = [
  {
    title: text.footer.product,
    links: [
      { href: featuresHref, label: text.nav.features },
      { href: routes.voiceTyping, label: text.nav.voiceTyping },
      { href: routes.pricing, label: text.nav.pricing },
      { href: routes.download, label: text.nav.download },
    ],
  },
  {
    title: text.footer.learn,
    links: [
      { href: routes.compare, label: text.nav.compare },
      { href: routes.vsGranola, label: copy.compare.competitors.granola.title },
      { href: routes.vsOtter, label: copy.compare.competitors.otter.title },
      { href: routes.vsFireflies, label: copy.compare.competitors.fireflies.title },
      { href: routes.vsPoffle, label: copy.compare.competitors.poffle.title },
      { href: routes.languages, label: text.nav.languages },
      { href: routes.integrations, label: text.nav.integrations },
      { href: routes.blog, label: text.nav.blog },
      { href: routes.mcp, label: text.nav.mcp },
    ],
  },
  {
    title: text.footer.account,
    links: [
      { href: routes.signIn, label: text.nav.signIn },
      { href: routes.account, label: text.nav.account },
    ],
  },
  {
    title: text.footer.company,
    links: [
      { href: routes.contact, label: text.nav.contact },
      { href: routes.privacy, label: text.nav.privacy },
      { href: `${routes.privacy}#at-a-glance`, label: text.nav.dataHandling },
      { href: routes.terms, label: text.nav.terms },
      { href: `${routes.privacy}#website`, label: text.footer.cookies },
      { href: "/fonts/Inter-OFL.txt", label: text.footer.fontLicense },
      { href: "/fonts/Newsreader-OFL.txt", label: text.footer.serifFontLicense },
    ],
  },
];
---

<footer class="site-footer">
  <FooterFlipbook />
  <div class="page site-footer__grid">
    <div class="site-footer__about">
      <a class="site-footer__brand" href={routes.home} aria-label={text.homeLabel}>
        <Logo size={28} />
        <span>{productName}</span>
      </a>
      <p class="site-footer__tagline">{text.footer.tagline}</p>
      <p class="site-footer__made">{text.footer.madeIn}</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="site-footer__title">{column.title}</h2>
          <ul class="site-footer__links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <Horizon seed={text.footer.tagline} class="page site-footer__horizon" />
  <div class="page site-footer__bottom">
    <p>{text.footer.copyright}</p>
    <nav class="site-footer__languages" aria-label={text.footer.language}>
      <Icon name="globe" size={15} class="site-footer__globe" />
      <ul>
        {
          siteLanguages.map((language) => (
            <li>
              {language.lang === lang ? (
                <span class="site-footer__language--current">{language.label}</span>
              ) : (
                <a href={routes[language.page]} hreflang={language.lang} lang={language.lang}>
                  {language.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(56px, 8vw, 104px);
    padding-top: clamp(56px, 7vw, 88px);
    background: var(--soft);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) repeat(4, minmax(0, 1fr));
    gap: 36px 32px;
  }

  .site-footer__about {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    width: fit-content;
  }

  .site-footer__tagline {
    max-width: 14ch;
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .site-footer__made {
    color: var(--muted);
  }

  .site-footer__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .site-footer__links {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__links a:hover {
    text-decoration: underline;
  }

  .site-footer :global(.site-footer__horizon) {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .site-footer__bottom {
    padding-block: 20px 32px;
    color: var(--muted);
    font-size: 0.8125rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .site-footer__languages {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer__languages ul {
    display: flex;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__languages a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-footer__language--current {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }

    .site-footer__tagline {
      max-width: 20ch;
    }
  }
</style>
