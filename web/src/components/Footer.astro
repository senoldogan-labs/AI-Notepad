---
// Footer on the paper surface. Left: the brand (logo, one line on what the product is, the Mac download and the App Store
// badge). Right: three link columns (product, comparisons, company). A hairline, then the closing strip: the copyright
// with who makes the product, privacy, terms, cookies and company details (the business's legal name, business ID and
// address live only in the terms and the privacy policy, in their contact sections), and the language choice
// (routes.ts `siteLanguages`: each language goes to its own home page, the current one is plain text) beside the colour
// palette switch (Ember or Classic, src/client/theme.js); under it one line
// of small print with the typeface licences. The page ends there: no closing image.
import GetApp from "./GetApp.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { productName } from "../config";
import { copy, type CommonCopy } from "../copy";
import { type SiteLang, routes, siteLanguages } from "../routes";

interface Props {
  /** Footer text: English or Finnish (`/fi`). */
  readonly text: CommonCopy;
  /** Target of the "Features" link (the home page's features section, or the Finnish one). */
  readonly featuresHref: string;
  /** The page's language: shown without a link in the language choice. */
  readonly lang: SiteLang;
}
const { text, featuresHref, lang } = Astro.props;
const columns: readonly { readonly title: string; readonly links: readonly { readonly href: string; readonly label: string }[] }[] = [
  {
    title: text.footer.product,
    links: [
      { href: featuresHref, label: text.nav.features },
      { href: routes.voiceTyping, label: text.nav.voiceTyping },
      { href: routes.integrations, label: text.nav.integrations },
      { href: routes.mcp, label: text.nav.mcp },
      { href: routes.languages, label: text.nav.languages },
      { href: routes.pricing, label: text.nav.pricing },
      { href: routes.download, label: text.nav.download },
      { href: routes.changelog, label: text.footer.changelog },
    ],
  },
  {
    title: text.footer.compare,
    links: [
      { href: routes.compare, label: text.footer.allComparisons },
      { href: routes.vsGranola, label: copy.compare.competitors.granola.title },
      { href: routes.vsOtter, label: copy.compare.competitors.otter.title },
      { href: routes.vsFireflies, label: copy.compare.competitors.fireflies.title },
      { href: routes.vsPoffle, label: copy.compare.competitors.poffle.title },
    ],
  },
  {
    title: text.footer.company,
    links: [
      { href: routes.blog, label: text.nav.blog },
      { href: routes.contact, label: text.nav.contact },
      { href: routes.press, label: text.footer.press },
      { href: routes.account, label: text.footer.yourAccount },
      { href: routes.privacy, label: text.nav.privacy },
      { href: `${routes.privacy}#at-a-glance`, label: text.nav.dataHandling },
      { href: routes.terms, label: text.nav.terms },
    ],
  },
];
---

<footer class="site-footer">
  <div class="page site-footer__top">
    <div class="site-footer__about">
      <a class="site-footer__brand" href={routes.home} aria-label={text.homeLabel}>
        <Logo size={28} />
        <span>{productName}</span>
      </a>
      <p class="site-footer__summary">{text.footer.summary}</p>
      <GetApp common={text} macHref={routes.download} size="small" class="site-footer__get" />
    </div>
    {
      columns.map((column) => (
        <nav class="site-footer__column" aria-label={column.title}>
          <p class="site-footer__title">{column.title}</p>
          <ul class="site-footer__links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    {/* Phones: the same groups as closed disclosures (44 px rows), so the footer stays short. */}
    <div class="site-footer__accordion">
      {
        columns.map((column) => (
          <details class="site-footer__group">
            <summary class="site-footer__summary-row">
              {column.title}
              <Icon name="chevron-down" size={16} class="site-footer__chevron" />
            </summary>
            <ul class="site-footer__links">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
  <div class="page site-footer__bottom">
    <div class="site-footer__legal">
      <p>{text.footer.copyright} · {text.footer.madeBy}</p>
      <ul>
        <li><a href={routes.privacy}>{text.footer.privacyShort}</a></li>
        <li><a href={routes.terms}>{text.footer.termsShort}</a></li>
        <li><a href={`${routes.privacy}#website`}>{text.footer.cookies}</a></li>
        <li><a href={`${routes.terms}#contact`}>{text.footer.companyDetails}</a></li>
      </ul>
    </div>
    <div class="site-footer__prefs">
    {/* Colour palette (theme.js binds the buttons and remembers the choice; without the script the switch is hidden). */}
    <div class="palette-switch" role="group" aria-label={text.footer.palette}>
      <button type="button" class="palette-switch__option" data-palette-choice="ember" aria-pressed="true">
        <span class="palette-switch__dot palette-switch__dot--ember" aria-hidden="true"></span>{text.footer.paletteEmber}
      </button>
      <button type="button" class="palette-switch__option" data-palette-choice="classic" aria-pressed="false">
        <span class="palette-switch__dot palette-switch__dot--classic" aria-hidden="true"></span>{text.footer.paletteClassic}
      </button>
    </div>
    <nav class="site-footer__languages" aria-label={text.footer.language}>
      <Icon name="globe" size={14} class="site-footer__icon" />
      <ul>
        {
          siteLanguages.map((language) => (
            <li>
              {language.lang === lang ? (
                <span class="site-footer__language--current" aria-current="true">{language.label}</span>
              ) : (
                <a href={routes[language.page]} hreflang={language.lang} lang={language.lang}>
                  {language.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    </div>
    <p class="site-footer__fine">
      {text.footer.typefaces}{" "}
      <a href="/fonts/Inter-OFL.txt">Inter</a>, <a href="/fonts/Newsreader-OFL.txt">Newsreader</a> (SIL OFL 1.1).
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 8vw, 112px);
    padding-top: clamp(56px, 6vw, 80px);
    border-top: 1px solid var(--line);
    background: var(--card);
    font-size: 0.9375rem;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: 40px 32px;
    padding-bottom: clamp(48px, 5vw, 72px);
  }

  .site-footer__about {
    display: grid;
    gap: 14px;
    align-content: start;
    justify-items: start;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-footer__summary {
    max-width: 30ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .site-footer__about :global(.site-footer__get) {
    gap: 10px;
    margin-top: 8px;
  }

  /* Column titles: small sans, like the navigation. */
  .site-footer__title {
    margin-bottom: 12px;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .site-footer__links {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  /* Each link is a 36 px row (44 px on touch screens) so the columns stay easy to tap. */
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .site-footer__links a:hover,
  .site-footer__legal a:hover,
  .site-footer__fine a:hover,
  .site-footer__languages a:hover {
    color: var(--ink);
  }

  .site-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px 28px;
    padding-block: 22px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
  }

  .site-footer__legal ul,
  .site-footer__languages ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__legal a,
  .site-footer__languages a,
  .site-footer__language--current {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .site-footer__prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
  }

  /* Palette switch: two small segments; the chosen one is filled. */
  .palette-switch {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }

  :global(:root:not([data-palette])) .palette-switch {
    display: none;
  }

  .palette-switch__option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .palette-switch__option:hover {
    color: var(--ink);
  }

  .palette-switch__option[aria-pressed="true"] {
    background: var(--soft);
    color: var(--ink);
    font-weight: 600;
  }

  .palette-switch__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .palette-switch__dot--ember {
    background: linear-gradient(135deg, #e8d3b8, #a5664b 55%, #4a2519);
  }

  .palette-switch__dot--classic {
    background: linear-gradient(135deg, #ffffff 0 50%, #c4470a 50%);
  }

  @media (forced-colors: active) {
    .palette-switch__option[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }

  .site-footer__languages {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer :global(.site-footer__icon) {
    flex: none;
    opacity: 0.8;
  }

  .site-footer__language--current {
    color: var(--ink);
    font-weight: 600;
  }

  .site-footer__fine {
    grid-column: 1 / -1;
    max-width: 80ch;
    font-size: 0.75rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .site-footer__fine a {
    text-decoration: underline;
    text-decoration-color: var(--line);
  }

  @media (max-width: 960px) {
    .site-footer__top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }

  .site-footer__accordion {
    display: none;
  }

  @media (max-width: 640px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-bottom: 32px;
    }

    .site-footer__column {
      display: none;
    }

    .site-footer__accordion {
      display: block;
      border-top: 1px solid var(--line);
    }

    .site-footer__group {
      border-bottom: 1px solid var(--line);
    }

    .site-footer__summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 52px;
      font-weight: 600;
      font-size: 0.9375rem;
      list-style: none;
      cursor: pointer;
    }

    .site-footer__summary-row::-webkit-details-marker {
      display: none;
    }

    .site-footer :global(.site-footer__chevron) {
      color: var(--muted);
      transition: transform 200ms ease;
    }

    .site-footer__group[open] :global(.site-footer__chevron) {
      transform: rotate(180deg);
    }

    .site-footer__group .site-footer__links {
      padding-bottom: 10px;
    }

    .site-footer__links a,
    .site-footer__legal a,
    .site-footer__languages a,
    .site-footer__language--current,
    .palette-switch__option {
      min-height: 44px;
    }

    .site-footer__bottom {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
