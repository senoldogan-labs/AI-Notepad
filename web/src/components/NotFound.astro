---
// "Page not found" view: the 404 page and an admin address opened without access or a session share it (so the admin
// panel's existence is not revealed). A large serif numeral over the horizon mark.
import Horizon from "./Horizon.astro";
import Icon from "./Icon.astro";
import { copy, type NotFoundCopy } from "../copy";
import { routes } from "../routes";

const text: NotFoundCopy = copy.notFound;
/** Where people usually wanted to go. */
const links: readonly { readonly href: string; readonly label: string }[] = [
  { href: routes.pricing, label: copy.common.nav.pricing },
  { href: routes.download, label: copy.common.nav.download },
  { href: routes.blog, label: copy.common.nav.blog },
  { href: routes.contact, label: copy.common.nav.contact },
];
---

<section class="narrow not-found">
  <p class="code tabular" aria-hidden="true">404</p>
  <Horizon seed={text.title} class="not-found__horizon" />
  <h1 class="title-l">{text.title}</h1>
  <p class="muted">{text.text}</p>
  <a class="button button--primary" href={routes.home}>
    {text.home}
    <Icon name="arrow-right" size={16} class="" />
  </a>
  <nav class="not-found__links" aria-label={text.linksLabel}>
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</section>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding-block: clamp(64px, 12vw, 140px);
    text-align: center;
  }

  .code {
    font-family: var(--serif);
    font-size: clamp(5rem, 16vw, 9rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--muted);
  }

  .not-found :global(.not-found__horizon) {
    width: min(100%, 320px);
    margin-bottom: 12px;
  }

  .not-found :global(.not-found__horizon)::before {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .not-found .button {
    margin-top: 10px;
  }

  .not-found__links ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
  }

  .not-found__links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
