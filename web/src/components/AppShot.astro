---
// A real Mac screenshot floating in a photograph panel (PhotoPanel): wide windows are cut by the panel's bottom
// edge, the narrow live panel floats with space around it; the window's own soft shadow follows its transparent
// rounded corners. Screenshots are Retina captures (scripts/make-screenshots.sh), served as AVIF (WebP fallback) in
// the given widths; they always load lazily, and the home hero's is preloaded on wide screens (`priority`). iPhone
// screens are not drawn here: the home page's iPhone section shows them in a device frame (scripts/make-iphone-shots.ts). Placement of the panel (`variant`) and narrow-screen zoom are set by the page
// (Landing.astro).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagePreload from "./ImagePreload.astro";
import PhotoPanel from "./PhotoPanel.astro";
import type { PhotoFocus, PhotoName } from "../lib/photos";

/** The panel's shape: a wide window (main window) or a narrow panel (live panel). */
export type AppShotVariant = "window" | "panel";

/** A label pinned to the screenshot: the dot marks an element in the image, the pill opens to its right or left.
 * Its position (`left`, `top`: percent of the image) is set in the page's CSS through `class`; the site CSP allows no
 * inline styles. Hidden on narrow screens; the image's text equivalent is its `alt`. */
export interface ShotCallout {
  readonly text: string;
  readonly class: string;
  readonly side: "left" | "right";
}

interface Props {
  readonly image: ImageMetadata;
  readonly alt: string;
  readonly photo: PhotoName;
  readonly focus: PhotoFocus;
  readonly variant: AppShotVariant;
  /** Generated screenshot widths (pixels). */
  readonly widths: readonly number[];
  /** The screenshot's `sizes` attribute. */
  readonly sizes: string;
  /** The photograph's `sizes` attribute (the panel's width). */
  readonly photoSizes: string;
  /** "wide-lcp": the home hero, the largest paint on wide screens only. Its screenshot is preloaded at high priority
   * on screens wider than 640 px; on phones the headline is the largest paint and the screenshot sits at the bottom of
   * the first screen, so there it loads lazily and does not compete with the text. "lazy": every other window. */
  readonly priority: "wide-lcp" | "lazy";
  readonly class: string;
  readonly callouts: readonly ShotCallout[];
}
const { image, alt, photo, focus, variant, widths, sizes, photoSizes, priority, class: extraClass, callouts } = Astro.props;
/** AVIF quality of the screenshot: interface text stays crisp at 62 (checked against 72), ~20 % smaller. */
const quality: number = 62;
---

{priority === "wide-lcp" && <ImagePreload image={image} widths={widths} sizes={sizes} quality={quality} media="(min-width: 641px)" />}
<figure class:list={["shot", `shot--${variant}`, extraClass]}>
  <PhotoPanel photo={photo} focus={focus} widths={[640, 960, 1280, 1920, 2560, 3840]} sizes={photoSizes} priority="lazy" class="shot__cover">
    <div class="shot__frame">
      <Picture
        src={image}
        alt={alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[...widths]}
        sizes={sizes}
        quality={quality}
        loading="lazy"
        decoding="async"
        class="shot__image"
      />
      {
        callouts.map((callout: ShotCallout) => (
          <span class:list={["shot__callout", `shot__callout--${callout.side}`, callout.class]} aria-hidden="true">
            <span class="shot__dot" />
            <span class="chip shot__pill">{callout.text}</span>
          </span>
        ))
      }
    </div>
  </PhotoPanel>
</figure>
<style>
  .shot {
    display: grid;
    min-width: 0;
    margin: 0;
  }

  /* The window floats with space above and at the sides and is cut by the bottom edge. */
  .shot :global(.shot__cover) {
    display: block;
    padding: var(--shot-top) var(--shot-side) 0;
    aspect-ratio: var(--shot-ratio);
  }

  .shot--window {
    --shot-ratio: 16 / 10;
    --shot-top: clamp(22px, 5.5%, 64px);
    --shot-side: clamp(18px, 7%, 96px);
  }

  .shot--panel {
    --shot-ratio: 4 / 5;
    --shot-top: clamp(22px, 9%, 56px);
    --shot-side: clamp(18px, 14%, 72px);
  }

  .shot__frame {
    position: relative;
  }

  .shot__frame > :global(picture) {
    display: block;
  }

  /* Açıklama balonu: nokta öğenin üstünde (konum sayfanın CSS'inde), balon yanında. Durgundur. */
  .shot__callout {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-7px, -50%);
    pointer-events: none;
  }

  .shot__callout--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 7px), -50%);
  }

  .shot__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.9),
      0 4px 12px rgb(0 0 0 / 0.25);
  }

  .shot__pill {
    min-height: 0;
    padding: 7px 14px;
    font-size: clamp(0.75rem, 1.1vw, 0.875rem);
  }

  @media (max-width: 640px) {
    .shot__callout {
      display: none;
    }
  }

  /* Dar ekranda Home pencereyi büyütüp kaydırabilir (`--shot-zoom`, `--shot-shift`); yoksa pencere kartın içine sığar. */
  /* Gölge görselin saydamlığını izler (pencerenin yuvarlak köşeleri); görsel durgun, gölge bir kez çizilir. */
  .shot :global(.shot__image) {
    display: block;
    width: var(--shot-zoom, 100%);
    max-width: none;
    margin-inline-start: var(--shot-shift, 0);
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.14)) drop-shadow(0 26px 48px rgb(0 0 0 / 0.32));
  }

</style>
