---
// Uygulamanın "son toplantılar" kartı, sade hâliyle: şablon etiketi ve zaman, başlık, görev ve karar sayısı, notun
// başındaki görevlerden biri. Süs gradyanı yok; kart her temada sayfanın kart rengini kullanır.
import type { LibraryMeeting } from "../copy";

interface Props {
  readonly meeting: LibraryMeeting;
}
const { meeting } = Astro.props;
---

<article class="meeting">
  <p class="meeting__top">
    <span class="meeting__template">{meeting.template}</span>
    <span class="meeting__when">{meeting.when}</span>
  </p>
  <h3 class="meeting__title">{meeting.title}</h3>
  <p class="meeting__counts">
    <span>{meeting.tasks}</span>
    <span aria-hidden="true">·</span>
    <span>{meeting.decisions}</span>
  </p>
  <p class="meeting__task">
    <span class="meeting__box" aria-hidden="true"></span>
    {meeting.nextTask}
  </p>
</article>

<style>
  .meeting {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    box-shadow: 0 1px 2px var(--shadow-near);
  }

  .meeting__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 10px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .meeting__template {
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--ink);
    font-weight: 600;
  }

  .meeting__when {
    font-variant-numeric: tabular-nums;
  }

  .meeting__title {
    margin-top: 4px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .meeting__counts {
    display: flex;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .meeting__task {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .meeting__box {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    border-radius: 4px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 35%, transparent);
  }
</style>
