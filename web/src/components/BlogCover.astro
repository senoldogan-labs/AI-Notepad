---
// Blog yazısının kapağı, sitenin fotoğraf dilinde: yazının sırasına göre seçilen (aşağıda `coverOrder`)
// bir fotoğraf ve üstünde kâğıt bir kart içinde başlık. Ölçüler kapağın genişliğine göredir (`cqi`): yazı sayfasının
// başı, dizin kartı ve paylaşım görseli (scripts/make-blog-og.ts bu öğeyi 1200 px genişlikte çizer) aynı görünür.
// Başlık öğesini sayfa verir (slot): yazı sayfasında `h1`. Kartlarda slot boştur: kapak yalnız fotoğraftır, başlık altında.
// `data-og-cover` paylaşım görselinin kaynağını işaretler. Fotoğraf süstür (boş alt metin).
import { Picture } from "astro:assets";
import { type BlogPost, coverTitleSize } from "../lib/blog";
import type { FilmPalette } from "../lib/film";
import { type CollectionEntry, getCollection } from "astro:content";
import { type PhotoName, photos } from "../lib/photos";

interface Props {
  readonly post: BlogPost;
  readonly class: string;
  /** Kapağın sayfadaki genişliği (`sizes`); dizin kartında küçük, yazı sayfasında sayfa genişliği. */
  readonly sizes?: string;
  /** Yazı sayfasının başında kapak ilk ekrandadır: hemen ve yüksek öncelikle yüklenir; kartlarda tembel. */
  readonly eager?: boolean;
}
const { post, class: extraClass, sizes = "(max-width: 760px) calc(100vw - 40px), 400px", eager = false } = Astro.props;
/**
 * Kapak görselleri sırayla dağıtılır: yazılar (taslak ve tarihi gelmemiş olanlar dahil, böylece yayımlanınca kapak
 * değişmez) yayın tarihine göre eskiden yeniye dizilir ve her biri sıradaki görseli alır; liste bitince başa döner.
 * `cover` verilmemiş komşu yazılar böylece farklı görsel alır (renk ailesi seçilmiş bir yazı komşusuyla aynı görsele
 * denk gelebilir).
 */
const coverOrder: readonly PhotoName[] = [
  "dune-sunset",
  "wave-coral",
  "lilac-peaks",
  "wave-ocean",
  "painted-hills",
  "wave-lilac",
  "dune-ridge",
  "pink-sands",
  "wave-sunset",
  "red-rock-glow",
  "pastel-ridges",
  "wave-dawn",
  "dawn-range",
  "white-dunes",
  "dune-blush",
  "red-mountain",
  "dune-pale",
  "dune-crest",
];
const allPosts: readonly CollectionEntry<"blog">[] = [...(await getCollection("blog"))].sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">): number =>
    a.data.published.getTime() - b.data.published.getTime() || a.id.localeCompare(b.id),
);
/**
 * The front matter's `cover` (the colour family the admin panel's cover picker sets) picks the photograph of that
 * colour; without it the post takes its place in `coverOrder`.
 */
const paletteCovers: Readonly<Record<FilmPalette, PhotoName>> = {
  sunset: "dune-sunset",
  coral: "wave-coral",
  ocean: "wave-ocean",
  mint: "dune-ridge",
  rose: "pink-sands",
  violet: "wave-lilac",
};
const rank: number = allPosts.findIndex((entry: CollectionEntry<"blog">): boolean => entry.id === post.slug);
const ordered: PhotoName | undefined = coverOrder[rank % coverOrder.length];
if (rank < 0 || ordered === undefined) {
  throw new Error(`BlogCover: post ${JSON.stringify(post.slug)} is not in the blog collection`);
}
const photo: PhotoName = post.cover === null ? ordered : paletteCovers[post.cover];
/** Cards and the featured post show the photograph alone (their title sits under it); the post page puts its title on the paper card. */
const titled: boolean = Astro.slots.has("default");
---

<div class:list={["blog-cover", titled ? `blog-cover--titled blog-cover--${coverTitleSize(post.title)}` : null, extraClass]} data-og-cover={post.slug}>
  <div class="blog-cover__frame">
    <Picture
      src={photos[photo]}
      alt=""
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 720, 960, 1440, 1920, 2560]}
      sizes={sizes}
      quality={72}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      pictureAttributes={{ class: "blog-cover__photo" }}
    />
    {
      titled && (
        <div class="blog-cover__card">
          <div class="blog-cover__body">
            <slot />
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Kapak kendi genişliğinin kabıdır: içindeki ölçüler `cqi` ile ölçeklenir. */
  .blog-cover {
    container-type: inline-size;
    min-width: 0;
  }

  .blog-cover__frame {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 1200 / 630;
    padding: 5.2cqi;
    overflow: hidden;
    border-radius: clamp(6px, 1cqi, 10px);
    background: #c9c2b4;
  }

  .blog-cover :global(.blog-cover__photo),
  .blog-cover :global(.blog-cover__photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blog-cover :global(.blog-cover__photo img) {
    object-fit: cover;
  }

  /* Başlık kâğıt kartta: yazı hiçbir zaman fotoğrafın doğrudan üstünde değil. */
  .blog-cover__card {
    position: relative;
    display: grid;
    gap: 2.4cqi;
    width: min(76%, 100%);
    padding: 3.6cqi 4cqi 4cqi;
    border-radius: clamp(6px, 1.2cqi, 14px);
    background: #f7f7f2;
    color: #292929;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 18px 40px -16px rgb(0 0 0 / 0.4);
  }

  .blog-cover__body {
    display: grid;
    align-content: start;
    gap: 3.2cqi;
    min-height: 0;
  }

  .blog-cover :global(.blog-cover__title) {
    margin: 0;
    color: #292929;
    font-family: var(--serif);
    font-size: 5.6cqi;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .blog-cover--medium :global(.blog-cover__title) {
    font-size: 4.8cqi;
  }

  .blog-cover--small :global(.blog-cover__title) {
    font-size: 4.2cqi;
    line-height: 1.08;
  }

  /* Dar kapakta (telefon) daha yüksek oran ve daha büyük yazı: başlık okunur kalır. Başlıksız kapaklar hep aynı orandadır. */
  @container (max-width: 360px) {
    .blog-cover--titled .blog-cover__frame {
      aspect-ratio: 5 / 4;
      padding: 6cqi;
    }

    .blog-cover__card {
      width: 100%;
      padding: 5cqi 5.4cqi 5.6cqi;
    }

    .blog-cover :global(.blog-cover__title) {
      font-size: 8.2cqi;
    }

    .blog-cover--medium :global(.blog-cover__title) {
      font-size: 7.4cqi;
    }

    .blog-cover--small :global(.blog-cover__title) {
      font-size: 6.6cqi;
    }
  }
</style>
