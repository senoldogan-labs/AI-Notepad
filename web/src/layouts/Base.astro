---
// Tüm sayfaların iskeleti: başlık ve açıklama, kanonik adres, Open Graph, simgeler, tema betiği, üst çubuk ve alt bilgi.
// Sayfanın dili (`lang`) ve arayüz metinleri (`common`) sayfadan gelir: `/fi` Fince metinlerle, aynı iskeletle çizilir.
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PullReveal from "../components/PullReveal.astro";
import MacOnlyDialog from "../components/MacOnlyDialog.astro";
import interFontUrl from "../assets/fonts/InterVariable-latin.woff2?url";
import serifFontUrl from "../assets/fonts/Newsreader-display-latin.woff2?url";
import themeScript from "../client/theme.js?raw";
import { productName } from "../config";
import { copy, type CommonCopy, type PageMeta } from "../copy";
import type { SocialCard } from "../lib/social";
import { ogImageSize } from "../lib/structured-data";
import { type PageAlternate, type SiteLang, blogFeedPath, routes, type SitePage, pageAlternates, sitePageKey, sitePagePath } from "../routes";
import { siteConfig } from "../site";

interface Props {
  /** Sabit sayfa ya da blog yazısı: kanonik adres ve üst çubuktaki etkin bağlantı bundan. */
  readonly page: SitePage;
  readonly meta: PageMeta;
  /** Kişiye özel sayfalar (hesap, yönetim) ve 404 arama motorlarına kapalıdır; kanonik adresleri de verilmez. */
  readonly indexed: boolean;
  /** Paylaşım kartı: sabit sayfalarda `websiteCard` (public/og.png), blog yazısında kendi görseli ve tarihleri. */
  readonly social: SocialCard;
  /** Sayfanın dili (`<html lang>`, `og:locale`); varsayılan İngilizce. */
  readonly lang?: SiteLang;
  /** Üst çubuk, alt bilgi ve atlama bağlantısının metinleri; varsayılan İngilizce (copy.common). */
  readonly common?: CommonCopy;
  /** Üst çubuktaki "Ominaisuudet" bağlantısının hedefi; varsayılan ana sayfanın özellikler bölümü. */
  readonly featuresHref?: string | undefined;
  /** Üst çubuktaki "Hinnat" bağlantısının hedefi; varsayılan fiyat sayfası. */
  readonly pricingHref?: string | undefined;
}
const { page, meta, indexed, social, lang = "en", common = copy.common, featuresHref, pricingHref } = Astro.props;
const origin: string = siteConfig.siteOrigin;
const canonical: string = `${origin}${sitePagePath(page)}`;
const ogImage: string = social.kind === "article" ? social.image : `${origin}/og.png`;
const ogImageAlt: string = social.kind === "article" ? social.imageAlt : common.ogImageAlt;
/** Öbür dildeki sürüm (varsa): `hreflang` bağlantıları. */
const alternate: PageAlternate | undefined = typeof page === "string" ? pageAlternates[page] : undefined;
/**
 * Dil eşi olan sayfanın `hreflang` kümesi: Google her sürümün kendini de, öbürünü de listelemesini ister; dili
 * eşleşmeyen ziyaretçi için `x-default` İngilizce sürümdür.
 */
const hreflangLinks: ReadonlyArray<{ readonly lang: string; readonly href: string }> =
  alternate === undefined
    ? []
    : [
        { lang, href: canonical },
        { lang: alternate.lang, href: `${origin}${sitePagePath(alternate.page)}` },
        { lang: "x-default", href: lang === "en" ? canonical : `${origin}${sitePagePath(alternate.page)}` },
      ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Tarayıcı çubuğunun rengi; theme.js elle seçilen temaya göre ikisini de günceller, bu yüzden betikten önce gelir. */}
    <meta name="theme-color" content="#f6f0e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100e0d" media="(prefers-color-scheme: dark)" />
    {/* Tema ilk boyamadan önce uygulanır. Satır içi: ayrı istek yavaş telefonda ilk boyamayı geciktiriyordu; CSP izni
        derlemede hesaplanan sha256 özetiyle verilir (astro.config.ts). */}
    <script is:inline set:html={themeScript}></script>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {indexed ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {indexed ? hreflangLinks.map((link) => <link rel="alternate" hreflang={link.lang} href={link.href} />) : null}
    {/* Yazı tipleri içerik özetli adla (`/_astro/…`, değişmez önbellek) sunulur: dosya güncellenince adres de değişir,
        CDN eski kopyayı vermez. */}
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFontUrl} as="font" type="font/woff2" crossorigin />
    {/* Simge köşesiz, tam siyah karedir: Google arama sonuçlarında daire içinde gösterir; yuvarlak köşeli karede köşeler beyaz kalırdı. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={copy.blog.feedTitle} href={blogFeedPath} />
    <meta property="og:type" content={social.kind} />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === "fi" ? "fi_FI" : "en_US"} />
    {
      social.kind === "article" && (
        <>
          <meta property="article:published_time" content={social.published} />
          <meta property="article:modified_time" content={social.modified} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* Sayfaya özgü ek başlık öğeleri (ör. paylaşım sayfasının `referrer` politikası). */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{common.skipLink}</a>
    {/* Sayfanın kendisi; sonundaki çekmede yukarı kayar ve arkasındaki PullReveal görünür. */}
    <div id="page-shell" class="page-shell">
      <Header page={sitePageKey(page)} text={common} featuresHref={featuresHref} pricingHref={pricingHref} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer text={common} featuresHref={featuresHref ?? `${routes.home}#features`} lang={lang} />
    </div>
    <PullReveal />
    <MacOnlyDialog text={common} />
  </body>
</html>

{/* One module for every page's shared behaviour (header, pull-to-reveal, Mac-only dialog, anchor focus, download
    campaign) instead of one per component: on a slow phone each extra request before the first paint costs a round
    trip. */}
<script>
  import "../client/header";
  import "../client/pull-reveal";
  import "../client/mac-only";
  import "../client/anchor-focus";
  import "../client/download-campaign";
</script>
