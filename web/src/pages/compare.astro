---
// Karşılaştırma dizini: başta ürünü seçmek için nedenler (vurgulu), her karşılaştırma sayfasına bir kart ve beş ürünün
// kısa özet tablosu (ilk sütun bizim). Değerler copy.ts `compare`'den.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import ComparisonTable, { type ComparisonColumn } from "../components/ComparisonTable.astro";
import CtaBand from "../components/CtaBand.astro";
import WhyUs from "../components/WhyUs.astro";
import Icon from "../components/Icon.astro";
import { productName } from "../config";
import { copy, type CompareCopy, type Competitor, type CompetitorCopy } from "../copy";
import { infoPageStructuredData, structuredDataJson } from "../lib/structured-data";
import { type PageKey, pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: CompareCopy = copy.compare;
/** Rakiplerin karşılaştırma sayfaları (dizindeki sırayla). */
const competitorPages: readonly { readonly competitor: Competitor; readonly page: PageKey }[] = [
  { competitor: "granola", page: "vsGranola" },
  { competitor: "otter", page: "vsOtter" },
  { competitor: "fireflies", page: "vsFireflies" },
  { competitor: "poffle", page: "vsPoffle" },
];
const columns: readonly ComparisonColumn[] = [
  { name: productName, values: text.us },
  ...competitorPages.map((entry): ComparisonColumn => ({ name: text.competitors[entry.competitor].name, values: text.competitors[entry.competitor].values })),
];
/** Gezinti izi: ana sayfa › karşılaştırma (JSON-LD). */
const structuredData: string = structuredDataJson(infoPageStructuredData(siteConfig, [{ name: text.eyebrow, url: pageUrl("compare", siteConfig.siteOrigin) }], []));
---

<Base page="compare" meta={text.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="page compare-intro">
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
  </section>

  <WhyUs id="compare-why-title" />

  <section class="page compare-cards" aria-label={text.pickTitle}>
    {
      competitorPages.map((entry) => {
        const them: CompetitorCopy = text.competitors[entry.competitor];
        return (
          <a class="card compare-card" href={routes[entry.page]}>
            <h2 class="title-m">{them.title}</h2>
            <p class="muted">{them.summary}</p>
            <span class="text-link">
              {text.readComparison} <Icon name="arrow-right" size={16} class="" />
            </span>
          </a>
        );
      })
    }
  </section>

  <section class="page compare-overview" aria-labelledby="overview-title">
    <h2 class="title-l" id="overview-title">{text.overviewTitle}</h2>
    <p class="small muted">{text.checked}</p>
    <ComparisonTable caption={text.overviewTitle} topics={text.overviewTopics} columns={columns} />
    <p class="small muted">{text.missingNote}</p>
  </section>

  <CtaBand id="compare-cta-title" title={text.ctaTitle} text={text.ctaText} photo="wave-lilac" />

  <p class="page small muted compare-trademarks">{text.trademarks}</p>
</Base>

<style>
  .compare-intro {
    display: grid;
    gap: 18px;
    padding-block: clamp(48px, 8vw, 96px) clamp(28px, 4vw, 44px);
  }

  .compare-cards {
    margin-top: clamp(32px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .compare-card {
    display: grid;
    align-content: start;
    gap: 10px;
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .compare-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, var(--line));
  }

  .compare-overview {
    display: grid;
    gap: 16px;
    margin-top: clamp(48px, 7vw, 88px);
  }

  .compare-trademarks {
    margin-top: 32px;
  }

  @media (max-width: 760px) {
    .compare-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
