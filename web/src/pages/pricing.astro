---
// Fiyat sayfası: iki plan (aylık 5,99 $, yıllık 49 $; vergiler dahil; yıllık önerilen), davet sayfasına bağlantı, neler
// dahil (yalnızca özellikler), sınırlar (deneme, aylık saat, toplantı süresi, iptal), ödeme ve vergiler (satıcı Link) ve
// SSS. Her bilgi sayfada bir kez geçer. Plan düğmeleri hesap sayfasına seçilen planla ve "ödemeye devam et" niyetiyle
// gider (`/account?plan=…&checkout=1`); hesap sayfası oturum yoksa önce girişe yönlendirir, giriş bitince seçilen planla
// doğrudan Stripe Checkout açılır.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { copy, type CommonCopy, type IconItem, type IconText, type PlanOptionCopy, type PricingCopy } from "../copy";
import { faqStructuredData, structuredDataJson } from "../lib/structured-data";
import { recommendedPlan } from "../lib/plans";
import { pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: PricingCopy = copy.pricing;
const common: CommonCopy = copy.common;
/** Arama motorları için sayfanın sık sorulan soruları (JSON-LD; aşağıdaki `Faq` ile aynı girdiler). */
const structuredData: string = structuredDataJson(faqStructuredData(text.faq, pageUrl("pricing", siteConfig.siteOrigin)));
/** Plan notunun davet bağlantısından önceki ve sonraki parçası; metinde tam bir `{invite}` yoksa derleme durur. */
const [noteBefore, noteAfter]: readonly [string, string] = ((): readonly [string, string] => {
  const [before, after, ...rest]: readonly string[] = text.plansNote.split("{invite}");
  if (before === undefined || after === undefined || rest.length > 0) {
    throw new Error(`copy.pricing.plansNote tam bir "{invite}" yer tutucusu içermeli; gelen: ${JSON.stringify(text.plansNote)}`);
  }
  return [before, after];
})();
---

<Base page="pricing" meta={text.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  {/* Pricing: a centred title, the plans side by side with what every plan includes, the limits, the
      questions centred, and the closing band. */}
  <section class="page page-head intro">
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
  </section>

  <section class="page" aria-labelledby="plans-title">
    <h2 class="visually-hidden" id="plans-title">{text.plansTitle}</h2>
    <div class="plans">
      {
        text.plans.map((option: PlanOptionCopy) => {
          const featured: boolean = option.plan === recommendedPlan;
          return (
            <article class:list={["plan-option", { "plan-option--featured": featured }]} aria-labelledby={`plan-${option.plan}`}>
              <div class="plan-option__body">
                <div class="plan-option__head">
                  <h3 class="plan-option__name" id={`plan-${option.plan}`}>{option.name}</h3>
                  {option.badge === null ? null : <span class="pill pill--accent">{option.badge}</span>}
                </div>
                <p class="plan-option__price">
                  <span class="tabular">{option.price}</span>
                  <span class="plan-option__per">{option.per}</span>
                </p>
                <p class="small muted">{option.detail}</p>
                <a
                  class:list={["button", "button--block", featured ? "button--primary" : "button--secondary"]}
                  href={`${routes.account}?plan=${option.plan}&checkout=1`}
                >
                  {option.cta}
                </a>
              </div>
            </article>
          );
        })
      }
      <article class="plan-option plan-option--included" aria-labelledby="included-title">
        <div class="plan-option__body">
          <h2 class="plan-option__name" id="included-title">{text.includedTitle}</h2>
          <p class="small plan-option__tagline">{text.planTagline}</p>
          <ul class="included">
            {
              text.included.map((item: IconItem) => (
                <li class="included__item">
                  <Icon name={item.icon} size={18} class="included__icon" />
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
    <div class="plans__foot">
      <p class="muted">
        {noteBefore}<a class="text-link" href={routes.invite}>{text.plansInviteLink}</a>{noteAfter}
      </p>
      <p class="small muted">{common.renewalNote}</p>
      <a class="button button--secondary" href={routes.download}>{text.startFree}</a>
    </div>
  </section>

  <section class="section page" aria-labelledby="limits-title">
    <h2 class="title-l reveal" id="limits-title">{text.limitsTitle}</h2>
    <div class="limits">
      {
        text.limits.map((limit: IconText) => (
          <div class="limit reveal">
            <Icon name={limit.icon} size={22} class="limit__icon" />
            <h3 class="limit__title">{limit.title}</h3>
            <p class="muted">{limit.text}</p>
          </div>
        ))
      }
    </div>
    <div class="tax reveal">
      <h2 class="limit__title">{text.taxTitle}</h2>
      <p class="muted">{text.taxText}</p>
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="pricing-faq-title">
    <h2 class="title-l reveal" id="pricing-faq-title">{text.faqTitle}</h2>
    <Faq items={text.faq} />
  </section>

  <CtaBand id="pricing-cta-title" title={copy.compare.ctaTitle} text={copy.compare.ctaText} photo="dune-crest" />
</Base>

<style>
  .intro h1 {
    max-width: 16ch;
  }

  /* ---------- Plans: the two plan cards side by side, what every plan includes as a wide night card below ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
    align-items: stretch;
    max-width: 1040px;
    margin-inline: auto;
  }

  .plan-option--included {
    grid-column: 1 / -1;
  }

  /* Two columns of items in the wide card. */
  .plan-option--included .included {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 56px);
  }

  .plan-option {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
  }

  /* The recommended plan (yearly): the accent hairline. */
  .plan-option--featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  /* What every plan includes: the night card, like the night bands. */
  .plan-option--included {
    border-color: transparent;
    background: var(--night);
    color: var(--on-night);
  }

  /* The button sits at the bottom of each card, so both plans' buttons line up whatever the detail text's length. */
  .plan-option__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: clamp(24px, 2.6vw, 34px);
  }

  .plan-option__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .plan-option__name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .plan-option__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 18px;
    font-family: var(--serif);
    font-size: clamp(3.25rem, 5vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .plan-option__per {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .plan-option .button {
    margin-top: auto;
  }

  .plan-option .small {
    margin-bottom: 20px;
  }

  .plan-option__tagline {
    color: var(--on-night-muted);
  }

  .included {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .included__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-block: 11px;
    border-top: 1px solid var(--night-line);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .included__item :global(.included__icon) {
    flex: none;
    margin-top: 2px;
    color: #f4b694;
  }

  .plans__foot {
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 46rem;
    margin: 32px auto 0;
    text-align: center;
  }

  /* ---------- Limits: a calm four-column list under a hairline, no boxes ---------- */

  .limits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px clamp(20px, 3vw, 36px);
    margin-top: clamp(28px, 4vw, 44px);
  }

  .limit {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
  }

  .limit :global(.limit__icon) {
    flex: none;
    color: var(--accent);
  }

  .limit__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .tax {
    display: grid;
    gap: 8px;
    max-width: 46rem;
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* Questions: centred title, one centred column. */
  .faq-section {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
  }

  .faq-section > :global(*:last-child) {
    width: min(820px, 100%);
  }

  @media (max-width: 760px) {
    .plan-option--included .included {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 960px) {
    .limits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .plans,
    .limits {
      grid-template-columns: minmax(0, 1fr);
    }

    /* In one column the recommended plan comes first. */
    .plan-option--featured {
      order: -1;
    }
  }
</style>
