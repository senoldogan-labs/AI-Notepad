---
// Fiyat sayfası: iki plan (aylık 5,99 $, yıllık 49 $; vergiler dahil; yıllık önerilen), davet sayfasına bağlantı, neler
// dahil (yalnızca özellikler), sınırlar (deneme, aylık saat, toplantı süresi, iptal), SSS (ödeme ve vergiler, satıcı Link, SSS'te). Her bilgi sayfada bir kez geçer. Plan düğmeleri hesap sayfasına seçilen planla ve "ödemeye devam et" niyetiyle
// gider (`/account?plan=…&checkout=1`); hesap sayfası oturum yoksa önce girişe yönlendirir, giriş bitince seçilen planla
// doğrudan Stripe Checkout açılır.
// Pro katmanı (12,99 $ / 109 $) HTML'de gizli bir karttır: src/client/pricing.ts herkese açık `GET /v1/pricing`'i okur ve
// sunucu Pro'yu sunuyorsa kartı ve Personal kartlarının katman satırını sunucunun saatleriyle gösterir (saatler sayfada
// sabit yazılmaz). Pro düğmeleri `/account?plan=…&tier=pro&checkout=1`'e gider. Yapılandırılmış veri yalnızca Personal'i
// anlatır (Pro gizliyken arama motorlarına Pro sunulmaz). Sınırlar ve SSS bugünkü (Pro'suz) metinleriyle çizilir; Pro'lu
// kalıpları öğelerin `data-pro-text` özniteliklerindedir ve betik Pro sunulunca onları yazar.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import GetApp from "../components/GetApp.astro";
import CtaBand from "../components/CtaBand.astro";
import { copy, type CommonCopy, type IconItem, type PlanOptionCopy, type PricingCopy, type PricingLimit, type ProTierCopy } from "../copy";
import { pricingStructuredData, structuredDataJson } from "../lib/structured-data";
import { proTextAttributes, recommendedPlan } from "../lib/plans";
import { routes } from "../routes";
import { siteConfig } from "../site";

const text: PricingCopy = copy.pricing;
const common: CommonCopy = copy.common;
const pro: ProTierCopy = text.pro;
/** Search engines: the subscription with its two plans, and the page's questions (the same entries as `Faq` below). */
const structuredData: string = structuredDataJson(pricingStructuredData(siteConfig, common, text.meta, text.faq));
/** Plan notunun davet bağlantısından önceki ve sonraki parçası; metinde tam bir `{invite}` yoksa derleme durur. */
const [noteBefore, noteAfter]: readonly [string, string] = ((): readonly [string, string] => {
  const [before, after, ...rest]: readonly string[] = text.plansNote.split("{invite}");
  if (before === undefined || after === undefined || rest.length > 0) {
    throw new Error(`copy.pricing.plansNote tam bir "{invite}" yer tutucusu içermeli; gelen: ${JSON.stringify(text.plansNote)}`);
  }
  return [before, after];
})();
---

<Base page="pricing" meta={text.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  {/* Pricing: a centred title, the plans side by side with what every plan includes, the limits, the
      questions centred, and the closing band. */}
  <section class="page page-head intro">
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
    {/* Start free on either device: the Mac download and the App Store side by side. */}
    <GetApp common={common} macHref={routes.download} size="large" class="intro__actions" />
  </section>

  <section class="page" aria-labelledby="plans-title">
    <h2 class="visually-hidden" id="plans-title">{text.plansTitle}</h2>
    <div
      class="plans"
      id="plans"
      data-tier-limits={pro.limits}
      data-meeting-hours={pro.meetingLength.hours}
      data-meeting-minutes={pro.meetingLength.minutes}
    >
      {
        text.plans.map((option: PlanOptionCopy) => {
          const featured: boolean = option.plan === recommendedPlan;
          return (
            <article class:list={["plan-option", { "plan-option--featured": featured }]} aria-labelledby={`plan-${option.plan}`}>
              <div class="plan-option__body">
                {/* Pro sunulunca: bu kartın katmanı ve sunucunun saatleri. */}
                <p class="plan-option__tier small hidden" data-pro-reveal>
                  <span class="plan-option__tier-name">{pro.personalName}</span>
                  <span data-tier-line="personal" />
                </p>
                <div class="plan-option__head">
                  <h3 class="plan-option__name" id={`plan-${option.plan}`}>{option.name}</h3>
                  {option.badge === null ? null : <span class="pill pill--accent">{option.badge}</span>}
                </div>
                <p class="plan-option__price">
                  <span class="tabular">{option.price}</span>
                  <span class="plan-option__per">{option.per}</span>
                </p>
                <p class="small muted">{option.detail}</p>
                <a
                  class:list={["button", "button--block", featured ? "button--primary" : "button--secondary"]}
                  href={`${routes.account}?plan=${option.plan}&checkout=1`}
                >
                  {option.cta}
                </a>
              </div>
            </article>
          );
        })
      }
      {/* Pro: sunucu sunana dek gizli (src/client/pricing.ts). */}
      <article class="plan-option plan-option--pro hidden" id="plan-pro" data-pro-reveal aria-labelledby="plan-pro-name">
        <div class="plan-option__body">
          <div class="plan-option__head">
            <h3 class="plan-option__name" id="plan-pro-name">{pro.name}</h3>
          </div>
          <p class="plan-option__tagline">{pro.tagline}</p>
          <p class="plan-option__tier small"><span data-tier-line="pro" /></p>
          <div class="pro-plans">
            {
              pro.plans.map((option: PlanOptionCopy) => (
                <div class="pro-plan">
                  <div class="plan-option__head">
                    <h4 class="pro-plan__name" id={`plan-pro-${option.plan}`}>{option.name}</h4>
                    {option.badge === null ? null : <span class="pill pill--accent">{option.badge}</span>}
                  </div>
                  <p class="plan-option__price">
                    <span class="tabular">{option.price}</span>
                    <span class="plan-option__per">{option.per}</span>
                  </p>
                  <p class="small muted">{option.detail}</p>
                  <a class="button button--block button--secondary" href={`${routes.account}?plan=${option.plan}&tier=pro&checkout=1`}>
                    {option.cta}
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </article>
      <article class="plan-option plan-option--included" aria-labelledby="included-title">
        <div class="plan-option__body">
          <h2 class="plan-option__name" id="included-title">{text.includedTitle}</h2>
          <p class="small plan-option__tagline">{text.planTagline}</p>
          <ul class="included">
            {
              text.included.map((item: IconItem) => (
                <li class="included__item">
                  <Icon name={item.icon} size={18} class="included__icon" />
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
    <div class="plans__foot">
      <p class="muted">
        {noteBefore}<a class="text-link plans__invite" href={routes.invite}>{text.plansInviteLink} <Icon name="arrow-right" size={14} class="" /></a>{noteAfter}
      </p>
      <p class="small muted">{common.renewalNote}</p>
    </div>
  </section>

  <section class="section page" aria-labelledby="limits-title">
    <h2 class="title-l reveal" id="limits-title">{text.limitsTitle}</h2>
    <div class="limits">
      {
        text.limits.map((limit: PricingLimit) => (
          <div class="limit reveal">
            <Icon name={limit.icon} size={22} class="limit__icon" />
            <h3 class="limit__title" {...proTextAttributes(limit.pro === null ? null : limit.pro.title)}>{limit.title}</h3>
            <p class="muted" {...proTextAttributes(limit.pro === null ? null : limit.pro.text)}>{limit.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="pricing-faq-title">
    <h2 class="title-l reveal" id="pricing-faq-title">{text.faqTitle}</h2>
    <Faq items={text.faq} />
  </section>

  <CtaBand id="pricing-cta-title" title={copy.compare.ctaTitle} text={copy.compare.ctaText} common={copy.common} macHref={routes.download} />
</Base>

<script>
  import "../client/pricing";
</script>

<style>
  .intro h1 {
    max-width: 16ch;
  }

  .intro :global(.intro__actions) {
    justify-content: center;
    margin-top: 6px;
  }

  /* ---------- Plans: the two plan cards side by side, what every plan includes as a wide paper card below ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 3.4vw, 44px) clamp(12px, 1.6vw, 20px);
    align-items: stretch;
    max-width: 1040px;
    margin-inline: auto;
  }

  /* What every plan includes: a wide paper card like the plans above it, so it follows the theme. The night surface
     is kept for full-width bands (global.css `.band--night`); a lone dark card among paper cards read as a missing light
     colour. */
  .plan-option--included {
    grid-column: 1 / -1;
  }

  /* Two columns of items in the wide card. */
  .plan-option--included .included {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 56px);
  }

  .plan-option {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
  }

  /* The recommended plan (yearly): the accent hairline. */
  .plan-option--featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  /* The button sits at the bottom of each card, so both plans' buttons line up whatever the detail text's length. */
  .plan-option__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: clamp(24px, 2.6vw, 34px);
  }

  .plan-option__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .plan-option__name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .plan-option__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 18px;
    font-family: var(--serif);
    font-size: clamp(3.25rem, 5vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .plan-option__per {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .plan-option .button {
    margin-top: auto;
  }

  .plan-option .small {
    margin-bottom: 20px;
  }

  .plan-option__tagline {
    color: var(--muted);
  }

  /* Pro sunulunca kartların üstündeki katman satırı: katmanın adı ve sunucunun saatleri. */
  .plan-option__tier {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    color: var(--muted);
  }

  .plan-option .plan-option__tier {
    margin-bottom: 4px;
  }

  .plan-option__tier-name {
    font-weight: 600;
    color: var(--ink);
  }

  /* Pro: geniş kart, içinde aylık ve yıllık yan yana. */
  .plan-option--pro {
    grid-column: 1 / -1;
  }

  .pro-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin-top: 12px;
  }

  .pro-plan {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .pro-plan__name {
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .pro-plan .plan-option__price {
    margin-top: 6px;
    font-size: clamp(2.5rem, 4vw, 3.25rem);
  }

  .included {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .included__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-block: 11px;
    border-top: 1px solid var(--line);
    font-size: clamp(0.9375rem, 1.05rem - 0.15vw, 1rem);
    line-height: 1.45;
  }

  .included__item :global(.included__icon) {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }

  .plans__foot {
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 54rem;
    margin: 32px auto 0;
    text-align: center;
  }

  /* Balanced lines: the invite question never breaks in the middle of a phrase. */
  .plans__foot p {
    text-wrap: balance;
  }

  /* The invite link reads as a link (ink, underlined) and has a 44 px tall hit area. */
  .plans__invite {
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    vertical-align: middle;
  }

  /* ---------- Limits: a calm four-column list under a hairline, no boxes ---------- */

  .limits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px clamp(20px, 3vw, 36px);
    margin-top: clamp(28px, 4vw, 44px);
  }

  .limit {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
  }

  .limit :global(.limit__icon) {
    flex: none;
    color: var(--accent);
  }

  .limit__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* Questions: centred title, one centred column. */
  .faq-section {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
  }

  .faq-section > :global(*:last-child) {
    width: min(820px, 100%);
  }

  @media (max-width: 760px) {
    .plan-option--included .included {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 960px) {
    .limits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .plans,
    .limits,
    .pro-plans {
      grid-template-columns: minmax(0, 1fr);
    }

    /* In one column the recommended plan comes first. */
    .plan-option--featured {
      order: -1;
    }
  }
</style>
