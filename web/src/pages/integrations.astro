---
// Entegrasyonlar sayfası: notların, görevlerin ve dosyaların gittiği her yer, webhook (Zapier, Make, n8n) ve gönderdiği
// JSON örneği, MCP, takvim, yerleşik olmayanlar (dürüst liste), gizlilik notu ve sık sorulan sorular (JSON-LD
// `FAQPage` ve gezinti izi). Metinler copy.ts `integrations`'tan; her öğe uygulamanın kodunda doğrulanmıştır.
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import BrandLogo from "../components/BrandLogo.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Icon from "../components/Icon.astro";
import McpChat from "../components/McpChat.astro";
import PhotoPanel from "../components/PhotoPanel.astro";
import { type Brand, brands } from "../lib/brands";
import { jsonTokens } from "../lib/code-tokens";
import { halfPhotoWidths } from "../lib/photos";
import { copy, type IntegrationGroupCopy, type IntegrationItemCopy, type IntegrationsCopy } from "../copy";
import { websiteCard } from "../lib/social";
import { infoPageStructuredData, structuredDataJson } from "../lib/structured-data";
import { pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: IntegrationsCopy = copy.integrations;
/** Chips around the AI app answer in the hero: tools the app really sends to. */
const heroBrands: readonly Brand[] = ["notion", "slack", "linear", "obsidian"];
const structuredData: string = structuredDataJson(
  infoPageStructuredData(siteConfig, [{ name: copy.common.nav.integrations, url: pageUrl("integrations", siteConfig.siteOrigin) }], text.faq),
);
---

<Base page="integrations" meta={text.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="page integrations-intro">
    <div class="integrations-intro__text">
      <h1 class="title-xl">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <nav class="integrations-toc" aria-label={text.eyebrow}>
        {
          text.groups.map((group: IntegrationGroupCopy) => (
            <a class="pill" href={`#${group.id}`}>
              {group.title}
            </a>
          ))
        }
      </nav>
    </div>
    {/* The home page's integration picture: an answer about your meetings in an AI app, with the tools around it. */}
    <PhotoPanel photo="wave-dawn" focus="center" widths={halfPhotoWidths} sizes="(max-width: 960px) calc(100vw - 40px), 600px" priority="lazy" class="integrations-visual">
      <div class="integrations-visual__window">
        <McpChat demo={copy.home.integrations.mcpDemo} />
      </div>
      <ul class="integrations-visual__chips" aria-hidden="true">
        {
          heroBrands.map((brand: Brand) => (
            <li class:list={["chip", `integrations-visual__chip--${brand}`]}>
              <span class="mark-tile mark-tile--small"><BrandLogo brand={brand} size={16} /></span>
              {brands[brand].name}
            </li>
          ))
        }
      </ul>
    </PhotoPanel>
  </section>

  {
    text.groups.map((group: IntegrationGroupCopy) => (
      <section class="page integrations-group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="integrations-group__head">
          <h2 class="title-l" id={`${group.id}-title`}>{group.title}</h2>
          <p class="muted">{group.lead}</p>
        </div>
        <ul class="integrations-items">
          {group.items.map((item: IntegrationItemCopy) => (
            <li class="card integrations-item">
              <div class="integrations-item__marks" aria-hidden="true">
                {item.mark.kind === "brands" ? (
                  item.mark.brands.map((brand: Brand) => (
                    <span class="mark-tile">
                      <BrandLogo brand={brand} size={24} />
                    </span>
                  ))
                ) : (
                  <span class="mark-tile">
                    <Icon name={item.mark.icon} size={22} class="" />
                  </span>
                )}
              </div>
              <h3 class="title-m">{item.name}</h3>
              <p class="muted">{item.text}</p>
            </li>
          ))}
        </ul>
        {group.id === "webhooks" ? (
          <CodeBlock label={text.webhookExampleLabel} tokens={jsonTokens(text.webhookExample)} copy={copy.mcp.copyButton} class="" />
        ) : null}
        {group.id === "mcp" ? (
          <a class="text-link" href={routes.mcp}>
            {text.mcpLink} <Icon name="arrow-right" size={16} class="" />
          </a>
        ) : null}
      </section>
    ))
  }

  <section class="page integrations-group" id="not-built-in" aria-labelledby="not-built-in-title">
    <div class="integrations-split">
      <article class="card integrations-note">
        <h2 class="title-m" id="not-built-in-title">{text.notBuiltInTitle}</h2>
        <ul>
          {text.notBuiltIn.map((item: string) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card integrations-note">
        <h2 class="title-m">{text.privacyTitle}</h2>
        <p class="muted">{text.privacyText}</p>
      </article>
    </div>
  </section>

  <section class="page integrations-group integrations-faq" id="faq" aria-labelledby="faq-title">
    <h2 class="title-l" id="faq-title">{text.faqTitle}</h2>
    <Faq items={text.faq} />
  </section>

  <CtaBand id="integrations-cta-title" title={copy.compare.ctaTitle} text={copy.compare.ctaText} common={copy.common} macHref={routes.download} />
</Base>

<style>
  /* Hero: the text on the left, the integration picture on the right. */
  .integrations-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    padding-block: clamp(48px, 8vw, 96px) clamp(8px, 2vw, 16px);
  }

  .integrations-intro__text {
    display: grid;
    gap: 18px;
  }

  .integrations-intro :global(.integrations-visual) {
    display: grid;
    place-items: center;
    min-height: clamp(420px, 40vw, 540px);
    padding: clamp(56px, 6vw, 72px) clamp(16px, 3vw, 40px);
  }

  .integrations-visual__window {
    width: min(100%, 380px);
  }

  .integrations-visual__chips {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .integrations-visual__chips > li {
    position: absolute;
  }

  .integrations-visual__chip--notion { left: 5%; top: 6%; }
  .integrations-visual__chip--slack { right: 5%; top: 12%; }
  .integrations-visual__chip--linear { left: 5%; bottom: 7%; }
  .integrations-visual__chip--obsidian { right: 5%; bottom: 4%; }

  /* Logo tiles: one neutral treatment for every brand (monochrome mark in ink on the paper surface). */
  .mark-tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--ink);
  }

  .mark-tile--small {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border-color: rgb(0 0 0 / 0.08);
    background: #f4f3ee;
    color: #1d1d1b;
  }

  @media (max-width: 960px) {
    .integrations-intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .integrations-visual__chip--linear,
    .integrations-visual__chip--obsidian {
      display: none;
    }
  }

  .integrations-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .integrations-toc a {
    min-height: 44px;
    padding-inline: 16px;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .integrations-group {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 72px);
    scroll-margin-top: 92px;
  }

  .integrations-group__head {
    display: grid;
    gap: 8px;
    max-width: 46rem;
  }

  .integrations-items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integrations-item {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .integrations-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .integrations-note {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .integrations-note ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .integrations-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .integrations-items,
    .integrations-split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Logo tiles on each card, side by side. */
  .integrations-item__marks {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }
</style>
