---
// Entegrasyonlar sayfası: notların, görevlerin ve dosyaların gittiği her yer, webhook (Zapier, Make, n8n) ve gönderdiği
// JSON örneği, MCP, takvim, yerleşik olmayanlar (dürüst liste), gizlilik notu ve sık sorulan sorular (JSON-LD
// `FAQPage` ve gezinti izi). Metinler copy.ts `integrations`'tan; her öğe uygulamanın kodunda doğrulanmıştır.
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import BrandTile from "../components/BrandTile.astro";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import type { Brand } from "../lib/brands";
import { copy, type IntegrationGroupCopy, type IntegrationItemCopy, type IntegrationsCopy } from "../copy";
import { websiteCard } from "../lib/social";
import { infoPageStructuredData, structuredDataJson } from "../lib/structured-data";
import { pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: IntegrationsCopy = copy.integrations;
const structuredData: string = structuredDataJson(
  infoPageStructuredData(siteConfig, [{ name: copy.common.nav.integrations, url: pageUrl("integrations", siteConfig.siteOrigin) }], text.faq),
);
---

<Base page="integrations" meta={text.meta} indexed={true} social={websiteCard}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="page integrations-intro">
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
    <nav class="integrations-toc" aria-label={text.eyebrow}>
      {
        text.groups.map((group: IntegrationGroupCopy) => (
          <a class="pill" href={`#${group.id}`}>
            {group.title}
          </a>
        ))
      }
    </nav>
  </section>

  {
    text.groups.map((group: IntegrationGroupCopy) => (
      <section class="page integrations-group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="integrations-group__head">
          <h2 class="title-l" id={`${group.id}-title`}>{group.title}</h2>
          <p class="muted">{group.lead}</p>
        </div>
        <ul class="integrations-items">
          {group.items.map((item: IntegrationItemCopy) => (
            <li class="card integrations-item">
              <div class="integrations-item__marks" aria-hidden="true">
                {item.mark.kind === "brands" ? (
                  item.mark.brands.map((brand: Brand) => <BrandTile brand={brand} size="medium" />)
                ) : (
                  <Film palette="ocean" layout="clouds-right" class="brand-tile brand-tile--medium">
                    <Icon name={item.mark.icon} size={22} class="" />
                  </Film>
                )}
              </div>
              <h3 class="title-m">{item.name}</h3>
              <p class="muted">{item.text}</p>
            </li>
          ))}
        </ul>
        {group.id === "webhooks" ? (
          <figure class="integrations-code">
            <figcaption class="small">{text.webhookExampleLabel}</figcaption>
            <pre><code>{text.webhookExample}</code></pre>
          </figure>
        ) : null}
        {group.id === "mcp" ? (
          <a class="text-link" href={routes.mcp}>
            {text.mcpLink} <Icon name="arrow-right" size={16} class="" />
          </a>
        ) : null}
      </section>
    ))
  }

  <section class="page integrations-group" id="not-built-in" aria-labelledby="not-built-in-title">
    <div class="integrations-split">
      <article class="card integrations-note">
        <h2 class="title-m" id="not-built-in-title">{text.notBuiltInTitle}</h2>
        <ul>
          {text.notBuiltIn.map((item: string) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card integrations-note">
        <h2 class="title-m">{text.privacyTitle}</h2>
        <p class="muted">{text.privacyText}</p>
      </article>
    </div>
  </section>

  <section class="page integrations-group integrations-faq" id="faq" aria-labelledby="faq-title">
    <h2 class="title-l" id="faq-title">{text.faqTitle}</h2>
    <Faq items={text.faq} />
  </section>

  <CtaBand id="integrations-cta-title" title={copy.compare.ctaTitle} text={copy.compare.ctaText} photo="desk-lamp" />
</Base>

<style>
  .integrations-intro {
    display: grid;
    gap: 18px;
    padding-block: clamp(48px, 8vw, 96px) clamp(8px, 2vw, 16px);
  }

  .integrations-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .integrations-toc a {
    text-decoration: none;
  }

  .integrations-group {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 72px);
    scroll-margin-top: 92px;
  }

  .integrations-group__head {
    display: grid;
    gap: 8px;
    max-width: 46rem;
  }

  .integrations-items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integrations-item {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .integrations-code {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .integrations-code figcaption {
    font-weight: 600;
  }

  .integrations-code pre {
    margin: 0;
    padding: 18px 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--soft);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .integrations-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .integrations-note {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .integrations-note ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .integrations-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .integrations-items,
    .integrations-split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Karttaki logo karoları: ana sayfadaki kayan şeritle aynı marka karoları (BrandTile), yan yana. */
  .integrations-item__marks {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }
</style>
