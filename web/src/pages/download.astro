---
// İndirme sayfası, iki blok: Mac (indirme düğmesi: sunucu indirmeyi sayıp en son GitHub sürümündeki DMG'ye yönlendirir;
// altında sürüm — sunucudan okunur, yeri baştan ayrılır, numara gelince sayfa kaymaz — ve gereksinimler etiket/değer
// satırlarında, altında sürüm notu: her şey macOS 15'te çalışır, sesle yazmanın motoru sürüme göre) ve iPhone (App Store
// rozeti, gereksinim, ne kaydettiği ve ortak hesap/abonelik; yanında gerçek iPhone ekranı). Sonra Mac için üç kurulum
// adımı, güncellemeler ve yardım tek satırda.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import { Picture } from "astro:assets";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import PhotoPanel from "../components/PhotoPanel.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { macDownloadUrl, productName } from "../config";
import { copy, type DownloadCopy, type TitledText } from "../copy";
import { routes } from "../routes";
import { siteConfig } from "../site";
import iphoneHomeShot from "../assets/screenshots/iphone-home.webp";

const text: DownloadCopy = copy.download;
---

<Base page="download" meta={text.meta} indexed={true} social={websiteCard}>
  <section class="page download-hero">
    <div class="download-hero__text">
      <h1 class="title-xl">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="download-hero__actions">
        <h2 class="download-hero__platform">{text.macTitle}</h2>
        <a class="button button--primary download-button" href={macDownloadUrl(siteConfig, "download-page")} data-mac-download>
          <Icon name="apple" size={18} class="button__apple" />
          {copy.common.downloadCta}
        </a>
        <dl class="fact-list small download-hero__facts">
          <dt id="download-version" class="download-hero__pending">{text.versionLabel}</dt>
          <dd id="download-version-number" class="download-hero__pending"></dd>
          <dt>{text.requirementsLabel}</dt>
          <dd>{copy.common.requirementsShort}</dd>
        </dl>
        <p class="small muted download-hero__note">{text.requirementsNote}</p>
      </div>
      <div class="download-hero__actions download-hero__actions--iphone">
        <h2 class="download-hero__platform">{text.iphoneTitle}</h2>
        <AppStoreBadge language={copy.common.appStoreBadge.language} label={copy.common.appStoreBadge.label} height={54} class="" />
        <dl class="fact-list small download-hero__facts">
          <dt>{text.requirementsLabel}</dt>
          <dd>{copy.common.iphoneRequirementsShort}</dd>
        </dl>
        <p class="small muted download-hero__note">{text.iphoneNote}</p>
      </div>
    </div>
    <PhotoPanel photo="summer-lake" focus="center" widths={[480, 720, 960, 1280]} sizes="(max-width: 960px) calc(100vw - 40px), 600px" priority="lcp" class="download-hero__cover">
      <div class="app-tile">
        <Logo size={96} />
        <span class="app-tile__name">{productName}</span>
      </div>
      <Picture
        src={iphoneHomeShot}
        alt={text.iphoneAlt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[240, 360, 480]}
        sizes="(max-width: 760px) 34vw, 190px"
        quality={62}
        loading="eager"
        decoding="async"
        pictureAttributes={{ class: "download-hero__phone" }}
      />
    </PhotoPanel>
  </section>

  <section class="section page install" id="install-steps" aria-labelledby="install-title" tabindex="-1">
    <h2 class="title-l reveal" id="install-title">{text.installTitle}</h2>
    <ol class="install__steps">
      {
        text.installSteps.map((step: TitledText, index: number) => (
          <li class="install__step reveal">
            <span class="install__number tabular" aria-hidden="true">{index + 1}</span>
            <h3 class="title-m">{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="install__footnote muted reveal">
      {text.footnote}
      <a class="text-link" href={routes.contact}>{text.helpCta} <Icon name="arrow-right" size={16} class="" /></a>
    </p>
  </section>
</Base>

<script>
  import "../client/download";
</script>

<style>
  .download-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
  }

  .download-hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .download-hero__actions {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 6px;
  }

  .download-button {
    min-height: 54px;
    padding: 0 28px;
    font-size: 1rem;
  }

  .download-hero__platform {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .download-hero__actions--iphone {
    width: 100%;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .download-hero__facts {
    gap: 2px 16px;
  }

  .download-hero__facts dd {
    color: var(--muted);
  }

  .download-hero__note {
    max-width: 30rem;
  }

  /* Sürüm satırı numara gelene dek yer kaplar ama görünmez (okunamazsa öyle kalır; hata konsolda). */
  .download-hero__pending {
    visibility: hidden;
  }

  /* The Mac app's tile and the iPhone app's home screen side by side over the photograph. */
  .download-hero :global(.download-hero__cover) {
    display: grid;
    grid-template-columns: auto auto;
    place-items: center;
    place-content: center;
    gap: clamp(20px, 4vw, 44px);
    aspect-ratio: 5 / 4;
    padding: 20px;
  }

  .download-hero :global(.download-hero__phone) {
    display: block;
    width: clamp(110px, 15vw, 190px);
  }

  .download-hero :global(.download-hero__phone img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.16)) drop-shadow(0 22px 36px rgb(0 0 0 / 0.32));
  }

  /* The app's tile on a paper card over the photograph. */
  .app-tile {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 32px 44px 26px;
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow-window);
  }

  .app-tile :global(.logo-mark) {
    filter: drop-shadow(0 18px 30px rgb(30 60 45 / 0.25));
  }

  .app-tile__name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Kurulum: üç adım yan yana, numara üstte; altında tek satır not. */
  .install {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    scroll-margin-top: 96px;
  }

  .install__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .install__step {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .install__step h3,
  .install__step p {
    margin: 0;
  }

  .install__number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .install__footnote {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-items: center;
    margin: 0;
  }

  @media (max-width: 760px) {
    .download-hero,
    .install__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .download-button {
      width: 100%;
    }

    .download-hero__actions {
      justify-items: stretch;
      width: 100%;
    }

    .download-hero__actions--iphone {
      justify-items: start;
    }

    /* The phone is taller than the 5:4 panel on a phone screen: the panel grows to fit it. */
    .download-hero :global(.download-hero__cover) {
      aspect-ratio: auto;
      padding: 28px 16px;
    }
  }
</style>
