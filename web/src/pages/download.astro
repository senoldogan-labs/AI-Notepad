---
// Download page: the title and lead beside the Mac window (light or dark capture with the theme) with the iPhone in front
// of its corner, then the two apps as equal columns, side by side on wide screens: Mac (one line, the download button —
// the server counts the download and redirects to the newest DMG on GitHub — the version, read from the server into
// space reserved up front so nothing shifts, the requirements, the note on what needs which macOS, and a link to the
// release history, /changelog) and iPhone (one line, the App Store badge at the same height, the requirement, what it records
// and the shared account and subscription). Then the picture of the Mac, iPhone and Apple Watch with the line on the
// Apple Watch app, and the three install steps for the Mac, updates and help in one line.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import { Picture } from "astro:assets";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import DevicesPicture from "../components/DevicesPicture.astro";
import PhotoPanel from "../components/PhotoPanel.astro";
import Icon from "../components/Icon.astro";
import ThemedShot from "../components/ThemedShot.astro";
import { macDownloadUrl } from "../config";
import { copy, type DownloadCopy, type TitledText } from "../copy";
import { routes } from "../routes";
import { siteConfig } from "../site";
import iphoneHomeShot from "../assets/screenshots/iphone-home.webp";
import noteShot from "../assets/screenshots/note.webp";
import noteShotDark from "../assets/screenshots/note-dark.webp";

const text: DownloadCopy = copy.download;
---

<Base page="download" meta={text.meta} indexed={true} social={websiteCard}>
  <section class="page download-hero">
    <div class="download-hero__text">
      <h1 class="title-xl">{text.title}</h1>
      <p class="lead">{text.lead}</p>
    </div>
    {/* The Mac window is the main picture (light or dark capture with the visitor's theme); the iPhone sits in front of
        its corner, smaller. */}
    <PhotoPanel photo="white-dunes" focus="center" widths={[480, 720, 960, 1440, 1920]} sizes="(max-width: 960px) calc(100vw - 40px), 620px" priority="lcp" class="download-hero__cover">
      <ThemedShot
        light={noteShot}
        dark={noteShotDark}
        mobile={null}
        alt={text.macAlt}
        widths={[640, 960, 1280, 1680]}
        sizes="(max-width: 960px) calc(100vw - 72px), 560px"
        loading="eager"
        class="download-hero__window"
      />
      <Picture
        src={iphoneHomeShot}
        alt={text.iphoneAlt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[240, 360, 480, 720]}
        sizes="(max-width: 760px) 30vw, 180px"
        quality={62}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: "download-hero__phone" }}
      />
    </PhotoPanel>
    {/* The two apps as equals: two columns of the same shape (title, one line, the way to get it at the same height,
        requirements, a note), side by side on wide screens and stacked on phones. */}
    <div class="download-platforms">
      <div class="download-platform">
        <h2 class="download-platform__title"><Icon name="laptop" size={20} class="" />{text.macTitle}</h2>
        <p class="download-platform__benefit">{text.macBenefit}</p>
        <div class="get-app">
          <a class="button get-app__mac" href={macDownloadUrl(siteConfig, "download-page")} data-mac-download>
            <Icon name="apple" size={18} class="button__apple" />
            {copy.common.downloadCta}
          </a>
        </div>
        <dl class="fact-list small download-platform__facts">
          <dt id="download-version" class="download-platform__pending">{text.versionLabel}</dt>
          <dd id="download-version-number" class="download-platform__pending"></dd>
          <dt>{text.requirementsLabel}</dt>
          <dd>{copy.common.requirementsShort}</dd>
        </dl>
        <p class="small muted download-platform__note">{text.requirementsNote}</p>
        <a class="text-link download-platform__whats-new" href={routes.changelog}>{text.whatsNew} <Icon name="arrow-right" size={14} class="" /></a>
      </div>
      <div class="download-platform">
        <h2 class="download-platform__title"><Icon name="phone" size={20} class="" />{text.iphoneTitle}</h2>
        <p class="download-platform__benefit">{text.iphoneBenefit}</p>
        <div class="get-app">
          <AppStoreBadge language={copy.common.appStoreBadge.language} label={copy.common.appStoreBadge.label} height={52} class="get-app__badge" />
        </div>
        <dl class="fact-list small download-platform__facts">
          <dt>{text.requirementsLabel}</dt>
          <dd>{copy.common.iphoneRequirementsShort}</dd>
        </dl>
        <p class="small muted download-platform__note">{text.iphoneNote}</p>
      </div>
    </div>
  </section>

  <section class="section page download-devices" aria-labelledby="devices-title">
    <h2 class="title-l reveal" id="devices-title">{text.devicesTitle}</h2>
    <DevicesPicture alt={copy.home.devices.alt} photoSizes="(max-width: 640px) 100vw, min(1240px, 100vw - 80px)" class="" />
    <p class="muted download-devices__note">{text.watchNote}</p>
  </section>

  <section class="section page install" id="install-steps" aria-labelledby="install-title" tabindex="-1">
    <h2 class="title-l reveal" id="install-title">{text.installTitle}</h2>
    <ol class="install__steps">
      {
        text.installSteps.map((step: TitledText, index: number) => (
          <li class="install__step reveal">
            <span class="install__number tabular" aria-hidden="true">{index + 1}</span>
            <h3 class="title-m">{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="install__footnote muted reveal">
      {text.footnote}
      <a class="text-link" href={routes.contact}>{text.helpCta} <Icon name="arrow-right" size={16} class="" /></a>
    </p>
  </section>
</Base>

<script>
  import "../client/download";
</script>

<style>
  .download-devices {
    display: grid;
    gap: clamp(20px, 3vw, 28px);
  }

  .download-devices__note {
    max-width: var(--measure);
  }

  .download-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
  }

  .download-hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .download-platforms {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }

  .download-platform {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 14px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
  }

  .download-platform__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .download-platform__benefit {
    max-width: 32rem;
    margin: 0;
  }

  .download-platform__facts {
    gap: 2px 16px;
  }

  .download-platform__facts dd {
    color: var(--muted);
  }

  .download-platform__note {
    max-width: 32rem;
    margin: 0;
  }

  /* Sürüm satırı numara gelene dek yer kaplar ama görünmez (okunamazsa öyle kalır; hata konsolda). */
  .download-platform__pending {
    visibility: hidden;
  }

  .download-platform__whats-new {
    min-height: 44px;
    margin-top: -8px;
    color: var(--ink);
    font-size: 0.9375rem;
  }

  /* The Mac window over the photograph; the phone overlaps its bottom-right corner. */
  .download-hero :global(.download-hero__cover) {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    padding: clamp(28px, 4vw, 48px) clamp(16px, 3vw, 36px) clamp(56px, 6vw, 72px);
  }

  /* Width only: ThemedShot shows one theme's picture and hides the other. */
  .download-hero :global(.download-hero__window) {
    width: 100%;
  }

  .download-hero :global(.download-hero__window img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: var(--shadow-window);
  }

  .download-hero :global(.download-hero__phone) {
    position: absolute;
    right: clamp(10px, 3vw, 28px);
    bottom: clamp(12px, 2vw, 22px);
    display: block;
    width: clamp(110px, 14vw, 180px);
  }

  .download-hero :global(.download-hero__phone img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.16)) drop-shadow(0 22px 36px rgb(0 0 0 / 0.32));
  }

  /* Kurulum: üç adım yan yana, numara üstte; altında tek satır not. */
  /* No closing band on this page: the section ends at its footnote, with the footer's own top margin below. */
  .install {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    padding-bottom: 0;
    scroll-margin-top: 96px;
  }

  @media (max-width: 760px) {
    .install {
      padding-top: 64px;
    }
  }

  .install__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .install__step {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .install__step h3,
  .install__step p {
    margin: 0;
  }

  .install__number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .install__footnote {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-items: center;
    margin: 0;
  }

  @media (max-width: 760px) {
    .download-hero,
    .install__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .download-platforms {
      grid-template-columns: minmax(0, 1fr);
    }

    .download-hero :global(.download-hero__cover) {
      aspect-ratio: auto;
      padding: 24px 14px 64px;
    }
  }
</style>
