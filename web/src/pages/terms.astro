---
// Kullanım şartları. Sınırlar ve ödeme davranışı sunucuyla aynıdır (server/wrangler.jsonc `vars`, server/src/billing.ts,
// server/src/account.ts, trialLedger.ts, deviceCheck.ts). Ödeme Stripe Managed Payments ile alınır: satıcı (merchant of
// record) Link'tir; iade ve cayma hakkı Link'in şartlarına bağlıdır (link.com/terms "Sold Through Link Terms": AB
// tüketicisine erişimden itibaren 14 gün, Link desteğine "cooling off period" gerekçesiyle başvurulur). Davet programının
// kuralları (ödül, bekleme süresi, yıllık sınır) sunucunun davet kurallarıyla aynı tutulur. iPhone uygulamasının App Store
// abonelikleri (server/src/appStore.ts) Apple'ın satışıdır: otomatik yenileme açıklaması App Store Review Guidelines
// 3.1.2 ve developer.apple.com/app-store/subscriptions; iOS uygulaması Apple'ın standart lisans sözleşmesiyle (Standard
// EULA) ve bu şartlarla sunulur (kendi EULA'mız yok); iptal ve iade Apple'dadır (support.apple.com/118428, /118223).
// iPhone uygulaması App Store'dadır. Yapay zekâ asistanı
// erişimi (docs/superpowers/specs/2026-11-05-remote-mcp.md) isteğe bağlıdır; ayrıntısı gizlilik politikası bölüm 3'te.
import LegalSection from "../components/LegalSection.astro";
import Legal from "../layouts/Legal.astro";
import { cardStatementDescriptor, productName } from "../config";
import { copy } from "../copy";
import type { LegalSectionInfo } from "../lib/legal";
import { operator } from "../legal/operator";
import { routes } from "../routes";

const sections: readonly LegalSectionInfo[] = [
  { id: "about", title: "About these terms" },
  { id: "service", title: "The service" },
  { id: "account", title: "Your account" },
  { id: "trial", title: "Free trial" },
  { id: "subscription", title: "Subscription, price and payment" },
  { id: "cancel", title: "Cancelling" },
  { id: "withdrawal", title: "Refunds and right of withdrawal" },
  { id: "invites", title: "Invites: give a month, get a month" },
  { id: "limits", title: "Fair use and limits" },
  { id: "use", title: "Acceptable use and recording consent" },
  { id: "content", title: "Your content" },
  { id: "dpa", title: "Processing personal data on your behalf" },
  { id: "ai", title: "AI-generated output" },
  { id: "third-party", title: "Integrations and third-party services" },
  { id: "availability", title: "Availability and changes to the service" },
  { id: "termination", title: "Suspension and termination" },
  { id: "liability", title: "Liability" },
  { id: "changes", title: "Changes to these terms" },
  { id: "law", title: "Governing law and disputes" },
  { id: "contact", title: "Contact and company details" },
];
const mail: string = `mailto:${operator.email}`;
/** Link'in satın alma şartları (Stripe Managed Payments: satıcı Link) ve destek adresi. */
const linkTermsUrl: string = "https://link.com/terms#sold-through-link-terms";
const linkSupportUrl: string = "https://support.link.com/topics/sold-through-link";
/** Apple'ın standart lisans sözleşmesi, abonelik yönetimi ve iade sayfaları. */
const appleEulaUrl: string = "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/";
const appleSubscriptionsHelpUrl: string = "https://support.apple.com/118428";
const appleRefundUrl: string = "https://reportaproblem.apple.com";
---

<Legal page="terms" meta={copy.termsMeta} title={copy.common.nav.terms} sections={sections}>
  <p class="legal-lead">
    These terms govern your use of {productName}. Please read them together with the{" "}
    <a href={routes.privacy}>Privacy policy</a>, which explains how we handle personal data.
  </p>

  <LegalSection sections={sections} id="about">
    <p>
      {productName} is provided by <strong>{operator.name}</strong>, {operator.legalForm}, business ID (Y-tunnus) {operator.businessId},{" "}
      {operator.address} (“we”, “us”). These terms are an agreement between you and us. By creating an
      account, starting a free trial or subscribing, you accept them.
    </p>
    <p>
      If you use {productName} for a business, you confirm that you may accept these terms on its behalf. Some sections
      apply differently to consumers and to business customers; where they do, we say so. Nothing in these terms limits
      the rights you have as a consumer under mandatory law.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="service">
    <p>
      {productName} is a Mac and iPhone app that records your meetings,
      shows a live transcript and optional live translation, and writes a note when the meeting ends — a summary, the
      tasks (yours picked out), decisions and a glossary. The Mac app records online calls and in-person meetings; the
      iPhone app records in-person meetings through its microphone (it cannot listen to calls in other apps). Transcription after the meeting and the AI features run through our servers
      using our providers (see the Privacy policy); the live transcript is produced on your device or, when available, by
      our speech-to-text provider from audio streamed directly from your device (on iPhone, an on-device live transcript
      needs iOS 26 or later; without one, the transcript is made after the meeting). Your notes and recordings are stored on
      the Mac or iPhone that recorded them. If you turn on sync between Mac and iPhone (off by default), the text of your
      meetings, your people and Ask chats also appear on your other devices through an end-to-end encrypted copy on our
      server; audio and screen snapshots stay on the device that recorded them. Sync is not a backup: deleting a meeting
      on one device deletes it on the others, and the encrypted copy has a storage limit (100 MB of encrypted data and
      20,000 items per account), past which new changes stop syncing until you make room. If you turn on AI assistant
      access (off by default), we keep an encrypted copy of your meeting notes, never audio or transcripts, that our
      servers can read, so the AI assistants you connect can read them (see section 14).
    </p>
    <p>
      Subject to these terms, you may download and use the apps on Macs and iPhones you own or control, for as long as
      you have an account; the same account works in both. The Mac app requires macOS 15 or later on a Mac with Apple
      silicon, and the iPhone app iOS 26.1 or later; both need an internet connection.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="account">
    <ul>
      <li>You sign in with Sign in with Apple or Sign in with Google. You must be at least 18 years old.</li>
      <li>Your account is personal. Keep your Apple or Google account and your devices secure; you are responsible for activity under your account.</li>
      <li>Creating several accounts to get more free trials, or sharing an account between people, is not allowed.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="trial">
    <p>
      New users get one free trial, with no payment card required: <strong>3 meetings or 7 days</strong> from your first
      trial meeting, whichever comes first. Trial meetings not used within the 7 days expire, and each trial meeting can be
      up to 90 minutes long. During the trial, AI features used outside a meeting (for example Ask or rewriting a note)
      have a small daily limit.
    </p>
    <ul>
      <li>
        There is one free trial per person and one per device (Mac or iPhone). We keep a pseudonymous record of the sign-in
        identity (Apple or Google account) that used a trial, and Apple DeviceCheck tells us whether a device has already
        been used for one.
      </li>
      <li>
        If you delete your account and sign in again with the same Apple or Google account, your trial continues where it
        left off; it does not start again.
      </li>
      <li>We may refuse to start new free trials when many accounts start from the same network on the same day.</li>
      <li>When the trial ends, you can keep reading your existing notes, but you need a subscription to start new meetings.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="subscription">
    <ul>
      <li>
        The <strong>Personal</strong> subscription is billed either monthly, at <strong>USD 5.99 per month</strong>, or
        yearly, at <strong>USD 49 per year</strong>. Where we offer it on our website and in the apps, the{" "}
        <strong>Pro</strong> subscription, which has the same features with more meeting hours (see section 9), is billed
        monthly, at <strong>USD 12.99 per month</strong>, or yearly, at <strong>USD 109 per year</strong>. All prices are{" "}
        <strong>taxes included</strong>: any sales tax, VAT or GST that applies where you live is part of that price. You
        choose the plan when you subscribe. The price is shown at checkout before you pay; it may be shown in your local
        currency.
      </li>
      <li>
        Subscriptions are sold through <strong>Link</strong>, Stripe's payment service, which acts as the{" "}
        <strong>merchant of record</strong> (the seller) for your purchase. Checkout is hosted by Stripe, and Link
        calculates, collects and remits the taxes. <a href={linkTermsUrl}>Link's terms</a> apply to the purchase and
        payment; these terms apply to your use of {productName}. Receipts and some subscription emails are sent by Link, and your card statement shows{" "}
        <code>{cardStatementDescriptor}</code>. We never see your card details.
      </li>
      <li>
        You subscribe from your <a href={routes.account}>account page</a> or in the app. The subscription starts when the
        payment is confirmed. <strong>It renews automatically</strong> at the end of each billing period — every month on
        the same day of the month, or every year on the same date — and each renewal is charged to your saved payment
        method, <strong>until you cancel</strong>. You can cancel at any time (see section 6).
      </li>
      <li>
        To move between the monthly and yearly plan, cancel your current plan and, once it has ended, subscribe again with
        the other plan. A subscription can't be bought while another one is still running.
      </li>
      <li>
        Where Pro is offered, a subscription bought on our website or in the Mac app can be switched between Personal and
        Pro from your account page, keeping its monthly or yearly billing. You confirm the switch on a Stripe page that
        shows the amount before anything is charged: moving to Pro charges the prorated difference for the rest of the
        current period straight away, and moving to Personal turns the unused part of the current period into a credit
        that is taken off your next payments.
      </li>
      <li>
        If a payment fails, it is retried over the following days. You keep access for up to 7 days after the end of the
        paid period; after that, new meetings can't be started until the payment succeeds.
      </li>
      <li>
        If we change the price, we will tell you in the app and on our website at least 30 days in advance (Link also
        emails you before a renewal at a new price). The new price applies from your next billing
        period after the notice period, and you can cancel before it takes effect.
      </li>
      <li>
        Purchases are not available in some countries and regions where Stripe cannot sell, including China, Cuba, Iran,
        North Korea, Russia and Syria.
      </li>
      <li>
        <strong>Subscribing in the iPhone app (App Store).</strong> You can also subscribe in the iPhone app through
        Apple's App Store with the same plans: Personal, monthly or yearly, at USD 5.99 per month or USD 49 per year,
        and, where offered, Pro at USD 12.99 per month or USD 109 per year, or the price Apple shows for your country.
        Switching between them goes through the App Store under Apple's rules: moving to Pro takes effect straight away
        and Apple refunds the unused part of Personal in proportion, and moving to Personal takes effect at your next
        renewal date. App Store subscriptions are sold and billed by <strong>Apple</strong>, not by Link:
        payment is charged to your Apple Account when you confirm the purchase, and{" "}
        <strong>the subscription renews automatically</strong> for the same period and price unless you turn off
        auto-renew at least 24 hours before the end of the current period; the renewal is charged within the 24 hours
        before the period ends. If a renewal payment fails, Apple retries it and may give you a short grace period in
        which your access continues. Price changes are announced by Apple under its rules. Apple's terms apply to the
        purchase, and the iPhone app is licensed to you under{" "}
        <a href={appleEulaUrl}>Apple's Standard Licensed Application End User License Agreement</a> together with these
        terms; where they differ, these terms govern your use of the {productName} service.
      </li>
      <li>
        One subscription from either source — Link on the web and in the Mac app, or the App Store in the iPhone app —
        unlocks {productName} on your Mac and iPhone when you sign in with the same account. You don't need a second
        subscription: we don't offer the web checkout while an App Store subscription is active. If you end up with both,
        each is billed separately by its seller until you cancel it.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="cancel">
    <p>
      You can cancel at any time with “Manage subscription” on your <a href={routes.account}>account page</a>, or at
      link.com, where you can also update your payment method. Cancelling stops the next renewal; you keep access until the
      end of the period you have already paid for.
    </p>
    <p>
      <strong>App Store subscriptions</strong> are managed and cancelled only with Apple: on your iPhone in Settings ›
      your name › Subscriptions, or on a Mac in the App Store under your account's Subscriptions (see{" "}
      <a href={appleSubscriptionsHelpUrl}>Apple's instructions</a>). We can't cancel them for you. Cancelling stops the
      next renewal; you keep access until the end of the period you have already paid for.
    </p>
    <p>
      If you delete your account, any active subscription bought through Link is cancelled immediately and the rest of the
      current period ends with it. Refunds for the remaining time follow the refund rules below.{" "}
      <strong>Deleting your account does not cancel an App Store subscription</strong>: Apple keeps billing it until you
      cancel it with Apple, so cancel it first.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="withdrawal">
    <p>
      Link is the merchant of record for the subscription, so payment questions, refunds and the statutory right of
      withdrawal are handled by Link under <a href={linkTermsUrl}>Link's terms</a>, which also provide the way to withdraw.
    </p>
    <ul>
      <li>
        <strong>Right of withdrawal (EU and EEA consumers).</strong> Under Link's terms, you can cancel your order within 14
        days from the day you get access to the subscription. To do so, contact{" "}
        <a href={linkSupportUrl}>Link support</a>, follow its instructions for requesting a refund and give “cooling off
        period” as the reason.
      </li>
      <li>
        <strong>A service that has already started.</strong> The subscription is a digital service that starts, at your
        request, as soon as your payment is confirmed. If you withdraw within the 14 days, EU consumer law lets the seller
        charge an amount in proportion to the service provided until you withdrew; the right of withdrawal ends early only
        if the service has been fully provided with your express prior consent. How this applies to your request is set
        out in Link's terms.
      </li>
      <li>
        <strong>Other refunds.</strong> Link may also refund a payment within 60 days in certain other cases, such as a
        duplicate or unauthorised charge. Apart from these cases, or where mandatory law requires otherwise, unused parts of
        a subscription period are not refunded.
      </li>
    </ul>
    <p>
      <strong>App Store purchases.</strong> Apple is the seller of subscriptions bought in the iPhone app, so refunds and
      the statutory right of withdrawal for them are handled by Apple under its terms. You can request a refund at{" "}
      <a href={appleRefundUrl}>reportaproblem.apple.com</a>. We can't issue refunds for App Store purchases; when Apple
      refunds one, the access it paid for ends.
    </p>
    <p>
      You can also write to us at <a href={mail}>{operator.email}</a> and we will help you with a request to Link or Apple.
      Nothing in these terms limits any statutory right you have as a consumer.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="invites">
    <p>
      Subscribers get a personal invite code. The invite programme works as follows; it doesn't change the rest of these
      terms.
    </p>
    <ul>
      <li>
        <strong>Your friend's discount.</strong> A new subscriber who enters a valid invite code when subscribing gets their
        first month free on the Personal monthly plan, or USD 5.99 off their first payment on the Personal yearly plan and,
        where offered, on the Pro plans. Invite codes are only for
        accounts that have never subscribed before, and each person can use one invite only once.
      </li>
      <li>
        <strong>Your reward.</strong> Your reward is one free month: when your friend's first paid charge (after the free
        month on the Personal monthly plan) has gone through and has not been refunded or disputed for 30 days, a credit of USD
        5.99 is added to your Stripe customer balance and taken off your next payment. On the monthly plan that covers a
        month; on the yearly plan it comes off your next renewal. The reward is cancelled if that payment is refunded or
        disputed before then.
      </li>
      <li>
        <strong>Limits.</strong> You can earn up to 12 rewards in any 12 months, one reward per new paying account, and
        at most 3 invites can be waiting for their reward at the same time. Using your own code, a code from another
        account of yours, the same card on several invited accounts, or an account created to collect rewards doesn't
        count; we may cancel rewards and discounts obtained that way, or in breach of these terms. Accounts with free
        access granted by us can share their code, and their friends still get the discount, but they don't earn rewards
        while that access lasts.
      </li>
      <li>
        <strong>No cash value.</strong> Rewards and discounts are credit towards future payments for {productName} only.
        They have no cash value and can't be exchanged, transferred or paid out. Credit that hasn't been used when your
        subscription ends stays with your Stripe customer record and is used if you subscribe again.
      </li>
      <li>
        <strong>Changes.</strong> We may change or end the invite programme at any time by updating these terms. Rewards
        already earned before a change remain yours.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="limits">
    <p>The subscription is for normal individual use. To keep the service fair and affordable:</p>
    <ul>
      <li>
        Personal includes up to <strong>10 hours of meetings per month</strong>. Pro, where offered, includes more: the
        monthly meeting hours shown for Pro on the pricing page and in the app. The allowance resets on the first day of each month (UTC). The
        app and your account page show the allowance that applies to your account.
      </li>
      <li>
        On Personal, a single meeting can last up to <strong>4 hours</strong>; on Pro, up to the meeting length shown for
        Pro on the pricing page and in the app. Longer recordings are closed at that point.
      </li>
      <li>
        We may adjust these limits. If we lower a limit that applies to your plan, we will tell you in the app and on our
        website at least 30 days in advance, and you can cancel before the change takes effect.
      </li>
      <li>Up to 20 meetings can be started per day, and AI features have daily and monthly usage ceilings.</li>
      <li>When you reach a limit, the app tells you clearly and new meetings can't be started until the limit resets. Your existing notes remain available.</li>
      <li>To protect the service, AI features may pause temporarily if overall usage reaches a daily safety ceiling.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="use">
    <ul>
      <li>
        <strong>Recording consent.</strong> Laws on recording conversations differ between countries. Before you record,
        you are responsible for informing everyone in the meeting and, where required, getting their consent. The app
        reminds you, but the responsibility is yours.
      </li>
      <li>
        <strong>Imported recordings and phone calls.</strong> When you import or share a recording of other people into
        the app, including a phone call, the same applies: you are responsible for informing them and for getting any
        consent the law requires for recording the conversation and for having it transcribed and summarized.
      </li>
      <li>Don't use the service for anything unlawful, to infringe other people's rights, or to record conversations you are not entitled to record.</li>
      <li>
        Don't access our servers other than through the app and our website, try to get around limits or device checks, resell the
        service or overload it. Don't reverse engineer, decompile or disassemble the app or the service, except as
        permitted by applicable law.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="content">
    <p>
      Your recordings, transcripts and notes belong to you. You give us permission to process them only as needed to
      provide the service to you. Our servers don't store your audio, or your notes in a form we can read; the final transcript is kept encrypted so
      it can be re-sent for 2 hours, then deleted at the next daily cleanup (within about a day), and if you turn on sync
      we keep an end-to-end encrypted copy of your meetings' text that only your devices can open. If you share a note
      with a link, we keep an end-to-end encrypted copy of that note until the link expires or you remove it; anyone with
      the link can read it, so you decide who gets it and are responsible for sharing it lawfully, including other
      participants' personal data in it. We may remove a shared link that is reported to us as unlawful. If you turn on AI
      assistant access, we also keep an encrypted copy of your meeting notes that our servers can read, so the assistants
      you connect can read them; turning it off deletes that copy. We don't use your meeting content to train AI models.
      Because your notes are stored on your Mac or iPhone, keeping backups of your devices is up to you.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="dpa">
    <p>
      The meetings you record include personal data of other participants: their voices, what they say and their names.
      For that data you are the controller and we are your processor. This section is our data processing agreement under
      Article 28 of the GDPR.
    </p>
    <ul>
      <li>
        <strong>Subject, purpose and duration.</strong> We process meeting audio, transcripts, notes, the participant
        names and terms you add, the title and attendee names of a calendar event you link to a meeting and, if you turn on “Use screen snapshots in notes”, a few downscaled snapshots of shared
        screens, only to transcribe your meetings, to produce notes, translations and answers for you, to create the
        Linear or Jira issues you ask for, if you turn on sync, to keep the end-to-end encrypted copy that brings your
        meetings to your other devices, if you share a note with a link, to keep its end-to-end encrypted copy for the
        people you give the link to, and, if you turn on AI assistant access, to keep an encrypted copy of your meeting
        notes and let the AI assistants you connect search and read it,
        for as long as you use the service. The categories of data depend on what is said in your meetings.
      </li>
      <li>
        <strong>Your instructions.</strong> These terms and the <a href={routes.privacy}>Privacy policy</a> are your
        documented instructions. We process the data for no other purpose, unless EU or Finnish law requires us to; in that
        case we tell you first unless the law forbids it.
      </li>
      <li>
        <strong>Confidentiality and security.</strong> Only the operator has access to the service's systems and is bound
        by confidentiality. Meeting content is encrypted in transit; our servers keep no audio, keep notes only as the
        end-to-end encrypted sync copy we cannot read (if you turn on sync) and as the AI assistant copy, encrypted at rest
        but not end to end (if you turn on AI assistant access), and keep the final
        transcript encrypted so it can be re-sent for 2 hours, then delete it within about a day; our other security
        measures are described in the Privacy policy.
      </li>
      <li>
        <strong>Sub-processors.</strong> You authorise the sub-processors listed in{" "}
        <a href={`${routes.privacy}#providers`}>section 8 of the Privacy policy</a> (Cloudflare, Deepgram, ElevenLabs
        and Anthropic for meeting content). We bind them by written data processing terms with data protection obligations equivalent to
        these, and we remain responsible to you for them. We announce changes to this list in the Privacy policy before
        they take effect; if you object, you can stop using the service and delete your account.
      </li>
      <li>
        <strong>Assistance.</strong> Taking into account the nature of the processing, we help you answer requests from
        people who use their data protection rights, and with security, data breach notifications, impact assessments and
        consultations with supervisory authorities. We tell you without undue delay after becoming aware of a personal data
        breach affecting this data.
      </li>
      <li>
        <strong>Deletion.</strong> We don't keep meeting content after processing it: transcripts and notes are returned
        to your Mac or iPhone, and you delete them there; the AI assistant copy, if you turn it on, is deleted as soon as
        you turn it off or delete your account, and within 7 days after your subscription or trial ends; the encrypted copy of the final transcript can no longer be fetched after 2 hours and is
        deleted from our server at the next daily cleanup (within about a day), or immediately when you delete your account. Our sub-processors delete it under the retention rules described in the
        Privacy policy.
      </li>
      <li>
        <strong>Demonstrating compliance.</strong> We give you the information you need to show that these obligations are
        met, including written answers to reasonable audit questions.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="ai">
    <p>
      Transcripts, translations, summaries, tasks and answers are produced automatically by AI models. They can be
      incomplete or wrong — for example misheard names, numbers or speakers. Check anything important against the recording
      before you rely on it, especially for legal, medical, financial or other high-stakes decisions.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="third-party">
    <p>
      You connect integrations such as Notion, Slack, Microsoft Teams, Discord, Zoom, Linear, Jira, Apple Notes, Markdown
      folders and webhooks (for example Zapier, Make or n8n) with your own
      accounts. Those services are provided by third parties under their own terms, and we are not responsible for how they
      work. Product names and logos belong to their owners.
    </p>
    <p>
      <strong>AI assistant access.</strong> AI assistant access is optional and off by default; you turn it on in the app.
      You choose which AI assistants (for example Claude or ChatGPT) to connect, and you are responsible for that choice.
      Those assistants are provided by third parties under their own terms and privacy policies, which apply to what they
      read from your notes. We don't control and make no promise about what an assistant does with your notes, how it
      answers or what it shares; an assistant that also has other tools, such as email or web access, can be steered by
      text in your meetings. The connection only lets an assistant search, list and read your notes. Turning AI assistant
      access off deletes our copy of your notes and disconnects every assistant; when your subscription or trial ends,
      assistants lose access immediately and the copy is deleted within 7 days.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="availability">
    <p>
      We work to keep {productName} running well, but we can't promise uninterrupted availability. The service may pause
      for maintenance, outages at our providers, or security reasons. We may improve and change features; if we make a
      change that substantially reduces what the subscription includes, we will tell you in advance and you may cancel.
      If we discontinue the service, we will give you at least 30 days' notice and arrange a refund of any prepaid period that remains.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="termination">
    <p>
      You can stop using {productName} and delete your account at any time on your <a href={routes.account}>account page</a>
      or in the app under Settings › Plan and billing.
      We may suspend or close an account that seriously or repeatedly breaches these terms, or where the law requires us to.
      Where appropriate, we will warn you first and give you a chance to fix the problem. If we close your account without
      it being your fault, we arrange a refund of any prepaid period that remains.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="liability">
    <p>
      <strong>Consumers.</strong> We are responsible for providing the service as described in these terms, and you have
