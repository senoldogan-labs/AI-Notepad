---
// Hesap sayfası, yukarıdan aşağı tek sütun: başlık ve çıkış; tek plan kartı (durgun film kapak, altında plan adı ve
// durum etiketi, cümle gerektiren durumda tek ileti satırı, tarih gibi değerler için etiket/değer satırları, denemede
// kalan toplantı ya da abonede aylık kullanım ve toplantı dışı yapay zekâ ölçerleri (sınıra yaklaşınca sarı, dolunca
// sıfırlanma günüyle uyarı), ödeme alınamadıysa eylemin yanında uyarı ve duruma uyan eylem: abone olmayanda plan seçimi
// (yıllık seçili; sunucu Pro'yu sunuyorsa üstünde Personal/Pro katman seçimi ve plan seçeneklerinde seçili katmanın
// fiyatları), davet kodu alanı ve Abone ol; abonede Aboneliği yönet ve Stripe abonesinde katman değiştirme; ücretsiz
// erişimde eylem yok); abonede davet
// kartı (kod, davet bağlantısını kopyalama, sayı satırı, ödülün tahmini tarihi); uygulamayı indirme ve yardım kartları
// yan yana; ödeme dönüşünde onay kartı (plan, tek sonraki adım: takvim) ya da abonelik henüz görünmüyorsa "Refresh my
// plan"; denemesi bitmiş ve hiç abone olmamış hesapta sakin bir "kaldığın yerden devam et" kartı; Abone ol düğmesinde
// tutar ve hemen altında yenileme koşulları (Terms ve Privacy bağlantılarıyla); en altta varsayılan kapalı hesap silme alanı (<details>; onay penceresiyle). Hesap yüklenemezse hatanın
// altında yeniden deneme düğmesi görünür. Değerler tarayıcıda `/v1/me` ve `/v1/referral`'dan doldurulur
// (src/client/account.ts); kimlikler scripts/e2e.ts ve scripts/screenshots.ts ile aynı tutulur.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import Film from "../components/Film.astro";
import AppStoreBadge from "../components/AppStoreBadge.astro";
import Icon from "../components/Icon.astro";
import Waveform from "../components/Waveform.astro";
import { macDownloadUrl } from "../config";
import { type AccountCopy, type CommonCopy, type PlanOptionCopy, copy } from "../copy";
import { type ClientCopy, clientCopy } from "../client/copy";
import { type BillingPlan, type SubscriptionTier, billingPlans, recommendedPlan, subscriptionTiers } from "../lib/plans";
import { routes } from "../routes";
import { siteConfig } from "../site";

const text: AccountCopy = copy.account;
const common: CommonCopy = copy.common;
const client: ClientCopy = clientCopy;
/** Plan seçiminde bir planın her katmandaki fiyatı (betik seçili katmanınkini gösterir; Personal varsayılan). */
const tierPlanOptions: Readonly<Record<SubscriptionTier, readonly PlanOptionCopy[]>> = { personal: copy.pricing.plans, pro: copy.pricing.pro.plans };
/** Katmanın planı; metinde yoksa derleme durur. */
function planOption(tier: SubscriptionTier, plan: BillingPlan): PlanOptionCopy {
  const option: PlanOptionCopy | undefined = tierPlanOptions[tier].find((item: PlanOptionCopy): boolean => item.plan === plan);
  if (option === undefined) {
    throw new Error(`copy.pricing: "${tier}" katmanında "${plan}" planı yok`);
  }
  return option;
}
const helpLinks: readonly { readonly href: string; readonly label: string }[] = [
  { href: routes.contact, label: text.helpContact },
  { href: routes.privacy, label: common.nav.privacy },
  { href: routes.terms, label: common.nav.terms },
];
---

<Base page="account" meta={text.meta} indexed={false} social={websiteCard}>
  <section class="page account" id="account" data-sign-in-path={routes.signIn} data-home-path={routes.home}>
    <header class="account__head">
      <div class="account__title">
        <h1 class="title-xl">{text.title}</h1>
      </div>
      <button id="signout-button" class="button button--secondary button--small" type="button">{text.signOut}</button>
    </header>

    <noscript><p class="notice notice--error">{text.noScript}</p></noscript>
    {/* Ödeme dönüşü: abonelik görününce onay ve tek sonraki adım (takvim); görünmezse bekleme satırı ve yenileme. */}
    <section id="payment-done" class="card confirmation hidden" role="status" aria-labelledby="confirmation-title">
      <span class="icon-chip confirmation__icon"><Icon name="check-circle" size={20} class="" /></span>
      <div class="confirmation__body">
        <h2 class="title-m" id="confirmation-title">{client.confirmation.title}</h2>
        <p id="confirmation-plan" class="muted"></p>
        <div class="confirmation__next">
          <p class="confirmation__next-title"><Icon name="calendar" size={16} class="" />{client.confirmation.nextTitle}</p>
          <p class="small muted">{client.confirmation.nextText}</p>
          <a class="text-link" href="#app-title">{client.confirmation.getApp} <Icon name="arrow-right" size={14} class="" /></a>
        </div>
      </div>
    </section>
    {/* Cayma onayı: hesap yeniden yüklense de ekranda kalır (saklanması istenir). */}
    <section id="withdraw-done" class="card withdraw-done hidden" role="status" tabindex="-1" aria-labelledby="withdraw-done-title">
      <span class="icon-chip"><Icon name="check-circle" size={20} class="" /></span>
      <div class="withdraw-done__body">
        <h2 class="title-m" id="withdraw-done-title">{client.withdrawal.doneTitle}</h2>
        <p id="withdraw-done-text"></p>
        <p class="small muted">{client.withdrawal.keep}</p>
      </div>
    </section>
    <div id="payment-pending" class="notice payment-pending hidden" role="status">
      <p>{client.confirmation.pending}</p>
      <button id="payment-refresh" class="button button--secondary button--small" type="button">{client.confirmation.refresh}</button>
    </div>
    <div id="payment-done-signed-out" class="card paid hidden" role="status">
      <h2 class="title-m">{text.paymentDoneSignedOut.title}</h2>
      <p class="muted">{text.paymentDoneSignedOut.text}</p>
      <a class="text-link" href={routes.signIn}>{text.paymentDoneSignedOut.signIn}</a>
    </div>
    <p id="account-error" class="notice notice--error hidden" role="alert"></p>
    <button id="account-retry" class="button button--secondary button--small account__retry hidden" type="button">{text.retry}</button>
    <p id="account-loading" class="muted" role="status">{text.loading}</p>

    <div id="account-content" class="account__content hidden">
      <article class="plan-card" aria-labelledby="plan-title">
        <Film palette="coral" layout="streaks" class="plan-card__cover">
          <Waveform seed={text.title} width={200} height={40} class="plan-card__wave" />
        </Film>
        <div class="plan-card__body">
          <div class="plan-card__head">
            <div class="plan-card__heading">
              <p class="plan-card__label">{text.planLabel}</p>
              <h2 class="plan-card__name" id="plan-title"><span id="plan-value"></span></h2>
            </div>
            <span id="plan-pill" class="pill hidden"></span>
          </div>
          <p id="plan-status" class="plan-card__status hidden"></p>
          {/* Hiç abone olmamış hesapta deneme bitti: sakin kart, geri sayım yok. */}
          <div id="win-back" class="win-back hidden">
            <p class="win-back__title">{client.winBack.title}</p>
            <p id="win-back-text" class="win-back__text"></p>
          </div>
          <dl id="plan-facts" class="fact-list hidden"></dl>

          <div id="trial-card" class="usage hidden">
            <div class="usage__head">
              <span class="usage__label" id="trial-label"><Icon name="gift" size={16} class="" />{text.trialLabel}</span>
              <span id="trial-value" class="usage__value tabular"></span>
            </div>
            <progress id="trial-meter" class="meter" aria-labelledby="trial-label" max="3" value="0"></progress>
          </div>

          <div id="hours-card" class="usage hidden">
            <div class="usage__head">
              <span class="usage__label" id="hours-label"><Icon name="clock" size={16} class="" />{text.hoursLabel}</span>
              <span id="hours-value" class="usage__value tabular"></span>
            </div>
            <progress id="hours-meter" class="meter" aria-labelledby="hours-label" max="10" value="0"></progress>
            <div id="hours-foot" class="usage__foot">
              <span id="hours-left" class="usage__left tabular"></span>
              <span class="small muted">{text.hoursNote}</span>
            </div>
            <p id="hours-limit" class="usage__limit hidden" role="status"></p>
          </div>

          <div id="ai-card" class="usage hidden">
            <div class="usage__head">
              <span class="usage__label" id="ai-label"><Icon name="sparkle" size={16} class="" />{text.aiLabel}</span>
              <span id="ai-value" class="usage__value tabular"></span>
            </div>
            <progress id="ai-meter" class="meter" aria-labelledby="ai-label" max="1" value="0"></progress>
            <div id="ai-foot" class="usage__foot">
              <span id="ai-resets" class="usage__left tabular"></span>
              <span class="small muted">{text.aiNote}</span>
            </div>
            <p id="ai-limit" class="usage__limit hidden" role="status"></p>
          </div>

          {/* Katman seçimi: yalnızca sunucu Pro'yu sunuyorsa görünür; adlar ve saatler sunucudan (betik yazar). */}
          <fieldset id="tier-choice" class="plan-choice hidden">
            <legend class="plan-choice__legend">{text.tierChoiceLegend}</legend>
            <div class="plan-choice__options">
              {
                subscriptionTiers.map((tier: SubscriptionTier) => (
                  <label class="plan-choice__option hidden" data-tier-option={tier}>
                    <input type="radio" name="tier" value={tier} checked={tier === "personal"} />
                    <span class="plan-choice__text">
                      <span class="plan-choice__name" id={`tier-name-${tier}`} />
                      <span class="small muted" id={`tier-hours-${tier}`} />
                      <span class="plan-choice__tier-price tabular" id={`tier-price-${tier}`} />
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset id="plan-choice" class="plan-choice hidden">
            <legend class="plan-choice__legend">{text.planChoiceLegend}</legend>
            <div class="plan-choice__options">
              {
                billingPlans.map((plan: BillingPlan) => (
                  <label class="plan-choice__option">
                    <input type="radio" name="plan" value={plan} checked={plan === recommendedPlan} />
                    {subscriptionTiers.map((tier: SubscriptionTier) => {
                      const option: PlanOptionCopy = planOption(tier, plan);
                      return (
                        <span class:list={["plan-choice__text", { hidden: tier !== "personal" }]} data-price-tier={tier}>
                          <span class="plan-choice__name">
                            {option.name}
                            {option.badge === null ? null : <span class="plan-choice__save">{option.badge}</span>}
                          </span>
                          <span class="plan-choice__price tabular">
                            {option.price} <span class="muted">{option.per}</span>
                          </span>
                          <span class="small muted">{option.detail}</span>
                        </span>
                      );
                    })}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <details id="invite" class="invite hidden">
            <summary class="invite__summary">
              {text.invite.summary}
              <Icon name="chevron-down" size={16} class="invite__chevron" />
            </summary>
            <div class="invite__body">
              <label class="invite__label" for="invite-input">{text.invite.label}</label>
              <div class="invite__row">
                <input
                  id="invite-input"
                  class="input invite__input"
                  type="text"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  maxlength="24"
                  placeholder={text.invite.placeholder}
                />
                <button id="invite-apply" class="button button--secondary button--small" type="button">{text.invite.apply}</button>
                <button id="invite-remove" class="button button--secondary button--small hidden" type="button">{text.invite.remove}</button>
              </div>
              <p id="invite-status" class="small hidden" role="status"></p>
            </div>
          </details>

          <p id="plan-alert" class="notice notice--warn plan-card__alert hidden" role="status"></p>
          <div class="plan-card__actions">
            <button id="subscribe-button" class="button button--primary hidden" type="button">{text.subscribe}</button>
            <button id="manage-button" class="button button--secondary hidden" type="button">{text.manage}</button>
            <button id="switch-tier-button" class="button button--secondary hidden" type="button"></button>
          </div>
          {/* Yenileme koşulları Checkout'tan önce, düğmenin hemen altında (betik seçili plana göre yazar). */}
          <p id="subscribe-note" class="plan-card__note plan-card__terms small hidden">
            <strong id="subscribe-terms-lead"></strong> <span id="subscribe-terms-rest"></span>
            <a class="text-link" href={routes.terms}>{common.nav.terms}</a> · <a class="text-link" href={routes.privacy}>{common.nav.privacy}</a>
          </p>
          <p id="manage-note" class="plan-card__note small muted hidden">{text.manageNote}</p>
          <p id="switch-tier-note" class="plan-card__note small muted hidden"></p>
        </div>
      </article>

      {/* Cayma işlevi (AB CRD Art. 11a): Stripe aboneliğinin ilk 14 günü; onay adımından sonra `POST /v1/billing/withdraw`. */}
      <section id="withdraw-card" class="card withdraw hidden" aria-labelledby="withdraw-title">
        <h2 class="title-m" id="withdraw-title">{client.withdrawal.title}</h2>
        <p id="withdraw-text" class="muted"></p>
        <button id="withdraw-button" class="button button--secondary" type="button">{client.withdrawal.button}</button>
        <div id="withdraw-confirm" class="withdraw__confirm hidden" role="group" aria-labelledby="withdraw-confirm-title">
          <p class="withdraw__confirm-title" id="withdraw-confirm-title">{client.withdrawal.confirmTitle}</p>
          <p class="small muted">{client.withdrawal.confirmText}</p>
          <p id="withdraw-error" class="notice notice--error hidden" role="alert"></p>
          <div class="withdraw__actions">
            <button id="withdraw-cancel" class="button button--secondary button--small" type="button">{client.withdrawal.cancel}</button>
            <button id="withdraw-confirm-button" class="button button--danger-solid button--small" type="button">{client.withdrawal.confirm}</button>
          </div>
        </div>
      </section>

      <article id="referral-card" class="card referral hidden" aria-labelledby="referral-title">
        <div class="referral__text">
          <h2 class="title-m" id="referral-title">{text.referral.title}</h2>
          <p class="muted">{text.referral.text}</p>
          <dl id="referral-stats" class="referral__stats hidden"></dl>
          <p id="referral-note" class="small muted hidden"></p>
          <a class="text-link" href={routes.invite}>{text.referral.howItWorks} <Icon name="arrow-right" size={16} class="" /></a>
        </div>
        <Film palette="rose" layout="clouds-right" class="referral__cover">
          <div id="referral-share" class="glass referral__share">
            <span class="referral__code-label">{text.referral.codeLabel}</span>
            <span id="referral-code" class="referral__code tabular"></span>
            <button id="referral-copy" class="button button--primary button--small referral__copy" type="button">{text.referral.copyLink}</button>
            <p id="referral-copied" class="referral__copied hidden" role="status">{text.referral.copied}</p>
          </div>
        </Film>
      </article>

      <div class="account__cards">
        <article class="card side-card" aria-labelledby="app-title">
          <span class="icon-chip"><Icon name="laptop" size={20} class="" /></span>
          <h2 class="title-m" id="app-title">{text.appTitle}</h2>
          <p class="muted">{text.appText}</p>
          <p class="small muted">{common.requirementsShort}</p>
          <a class="button button--primary button--small" href={macDownloadUrl(siteConfig, "account")} data-mac-download>
            <Icon name="apple" size={15} class="button__apple" />
            {common.downloadCta}
          </a>
          <AppStoreBadge language={common.appStoreBadge.language} label={common.appStoreBadge.label} height={40} class="" />
        </article>

        <nav class="card side-card" aria-labelledby="help-title">
          <span class="icon-chip"><Icon name="message" size={20} class="" /></span>
          <h2 class="title-m" id="help-title">{text.helpTitle}</h2>
          <ul class="help-links">
            {
              helpLinks.map((link) => (
                <li>
                  <a class="help-links__link" href={link.href}>
                    {link.label}
                    <Icon name="arrow-right" size={16} class="" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {/* Hesap silme: varsayılan kapalı, sakin bir satır; açılınca açıklama ve silme düğmesi görünür. */}
      <details class="danger">
        <summary class="danger__summary">
          <h2 class="danger__title" id="danger-title">{text.dangerTitle}</h2>
          <Icon name="chevron-down" size={18} class="danger__chevron" />
        </summary>
        <div class="danger__body">
          <p class="muted">{text.dangerText}</p>
          <button id="delete-button" class="button button--danger" type="button">{text.deleteButton}</button>
        </div>
      </details>
    </div>

    <div id="account-deleted" class="card deleted hidden" tabindex="-1" role="status">
      <h2 class="title-l">{text.deletedTitle}</h2>
      <p class="muted">{text.deletedText}</p>
      <p class="small muted">{text.deletedRedirect}</p>
      <a class="button button--primary" href={routes.home}>{text.backHome}</a>
    </div>
  </section>

  <dialog id="delete-dialog" class="dialog" aria-labelledby="dialog-title" data-confirm-word={text.confirmWord}>
    <form method="dialog" class="dialog__form">
      <h2 class="title-m" id="dialog-title">{text.dialogTitle}</h2>
      <p class="muted">{text.dialogText}</p>
      <p id="delete-app-store-warning" class="notice notice--warn hidden" role="note"></p>
      <div class="field">
        <label for="confirm-input">{text.confirmLabel}</label>
        <input id="confirm-input" class="input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" />
      </div>
      <p id="delete-error" class="notice notice--error hidden" role="alert"></p>
      <div class="dialog__actions">
        <button id="cancel-delete" class="button button--secondary" type="button">{text.cancel}</button>
        <button id="confirm-delete" class="button button--danger-solid" type="button" disabled>{text.confirmDelete}</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import "../client/account";
</script>

<style>
  .account {
    display: grid;
    gap: 20px;
    padding-top: clamp(40px, 6vw, 72px);
    max-width: 880px;
  }

  .account__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 8px;
  }

  .account__title {
    display: grid;
    gap: 14px;
  }

  .account__content {
    display: grid;
    gap: 20px;
  }

  .account__retry {
    justify-self: start;
  }

  /* ---------- Plan kartı ---------- */

  .plan-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--elevation);
    overflow: hidden;
  }

  .plan-card :global(.plan-card__cover) {
    display: grid;
    place-items: center;
    height: clamp(88px, 11vw, 112px);
    border-radius: 0;
  }

  .plan-card :global(.plan-card__wave) {
    color: rgb(10 10 10 / 0.55);
  }

  .plan-card__body {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3.4vw, 36px);
  }

  .plan-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .plan-card__heading {
    display: grid;
    gap: 4px;
  }

  .plan-card__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .plan-card__name {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .plan-card__status {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
  }

  /* Abonenin aylık kullanımı: etiket ve değer bir satırda, altında ölçer ve sıfırlanma notu. */
  .usage {
    display: grid;
    gap: 10px;
    padding: 16px 18px;
    border-radius: var(--radius-m);
    background: var(--soft);
  }

  .usage__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .usage__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .usage__value {
    font-weight: 600;
  }

  /* Ölçerin altı: solda ikincil değer (kalan saat), sağda sıfırlanma notu. */
  .usage__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .usage__left {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .usage__limit {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--danger);
  }

  .plan-card__alert {
    margin-bottom: -4px;
  }

  .plan-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  /* Eylem yoksa (ücretsiz erişim) boş satır yer kaplamaz. */
  .plan-card__actions:not(:has(> :not(.hidden))) {
    display: none;
  }

  .plan-card__note {
    max-width: 36rem;
    margin-top: -6px;
  }

  /* Yenileme koşulları okunur kalır: kalın satır mürekkep, geri kalanı ikincil metin. */
  .plan-card__terms {
    color: var(--muted);
  }

  .plan-card__terms strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Deneme bitti: vurgu renginin yumuşak zemini, sakin. */
  .win-back {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: var(--radius-m);
    background: var(--accent-soft);
  }

  .win-back__title {
    font-weight: 600;
  }

  /* ---------- Plan seçimi ve davet kodu ---------- */

  .plan-choice {
    display: grid;
    gap: 12px;
    min-width: 0;
    margin: 6px 0 0;
    padding: 0;
    border: 0;
  }

  .plan-choice__legend {
    margin-bottom: 12px;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .plan-choice__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .plan-choice__option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  /* Seçim vurgu rengiyle (uygulamalardaki plan seçimiyle aynı). */
  .plan-choice__option:has(input:checked) {
    border-color: var(--accent);
