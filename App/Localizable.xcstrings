        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän maan numeroihin ei voi vielä soittaa."
          }
        }
      }
    },
    "Aramanın kaydı henüz gelmedi; uygulama bir sonraki açılışta yeniden dener.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call's recording hasn't arrived yet; the app tries again next time it opens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme des Anrufs ist noch nicht da; die App versucht es beim nächsten Öffnen erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement de l'appel n'est pas encore arrivé ; l'app réessaiera à sa prochaine ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de la llamada aún no ha llegado; la app lo intentará de nuevo la próxima vez que se abra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione della chiamata non è ancora arrivata; l'app riproverà alla prossima apertura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação da chamada ainda não chegou; o app tentará novamente na próxima abertura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname van het gesprek is nog niet binnen; de app probeert het opnieuw bij de volgende keer openen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の録音がまだ届いていません。次回アプリを開いたときに再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 녹음이 아직 도착하지 않았습니다. 다음에 앱을 열 때 다시 시도합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话录音尚未送达，应用将在下次打开时重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelun tallenne ei ole vielä saapunut; sovellus yrittää uudelleen seuraavalla avauskerralla."
          }
        }
      }
    },
