          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun campo di testo selezionato; il testo è stato copiato negli appunti. Incollalo con ⌘V."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストフィールドが選択されていません。テキストをクリップボードにコピーしました。⌘V でペーストしてください。"
          }
        },
        "ko": {
