    "Kayıt çevrimdışı sürüyor: canlı çeviri kapalı; not ve konuşmacılar bağlantı gelince hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Aufnahme: Die Live-Übersetzung ist aus; Notiz und Sprecher werden erstellt, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording offline: live translation is off; the note and speakers are prepared when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando sin conexión: la traducción en directo está desactivada; la nota y los interlocutores se prepararán cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitetaan offline-tilassa: reaaliaikainen käännös on pois päältä; muistiinpano ja puhujat valmistellaan, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement hors ligne : la traduction en direct est désactivée ; la note et les intervenants seront préparés lorsque vous serez de nouveau en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione offline: la traduzione dal vivo è disattivata; nota e interlocutori vengono preparati quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで録音中：ライブ翻訳はオフです。ノートと話者はオンラインに戻ったときに作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 녹음 중: 실시간 번역이 꺼져 있습니다. 다시 온라인 상태가 되면 노트와 화자가 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline opnemen: live vertaling staat uit; de notitie en sprekers worden gemaakt zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando offline: a tradução ao vivo está desativada; a nota e os falantes são preparados quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线录制：实时翻译已关闭；恢复联网后会准备笔记和说话人。"
          }
        }
      }
    },
