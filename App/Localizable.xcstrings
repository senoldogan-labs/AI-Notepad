    "Hesabın zaten ücretsiz olduğu için sana ödül yazılmaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Account ist bereits kostenlos, daher wird dir keine Prämie gutgeschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is already free, so no reward is credited to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta ya es gratuita, así que no se te abona ninguna recompensa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi on jo ilmainen, joten sinulle ei hyvitetä palkkiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est déjà gratuit ; aucune récompense ne vous est donc créditée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è già gratuito, quindi non ti viene accreditato alcun premio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアカウントはすでに無料のため、特典は付与されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계정은 이미 무료이므로 보상이 적립되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is al gratis, dus er wordt geen beloning bijgeschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta já é grátis, então nenhuma recompensa é creditada para você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户已经免费，因此不会为你记入奖励。"
          }
        }
      }
    },
    "Kaydedince not, notlarını da hesaba katarak yeniden yazılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern wird die Notiz unter Berücksichtigung deiner Notizen neu geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you save, the note is rewritten taking your notes into account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, la nota se reescribe teniendo en cuenta tus notas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tallennat, muistiinpano kirjoitetaan uudelleen omat muistiinpanosi huomioiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous enregistrez, la note est réécrite en tenant compte de vos notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando salvi, la nota viene riscritta tenendo conto delle tue note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、あなたのメモを考慮してノートが書き直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 직접 작성한 메모를 반영하여 노트가 다시 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je bewaart, wordt de notitie herschreven met je notities erin verwerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, a nota é reescrita levando suas anotações em conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储时，会结合你的笔记重写会议笔记。"
          }
        }
      }
    },
