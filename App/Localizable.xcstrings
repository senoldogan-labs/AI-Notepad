    "%lld toplantının sesi şimdi silinecek; metin ve not kalır. Bu geri alınamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio of %lld meetings will be deleted now; transcripts and notes stay. This can't be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio von %lld Meetings wird jetzt gelöscht; Transkripte und Notizen bleiben. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio de %lld réunions sera supprimé maintenant ; transcriptions et notes restent. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de %lld reuniones se borrará ahora; las transcripciones y notas se conservan. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio di %lld riunioni verrà eliminato ora; trascrizioni e note restano. L'operazione non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de %lld reuniões será apagado agora; transcrições e notas ficam. Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio van %lld vergaderingen wordt nu verwijderd; transcripten en notities blijven. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の会議の音声を今すぐ削除します。文字起こしとメモは残ります。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 %lld개의 오디오가 지금 삭제됩니다. 스크립트와 노트는 남습니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个会议的音频将立即删除；转写和笔记会保留。此操作无法撤销。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kokouksen äänet poistetaan nyt; litteroinnit ja muistiinpanot säilyvät. Tätä ei voi perua."
          }
        }
      }
    },
    "dosya okunamadı; desteklenen bir ses ya da video dosyası olduğunu kontrol et": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't read the file; check that it's a supported audio or video file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht gelesen werden; prüfe, ob es eine unterstützte Audio- oder Videodatei ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "impossible de lire le fichier ; vérifie qu'il s'agit d'un fichier audio ou vidéo pris en charge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se pudo leer el archivo; comprueba que sea un archivo de audio o vídeo compatible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "impossibile leggere il file; verifica che sia un file audio o video supportato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "não foi possível ler o arquivo; verifique se é um arquivo de áudio ou vídeo compatível"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bestand kon niet worden gelezen; controleer of het een ondersteund audio- of videobestand is"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。対応する音声または動画ファイルか確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽을 수 없습니다. 지원되는 오디오 또는 비디오 파일인지 확인하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件；请检查它是否为受支持的音频或视频文件"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "tiedostoa ei voitu lukea; tarkista, että se on tuettu ääni- tai videotiedosto"
          }
        }
      }
    },
    "ses kaydedilemedi; disk alanını kontrol et": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't save the audio; check disk space"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio konnte nicht gespeichert werden; prüfe den Speicherplatz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "impossible d'enregistrer l'audio ; vérifie l'espace disque"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se pudo guardar el audio; comprueba el espacio en disco"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "impossibile salvare l'audio; controlla lo spazio su disco"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "não foi possível salvar o áudio; verifique o espaço em disco"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "audio kon niet worden opgeslagen; controleer de schijfruimte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を保存できませんでした。ディスクの空き容量を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 저장할 수 없습니다. 디스크 공간을 확인하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存音频；请检查磁盘空间"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ääntä ei voitu tallentaa; tarkista levytila"
          }
        }
      }
    },
    "Dosyanın biçimi tanınmadı: bozuk ya da daha yeni bir sürümle yazılmış olabilir. Uygulamayı güncelle; sürerse geri bildirim gönder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's format wasn't recognized: it may be damaged or written by a newer version. Update the app; if it continues, send feedback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dateiformat wurde nicht erkannt: Die Datei ist evtl. beschädigt oder mit einer neueren Version geschrieben. Aktualisiere die App; falls es weiter auftritt, sende Feedback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de fichier non reconnu : il est peut-être endommagé ou écrit par une version plus récente. Mets l'app à jour ; si cela persiste, envoie un retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció el formato del archivo: puede estar dañado o haberse escrito con una versión más reciente. Actualiza la app; si continúa, envía tus comentarios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato del file non riconosciuto: potrebbe essere danneggiato o scritto da una versione più recente. Aggiorna l'app; se continua, invia un feedback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato do arquivo não foi reconhecido: ele pode estar danificado ou ter sido gravado por uma versão mais nova. Atualize o app; se continuar, envie feedback."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestandsindeling werd niet herkend: het bestand is mogelijk beschadigd of door een nieuwere versie geschreven. Werk de app bij; blijft het gebeuren, stuur dan feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル形式を認識できませんでした。破損しているか、新しいバージョンで書き込まれた可能性があります。アプリをアップデートし、解決しない場合はフィードバックを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 형식을 인식하지 못했습니다. 손상되었거나 더 최신 버전에서 작성되었을 수 있습니다. 앱을 업데이트하고, 계속되면 피드백을 보내 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别文件格式：文件可能已损坏，或由更新版本写入。请更新 App；如果问题仍然存在，请发送反馈。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoston muotoa ei tunnistettu: se voi olla vioittunut tai uudemman version kirjoittama. Päivitä sovellus; jos ongelma jatkuu, lähetä palautetta."
          }
        }
      }
    },
    "Klip kaydedilemedi: toplantının sesi okunamadı ya da dışa aktarılamadı. Yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the clip: the meeting audio couldn't be read or exported. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip konnte nicht gespeichert werden: Das Meeting-Audio ließ sich nicht lesen oder exportieren. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer l'extrait : l'audio de la réunion n'a pas pu être lu ou exporté. Réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el clip: no se pudo leer ni exportar el audio de la reunión. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la clip: non è stato possibile leggere o esportare l'audio della riunione. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o clipe: o áudio da reunião não pôde ser lido ou exportado. Tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip kon niet worden opgeslagen: de audio van de vergadering kon niet worden gelezen of geëxporteerd. Probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを保存できませんでした：会議の音声を読み込むか書き出すことができませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 저장할 수 없습니다. 회의 오디오를 읽거나 내보낼 수 없었습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存片段：无法读取或导出会议音频。请重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikettä ei voitu tallentaa: kokouksen ääntä ei voitu lukea tai viedä. Yritä uudelleen."
          }
        }
      }
    },
    "Önceki toplantılar hesabına taşınamadı (%@). Hiçbir şey silinmedi; taşınamayanlar eski yerinde kaldı, yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't move earlier meetings to your account (%@). Nothing was deleted; what couldn't be moved stayed where it was. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Meetings konnten nicht in deinen Account verschoben werden (%@). Nichts wurde gelöscht; was nicht verschoben werden konnte, blieb an seinem Ort. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déplacer les réunions précédentes vers ton compte (%@). Rien n'a été supprimé ; ce qui n'a pas pu être déplacé est resté en place. Réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mover las reuniones anteriores a tu cuenta (%@). No se borró nada; lo que no se pudo mover sigue en su sitio. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile spostare le riunioni precedenti nel tuo account (%@). Non è stato eliminato nulla; ciò che non è stato spostato è rimasto al suo posto. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover as reuniões anteriores para sua conta (%@). Nada foi apagado; o que não pôde ser movido ficou no lugar. Tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere vergaderingen konden niet naar je account worden verplaatst (%@). Er is niets verwijderd; wat niet kon worden verplaatst, bleef op zijn plek. Probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の会議をアカウントに移動できませんでした（%@）。何も削除されていません。移動できなかったものは元の場所に残っています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 회의를 계정으로 옮길 수 없습니다(%@). 아무것도 삭제되지 않았으며, 옮기지 못한 항목은 원래 위치에 남아 있습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将之前的会议移到你的账户（%@）。没有删除任何内容；未能移动的内容仍在原处。请重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiempia kokouksia ei voitu siirtää tilillesi (%@). Mitään ei poistettu; siirtämättä jääneet ovat yhä paikallaan. Yritä uudelleen."
          }
        }
      }
    },
