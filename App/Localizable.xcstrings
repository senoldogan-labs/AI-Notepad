    "Anımsatıcılar'a erişim izni yok: Sistem Ayarları › Gizlilik ve Güvenlik › Anımsatıcılar'dan %@'e izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Erinnerungen: Erlaube %@ unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Erinnerungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to Reminders: allow %@ in System Settings › Privacy & Security › Reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Recordatorios: permite %@ en Ajustes del Sistema › Privacidad y seguridad › Recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei pääsyä Muistutuksiin: salli %@ kohdassa Järjestelmäasetukset › Tietosuoja ja suojaus › Muistutukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès aux Rappels : autorisez %@ dans Réglages Système › Confidentialité et sécurité › Rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso a Promemoria: consenti %@ in Impostazioni di Sistema › Privacy e sicurezza › Promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーへのアクセス権がありません：「システム設定」›「プライバシーとセキュリティ」›「リマインダー」で%@を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에 접근할 수 없습니다: 시스템 설정 › 개인정보 보호 및 보안 › 미리 알림에서 %@을(를) 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot Herinneringen: sta %@ toe in Systeeminstellingen › Privacy en beveiliging › Herinneringen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso aos Lembretes: permita %@ em Ajustes do Sistema › Privacidade e Segurança › Lembretes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权访问提醒事项：请在“系统设置 › 隐私与安全性 › 提醒事项”中允许 %@。"
          }
        }
      }
    },
    "Anımsatıcılar'da": {
      "localizations": {
        "de": {
