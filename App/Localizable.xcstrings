          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a glass surface the desktop shows faintly through the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una superficie de vidrio, el escritorio se ve tenuemente a través de la ventana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasipinnalla työpöytä kuultaa heikosti ikkunan läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une surface en verre, le bureau transparaît légèrement à travers la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su una superficie di vetro la scrivania traspare leggermente attraverso la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスの表面では、ウインドウ越しにデスクトップがうっすら透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 표면에서는 윈도우 뒤로 데스크탑이 희미하게 비쳐 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een glazen oppervlak schemert het bureaublad zacht door het venster heen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma superfície de vidro, a mesa aparece levemente através da janela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在玻璃表面上，桌面会透过窗口隐约可见。"
          }
        }
      }
    },
