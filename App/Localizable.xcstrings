    "Mikrofon başka bir uygulamada açıldı. Toplantıyı dinlemeye başlamak için tıkla.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App hat das Mikrofon eingeschaltet. Klicke, um dem Meeting zuzuhören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app turned on the microphone. Click to start listening to the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ha activado el micrófono. Haz clic para empezar a escuchar la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen sovellus laittoi mikrofonin päälle. Aloita kokouksen kuuntelu klikkaamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app a activé le micro. Cliquez pour commencer l’écoute de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app ha attivato il microfono. Fai clic per iniziare ad ascoltare la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがマイクをオンにしました。クリックすると会議の聞き取りを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 마이크를 켰습니다. 회의 듣기를 시작하려면 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app heeft de microfoon aangezet. Klik om naar de vergadering te gaan luisteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app ativou o microfone. Clique para começar a ouvir a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 打开了麦克风。点按即可开始收听会议。"
          }
        }
      }
    },
    "Mikrofon başlatılamadı (kod %lld). Giriş cihazını kontrol edip kaydı yeniden başlat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht starten (Code %lld). Prüfe das Eingabegerät und starte die Aufnahme neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone couldn't start (code %lld). Check the input device and restart the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar el micrófono (código %lld). Revisa el dispositivo de entrada y reinicia la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonia ei voitu käynnistää (koodi %lld). Tarkista syöttölaite ja aloita nauhoitus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n’a pas pu démarrer (code %lld). Vérifiez le périphérique d’entrée et relancez l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il microfono (codice %lld). Controlla il dispositivo di input e riavvia la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを開始できませんでした（コード %lld）。入力デバイスを確認して、録音をやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 시작할 수 없습니다(코드 %lld). 입력 장치를 확인하고 녹음을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon kon niet starten (code %lld). Controleer het invoerapparaat en start de opname opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o microfone (código %lld). Verifique o dispositivo de entrada e reinicie a gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风无法启动（代码 %lld）。请检查输入设备并重新开始录制。"
          }
        }
      }
    },
    "Mikrofon bekleniyor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Mikrofon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al micrófono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan mikrofonia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを待機中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 대기 중"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op microfoon"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o microfone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待麦克风"
          }
        }
      }
    },
    "Mikrofon beklenmedik şekilde durdu; kayıt o ana kadarki sesle bitirilip işleniyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wurde unerwartet gestoppt; die Aufnahme wurde mit dem bisher erfassten Audio beendet und wird verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone stopped unexpectedly; the recording was finished with the audio captured so far and is being processed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se ha detenido inesperadamente; la grabación se ha finalizado con el audio captado hasta ahora y se está procesando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni pysähtyi odottamatta; nauhoitus päätettiin tähän mennessä tallennetulla äänellä, ja sitä käsitellään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro s’est arrêté de manière inattendue ; l’enregistrement a été terminé avec l’audio capté jusque-là et est en cours de traitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono si è interrotto inaspettatamente; la registrazione è stata conclusa con l’audio acquisito finora ed è in elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが予期せず停止しました。それまでに収録された音声で録音を終了し、処理しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 예기치 않게 중지되었습니다. 지금까지 캡처된 오디오로 녹음을 마치고 처리하는 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon is onverwacht gestopt; de opname is afgerond met de audio die tot nu toe is opgenomen en wordt verwerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone parou inesperadamente; a gravação foi encerrada com o áudio captado até agora e está sendo processada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风意外停止；录制已使用目前捕获的音频结束，正在处理。"
          }
        }
      }
    },
    "Mikrofon izni yok. Sistem Ayarları › Gizlilik ve Güvenlik › Mikrofon'da bu uygulamaya izin ver.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Mikrofonberechtigung. Erlaube diese App unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Mikrofon“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone permission. Allow this app in System Settings › Privacy & Security › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay permiso para el micrófono. Permite esta app en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mikrofonilupaa. Salli tämä sovellus kohdassa Järjestelmäasetukset › Tietosuoja ja suojaus › Mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’autorisation pour le micro. Autorisez cette app dans Réglages Système › Confidentialité et sécurité › Micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna autorizzazione per il microfono. Consenti questa app in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクの許可がありません。「システム設定」›「プライバシーとセキュリティ」›「マイク」でこのアプリを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 권한이 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 이 앱을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toestemming voor de microfoon. Sta deze app toe in Systeeminstellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão para o microfone. Permita este app em Ajustes do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请在“系统设置 › 隐私与安全性 › 麦克风”中允许此 App。"
          }
        }
      }
    },
    "Mikrofon kesildi (arama ya da alarm). Kesinti bitince kayıt kendiliğinden sürer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wurde unterbrochen (Anruf oder Wecker). Die Aufnahme wird danach automatisch fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone was interrupted (call or alarm). Recording resumes by itself when it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se ha interrumpido (llamada o alarma). La grabación se reanudará sola cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni keskeytyi (puhelu tai hälytys). Nauhoitus jatkuu itsestään, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro a été interrompu (appel ou alarme). L’enregistrement reprend de lui-même à la fin de l’interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è stato interrotto (chiamata o sveglia). La registrazione riprende da sola al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが中断されました（通話またはアラーム）。終了すると自動的に録音が再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 중단되었습니다(전화 또는 알람). 끝나면 녹음이 자동으로 재개됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon werd onderbroken (gesprek of alarm). De opname gaat vanzelf verder als dat voorbij is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone foi interrompido (chamada ou alarme). A gravação é retomada sozinha quando isso terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风被中断（来电或闹钟）。中断结束后，录制会自动恢复。"
          }
        }
      }
    },
    "Mikrofon senin sesin, sistem sesi karşı taraf. İkisi ayrı kaydedilir, konuşmacılar ayrılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon bist du, das Systemaudio ist die andere Seite. Beides wird getrennt aufgenommen und die Sprecher werden getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is you, system audio is the other side. Both are recorded separately and speakers are separated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono eres tú; el audio del sistema es la otra parte. Ambos se graban por separado y los interlocutores se separan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni olet sinä, järjestelmän ääni on toinen osapuoli. Molemmat nauhoitetaan erikseen ja puhujat erotellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro, c’est vous ; l’audio du système, c’est l’autre partie. Les deux sont enregistrés séparément et les intervenants sont séparés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono sei tu, l’audio di sistema è l’altra parte. Entrambi vengono registrati separatamente e gli interlocutori vengono separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクはあなた、システムオーディオは相手側です。両方が別々に録音され、話者が分離されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크는 나, 시스템 오디오는 상대방입니다. 둘 다 따로 녹음되고 화자가 구분됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon ben jij, systeemaudio is de andere kant. Beide worden apart opgenomen en sprekers worden gescheiden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone é você, o áudio do sistema é o outro lado. Os dois são gravados separadamente e os falantes são separados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风是你，系统音频是对方。两者分别录制，并区分说话人。"
          }
        }
      }
    },
    "Mikrofon ve sistem sesi": {
