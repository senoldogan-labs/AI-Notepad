          }
        }
      }
    },
    "Claude'da Ayarlar › Bağlayıcılar'ı aç ve \"Özel bağlayıcı ekle\"yi seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Claude „Settings › Connectors“ und wähle „Add custom connector“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude, open Settings › Connectors and choose \"Add custom connector\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Claude, abre \"Settings › Connectors\" y elige \"Add custom connector\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Claudessa \"Settings › Connectors\" ja valitse \"Add custom connector\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Claude, ouvrez « Settings › Connectors » et choisissez « Add custom connector »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude, apri “Settings › Connectors” e scegli “Add custom connector”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeで「Settings › Connectors」を開き、「Add custom connector」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude에서 \"Settings › Connectors\"를 열고 \"Add custom connector\"를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Claude \"Settings › Connectors\" en kies \"Add custom connector\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Claude, abra \"Settings › Connectors\" e escolha \"Add custom connector\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude 中打开“Settings › Connectors”，然后选择“Add custom connector”。"
          }
        }
      }
    },
    "Ad olarak %@ yaz, yukarıdaki adresi yapıştır ve ekle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne ihn %@, füge die Adresse von oben ein und füge ihn hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name it %@, paste the address above and add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle el nombre %@, pega la dirección de arriba y añádelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna nimeksi %@, liitä yllä oleva osoite ja lisää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez-le %@, collez l’adresse ci-dessus et ajoutez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiamalo %@, incolla l’indirizzo qui sopra e aggiungilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を%@にし、上のアドレスを貼り付けて追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 %@(으)로 입력하고 위의 주소를 붙여넣은 다음 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem hem %@, plak het adres hierboven en voeg hem toe."
          }
        },
        "pt-BR": {
