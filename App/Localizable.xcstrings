        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note, la transcription et l’audio seront supprimés ; cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota, trascrizione e audio vengono eliminati; l’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、文字起こし、音声が削除されます。この操作は取り消せません。"
          }
