          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步"
          }
        }
      }
    },
    "Eşitleniyor…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird synchronisiert …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoidaan…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 중…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseren…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在同步…"
          }
        }
      }
    },
    "Kapatınca sunucudaki şifreli kopya silinir ve diğer cihazlarında da eşitleme durur. Toplantıların her cihazda yerinde kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ausschalten wird die verschlüsselte Kopie auf unserem Server gelöscht und die Synchronisierung stoppt auch auf deinen anderen Geräten. Deine Meetings bleiben auf jedem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning it off deletes the encrypted copy on our server and stops sync on your other devices too. Your meetings stay on each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarla se elimina la copia cifrada de nuestro servidor y la sincronización también se detiene en tus otros dispositivos. Tus reuniones se quedan en cada dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun poistat sen käytöstä, palvelimemme salattu kopio poistetaan ja synkronointi pysähtyy myös muilla laitteillasi. Kokouksesi pysyvät jokaisella laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désactiver supprime la copie chiffrée sur notre serveur et arrête aussi la synchronisation sur vos autres appareils. Vos réunions restent sur chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivandola, la copia cifrata sul nostro server viene eliminata e la sincronizzazione si ferma anche sugli altri dispositivi. Le tue riunioni restano su ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、サーバー上の暗号化コピーが削除され、ほかのデバイスでも同期が止まります。会議はそれぞれのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 서버의 암호화된 사본이 삭제되고 다른 기기에서도 동기화가 멈춥니다. 회의는 각 기기에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het uitzet, wordt de versleutelde kopie op onze server verwijderd en stopt synchronisatie ook op je andere apparaten. Je vergaderingen blijven op elk apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao desativar, a cópia criptografada no nosso servidor é apagada e a sincronização também para nos seus outros dispositivos. Suas reuniões ficam em cada dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，我们服务器上的加密副本会被删除，你的其他设备也会停止同步。你的会议保留在每台设备上。"
          }
        }
      }
    },
    "Kendi notların iki cihazda düzenlendi; iki sürüm de notta duruyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Notizen wurden auf zwei Geräten bearbeitet; beide Versionen stehen in der Notiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own notes were edited on two devices; both versions are kept in the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus propias notas se editaron en dos dispositivos; ambas versiones están en la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omia muistiinpanojasi muokattiin kahdella laitteella; molemmat versiot ovat muistiinpanossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres notes ont été modifiées sur deux appareils ; les deux versions sont conservées dans la note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue note sono state modificate su due dispositivi; entrambe le versioni restano nella nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のメモが2台のデバイスで編集されました。両方のバージョンがメモに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 노트가 두 기기에서 편집되었습니다. 두 버전 모두 노트에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen notities zijn op twee apparaten bewerkt; beide versies staan in de notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas próprias notas foram editadas em dois dispositivos; as duas versões ficam na nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的笔记在两台设备上被编辑；两个版本都保留在笔记中。"
          }
        }
      }
    },
