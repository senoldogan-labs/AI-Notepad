    "Aynı odadaki toplantı: mikrofondaki herkes konuşmacılara ayrılır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting im selben Raum: Alle am Mikrofon werden in Sprecher getrennt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting in the same room: everyone on the microphone is separated into speakers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunión en la misma sala: todos los que hablan al micrófono se separan en interlocutores"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokous samassa huoneessa: kaikki mikrofoniin puhuvat erotellaan puhujiksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunion dans la même pièce : toutes les personnes captées par le micro sont séparées en intervenants"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunione nella stessa stanza: tutti quelli che parlano al microfono vengono separati in interlocutori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ部屋での会議：マイクに入る全員を話者ごとに分離します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 공간에서 하는 회의: 마이크에 잡힌 모든 사람이 화자별로 구분됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergadering in dezelfde ruimte: iedereen op de microfoon wordt in sprekers gescheiden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunião na mesma sala: todos no microfone são separados em falantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一房间内的会议：麦克风收录的所有人都会被区分为不同说话人"
          }
        }
      }
    },
    "Aynı toplantı hedefte zaten var: %@. İki kopyayı karşılaştırıp birini sil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Meeting existiert bereits am Ziel: %@. Vergleiche die beiden Kopien und lösche eine davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same meeting already exists at the destination: %@. Compare the two copies and delete one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma reunión ya existe en el destino: %@. Compara las dos copias y elimina una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama kokous on jo kohteessa: %@. Vertaa kahta kopiota ja poista toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même réunion existe déjà à la destination : %@. Comparez les deux copies et supprimez-en une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa riunione esiste già nella destinazione: %@. Confronta le due copie ed eliminane una."
