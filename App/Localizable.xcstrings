    "Aramada kaydı başlat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Anruf die Aufnahme starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording in the call"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar en la llamada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita nauhoitus puhelussa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez l’enregistrement pendant l’appel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la registrazione nella chiamata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中に録音を開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 중 녹음 시작"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de opname in het gesprek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a gravar na ligação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通话中开始录音"
          }
        }
      }
    },
    "Görüşme sırasında ekranın sol üstündeki kayıt düğmesine dokun. iPhone kaydın başladığını iki tarafa da duyurur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe während des Gesprächs oben links auf die Aufnahmetaste. Das iPhone kündigt beiden Seiten an, dass aufgezeichnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the call, tap the record button at the top left of the screen. iPhone announces to both sides that recording has started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la llamada, toca el botón de grabar en la parte superior izquierda de la pantalla. El iPhone avisa a ambas partes de que ha empezado la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta puhelun aikana näytön vasemman yläkulman nauhoituspainiketta. iPhone kertoo molemmille osapuolille, että nauhoitus alkoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant l’appel, touchez le bouton d’enregistrement en haut à gauche de l’écran. L’iPhone annonce aux deux interlocuteurs que l’enregistrement a commencé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la chiamata, tocca il pulsante di registrazione in alto a sinistra. L’iPhone annuncia a entrambe le parti che la registrazione è iniziata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中に画面左上の録音ボタンをタップします。iPhoneが録音の開始を双方に知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 중에 화면 왼쪽 상단의 녹음 버튼을 탭하세요. iPhone이 양쪽 모두에게 녹음이 시작되었음을 알립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik tijdens het gesprek linksboven op de opnameknop. De iPhone meldt beide kanten dat de opname is gestart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a ligação, toque no botão de gravar no canto superior esquerdo da tela. O iPhone avisa os dois lados de que a gravação começou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话时轻点屏幕左上角的录音按钮。iPhone 会告知双方录音已开始。"
          }
        }
      }
    },
    "Sesi Gistsmith'e gönder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio an Gistsmith senden"
          }
        },
        "en": {
