    "Satın alma tamamlanamadı; yeniden dene. Sürerse destekle paylaşmak için hata kodu: %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden; versuch es erneut. Falls es weiter passiert, teile diesen Fehlercode mit dem Support: %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn't be completed; try again. If it keeps happening, share this error code with support: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra; vuelve a intentarlo. Si sigue pasando, comparte este código de error con soporte: %lld"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu viedä loppuun; yritä uudelleen. Jos tämä toistuu, kerro tukeen tämä virhekoodi: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
