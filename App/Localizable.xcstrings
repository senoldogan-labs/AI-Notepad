    "Bitmiş bir özelliği yeni sürüm çıkarmadan açıp kapatan ayar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellung, die eine fertige Funktion ohne neues Release ein- oder ausschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A setting that turns a finished feature on or off without a new release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajuste que activa o desactiva una función terminada sin publicar una nueva versión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetus, jolla valmis ominaisuus kytketään päälle tai pois ilman uutta julkaisua."
          }
        },
        "fr": {
