      }
    },
    "Konuşmacılar ayrılamadı (%@); metin tek konuşmacı olarak kaydedildi. İnternete bağlanıp \"Tekrar işle\"yi dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprecher konnten nicht getrennt werden (%@); der Text wurde als ein einziger Sprecher gesichert. Stelle eine Internetverbindung her und versuche „Neu verarbeiten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakers couldn't be separated (%@); the text was saved as a single speaker. Connect to the internet and try \"Reprocess\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido separar los interlocutores (%@); el texto se ha guardado como un único interlocutor. Conéctate a internet y prueba con “Reprocesar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhujia ei voitu erotella (%@); teksti tallennettiin yhtenä puhujana. Muodosta internetyhteys ja kokeile valintaa ”Käsittele uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intervenants n’ont pas pu être séparés (%@) ; le texte a été enregistré comme un seul intervenant. Connectez-vous à Internet et essayez « Retraiter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile separare gli interlocutori (%@); il testo è stato salvato come un unico interlocutore. Connettiti a internet e prova “Rielabora”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者を分離できませんでした（%@）。テキストは1人の話者として保存されました。インターネットに接続して、「再処理」をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자를 구분할 수 없어(%@) 텍스트가 단일 화자로 저장되었습니다. 인터넷에 연결하고 \"다시 처리\"를 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekers konden niet worden gescheiden (%@); de tekst is als één spreker bewaard. Maak verbinding met internet en probeer \"Opnieuw verwerken\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível separar os falantes (%@); o texto foi salvo como um único falante. Conecte-se à internet e tente \"Reprocessar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法区分说话人（%@）；文字已存储为单个说话人。请连接互联网后尝试“重新处理”。"
          }
        }
      }
    },
