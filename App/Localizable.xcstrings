    "Ayarlar › Bağlantılar › Görev araçları'ndan Linear ya da Jira bağla": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Linear oder Jira unter „Einstellungen“ › „Verbindungen“ › „Aufgaben-Tools“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Linear or Jira in Settings › Connections › Task tools"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Linear o Jira en Ajustes › Conexiones › Herramientas de tareas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Linear tai Jira kohdassa Asetukset › Yhteydet › Tehtävätyökalut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Linear ou Jira dans Réglages › Connexions › Outils de tâches"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Linear o Jira in Impostazioni › Connessioni › Strumenti per le attività"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」›「連携」›「タスクツール」でLinearまたはJiraを接続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › 연결 › 할 일 도구에서 Linear 또는 Jira 연결"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel Linear of Jira in Instellingen › Koppelingen › Taaktools"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Linear ou o Jira em Ajustes › Conexões › Ferramentas de tarefas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置 › 连接 › 任务工具”中连接 Linear 或 Jira"
          }
        }
      }
    },
    "Ayarlar › Bağlantılar'dan kanal ekle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter „Einstellungen“ › „Verbindungen“ einen Kanal hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a channel in Settings › Connections"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un canal en Ajustes › Conexiones"
          }
        },
        "fi": {
