            "value": "オーディオでもビデオでもないため読み込みませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오나 비디오가 아니어서 가져오지 않았습니다: %@"
          }
        },
        "nl": {
          "stringUnit": {
