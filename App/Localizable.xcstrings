          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모 열기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Notities"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Notas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“备忘录”"
          }
        }
      }
    },
    "Paylaşımda Gistsmith görünmüyorsa sesi Dosyalar'a kaydet ve buradan seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Gistsmith beim Teilen fehlt, sichere das Audio in „Dateien“ und wähle es hier aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Gistsmith isn't in the share sheet, save the audio to Files and choose it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Gistsmith no aparece al compartir, guarda el audio en Archivos y elígelo aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos Gistsmith ei näy jakovalikossa, tallenna ääni Tiedostoihin ja valitse se täältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Gistsmith n’apparaît pas dans le partage, enregistrez l’audio dans Fichiers et choisissez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Gistsmith non compare nella condivisione, salva l’audio in File e sceglilo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有にGistsmithが表示されない場合は、オーディオを「ファイル」に保存してここで選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유에 Gistsmith가 보이지 않으면 오디오를 파일에 저장한 뒤 여기에서 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat Gistsmith niet bij het delen, bewaar de audio dan in Bestanden en kies hem hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Gistsmith não aparecer ao compartilhar, salve o áudio no Arquivos e escolha-o aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果共享中没有 Gistsmith，请将音频存储到“文件”，然后在这里选取。"
          }
        }
      }
    },
    "Arama kaydı olmayan bölgelerde ve WhatsApp, Teams, Zoom gibi uygulama aramalarında görüşmeyi Mac'te yap (iPhone aramaları da Mac'ten açılabilir). Mac'teki Gistsmith iki tarafı da kaydeder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo es keine Anrufaufzeichnung gibt, und bei App-Anrufen wie WhatsApp, Teams oder Zoom, telefoniere am Mac (auch iPhone-Anrufe kannst du dort führen). Gistsmith auf dem Mac nimmt beide Seiten auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where call recording isn't available, and for app calls such as WhatsApp, Teams or Zoom, take the call on your Mac (you can make and answer iPhone calls there too). Gistsmith on the Mac records both sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde no haya grabación de llamadas, y para llamadas de apps como WhatsApp, Teams o Zoom, atiende la llamada en tu Mac (también puedes hacer y recibir allí las llamadas del iPhone). Gistsmith en el Mac graba a ambas partes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos puhelun nauhoitusta ei ole, ja appipuheluissa kuten WhatsApp, Teams tai Zoom, puhu Macilla (myös iPhone-puheluita voi soittaa ja vastaanottaa siellä). Macin Gistsmith nauhoittaa molemmat osapuolet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où l’enregistrement d’appels n’existe pas, et pour les appels d’apps comme WhatsApp, Teams ou Zoom, prenez l’appel sur votre Mac (vous pouvez aussi y passer et recevoir vos appels iPhone). Gistsmith sur Mac enregistre les deux interlocuteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove la registrazione chiamate non c’è, e per le chiamate di app come WhatsApp, Teams o Zoom, rispondi sul Mac (lì puoi fare e ricevere anche le chiamate dell’iPhone). Gistsmith sul Mac registra entrambe le parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話録音がない地域や、WhatsApp、Teams、Zoomなどのアプリの通話は、Macで通話してください（iPhoneの電話もMacでかけたり受けたりできます）。MacのGistsmithが双方の声を録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 녹음이 없는 지역이나 WhatsApp, Teams, Zoom 같은 앱 통화는 Mac에서 통화하세요(iPhone 전화도 Mac에서 걸고 받을 수 있습니다). Mac의 Gistsmith가 양쪽을 모두 녹음합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar gespreksopname niet bestaat, en voor app-gesprekken zoals WhatsApp, Teams of Zoom, voer je het gesprek op je Mac (daar kun je ook iPhone-gesprekken voeren). Gistsmith op de Mac neemt beide kanten op."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde não houver gravação de chamadas, e em ligações de apps como WhatsApp, Teams ou Zoom, atenda no Mac (lá você também pode fazer e receber as ligações do iPhone). O Gistsmith no Mac grava os dois lados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有通话录音的地区，以及 WhatsApp、Teams、Zoom 等 App 通话中，请在 Mac 上通话（也可以在 Mac 上拨打和接听 iPhone 电话）。Mac 上的 Gistsmith 会录下双方的声音。"
          }
        }
      }
    },
    "Gistsmith'ten arama şu an kullanılamıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling from Gistsmith isn't available right now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe über Gistsmith sind gerade nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels depuis Gistsmith ne sont pas disponibles pour le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas desde Gistsmith no están disponibles ahora mismo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate da Gistsmith non sono disponibili al momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas pelo Gistsmith não estão disponíveis agora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellen via Gistsmith is nu niet beschikbaar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Gistsmith からの発信は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Gistsmith에서 전화를 걸 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法通过 Gistsmith 拨打电话。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittaminen Gistsmithistä ei ole nyt käytettävissä."
          }
        }
      }
    },
    "Aramadan önce kayıt koşullarını kabul et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the call recording terms before calling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiere vor dem Anrufen die Bedingungen für die Anrufaufzeichnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepte les conditions d'enregistrement des appels avant d'appeler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta las condiciones de grabación de llamadas antes de llamar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta le condizioni di registrazione delle chiamate prima di chiamare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceite os termos de gravação de chamadas antes de ligar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer de voorwaarden voor gespreksopname voordat je belt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発信する前に通話録音の条件に同意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 걸기 전에 통화 녹음 조건에 동의하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨打电话前，请先接受通话录音条款。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksy puhelujen tallennuksen ehdot ennen soittamista."
          }
        }
      }
    },
    "Aramadan önce kendi telefon numaranı doğrula.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your own phone number before calling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige vor dem Anrufen deine eigene Telefonnummer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ton propre numéro de téléphone avant d'appeler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu propio número de teléfono antes de llamar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica il tuo numero di telefono prima di chiamare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique seu próprio número de telefone antes de ligar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer je eigen telefoonnummer voordat je belt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発信する前にご自身の電話番号を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 걸기 전에 내 전화번호를 인증하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨打电话前，请先验证你自己的电话号码。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista oma puhelinnumerosi ennen soittamista."
          }
        }
      }
    },
    "Numara geçersiz. Ülke koduyla yaz, ör. +1 415 555 0100.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That number isn't valid. Include the country code, e.g. +1 415 555 0100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer ist ungültig. Gib sie mit Ländervorwahl ein, z. B. +1 415 555 0100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro n'est pas valide. Ajoute l'indicatif du pays, par ex. +1 415 555 0100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese número no es válido. Incluye el prefijo del país, p. ej. +1 415 555 0100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero non è valido. Includi il prefisso internazionale, ad es. +1 415 555 0100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse número não é válido. Inclua o código do país, por ex. +1 415 555 0100."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit nummer is ongeldig. Voeg de landcode toe, bijv. +1 415 555 0100."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号が無効です。国番号を付けて入力してください（例: +1 415 555 0100）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호가 올바르지 않습니다. 국가 번호를 포함해 입력하세요(예: +1 415 555 0100)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "号码无效。请包含国家代码，例如 +1 415 555 0100。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numero ei kelpaa. Lisää maatunnus, esim. +1 415 555 0100."
          }
        }
      }
    },
    "Bu numara Gistsmith'ten aranamaz: ücretli, özel ya da desteklenmeyen bir ülkedeki numaralar engelli.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number can't be called from Gistsmith: premium-rate, special and unsupported-country numbers are blocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer kann nicht über Gistsmith angerufen werden: Premium-, Sonder- und Nummern aus nicht unterstützten Ländern sind gesperrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro ne peut pas être appelé depuis Gistsmith : les numéros surtaxés, spéciaux et de pays non pris en charge sont bloqués."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede llamar a este número desde Gistsmith: los números de tarificación adicional, especiales y de países no compatibles están bloqueados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero non può essere chiamato da Gistsmith: i numeri a tariffa maggiorata, speciali e di paesi non supportati sono bloccati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ligar para este número pelo Gistsmith: números de tarifa premium, especiais e de países não compatíveis são bloqueados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit nummer kan niet via Gistsmith worden gebeld: betaalnummers, speciale nummers en nummers in niet-ondersteunde landen zijn geblokkeerd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号には Gistsmith から発信できません。有料番号、特殊番号、対応していない国の番号はブロックされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 번호로는 Gistsmith에서 전화를 걸 수 없습니다. 유료, 특수 번호와 지원하지 않는 국가의 번호는 차단됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Gistsmith 拨打此号码：付费号码、特殊号码和不支持国家/地区的号码均被屏蔽。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän numeroon ei voi soittaa Gistsmithistä: maksulliset, erikois- ja tukemattomien maiden numerot on estetty."
          }
        }
      }
    },
    "Bu numara başka bir Gistsmith hesabında kullanılıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number is already used by another Gistsmith account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer wird bereits von einem anderen Gistsmith-Account verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro est déjà utilisé par un autre compte Gistsmith."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número ya lo usa otra cuenta de Gistsmith."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero è già usato da un altro account Gistsmith."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número já é usado por outra conta do Gistsmith."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit nummer wordt al door een ander Gistsmith-account gebruikt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号は別の Gistsmith アカウントで使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 번호는 다른 Gistsmith 계정에서 이미 사용 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此号码已被另一个 Gistsmith 账户使用。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä numero on jo toisen Gistsmith-tilin käytössä."
          }
        }
      }
    },
    "Bugün çok fazla doğrulama araması yapıldı; yarın yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many verification calls today; try again tomorrow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute gab es zu viele Bestätigungsanrufe; versuche es morgen erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d'appels de vérification aujourd'hui ; réessaie demain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas llamadas de verificación hoy; vuelve a intentarlo mañana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe chiamate di verifica oggi; riprova domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas chamadas de verificação hoje; tente novamente amanhã."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verificatiegesprekken vandaag; probeer het morgen opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の確認通話が多すぎます。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 인증 전화가 너무 많았습니다. 내일 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的验证来电过多，请明天再试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta vahvistuspuhelua tänään; yritä huomenna uudelleen."
          }
        }
      }
    },
    "Hesabında süren başka bir arama var; o bitince yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another call is running on your account; try again when it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Account läuft bereits ein anderer Anruf; versuche es erneut, wenn er beendet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appel est en cours sur ton compte ; réessaie quand il sera terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra llamada en curso en tu cuenta; vuelve a intentarlo cuando termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra chiamata è in corso sul tuo account; riprova quando termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há outra chamada em andamento na sua conta; tente novamente quando ela terminar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een ander gesprek op je account; probeer het opnieuw als dat is afgelopen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントで別の通話が進行中です。終了してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에서 다른 통화가 진행 중입니다. 통화가 끝나면 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户中有另一通电话正在进行，请在结束后再试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tililläsi on käynnissä toinen puhelu; yritä uudelleen, kun se päättyy."
          }
        }
      }
    },
    "Bu ayki arama dakikaların doldu; ay başında yenilenir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this month's call minutes; they renew at the start of the month."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anrufminuten für diesen Monat sind aufgebraucht; sie werden zum Monatsanfang erneuert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as utilisé tes minutes d'appel de ce mois ; elles sont renouvelées au début du mois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado los minutos de llamada de este mes; se renuevan a principios de mes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai esaurito i minuti di chiamata di questo mese; si rinnovano all'inizio del mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou os minutos de chamada deste mês; eles são renovados no início do mês."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je belminuten voor deze maand zijn op; ze worden aan het begin van de maand vernieuwd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の通話時間を使い切りました。月初めに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 통화 시간을 모두 사용했습니다. 매월 초에 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的通话分钟数已用完，将在月初重置。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun puheluminuutit on käytetty; ne uusiutuvat kuun alussa."
          }
        }
      }
    },
    "Arama bugün çok yoğun; yarın yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling is at capacity today; try again tomorrow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe sind heute ausgelastet; versuche es morgen erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels ont atteint leur capacité aujourd'hui ; réessaie demain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas están al límite de capacidad hoy; vuelve a intentarlo mañana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate hanno raggiunto la capacità massima oggi; riprova domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas atingiram a capacidade hoje; tente novamente amanhã."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellen zit vandaag aan de capaciteit; probeer het morgen opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日は通話が上限に達しています。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 통화 용량이 가득 찼습니다. 내일 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天通话已达容量上限，请明天再试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittamisen kapasiteetti on tänään täynnä; yritä huomenna uudelleen."
          }
        }
      }
    },
    "Aramanın kaydı henüz hazır değil ya da silindi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call's recording isn't ready yet or was deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme des Anrufs ist noch nicht bereit oder wurde gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement de l'appel n'est pas encore prêt ou a été supprimé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de la llamada aún no está lista o se eliminó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione della chiamata non è ancora pronta o è stata eliminata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação da chamada ainda não está pronta ou foi excluída."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname van het gesprek is nog niet klaar of is verwijderd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の録音はまだ準備できていないか、削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 녹음이 아직 준비되지 않았거나 삭제되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话录音尚未就绪或已被删除。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelun tallenne ei ole vielä valmis tai se on poistettu."
          }
        }
      }
    },
    "Bu ayki kayıt saatlerin doldu; arama da kaydedileceği için yeni arama ay başında açılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's recording hours are used up; since calls are recorded too, new calls open at the start of the month."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmestunden für diesen Monat sind aufgebraucht; da auch Anrufe aufgezeichnet werden, sind neue Anrufe ab Monatsanfang wieder möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes heures d'enregistrement de ce mois sont épuisées ; comme les appels sont aussi enregistrés, les nouveaux appels redeviennent possibles au début du mois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han agotado las horas de grabación de este mes; como las llamadas también se graban, podrás hacer nuevas llamadas a principios de mes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di registrazione di questo mese sono esaurite; poiché anche le chiamate vengono registrate, potrai fare nuove chiamate dall'inizio del mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de gravação deste mês acabaram; como as chamadas também são gravadas, novas chamadas ficam disponíveis no início do mês."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opname-uren voor deze maand zijn op; omdat gesprekken ook worden opgenomen, kun je aan het begin van de maand weer bellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の録音時間を使い切りました。通話も録音されるため、新しい通話は月初めから可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 녹음 시간을 모두 사용했습니다. 통화도 녹음되므로 새 통화는 매월 초부터 가능합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的录音时长已用完；由于通话也会被录音，新的通话将在月初恢复。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun tallennustunnit on käytetty; koska puhelutkin tallennetaan, uudet puhelut ovat mahdollisia kuun alussa."
          }
        }
      }
    },
    "Kendi numaranı ülke koduyla yaz, ör. +1 415 555 0100.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your own number with the country code, e.g. +1 415 555 0100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine eigene Nummer mit Ländervorwahl ein, z. B. +1 415 555 0100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis ton propre numéro avec l'indicatif du pays, par ex. +1 415 555 0100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu propio número con el prefijo del país, p. ej. +1 415 555 0100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo numero con il prefisso internazionale, ad es. +1 415 555 0100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu próprio número com o código do país, por ex. +1 415 555 0100."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je eigen nummer in met de landcode, bijv. +1 415 555 0100."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身の番号を国番号付きで入力してください（例: +1 415 555 0100）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 번호를 포함해 내 번호를 입력하세요(예: +1 415 555 0100)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入带国家代码的你自己的号码，例如 +1 415 555 0100。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita oma numerosi maatunnuksen kanssa, esim. +1 415 555 0100."
          }
        }
      }
    },
    "Numara doğrulanamadı. Aramayı açıp kodu tuşladığından emin ol ve yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number couldn't be verified. Make sure you answer the call and type the code, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nummer konnte nicht bestätigt werden. Nimm den Anruf an, gib den Code ein und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro n'a pas pu être vérifié. Assure-toi de répondre à l'appel et de saisir le code, puis réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el número. Asegúrate de contestar la llamada y marcar el código, y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il numero. Assicurati di rispondere alla chiamata e digitare il codice, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o número. Atenda a chamada e digite o código, depois tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nummer kon niet worden geverifieerd. Neem het gesprek aan, toets de code in en probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を確認できませんでした。電話に出てコードを入力したことを確かめ、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호를 인증하지 못했습니다. 전화를 받고 코드를 입력했는지 확인한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证该号码。请确认已接听来电并输入验证码，然后重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeroa ei voitu vahvistaa. Varmista, että vastaat puheluun ja näppäilet koodin, ja yritä uudelleen."
          }
        }
      }
    },
    "Doğrulama zaman aşımına uğradı; yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification timed out; try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung ist abgelaufen; versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification a expiré ; réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación caducó; vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica è scaduta; riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação expirou; tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verificatie is verlopen; probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認がタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 시간이 초과되었습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已超时，请重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistus aikakatkaistiin; yritä uudelleen."
          }
        }
      }
    },
    "Süren bir arama var.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call is already in progress."
          }
        },
        "de": {
          "stringUnit": {
