    "%@ erişimin uygulamadan geri alınmasını desteklemiyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt das Widerrufen des Zugriffs aus der App nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't support revoking access from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no permite revocar el acceso desde la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei tue käyttöoikeuden perumista sovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne permet pas de révoquer l’accès depuis l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non supporta la revoca dell’accesso dall’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はアプリからのアクセス取り消しに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 앱에서 접근 권한 취소를 지원하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ondersteunt het intrekken van toegang vanuit de app niet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não permite revogar o acesso pelo app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持从 App 中撤销访问权限。"
          }
        }
      }
    },
    "%@ etiketini kaldır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %@ entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove tag %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar la etiqueta %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tunniste %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le tag %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi tag %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグ%@を削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 태그 제거"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder tag %@"
          }
        },
        "pt-BR": {
