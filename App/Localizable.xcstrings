    "Çevrimdışı kayıt yarıda kaldı; kaydedilen kısım bağlantı gelince işlenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Aufnahme wurde unterbrochen; der aufgenommene Teil wird verarbeitet, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offline recording was interrupted; the recorded part will be processed when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación sin conexión se ha interrumpido; la parte grabada se procesará cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-nauhoitus keskeytyi; nauhoitettu osa käsitellään, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement hors ligne a été interrompu ; la partie enregistrée sera traitée lorsque vous serez de nouveau en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione offline è stata interrotta; la parte registrata verrà elaborata quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインでの録音が中断されました。録音済みの部分はオンラインに戻ったときに処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 녹음이 중단되었습니다. 다시 온라인 상태가 되면 녹음된 부분이 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De offline opname is onderbroken; het opgenomen deel wordt verwerkt zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação offline foi interrompida; a parte gravada será processada quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线录制被中断；恢复联网后会处理已录制的部分。"
          }
        }
      }
    },
