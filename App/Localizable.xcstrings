    "Senin konuşmaların (\"Sen\").": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du sagst („Du“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you say (\"You\")."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que dices tú (“Tú”)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä sinä sanot (”Sinä”)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous dites (« Vous »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che dici tu (“Tu”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの発言（「自分」）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말하는 내용(\"나\")."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat jij zegt (\"Jij\")."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você diz (\"Você\")."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的内容（“你”）。"
          }
        }
      }
    },
    "Servis bugün çok yoğun; yeni toplantılar ve yapay zekâ istekleri geçici olarak durduruldu. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst ist heute stark ausgelastet; neue Meetings und KI-Anfragen sind vorerst pausiert. Versuche es etwas später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is very busy today; new meetings and AI requests are paused for now. Try again a bit later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio está muy ocupado hoy; las reuniones nuevas y las solicitudes de IA están en pausa por ahora. Inténtalo de nuevo un poco más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelu on tänään hyvin kuormitettu; uudet kokoukset ja tekoälypyynnöt on toistaiseksi keskeytetty. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service est très sollicité aujourd’hui ; les nouvelles réunions et les requêtes d’IA sont suspendues pour le moment. Réessayez un peu plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi il servizio è molto occupato; le nuove riunioni e le richieste AI sono sospese per ora. Riprova un po’ più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日はサービスが非常に混み合っているため、新しい会議とAIリクエストを一時停止しています。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 서비스가 매우 바빠 새 회의와 AI 요청이 잠시 중단되었습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dienst is vandaag erg druk; nieuwe vergaderingen en AI-verzoeken zijn voorlopig gepauzeerd. Probeer het iets later opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço está muito ocupado hoje; novas reuniões e solicitações de IA estão pausadas por enquanto. Tente de novo um pouco mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务今天非常繁忙；新会议和 AI 请求暂时暂停。请稍后再试。"
          }
        }
      }
    },
    "Ses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        },
        "en": {
