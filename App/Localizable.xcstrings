      }
    },
    "Kısayol atanmadı. Seç": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurzbefehl zugewiesen. Auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcut assigned. Choose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún atajo asignado. Elegir"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikanäppäintä ei ole määritetty. Valitse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci attribué. Choisir"
          }
        },
        "it": {
