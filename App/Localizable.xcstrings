            "value": "받아쓰기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写"
          }
        }
      }
    },
    "Kısayola basıp konuş; söylediğin, imlecin olduğu yere yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück das Tastenkürzel und sprich; deine Worte erscheinen an der Cursorposition."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut and speak; your words are typed where the cursor is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el atajo y habla; lo que dices se escribe donde está el cursor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina pikanäppäintä ja puhu; sanasi kirjoitetaan kohdistimen kohdalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur le raccourci et parle ; tes mots s'écrivent là où se trouve le curseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la scorciatoia e parla; le tue parole vengono scritte dove si trova il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押して話すと、カーソルの位置に入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르고 말하면 커서 위치에 입력됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de sneltoets en spreek; je woorden worden getypt waar de cursor staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o atalho e fale; suas palavras são digitadas onde está o cursor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷键说话；你说的话会输入到光标所在位置。"
          }
        }
      }
    },
    "Basılı tut ya da kısa dokun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten oder kurz tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it, or tap it briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenlo pulsado o tócalo brevemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painettuna tai napauta lyhyesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens-le ou appuie brièvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienila premuta o toccala brevemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しするか、短くタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르거나 짧게 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingedrukt houden of kort tikken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ou toque rapidamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住或短按。"
          }
        }
      }
    },
    "Metni yazdığın yere yapıştırmak (⌘V) için gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um Text dort einzufügen, wo du schreibst (⌘V)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to paste text where you're typing (⌘V)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para pegar el texto donde escribes (⌘V)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan tekstin liittämiseen kirjoituskohtaan (⌘V)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour coller le texte là où tu écris (⌘V)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per incollare il testo dove stai scrivendo (⌘V)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中の場所にテキストをペースト（⌘V）するために必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 중인 곳에 텍스트를 붙여넣으려면(⌘V) 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om tekst te plakken waar je typt (⌘V)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para colar o texto onde você está digitando (⌘V)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你输入的位置粘贴文本（⌘V）。"
          }
        }
      }
    },
    "Hesabın, aboneliğin ve sunucudaki kayıtların silinir; bu Mac'teki notlar kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht deinen Account, dein Abo und die Daten auf dem Server; Notizen auf diesem Mac bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes your account, subscription and server records; notes on this Mac stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta, tu suscripción y los datos del servidor; las notas de este Mac se quedan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tilisi, tilauksesi ja palvelimen tiedot; tämän Macin muistiinpanot säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ton compte, ton abonnement et les données du serveur ; les notes de ce Mac restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina account, abbonamento e dati sul server; le note su questo Mac restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、サブスクリプション、サーバー上の記録を削除します。このMacのノートは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정, 구독, 서버의 기록이 삭제됩니다. 이 Mac의 노트는 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je account, abonnement en servergegevens; notities op deze Mac blijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui sua conta, sua assinatura e os dados no servidor; as notas deste Mac continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除你的账户、订阅和服务器上的记录；这台 Mac 上的笔记会保留。"
          }
        }
      }
    },
