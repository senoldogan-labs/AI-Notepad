    "Son dakikaların özetini gösterir; toplantıya soru da sorabilirsin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Zusammenfassung der letzten Minuten; du kannst auch Fragen zum Meeting stellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a summary of the last minutes; you can also ask about the meeting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un resumen de los últimos minutos; también puedes preguntar sobre la reunión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää yhteenvedon viime minuuteista; voit myös kysyä kokouksesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un résumé des dernières minutes ; vous pouvez aussi poser des questions sur la réunion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un riepilogo degli ultimi minuti; puoi anche fare domande sulla riunione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近数分間の要約を表示します。会議について質問することもできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 몇 분의 요약을 보여 줍니다. 회의에 대해 질문할 수도 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een samenvatting van de laatste minuten; je kunt ook vragen stellen over de vergadering"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um resumo dos últimos minutos; você também pode perguntar sobre a reunião"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最近几分钟的摘要；你也可以询问有关会议的问题"
          }
        }
      }
    },
