    "Yazı alanı seçili değil; metin panoya kopyalandı. ⌘V ile yapıştır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Textfeld ausgewählt; der Text wurde in die Zwischenablage kopiert. Mit ⌘V einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text field selected; the text was copied to the clipboard. Paste with ⌘V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún campo de texto seleccionado; el texto se copió al portapapeles. Pégalo con ⌘V."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstikenttää ei ole valittu; teksti kopioitiin leikepöydälle. Liitä ⌘V:llä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
