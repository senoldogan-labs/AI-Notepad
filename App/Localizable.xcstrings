    "Anımsatıcılar'da liste yok: Anımsatıcılar uygulamasında bir liste oluştur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen hat keine Liste: Erstelle eine in der App „Erinnerungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders has no list: create one in the Reminders app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios no tiene ninguna lista: crea una en la app Recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutuksissa ei ole listaa: luo sellainen Muistutukset-apissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels n’a aucune liste : créez-en une dans l’app Rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria non ha nessun elenco: creane uno nell’app Promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーにリストがありません：リマインダーAppでリストを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에 목록이 없습니다. 미리 알림 앱에서 목록을 생성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen heeft geen lijst: maak er een aan in de Herinneringen-app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app Lembretes não tem nenhuma lista: crie uma no app Lembretes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒事项中没有列表：请在“提醒事项” App 中创建一个列表。"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能"
          }
        }
      }
    },
    "Apple Intelligence güvenlik denetimi bu metni işlemedi. Kendi anahtarınla bir sağlayıcı seçip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsprüfung von Apple Intelligence hat diesen Text nicht verarbeitet. Wähle einen Anbieter mit eigenem Schlüssel und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence's safety check didn't process this text. Choose a provider with your own key and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación de seguridad de Apple Intelligence no ha procesado este texto. Elige un proveedor con tu propia clave e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligencen turvatarkistus ei käsitellyt tätä tekstiä. Valitse palveluntarjoaja omalla avaimellasi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle de sécurité d’Apple Intelligence n’a pas traité ce texte. Choisissez un fournisseur avec votre propre clé et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo di sicurezza di Apple Intelligence non ha elaborato questo testo. Scegli un fornitore con la tua chiave e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceの安全性チェックにより、このテキストは処理されませんでした。独自のキーを使うプロバイダを選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence의 안전 검사에서 이 텍스트를 처리하지 않았습니다. 자신의 키를 사용하는 제공업체를 선택하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De veiligheidscontrole van Apple Intelligence heeft deze tekst niet verwerkt. Kies een aanbieder met je eigen sleutel en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação de segurança da Apple Intelligence não processou este texto. Escolha um provedor com sua própria chave e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能的安全检查未处理此文本。请选择使用你自己密钥的提供商后重试。"
          }
        }
      }
    },
    "Apple Intelligence kapalı. Mac'te Sistem Ayarları, iPhone'da Ayarlar › Apple Intelligence ve Siri'den aç; model indirilince cihaz içi not hazır olur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es auf dem Mac in den Systemeinstellungen oder auf dem iPhone unter „Einstellungen“ › „Apple Intelligence & Siri“; Notizen auf dem Gerät sind verfügbar, sobald das Modell geladen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is off. Turn it on in System Settings on the Mac or Settings › Apple Intelligence & Siri on the iPhone; on-device notes are ready once the model downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes del Sistema en el Mac o en Ajustes › Apple Intelligence y Siri en el iPhone; las notas en el dispositivo estarán listas cuando se descargue el modelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on pois päältä. Laita se päälle Macin Järjestelmäasetuksissa tai iPhonen kohdassa Asetukset › Apple Intelligence ja Siri; laitteella tehtävät muistiinpanot ovat valmiina, kun malli on ladattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Activez-le dans Réglages Système sur le Mac ou dans Réglages › Apple Intelligence et Siri sur l’iPhone ; les notes sur l’appareil sont disponibles une fois le modèle téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato. Attivalo in Impostazioni di Sistema sul Mac o in Impostazioni › Apple Intelligence e Siri su iPhone; le note sul dispositivo sono pronte appena il modello è scaricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフです。Macでは「システム設定」、iPhoneでは「設定」›「Apple IntelligenceとSiri」でオンにしてください。モデルのダウンロードが完了すると、オンデバイスのノートを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. Mac에서는 시스템 설정에서, iPhone에서는 설정 › Apple Intelligence 및 Siri에서 켜세요. 모델이 다운로드되면 온디바이스 노트를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence staat uit. Zet het aan in Systeeminstellingen op de Mac of in Instellingen › Apple Intelligence en Siri op de iPhone; notities op het apparaat zijn klaar zodra het model is gedownload."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes do Sistema no Mac ou em Ajustes › Apple Intelligence e Siri no iPhone; as notas no dispositivo ficam prontas assim que o modelo for baixado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能已关闭。请在 Mac 的“系统设置”或 iPhone 的“设置 › Apple 智能与 Siri”中打开；模型下载完成后即可使用设备端笔记。"
          }
        }
      }
    },
    "Apple Intelligence modeli henüz hazır değil (indiriliyor). Cihazı Wi‑Fi'ye ve güce bağlı bırakıp birkaç dakika sonra yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple Intelligence-Modell ist noch nicht bereit (wird geladen). Lass das Gerät mit WLAN und Strom verbunden und versuche es in ein paar Minuten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Intelligence model isn't ready yet (downloading). Keep the device on Wi‑Fi and power, then try again in a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de Apple Intelligence aún no está listo (descargándose). Mantén el dispositivo conectado a la red Wi‑Fi y a la corriente, e inténtalo de nuevo en unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence -malli ei ole vielä valmis (latautuu). Pidä laite Wi‑Fi-verkossa ja laturissa ja yritä muutaman minuutin päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple Intelligence n’est pas encore prêt (téléchargement en cours). Laissez l’appareil connecté au Wi‑Fi et à l’alimentation, puis réessayez dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di Apple Intelligence non è ancora pronto (download in corso). Tieni il dispositivo connesso al Wi‑Fi e all’alimentazione, poi riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceのモデルはまだ準備できていません（ダウンロード中）。デバイスをWi‑Fiと電源に接続したまま、数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 모델이 아직 준비되지 않았습니다(다운로드 중). 기기를 Wi‑Fi와 전원에 연결한 상태로 두고 몇 분 후에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Apple Intelligence-model is nog niet klaar (wordt gedownload). Houd het apparaat verbonden met wifi en de stroom en probeer het over een paar minuten opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo da Apple Intelligence ainda não está pronto (baixando). Mantenha o dispositivo no Wi‑Fi e na tomada e tente de novo em alguns minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能模型尚未就绪（正在下载）。请让设备保持连接 Wi‑Fi 和电源，几分钟后再试。"
          }
        }
      }
    },
    "Apple Intelligence modeli şu an kullanılamıyor (indiriliyor ya da disk dolu). Birkaç dakika sonra yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple Intelligence-Modell ist gerade nicht verfügbar (wird geladen oder der Speicher ist voll). Versuche es in ein paar Minuten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Intelligence model isn't available right now (downloading or the disk is full). Try again in a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de Apple Intelligence no está disponible ahora mismo (se está descargando o el disco está lleno). Inténtalo de nuevo en unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence -malli ei ole juuri nyt käytettävissä (latautuu tai levy on täynnä). Yritä muutaman minuutin päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple Intelligence n’est pas disponible pour le moment (téléchargement en cours ou disque plein). Réessayez dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di Apple Intelligence non è disponibile al momento (download in corso o disco pieno). Riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceのモデルは現在利用できません（ダウンロード中、またはディスクがいっぱいです）。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Apple Intelligence 모델을 사용할 수 없습니다(다운로드 중이거나 디스크가 가득 참). 몇 분 후에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Apple Intelligence-model is nu niet beschikbaar (wordt gedownload of de schijf is vol). Probeer het over een paar minuten opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo da Apple Intelligence não está disponível agora (baixando ou disco cheio). Tente de novo em alguns minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能模型目前不可用（正在下载或磁盘已满）。请几分钟后再试。"
          }
        }
      }
    },
    "Apple Intelligence şu an kullanılamıyor (%@). Cihazı yeniden başlatıp tekrar dene.": {
