    "Takvimini bağla; günün toplantıları burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Kalender, um die heutigen Meetings hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendar to see today's meetings here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu calendario para ver aquí las reuniones de hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä kalenteri, niin tämän päivän kokoukset näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre calendrier pour voir ici les réunions du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il calendario per vedere qui le riunioni di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを接続すると、今日の会議がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더를 연결하면 오늘의 회의가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
