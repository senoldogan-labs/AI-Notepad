    "Ücretsiz deneme: %@. Abone olunca her toplantının notu böyle kendiliğinden hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Test: %@. Mit einem Abo bekommt jedes Meeting automatisch eine Notiz wie diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial: %@. Subscribe and every meeting gets a note like this, automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratuita: %@. Suscríbete y cada reunión tendrá una nota como esta, automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujakso: %@. Tilaa, niin jokainen kokous saa automaattisesti tällaisen muistiinpanon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit : %@. Abonnez-vous et chaque réunion aura automatiquement une note comme celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gratuita: %@. Abbonati e ogni riunione avrà automaticamente una nota come questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアル：%@。登録すると、すべての会議にこのようなノートが自動で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험: %@. 구독하면 모든 회의에 이와 같은 노트가 자동으로 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis proefperiode: %@. Neem een abonnement en elke vergadering krijgt automatisch zo'n notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste grátis: %@. Assine e cada reunião ganha uma nota como esta, automaticamente."
