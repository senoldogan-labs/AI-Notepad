    "Emin misin? Bu işlem geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher? Das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma? Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi continuare? L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よろしいですか？ この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확실합니까? 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je het zeker? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza? Isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定吗？此操作无法撤销。"
          }
        }
      }
    },
    "Emin misin? Hesabın ve sunucudaki tüm kayıtların kalıcı olarak silinir; bu işlem geri alınamaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher? Dein Account und alle zugehörigen Daten auf unserem Server werden endgültig gelöscht; das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? Your account and all its records on our server are deleted permanently; this can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro? Tu cuenta y todos sus registros en nuestro servidor se eliminarán de forma permanente; esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma? Tilisi ja kaikki sen tiedot palvelimellamme poistetaan pysyvästi; tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr ? Votre compte et toutes ses données sur notre serveur seront supprimés définitivement ; cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi continuare? Il tuo account e tutti i suoi dati sul nostro server vengono eliminati definitivamente; l’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よろしいですか？ アカウントと、サーバ上のすべての記録が完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확실합니까? 계정과 서버에 있는 모든 기록이 영구적으로 삭제되며, 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je het zeker? Je account en alle bijbehorende gegevens op onze server worden permanent verwijderd; dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza? Sua conta e todos os registros dela no nosso servidor serão apagados permanentemente; isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定吗？你的账户及其在我们服务器上的所有记录将被永久删除；此操作无法撤销。"
          }
        }
      }
    },
