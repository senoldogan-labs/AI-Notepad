    "Oturumun kapandı (çıkış yapılmış ya da güvenlik nedeniyle tüm oturumlar kapatılmış). Yeniden giriş yap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung wurde beendet (du hast dich abgemeldet oder alle Sitzungen wurden aus Sicherheitsgründen beendet). Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session was closed (you signed out, or all sessions were closed for security). Sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión se ha cerrado (cerraste sesión o se cerraron todas las sesiones por seguridad). Vuelve a iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istuntosi suljettiin (kirjauduit ulos, tai kaikki istunnot suljettiin turvallisuussyistä). Kirjaudu uudelleen sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a été fermée (vous vous êtes déconnecté, ou toutes les sessions ont été fermées par sécurité). Reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione è stata chiusa (sei uscito dall’account o tutte le sessioni sono state chiuse per sicurezza). Accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが終了しました（サインアウトしたか、セキュリティのためすべてのセッションが終了されました）。もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 종료되었습니다(로그아웃했거나 보안을 위해 모든 세션이 종료됨). 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessie is gesloten (je bent uitgelogd, of alle sessies zijn om veiligheidsredenen gesloten). Log opnieuw in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão foi encerrada (você saiu ou todas as sessões foram encerradas por segurança). Inicie sessão de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会话已关闭（你已退出登录，或出于安全原因关闭了所有会话）。请重新登录。"
          }
        }
      }
    },
    "Oturumun sona erdi; Ayarlar › Hesap'tan yeniden giriş yap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen; melde dich unter „Einstellungen“ › „Account“ erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended; sign in again in Settings › Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha finalizado; vuelve a iniciar sesión en Ajustes › Cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istuntosi on päättynyt; kirjaudu uudelleen kohdassa Asetukset › Tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a pris fin ; reconnectez-vous dans Réglages › Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione è terminata; accedi di nuovo in Impostazioni › Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが終了しました。「設定」›「アカウント」でもう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 종료되었습니다. 설정 › 계정에서 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessie is verlopen; log opnieuw in via Instellingen › Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão terminou; inicie sessão de novo em Ajustes › Conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会话已结束；请在“设置 › 账户”中重新登录。"
          }
        }
      }
    },
    "Oturumun süresi doldu; yeniden bağlan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung abgelaufen; verbinde dich erneut"
