    "Bağlantıyla paylaşma şu an kullanılamıyor; biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen per Link ist gerade nicht verfügbar; versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing with a link isn't available right now; try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir con enlace no está disponible ahora; vuelve a intentarlo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkillä jakaminen ei ole juuri nyt käytettävissä; yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage par lien n’est pas disponible pour le moment ; réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione con link non è disponibile ora; riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクでの共有は現在利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 링크로 공유할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen met een link is nu niet beschikbaar; probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar com link não está disponível agora; tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法通过链接共享，请稍后再试。"
          }
        }
      }
    },
    "Bir hesapta en çok %lld etkin bağlantı olabilir; eski bağlantıları kaldırıp yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Account kann höchstens %lld aktive Links haben; entferne alte Links und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account can have at most %lld active links; remove old links and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta puede tener como máximo %lld enlaces activos; elimina enlaces antiguos y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilillä voi olla enintään %lld voimassa olevaa linkkiä; poista vanhoja linkkejä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte peut avoir au maximum %lld liens actifs ; supprime d’anciens liens et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account può avere al massimo %lld link attivi; rimuovi i link vecchi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのアカウントで有効なリンクは最大%lld件です。古いリンクを削除してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 계정에는 활성 링크를 최대 %lld개까지 둘 수 있습니다. 오래된 링크를 삭제한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een account kan maximaal %lld actieve links hebben; verwijder oude links en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta pode ter no máximo %lld links ativos; remova links antigos e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个账户最多可有 %lld 个有效链接；请删除旧链接后再试。"
          }
        }
      }
    },
    "Bağlantı oluşturulamadı; yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link konnte nicht erstellt werden; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the link; try again."
          }
        },
        "es": {
          "stringUnit": {
