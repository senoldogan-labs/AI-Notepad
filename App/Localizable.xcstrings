    "Toplantılarını dinler, notunu yazar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört deinen Meetings zu, schreibt deine Notizen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens to your meetings, writes your notes"
