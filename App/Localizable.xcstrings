    "Toplantı işlenirken görev eklenemez; işleme bitince yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während das Meeting verarbeitet wird, kannst du keine Aufgabe hinzufügen. Versuch es danach erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't add a task while the meeting is processing; try again when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes añadir una tarea mientras se procesa la reunión; vuelve a intentarlo cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtävää ei voi lisätä, kun kokousta käsitellään. Yritä uudelleen, kun käsittely on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter une tâche pendant le traitement de la réunion ; réessayez une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi aggiungere un’attività mentre la riunione è in elaborazione; riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の処理中はタスクを追加できません。処理が終わってから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 처리하는 동안에는 할 일을 추가할 수 없습니다. 처리가 끝나면 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt geen taak toevoegen terwijl de vergadering wordt verwerkt; probeer het opnieuw als dat klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível adicionar uma tarefa enquanto a reunião é processada; tente de novo quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议处理期间无法添加任务；处理完成后再试。"
          }
        }
      }
    },
