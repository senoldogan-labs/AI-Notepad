            "value": "Sesión iniciada, estado desconocido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautunut, tila tuntematon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, état inconnu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso eseguito, stato sconosciuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン済み、状況不明"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인됨, 상태 알 수 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingelogd, status onbekend"
          }
        },
        "pt-BR": {
