    "Mail açılamadı: Mac'te ayarlı bir e-posta hesabı yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail konnte nicht geöffnet werden: Auf diesem Mac ist kein E-Mail-Account eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Mail: no email account is set up on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir Mail: no hay ninguna cuenta de correo configurada en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailia ei voitu avata: tähän Maciin ei ole määritetty sähköpostitiliä."
          }
        },
        "fr": {
