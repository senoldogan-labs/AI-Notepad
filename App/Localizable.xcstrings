    "Yeni sürüm arka planda iner, uygulamadan çıkınca kurulur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Versionen werden im Hintergrund geladen und beim Beenden installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New versions download in the background and install when you quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones nuevas se descargan en segundo plano y se instalan al salir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet versiot latautuvat taustalla ja asentuvat, kun suljet sovelluksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles versions se téléchargent en arrière-plan et s'installent quand tu quittes l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove versioni si scaricano in background e si installano quando esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンはバックグラウンドでダウンロードされ、終了時にインストールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전은 백그라운드에서 다운로드되고 앱을 종료할 때 설치됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe versies worden op de achtergrond gedownload en bij afsluiten geïnstalleerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas versões são baixadas em segundo plano e instaladas quando você sai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本会在后台下载，并在退出时安装。"
          }
        }
      }
    },
    "Raporlar bu Mac'te kalır; yalnızca \"Gönder\"e basınca gider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichte bleiben auf diesem Mac; sie werden nur gesendet, wenn du auf „Senden“ klickst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports stay on this Mac; they're sent only when you press \"Send\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes se quedan en este Mac; solo se envían al pulsar «Enviar»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportit pysyvät tässä Macissa; ne lähetetään vain, kun painat ”Lähetä”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports restent sur ce Mac ; ils ne sont envoyés que si tu cliques sur « Envoyer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rapporti restano su questo Mac; vengono inviati solo quando premi «Invia»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートはこのMacに残り、「送信」を押したときだけ送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서는 이 Mac에 남아 있으며 '보내기'를 누를 때만 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten blijven op deze Mac; ze worden alleen verstuurd als je op ‘Verstuur’ klikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relatórios ficam neste Mac; só são enviados quando você clica em \"Enviar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告保留在这台 Mac 上；只有点按“发送”时才会发送。"
          }
        }
      }
    },
    "Bildirim izni yok": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen nicht erlaubt"
          }
        },
        "en": {
