    "Duraklatıldı; bu sırada ses kaydedilmez ve yazıya dökülmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert; Audio wird in dieser Zeit weder aufgenommen noch transkribiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused; audio isn't recorded or transcribed meanwhile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa; mientras tanto, el audio no se graba ni se transcribe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty; ääntä ei sillä välin nauhoiteta eikä litteroida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause ; l’audio n’est ni enregistré ni transcrit pendant ce temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa; nel frattempo l’audio non viene registrato né trascritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中です。その間、音声は録音も文字起こしもされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지됨. 그동안 오디오는 녹음되거나 텍스트로 변환되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd; audio wordt intussen niet opgenomen of uitgeschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado; o áudio não é gravado nem transcrito enquanto isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停；在此期间不会录制或转写音频。"
          }
        }
      }
    },
