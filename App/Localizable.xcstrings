    "Toplantılarını yazıya dökmesine izin ver": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Transkription erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow meeting transcription"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir la transcripción de reuniones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kokousten litterointi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser la transcription des réunions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la trascrizione delle riunioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の文字起こしを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 텍스트 변환 허용"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta transcriptie van vergaderingen toe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir a transcrição de reuniões"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许转写会议"
          }
        }
      }
    },
    "Bir toplantıyı birlikte dinleyelim": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns gemeinsam einem Meeting zuhören"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's listen to a meeting together"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchemos juntos una reunión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuunnellaan kokousta yhdessä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutons une réunion ensemble"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascoltiamo insieme una riunione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に会議を聞いてみましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 회의를 들어 봅시다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten we samen naar een vergadering luisteren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos ouvir uma reunião juntos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起听一场会议吧"
          }
        }
      }
    },
    "Toplantılarını canlı yazıya döker; bitince notun hazır, en üstte senin görevlerin. Kurulum iki dakika sürer, her adım atlanabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkribiert deine Meetings live; danach ist deine Notiz fertig, mit deinen Aufgaben ganz oben. Die Einrichtung dauert zwei Minuten, und du kannst jeden Schritt überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribes your meetings live; when they end, your note is ready with your tasks on top. Setup takes two minutes, and you can skip any step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe tus reuniones en directo; al terminar, tu nota está lista con tus tareas arriba. La configuración lleva dos minutos y puedes omitir cualquier paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Litteroi kokouksesi reaaliajassa; kun ne päättyvät, muistiinpanosi on valmis ja tehtäväsi ovat ylimpänä. Käyttöönotto vie kaksi minuuttia, ja voit ohittaa minkä tahansa vaiheen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit vos réunions en direct ; à la fin, votre note est prête, avec vos tâches en haut. La configuration prend deux minutes, et vous pouvez passer chaque étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrive le tue riunioni dal vivo; alla fine la tua nota è pronta, con le tue attività in cima. La configurazione richiede due minuti e puoi saltare qualsiasi passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議をライブで文字起こしします。終了するとノートが完成し、あなたのタスクがいちばん上に表示されます。セットアップは2分で終わり、どのステップもスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 실시간으로 텍스트로 변환합니다. 회의가 끝나면 노트가 준비되고, 내 할 일이 맨 위에 표시됩니다. 설정은 2분이면 끝나며, 어떤 단계든 건너뛸 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft je vergaderingen live uit; als ze afgelopen zijn, is je notitie klaar met je taken bovenaan. De configuratie duurt twee minuten en je kunt elke stap overslaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreve suas reuniões ao vivo; quando terminam, sua nota está pronta, com suas tarefas no topo. A configuração leva dois minutos, e você pode pular qualquer etapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转写你的会议；会议结束时笔记就已就绪，你的任务排在最上面。初始设置只需两分钟，每一步都可以跳过。"
          }
        }
      }
    },
    "Canlı metni ve notu nerede yazdıracağını seç; sonra Ayarlar'dan değişir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo das Live-Transkript und die Notizen geschrieben werden; du kannst das später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where the live transcript and notes are written; you can change it later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde se escriben la transcripción en directo y las notas; puedes cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, missä reaaliaikainen litterointi ja muistiinpanot kirjoitetaan; voit muuttaa tätä myöhemmin kohdassa Asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où la transcription en direct et les notes sont rédigées ; vous pourrez changer cela plus tard dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove vengono scritte la trascrizione dal vivo e le note; puoi cambiarlo in seguito in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしとノートをどこで作成するかを選択します。あとで「設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 녹취록과 노트를 어디서 작성할지 선택하세요. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar het live transcript en de notities worden geschreven; je kunt dit later wijzigen in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde a transcrição ao vivo e as notas são escritas; você pode mudar isso depois nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在哪里生成实时文字稿和笔记；之后可在“设置”中更改。"
          }
        }
      }
    },
    "Senin sesin, toplantıdaki diğer kişilerin sesi ve not hazır olunca haber. İzinleri sonra Sistem Ayarları'ndan değiştirebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme, alle anderen im Meeting und ein Hinweis, wenn deine Notiz fertig ist. Du kannst das später in den Systemeinstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice, everyone else in the meeting, and a heads-up when your note is ready. You can change these later in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz, la del resto de la reunión y un aviso cuando tu nota esté lista. Puedes cambiar estos permisos después en Ajustes del Sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma äänesi, muiden kokoukseen osallistujien äänet ja ilmoitus, kun muistiinpanosi on valmis. Voit muuttaa näitä myöhemmin Järjestelmäasetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix, celle des autres participants et une alerte quand votre note est prête. Vous pourrez modifier ces autorisations plus tard dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce, quella degli altri partecipanti e un avviso quando la tua nota è pronta. Puoi modificare queste autorizzazioni in seguito in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声、会議のほかの参加者の声、ノートが完成したときの通知。これらはあとで「システム設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목소리, 회의의 다른 참가자 목소리, 노트가 준비되면 알림. 나중에 시스템 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem, iedereen anders in de vergadering en een seintje als je notitie klaar is. Je kunt dit later wijzigen in Systeeminstellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz, a dos demais participantes da reunião e um aviso quando sua nota estiver pronta. Você pode mudar essas permissões depois nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的声音、会议中其他人的声音，以及笔记就绪时的通知。之后可在“系统设置”中更改这些权限。"
          }
        }
      }
    },
    "Bir dakikalık örnek toplantı: canlı metin akarken bir not yaz, bitince notun hazır. İnternet gerekmez, kullanımına sayılmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einminütiges Beispiel-Meeting: Schreib eine Notiz, während das Live-Transkript läuft, und am Ende ist deine Notiz fertig. Kein Internet nötig, und es zählt nicht zu deiner Nutzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-minute sample meeting: jot down a note while the live transcript flows, and your note is ready when it ends. No internet needed, and it doesn't count toward your usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una reunión de ejemplo de un minuto: escribe una nota mientras avanza la transcripción en directo y, al terminar, tu nota estará lista. No necesitas internet y no cuenta para tu uso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuutin mittainen esimerkkikokous: kirjoita muistiinpano, kun reaaliaikainen litterointi etenee, ja muistiinpanosi on valmis lopussa. Internetiä ei tarvita, eikä se kuluta käyttöäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réunion d’exemple d’une minute : prenez une note pendant que la transcription en direct défile, et votre note est prête à la fin. Pas besoin d’Internet, et elle n’est pas décomptée de votre utilisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riunione di esempio di un minuto: scrivi una nota mentre scorre la trascrizione dal vivo e alla fine la tua nota è pronta. Non serve Internet e non conta nel tuo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分間のサンプル会議：ライブ文字起こしが流れる間にメモを書くと、終了時にノートが完成します。インターネットは不要で、使用量にもカウントされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분짜리 샘플 회의: 실시간 녹취록이 흐르는 동안 메모를 작성하면, 끝날 때 노트가 준비됩니다. 인터넷이 필요 없으며 사용량에 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een voorbeeldvergadering van één minuut: schrijf een notitie terwijl het live transcript meeloopt, en aan het eind is je notitie klaar. Geen internet nodig, en het telt niet mee voor je gebruik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma reunião de exemplo de um minuto: escreva uma anotação enquanto a transcrição ao vivo avança, e sua nota fica pronta no final. Não precisa de internet e não conta no seu uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一分钟的示例会议：在实时文字稿滚动时写下笔记，结束时你的笔记就已就绪。无需联网，也不计入你的用量。"
          }
        }
      }
    },
    "Kurulumu atla": {
      "localizations": {
        "de": {
