    "Toplantının metni not, canlı çeviri ve Sor cevapları için sunucumuz üzerinden bir yapay zekâ dil modeline gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Text wird über unseren Server an ein KI-Sprachmodell gesendet, um Notizen, Live-Übersetzungen und Antworten in „Fragen“ zu schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting text is sent through our server to an AI language model to write notes, live translations and Ask answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de las reuniones se envía a través de nuestro servidor a un modelo de lenguaje de IA para escribir notas, traducciones en directo y respuestas de Preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen teksti lähetetään palvelimemme kautta tekoälykielimallille muistiinpanojen, reaaliaikaisten käännösten ja Kysy-vastausten kirjoittamista varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte des réunions est envoyé via notre serveur à un modèle de langage d’IA pour rédiger les notes, les traductions en direct et les réponses de Demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo della riunione viene inviato tramite il nostro server a un modello linguistico AI per scrivere note, traduzioni dal vivo e risposte di Chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、ライブ翻訳、「質問」の回答を作成するため、会議のテキストは当社サーバを経由してAI言語モデルに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트, 실시간 번역 및 질문하기 답변을 작성하기 위해 회의 텍스트가 서버를 거쳐 AI 언어 모델로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergadertekst wordt via onze server naar een AI-taalmodel gestuurd om notities, live vertalingen en antwoorden in Vraag te schrijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto da reunião é enviado pelo nosso servidor a um modelo de linguagem de IA para escrever notas, traduções ao vivo e respostas de Perguntar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议文字会通过我们的服务器发送给 AI 语言模型，用于撰写笔记、实时翻译和“提问”的回答。"
          }
        }
      }
    },
    "Toplantının sesi canlı metin, konuşmacıları ayırma ve yazıya dökme için bir konuşma tanıma hizmetine gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Audio wird an einen Spracherkennungsdienst gesendet – für das Live-Transkript, die Unterscheidung der Sprecher und das endgültige Transkript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting audio is sent to a speech recognition service for the live transcript, telling speakers apart and the final transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de las reuniones se envía a un servicio de reconocimiento de voz para la transcripción en directo, la distinción de interlocutores y la transcripción final."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen ääni lähetetään puheentunnistuspalveluun reaaliaikaista litterointia, puhujien erottelua ja lopullista litterointia varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio des réunions est envoyé à un service de reconnaissance vocale pour la transcription en direct, la distinction des intervenants et la transcription finale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio della riunione viene inviato a un servizio di riconoscimento vocale per la trascrizione dal vivo, la distinzione degli interlocutori e la trascrizione finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こし、話者の識別、最終的な文字起こしのため、会議の音声は音声認識サービスに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 녹취록, 화자 구분 및 최종 녹취록을 위해 회의 오디오가 음성 인식 서비스로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergaderaudio wordt naar een spraakherkenningsdienst gestuurd voor het live transcript, het onderscheiden van sprekers en het definitieve transcript."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio da reunião é enviado a um serviço de reconhecimento de fala para a transcrição ao vivo, a distinção entre falantes e a transcrição final."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议音频会发送给语音识别服务，用于实时文字稿、区分说话人和最终文字稿。"
          }
        }
      }
    },
    "Transkriptte bir konuşmacıya ad verince kişi burada görünür; toplantıları, konuşma payı ve görevleriyle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne einen Sprecher in einem Transkript, dann erscheint er hier mit seinen Meetings, seiner Redezeit und seinen Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a speaker in a transcript and they appear here, with their meetings, talk time and tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon nombre a un interlocutor en una transcripción y aparecerá aquí, con sus reuniones, su tiempo de habla y sus tareas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeä puhuja litteroinnissa, niin hän näkyy tässä kokouksineen, puheaikoineen ja tehtävineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez un intervenant dans une transcription et il apparaîtra ici, avec ses réunions, son temps de parole et ses tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un nome a un interlocutore in una trascrizione e apparirà qui, con le sue riunioni, il tempo di parola e le attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしで話者に名前を付けると、その人の会議、発言時間、タスクとともにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹취록에서 화자의 이름을 지정하면 해당 화자의 회의, 발언 시간 및 할 일과 함께 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een spreker een naam in een transcript en die verschijnt hier, met diens vergaderingen, spreektijd en taken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê nome a um falante em uma transcrição e ele aparece aqui, com suas reuniões, tempo de fala e tarefas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文字稿中为说话人命名后，他们会显示在这里，并附带其会议、发言时长和任务。"
          }
        }
      }
    },
    "ya da ses/video dosyasını buraya sürükle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "oder ziehe eine Audio- oder Videodatei hierher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "or drag an audio or video file here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "o arrastra aquí un archivo de audio o vídeo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "tai vedä ääni- tai videotiedosto tähän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ou faites glisser un fichier audio ou vidéo ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "o trascina qui un file audio o video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "またはオーディオ／ビデオファイルをここにドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 오디오나 비디오 파일을 여기로 드래그하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "of sleep hier een audio- of videobestand naartoe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ou arraste um arquivo de áudio ou vídeo para cá"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或将音频或视频文件拖到这里"
          }
        }
      }
    },
    "Yazıya dökme ve not için toplantının sesi ve metni hizmetimize ve güvenilir üçüncü taraf yapay zekâ hizmetlerine gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Meetings zu transkribieren und Notizen zu schreiben, werden Meeting-Audio und -Text an unseren Dienst und an vertrauenswürdige KI-Dienste von Drittanbietern gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To transcribe your meetings and write notes, the meeting audio and text are sent to our service and to trusted third-party AI services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para transcribir tus reuniones y escribir notas, el audio y el texto de las reuniones se envían a nuestro servicio y a servicios de IA de terceros de confianza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokousten litterointia ja muistiinpanojen kirjoittamista varten kokouksen ääni ja teksti lähetetään palveluumme ja luotettaville kolmannen osapuolen tekoälypalveluille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour transcrire vos réunions et rédiger les notes, l’audio et le texte des réunions sont envoyés à notre service et à des services d’IA tiers de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trascrivere le tue riunioni e scrivere le note, l’audio e il testo delle riunioni vengono inviati al nostro servizio e a servizi AI di terze parti affidabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の文字起こしとノート作成のため、会議の音声とテキストは当社のサービスおよび信頼できる第三者のAIサービスに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 텍스트로 변환하고 노트를 작성하기 위해 회의 오디오와 텍스트가 당사 서비스 및 신뢰할 수 있는 타사 AI 서비스로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je vergaderingen uit te schrijven en notities te maken, worden de audio en tekst van de vergadering naar onze dienst en naar vertrouwde AI-diensten van derden gestuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para transcrever suas reuniões e escrever notas, o áudio e o texto das reuniões são enviados ao nosso serviço e a serviços de IA de terceiros confiáveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了转写你的会议并撰写笔记，会议音频和文字会发送到我们的服务以及受信任的第三方 AI 服务。"
          }
        }
      }
    },
    "İzin verilmedi: metin yalnızca panoya kopyalanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erlaubt: Der Text wird nur in die Zwischenablage kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed: the text is only copied to the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitido: el texto solo se copia al portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei sallittu: teksti kopioidaan vain leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non autorisé : le texte est seulement copié dans le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consentito: il testo viene solo copiato negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていません：テキストはクリップボードにコピーされるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되지 않음: 텍스트가 클립보드에만 복사됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet toegestaan: de tekst wordt alleen naar het klembord gekopieerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não permitido: o texto é apenas copiado para a área de transferência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许：文本仅拷贝到剪贴板。"
          }
        }
      }
    },
