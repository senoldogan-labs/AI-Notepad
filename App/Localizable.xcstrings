        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではトライアル使用済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 체험 사용함"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proefperiode op deze Mac gebruikt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste já usado neste Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已使用过试用"
          }
        }
      }
    },
    "Bu Mac'te yüklü değil": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac nicht installiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed on this Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No instalado en este Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei asennettu tähän Maciin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non installé sur ce Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non installato su questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにはインストールされていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 설치되지 않음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet geïnstalleerd op deze Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não instalado neste Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装在这台 Mac 上"
          }
        }
      }
    },
    "Bu Mac'te çıkış yapıldı. Sunucuya ulaşılamadı; sunucudaki oturum en geç 60 gün içinde kendiliğinden kapanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac abgemeldet. Der Server war nicht erreichbar; deine Sitzung auf dem Server endet von selbst innerhalb von 60 Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this Mac. The server couldn't be reached; your session on the server closes on its own within 60 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada en este Mac. No se ha podido acceder al servidor; tu sesión en el servidor se cerrará sola en un plazo de 60 días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduttu ulos tässä Macissa. Palvelimeen ei saatu yhteyttä; istuntosi palvelimella sulkeutuu itsestään 60 päivän kuluessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté sur ce Mac. Le serveur était injoignable ; votre session sur le serveur se fermera d’elle-même d’ici 60 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnesso su questo Mac. Il server non è raggiungibile; la tua sessione sul server si chiuderà da sola entro 60 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでサインアウトしました。サーバに接続できませんでしたが、サーバ上のセッションは60日以内に自動的に終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 로그아웃했습니다. 서버에 연결할 수 없었습니다. 서버의 세션은 60일 이내에 자동으로 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgelogd op deze Mac. De server was niet bereikbaar; je sessie op de server sluit vanzelf binnen 60 dagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão encerrada neste Mac. Não foi possível acessar o servidor; sua sessão no servidor se encerra sozinha em até 60 dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在这台 Mac 上退出登录。无法连接服务器；你在服务器上的会话会在 60 天内自动关闭。"
          }
        }
      }
    },
    "Bu Mac'te ücretsiz deneme başka bir hesapla kullanıldı. Kayda devam etmek için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Test auf diesem Mac wurde bereits mit einem anderen Account genutzt. Schließe ein Abo ab, um weiter aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial on this Mac was already used with another account. Subscribe to keep recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita de este Mac ya se usó con otra cuenta. Suscríbete para seguir grabando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän Macin ilmainen kokeilujakso on jo käytetty toisella tilillä. Tilaa, niin voit jatkaa nauhoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit de ce Mac a déjà été utilisé avec un autre compte. Abonnez-vous pour continuer à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita su questo Mac è già stata usata con un altro account. Abbonati per continuare a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの無料トライアルは別のアカウントですでに使用されています。録音を続けるには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 무료 체험은 이미 다른 계정에서 사용되었습니다. 계속 녹음하려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis proefperiode op deze Mac is al met een ander account gebruikt. Neem een abonnement om te blijven opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis neste Mac já foi usado com outra conta. Assine para continuar gravando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的免费试用已被另一个账户使用。订阅即可继续录制。"
          }
        }
      }
    },
    "Bu Mac'te ücretsiz deneme başka bir hesapla kullanıldı. Kaydetmeye ve not almaya devam etmek için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat bereits mit einem anderen Account einen kostenlosen Test genutzt. Schließe ein Abo ab, um weiter aufzunehmen und Notizen zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has already used a free trial with another account. Subscribe to keep recording and getting notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ya ha usado una prueba gratuita con otra cuenta. Suscríbete para seguir grabando y recibiendo notas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac on jo käyttänyt ilmaisen kokeilujakson toisella tilillä. Tilaa, niin voit jatkaa nauhoittamista ja saada muistiinpanoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a déjà utilisé un essai gratuit avec un autre compte. Abonnez-vous pour continuer à enregistrer et à recevoir des notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac ha già usato una prova gratuita con un altro account. Abbonati per continuare a registrare e ricevere note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは別のアカウントですでに無料トライアルが使用されています。録音とノート作成を続けるには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 이미 다른 계정으로 무료 체험을 사용했습니다. 계속 녹음하고 노트를 받으려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac heeft al een gratis proefperiode met een ander account gebruikt. Neem een abonnement om te blijven opnemen en notities te krijgen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac já usou um teste grátis com outra conta. Assine para continuar gravando e recebendo notas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已通过另一个账户使用过免费试用。订阅即可继续录制并获取笔记。"
          }
        }
      }
    },
    "Bu Mac'te ücretsiz deneme başka bir hesapla kullanıldı; devam etmek için abone ol. Toplantıların ve notların bu Mac'te kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Test auf diesem Mac wurde bereits mit einem anderen Account genutzt; schließe ein Abo ab, um fortzufahren. Deine Meetings und Notizen bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial on this Mac was already used with another account; subscribe to continue. Your meetings and notes stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita de este Mac ya se usó con otra cuenta; suscríbete para continuar. Tus reuniones y notas se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän Macin ilmainen kokeilujakso on jo käytetty toisella tilillä; jatka tilaamalla. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit de ce Mac a déjà été utilisé avec un autre compte ; abonnez-vous pour continuer. Vos réunions et notes restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita su questo Mac è già stata usata con un altro account; abbonati per continuare. Le riunioni e le note restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの無料トライアルは別のアカウントですでに使用されています。続けるには登録してください。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 무료 체험은 이미 다른 계정에서 사용되었습니다. 계속하려면 구독하세요. 회의와 노트는 이 Mac에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis proefperiode op deze Mac is al met een ander account gebruikt; neem een abonnement om door te gaan. Je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis neste Mac já foi usado com outra conta; assine para continuar. Suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的免费试用已被另一个账户使用；订阅即可继续。你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
    "Bu Mac'te ücretsiz deneme daha önce başka bir hesapla kullanıldı. Devam etmek için Ayarlar › Hesap'tan abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat bereits mit einem anderen Account einen kostenlosen Test genutzt. Schließe zum Fortfahren unter „Einstellungen“ › „Account“ ein Abo ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has already used a free trial with another account. To continue, subscribe in Settings › Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ya ha usado una prueba gratuita con otra cuenta. Para continuar, suscríbete en Ajustes › Cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac on jo käyttänyt ilmaisen kokeilujakson toisella tilillä. Jatka tilaamalla kohdassa Asetukset › Tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a déjà utilisé un essai gratuit avec un autre compte. Pour continuer, abonnez-vous dans Réglages › Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac ha già usato una prova gratuita con un altro account. Per continuare, abbonati in Impostazioni › Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは別のアカウントですでに無料トライアルが使用されています。続けるには「設定」›「アカウント」で登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 이미 다른 계정으로 무료 체험을 사용했습니다. 계속하려면 설정 › 계정에서 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac heeft al een gratis proefperiode met een ander account gebruikt. Neem een abonnement in Instellingen › Account om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac já usou um teste grátis com outra conta. Para continuar, assine em Ajustes › Conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已通过另一个账户使用过免费试用。要继续，请在“设置 › 账户”中订阅。"
          }
        }
      }
    },
    "Bu Mac'teki cihaz içi dikte ana toplantı dilini (%@) desteklemiyor. Ayarlar › Genel'den başka bir ana toplantı dili seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diktierfunktion auf diesem Mac unterstützt deine Hauptsprache für Meetings (%@) nicht. Wähle unter „Einstellungen“ › „Allgemein“ eine andere Hauptsprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device dictation on this Mac doesn't support your primary meeting language (%@). Choose another primary meeting language in Settings › General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en el dispositivo de este Mac no admite tu idioma principal de las reuniones (%@). Elige otro idioma principal en Ajustes › General."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän Macin laitteella toimiva sanelu ei tue kokousten pääkieltäsi (%@). Valitse toinen kokousten pääkieli kohdassa Asetukset › Yleiset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée sur l’appareil de ce Mac ne prend pas en charge la langue principale de vos réunions (%@). Choisissez une autre langue principale dans Réglages › Général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura sul dispositivo di questo Mac non supporta la lingua principale delle riunioni (%@). Scegli un’altra lingua principale in Impostazioni › Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのオンデバイス音声入力は、会議のメイン言語（%@）に対応していません。「設定」›「一般」で別のメイン言語を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 온디바이스 받아쓰기는 주 회의 언어(%@)를 지원하지 않습니다. 설정 › 일반에서 다른 주 회의 언어를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren op het apparaat ondersteunt op deze Mac je hoofdtaal voor vergaderingen (%@) niet. Kies een andere hoofdtaal in Instellingen › Algemeen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado no dispositivo deste Mac não é compatível com o idioma principal das suas reuniões (%@). Escolha outro idioma principal em Ajustes › Geral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的设备端听写不支持你的主要会议语言（%@）。请在“设置 › 通用”中选择其他主要会议语言。"
          }
        }
      }
    },
    "Bu Mac'teki oturumu kapatır; toplantıların ve notların bu Mac'te kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich auf diesem Mac ab; deine Meetings und Notizen bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out on this Mac; your meetings and notes stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión en este Mac; tus reuniones y notas se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa ulos tässä Macissa; kokouksesi ja muistiinpanosi säilyvät tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte sur ce Mac ; vos réunions et notes restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce dall’account su questo Mac; le riunioni e le note restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでサインアウトします。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 로그아웃합니다. 회의와 노트는 이 Mac에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt uit op deze Mac; je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a sessão neste Mac; suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上退出登录；你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
    "Bu adres yalnızca %@ girişinin dönüşü içindir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse dient nur zur Rückkehr nach der Anmeldung bei %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address is only for returning from %@ sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección solo sirve para volver del inicio de sesión de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
