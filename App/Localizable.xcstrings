    "Tarayıcıdaki giriş süresinde tamamlanmadı; Ayarlar › Bağlantılar'dan yeniden bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung im Browser wurde nicht rechtzeitig abgeschlossen; verbinde dich erneut unter „Einstellungen“ › „Verbindungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in in the browser wasn't completed in time; connect again from Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en el navegador no se completó a tiempo; vuelve a conectarte desde Ajustes › Conexiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumista selaimessa ei suoritettu ajoissa; yhdistä uudelleen kohdassa Asetukset › Yhteydet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion dans le navigateur n’a pas abouti à temps ; reconnectez-vous depuis Réglages › Connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso nel browser non è stato completato in tempo; connettiti di nuovo da Impostazioni › Connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでのサインインが時間内に完了しませんでした。「設定」›「連携」からもう一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인이 제시간에 완료되지 않았습니다. 설정 › 연결에서 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen in de browser is niet op tijd voltooid; koppel opnieuw via Instellingen › Koppelingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão no navegador não foi concluído a tempo; conecte de novo em Ajustes › Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未及时在浏览器中完成登录；请从“设置 › 连接”重新连接。"
          }
        }
      }
    },
