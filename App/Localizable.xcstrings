          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme important (mis en évidence dans la note)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna come importante (evidenziato nella nota)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要としてマーク（ノートで強調表示されます）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요로 표시(노트에서 강조됨)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer als belangrijk (gemarkeerd in de notitie)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar como importante (destacado na nota)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记为重要（在笔记中高亮显示）"
          }
        }
      }
    },
    "Öneri yok: transkriptte ad ya da birleştirme için yeterli ipucu bulunamadı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Vorschläge: Das Transkript enthält keine klaren Hinweise auf Namen oder Zusammenführungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions: the transcript has no clear clues for names or merges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay sugerencias: la transcripción no tiene pistas claras para nombres o combinaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ehdotuksia: litteroinnissa ei ole selviä vihjeitä nimistä tai yhdistämisistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune suggestion : la transcription ne contient pas d’indices clairs pour des noms ou des fusions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suggerimento: la trascrizione non contiene indizi chiari per nomi o unioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補はありません：文字起こしに名前や統合の明確な手がかりがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안 없음: 녹취록에 이름이나 병합에 대한 명확한 단서가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen suggesties: het transcript bevat geen duidelijke aanwijzingen voor namen of samenvoegingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sugestão: a transcrição não tem pistas claras para nomes ou mesclagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有建议：文字稿中没有关于名字或合并的明确线索。"
          }
        }
      }
    },
