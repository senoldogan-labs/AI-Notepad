    "Sunucu": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
