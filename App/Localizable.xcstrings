    "Toplantı notunda senin adına yazılan işler burada toplanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, die dir in Meeting-Notizen zugewiesen werden, sammeln sich hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks assigned to you in meeting notes collect here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas que se te asignan en las notas de reunión se reúnen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokousmuistiinpanoissa sinulle annetut tehtävät kerääntyvät tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches qui vous sont attribuées dans les notes de réunion sont regroupées ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività assegnate a te nelle note delle riunioni si raccolgono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議ノートであなたに割り当てられたタスクがここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 노트에서 나에게 할당된 할 일이 여기에 모입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die in vergadernotities aan jou zijn toegewezen, worden hier verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas atribuídas a você nas notas de reunião se reúnem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议笔记中分配给你的任务会汇集在这里。"
          }
        }
      }
    },
    "Toplantı sayfasındaki \"Klasöre taşı\" ile buraya ekle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Meetings über „In Ordner bewegen“ auf der Seite eines Meetings hinzu."
          }
