    "Bu iPhone'da ücretsiz deneme başka bir hesapla kullanıldı; devam etmek için abone ol. Toplantıların ve notların bu iPhone'da kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Test auf diesem iPhone wurde mit einem anderen Account genutzt; schließe ein Abo ab, um fortzufahren. Deine Meetings und Notizen bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial on this iPhone was used with another account; subscribe to continue. Your meetings and notes stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita de este iPhone se usó con otra cuenta; suscríbete para continuar. Tus reuniones y notas se quedan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPhonen ilmainen kokeilujakso käytettiin toisella tilillä; jatka tilaamalla. Kokouksesi ja muistiinpanosi säilyvät tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit de cet iPhone a été utilisé avec un autre compte ; abonnez-vous pour continuer. Vos réunions et notes restent sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita su questo iPhone è stata usata con un altro account; abbonati per continuare. Le riunioni e le note restano su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの無料トライアルは別のアカウントで使用されています。続けるには登録してください。会議とノートはこのiPhoneに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 무료 체험은 다른 계정에서 이미 사용되었습니다. 계속하려면 구독하세요. 회의와 노트는 이 iPhone에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis proefperiode op deze iPhone is met een ander account gebruikt; neem een abonnement om door te gaan. Je vergaderingen en notities blijven op deze iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis neste iPhone foi usado com outra conta; assine para continuar. Suas reuniões e notas continuam neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 上的免费试用已被另一个账户使用；订阅即可继续。你的会议和笔记保留在这部 iPhone 上。"
          }
        }
      }
    },
