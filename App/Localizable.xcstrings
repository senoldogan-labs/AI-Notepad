    "Kayıt %lld sn sonra bitecek. Sürmesini istiyorsan \"Kayda devam et\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme endet in %lld s. Wähle „Weiter aufnehmen“, um sie fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording finishes in %lld s. To keep it going, choose \"Keep recording\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación terminará en %lld s. Para continuar, elige “Seguir grabando”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus päättyy %lld s kuluttua. Jatka valitsemalla ”Jatka nauhoitusta”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement se termine dans %lld s. Pour continuer, choisissez « Continuer l’enregistrement »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione termina tra %lld s. Per continuare, scegli “Continua a registrare”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒後に録音が終了します。続けるには「録音を続ける」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초 후에 녹음이 종료됩니다. 계속하려면 \"계속 녹음\"을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname wordt over %lld s afgerond. Kies \"Blijf opnemen\" om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação termina em %lld s. Para continuar, escolha \"Continuar gravando\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制将在 %lld 秒后结束。要继续录制，请选择“继续录制”。"
          }
        }
      }
    },
    "Görüşme bitti gibi görünüyor; kayıt %lld sn sonra bitecek": {
