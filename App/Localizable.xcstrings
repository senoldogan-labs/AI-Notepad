    "Ödeme alınamadı; erişimin %@ tarihine kadar sürer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung fehlgeschlagen; dein Zugang bleibt bis %@ bestehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment failed; your access continues until %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago no se ha podido realizar; mantienes el acceso hasta el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksu epäonnistui; käyttöoikeutesi jatkuu %@ asti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement a échoué ; votre accès continue jusqu’au %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento non riuscito; il tuo accesso continua fino al %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いに失敗しました。%@まではアクセスを継続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제에 실패했습니다. %@까지 계속 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling mislukt; je toegang loopt door tot %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento falhou; seu acesso continua até %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款失败；你的访问权限将持续到 %@。"
          }
        }
      }
    },
    "Ödeme alınamadı; erişimin %@ tarihine kadar sürer. \"Hesabı yönet\"ten kartını güncelle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung fehlgeschlagen; dein Zugang bleibt bis %@ bestehen. Aktualisiere deine Karte unter „Account verwalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment failed; your access continues until %@. Update your card under \"Manage account\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago no se ha podido realizar; mantienes el acceso hasta el %@. Actualiza tu tarjeta en “Gestionar cuenta”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksu epäonnistui; käyttöoikeutesi jatkuu %@ asti. Päivitä korttisi kohdassa ”Hallitse tiliä”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement a échoué ; votre accès continue jusqu’au %@. Mettez à jour votre carte dans « Gérer le compte »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento non riuscito; il tuo accesso continua fino al %@. Aggiorna la carta in “Gestisci account”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いに失敗しました。%@まではアクセスを継続できます。「アカウントを管理」でカード情報を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제에 실패했습니다. %@까지 계속 이용할 수 있습니다. \"계정 관리\"에서 카드 정보를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling mislukt; je toegang loopt door tot %@. Werk je kaart bij onder \"Beheer account\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento falhou; seu acesso continua até %@. Atualize seu cartão em \"Gerenciar conta\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款失败；你的访问权限将持续到 %@。请在“管理账户”中更新你的银行卡。"
          }
        }
      }
    },
    "Ödeme alınamadığı için yeni toplantı başlatılamıyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Meetings können nicht starten, weil eine Zahlung fehlgeschlagen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New meetings can't start because a payment failed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden iniciar reuniones nuevas porque un pago no se ha podido realizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusia kokouksia ei voi aloittaa, koska maksu epäonnistui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer de nouvelles réunions car un paiement a échoué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile avviare nuove riunioni perché un pagamento non è riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いに失敗したため、新しい会議を開始できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제에 실패하여 새 회의를 시작할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe vergaderingen kunnen niet starten omdat een betaling is mislukt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível iniciar novas reuniões porque um pagamento falhou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于付款失败，无法开始新会议。"
          }
        }
      }
    },
