    "Konuşmacı ayırma modeli indirilemedi; internete bağlanıp \"Modeli yeniden yükle\"ye bas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell zur Sprechertrennung konnte nicht geladen werden; stelle eine Internetverbindung her und klicke auf „Modell neu laden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speaker separation model couldn't be downloaded; connect to the internet and click \"Reload model\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido descargar el modelo de separación de interlocutores; conéctate a internet y haz clic en “Volver a cargar el modelo”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhujien erottelumallia ei voitu ladata; muodosta internetyhteys ja klikkaa ”Lataa malli uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de séparation des intervenants n’a pas pu être téléchargé ; connectez-vous à Internet et cliquez sur « Recharger le modèle »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello di separazione degli interlocutori; connettiti a internet e fai clic su “Ricarica modello”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者分離モデルをダウンロードできませんでした。インターネットに接続して、「モデルを再読み込み」をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 구분 모델을 다운로드할 수 없습니다. 인터넷에 연결하고 \"모델 다시 불러오기\"를 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model voor sprekerscheiding kon niet worden gedownload; maak verbinding met internet en klik op \"Laad model opnieuw\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar o modelo de separação de falantes; conecte-se à internet e clique em \"Recarregar modelo\"."
