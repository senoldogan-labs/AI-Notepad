          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"O que eu perdi?\", perguntas e notas de reunião"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我错过了什么？”、提问和会议笔记"
          }
        }
      }
    },
    "\"Notu yenile\" ile not yeniden yazılabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Notiz aktualisieren“ wird sie neu geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \"Refresh note\" to write it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “Actualizar nota” para volver a escribirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita se uudelleen valinnalla ”Päivitä muistiinpano”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Actualiser la note » pour la rédiger à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “Aggiorna nota” per riscriverla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ノートを更新」で書き直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 작성하려면 \"노트 새로 고침\"을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik \"Notitie vernieuwen\" om hem opnieuw te schrijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \"Atualizar nota\" para escrevê-la de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“刷新笔记”重新撰写。"
          }
        }
      }
    },
    "\"Sen\" kaydı yazıya dökülemedi: %@ Canlı metin eksik olabilir; \"Tekrar işle\" ile yeniden deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme „Du“ konnte nicht transkribiert werden: %@ Der Live-Text ist eventuell unvollständig; mit „Neu verarbeiten“ kannst du es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't transcribe the \"You\" recording: %@ The live text may be incomplete; you can try again with \"Reprocess\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido transcribir la grabación de “Tú”: %@ Puede que el texto en directo esté incompleto; puedes volver a intentarlo con “Reprocesar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Sinä”-nauhoitetta ei voitu litteroida: %@ Reaaliaikainen teksti voi olla puutteellinen; voit yrittää uudelleen valinnalla ”Käsittele uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de transcrire l’enregistrement « Vous » : %@ Le texte en direct est peut-être incomplet ; vous pouvez réessayer avec « Retraiter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere la registrazione “Tu”: %@ Il testo dal vivo potrebbe essere incompleto; puoi riprovare con “Rielabora”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自分」の録音を文字起こしできませんでした：%@ ライブ文字起こしが不完全な可能性があります。「再処理」でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"나\" 녹음을 텍스트로 변환할 수 없습니다: %@ 실시간 텍스트가 불완전할 수 있습니다. \"다시 처리\"로 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de opname van \"Jij\" niet uitschrijven: %@ De live tekst is mogelijk onvolledig; je kunt het opnieuw proberen met \"Opnieuw verwerken\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível transcrever a gravação de \"Você\": %@ O texto ao vivo pode estar incompleto; você pode tentar de novo com \"Reprocessar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转写“你”的录音：%@ 实时文字可能不完整；你可以用“重新处理”再试一次。"
          }
        }
      }
    },
    "\"Sen\" metni eksik: kayıt sırasında akış koptu ve \"Sen\" sesi kaydedilmemiş.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text „Du“ ist unvollständig: Der Stream ist während der Aufnahme abgebrochen und das Audio „Du“ wurde nicht gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"You\" text is incomplete: the stream dropped during recording and the \"You\" audio wasn't saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de “Tú” está incompleto: la transmisión se cortó durante la grabación y no se guardó el audio de “Tú”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Sinä”-teksti on puutteellinen: yhteys katkesi nauhoituksen aikana, eikä ”Sinä”-ääntä tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte « Vous » est incomplet : le flux s’est interrompu pendant l’enregistrement et l’audio « Vous » n’a pas été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo “Tu” è incompleto: il flusso si è interrotto durante la registrazione e l’audio “Tu” non è stato salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自分」のテキストが不完全です：録音中にストリームが途切れ、「自分」の音声は保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"나\" 텍스트가 불완전합니다: 녹음 중 스트림이 끊겼고 \"나\" 오디오가 저장되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst van \"Jij\" is onvolledig: de stream viel weg tijdens de opname en het geluid van \"Jij\" is niet bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto de \"Você\" está incompleto: a transmissão caiu durante a gravação e o áudio de \"Você\" não foi salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“你”的文字不完整：录制期间数据流中断，且“你”的音频未存储。"
          }
        }
      }
    },
