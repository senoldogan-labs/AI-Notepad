    "Notlar Slack, Teams, Discord, Notion ya da Zoom'a, görevler Linear ya da Jira'ya gider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen gehen an Slack, Teams, Discord, Notion oder Zoom; Aufgaben gehen an Linear oder Jira."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes go to Slack, Teams, Discord, Notion or Zoom; tasks go to Linear or Jira."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas van a Slack, Teams, Discord, Notion o Zoom; las tareas, a Linear o Jira."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot menevät Slackiin, Teamsiin, Discordiin, Notioniin tai Zoomiin; tehtävät menevät Lineariin tai Jiraan."
          }
        },
        "fr": {
