          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou; assine de novo para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已结束；重新订阅即可录制。"
          }
        }
      }
    },
    "Aboneliğin sona erdiği için bu toplantı işlenemedi. Ses bu Mac'te kalır; yeniden abone olunca kendiliğinden işlenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting konnte nicht verarbeitet werden, weil dein Abo abgelaufen ist. Das Audio bleibt auf diesem Mac; es wird automatisch verarbeitet, sobald du erneut ein Abo abschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting couldn't be processed because your subscription has ended. The audio stays on this Mac; it's processed automatically once you subscribe again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar esta reunión porque tu suscripción ha finalizado. El audio se queda en este Mac; se procesará automáticamente cuando vuelvas a suscribirte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei voitu käsitellä, koska tilauksesi on päättynyt. Ääni säilyy tässä Macissa; se käsitellään automaattisesti, kun tilaat uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas pu être traitée car votre abonnement a pris fin. L’audio reste sur ce Mac ; il sera traité automatiquement dès que vous vous réabonnerez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare questa riunione perché il tuo abbonamento è terminato. L’audio resta su questo Mac; verrà elaborato automaticamente quando ti abbonerai di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが終了したため、この会議を処理できませんでした。音声はこのMacに残り、再度登録すると自動的に処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 종료되어 이 회의를 처리할 수 없습니다. 오디오는 이 Mac에 그대로 남아 있으며 다시 구독하면 자동으로 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kon niet worden verwerkt omdat je abonnement is beëindigd. De audio blijft op deze Mac; hij wordt automatisch verwerkt zodra je opnieuw abonneert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível processar esta reunião porque sua assinatura terminou. O áudio continua neste Mac; ele será processado automaticamente quando você assinar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于你的订阅已结束，无法处理此会议。音频保留在这台 Mac 上；重新订阅后会自动处理。"
          }
        }
      }
    },
