    "Giriş yapılmamış. Ayarlar › Hesap'tan Apple ya da Google ile giriş yap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angemeldet. Melde dich unter „Einstellungen“ › „Account“ mit Apple oder Google an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in. Sign in with Apple or Google in Settings › Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión no iniciada. Inicia sesión con Apple o Google en Ajustes › Cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kirjautunut. Kirjaudu Applella tai Googlella kohdassa Asetukset › Tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté. Connectez-vous avec Apple ou Google dans Réglages › Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non eseguito. Accedi con Apple o Google in Impostazioni › Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしていません。「設定」›「アカウント」でAppleまたはGoogleでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하지 않았습니다. 설정 › 계정에서 Apple 또는 Google로 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet ingelogd. Log in met Apple of Google in Instellingen › Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão não iniciada. Inicie sessão com Apple ou Google em Ajustes › Conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
