    "Takvime erişim izni yok: Sistem Ayarları › Gizlilik ve Güvenlik › Takvimler'den %@'e izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Kalender: Erlaube %@ unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Kalender“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to Calendar: allow %@ in System Settings › Privacy & Security › Calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Calendario: permite %@ en Ajustes del Sistema › Privacidad y seguridad › Calendarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei pääsyä Kalenteriin: salli %@ kohdassa Järjestelmäasetukset › Tietosuoja ja suojaus › Kalenterit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès à Calendrier : autorisez %@ dans Réglages Système › Confidentialité et sécurité › Calendriers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso a Calendario: consenti %@ in Impostazioni di Sistema › Privacy e sicurezza › Calendari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセス権がありません：「システム設定」›「プライバシーとセキュリティ」›「カレンダー」で%@を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 접근할 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 캘린더에서 %@ 앱을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot Agenda: sta %@ toe in Systeeminstellingen › Privacy en beveiliging › Agenda's."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao Calendário: permita %@ em Ajustes do Sistema › Privacidade e Segurança › Calendários."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权访问日历：请在“系统设置 › 隐私与安全性 › 日历”中允许 %@。"
          }
        }
      }
    },
    "Takvime erişim izni yok; sıradaki toplantılar görünmüyor. Ayarlar'a git.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kalenderzugriff, daher können anstehende Meetings nicht angezeigt werden. Öffne die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar access, so upcoming meetings can't be shown. Go to Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al calendario, no se pueden mostrar las próximas reuniones. Ve a Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kalenterin käyttöoikeutta, joten tulevia kokouksia ei voi näyttää. Siirry Asetuksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au calendrier ; les réunions à venir ne peuvent donc pas être affichées. Allez dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al calendario, quindi non è possibile mostrare le prossime riunioni. Vai a Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセス権がないため、今後の会議を表示できません。設定を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한이 없어 예정된 회의를 표시할 수 없습니다. 설정으로 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de agenda, dus komende vergaderingen kunnen niet worden getoond. Ga naar Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao calendário, então as próximas reuniões não podem ser exibidas. Vá para Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有日历访问权限，因此无法显示即将开始的会议。请前往设置。"
          }
        }
      }
    },
