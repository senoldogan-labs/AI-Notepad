    "Kesintisiz devam etmek için bir plan seç. Toplantıların ve notların bu Mac'te kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Tarif, um ohne Unterbrechung weiterzumachen. Deine Meetings und Notizen bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a plan to keep going without a break. Your meetings and notes stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un plan para continuar sin interrupciones. Tus reuniones y notas se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tilaus, niin voit jatkaa ilman taukoa. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un forfait pour continuer sans interruption. Vos réunions et notes restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un piano per continuare senza interruzioni. Le riunioni e le note restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途切れることなく使い続けるには、プランを選択してください。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊김 없이 계속 사용하려면 플랜을 선택하세요. 회의와 노트는 이 Mac에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een abonnement om zonder onderbreking door te gaan. Je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um plano para continuar sem interrupção. Suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个方案即可不间断地继续使用。你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
