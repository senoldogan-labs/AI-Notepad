          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Sunucu bu işlemi henüz desteklemiyor (güncelleniyor). Toplantı işlenmedi; biraz sonra \"Tekrar işle\" ile yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server unterstützt das noch nicht (er wird gerade aktualisiert). Das Meeting wurde nicht verarbeitet; versuche „Neu verarbeiten“ in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn't support this yet (it's being updated). The meeting wasn't processed; try \"Reprocess\" again in a little while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor aún no admite esto (se está actualizando). La reunión no se ha procesado; vuelve a probar “Reprocesar” dentro de un rato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei vielä tue tätä (sitä päivitetään). Kokousta ei käsitelty; kokeile valintaa ”Käsittele uudelleen” hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne prend pas encore cela en charge (mise à jour en cours). La réunion n’a pas été traitée ; réessayez « Retraiter » d’ici peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non lo supporta ancora (è in aggiornamento). La riunione non è stata elaborata; riprova “Rielabora” tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはまだこれに対応していません（アップデート中）。会議は処理されませんでした。しばらくしてから、もう一度「再処理」をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 아직 이 기능을 지원하지 않습니다(업데이트 중). 회의가 처리되지 않았습니다. 잠시 후 \"다시 처리\"를 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server ondersteunt dit nog niet (hij wordt bijgewerkt). De vergadering is niet verwerkt; probeer \"Opnieuw verwerken\" over een tijdje nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor ainda não é compatível com isso (está sendo atualizado). A reunião não foi processada; tente \"Reprocessar\" de novo daqui a pouco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器暂不支持此功能（正在更新）。会议未处理；请稍后再试一次“重新处理”。"
          }
        }
      }
    },
    "Sunucu isteği şu an tamamlayamadı. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte die Anfrage gerade nicht abschließen. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server couldn't complete the request right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha podido completar la solicitud ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei voinut suorittaa pyyntöä juuri nyt. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas pu traiter la requête pour le moment. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non è riuscito a completare la richiesta in questo momento. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは現在リクエストを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 서버가 요청을 완료할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server kon het verzoek nu niet voltooien. Probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu concluir a solicitação agora. Tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器目前无法完成请求。请稍后再试。"
          }
        }
      }
    },
    "Sunucu ve kanalı Discord'da seç": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Server und Kanal in Discord"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the server and channel in Discord"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el servidor y el canal en Discord"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse palvelin ja kanava Discordissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le serveur et le canal dans Discord"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli server e canale in Discord"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discordでサーバとチャンネルを選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord에서 서버와 채널 선택"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de server en het kanaal in Discord"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o servidor e o canal no Discord"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Discord 中选择服务器和频道"
          }
        }
      }
    },
    "Sunucuda beklenmeyen bir hata oluştu; biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist ein unerwarteter Fehler aufgetreten; versuche es etwas später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred on the server; try again a bit later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error inesperado en el servidor; inténtalo de nuevo un poco más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimella tapahtui odottamaton virhe; yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur inattendue s’est produite sur le serveur ; réessayez un peu plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore imprevisto sul server; riprova un po’ più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバで予期しないエラーが発生しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 예기치 않은 오류가 발생했습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een onverwachte fout op de server opgetreden; probeer het iets later opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro inesperado no servidor; tente de novo um pouco mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上发生意外错误；请稍后再试。"
          }
        }
      }
    },
    "Sunucudan beklenmeyen bir yanıt geldi. Uygulamayı güncelleyip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine unerwartete Antwort gesendet. Aktualisiere die App und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent an unexpected response. Update the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha enviado una respuesta inesperada. Actualiza la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin lähetti odottamattoman vastauksen. Päivitä sovellus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a envoyé une réponse inattendue. Mettez à jour l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha inviato una risposta inattesa. Aggiorna l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバから予期しない応答が返されました。アプリをアップデートして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 예기치 않은 응답을 보냈습니다. 앱을 업데이트하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server stuurde een onverwacht antwoord. Werk de app bij en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor enviou uma resposta inesperada. Atualize o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器发送了意外的响应。请更新 App 后重试。"
          }
        }
      }
    },
    "Sunucuya ulaşılamadı; internet bağlantını kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar; prüfe deine Internetverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the server; check your internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido acceder al servidor; comprueba tu conexión a internet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimeen ei saatu yhteyttä; tarkista internetyhteys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur ; vérifiez votre connexion Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server; controlla la connessione a internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できませんでした。インターネット接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 인터넷 연결을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de server niet bereiken; controleer je internetverbinding."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor; verifique sua conexão com a internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器；请检查你的互联网连接。"
          }
        }
      }
    },
