    "Deneme %@ sürer. Kesintisiz devam etmek için şimdi abone olabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase dauert %@. Schließe jetzt ein Abo ab, um ohne Unterbrechung weiterzumachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial lasts %@. Subscribe now to keep going without a break."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba dura %@. Suscríbete ahora para continuar sin interrupciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujakso kestää %@. Tilaa nyt, niin voit jatkaa ilman taukoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai dure %@. Abonnez-vous maintenant pour continuer sans interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova dura %@. Abbonati ora per continuare senza interruzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル期間は%@です。今すぐ登録すると、途切れることなく使い続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험 기간은 %@입니다. 끊김 없이 계속 사용하려면 지금 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proefperiode duurt %@. Neem nu een abonnement om zonder onderbreking door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste dura %@. Assine agora para continuar sem interrupção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期为%@。立即订阅即可不间断地继续使用。"
          }
        }
      }
    },
