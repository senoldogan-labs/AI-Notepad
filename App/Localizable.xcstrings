    "Bildirim izni yok: Sistem Ayarları › Bildirimler › %@ bölümünden izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Berechtigung für Mitteilungen: Erlaube %@ unter „Systemeinstellungen“ › „Mitteilungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No permission for notifications: allow %@ in System Settings › Notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso para notificaciones: permite %@ en Ajustes del Sistema › Notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei lupaa ilmoituksiin: salli %@ kohdassa Järjestelmäasetukset › Ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’autorisation pour les notifications : autorisez %@ dans Réglages Système › Notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna autorizzazione per le notifiche: consenti %@ in Impostazioni di Sistema › Notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可がありません：「システム設定」›「通知」で%@を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 없습니다: 시스템 설정 › 알림에서 %@을(를) 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toestemming voor meldingen: sta %@ toe in Systeeminstellingen › Meldingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão para notificações: permita %@ em Ajustes do Sistema › Notificações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通知权限：请在“系统设置 › 通知”中允许 %@。"
          }
        }
      }
    },
    "Bildirim izni yok: iPhone Ayarları › Bildirimler › %@ bölümünden izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Berechtigung für Mitteilungen: Erlaube sie in den iPhone-Einstellungen unter „Mitteilungen“ › „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notification permission: allow it in iPhone Settings › Notifications › %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso para notificaciones: permítelo en Ajustes del iPhone › Notificaciones › %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ilmoituslupaa: salli se iPhonen kohdassa Asetukset › Ilmoitukset › %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’autorisation pour les notifications : autorisez-les dans Réglages de l’iPhone › Notifications › %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna autorizzazione per le notifiche: consentile in Impostazioni di iPhone › Notifiche › %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可がありません：iPhoneの「設定」›「通知」›「%@」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 없습니다: iPhone 설정 › 알림 › %@에서 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toestemming voor meldingen: sta het toe in Instellingen › Meldingen › %@ op de iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão para notificações: permita em Ajustes do iPhone › Notificações › %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通知权限：请在 iPhone“设置 › 通知 › %@”中允许。"
          }
        }
      }
    },
    "Bildirim kurulamadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilung konnte nicht geplant werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't schedule the notification: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido programar la notificación: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusta ei voitu ajoittaa: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de programmer la notification : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile programmare la notifica: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をスケジュールできませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
