          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu calendário para ver aqui as reuniões de hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
