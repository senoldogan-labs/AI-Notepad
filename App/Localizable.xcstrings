    "Asistanında özel bağlayıcı olarak ekle; girişte %@ hesabını seçersin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge sie deinem Assistenten als benutzerdefinierten Connector hinzu und melde dich dann mit deinem %@-Account an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add it to your assistant as a custom connector, then sign in with your %@ account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añádela a tu asistente como conector personalizado y luego inicia sesión con tu cuenta de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää se avustajaasi mukautettuna liittimenä ja kirjaudu sitten %@-tililläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-la à votre assistant comme connecteur personnalisé, puis connectez-vous avec votre compte %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungilo al tuo assistente come connettore personalizzato, poi accedi con il tuo account %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントにカスタムコネクタとして追加し、%@アカウントでサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트에 맞춤 커넥터로 추가한 다음 %@ 계정으로 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het als aangepaste connector toe aan je assistent en log daarna in met je %@-account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione-o ao seu assistente como conector personalizado e depois entre com sua conta %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
