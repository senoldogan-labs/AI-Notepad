    "Kayıt başlarken haber vermeyi hatırlat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnern, Teilnehmende zu informieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me to tell participants"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordarme avisar a los participantes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistuta kertomaan osallistujille"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me rappeler de prévenir les participants"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricordami di avvisare i partecipanti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者への告知をリマインド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참석자에게 알리도록 알림"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinner me eraan het deelnemers te laten weten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrar-me de avisar os participantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒我告知参与者"
          }
        }
      }
    },
    "Kayıt başlarken katılımcılara söylemeyi hatırlatır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich beim Start der Aufnahme daran, die Teilnehmenden zu informieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you to tell participants when recording starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recuerda avisar a los participantes cuando empieza la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistuttaa kertomaan osallistujille, kun nauhoitus alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rappelle de prévenir les participants au début de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ricorda di avvisare i partecipanti quando inizia la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の開始時に、参加者に伝えるようリマインドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 시작되면 참석자에게 알리도록 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert je eraan het deelnemers te laten weten als de opname start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra você de avisar os participantes quando a gravação começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录制时提醒你告知参与者。"
          }
        }
      }
    },
