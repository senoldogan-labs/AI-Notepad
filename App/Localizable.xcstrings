          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議を処理中です。完了すると保存できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 처리하는 중입니다. 처리가 끝나면 저장할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergadering wordt verwerkt; je kunt bewaren zodra dat klaar is"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reunião está sendo processada; você pode salvar quando terminar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理会议；完成后即可存储"
          }
        }
      }
    },
