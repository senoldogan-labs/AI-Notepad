    "Mac'teki anahtarlar iCloud Anahtar Zinciri ile gelir ya da burada girersin; hiçbir yere gönderilmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel deines Mac kommen über den iCloud-Schlüsselbund, oder du gibst sie hier ein; sie werden nie irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac's keys arrive via iCloud Keychain, or you enter them here; they're never sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de tu Mac llegan a través del Llavero de iCloud, o las introduces aquí; nunca se envían a ningún sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macisi avaimet saapuvat iCloud-avainnipun kautta, tai syötät ne tässä; niitä ei koskaan lähetetä minnekään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de votre Mac arrivent via le trousseau iCloud, ou vous les saisissez ici ; elles ne sont jamais envoyées nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi del Mac arrivano tramite il Portachiavi iCloud, oppure le inserisci qui; non vengono mai inviate da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのキーはiCloudキーチェーン経由で届くか、ここで入力します。どこにも送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 키가 iCloud 키체인을 통해 도착하거나 여기에서 직접 입력할 수 있습니다. 키는 어디에도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutels van je Mac komen binnen via de iCloud-sleutelhanger, of je voert ze hier in; ze worden nooit ergens naartoe gestuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves do seu Mac chegam pelas Chaves do iCloud, ou você as digita aqui; elas nunca são enviadas a lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你 Mac 上的密钥会通过 iCloud 钥匙串到达，或由你在这里输入；它们绝不会发送到任何地方。"
          }
        }
      }
    },
