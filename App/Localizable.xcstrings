    "Aboneliğin web'de yönetiliyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo wird im Web verwaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription is managed on the web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se gestiona en la web."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaustasi hallitaan verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement est géré sur le web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è gestito sul web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションはWebで管理されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 웹에서 관리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement wordt via het web beheerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura é gerenciada na web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅在网页上管理。"
          }
        }
      }
    },
    "Apple'ın abonelik penceresi açılamadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Abo-Bildschirm konnte nicht geöffnet werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's subscription screen couldn't be opened: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir la pantalla de suscripciones de Apple: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen tilausnäkymää ei voitu avata: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran d’abonnement d’Apple n’a pas pu s’ouvrir : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la schermata degli abbonamenti di Apple: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのサブスクリプション画面を開けませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 구독 화면을 열 수 없습니다: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnementenscherm van Apple kon niet worden geopend: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a tela de assinaturas da Apple: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 Apple 的订阅屏幕：%@"
          }
        }
      }
    },
    "Web aboneliğin hemen iptal edilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Web-Abo wird sofort gekündigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your web subscription is canceled immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción web se cancela de inmediato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkotilauksesi perutaan heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement web est résilié immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento web viene annullato immediatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webのサブスクリプションはただちにキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 구독이 즉시 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je webabonnement wordt onmiddellijk opgezegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura pela web é cancelada imediatamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的网页订阅会立即取消。"
          }
        }
      }
    },
    "App Store aboneliğin hesabı silince iptal olmaz; Apple ücret almaya devam eder. Önce \"Aboneliği yönet\"ten iptal et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen deines Accounts kündigt dein App Store-Abo nicht; Apple rechnet weiter ab. Kündige es zuerst unter „Abo verwalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account doesn't cancel your App Store subscription; Apple keeps charging you. Cancel it first under \"Manage subscription\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar tu cuenta no cancela tu suscripción del App Store; Apple seguirá cobrándote. Cancélala primero en “Gestionar suscripción”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin poistaminen ei peru App Store -tilaustasi; Apple jatkaa veloittamista. Peru se ensin kohdassa ”Hallitse tilausta”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer votre compte ne résilie pas votre abonnement App Store ; Apple continue de vous débiter. Résiliez-le d’abord dans « Gérer l’abonnement »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare l’account non annulla l’abbonamento App Store; Apple continua ad addebitarti. Annullalo prima in “Gestisci abbonamento”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除してもApp Storeのサブスクリプションはキャンセルされず、Appleからの請求が続きます。先に「サブスクリプションを管理」でキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제해도 App Store 구독은 취소되지 않으며 Apple이 계속 요금을 청구합니다. 먼저 \"구독 관리\"에서 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je account verwijdert, wordt je App Store-abonnement niet opgezegd; Apple blijft afschrijven. Zeg het eerst op onder \"Beheer abonnement\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar sua conta não cancela sua assinatura da App Store; a Apple continua cobrando. Cancele-a primeiro em \"Gerenciar assinatura\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账户不会取消你的 App Store 订阅；Apple 会继续向你收费。请先在“管理订阅”中取消。"
          }
        }
      }
    },
    "App Store aboneliğin zaten yenilenmeyecek; yeniden ücret alınmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein App Store-Abo wird nicht verlängert; dir wird nichts mehr berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your App Store subscription won't renew; you won't be charged again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción del App Store no se renovará; no se te volverá a cobrar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store -tilauksesi ei uusiudu; sinua ei veloiteta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement App Store ne sera pas renouvelé ; vous ne serez plus débité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento App Store non verrà rinnovato; non ti verrà addebitato di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeのサブスクリプションは更新されません。今後請求されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 구독이 갱신되지 않으며, 더 이상 요금이 청구되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je App Store-abonnement wordt niet verlengd; er wordt niet opnieuw afgeschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura da App Store não será renovada; você não será cobrado de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 App Store 订阅不会续订；你不会再被收费。"
          }
        }
      }
    },
    "Web aboneliğin hemen iptal edilir. App Store aboneliğin ise iptal olmaz; Apple ücret almaya devam eder. Önce \"Aboneliği yönet\"ten iptal et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Web-Abo wird sofort gekündigt. Dein App Store-Abo nicht; Apple rechnet weiter ab. Kündige es zuerst unter „Abo verwalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your web subscription is canceled immediately. Your App Store subscription isn't; Apple keeps charging you. Cancel it first under \"Manage subscription\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción web se cancela de inmediato. Tu suscripción del App Store no; Apple seguirá cobrándote. Cancélala primero en “Gestionar suscripción”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkotilauksesi perutaan heti. App Store -tilaustasi ei; Apple jatkaa veloittamista. Peru se ensin kohdassa ”Hallitse tilausta”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement web est résilié immédiatement. Votre abonnement App Store ne l’est pas ; Apple continue de vous débiter. Résiliez-le d’abord dans « Gérer l’abonnement »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento web viene annullato immediatamente. L’abbonamento App Store invece no; Apple continua ad addebitarti. Annullalo prima in “Gestisci abbonamento”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webのサブスクリプションはただちにキャンセルされます。App Storeのサブスクリプションはキャンセルされず、Appleからの請求が続きます。先に「サブスクリプションを管理」でキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 구독은 즉시 취소되지만 App Store 구독은 취소되지 않으며 Apple이 계속 요금을 청구합니다. 먼저 \"구독 관리\"에서 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je webabonnement wordt onmiddellijk opgezegd. Je App Store-abonnement niet; Apple blijft afschrijven. Zeg het eerst op onder \"Beheer abonnement\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura pela web é cancelada imediatamente. A da App Store não; a Apple continua cobrando. Cancele-a primeiro em \"Gerenciar assinatura\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的网页订阅会立即取消。你的 App Store 订阅不会；Apple 会继续向你收费。请先在“管理订阅”中取消。"
          }
        }
      }
    },
    "Hesabın silindi, ama App Store aboneliğin iptal olmadı: Apple %@ tarihinde yeniden ücret alır. Aboneliği şimdi iptal et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Account ist gelöscht, aber dein App Store-Abo ist nicht gekündigt: Apple rechnet am %@ erneut ab. Kündige das Abo jetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is deleted, but your App Store subscription isn't canceled: Apple charges you again on %@. Cancel the subscription now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se ha eliminado, pero tu suscripción del App Store no se ha cancelado: Apple volverá a cobrarte el %@. Cancela la suscripción ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi on poistettu, mutta App Store -tilaustasi ei ole peruttu: Apple veloittaa sinua uudelleen %@. Peru tilaus nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est supprimé, mais votre abonnement App Store n’est pas résilié : Apple vous débitera de nouveau le %@. Résiliez l’abonnement maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è stato eliminato, ma l’abbonamento App Store non è stato annullato: Apple ti addebiterà di nuovo il %@. Annulla l’abbonamento ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは削除されましたが、App Storeのサブスクリプションはキャンセルされていません：%@にAppleから再度請求されます。今すぐサブスクリプションをキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 삭제되었지만 App Store 구독은 취소되지 않았습니다. Apple이 %@에 다시 요금을 청구합니다. 지금 구독을 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is verwijderd, maar je App Store-abonnement is niet opgezegd: Apple schrijft op %@ opnieuw af. Zeg het abonnement nu op."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta foi apagada, mas sua assinatura da App Store não foi cancelada: a Apple vai cobrar de novo em %@. Cancele a assinatura agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户已删除，但你的 App Store 订阅未取消：Apple 将于 %@ 再次向你收费。请立即取消订阅。"
          }
        }
      }
    },
    "Aboneliğin %@ tarihinde sona erdi. Toplantıların ve notların bu iPhone'da; yeni kayıt için yeniden abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist am %@ abgelaufen. Deine Meetings und Notizen bleiben auf diesem iPhone; schließe erneut ein Abo ab, um neue aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription ended on %@. Your meetings and notes stay on this iPhone; resubscribe to record new ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción finalizó el %@. Tus reuniones y notas se quedan en este iPhone; vuelve a suscribirte para grabar otras nuevas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi päättyi %@. Kokouksesi ja muistiinpanosi säilyvät tässä iPhonessa; tilaa uudelleen, niin voit nauhoittaa uusia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a pris fin le %@. Vos réunions et notes restent sur cet iPhone ; réabonnez-vous pour en enregistrer de nouvelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è terminato il %@. Le riunioni e le note restano su questo iPhone; abbonati di nuovo per registrarne di nuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは%@に終了しました。会議とノートはこのiPhoneに残ります。新しい会議を録音するには再度登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 %@에 종료되었습니다. 회의와 노트는 이 iPhone에 남아 있습니다. 새 회의를 녹음하려면 다시 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is beëindigd op %@. Je vergaderingen en notities blijven op deze iPhone; abonneer opnieuw om nieuwe op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou em %@. Suas reuniões e notas continuam neste iPhone; assine de novo para gravar novas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已于 %@ 结束。你的会议和笔记保留在这部 iPhone 上；重新订阅即可录制新会议。"
          }
        }
      }
    },
    "Aboneliğin web'de (kartla) alındı; Mac uygulamasında Ayarlar › Hesap › Hesabı yönet'ten yönetebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo wurde im Web (per Karte) gekauft; verwalte es in der Mac-App unter „Einstellungen“ › „Account“ › „Account verwalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription was bought on the web (by card); manage it in the Mac app under Settings › Account › Manage account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se compró en la web (con tarjeta); gestiónala en la app para Mac en Ajustes › Cuenta › Gestionar cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi ostettiin verkossa (kortilla); hallitse sitä Mac-sovelluksessa kohdassa Asetukset › Tili › Hallitse tiliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a été acheté sur le web (par carte) ; gérez-le dans l’app Mac sous Réglages › Compte › Gérer le compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è stato acquistato sul web (con carta); gestiscilo nell’app per Mac in Impostazioni › Account › Gestisci account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションはWeb（カード）で購入されています。Macアプリの「設定」›「アカウント」›「アカウントを管理」で管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹에서(카드로) 구입한 구독입니다. Mac 앱의 설정 › 계정 › 계정 관리에서 관리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is via het web gekocht (met een kaart); beheer het in de Mac-app onder Instellingen › Account › Beheer account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura foi comprada na web (com cartão); gerencie-a no app para Mac em Ajustes › Conta › Gerenciar conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅是在网页上（通过银行卡）购买的；请在 Mac App 的“设置 › 账户 › 管理账户”中管理。"
          }
        }
      }
    },
