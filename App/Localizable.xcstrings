    "Dinleme başlarken ve biterken kısa bir ses çalar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short sound when listening starts and stops."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen kurzen Ton, wenn das Zuhören beginnt und endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un son bref au début et à la fin de l'écoute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un sonido breve al empezar y al terminar de escuchar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve suono quando l'ascolto inizia e finisce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um som curto quando a escuta começa e termina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt een kort geluid af als het luisteren begint en stopt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取りの開始時と終了時に短い音を鳴らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣기를 시작하고 끝낼 때 짧은 소리를 재생합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始和结束聆听时播放简短提示音。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittaa lyhyen äänen, kun kuuntelu alkaa ja päättyy."
          }
        }
      }
    },
