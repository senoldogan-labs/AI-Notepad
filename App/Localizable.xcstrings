          "stringUnit": {
            "state": "translated",
            "value": "将名称设为 %@，粘贴上方的地址并添加。"
          }
        }
      }
    },
    "\"Bağlan\"a bas, %@ hesabınla giriş yap ve izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Connect“, melde dich mit deinem %@-Account an und erlaube den Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
