    "Telefonu masaya koy ve dokun; odadaki herkes konuşmacılara ayrılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dein iPhone auf den Tisch und tippe; alle im Raum werden nach Sprecher unterschieden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on the table and tap; everyone in the room is told apart by speaker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el teléfono sobre la mesa y toca; se distingue a cada persona de la sala como interlocutor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita puhelin pöydälle ja napauta; kaikki huoneessa olevat erotellaan puhujittain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez votre téléphone sur la table et touchez ; chaque personne dans la pièce est distinguée en tant qu’intervenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia il telefono sul tavolo e tocca; tutti i presenti nella stanza vengono distinti per interlocutore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneをテーブルに置いてタップするだけ。部屋にいる全員が話者ごとに区別されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 테이블에 놓고 탭하세요. 회의실에 있는 모든 사람이 화자별로 구분됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg je telefoon op tafel en tik; iedereen in de ruimte wordt per spreker onderscheiden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o telefone na mesa e toque; todos na sala são distinguidos por falante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机放在桌上并轻点；房间里的每个人都会按说话人区分开来。"
          }
        }
      }
    },
    "Not, kararlar, görevler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, Entscheidungen, Aufgaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, decisions, tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, decisiones, tareas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot, päätökset, tehtävät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, décisions, tâches"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note, decisioni, attività"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、決定事項、タスク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트, 결정 사항, 할 일"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities, besluiten, taken"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, decisões, tarefas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记、决策、任务"
          }
        }
      }
    },
    "Bitince not hazır: kararlar ve sana düşen işler en üstte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende ist deine Notiz fertig: Entscheidungen und deine Aufgaben oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it ends, your note is ready: decisions and your tasks at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar, tu nota está lista: las decisiones y tus tareas arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun se päättyy, muistiinpanosi on valmis: päätökset ja tehtäväsi ylimpänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin, votre note est prête : décisions et vos tâches en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine la nota è pronta: decisioni e le tue attività in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると、ノートが完成：決定事項とあなたのタスクが上部に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 끝나면 노트가 준비됩니다. 결정 사항과 내 할 일이 맨 위에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na afloop staat je notitie klaar: besluiten en je taken bovenaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando terminar, sua nota estará pronta: decisões e suas tarefas no topo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议结束时，你的笔记就已准备好：决策和你的任务在顶部。"
          }
        }
      }
    },
    "“Bütçe ne oldu?” diye sor; cevap hangi toplantıdan geldiğini gösterir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag „Was ist mit dem Budget passiert?“; die Antwort zeigt, aus welchem Meeting sie stammt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask “What happened with the budget?”; the answer shows which meeting it came from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta “¿Qué pasó con el presupuesto?”; la respuesta muestra de qué reunión procede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy ”Mitä budjetille tapahtui?”; vastaus näyttää, mistä kokouksesta se tuli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez « Qu’est-il advenu du budget ? » ; la réponse indique de quelle réunion elle provient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi “Cosa è successo con il budget?”; la risposta mostra da quale riunione proviene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「予算の件はどうなった？」と質問すると、回答にはどの会議の情報かが示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“예산은 어떻게 됐나요?”라고 질문해 보세요. 답변에 어느 회의에서 나온 내용인지 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag “Wat is er met het budget gebeurd?”; het antwoord toont uit welke vergadering het komt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte “O que aconteceu com o orçamento?”; a resposta mostra de qual reunião veio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问“预算的事情怎么样了？”；回答会显示它来自哪个会议。"
          }
        }
      }
    },
    "Takvimini bağla": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Kalender"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu calendario"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä kalenterisi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre calendrier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il calendario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを接続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 연결하기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel je agenda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu calendário"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的日历"
          }
        }
      }
    },
    "Sıradaki toplantıların burada görünür; o sırada başlattığın kayıt toplantının adını ve katılımcılarını alır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine anstehenden Meetings erscheinen hier; eine Aufnahme, die du währenddessen startest, übernimmt Titel und Teilnehmende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your upcoming meetings appear here; a recording you start during one takes its title and attendees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus próximas reuniones aparecen aquí; una grabación que inicies durante una de ellas toma su título y sus asistentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevat kokouksesi näkyvät tässä; kokouksen aikana aloittamasi nauhoitus saa sen otsikon ja osallistujat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions à venir apparaissent ici ; un enregistrement démarré pendant l’une d’elles en reprend le titre et les participants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prossime riunioni appaiono qui; una registrazione avviata durante una di esse ne prende il titolo e i partecipanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の会議がここに表示されます。会議中に録音を開始すると、そのタイトルと参加者が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 회의가 여기에 표시됩니다. 회의 중에 녹음을 시작하면 해당 회의의 제목과 참석자가 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je komende vergaderingen verschijnen hier; een opname die je tijdens een vergadering start, neemt de titel en deelnemers over."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas próximas reuniões aparecem aqui; uma gravação iniciada durante uma delas recebe o título e os participantes dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你即将开始的会议会显示在这里；在会议期间开始的录音会采用其标题和参与者。"
          }
        }
      }
    },
    "Takvimi bağla": {
      "localizations": {
