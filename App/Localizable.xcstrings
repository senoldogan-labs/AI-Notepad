    "Kısayola basmanı bekliyorum…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you to press the shortcut…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte darauf, dass du das Kürzel drückst…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du raccourci…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que pulses el atajo…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa che premi l'abbreviazione…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando você pressionar o atalho…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot je de sneltoets indrukt…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが押されるのを待っています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르기를 기다리는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你按下快捷键…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan, että painat pikanäppäintä…"
          }
        }
      }
    },
    "Kısayola basılı tut, bir cümle söyle ve bırak. Ör. “Yarın onda kısa bir toplantı yapalım.”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the shortcut, say a sentence and let go. For example: “Let's have a quick meeting at ten tomorrow.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Kürzel, sag einen Satz und lass los. Zum Beispiel: „Lass uns morgen um zehn kurz treffen.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le raccourci, dites une phrase et relâchez. Par exemple : « Faisons une courte réunion demain à dix heures. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el atajo, di una frase y suelta. Por ejemplo: «Hagamos una reunión breve mañana a las diez»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta l'abbreviazione, di' una frase e rilascia. Ad esempio: “Facciamo una breve riunione domani alle dieci.”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o atalho pressionado, diga uma frase e solte. Por exemplo: “Vamos fazer uma reunião rápida amanhã às dez.”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de sneltoets ingedrukt, zeg een zin en laat los. Bijvoorbeeld: ‘Laten we morgen om tien kort vergaderen.’"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押したまま一文話して離します。例:「明日10時に短い打ち合わせをしましょう。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누른 채 한 문장을 말하고 떼세요. 예: “내일 10시에 짧게 회의해요.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷键,说一句话后松开。例如:“明天十点开个短会吧。”"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä pikanäppäintä painettuna, sano lause ja päästä irti. Esim. ”Pidetään huomenna kymmeneltä lyhyt kokous.”"
          }
        }
      }
    },
    "Kısayolunu dene": {
      "localizations": {
