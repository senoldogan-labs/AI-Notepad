    "Not düzenlenemedi: LLM anahtarı ya da ayarı yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiz konnte nicht bearbeitet werden: kein LLM-Schlüssel oder keine Einstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't edit the note: no LLM key or setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido editar la nota: no hay ninguna clave ni ajuste del LLM."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoa ei voitu muokata: kielimallin avain tai asetus puuttuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier la note : aucune clé ni aucun réglage LLM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare la nota: nessuna chiave o impostazione LLM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを編集できませんでした：LLMのキーまたは設定がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 편집할 수 없습니다: LLM 키나 설정이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de notitie niet wijzigen: geen LLM-sleutel of -instelling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
