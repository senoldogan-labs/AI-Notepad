    "Toplantıdaki rolünü anlamaya yardım eder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft Notizen, deine Rolle in Meetings zu verstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps notes understand your role in meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a las notas a entender tu rol en las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auttaa muistiinpanoja ymmärtämään roolisi kokouksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide les notes à comprendre votre rôle en réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta le note a capire il tuo ruolo nelle riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議でのあなたの役割をノートが理解する手助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트가 회의에서 내 역할을 이해하도록 돕습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helpt notities je rol in vergaderingen te begrijpen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda as notas a entender seu papel nas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助笔记理解你在会议中的角色。"
          }
        }
      }
    },
    "Kendi şirketini müşteriden ve iş ortağından ayırır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterscheidet dein eigenes Unternehmen von Kunden und Partnern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells your own company apart from clients and partners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue tu propia empresa de clientes y socios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erottaa oman yrityksesi asiakkaista ja kumppaneista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue votre entreprise de vos clients et partenaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue la tua azienda da clienti e partner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自社と顧客・パートナーを区別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 회사를 고객 및 파트너와 구분합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderscheidt je eigen bedrijf van klanten en partners."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia sua empresa de clientes e parceiros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区分你自己的公司与客户和合作伙伴。"
          }
        }
      }
    },
    "Ne yaptığınızı, ürünlerinizi ve sık geçen terimleri birkaç cümleyle yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe in ein paar Sätzen, was ihr macht, eure Produkte und häufige Begriffe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what you do, your products and terms that come up often, in a few sentences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe en unas pocas frases a qué os dedicáis, vuestros productos y los términos habituales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa muutamalla lauseella, mitä teette, tuotteenne ja usein toistuvat termit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez en quelques phrases ce que vous faites, vos produits et les termes fréquents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi in poche frasi di cosa vi occupate, i vostri prodotti e i termini ricorrenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事業内容、製品、よく出てくる用語を数文で書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하는 일, 제품, 자주 쓰는 용어를 몇 문장으로 적어 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf in een paar zinnen wat jullie doen, jullie producten en veelgebruikte termen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva em poucas frases o que vocês fazem, seus produtos e os termos mais usados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用几句话描述你们做什么、你们的产品和常用术语。"
          }
        }
      }
    },
    "Notlar bağlamını anlamak için bunu kullanır; yalnızca not ya da cevap yazılırken toplantı metniyle gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen nutzen dies, um deinen Kontext zu verstehen. Es wird nur mit dem Meetingtext gesendet, wenn eine Notiz oder Antwort geschrieben wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes use this to understand your context. It's sent with the meeting text only when a note or answer is written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas lo usan para entender tu contexto. Solo se envía con el texto de la reunión cuando se redacta una nota o una respuesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot käyttävät tätä ymmärtääkseen taustasi. Se lähetetään kokouksen tekstin mukana vain, kun muistiinpano tai vastaus kirjoitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes s'en servent pour comprendre votre contexte. Ces informations ne sont envoyées avec le texte de la réunion que lorsqu'une note ou une réponse est rédigée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note lo usano per capire il tuo contesto. Viene inviato con il testo della riunione solo quando si scrive una nota o una risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートはこれを使ってあなたの状況を理解します。ノートや回答を書くときにだけ、会議のテキストと一緒に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 이 정보로 내 상황을 이해합니다. 노트나 답변을 작성할 때만 회의 텍스트와 함께 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities gebruiken dit om je context te begrijpen. Het wordt alleen met de vergadertekst verstuurd als er een notitie of antwoord wordt geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas usam isso para entender seu contexto. Só é enviado com o texto da reunião quando uma nota ou resposta é escrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记会借此理解你的背景。仅在撰写笔记或回答时随会议文本一起发送。"
          }
        }
      }
    },
