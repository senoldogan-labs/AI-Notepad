    "Mac uykuya geçtiği için kayıt bitirildi; not hazırlanıyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde gestoppt, weil der Mac in den Ruhezustand gewechselt ist; die Notiz wird vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because the Mac went to sleep; the note is being prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se ha detenido porque el Mac entró en reposo; se está preparando la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus pysähtyi, koska Mac siirtyi nukkumaan; muistiinpanoa valmistellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté car le Mac s’est mis en veille ; la note est en cours de préparation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è fermata perché il Mac è andato in stop; la nota è in preparazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがスリープしたため録音を停止しました。ノートを準備しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기 상태가 되어 녹음이 중지되었습니다. 노트를 준비하는 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is gestopt omdat de Mac in de sluimerstand ging; de notitie wordt voorbereid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou porque o Mac entrou em repouso; a nota está sendo preparada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 Mac 进入睡眠，录制已停止；正在准备笔记。"
          }
        }
      }
    },
