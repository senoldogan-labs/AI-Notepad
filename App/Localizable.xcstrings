    "Yeni toplantılar için abone ol; toplantıların ve notların bu Mac'te kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe für neue Meetings ein Abo ab; deine Meetings und Notizen bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe for new meetings; your meetings and notes stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para tener reuniones nuevas; tus reuniones y notas se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa uusia kokouksia varten; kokouksesi ja muistiinpanosi säilyvät tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour de nouvelles réunions ; vos réunions et notes restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati per nuove riunioni; le riunioni e le note restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会議には登録が必要です。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 회의를 녹음하려면 구독하세요. 회의와 노트는 이 Mac에 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een abonnement voor nieuwe vergaderingen; je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine para novas reuniões; suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅即可录制新会议；你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
    "Yeni toplantılarda sana düşen işler buraya gelir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben aus neuen Meetings erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks from new meetings will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de las reuniones nuevas aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusien kokousten tehtävät näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches des nouvelles réunions apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività delle nuove riunioni appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会議のタスクはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 회의의 할 일이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken uit nieuwe vergaderingen verschijnen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas de novas reuniões vão aparecer aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会议中的任务会显示在这里。"
          }
        }
      }
    },
    "Yeni toplantıların notu bu türe göre yazılır; bir toplantının notunu sonradan başka şablonla yeniden yazabilirsin (⋯ menüsü).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen für neue Meetings werden für diese Art geschrieben; du kannst die Notiz eines Meetings später mit einer anderen Vorlage neu schreiben (Menü ⋯)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes for new meetings are written for this type; you can rewrite a meeting's note with another template later (⋯ menu)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de las reuniones nuevas se escriben para este tipo; más adelante puedes reescribir la nota de una reunión con otra plantilla (menú ⋯)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusien kokousten muistiinpanot kirjoitetaan tälle tyypille; voit myöhemmin kirjoittaa kokouksen muistiinpanon uudelleen toisella pohjalla (⋯-valikko)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes des nouvelles réunions sont rédigées pour ce type ; vous pourrez réécrire la note d’une réunion avec un autre modèle plus tard (menu ⋯)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note delle nuove riunioni vengono scritte per questo tipo; in seguito puoi riscrivere la nota di una riunione con un altro modello (menu ⋯)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会議のノートはこの種類に合わせて作成されます。あとから別のテンプレートで会議のノートを書き直すこともできます（⋯メニュー）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 회의의 노트는 이 유형으로 작성됩니다. 나중에 다른 템플릿으로 회의 노트를 다시 작성할 수 있습니다(⋯ 메뉴)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities voor nieuwe vergaderingen worden voor dit type geschreven; je kunt de notitie van een vergadering later herschrijven met een ander sjabloon (⋯-menu)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas de novas reuniões são escritas para este tipo; você pode reescrever a nota de uma reunião com outro modelo depois (menu ⋯)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会议的笔记会按此类型撰写；之后你可以用其他模板重写会议的笔记（⋯ 菜单）。"
          }
        }
      }
    },
