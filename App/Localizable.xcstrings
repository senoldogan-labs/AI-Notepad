    "Ekip yeni sürümün tarihini 14 Kasım olarak belirledi; tasarım incelemesi perşembe yapılacak ve geri bildirimler cuma toplanacak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Team hat das neue Release auf den 14. November gelegt; das Design-Review ist am Donnerstag, Feedback wird am Freitag gesammelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The team set the new release for 14 November; the design review is on Thursday and feedback is collected on Friday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo fijó la nueva versión para el 14 de noviembre; la revisión de diseño es el jueves y los comentarios se recogen el viernes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiimi sopi uuden julkaisun päiväksi 14. marraskuuta; suunnittelukatselmointi on torstaina ja palaute kerätään perjantaina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’équipe a fixé la nouvelle version au 14 novembre ; la revue du design a lieu jeudi et les retours sont recueillis vendredi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il team ha fissato la nuova release al 14 novembre; la revisione del design è giovedì e il feedback viene raccolto venerdì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームは新リリースを11月14日に決定しました。デザインレビューは木曜日、フィードバックの収集は金曜日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀은 새 릴리스를 11월 14일로 정했습니다. 디자인 검토는 목요일에 있고, 피드백은 금요일에 수집합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het team heeft de nieuwe release vastgesteld op 14 november; de ontwerpreview is op donderdag en feedback wordt op vrijdag verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A equipe marcou o novo lançamento para 14 de novembro; a revisão de design é na quinta e o feedback é coletado na sexta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队将新版本发布日期定为 11 月 14 日；设计评审在周四，反馈在周五收集。"
          }
        }
      }
    },
