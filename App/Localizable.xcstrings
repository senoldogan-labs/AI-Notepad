    "Kaydı kısayolla başlat; toplantı bitince notun ve görevlerin hazır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte die Aufnahme mit einem Kurzbefehl; wenn das Meeting endet, sind Notiz und Aufgaben bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording with a shortcut; when the meeting ends your note and tasks are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar con un atajo; cuando termine la reunión, tu nota y tus tareas estarán listas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita nauhoitus pikanäppäimellä; kun kokous päättyy, muistiinpanosi ja tehtäväsi ovat valmiina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez l’enregistrement avec un raccourci ; à la fin de la réunion, votre note et vos tâches sont prêtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la registrazione con un’abbreviazione; al termine della riunione nota e attività sono pronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットで録音を開始。会議が終わると、ノートとタスクが用意されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키로 녹음을 시작하세요. 회의가 끝나면 노트와 할 일이 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de opname met een toetscombinatie; als de vergadering eindigt, staan je notitie en taken klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a gravar com um atalho; quando a reunião terminar, sua nota e suas tarefas estarão prontas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用快捷键开始录制；会议结束时，你的笔记和任务就已准备好。"
          }
        }
      }
    },
