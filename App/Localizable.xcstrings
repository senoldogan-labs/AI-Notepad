    "%@ beklenmedik şekilde kapandı — raporu gönder?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde unerwartet beendet – Bericht senden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quit unexpectedly — send the report?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha cerrado inesperadamente. ¿Enviar el informe?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sulkeutui odottamatta — lähetetäänkö raportti?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a quitté de manière inattendue — envoyer le rapport ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è chiuso inaspettatamente: vuoi inviare il rapporto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が予期せず終了しました。レポートを送信しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 예기치 않게 종료되었습니다. 보고서를 보내겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is onverwacht gestopt — rapport versturen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi encerrado inesperadamente — enviar o relatório?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 意外退出——要发送报告吗？"
          }
        }
      }
    },
    "%@ beklenmeyen bir yanıt verdi.": {
