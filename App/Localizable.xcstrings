    "Bu iPhone'daki görüşmeyi kaydet (deneysel)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf auf diesem iPhone aufnehmen (experimentell)"
          }
        },
        "en": {
          "stringUnit": {
