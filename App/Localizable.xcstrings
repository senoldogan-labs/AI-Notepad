        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona più riunioni da eliminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の会議を選択して削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 회의 여러 개 선택"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer meerdere vergaderingen om te verwijderen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione várias reuniões para apagar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择多个会议以删除"
          }
        }
      }
    },
    "Birebir görüşme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelgespräch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-on-one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunión individual"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahdenkeskinen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tête-à-tête"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Faccia a faccia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1対1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일대일"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén-op-één"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um a um"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一对一"
          }
        }
      }
    },
    "Birkaç adımda hazırsın; her adım atlanabilir, hepsi sonra Ayarlar'dan değişir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Schritte, und du bist bereit; jeder Schritt kann übersprungen und später in den Einstellungen geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few steps and you're ready; every step can be skipped and changed later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos pocos pasos y listo; puedes omitir cualquier paso y cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama vaihe, ja olet valmis; jokaisen vaiheen voi ohittaa ja muuttaa myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques étapes et c’est prêt ; chaque étape peut être ignorée et modifiée plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi passaggi e sei pronto; ogni passaggio può essere saltato e modificato in seguito in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数ステップで準備完了です。どのステップもスキップでき、あとから設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 단계만 거치면 준비가 끝납니다. 모든 단계는 건너뛸 수 있으며 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar stappen en je bent klaar; elke stap kun je overslaan en later wijzigen in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns passos e pronto; todos podem ser pulados e alterados depois em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需几步即可准备就绪；每一步都可以跳过，之后也可在设置中更改。"
          }
        }
      }
    },
    "Biten toplantılar iCloud Drive'a taşınır ve Mac'teki AI-Notepad'de de görünür (Mac'te de açık olmalı). Kayıt ve işleme bu iPhone'da yapılır. Kapatınca iCloud'daki toplantıların bir kopyası bu iPhone'da kalır; Mac'tekiler etkilenmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Meetings werden in iCloud Drive verschoben und erscheinen auch in AI-Notepad auf deinem Mac (dort muss es ebenfalls aktiviert sein). Aufnahme und Verarbeitung erfolgen auf diesem iPhone. Beim Deaktivieren bleibt eine Kopie der iCloud-Meetings auf diesem iPhone; die des Mac sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished meetings move to iCloud Drive and also appear in AI-Notepad on your Mac (it must be on there too). Recording and processing happen on this iPhone. Turning it off keeps a copy of the iCloud meetings on this iPhone; the Mac's aren't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones terminadas se trasladan a iCloud Drive y también aparecen en AI-Notepad en tu Mac (también debe estar activado allí). La grabación y el procesamiento se hacen en este iPhone. Si lo desactivas, se conserva en este iPhone una copia de las reuniones de iCloud; las del Mac no se ven afectadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättyneet kokoukset siirtyvät iCloud Driveen ja näkyvät myös Macin AI-Notepadissa (sen täytyy olla päällä siellä myös). Nauhoitus ja käsittely tapahtuvat tässä iPhonessa. Kun tämä laitetaan pois päältä, iCloud-kokouksista jää kopio tähän iPhoneen; Macin kokouksiin se ei vaikuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions terminées sont déplacées vers iCloud Drive et apparaissent aussi dans AI-Notepad sur votre Mac (il doit y être activé aussi). L’enregistrement et le traitement ont lieu sur cet iPhone. Si vous désactivez l’option, une copie des réunions iCloud est conservée sur cet iPhone ; celles du Mac ne sont pas concernées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni concluse vengono spostate su iCloud Drive e appaiono anche in AI-Notepad sul Mac (deve essere attivo anche lì). Registrazione ed elaborazione avvengono su questo iPhone. Disattivandolo, su questo iPhone resta una copia delle riunioni su iCloud; quelle del Mac non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した会議はiCloud Driveに移動し、Mac上のAI-Notepadにも表示されます（Mac側でもオンにする必要があります）。録音と処理はこのiPhoneで行われます。オフにすると、iCloudの会議のコピーがこのiPhoneに残ります。Macの会議には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 회의는 iCloud Drive로 이동되며 Mac의 AI-Notepad에도 표시됩니다(Mac에서도 켜져 있어야 함). 녹음과 처리는 이 iPhone에서 이루어집니다. 끄면 iCloud 회의의 사본이 이 iPhone에 남으며 Mac의 회의에는 영향을 주지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgeronde vergaderingen gaan naar iCloud Drive en verschijnen ook in AI-Notepad op je Mac (daar moet het ook aanstaan). Opnemen en verwerken gebeurt op deze iPhone. Als je het uitzet, blijft er een kopie van de iCloud-vergaderingen op deze iPhone; die van de Mac blijven ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões concluídas vão para o iCloud Drive e também aparecem no AI-Notepad do seu Mac (ele também precisa estar ativado lá). A gravação e o processamento acontecem neste iPhone. Desativar mantém uma cópia das reuniões do iCloud neste iPhone; as do Mac não são afetadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束的会议会移到 iCloud 云盘，也会显示在你 Mac 上的 AI-Notepad 中（那里也必须打开此功能）。录制和处理都在这部 iPhone 上进行。关闭后，iCloud 中的会议会在这部 iPhone 上保留一份副本；Mac 上的会议不受影响。"
          }
        }
      }
    },
    "Biten toplantılar iCloud Drive'a taşınır ve iPhone'daki AI-Notepad'de de görünür; iPhone'da kaydedilenler buraya gelir. Kayıt ve işleme her zaman bu Mac'te yapılır. Kapatınca iCloud'daki toplantıların bir kopyası bu Mac'te kalır; iPhone'dakiler etkilenmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Meetings werden in iCloud Drive verschoben und erscheinen auch in AI-Notepad auf deinem iPhone; auf dem iPhone aufgenommene Meetings kommen hierher. Aufnahme und Verarbeitung erfolgen immer auf diesem Mac. Beim Deaktivieren bleibt eine Kopie der iCloud-Meetings auf diesem Mac; die des iPhone sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished meetings move to iCloud Drive and also appear in AI-Notepad on your iPhone; meetings recorded on the iPhone come here. Recording and processing always happen on this Mac. Turning it off keeps a copy of the iCloud meetings on this Mac; the iPhone's aren't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones terminadas se trasladan a iCloud Drive y también aparecen en AI-Notepad en tu iPhone; las reuniones grabadas en el iPhone llegan aquí. La grabación y el procesamiento siempre se hacen en este Mac. Si lo desactivas, se conserva en este Mac una copia de las reuniones de iCloud; las del iPhone no se ven afectadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättyneet kokoukset siirtyvät iCloud Driveen ja näkyvät myös iPhonen AI-Notepadissa; iPhonessa nauhoitetut kokoukset tulevat tänne. Nauhoitus ja käsittely tapahtuvat aina tässä Macissa. Kun tämä laitetaan pois päältä, iCloud-kokouksista jää kopio tähän Maciin; iPhonen kokouksiin se ei vaikuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions terminées sont déplacées vers iCloud Drive et apparaissent aussi dans AI-Notepad sur votre iPhone ; les réunions enregistrées sur l’iPhone arrivent ici. L’enregistrement et le traitement ont toujours lieu sur ce Mac. Si vous désactivez l’option, une copie des réunions iCloud est conservée sur ce Mac ; celles de l’iPhone ne sont pas concernées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni concluse vengono spostate su iCloud Drive e appaiono anche in AI-Notepad su iPhone; le riunioni registrate su iPhone arrivano qui. Registrazione ed elaborazione avvengono sempre su questo Mac. Disattivandolo, su questo Mac resta una copia delle riunioni su iCloud; quelle di iPhone non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した会議はiCloud Driveに移動し、iPhone上のAI-Notepadにも表示されます。iPhoneで録音した会議はここに表示されます。録音と処理は常にこのMacで行われます。オフにすると、iCloudの会議のコピーがこのMacに残ります。iPhoneの会議には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 회의는 iCloud Drive로 이동되며 iPhone의 AI-Notepad에도 표시됩니다. iPhone에서 녹음한 회의는 여기에 표시됩니다. 녹음과 처리는 항상 이 Mac에서 이루어집니다. 끄면 iCloud 회의의 사본이 이 Mac에 남으며 iPhone의 회의에는 영향을 주지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgeronde vergaderingen gaan naar iCloud Drive en verschijnen ook in AI-Notepad op je iPhone; vergaderingen die op de iPhone zijn opgenomen, komen hier. Opnemen en verwerken gebeurt altijd op deze Mac. Als je het uitzet, blijft er een kopie van de iCloud-vergaderingen op deze Mac; die van de iPhone blijven ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões concluídas vão para o iCloud Drive e também aparecem no AI-Notepad do seu iPhone; as reuniões gravadas no iPhone vêm para cá. A gravação e o processamento sempre acontecem neste Mac. Desativar mantém uma cópia das reuniões do iCloud neste Mac; as do iPhone não são afetadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束的会议会移到 iCloud 云盘，也会显示在你 iPhone 上的 AI-Notepad 中；在 iPhone 上录制的会议也会出现在这里。录制和处理始终在这台 Mac 上进行。关闭后，iCloud 中的会议会在这台 Mac 上保留一份副本；iPhone 上的会议不受影响。"
          }
        }
      }
    },
    "Bitince kayıt başlatılabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es fertig ist, kannst du mit der Aufnahme beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start recording when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás empezar a grabar cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit aloittaa nauhoituksen, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez commencer à enregistrer une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai iniziare a registrare al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了すると録音を開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되면 녹음을 시작할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt beginnen met opnemen als het klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode começar a gravar quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后即可开始录制。"
          }
        }
      }
    },
    "Bitince not: görevler, kararlar ve özet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende: Aufgaben, Entscheidungen und Zusammenfassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it ends: tasks, decisions and summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar: tareas, decisiones y resumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun se päättyy: tehtävät, päätökset ja yhteenveto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin : tâches, décisions et résumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine: attività, decisioni e riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると：タスク、決定事項、要約。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 끝나면: 할 일, 결정 사항 및 요약."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na afloop: taken, besluiten en samenvatting."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando terminar: tarefas, decisões e resumo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时：任务、决策和摘要。"
          }
        }
      }
    },
    "Bitince not: görevler, kararlar, özet ve sözlük.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
