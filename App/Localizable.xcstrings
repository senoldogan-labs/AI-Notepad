            "state": "translated",
            "value": "Prep my day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar mi día"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistele päiväni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparer ma journée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara la mia giornata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の準備"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 하루 준비"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid mijn dag voor"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar meu dia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划我的一天"
          }
        }
      }
    },
    "Bugünkü kullanım sınırına ulaştın; yarın yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das heutige Nutzungslimit erreicht; versuche es morgen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hit today's usage limit; try again tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de uso de hoy; inténtalo de nuevo mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saavutit tämän päivän käyttörajan; yritä huomenna uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite d’utilisation du jour ; réessayez demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di utilizzo di oggi; riprova domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の使用上限に達しました。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 사용 한도에 도달했습니다. 내일 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de gebruikslimiet van vandaag bereikt; probeer het morgen opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de uso de hoje; tente de novo amanhã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到今天的用量限额；请明天再试。"
          }
        }
      }
    },
    "Bugünkü yapay zekâ payın doldu (Sor, notu yeniden yazma…); yarın yeniden dene. Kayıt yapmaya devam edebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heutige KI-Kontingent ist aufgebraucht (Fragen, Notizen neu schreiben …); versuche es morgen erneut. Du kannst weiter aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's AI allowance is used up (Ask, rewriting notes…); try again tomorrow. You can keep recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado la asignación de IA de hoy (Preguntar, reescribir notas…); inténtalo de nuevo mañana. Puedes seguir grabando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän päivän tekoälykiintiö on käytetty (Kysy, muistiinpanojen uudelleenkirjoitus…); yritä huomenna uudelleen. Voit jatkaa nauhoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota d’IA du jour est épuisé (Demander, réécriture des notes…) ; réessayez demain. Vous pouvez continuer à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota AI di oggi è esaurita (Chiedi, riscrittura delle note…); riprova domani. Puoi continuare a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日のAI利用枠（質問、ノートの書き直しなど）を使い切りました。明日もう一度お試しください。録音は引き続き可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 AI 사용량(질문하기, 노트 다시 작성…)을 모두 사용했습니다. 내일 다시 시도하세요. 녹음은 계속할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-tegoed van vandaag is op (Vraag, notities herschrijven…); probeer het morgen opnieuw. Je kunt blijven opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota de IA de hoje acabou (Perguntar, reescrever notas…); tente de novo amanhã. Você pode continuar gravando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的 AI 额度已用完（提问、重写笔记…）；请明天再试。你仍可继续录制。"
          }
        }
      }
    },
