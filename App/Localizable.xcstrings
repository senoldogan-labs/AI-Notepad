    },
    "Mikrofon başka bir uygulamada açıldı. Toplantıyı kaydetmek için \"Kaydı başlat\"ı seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App hat das Mikrofon eingeschaltet. Wähle „Aufnahme starten“, um das Meeting aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app turned on the microphone. Choose \"Start recording\" to record the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app activó el micrófono. Elige «Iniciar grabación» para grabar la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen sovellus otti mikrofonin käyttöön. Nauhoita kokous valitsemalla ”Aloita nauhoitus”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app a activé le micro. Choisissez « Démarrer l’enregistrement » pour enregistrer la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app ha attivato il microfono. Scegli «Avvia registrazione» per registrare la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがマイクをオンにしました。会議を録音するには「録音を開始」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 마이크를 켰습니다. 회의를 녹음하려면 ‘녹음 시작’을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app heeft de microfoon aangezet. Kies ‘Start opname’ om de vergadering op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app ativou o microfone. Escolha “Iniciar gravação” para gravar a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个应用打开了麦克风。选择“开始录制”即可录制会议。"
          }
        }
      }
    },
    "Katıl ve kaydet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilnehmen & aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join & record"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirse y grabar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liity ja nauhoita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre et enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Partecipa e registra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加して録音"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참가하고 녹음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelnemen en opnemen"
          }
        },
        "pt-BR": {
