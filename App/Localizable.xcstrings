    "Yanıt uzunluk sınırına takılıp yarıda kesildi. İsteği kısaltıp ya da daha az toplantı seçip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort hat ihr Längenlimit erreicht und wurde abgeschnitten. Kürze die Anfrage oder wähle weniger Meetings und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer hit its length limit and was cut off. Shorten the request or pick fewer meetings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta alcanzó su límite de longitud y se cortó. Acorta la solicitud o elige menos reuniones e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaus saavutti pituusrajansa ja katkesi. Lyhennä pyyntöä tai valitse vähemmän kokouksia ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse a atteint sa limite de longueur et a été coupée. Raccourcissez la demande ou choisissez moins de réunions, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta ha raggiunto il limite di lunghezza ed è stata troncata. Accorcia la richiesta o scegli meno riunioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が長さの上限に達して途中で切れました。リクエストを短くするか、会議の数を減らして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 길이 제한에 도달하여 잘렸습니다. 요청을 줄이거나 회의를 더 적게 선택한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord bereikte de lengtelimiet en is afgebroken. Maak het verzoek korter of kies minder vergaderingen en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta atingiu o limite de tamanho e foi cortada. Encurte a solicitação ou escolha menos reuniões e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答达到长度上限而被截断。请缩短请求或选择更少的会议，然后重试。"
          }
        }
      }
    },
    "Yanıt verdi ama sağlıklı değil (HTTP %lld), %lld ms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwortet, aber nicht fehlerfrei (HTTP %lld), %lld ms"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Responded but not healthy (HTTP %lld), %lld ms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondió pero no está en buen estado (HTTP %lld), %lld ms"
          }
        },
        "fi": {
