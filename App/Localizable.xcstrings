            "value": "Tili"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
