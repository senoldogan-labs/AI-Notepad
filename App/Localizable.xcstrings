    "Toplantı işleniyor. Şimdi çıkarsan not hazırlanmaz; açılınca \"Tekrar işle\" gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meeting wird verarbeitet. Wenn du jetzt beendest, wird die Notiz nicht erstellt; beim nächsten Mal brauchst du „Neu verarbeiten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting is being processed. If you quit now the note won't be prepared; you'll need \"Reprocess\" next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está procesando una reunión. Si sales ahora, la nota no se preparará; la próxima vez tendrás que usar “Reprocesar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokousta käsitellään. Jos lopetat nyt, muistiinpanoa ei valmistella; tarvitset seuraavalla kerralla valinnan ”Käsittele uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réunion est en cours de traitement. Si vous quittez maintenant, la note ne sera pas préparée ; il faudra utiliser « Retraiter » la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in elaborazione una riunione. Se esci ora la nota non verrà preparata; la prossima volta dovrai usare “Rielabora”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議を処理中です。今終了するとノートは作成されず、次回「再処理」が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 처리하는 중입니다. 지금 종료하면 노트가 준비되지 않으며, 다음에 \"다시 처리\"를 해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een vergadering verwerkt. Als je nu stopt, wordt de notitie niet gemaakt; je hebt dan de volgende keer \"Opnieuw verwerken\" nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma reunião está sendo processada. Se você sair agora, a nota não será preparada; você vai precisar usar \"Reprocessar\" da próxima vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理会议。如果现在退出，将不会准备笔记；下次需要使用“重新处理”。"
          }
        }
      }
    },
    "Toplantı işleniyor; bitince kaydedebilirsin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Meeting wird verarbeitet; du kannst sichern, sobald es fertig ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting is being processed; you can save once it finishes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
