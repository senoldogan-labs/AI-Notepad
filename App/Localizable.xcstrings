    "Giriş penceresinde devam et. Vazgeçersen pencereyi kapatman yeter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre im Anmeldefenster fort. Zum Abbrechen schließe es einfach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue in the sign-in window. To cancel, just close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa en la ventana de inicio de sesión. Para cancelar, simplemente ciérrala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka kirjautumisikkunassa. Peru sulkemalla se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez dans la fenêtre de connexion. Pour annuler, fermez-la simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua nella finestra di accesso. Per annullare, chiudila e basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインウインドウで続けてください。キャンセルするには、ウインドウを閉じるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 윈도우에서 계속하세요. 취소하려면 윈도우를 닫기만 하면 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder in het inlogvenster. Sluit het gewoon om te annuleren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue na janela de início de sessão. Para cancelar, basta fechá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在登录窗口中继续。要取消，直接关闭窗口即可。"
          }
        }
      }
    },
    "Giriş sayfasında devam et. Vazgeçersen sayfayı kapatman yeter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre auf der Anmeldeseite fort. Zum Abbrechen schließe die Seite einfach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue on the sign-in page. To cancel, just close the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa en la página de inicio de sesión. Para cancelar, simplemente cierra la página."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka kirjautumissivulla. Peru sulkemalla sivu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez sur la page de connexion. Pour annuler, fermez simplement la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua nella pagina di accesso. Per annullare, chiudi la pagina e basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインページで続けてください。キャンセルするには、ページを閉じるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 페이지에서 계속하세요. 취소하려면 페이지를 닫기만 하면 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder op de inlogpagina. Sluit de pagina gewoon om te annuleren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue na página de início de sessão. Para cancelar, basta fechar a página."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在登录页面中继续。要取消，直接关闭页面即可。"
          }
        }
      }
    },
