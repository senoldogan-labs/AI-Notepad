    "Abone olunca her toplantının notu böyle kendiliğinden hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Abo bekommt jedes Meeting automatisch eine Notiz wie diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe and every meeting gets a note like this, automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete y cada reunión tendrá una nota como esta, automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa, niin jokainen kokous saa automaattisesti tällaisen muistiinpanon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous et chaque réunion aura automatiquement une note comme celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati e ogni riunione avrà automaticamente una nota come questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録すると、すべての会議にこのようなノートが自動で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하면 모든 회의에 이런 노트가 자동으로 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een abonnement en elke vergadering krijgt automatisch zo'n notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine e cada reunião ganha uma nota como esta, automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅后，每个会议都会自动获得这样的笔记。"
          }
        }
      }
    },
