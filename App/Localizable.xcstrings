        }
      }
    },
    "Ses kalıcı olarak silinsin mi? Metin ve not kalır; geri alınamaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio endgültig löschen? Transkript und Notiz bleiben erhalten; das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the audio permanently? The transcript and note stay; this can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el audio de forma permanente? La transcripción y la nota se conservan; esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko ääni pysyvästi? Litterointi ja muistiinpano säilyvät; tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement l’audio ? La transcription et la note sont conservées ; cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente l’audio? Trascrizione e nota restano; l’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を完全に削除しますか？ 文字起こしとノートは残ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 영구적으로 삭제하시겠습니까? 녹취록과 노트는 남으며, 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio permanent verwijderen? Het transcript en de notitie blijven; dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o áudio permanentemente? A transcrição e a nota continuam; isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要永久删除音频吗？文字稿和笔记会保留；此操作无法撤销。"
