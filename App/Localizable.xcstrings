    "Giriş penceresi açılamadı. Uygulamayı öne getirip Apple ya da Google ile yeniden devam et.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldefenster konnte nicht geöffnet werden. Bring die App in den Vordergrund und fahre erneut mit Apple oder Google fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window couldn't open. Bring the app to the front and continue with Apple or Google again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir la ventana de inicio de sesión. Pon la app en primer plano y vuelve a continuar con Apple o Google."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumisikkunaa ei voitu avata. Tuo sovellus etualalle ja jatka uudelleen Applella tai Googlella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre de connexion n’a pas pu s’ouvrir. Mettez l’app au premier plan et continuez à nouveau avec Apple ou Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la finestra di accesso. Porta l’app in primo piano e continua di nuovo con Apple o Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインウインドウを開けませんでした。アプリを前面に出して、もう一度AppleまたはGoogleで続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 창을 열 수 없습니다. 앱을 앞으로 가져온 후 Apple 또는 Google로 다시 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het inlogvenster kon niet openen. Zet de app op de voorgrond en ga opnieuw door met Apple of Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a janela de início de sessão. Traga o app para a frente e continue com Apple ou Google de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开登录窗口。请将 App 置于前台，然后再次通过 Apple 或 Google 继续。"
          }
        }
      }
    },
    "Bu giriş uygulamadan başlatılmamış ya da zaten kullanılmış. Apple ya da Google ile yeniden devam et.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldung wurde nicht aus der App gestartet oder wurde bereits verwendet. Fahre erneut mit Apple oder Google fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in wasn't started from the app or was already used. Continue with Apple or Google again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inicio de sesión no se inició desde la app o ya se ha usado. Vuelve a continuar con Apple o Google."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
