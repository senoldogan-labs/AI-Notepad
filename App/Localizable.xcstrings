    "%@ girişinin dönüşü başka bir denemeye ait; Ayarlar › Bağlantılar'dan yeniden bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %@ stammt von einem anderen Versuch; verbinde dich erneut unter „Einstellungen“ › „Verbindungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ sign-in returned from a different attempt; connect again from Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de %@ ha vuelto de otro intento; vuelve a conectarte desde Ajustes › Conexiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kirjautuminen palasi eri yrityksestä; yhdistä uudelleen kohdassa Asetukset › Yhteydet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ provient d’une autre tentative ; reconnectez-vous depuis Réglages › Connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a %@ è tornato da un tentativo diverso; connettiti di nuovo da Impostazioni › Connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のサインインが別の試行から戻りました。「設定」›「連携」からもう一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 로그인이 다른 시도에서 돌아왔습니다. 설정 › 연결에서 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding bij %@ kwam van een andere poging terug; koppel opnieuw via Instellingen › Koppelingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão em %@ voltou de outra tentativa; conecte de novo em Ajustes › Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 登录返回自另一次尝试；请从“设置 › 连接”重新连接。"
          }
        }
      }
    },
    "%@ hesabında yazabileceğin bir kanal bulunamadı. Önce bir kanala katıl, sonra yeniden bağlan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem %@-Account wurde kein Kanal gefunden, in dem du posten kannst. Tritt zuerst einem Kanal bei und verbinde dich dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No channel you can post to was found in your %@ account. Join a channel first, then connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún canal en el que puedas publicar en tu cuenta de %@. Únete primero a un canal y vuelve a conectarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-tililtäsi ei löytynyt kanavaa, jolle voit lähettää. Liity ensin kanavalle ja yhdistä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun canal dans lequel vous pouvez publier n’a été trouvé dans votre compte %@. Rejoignez d’abord un canal, puis reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo account %@ non è stato trovato nessun canale in cui puoi pubblicare. Unisciti prima a un canale, poi connettiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@アカウントに投稿可能なチャンネルが見つかりませんでした。先にチャンネルに参加してから、もう一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 계정에서 게시할 수 있는 채널을 찾지 못했습니다. 먼저 채널에 참여한 다음 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen kanaal gevonden in je %@-account waarin je kunt posten. Word eerst lid van een kanaal en koppel dan opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum canal em que você possa publicar foi encontrado na sua conta de %@. Entre em um canal primeiro e conecte de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 %@ 账户中未找到可发布消息的频道。请先加入一个频道，然后重新连接。"
          }
        }
      }
    },
    "%@ ile %@ aynı kişi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@ sind dieselbe Person"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ are the same person"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ son la misma persona"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ja %@ ovat sama henkilö"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %@ sont la même personne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@ sono la stessa persona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と%@は同一人物"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와(과) %@은(는) 같은 사람입니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ zijn dezelfde persoon"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@ são a mesma pessoa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和 %@ 是同一个人"
          }
        }
      }
    },
    "%@ isteği kabul etmedi. Yeniden dene; sürerse bağlantıyı kaldırıp yeniden bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Anfrage nicht akzeptiert. Versuche es erneut; falls das weiterhin passiert, entferne die Verbindung und verbinde dich neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the request. Try again; if it keeps happening, remove the connection and connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha aceptado la solicitud. Inténtalo de nuevo; si sigue ocurriendo, elimina la conexión y vuelve a conectarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei hyväksynyt pyyntöä. Yritä uudelleen; jos ongelma toistuu, poista yhteys ja yhdistä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté la requête. Réessayez ; si le problème persiste, supprimez la connexion et reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha accettato la richiesta. Riprova; se continua a succedere, rimuovi la connessione e connettiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がリクエストを受け付けませんでした。もう一度お試しください。繰り返し発生する場合は、連携を削除して再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 요청을 허용하지 않았습니다. 다시 시도하세요. 계속 발생하면 연결을 제거하고 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft het verzoek niet geaccepteerd. Probeer het opnieuw; blijft het gebeuren, verwijder dan de koppeling en koppel opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceitou a solicitação. Tente de novo; se continuar acontecendo, remova a conexão e conecte de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受该请求。请重试；如果问题持续，请移除连接后重新连接。"
          }
        }
      }
    },
    "%@ içe aktarılamadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht importiert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't import %@: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido importar %@: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
