        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のアカウントの会議を処理中です。完了すると、このアカウントの会議が自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 계정의 회의를 처리하는 중입니다. 완료되면 이 계정의 회의가 자동으로 열립니다."
          }
