    "Mac'te ve iPhone'da aynı hesapla giriş yaptığın her yerde tam erişimin var.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast vollen Zugriff überall, wo du dich mit diesem Account anmeldest, auf Mac und iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have full access wherever you sign in with this account, on Mac and iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes acceso total en cualquier lugar donde inicies sesión con esta cuenta, en Mac y iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on täysi käyttöoikeus kaikkialla, missä kirjaudut tällä tilillä, Macissa ja iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous bénéficiez d’un accès complet partout où vous vous connectez avec ce compte, sur Mac et iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai accesso completo ovunque accedi con questo account, su Mac e iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでサインインすれば、MacでもiPhoneでもフルアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 iPhone에서 이 계정으로 로그인하면 어디서든 모든 기능을 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt volledige toegang overal waar je met dit account inlogt, op Mac en iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem acesso total onde iniciar sessão com esta conta, no Mac e no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要使用此账户登录，无论在 Mac 还是 iPhone 上，你都享有完全访问权限。"
          }
        }
      }
    },
    "Aboneliği yönet": {
