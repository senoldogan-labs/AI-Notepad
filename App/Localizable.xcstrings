    "İzin verilmedi; %@'e dönüp yeniden deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff wurde nicht erteilt; kehre zu %@ zurück, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access wasn't granted; go back to %@ to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido el acceso; vuelve a %@ para intentarlo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöoikeutta ei myönnetty; palaa sovellukseen %@ ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès n’a pas été accordé ; revenez à %@ pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso non è stato concesso; torna a %@ per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが許可されませんでした。%@に戻って、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한이 부여되지 않았습니다. 다시 시도하려면 %@(으)로 돌아가세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen toegang verleend; ga terug naar %@ om het opnieuw te proberen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso não foi concedido; volte para %@ para tentar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予访问权限；请返回 %@ 重试。"
          }
        }
      }
    },
