    "Yenileme ödemesi alınamadı ve ek süre bitti. Toplantıların ve notların bu Mac'te; yeni kayıt için kartını güncelle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verlängerungszahlung ist fehlgeschlagen und die Kulanzzeit ist abgelaufen. Deine Meetings und Notizen sind auf diesem Mac; aktualisiere deine Karte, um wieder aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The renewal payment failed and the grace period is over. Your meetings and notes are on this Mac; update your card to record again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago de la renovación no se ha podido realizar y el periodo de gracia ha terminado. Tus reuniones y notas están en este Mac; actualiza tu tarjeta para volver a grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusimismaksu epäonnistui, ja lisäaika on päättynyt. Kokouksesi ja muistiinpanosi ovat tässä Macissa; päivitä korttisi, niin voit taas nauhoittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement du renouvellement a échoué et la période de grâce est terminée. Vos réunions et notes sont sur ce Mac ; mettez à jour votre carte pour enregistrer de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento del rinnovo non è riuscito e il periodo di tolleranza è scaduto. Le riunioni e le note sono su questo Mac; aggiorna la carta per registrare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の支払いに失敗し、猶予期間が終了しました。会議とノートはこのMacにあります。再び録音するにはカード情報を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 결제가 실패했고 유예 기간이 종료되었습니다. 회의와 노트는 이 Mac에 있습니다. 다시 녹음하려면 카드를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verlengingsbetaling is mislukt en de respijtperiode is voorbij. Je vergaderingen en notities staan op deze Mac; werk je kaart bij om weer op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento da renovação falhou e o período de carência terminou. Suas reuniões e notas estão neste Mac; atualize seu cartão para gravar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续订付款失败，且宽限期已结束。你的会议和笔记在这台 Mac 上；更新银行卡即可再次录制。"
          }
        }
      }
    },
    "Okunamayanları sil": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlesbare löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Unreadable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar ilegibles"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista lukukelvottomat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les illisibles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina illeggibili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れないものを削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 항목 삭제"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder onleesbare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar ilegíveis"
          }
        },
        "zh-Hans": {
