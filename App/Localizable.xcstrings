            "value": "The pill at the bottom of the screen shows when it's listening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kapsel unten am Bildschirm zeigt, dass zugehört wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pastille en bas de l'écran indique l'écoute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La píldora en la parte inferior de la pantalla indica que está escuchando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pillola in fondo allo schermo indica che è in ascolto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pílula na parte inferior da tela mostra que está ouvindo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het pilletje onder aan het scherm laat zien dat er geluisterd wordt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
