    "Mikrofondan ses gelmiyor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ton vom Mikrofon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sound from the microphone"
          }
        },
        "es": {
          "stringUnit": {
