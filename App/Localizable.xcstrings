    "Bu hesabın ücretsiz erişimi var; abonelik gerekmiyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account hat kostenlosen Zugriff; es ist kein Abo nötig."
          }
        },
        "en": {
