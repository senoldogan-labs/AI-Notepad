          "stringUnit": {
            "state": "translated",
            "value": "URL de webhook non valide : collez l’adresse complète commençant par https://."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL webhook non valido: incolla l’indirizzo completo che inizia con https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なwebhook URLです：https://で始まる完全なアドレスをペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 Webhook URL입니다. https://로 시작하는 전체 주소를 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldige webhook-URL: plak het volledige adres dat begint met https://."
          }
        },
        "pt-BR": {
