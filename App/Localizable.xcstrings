    "Bu kararlara nasıl varıldı?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie kam es zu diesen Entscheidungen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How were these decisions reached?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se llegó a estas decisiones?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten näihin päätöksiin päädyttiin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ces décisions ont-elles été prises ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si è arrivati a queste decisioni?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの決定はどう決まった？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결정들은 어떻게 내려졌나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe zijn deze besluiten tot stand gekomen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como se chegou a essas decisões?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些决定是如何得出的？"
          }
        }
      }
    },
    "Açık kalan konuları kim takip edecek?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
