    "Önceki cevaplar bağlam olmaz; bu sohbet geçmişte kalır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Antworten werden nicht als Kontext verwendet; dieser Chat bleibt im Verlauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier answers won't be used as context; this chat stays in history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas anteriores no se usarán como contexto; este chat se queda en el historial"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiempia vastauksia ei käytetä kontekstina; tämä keskustelu pysyy historiassa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses précédentes ne seront pas utilisées comme contexte ; cette conversation reste dans l’historique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte precedenti non verranno usate come contesto; questa chat resta nella cronologia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の回答はコンテキストとして使われません。このチャットは履歴に残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 답변은 맥락으로 사용되지 않습니다. 이 대화는 기록에 남습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere antwoorden worden niet als context gebruikt; deze chat blijft in de geschiedenis"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas anteriores não serão usadas como contexto; esta conversa fica no histórico"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的回答不会用作上下文；此对话会保留在历史记录中"
          }
        }
      }
    },
