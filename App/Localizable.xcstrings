          }
        }
      }
    },
    "Bitince toplantının sayfası açılır; görevlerin en üstte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende öffnet sich die Meeting-Seite mit deinen Aufgaben oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When done, the meeting page opens with your tasks at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar, se abre la página de la reunión con tus tareas arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun valmista, kokoussivu avautuu tehtäväsi ylimpänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois terminé, la page de la réunion s’ouvre avec vos tâches en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine si apre la pagina della riunione con le tue attività in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了すると、あなたのタスクが上部に表示された会議ページが開きます。"
