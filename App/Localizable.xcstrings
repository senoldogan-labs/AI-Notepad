    "Son geçiş başarısız: %@ Not canlı metinden yazıldı; \"Tekrar işle\" ile yeniden deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschließender Durchgang fehlgeschlagen: %@ Die Notiz wurde aus dem Live-Text geschrieben; du kannst es mit „Neu verarbeiten“ erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final pass failed: %@ The note was written from the live text; you can try again with \"Reprocess\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en el repaso final: %@ La nota se ha escrito a partir del texto en directo; puedes volver a intentarlo con “Reprocesar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeistely epäonnistui: %@ Muistiinpano kirjoitettiin reaaliaikaisesta tekstistä; voit yrittää uudelleen valinnalla ”Käsittele uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la passe finale : %@ La note a été rédigée à partir du texte en direct ; vous pouvez réessayer avec « Retraiter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggio finale non riuscito: %@ La nota è stata scritta dal testo dal vivo; puoi riprovare con “Rielabora”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終処理に失敗しました：%@ ノートはライブ文字起こしから作成されました。「再処理」でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 처리 실패: %@ 실시간 텍스트로 노트를 작성했습니다. \"다시 처리\"로 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste ronde mislukt: %@ De notitie is op basis van de live tekst geschreven; je kunt het opnieuw proberen met \"Opnieuw verwerken\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A passada final falhou: %@ A nota foi escrita a partir do texto ao vivo; você pode tentar de novo com \"Reprocessar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终处理失败：%@ 笔记是根据实时文字撰写的；你可以用“重新处理”再试一次。"
          }
        }
      }
    },
