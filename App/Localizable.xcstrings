    "Örnek: \"Riskleri ayrı bir paragrafta say, her kararın gerekçesini yaz.\"": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: „Liste Risiken in einem eigenen Absatz auf und begründe jede Entscheidung.“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: \"List risks in a separate paragraph and give the reason for each decision.\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: “Enumera los riesgos en un párrafo aparte y da el motivo de cada decisión”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkki: ”Listaa riskit omana kappaleenaan ja perustele jokainen päätös.”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : « Liste les risques dans un paragraphe séparé et donne la raison de chaque décision. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: “Elenca i rischi in un paragrafo a parte e indica il motivo di ogni decisione.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「リスクを別の段落に分け、各決定事項の理由を示してください。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: \"위험 요소를 별도 단락으로 나열하고 각 결정 사항의 이유를 제시하세요.\""
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld: \"Zet risico's in een aparte alinea en geef bij elk besluit de reden.\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo: \"Liste os riscos em um parágrafo separado e dê o motivo de cada decisão.\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：“将风险单独列为一段，并给出每项决策的理由。”"
          }
        }
      }
    },
