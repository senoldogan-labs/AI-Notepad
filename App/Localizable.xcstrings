    },
    "Bu bağlantı artık yok (kaldırılmış); Ayarlar › Bağlantılar'ı yeniden aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung existiert nicht mehr (entfernt); öffne „Einstellungen“ › „Verbindungen“ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection no longer exists (removed); reopen Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión ya no existe (se ha eliminado); vuelve a abrir Ajustes › Conexiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä yhteyttä ei enää ole (poistettu); avaa Asetukset › Yhteydet uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n’existe plus (supprimée) ; rouvrez Réglages › Connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione non esiste più (rimossa); riapri Impostazioni › Connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連携は存在しません（削除済み）。「設定」›「連携」を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결은 더 이상 존재하지 않습니다(제거됨). 설정 › 연결을 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppeling bestaat niet meer (verwijderd); open Instellingen › Koppelingen opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão não existe mais (foi removida); reabra Ajustes › Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接已不存在（已移除）；请重新打开“设置 › 连接”。"
          }
        }
      }
    },
    "Bu bağlantıda kanal seçilmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung hat keinen Kanal zur Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection has no channel to choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no tiene ningún canal que elegir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä yhteydellä ei ole valittavaa kanavaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n’a aucun canal à choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione non ha nessun canale da scegliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連携には選択できるチャンネルがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에는 선택할 채널이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppeling heeft geen kanaal om te kiezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão não tem canal para escolher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接没有可选择的频道。"
          }
        }
      }
    },
    "Bu bir deneme mesajıdır: toplantı notların buraya böyle gelecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Testnachricht: Deine Meeting-Notizen kommen so hier an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a test message: your meeting notes will arrive here like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es un mensaje de prueba: tus notas de reunión llegarán aquí así."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on testiviesti: kokousmuistiinpanosi saapuvat tänne tällaisina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un message de test : vos notes de réunion arriveront ici de cette façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un messaggio di prova: le note delle tue riunioni arriveranno qui così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはテストメッセージです：会議ノートはこのようにここに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 메시지입니다: 회의 노트가 이렇게 여기에 도착합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een testbericht: je vergadernotities komen hier zo binnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma mensagem de teste: suas notas de reunião chegarão aqui assim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一条测试消息：你的会议笔记会像这样发送到这里。"
          }
        }
      }
    },
    "Bu bölüm cihaz içi konuşma tanımayla yazıya dökülemedi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Teil konnte mit der Spracherkennung auf dem Gerät nicht transkribiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part couldn't be transcribed with on-device speech recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte no se ha podido transcribir con el reconocimiento de voz en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä osaa ei voitu litteroida laitteella toimivalla puheentunnistuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie n’a pas pu être transcrite avec la reconnaissance vocale sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere questa parte con il riconoscimento vocale sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この部分はオンデバイス音声認識で文字起こしできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 부분은 온디바이스 음성 인식으로 텍스트로 변환할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit deel kon niet met spraakherkenning op het apparaat worden uitgeschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte não pôde ser transcrita com o reconhecimento de fala no dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用设备端语音识别转写此部分。"
          }
        }
      }
    },
    "Bu bölüm yazıya dökülemedi.": {
