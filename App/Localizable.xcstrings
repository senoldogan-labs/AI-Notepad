    "%@ bağlantısı bu cihazdan kaldırıldı ama %@ tarafında kapatılamadı (%@). %@'in erişimini %@ ayarlarından kaldır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ wurde von diesem Gerät entfernt, konnte aber auf Seiten von %@ nicht geschlossen werden (%@). Entferne den Zugriff von %@ in deinen Einstellungen bei %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ connection was removed from this device, but it couldn't be closed on the %@ side (%@). Remove %@'s access in your %@ settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de %@ se ha eliminado de este dispositivo, pero no se ha podido cerrar en %@ (%@). Retira el acceso de %@ en los ajustes de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-yhteys poistettiin tältä laitteelta, mutta sitä ei voitu sulkea palvelun %@ puolella (%@). Poista sovelluksen %@ käyttöoikeus %@-tilisi asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion %@ a été supprimée de cet appareil, mais elle n’a pas pu être fermée du côté de %@ (%@). Retirez l’accès de %@ dans vos réglages %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione a %@ è stata rimossa da questo dispositivo, ma non è stato possibile chiuderla dal lato di %@ (%@). Rimuovi l’accesso di %@ nelle impostazioni di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の連携はこのデバイスから削除されましたが、%2$@側で解除できませんでした（%3$@）。%5$@の設定で%4$@のアクセス権を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 %1$@ 연결을 제거했지만 %2$@ 측에서 종료하지 못했습니다(%3$@). %5$@ 설정에서 %4$@의 접근 권한을 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %@-koppeling is van dit apparaat verwijderd, maar kon aan de kant van %@ niet worden afgesloten (%@). Trek de toegang van %@ in via je %@-instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com %@ foi removida deste dispositivo, mas não pôde ser encerrada do lado de %@ (%@). Remova o acesso de %@ nos ajustes de %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从此设备移除 %1$@ 连接，但无法在 %2$@ 端关闭该连接（%3$@）。请在你的 %5$@ 设置中移除 %4$@ 的访问权限。"
          }
        }
      }
    },
    "%@ bağlantısında iş açan araç bulunamadı; sunucunun araçları değişmiş olabilir. Uygulamayı güncelle ya da yeniden bağlan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bietet kein Werkzeug zum Erstellen von Issues; die Werkzeuge haben sich eventuell geändert. Aktualisiere die App oder verbinde neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ offers no tool for creating issues; its tools may have changed. Update the app or reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ofrece ninguna herramienta para crear incidencias; puede que sus herramientas hayan cambiado. Actualiza la app o vuelve a conectarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei tarjoa työkalua tikettien luomiseen; sen työkalut ovat ehkä muuttuneet. Päivitä sovellus tai yhdistä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne propose aucun outil pour créer des tickets ; ses outils ont peut-être changé. Mettez à jour l’app ou reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non offre alcuno strumento per creare issue; i suoi strumenti potrebbero essere cambiati. Aggiorna l’app o riconnettiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に課題を作成するツールがありません。ツールが変更された可能性があります。アプリをアップデートするか、再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이슈 생성 도구가 없습니다. 도구가 변경되었을 수 있습니다. 앱을 업데이트하거나 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ biedt geen tool om issues aan te maken; de tools zijn misschien veranderd. Werk de app bij of koppel opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não oferece nenhuma ferramenta para criar issues; as ferramentas podem ter mudado. Atualize o app ou conecte de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供创建问题的工具；其工具可能已更改。请更新 App 或重新连接。"
          }
        }
      }
    },
