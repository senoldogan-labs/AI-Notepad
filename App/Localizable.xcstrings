            "state": "translated",
            "value": "全部收起"
          }
        }
      }
    },
    "Uygulama kapalıyken not hazırlanınca; toplantıyı açar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Notizen fertig sind, während die App geschlossen ist; öffnet das Meeting."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When notes are ready while the app is closed; opens the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando las notas están listas con la app cerrada; abre la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistiinpanot valmistuvat sovelluksen ollessa kiinni; avaa kokouksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les notes sont prêtes et que l’app est fermée ; ouvre la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando le note sono pronte ad app chiusa; apre la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じている間にノートができたとき。会議を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫혀 있을 때 노트가 준비되면. 회의를 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als notities klaar zijn terwijl de app dicht is; opent de vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as notas ficam prontas com o app fechado; abre a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用关闭时笔记就绪即通知；点按打开会议。"
          }
        }
      }
    },
