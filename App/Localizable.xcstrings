    "Konuşulanlardan bir proje planı taslağı çıkar: hedef, kapsam, aşamalar ve tarihleri, sorumlular, riskler ve açık sorular.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwirf aus dem Besprochenen einen Projektplan: Ziel, Umfang, Phasen und Termine, Verantwortliche, Risiken und offene Fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft a project plan from what was discussed: goal, scope, phases and dates, owners, risks and open questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta un plan de proyecto a partir de lo que se trató: objetivo, alcance, fases y fechas, responsables, riesgos y preguntas abiertas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadi projektisuunnitelma keskustellun pohjalta: tavoite, laajuus, vaiheet ja päivämäärät, vastuuhenkilöt, riskit ja avoimet kysymykset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige un plan de projet à partir de ce qui a été discuté : objectif, périmètre, phases et dates, responsables, risques et questions ouvertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una bozza di piano di progetto da ciò che è stato discusso: obiettivo, ambito, fasi e date, responsabili, rischi e domande aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話し合われた内容からプロジェクト計画の下書きを作成してください：目標、範囲、フェーズと日程、担当者、リスク、未解決の課題。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "논의된 내용을 바탕으로 프로젝트 계획 초안 작성: 목표, 범위, 단계와 일정, 담당자, 위험 요소, 미결 질문."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een projectplan op op basis van wat er besproken is: doel, scope, fasen en datums, eigenaren, risico's en open vragen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunhe um plano de projeto com base no que foi discutido: objetivo, escopo, fases e datas, responsáveis, riscos e questões em aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据讨论内容起草一份项目计划：目标、范围、阶段和日期、负责人、风险和未决问题。"
          }
        }
      }
    },
