    "Çökme raporu okunamadı (metin değil); raporu silip yenisini bekle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Absturzbericht konnte nicht gelesen werden (kein Text); lösche ihn und warte auf einen neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crash report couldn't be read (not text); delete it and wait for a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el informe de fallo (no es texto); elimínalo y espera a que llegue uno nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaatumisraporttia ei voitu lukea (ei tekstiä); poista se ja odota uutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport de plantage n’a pas pu être lu (ce n’est pas du texte) ; supprimez-le et attendez-en un nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il rapporto di arresto anomalo (non è testo); eliminalo e attendine uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュレポートを読み取れませんでした（テキストではありません）。削除して、新しいレポートを待ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌 보고서를 읽을 수 없습니다(텍스트가 아님). 삭제하고 새 보고서를 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het crashrapport kon niet worden gelezen (geen tekst); verwijder het en wacht op een nieuw rapport."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o relatório de falha (não é texto); apague-o e aguarde um novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取崩溃报告（不是文本）；请将其删除并等待新的报告。"
          }
        }
      }
    },
