      }
    },
    "Yer az: yaklaşık %lld dk kayıt sığar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Speicher: Platz für etwa %lld Min. Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low storage: room for about %lld min of recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco almacenamiento: caben unos %lld min de grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tila vähissä: tilaa noin %lld min tallennukselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage faible : environ %lld min d’enregistrement possibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio ridotto: circa %lld min di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量わずか：約%lld分録音できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 부족: 약 %lld분 녹음할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig opslag: ruimte voor ongeveer %lld min opname."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco armazenamento: cabem cerca de %lld min de gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间不足：约可录制 %lld 分钟。"
          }
        }
      }
    },
    "Kayıt için yer yok; iPhone'da yer aç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Speicher für eine Aufnahme; gib auf dem iPhone Speicher frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No storage for a recording; free up space on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay almacenamiento para grabar; libera espacio en tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennukselle ei ole tilaa; vapauta tilaa iPhonesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de stockage pour un enregistrement ; libère de l’espace sur ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente per registrare; libera spazio sull’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音する空き容量がありません。iPhoneの空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 저장 공간이 없습니다. iPhone의 공간을 확보하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen opslag voor een opname; maak ruimte vrij op je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem armazenamento para gravar; libere espaço no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用于录制的存储空间；请在 iPhone 上释放空间。"
          }
        }
      }
    },
    "Bu ayın web araması hakkı doldu; cevap yalnız toplantılardan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Websuchen für diesen Monat sind aufgebraucht; diese Antwort stammt nur aus deinen Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's web searches are used up; this answer comes from your meetings only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado las búsquedas web de este mes; esta respuesta solo usa tus reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun verkkohaut on käytetty; vastaus perustuu vain kokouksiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches web de ce mois-ci sont épuisées ; cette réponse provient uniquement de vos réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricerche web di questo mese sono esaurite; questa risposta si basa solo sulle tue riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のウェブ検索の上限に達しました。この回答は会議の内容のみに基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 웹 검색 횟수를 모두 사용했습니다. 이 답변은 회의 내용만 바탕으로 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De webzoekopdrachten van deze maand zijn op; dit antwoord komt alleen uit je vergaderingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pesquisas na web deste mês acabaram; esta resposta vem só das suas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的网页搜索次数已用完；此回答仅基于你的会议。"
          }
        }
      }
    },
