    "Canlı metnin sonu beklenmeden kayıt kapatıldı; kaydın tamamı yine yazıya dökülür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde geschlossen, ohne auf das Ende des Live-Transkripts zu warten; die gesamte Aufnahme wird trotzdem transkribiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was closed without waiting for the end of the live transcript; the full recording will still be transcribed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se cerró sin esperar al final de la transcripción en directo; aun así, se transcribirá la grabación completa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus suljettiin odottamatta reaaliaikaisen litteroinnin loppua; koko nauhoite litteroidaan silti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a été fermé sans attendre la fin de la transcription en direct ; l’enregistrement complet sera quand même transcrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata chiusa senza attendere la fine della trascrizione dal vivo; la registrazione completa verrà comunque trascritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしの終了を待たずに録音が閉じられました。録音全体は引き続き文字起こしされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 녹취록이 끝나기를 기다리지 않고 녹음을 닫았습니다. 전체 녹음은 그래도 텍스트로 변환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is gesloten zonder op het einde van het live transcript te wachten; de volledige opname wordt toch uitgeschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi fechada sem esperar o fim da transcrição ao vivo; a gravação completa ainda será transcrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制已关闭，未等待实时文字稿结束；完整录音仍会被转写。"
          }
        }
      }
    },
