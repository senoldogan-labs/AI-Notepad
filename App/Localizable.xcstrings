        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将示例会议存储到“会议”：%@"
          }
        }
      }
    },
    "Ana sayfadaki \"Kaydı başlat\", menü çubuğu ya da kısayol; kayıt sırasında canlı panel açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aufnahme starten“ unter „Start“, in der Menüleiste oder per Kurzbefehl; während der Aufnahme öffnet sich das Live-Panel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Start recording\" on Home, the menu bar or the shortcut; the live panel opens while you record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Iniciar grabación” en Inicio, la barra de menús o el atajo; el panel en directo se abre mientras grabas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Aloita nauhoitus” Koti-näkymässä, valikkorivillä tai pikanäppäimellä; live-paneeli avautuu nauhoituksen ajaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Démarrer l’enregistrement » dans Accueil, la barre des menus ou le raccourci ; le panneau en direct s’ouvre pendant l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Avvia registrazione” in Home, la barra dei menu o l’abbreviazione; durante la registrazione si apre il pannello dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホーム」の「録音を開始」、メニューバー、またはショートカット。録音中はライブパネルが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈의 \"녹음 시작\", 메뉴 막대 또는 단축키. 녹음하는 동안 실시간 패널이 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Start opname\" in Start, de menubalk of de toetscombinatie; tijdens het opnemen opent het livepaneel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Iniciar gravação\" no Início, na barra de menus ou pelo atalho; o painel ao vivo abre enquanto você grava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“主页”中的“开始录制”、菜单栏或快捷键；录制时会打开实时面板。"
          }
        }
      }
    },
    "Sor ve tarifler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen und Rezepte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask and recipes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar y recetas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy ja reseptit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander et recettes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi e ricette"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問とレシピ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하기와 레시피"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag en recepten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar e receitas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问和预设"
          }
        }
      }
    },
    "Toplantılarına soru sor; sık sorduğunu tarif olarak kaydet, \"/\" ile çalıştır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag deine Meetings, was du willst; sichere eine häufige Frage als Rezept und führe sie mit „/“ aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your meetings anything; save a question you ask often as a recipe and run it with \"/\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta lo que quieras a tus reuniones; guarda como receta una pregunta que hagas a menudo y ejecútala con “/”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy kokouksiltasi mitä tahansa; tallenna usein kysymäsi kysymys reseptiksi ja suorita se merkillä ”/”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez n’importe quelle question à vos réunions ; enregistrez une question fréquente comme recette et lancez-la avec « / »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi qualsiasi cosa alle tue riunioni; salva come ricetta una domanda che fai spesso ed eseguila con “/”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議について何でも質問できます。よくする質問はレシピとして保存し、「/」で実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의에 무엇이든 물어보세요. 자주 하는 질문은 레시피로 저장하고 \"/\"로 실행하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je vergaderingen elke vraag die je wilt; bewaar een vraag die je vaak stelt als recept en voer hem uit met \"/\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa às suas reuniões; salve uma pergunta frequente como receita e execute-a com \"/\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的会议提出任何问题；将常问的问题存储为预设，并用“/”运行。"
          }
        }
      }
    },
    "Ana ekranda seni bekliyor; istediğin zaman silebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wartet auf dem Startbildschirm; lösch es, wann immer du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's waiting on the home screen; delete it whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te espera en la pantalla de inicio; elimínala cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se odottaa aloitusnäkymässä; voit poistaa sen milloin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle vous attend sur l’écran d’accueil ; supprimez-la quand vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti aspetta nella schermata principale; eliminala quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面にあります。いつでも削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에서 기다리고 있습니다. 언제든지 삭제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij wacht op je op het startscherm; verwijder hem wanneer je wilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela espera por você na tela inicial; apague quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在主屏幕上等你；你可以随时删除它。"
          }
        }
      }
    },
    "Senin sesin, kilit ekranında kayıt ve not hazır olunca haber. İzinleri sonra iPhone Ayarları'ndan değiştirebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme, Aufnahme auf dem Sperrbildschirm und ein Hinweis, wenn deine Notiz fertig ist. Du kannst das später in den iPhone-Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice, recording on the Lock Screen, and a heads-up when your note is ready. You can change these later in iPhone Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz, la grabación en la pantalla bloqueada y un aviso cuando tu nota esté lista. Puedes cambiar estos permisos después en Ajustes del iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma äänesi, nauhoitus lukitusnäytöllä ja ilmoitus, kun muistiinpanosi on valmis. Voit muuttaa näitä myöhemmin iPhonen asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix, l’enregistrement sur l’écran verrouillé et une alerte quand votre note est prête. Vous pourrez modifier ces autorisations plus tard dans Réglages de l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce, la registrazione sulla schermata di blocco e un avviso quando la tua nota è pronta. Puoi modificare queste autorizzazioni in seguito in Impostazioni di iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声、ロック画面での録音、ノートが完成したときの通知。これらはあとでiPhoneの「設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목소리, 잠금 화면에서 녹음, 노트가 준비되면 알림. 나중에 iPhone 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem, opnemen op het toegangsscherm en een seintje als je notitie klaar is. Je kunt dit later wijzigen in Instellingen op de iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz, a gravação na Tela Bloqueada e um aviso quando sua nota estiver pronta. Você pode mudar essas permissões depois nos Ajustes do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的声音、在锁定屏幕上录制，以及笔记就绪时的通知。之后可在 iPhone“设置”中更改这些权限。"
          }
        }
      }
    },
    "Takvim yalnızca bu iPhone'da okunur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kalender wird nur auf diesem iPhone gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calendar is read only on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu calendario solo se lee en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenteriasi luetaan vain tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre calendrier est lu uniquement sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo calendario viene letto solo su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーはこのiPhone上でのみ読み取られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더는 이 iPhone에서만 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je agenda wordt alleen op deze iPhone gelezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu calendário é lido apenas neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的日历仅在这部 iPhone 上读取。"
          }
        }
      }
    },
    "Takvim izni yok: iPhone Ayarları'nda Gistsmith › Takvimler'i aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kalenderzugriff: Aktiviere „Gistsmith“ › „Kalender“ in den iPhone-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar access: turn on Gistsmith › Calendars in iPhone Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al calendario: activa Gistsmith › Calendarios en Ajustes del iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei pääsyä kalenteriin: laita Gistsmith › Kalenterit päälle iPhonen asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au calendrier : activez Gistsmith › Calendriers dans Réglages de l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al calendario: attiva Gistsmith › Calendari in Impostazioni di iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセス権がありません：iPhoneの「設定」で「Gistsmith」›「カレンダー」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한 없음: iPhone 설정에서 Gistsmith › 캘린더를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot agenda: zet Gistsmith › Agenda's aan in Instellingen op de iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao calendário: ative Gistsmith › Calendários nos Ajustes do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有日历访问权限：请在 iPhone“设置”中打开“Gistsmith › 日历”。"
          }
        }
      }
    },
    "Google, Outlook ya da iCloud takvimin mi var? iPhone Ayarları › Takvim › Hesaplar'dan eklediğin takvimler burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Google, Outlook oder iCloud? Kalender, die du in den iPhone-Einstellungen unter „Kalender“ › „Accounts“ hinzufügst, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using Google, Outlook or iCloud? Calendars you add in iPhone Settings › Calendar › Accounts appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usas Google, Outlook o iCloud? Los calendarios que añadas en Ajustes del iPhone › Calendario › Cuentas aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytätkö Googlea, Outlookia tai iCloudia? Kalenterit, jotka lisäät iPhonen kohdassa Asetukset › Kalenteri › Tilit, näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez Google, Outlook ou iCloud ? Les calendriers que vous ajoutez dans Réglages de l’iPhone › Calendrier › Comptes apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usi Google, Outlook o iCloud? I calendari che aggiungi in Impostazioni di iPhone › Calendario › Account compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google、Outlook、iCloudをお使いですか？iPhoneの「設定」›「カレンダー」›「アカウント」で追加したカレンダーがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google, Outlook 또는 iCloud를 사용하시나요? iPhone 설정 › 캘린더 › 계정에서 추가한 캘린더가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je Google, Outlook of iCloud? Agenda's die je toevoegt in Instellingen › Agenda › Accounts op de iPhone verschijnen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Google, Outlook ou iCloud? Os calendários que você adicionar em Ajustes do iPhone › Calendário › Contas aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google、Outlook 或 iCloud？在 iPhone“设置 › 日历 › 账户”中添加的日历会显示在这里。"
          }
        }
      }
    },
    "Önümüzdeki gün takviminde toplantı yok; eklenince burada ve ana ekranda görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Meetings in deinem Kalender für den nächsten Tag; neue erscheinen hier und auf dem Startbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meetings on your calendar for the next day; new ones appear here and on the home screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay reuniones en tu calendario para el próximo día; las nuevas aparecen aquí y en la pantalla de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterissasi ei ole kokouksia seuraavan vuorokauden aikana; uudet näkyvät täällä ja aloitusnäkymässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réunion dans votre calendrier pour le jour à venir ; les nouvelles apparaissent ici et sur l’écran d’accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna riunione nel tuo calendario per il prossimo giorno; quelle nuove compaiono qui e nella schermata principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後1日、カレンダーに会議はありません。新しい会議はこことホーム画面に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 하루 동안 캘린더에 회의가 없습니다. 새 회의는 여기와 홈 화면에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vergaderingen in je agenda voor de komende dag; nieuwe verschijnen hier en op het startscherm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma reunião no seu calendário para o próximo dia; as novas aparecem aqui e na tela inicial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来一天你的日历中没有会议；新会议会显示在这里和主屏幕上。"
          }
        }
      }
    },
    "Toplantıdaki konuşmalar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was im Meeting gesagt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's said in the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se dice en la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä kokouksessa sanotaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se dit dans la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che si dice nella riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議での発言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의에서 나오는 말."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er in de vergadering wordt gezegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é dito na reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议中所说的内容。"
          }
        }
      }
    },
    "Kilit ekranında kayıt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme auf dem Sperrbildschirm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording on the Lock Screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación en la pantalla bloqueada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus lukitusnäytöllä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement sur l’écran verrouillé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione sulla schermata di blocco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面での録音"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에서 녹음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen op het toegangsscherm"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação na Tela Bloqueada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕上录制"
          }
        }
      }
    },
    "Süre ve son cümle kilit ekranında ve Dynamic Island'da.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit und letzter Satz auf dem Sperrbildschirm und in der Dynamic Island."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time and the latest sentence on the Lock Screen and in the Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo y la última frase en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika ja viimeisin lause lukitusnäytöllä ja Dynamic Islandissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée et la dernière phrase sur l’écran verrouillé et dans la Dynamic Island."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata e ultima frase sulla schermata di blocco e nella Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経過時間と最新の文をロック画面とDynamic Islandに表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면과 Dynamic Island에 시간과 최신 문장 표시."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd en de laatste zin op het toegangsscherm en in het Dynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo e a frase mais recente na Tela Bloqueada e na Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕和灵动岛上显示时间和最新的一句话。"
          }
        }
      }
    },
    "İzin vermesen de devam edebilirsin; kayıt başlarken eksik izin yeniden sorulur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch ohne Berechtigungen fortfahren; eine fehlende wird beim Start der Aufnahme erneut abgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without permissions; a missing one is asked for again when you start recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes continuar sin permisos; el que falte se volverá a pedir al empezar a grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa ilman lupia; puuttuva lupa kysytään uudelleen, kun aloitat nauhoituksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer sans autorisations ; celle qui manque sera redemandée au début de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare senza autorizzazioni; quella mancante viene richiesta di nuovo all’avvio della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しなくても続行できます。足りない許可は録音開始時にもう一度求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 없이도 계속할 수 있으며, 빠진 권한은 녹음을 시작할 때 다시 요청됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt doorgaan zonder toestemmingen; een ontbrekende wordt opnieuw gevraagd wanneer je begint met opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar sem permissões; a que faltar será pedida de novo quando você iniciar a gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不授予权限也可以继续；缺少的权限会在开始录制时再次请求。"
          }
        }
      }
    },
