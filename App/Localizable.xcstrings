    "Bildirimdeki \"Dinlemeye başla\" ile kayıt hemen başlar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zuhören starten“ in der Mitteilung startet die Aufnahme sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Start listening\" in the notification starts recording right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Empezar a escuchar” en la notificación inicia la grabación al momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksen ”Aloita kuuntelu” aloittaa nauhoituksen heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Commencer l’écoute » dans la notification lance l’enregistrement immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Inizia ad ascoltare” nella notifica avvia subito la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の「聞き取りを開始」で、すぐに録音が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에서 \"듣기 시작\"을 누르면 바로 녹음이 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Begin met luisteren\" in de melding start de opname meteen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Começar a ouvir\" na notificação inicia a gravação na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按通知中的“开始收听”会立即开始录制。"
          }
        }
      }
    },
    "Bildirimi kopyala": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis kopieren"
          }
        },
