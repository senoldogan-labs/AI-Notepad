    "Henüz konuşma yok; sorular toplantıda konuşulanlara göre cevaplanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gesprochen; Fragen werden anhand des im Meeting Gesagten beantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech yet; questions are answered from what is said in the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha hablado; las preguntas se responden a partir de lo que se dice en la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä puhetta; kysymyksiin vastataan sen perusteella, mitä kokouksessa sanotaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’a encore parlé ; les réponses aux questions s’appuient sur ce qui est dit pendant la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun parlato; le domande ricevono risposta in base a ciò che viene detto nella riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ発話がありません。質問には会議で話された内容をもとに回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 발언이 없습니다. 질문에는 회의에서 나온 내용을 바탕으로 답변합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen spraak; vragen worden beantwoord op basis van wat er in de vergadering wordt gezegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém falou ainda; as perguntas são respondidas com base no que é dito na reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有人说话；问题会根据会议中所说的内容回答。"
          }
        }
      }
    },
