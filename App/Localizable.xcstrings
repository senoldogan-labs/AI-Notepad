    "Bu toplantının sesi zaten işleniyor; bitince yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio dieses Meetings wird bereits verarbeitet; versuche es erneut, wenn der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting's audio is already being processed; try again when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de esta reunión ya se está procesando; inténtalo de nuevo cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kokouksen ääntä käsitellään jo; yritä uudelleen, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de cette réunion est déjà en cours de traitement ; réessayez une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio di questa riunione è già in elaborazione; riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議の音声はすでに処理中です。完了してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의의 오디오를 이미 처리하는 중입니다. 완료되면 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio van deze vergadering wordt al verwerkt; probeer het opnieuw als dat klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio desta reunião já está sendo processado; tente de novo quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议的音频已在处理中；处理完成后再试。"
          }
        }
      }
    },
    "Bu toplantının sunucu oturumu kapandı. Kayıtlı toplantıyı \"Tekrar işle\" ile yeniden işleyebilir ya da yeni bir toplantı başlatabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serversitzung dieses Meetings wurde geschlossen. Du kannst das gesicherte Meeting mit „Neu verarbeiten“ erneut verarbeiten oder ein neues Meeting starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting's server session has closed. You can reprocess the saved meeting with \"Reprocess\" or start a new meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión del servidor de esta reunión se ha cerrado. Puedes reprocesar la reunión guardada con “Reprocesar” o iniciar una reunión nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kokouksen palvelinistunto on sulkeutunut. Voit käsitellä tallennetun kokouksen uudelleen valinnalla ”Käsittele uudelleen” tai aloittaa uuden kokouksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session serveur de cette réunion est fermée. Vous pouvez retraiter la réunion enregistrée avec « Retraiter » ou démarrer une nouvelle réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione sul server di questa riunione è chiusa. Puoi rielaborare la riunione salvata con “Rielabora” o iniziare una nuova riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議のサーバセッションは終了しました。保存済みの会議は「再処理」で再処理するか、新しい会議を開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의의 서버 세션이 종료되었습니다. \"다시 처리\"로 저장된 회의를 다시 처리하거나 새 회의를 시작할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serversessie van deze vergadering is gesloten. Je kunt de bewaarde vergadering opnieuw verwerken met \"Opnieuw verwerken\" of een nieuwe vergadering starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão desta reunião no servidor foi encerrada. Você pode reprocessar a reunião salva com \"Reprocessar\" ou iniciar uma nova reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议的服务器会话已关闭。你可以用“重新处理”重新处理已存储的会议，或开始新的会议。"
          }
        }
      }
    },
    "Bu toplantının süre sınırına 5 dakika kaldı; kayıt %@ itibarıyla bitirilecek.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch 5 Minuten bis zum Zeitlimit dieses Meetings; die Aufnahme stoppt um %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes left before this meeting's time limit; recording will stop at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan 5 minutos para el límite de tiempo de esta reunión; la grabación se detendrá a las %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen aikarajaan on 5 minuuttia; nauhoitus pysähtyy klo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que 5 minutes avant la limite de durée de cette réunion ; l’enregistrement s’arrêtera à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano 5 minuti al limite di tempo di questa riunione; la registrazione si fermerà alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議の制限時間まで残り5分です。録音は%@に停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의의 시간 제한까지 5분 남았습니다. 녹음은 %@에 중지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog 5 minuten tot de tijdslimiet van deze vergadering; de opname stopt om %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam 5 minutos para o limite de tempo desta reunião; a gravação vai parar às %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离此会议的时长上限还有 5 分钟；录制将于 %@ 停止。"
          }
        }
      }
    },
    "Bu toplantının süre sınırına ulaşıldı; kayıt bitirildi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting hat sein Zeitlimit erreicht; die Aufnahme wurde gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting reached its time limit; recording was stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión ha alcanzado su límite de tiempo; se ha detenido la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kokous saavutti aikarajansa; nauhoitus pysäytettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion a atteint sa limite de durée ; l’enregistrement a été arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione ha raggiunto il limite di tempo; la registrazione è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議は制限時間に達したため、録音を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의가 시간 제한에 도달하여 녹음이 중지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering heeft de tijdslimiet bereikt; de opname is gestopt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião atingiu o limite de tempo; a gravação foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议已达到时长上限；录制已停止。"
          }
        }
      }
    },
    "Bu toplantının yapay zekâ kullanım hakkı doldu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Kontingent dieses Meetings ist aufgebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting's AI allowance is used up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado la asignación de IA de esta reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kokouksen tekoälykiintiö on käytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota d’IA de cette réunion est épuisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota AI di questa riunione è esaurita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議のAI利用枠を使い切りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의의 AI 사용량을 모두 사용했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-tegoed van deze vergadering is op."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota de IA desta reunião acabou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议的 AI 额度已用完。"
          }
        }
      }
    },
    "Bu toplantıya tarif uygula: takip e-postası, aksiyonlar, proje planı…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende ein Rezept auf dieses Meeting an: Follow-up-E-Mail, Aktionen, Projektplan …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a recipe to this meeting: follow-up email, actions, project plan…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica una receta a esta reunión: correo de seguimiento, acciones, plan de proyecto…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä reseptiä tähän kokoukseen: jatkosähköposti, toimenpiteet, projektisuunnitelma…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquez une recette à cette réunion : e-mail de suivi, actions, plan de projet…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica una ricetta a questa riunione: email di follow-up, azioni, piano di progetto…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議にレシピを適用：フォローアップメール、アクション、プロジェクト計画…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의에 레시피 적용: 후속 이메일, 실행 항목, 프로젝트 계획…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas een recept toe op deze vergadering: follow-up-e-mail, acties, projectplan…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique uma receita a esta reunião: e-mail de acompanhamento, ações, plano de projeto…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对此会议应用预设：跟进邮件、行动项、项目计划…"
          }
        }
      }
    },
    "Bu yapılandırmayı istemcinin MCP ayarlarına (Claude Desktop: Ayarlar › Geliştirici › Yapılandırmayı düzenle) ekle. İstemci toplantılarını listeler, arar, notları, transkriptleri ve paylaşılan ekranların görüntülerini okur; yalnızca okur, hiçbir şey değiştirmez. Okunanlar istemcinin yapay zekâ sağlayıcısına (ör. Anthropic, OpenAI) gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diese Konfiguration zu den MCP-Einstellungen des Clients hinzu (Claude Desktop: Settings › Developer › Edit Config). Der Client listet, durchsucht und liest deine Meetings, Notizen, Transkripte und Bildschirmfotos geteilter Bildschirme; er liest nur und ändert nie etwas. Was er liest, wird an den KI-Anbieter des Clients gesendet (z. B. Anthropic, OpenAI)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this configuration to the client's MCP settings (Claude Desktop: Settings › Developer › Edit Config). The client lists, searches and reads your meetings, notes, transcripts and shared-screen snapshots; it only reads and never changes anything. What it reads is sent to the client's AI provider (e.g. Anthropic, OpenAI)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade esta configuración a los ajustes MCP del cliente (Claude Desktop: Settings › Developer › Edit Config). El cliente enumera, busca y lee tus reuniones, notas, transcripciones y capturas de la pantalla compartida; solo lee y nunca cambia nada. Lo que lee se envía al proveedor de IA del cliente (p. ej., Anthropic, OpenAI)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä määritys asiakasohjelman MCP-asetuksiin (Claude Desktop: Settings › Developer › Edit Config). Asiakasohjelma listaa, hakee ja lukee kokouksiasi, muistiinpanojasi, litterointejasi ja jaetun näytön kuvia; se vain lukee eikä koskaan muuta mitään. Sen lukema tieto lähetetään asiakasohjelman tekoälypalveluntarjoajalle (esim. Anthropic, OpenAI)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cette configuration aux réglages MCP du client (Claude Desktop : Settings › Developer › Edit Config). Le client liste, recherche et lit vos réunions, notes, transcriptions et captures de l’écran partagé ; il se contente de lire et ne modifie jamais rien. Ce qu’il lit est envoyé au fournisseur d’IA du client (p. ex. Anthropic, OpenAI)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questa configurazione alle impostazioni MCP del client (Claude Desktop: Settings › Developer › Edit Config). Il client elenca, cerca e legge le tue riunioni, note, trascrizioni e istantanee dello schermo condiviso; si limita a leggere e non modifica mai nulla. Ciò che legge viene inviato al fornitore AI del client (ad es. Anthropic, OpenAI)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定をクライアントのMCP設定に追加してください（Claude Desktop：Settings › Developer › Edit Config）。クライアントは会議、ノート、文字起こし、共有画面のスナップショットを一覧表示・検索・読み取りします。読み取るだけで、何も変更しません。読み取った内容はクライアントのAIプロバイダ（例：Anthropic、OpenAI）に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구성을 클라이언트의 MCP 설정에 추가하세요(Claude Desktop: Settings › Developer › Edit Config). 클라이언트가 회의, 노트, 녹취록 및 공유 화면 스냅샷의 목록을 보고 검색하며 읽습니다. 읽기만 하고 아무것도 변경하지 않습니다. 읽은 내용은 클라이언트의 AI 제공업체(예: Anthropic, OpenAI)로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg deze configuratie toe aan de MCP-instellingen van de client (Claude Desktop: Settings › Developer › Edit Config). De client toont, doorzoekt en leest je vergaderingen, notities, transcripten en schermafbeeldingen van gedeelde schermen; hij leest alleen en wijzigt nooit iets. Wat hij leest, wordt naar de AI-aanbieder van de client gestuurd (bijv. Anthropic, OpenAI)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione esta configuração aos ajustes de MCP do cliente (Claude Desktop: Settings › Developer › Edit Config). O cliente lista, busca e lê suas reuniões, notas, transcrições e capturas da tela compartilhada; ele só lê e nunca altera nada. O que ele lê é enviado ao provedor de IA do cliente (ex.: Anthropic, OpenAI)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此配置添加到客户端的 MCP 设置中（Claude Desktop：设置 › 开发者 › 编辑配置）。客户端会列出、搜索和读取你的会议、笔记、文字稿和共享屏幕快照；它只读取，从不更改任何内容。它读取的内容会发送给客户端的 AI 提供商（例如 Anthropic、OpenAI）。"
          }
        }
      }
    },
    "Bu yüz yüze toplantılardaki görevlerin, konuşmacını seçince buraya gelir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben aus diesen Meetings vor Ort erscheinen hier, sobald du deinen Sprecher auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks from these in-person meetings appear here once you pick your speaker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas de estas reuniones presenciales aparecerán aquí cuando elijas tu interlocutor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden kasvokkaisten kokousten tehtäväsi tulevat tänne, kun valitset puhujasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches issues de ces réunions en présentiel apparaissent ici dès que vous choisissez votre intervenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività di queste riunioni di persona compaiono qui quando scegli il tuo interlocutore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの対面の会議のタスクは、自分の話者を選ぶとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대면 회의들의 할 일은 자신의 화자를 선택하면 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken uit deze fysieke vergaderingen verschijnen hier zodra je je spreker kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas dessas reuniões presenciais aparecem aqui quando você escolhe seu falante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选出你的说话人后，这些面对面会议中的任务会显示在这里。"
          }
        }
      }
    },
