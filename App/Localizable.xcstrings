    "Ücretsiz denemen bitti. Devam etmek için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Test ist beendet. Schließe ein Abo ab, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial has ended. Subscribe to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita ha finalizado. Suscríbete para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujaksosi on päättynyt. Jatka tilaamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit est terminé. Abonnez-vous pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita è terminata. Abbonati per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルが終了しました。続けるには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되었습니다. 계속 사용하려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis proefperiode is afgelopen. Neem een abonnement om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis terminou. Assine para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用已结束。订阅即可继续。"
          }
        }
      }
    },
    "Ücretsiz denemen bitti. Kayda devam etmek için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Test ist beendet. Schließe ein Abo ab, um weiter aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial has ended. Subscribe to keep recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita ha finalizado. Suscríbete para seguir grabando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujaksosi on päättynyt. Tilaa, niin voit jatkaa nauhoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit est terminé. Abonnez-vous pour continuer à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita è terminata. Abbonati per continuare a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルが終了しました。録音を続けるには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되었습니다. 계속 녹음하려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis proefperiode is afgelopen. Neem een abonnement om te blijven opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis terminou. Assine para continuar gravando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用已结束。订阅即可继续录制。"
          }
        }
      }
    },
    "Ücretsiz denemen bitti. Toplantıların ve notların bu Mac'te kalır; yeni toplantılar için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Test ist beendet. Deine Meetings und Notizen bleiben auf diesem Mac; schließe ein Abo ab, um neue Meetings aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial has ended. Your meetings and notes stay on this Mac; subscribe to record new meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita ha finalizado. Tus reuniones y notas se quedan en este Mac; suscríbete para grabar reuniones nuevas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujaksosi on päättynyt. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa; tilaa, niin voit nauhoittaa uusia kokouksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit est terminé. Vos réunions et notes restent sur ce Mac ; abonnez-vous pour enregistrer de nouvelles réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita è terminata. Le riunioni e le note restano su questo Mac; abbonati per registrare nuove riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルが終了しました。会議とノートはこのMacに残ります。新しい会議を録音するには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되었습니다. 회의와 노트는 이 Mac에 보관됩니다. 새 회의를 녹음하려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis proefperiode is afgelopen. Je vergaderingen en notities blijven op deze Mac; neem een abonnement om nieuwe vergaderingen op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis terminou. Suas reuniões e notas continuam neste Mac; assine para gravar novas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用已结束。你的会议和笔记保留在这台 Mac 上；订阅即可录制新会议。"
          }
        }
      }
    },
    "Ücretsiz denemen bittiği için bu toplantı işlenemedi. Ses bu Mac'te kalır; abone olunca kendiliğinden işlenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting konnte nicht verarbeitet werden, weil dein kostenloser Test beendet ist. Das Audio bleibt auf diesem Mac; es wird automatisch verarbeitet, sobald du ein Abo abschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting couldn't be processed because your free trial has ended. The audio stays on this Mac; it's processed automatically once you subscribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar esta reunión porque tu prueba gratuita ha finalizado. El audio se queda en este Mac; se procesará automáticamente cuando te suscribas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei voitu käsitellä, koska ilmainen kokeilujaksosi on päättynyt. Ääni säilyy tässä Macissa; se käsitellään automaattisesti, kun tilaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas pu être traitée car votre essai gratuit est terminé. L’audio reste sur ce Mac ; il sera traité automatiquement dès que vous vous abonnerez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare questa riunione perché la tua prova gratuita è terminata. L’audio resta su questo Mac; verrà elaborato automaticamente quando ti abbonerai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルが終了したため、この会議を処理できませんでした。音声はこのMacに残り、登録すると自動的に処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되어 이 회의를 처리할 수 없습니다. 오디오는 이 Mac에 보관되며, 구독하면 자동으로 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kon niet worden verwerkt omdat je gratis proefperiode is afgelopen. De audio blijft op deze Mac; hij wordt automatisch verwerkt zodra je een abonnement neemt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível processar esta reunião porque seu teste grátis terminou. O áudio continua neste Mac; ele será processado automaticamente quando você assinar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于你的免费试用已结束，无法处理此会议。音频保留在这台 Mac 上；订阅后会自动处理。"
          }
        }
      }
    },
