    "Kayıt ya da işleme sürerken güncellenmez; bitince güncelleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird während einer Aufnahme oder Verarbeitung nicht aktualisiert; du kannst aktualisieren, wenn sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app won't update while recording or processing; you can update when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se actualizará mientras haya una grabación o un procesamiento en curso; podrás actualizar cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei päivity nauhoituksen tai käsittelyn aikana; voit päivittää, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne se met pas à jour pendant un enregistrement ou un traitement ; vous pourrez mettre à jour une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non si aggiorna durante la registrazione o l’elaborazione; puoi aggiornare al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中や処理中はアプリはアップデートされません。完了したらアップデートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 처리 중에는 앱이 업데이트되지 않습니다. 완료된 후에 업데이트할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app werkt niet bij tijdens het opnemen of verwerken; je kunt bijwerken als dat klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não atualiza durante a gravação ou o processamento; você pode atualizar quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或处理期间 App 不会更新；完成后即可更新。"
          }
        }
      }
    },
