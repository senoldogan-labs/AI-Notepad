    },
    "Paylaşım penceresi açılamadı; uygulamayı öne getirip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen-Menü konnte nicht geöffnet werden; bring die App in den Vordergrund und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share sheet couldn't open; bring the app to the front and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir la hoja para compartir; pon la app en primer plano e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakonäkymää ei voitu avata; tuo sovellus etualalle ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille de partage n’a pas pu s’ouvrir ; mettez l’app au premier plan et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il foglio di condivisione; porta l’app in primo piano e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有シートを開けませんでした。アプリを前面に出して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 시트를 열 수 없습니다. 앱을 앞으로 가져온 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deelpaneel kon niet openen; zet de app op de voorgrond en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planilha de compartilhamento não abriu; traga o app para a frente e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开共享表单；请将 App 置于前台后重试。"
          }
        }
      }
    },
