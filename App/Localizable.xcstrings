            "state": "translated",
            "value": "Deepgram e ElevenLabs; falantes separados ao vivo. Precisa de duas chaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram 和 ElevenLabs；实时区分说话人。需要两个密钥。"
          }
        }
      }
    },
