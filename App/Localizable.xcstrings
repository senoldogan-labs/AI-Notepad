          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytön alareunan kapseli näyttää, että kuuntelu on käynnissä."
          }
        }
      }
    },
    "Eller serbest": {
      "localizations": {
