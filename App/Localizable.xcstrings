          "stringUnit": {
            "state": "translated",
            "value": "La nota viene preparata quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートはオンラインに戻ると準備されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 다시 온라인이 되면 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie wordt voorbereid zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota é preparada quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复联网后会准备笔记。"
          }
        }
      }
    },
    "Gistsmith'le yüz yüze toplantıyı kaydetmeye başlar; uygulama açılmadan kilit ekranında görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Aufnahme eines persönlichen Meetings mit Gistsmith; sie erscheint auf dem Sperrbildschirm, ohne die App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts recording an in-person meeting with Gistsmith; it shows on the Lock Screen without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar una reunión presencial con Gistsmith; aparece en la pantalla bloqueada sin abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittaa kasvokkaisen kokouksen nauhoituksen Gistsmithillä; näkyy lukitusnäytöllä avaamatta sovellusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance l’enregistrement d’une réunion en personne avec Gistsmith ; il s’affiche sur l’écran verrouillé sans ouvrir l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la registrazione di una riunione di persona con Gistsmith; appare nella schermata di blocco senza aprire l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith で対面の会議の録音を開始します。アプリを開かずにロック画面に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith로 대면 회의 녹음을 시작합니다. 앱을 열지 않아도 잠금 화면에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de opname van een fysieke vergadering met Gistsmith; die verschijnt op het toegangsscherm zonder de app te openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a gravar uma reunião presencial com o Gistsmith; aparece na Tela Bloqueada sem abrir o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Gistsmith 开始录制面对面会议；无需打开应用即可在锁定屏幕上显示。"
          }
        }
      }
    },
    "Kaydı başlat ya da bitir": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme starten oder beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or finish recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar o terminar grabación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita tai lopeta nauhoitus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer ou terminer l’enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o termina registrazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始または終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시작 또는 끝내기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname starten of afronden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar ou encerrar gravação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始或结束录制"
          }
        }
      }
    },
    "Süren Gistsmith kaydında şu anı işaretler; notta öne çıkar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert diesen Moment in der laufenden Gistsmith-Aufnahme; er wird in der Notiz hervorgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks this moment in the running Gistsmith recording; it stands out in the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca este momento en la grabación de Gistsmith en curso; se destaca en la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitsee tämän hetken käynnissä olevaan Gistsmith-nauhoitukseen; se korostuu muistiinpanossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque ce moment dans l’enregistrement Gistsmith en cours ; il ressort dans la note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna questo momento nella registrazione Gistsmith in corso; viene messo in evidenza nella nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の Gistsmith の録音でこの瞬間をマークします。ノートで強調されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 Gistsmith 녹음에서 이 순간을 표시합니다. 노트에서 강조됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert dit moment in de lopende Gistsmith-opname; het valt op in de notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca este momento na gravação do Gistsmith em andamento; ele ganha destaque na nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在进行中的 Gistsmith 录制中标记此时刻；它会在笔记中突出显示。"
          }
        }
      }
    },
    "Durumunu görmek için uygulamayı aç; o ana kadarki ses saklandı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um nachzusehen; der Ton bis dahin ist gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to check it; the audio up to that point is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app para comprobarlo; el audio hasta ese momento está guardado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa sovellus tarkistaaksesi; siihen asti tallentunut ääni on tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app pour vérifier ; l’audio jusqu’à ce moment est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’app per controllare; l’audio fino a quel momento è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いて確認してください。その時点までの音声は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열어 확인하세요. 그때까지의 오디오는 저장되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app om te controleren; de audio tot dat moment is bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app para verificar; o áudio até aquele momento foi salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用查看；在此之前的音频已保存。"
          }
        }
      }
    },
    "Yüz yüze toplantıyı uygulamayı açmadan kaydetmeye başlar; yeniden basınca bitirir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Aufnahme eines persönlichen Meetings, ohne die App zu öffnen; erneut drücken zum Beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts recording an in-person meeting without opening the app; press again to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar una reunión presencial sin abrir la app; vuelve a pulsar para terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittaa kasvokkaisen kokouksen nauhoituksen avaamatta sovellusta; lopeta painamalla uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance l’enregistrement d’une réunion en personne sans ouvrir l’app ; appuyez à nouveau pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la registrazione di una riunione di persona senza aprire l’app; premi di nuovo per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かずに対面の会議の録音を開始します。もう一度押すと終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고 대면 회의 녹음을 시작합니다. 다시 누르면 끝납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de opname van een fysieke vergadering zonder de app te openen; druk nogmaals om af te ronden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a gravar uma reunião presencial sem abrir o app; toque de novo para encerrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开应用即可开始录制面对面会议；再按一次即可结束。"
          }
        }
      }
    },
    "Mikrofon izni yok. Ayarlar'da bu uygulamanın sayfasında Mikrofon'u aç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofonzugriff. Aktiviere „Mikrofon“ auf der Seite dieser App in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone access. Turn on Microphone on this app's page in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono. Activa Micrófono en la página de esta app en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mikrofonin käyttöoikeutta. Laita Mikrofoni päälle tämän sovelluksen sivulla Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au micro. Activez Micro sur la page de cette app dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al microfono. Attiva Microfono nella pagina di questa app in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがありません。「設定」のこのアプリのページで「マイク」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 없습니다. 설정에서 이 앱 페이지의 마이크를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de microfoon. Zet Microfoon aan op de pagina van deze app in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao microfone. Ative Microfone na página deste app em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请在“设置”中此应用的页面打开“麦克风”。"
          }
        }
      }
    },
    "Ses açılıyor; izin sorulursa onayla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on audio; approve if asked for permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird eingeschaltet; bestätige, falls nach einer Berechtigung gefragt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation de l’audio ; acceptez si une autorisation est demandée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activando el audio; acepta si se pide permiso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivazione dell’audio; conferma se viene chiesto un permesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativando o áudio; aceite se for pedida permissão."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt aangezet; geef toestemming als daarom wordt gevraagd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声をオンにしています。許可を求められたら承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 켜는 중입니다. 권한을 요청하면 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开音频；如有权限请求，请允许。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääntä otetaan käyttöön; hyväksy, jos lupaa kysytään."
          }
        }
      }
    },
    "Kaydetmek için \"Kaydı başlat\"ı seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Aufnahme starten“, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Start recording\" to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Iniciar grabación» para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita valitsemalla ”Aloita nauhoitus”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Démarrer l’enregistrement » pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Avvia registrazione» per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するには「録音を開始」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 ‘녹음 시작’을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ‘Start opname’ om op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Iniciar gravação” para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“开始录制”即可录制。"
          }
        }
      }
    },
    "%@ · Kaydetmek için \"Kaydı başlat\"ı seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Wähle „Aufnahme starten“, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Choose \"Start recording\" to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Elige «Iniciar grabación» para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Nauhoita valitsemalla ”Aloita nauhoitus”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Choisissez « Démarrer l’enregistrement » pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Scegli «Avvia registrazione» per registrare."
          }
        },
        "ja": {
          "stringUnit": {
