            "state": "translated",
            "value": "Desactivado · activar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato · attiva"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado · ativar"
          }
        },
        "nl": {
          "stringUnit": {
