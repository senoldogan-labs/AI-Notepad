    "Önce Ayarlar › Bağlantılar'dan bir klasör seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst unter „Einstellungen“ › „Verbindungen“ einen Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First choose a folder in Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elige una carpeta en Ajustes › Conexiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ensin kansio kohdassa Asetukset › Yhteydet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord un dossier dans Réglages › Connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima una cartella in Impostazioni › Connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「設定」›「連携」でフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정 › 연결에서 폴더를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies eerst een map in Instellingen › Koppelingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro escolha uma pasta em Ajustes › Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置 › 连接”中选择一个文件夹。"
          }
        }
      }
    },
    "Önce bir toplantı kaydet: ücretsiz deneme ilk toplantıyla başlar, sonra toplantılarına soru sorabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm zuerst ein Meeting auf: Dein kostenloser Test beginnt mit deinem ersten Meeting, danach kannst du Fragen zu deinen Meetings stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting first: your free trial starts with your first meeting, then you can ask about your meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba primero una reunión: tu prueba gratuita empieza con tu primera reunión y luego podrás preguntar sobre tus reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita ensin kokous: ilmainen kokeilujaksosi alkaa ensimmäisestä kokouksestasi, minkä jälkeen voit kysyä kokouksistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez d’abord une réunion : votre essai gratuit commence avec votre première réunion, puis vous pourrez interroger vos réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra prima una riunione: la prova gratuita inizia con la tua prima riunione, poi potrai fare domande sulle tue riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に会議を録音してください：無料トライアルは最初の会議から始まり、その後、会議について質問できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 회의를 녹음하세요. 무료 체험은 첫 회의와 함께 시작되며, 그 후 회의에 대해 질문할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem eerst een vergadering op: je gratis proefperiode begint bij je eerste vergadering, daarna kun je vragen stellen over je vergaderingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião primeiro: seu teste grátis começa com sua primeira reunião e depois você pode perguntar sobre suas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先录制一个会议：你的免费试用从第一个会议开始，之后即可询问你的会议。"
          }
        }
      }
    },
    "Önce haber ver": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es ihnen zuerst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell them first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísales antes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro heille ensin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez-les d’abord"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisali prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に伝える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 알리세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het ze eerst weten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise-os primeiro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先告知对方"
          }
        }
      }
    },
    "Önce kenar çubuğunda \"+\" ile klasör oluştur": {
      "localizations": {
        "de": {
