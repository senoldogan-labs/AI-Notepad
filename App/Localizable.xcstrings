    "Bulut canlı metnine bu toplantıda çok sık yeniden bağlanıldı; canlı metin bu Mac'te sürüyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cloud-Live-Transkript hat sich in diesem Meeting zu oft neu verbunden; das Live-Transkript läuft auf diesem Mac weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud live transcript reconnected too often in this meeting; the live transcript continues on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en directo en la nube se ha reconectado demasiadas veces en esta reunión; la transcripción en directo continúa en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilven reaaliaikainen litterointi yhdisti uudelleen liian usein tässä kokouksessa; reaaliaikainen litterointi jatkuu tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription cloud en direct s’est reconnectée trop souvent pendant cette réunion ; la transcription en direct continue sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione dal vivo nel cloud si è riconnessa troppe volte in questa riunione; la trascrizione dal vivo continua su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議でクラウドのライブ文字起こしの再接続が多すぎました。ライブ文字起こしはこのMacで続行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의에서 클라우드 실시간 녹취록의 재연결이 너무 잦았습니다. 실시간 녹취록은 이 Mac에서 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het live cloudtranscript heeft in deze vergadering te vaak opnieuw verbinding gemaakt; het live transcript gaat door op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ao vivo na nuvem se reconectou vezes demais nesta reunião; a transcrição ao vivo continua neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会议中云端实时转写重新连接过于频繁；实时转写在这台 Mac 上继续。"
          }
        }
      }
    },
