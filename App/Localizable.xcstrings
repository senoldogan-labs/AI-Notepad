    "Toplantı etiketle — soru yalnız ona sorulur": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere ein Meeting – die Frage geht nur an dieses"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag a meeting — the question goes to it only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiqueta una reunión: la pregunta solo irá a ella"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse kokous — kysymys kohdistuu vain siihen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taguez une réunion — la question ne porte que sur elle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagga una riunione: la domanda va solo a quella"
          }
        },
        "ja": {
