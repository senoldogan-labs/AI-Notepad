    "Son silinenler'den geri yükleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es aus „Zuletzt gelöscht“ wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore it from Recently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurarla desde Eliminado recientemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa sen kohdasta Äskettäin poistetut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez la restaurer depuis Suppressions récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ripristinarla da Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最近削除した項目」から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 삭제된 항목에서 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het terugzetten vanuit Recent verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurá-la em Apagados recentemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以从“最近删除”中恢复。"
          }
        }
      }
    },
    "Son silinenler'e taşınır; %lld gün içinde geri yükleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach „Zuletzt gelöscht“ verschoben; du kannst es innerhalb von %lld Tagen wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves to Recently deleted; you can restore it within %lld days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve a Eliminado recientemente; puedes restaurarla en un plazo de %lld días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtyy kohtaan Äskettäin poistetut; voit palauttaa sen %lld päivän kuluessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacée vers Suppressions récentes ; vous pouvez la restaurer pendant %lld jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene spostata in Eliminati di recente; puoi ripristinarla entro %lld giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最近削除した項目」に移動します。%lld日以内であれば復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 삭제된 항목으로 이동하며, %lld일 이내에 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt verplaatst naar Recent verwijderd; je kunt het binnen %lld dagen terugzetten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para Apagados recentemente; você pode restaurá-la em até %lld dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到“最近删除”；你可以在 %lld 天内恢复。"
          }
        }
      }
    },
    "Sunucu %lld saniyede yanıt vermedi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht innerhalb von %lld Sekunden geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't respond within %lld seconds."
