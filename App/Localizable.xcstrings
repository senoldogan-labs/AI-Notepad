    "Güvenlik işlemi tamamlanamadı (%@, kod %lld). Uygulamayı yeniden açıp tekrar dene; sürerse geri bildirim gönder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sicherheitsvorgang konnte nicht abgeschlossen werden (%@, Code %lld). Öffne die App erneut und versuche es noch einmal; falls das weiterhin passiert, sende Feedback."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A security operation couldn't be completed (%@, code %lld). Reopen the app and try again; if it keeps happening, send feedback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar una operación de seguridad (%@, código %lld). Vuelve a abrir la app e inténtalo de nuevo; si sigue ocurriendo, envía comentarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojaustoimintoa ei voitu suorittaa (%@, koodi %lld). Avaa sovellus uudelleen ja yritä uudelleen; jos tämä toistuu, lähetä palautetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération de sécurité n’a pas pu aboutir (%@, code %lld). Rouvrez l’app et réessayez ; si le problème persiste, envoyez un commentaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare un’operazione di sicurezza (%@, codice %lld). Riapri l’app e riprova; se continua a succedere, invia un feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ操作を完了できませんでした（%@、コード %lld）。アプリを開き直して、もう一度お試しください。繰り返し発生する場合は、フィードバックを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 작업을 완료할 수 없습니다(%1$@, 코드 %2$lld). 앱을 다시 열고 시도하세요. 문제가 계속되면 피드백을 보내 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beveiligingsbewerking kon niet worden voltooid (%@, code %lld). Open de app opnieuw en probeer het nog eens; blijft het gebeuren, stuur dan feedback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir uma operação de segurança (%@, código %lld). Reabra o app e tente de novo; se continuar acontecendo, envie feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成安全操作（%@，代码 %lld）。请重新打开 App 后重试；如果问题持续，请发送反馈。"
          }
        }
      }
    },
    "iCloud kullanılamıyor. Sistem Ayarları › Apple Hesabı › iCloud'da iCloud Drive'ı aç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist nicht verfügbar. Aktiviere iCloud Drive unter „Systemeinstellungen“ › „Apple Account“ › „iCloud“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud isn't available. Turn on iCloud Drive in System Settings › Apple Account › iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible. Activa iCloud Drive en Ajustes del Sistema › Cuenta de Apple › iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ei ole käytettävissä. Laita iCloud Drive päälle kohdassa Järjestelmäasetukset › Apple-tili › iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n’est pas disponible. Activez iCloud Drive dans Réglages Système › Compte Apple › iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è disponibile. Attiva iCloud Drive in Impostazioni di Sistema › Account Apple › iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを利用できません。「システム設定」›「Appleアカウント」›「iCloud」でiCloud Driveをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 사용할 수 없습니다. 시스템 설정 › Apple 계정 › iCloud에서 iCloud Drive를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is niet beschikbaar. Zet iCloud Drive aan in Systeeminstellingen › Apple-account › iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não está disponível. Ative o iCloud Drive em Ajustes do Sistema › Conta Apple › iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用。请在“系统设置 › Apple 账户 › iCloud”中打开 iCloud 云盘。"
          }
        }
      }
    },
