            "value": "Aviso breve en el idioma de la reunión y en inglés; pégalo en el chat de la reunión"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve avviso nella lingua della riunione e in inglese; incollalo nella chat della riunione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso curto no idioma da reunião e em inglês; cole no chat da reunião"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte melding in de taal van de vergadering en in het Engels; plak hem in de vergaderchat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の言語と英語の短いお知らせ。会議のチャットに貼り付けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 언어와 영어로 된 짧은 안내. 회의 채팅에 붙여 넣으세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
