    "Kişiler defteri okunamadığı için değişiklik kaydedilmedi; People.json dosyasını denetle ve uygulamayı yeniden aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde nicht gesichert, weil die Personenliste nicht gelesen werden konnte; prüfe People.json und öffne die App erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change wasn't saved because the people list couldn't be read; check People.json and reopen the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio no se ha guardado porque no se ha podido leer la lista de personas; revisa People.json y vuelve a abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutosta ei tallennettu, koska henkilölistaa ei voitu lukea; tarkista People.json ja avaa sovellus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas été enregistrée car la liste des personnes n’a pas pu être lue ; vérifiez People.json et rouvrez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non è stata salvata perché non è stato possibile leggere l’elenco delle persone; controlla People.json e riapri l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物リストを読み取れなかったため、変更は保存されませんでした。People.jsonを確認して、アプリを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람 목록을 읽을 수 없어 변경 사항이 저장되지 않았습니다. People.json을 확인하고 앱을 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging is niet bewaard omdat de personenlijst niet kon worden gelezen; controleer People.json en open de app opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração não foi salva porque a lista de pessoas não pôde ser lida; verifique People.json e reabra o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法读取人员列表，更改未存储；请检查 People.json 并重新打开 App。"
          }
        }
      }
    },
    "Kişiler'den kaldırır ve sesini unutur; toplantılardaki adı kalır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt aus „Personen“ und vergisst die Stimme; der Name bleibt in den Meetings"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes from People and forgets the voice; the name stays in meetings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de Personas y olvida la voz; el nombre se mantiene en las reuniones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa henkilöistä ja unohtaa äänen; nimi säilyy kokouksissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire de Personnes et oublie la voix ; le nom reste dans les réunions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove da Persone e dimentica la voce; il nome resta nelle riunioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」から削除し、声を忘れます。名前は会議に残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람 목록에서 제거하고 목소리를 잊습니다. 이름은 회의에 그대로 남습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert uit Personen en vergeet de stem; de naam blijft in vergaderingen staan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove de Pessoas e esquece a voz; o nome continua nas reuniões"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“人员”中移除并忘记其声音；名字会保留在会议中"
          }
        }
      }
    },
