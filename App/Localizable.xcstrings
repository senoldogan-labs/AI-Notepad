            "value": "¿Qué interlocutor eras tú en esta reunión?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka puhujista olit tässä kokouksessa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel intervenant étiez-vous dans cette réunion ?"
