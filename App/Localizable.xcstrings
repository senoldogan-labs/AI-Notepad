    "Leo perşembeye düzeltir; sen cumaya özeti gönderirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo behebt es bis Donnerstag; du sendest die Zusammenfassung bis Freitag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo fixes it by Thursday; you send the recap by Friday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo lo corrige antes del jueves; tú envías el resumen antes del viernes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo korjaa sen torstaihin mennessä; sinä lähetät yhteenvedon perjantaihin mennessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo corrige le bug d’ici jeudi ; vous envoyez le compte rendu d’ici vendredi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo lo corregge entro giovedì; tu invii il riepilogo entro venerdì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Leoが木曜日までに修正し、あなたが金曜日までに要約を送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo가 목요일까지 수정하고, 내가 금요일까지 요약을 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo lost het op vóór donderdag; jij stuurt de samenvatting vóór vrijdag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo corrige até quinta; você envia o resumo até sexta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo 在周四前修复；你在周五前发送摘要。"
          }
        }
      }
    },
    "Paylaşım akışının yayını: önizlemeler büyük toplantılarda hâlâ bozuluyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Release des Teilen-Flows: Vorschauen funktionieren bei großen Meetings noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing flow release: previews still break on large meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzamiento del flujo para compartir: las vistas previas aún fallan en reuniones grandes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakotoiminnon julkaisu: esikatselut eivät vieläkään toimi suurissa kokouksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie du flux de partage : les aperçus ne fonctionnent toujours pas sur les grandes réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascio del flusso di condivisione: le anteprime non funzionano ancora nelle riunioni grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フローのリリース：大規模な会議ではプレビューがまだ正しく動作しない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 흐름 출시: 대규모 회의에서 미리보기가 아직 작동하지 않음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Release van de deelflow: voorbeelden werken nog niet bij grote vergaderingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lançamento do fluxo de compartilhamento: as prévias ainda falham em reuniões grandes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
