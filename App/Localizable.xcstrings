    "Vurgu rengi düğmelerde, ölçerlerde ve seçili sekmede kullanılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akzentfarbe wird für Tasten, Anzeigen und den ausgewählten Tab verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent colour is used for buttons, meters and the selected tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de resalte se usa en los botones, los medidores y la pestaña seleccionada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korostusväriä käytetään painikkeissa, mittareissa ja valitussa välilehdessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur d’accentuation est utilisée pour les boutons, les jauges et l’onglet sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di evidenziazione viene usato per pulsanti, indicatori e scheda selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセントカラーは、ボタン、メーター、選択中のタブに使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 색상은 버튼, 측정기 및 선택된 탭에 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
