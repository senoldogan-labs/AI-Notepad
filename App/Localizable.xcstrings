    "Kilit ekranında süre ve son cümle; Denetim Merkezi ya da Eylem düğmesiyle tek dokunuşla kayıt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit und letzter Satz auf dem Sperrbildschirm; Aufnahme mit einem Tippen im Kontrollzentrum oder über die Aktionstaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time and the latest sentence on the Lock Screen; one-tap recording from Control Center or the Action button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo y la última frase en la pantalla bloqueada; grabación con un toque desde el centro de control o el botón de acción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika ja viimeisin lause lukitulla näytöllä; nauhoitus yhdellä napautuksella Ohjauskeskuksesta tai Toimintopainikkeella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée et la dernière phrase sur l’écran verrouillé ; enregistrement en un geste depuis le centre de contrôle ou le bouton Action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora e ultima frase sulla schermata di blocco; registrazione con un tocco da Centro di Controllo o dal tasto Azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に時間と最新の文を表示。コントロールセンターやアクションボタンからワンタップで録音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 시간과 최신 문장을 표시합니다. 제어 센터나 동작 버튼에서 한 번 탭으로 녹음할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd en de laatste zin op het toegangsscherm; opnemen met één tik vanuit het bedieningspaneel of met de actieknop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo e a frase mais recente na Tela Bloqueada; gravação com um toque pela Central de Controle ou pelo botão de Ação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕上显示时间和最新的一句话；从控制中心或操作按钮一键录制。"
          }
        }
      }
    },
