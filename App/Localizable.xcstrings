            "value": "Atribuir esta parte a"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此部分分配给"
          }
        }
      }
    },
    "Bu cihaz Apple Intelligence'ı desteklemiyor; cihaz içi not yazılamaz. Ayarlar'da kendi anahtarınla bir sağlayıcı seç (ör. Anthropic).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt Apple Intelligence nicht, daher können keine Notizen auf dem Gerät geschrieben werden. Wähle in den Einstellungen einen Anbieter mit eigenem Schlüssel (z. B. Anthropic)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't support Apple Intelligence, so on-device notes can't be written. Choose a provider with your own key in Settings (e.g. Anthropic)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite Apple Intelligence, así que no se pueden escribir notas en el dispositivo. Elige un proveedor con tu propia clave en Ajustes (p. ej., Anthropic)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei tue Apple Intelligencea, joten laitteella tehtäviä muistiinpanoja ei voi kirjoittaa. Valitse Asetuksissa palveluntarjoaja omalla avaimellasi (esim. Anthropic)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge Apple Intelligence ; les notes sur l’appareil ne peuvent donc pas être rédigées. Choisissez un fournisseur avec votre propre clé dans les Réglages (p. ex. Anthropic)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta Apple Intelligence, quindi non è possibile scrivere note sul dispositivo. Scegli un fornitore con la tua chiave in Impostazioni (ad es. Anthropic)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはApple Intelligenceに対応していないため、オンデバイスでノートを作成できません。設定で独自のキーを使うプロバイダ（例：Anthropic）を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 Apple Intelligence를 지원하지 않아 온디바이스 노트를 작성할 수 없습니다. 설정에서 자신의 키를 사용하는 제공업체(예: Anthropic)를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat ondersteunt Apple Intelligence niet, dus notities kunnen niet op het apparaat worden geschreven. Kies in Instellingen een aanbieder met je eigen sleutel (bijv. Anthropic)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não é compatível com a Apple Intelligence, então não é possível escrever notas no dispositivo. Escolha um provedor com sua própria chave em Ajustes (ex.: Anthropic)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持 Apple 智能，因此无法撰写设备端笔记。请在设置中选择使用你自己密钥的提供商（例如 Anthropic）。"
          }
        }
      }
    },
    "Bu cihaz Apple'ın cihaz doğrulamasını (DeviceCheck) desteklemiyor; ücretsiz deneme başlatılamıyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt Apples Geräteprüfung (DeviceCheck) nicht, daher kann der kostenlose Test nicht starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't support Apple's device check (DeviceCheck), so the free trial can't start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite la comprobación de dispositivos de Apple (DeviceCheck), así que no se puede iniciar la prueba gratuita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei tue Applen laitetarkistusta (DeviceCheck), joten ilmaista kokeilujaksoa ei voi aloittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge la vérification d’appareil d’Apple (DeviceCheck) ; l’essai gratuit ne peut donc pas commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta il controllo del dispositivo di Apple (DeviceCheck), quindi la prova gratuita non può iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはAppleのデバイス確認（DeviceCheck）に対応していないため、無料トライアルを開始できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 Apple의 기기 확인(DeviceCheck)을 지원하지 않아 무료 체험을 시작할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat ondersteunt Apples apparaatcontrole (DeviceCheck) niet, dus de gratis proefperiode kan niet starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não é compatível com a verificação de dispositivo da Apple (DeviceCheck), então o teste grátis não pode começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持 Apple 的设备检查（DeviceCheck），因此无法开始免费试用。"
          }
        }
      }
    },
    "Bu dönüş bu girişe ait değil": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Rückkehr gehört nicht zu dieser Anmeldung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This return doesn't belong to this sign-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este retorno no corresponde a este inicio de sesión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä paluu ei kuulu tähän kirjautumiseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce retour ne correspond pas à cette connexion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ritorno non appartiene a questo accesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この戻り先はこのサインインのものではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 응답은 이 로그인에 속하지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze terugkeer hoort niet bij deze aanmelding"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este retorno não pertence a este início de sessão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此返回不属于本次登录"
          }
        }
      }
    },
    "Bu görev aracı artık yok (kaldırılmış); Ayarlar › Bağlantılar'ı yeniden aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Aufgaben-Tool existiert nicht mehr (es wurde entfernt); öffne „Einstellungen“ › „Verbindungen“ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task tool no longer exists (it was removed); reopen Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta herramienta de tareas ya no existe (se ha eliminado); vuelve a abrir Ajustes › Conexiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tehtävätyökalua ei enää ole (se poistettiin); avaa Asetukset › Yhteydet uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet outil de tâches n’existe plus (il a été supprimé) ; rouvrez Réglages › Connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo strumento per le attività non esiste più (è stato rimosso); riapri Impostazioni › Connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクツールは存在しません（削除済み）。「設定」›「連携」を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일 도구는 더 이상 존재하지 않습니다(제거됨). 설정 › 연결을 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taaktool bestaat niet meer (hij is verwijderd); open Instellingen › Koppelingen opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ferramenta de tarefas não existe mais (foi removida); reabra Ajustes › Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务工具已不存在（已被移除）；请重新打开“设置 › 连接”。"
          }
        }
      }
    },
    "Bu hafta kimlerle neler konuştum?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit wem habe ich diese Woche gesprochen, und worüber?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who did I talk to this week, and about what?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con quién hablé esta semana y de qué?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenen kanssa puhuin tällä viikolla, ja mistä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec qui ai-je parlé cette semaine, et de quoi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con chi ho parlato questa settimana, e di cosa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週は誰と何について話した？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 누구와 무엇에 대해 이야기했나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met wie heb ik deze week gesproken, en waarover?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com quem eu falei esta semana e sobre o quê?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周我和谁聊过，聊了什么？"
          }
        }
      }
    },
    "Bu hesabın toplantıları bu Mac'te henüz yok. Uygulamayı bir kez açıp bu hesapla giriş yap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meetings dieses Accounts sind noch nicht auf diesem Mac. Öffne die App einmal und melde dich mit diesem Account an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account's meetings aren't on this Mac yet. Open the app once and sign in with this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones de esta cuenta aún no están en este Mac. Abre la app una vez e inicia sesión con esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tilin kokoukset eivät ole vielä tässä Macissa. Avaa sovellus kerran ja kirjaudu tällä tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions de ce compte ne sont pas encore sur ce Mac. Ouvrez l’app une fois et connectez-vous avec ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni di questo account non sono ancora su questo Mac. Apri l’app una volta e accedi con questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの会議はまだこのMacにありません。アプリを一度開いて、このアカウントでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 회의가 아직 이 Mac에 없습니다. 앱을 한 번 열고 이 계정으로 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergaderingen van dit account staan nog niet op deze Mac. Open de app één keer en log in met dit account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões desta conta ainda não estão neste Mac. Abra o app uma vez e inicie sessão com esta conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的会议尚未在这台 Mac 上。请打开 App 一次并使用此账户登录。"
          }
        }
      }
    },
    "Bu iPhone Apple ile doğrulanamadı (DeviceCheck). İnternet bağlantını kontrol edip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone konnte nicht bei Apple verifiziert werden (DeviceCheck). Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone couldn't be verified with Apple (DeviceCheck). Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar este iPhone con Apple (DeviceCheck). Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä iPhonea ei voitu varmentaa Applen kanssa (DeviceCheck). Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n’a pas pu être vérifié auprès d’Apple (DeviceCheck). Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare questo iPhone con Apple (DeviceCheck). Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneをAppleで確認できませんでした（DeviceCheck）。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 이 iPhone을 확인할 수 없습니다(DeviceCheck). 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPhone kon niet bij Apple worden geverifieerd (DeviceCheck). Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar este iPhone com a Apple (DeviceCheck). Verifique sua conexão com a internet e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Apple 验证这部 iPhone（DeviceCheck）。请检查你的互联网连接后重试。"
          }
        }
      }
    },
    "Bu iPhone Apple tarafından doğrulanamadı; uygulamayı yeniden açıp tekrar dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte dieses iPhone nicht verifizieren; öffne die App erneut und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't verify this iPhone; reopen the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha podido verificar este iPhone; vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ei voinut varmentaa tätä iPhonea; avaa sovellus uudelleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas pu vérifier cet iPhone ; rouvrez l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non è riuscita a verificare questo iPhone; riapri l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleがこのiPhoneを確認できませんでした。アプリを開き直して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 이 iPhone을 확인할 수 없습니다. 앱을 다시 열고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple kon deze iPhone niet verifiëren; open de app opnieuw en probeer het nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não conseguiu verificar este iPhone; reabra o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 无法验证这部 iPhone；请重新打开 App 后重试。"
          }
        }
      }
    },
    "Bu iPhone doğrulanamadı; uygulamayı yeniden açıp tekrar dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
