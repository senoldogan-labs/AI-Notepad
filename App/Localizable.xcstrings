    "Sorun bildirirken işe yarar; kopyalamadıkça hiçbir yere gitmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfreich beim Melden eines Problems; geht nirgendwohin, solange du es nicht kopierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful when reporting a problem; it goes nowhere unless you copy it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil para informar de un problema; no va a ninguna parte salvo que lo copies."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyödyllinen ongelmaa ilmoittaessa; ei lähde minnekään, ellet kopioi sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile pour signaler un problème ; rien n'est envoyé tant que tu ne le copies pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile per segnalare un problema; non va da nessuna parte se non lo copi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を報告するときに役立ちます。コピーしない限りどこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 알릴 때 유용합니다. 복사하지 않으면 어디에도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig bij het melden van een probleem; gaat nergens heen tenzij je het kopieert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil para relatar um problema; não vai a lugar nenhum a menos que você copie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题时有用；除非你复制，否则不会发送到任何地方。"
          }
        }
      }
    },
    "Abonelik": {
