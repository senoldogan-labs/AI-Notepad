    "Tüm sesler unutulsun mu? Toplantılardaki adlar kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Stimmen vergessen? Namen in Meetings bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget all voices? Names in meetings stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidar todas las voces? Los nombres en las reuniones se mantienen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unohdetaanko kaikki äänet? Nimet säilyvät kokouksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier toutes les voix ? Les noms dans les réunions sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimenticare tutte le voci? I nomi nelle riunioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての声を忘れますか？ 会議内の名前は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 음성을 지우겠습니까? 회의의 이름은 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle stemmen vergeten? Namen in vergaderingen blijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer todas as vozes? Os nomes nas reuniões continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要忘记所有声音吗？会议中的名字会保留。"
          }
        }
      }
    },
