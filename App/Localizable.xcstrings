            "value": "移除标签 %@"
          }
        }
      }
    },
    "%@ girişi başka bir denemeden döndü; yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %@ stammt von einem anderen Versuch; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in came back from a different attempt; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de %@ ha vuelto de otro intento; inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kirjautuminen palasi eri yrityksestä; yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ provient d’une autre tentative ; réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a %@ proviene da un tentativo diverso; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のサインインが別の試行から戻ってきました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 로그인이 다른 시도에서 돌아왔습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding bij %@ kwam van een andere poging terug; probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão em %@ voltou de outra tentativa; tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 登录返回自另一次尝试；请重试。"
          }
        }
      }
    },
    "%@ girişi bu sürümde henüz etkin değil. Şimdilik \"Webhook adresi\" kartıyla bağlayabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %@ ist in dieser Version noch nicht verfügbar. Vorerst kannst du dich über die Karte „Webhook-URL“ verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in isn't available in this version yet. For now you can connect with the \"Webhook URL\" card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con %@ aún no está disponible en esta versión. Por ahora puedes conectarte con la tarjeta “URL de webhook”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kirjautuminen ei ole vielä käytettävissä tässä versiossa. Toistaiseksi voit yhdistää ”Webhook-URL”-kortilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ n’est pas encore disponible dans cette version. Pour l’instant, vous pouvez vous connecter avec la carte « URL de webhook »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso con %@ non è ancora disponibile in questa versione. Per ora puoi connetterti con la scheda “URL webhook”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のサインインはこのバージョンではまだ利用できません。現時点では「Webhook URL」カードで接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서는 아직 %@ 로그인을 사용할 수 없습니다. 지금은 \"Webhook URL\" 카드로 연결할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen bij %@ is in deze versie nog niet beschikbaar. Voorlopig kun je koppelen met de kaart \"Webhook-URL\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão em %@ ainda não está disponível nesta versão. Por enquanto, você pode conectar com o cartão \"URL do webhook\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚不支持 %@ 登录。目前你可以通过“Webhook URL”卡片连接。"
          }
        }
      }
    },
    "%@ girişi tamamlanmadı (izin verilmedi). Yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %@ wurde nicht abgeschlossen (Zugriff nicht erteilt). Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in wasn't completed (access not granted). Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha completado el inicio de sesión en %@ (no se concedió el acceso). Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kirjautuminen ei valmistunut (käyttöoikeutta ei myönnetty). Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ n’a pas abouti (accès non accordé). Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a %@ non è stato completato (accesso non concesso). Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のサインインが完了しませんでした（アクセスが許可されていません）。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 로그인이 완료되지 않았습니다(접근 권한이 부여되지 않음). 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen bij %@ is niet voltooid (geen toegang verleend). Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão em %@ não foi concluído (acesso não concedido). Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 登录未完成（未授予访问权限）。请重试。"
          }
        }
      }
    },
    "%@ girişi tamamlanmadı: %@": {
      "localizations": {
