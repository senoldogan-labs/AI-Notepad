        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音仅捕获电脑的音频"
          }
        }
      }
    },
    "Bu kişi bundan sonra sesinden tanınmaz": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person wird nicht mehr an der Stimme erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person will no longer be recognised by voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona ya no se reconocerá por la voz"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä henkilöä ei enää tunnisteta äänestä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne sera plus reconnue à sa voix"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona non verrà più riconosciuta dalla voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人は今後、声で認識されなくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람은 더 이상 목소리로 인식되지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon wordt niet meer aan de stem herkend"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pessoa não será mais reconhecida pela voz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将不再通过声音识别此人"
          }
        }
      }
    },
    "Bu kişilerle ve konuda önceki toplantılar, kararlar, açık görevler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Meetings mit diesen Personen und zu diesem Thema, Entscheidungen, offene Aufgaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier meetings with these people and on this topic, decisions, open tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuniones anteriores con estas personas y sobre este tema, decisiones, tareas abiertas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemmat kokoukset näiden henkilöiden kanssa ja tästä aiheesta, päätökset, avoimet tehtävät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunions précédentes avec ces personnes et sur ce sujet, décisions, tâches ouvertes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunioni precedenti con queste persone e su questo argomento, decisioni, attività aperte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの人やこのトピックに関する過去の会議、決定事項、未完了のタスク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람들과 이 주제에 관한 이전 회의, 결정 사항, 남은 할 일"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere vergaderingen met deze mensen en over dit onderwerp, besluiten, open taken"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuniões anteriores com essas pessoas e sobre este tema, decisões, tarefas em aberto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前与这些人以及关于这个主题的会议、决策、未完成的任务"
          }
        }
      }
    },
    "Bu not bu bağlantıya zaten gönderiliyor; bitmesini bekle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz wird bereits an diese Verbindung gesendet; warte, bis der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note is already being sent to this connection; wait for it to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota ya se está enviando a esta conexión; espera a que termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä muistiinpanoa lähetetään jo tähän yhteyteen; odota, että se valmistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note est déjà en cours d’envoi vers cette connexion ; attendez la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa nota è già in invio a questa connessione; attendi che finisca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノートはすでにこの連携に送信中です。完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트를 이미 이 연결로 보내는 중입니다. 완료될 때까지 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie wordt al naar deze koppeling verstuurd; wacht tot dat klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota já está sendo enviada para esta conexão; aguarde terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔记已在发送到此连接；请等待发送完成。"
          }
        }
      }
    },
    "Bu not sürümü artık geçmişte yok; menüyü yeniden açıp tekrar seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notizversion ist nicht mehr im Verlauf; öffne das Menü erneut und wähle noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note version is no longer in the history; reopen the menu and choose again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de la nota ya no está en el historial; vuelve a abrir el menú y elige de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä muistiinpanon versio ei ole enää historiassa; avaa valikko uudelleen ja valitse uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de la note n’est plus dans l’historique ; rouvrez le menu et choisissez de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione della nota non è più nella cronologia; riapri il menu e scegli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノートのバージョンは履歴にありません。メニューを開き直して、もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트 버전이 더 이상 기록에 없습니다. 메뉴를 다시 열고 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitieversie staat niet meer in de geschiedenis; open het menu opnieuw en kies nogmaals."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão da nota não está mais no histórico; reabra o menu e escolha de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔记版本已不在历史记录中；请重新打开菜单并再次选择。"
          }
        }
      }
    },
    "Bu oturumda hata yok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fehler in dieser Sitzung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No errors in this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay errores en esta sesión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei virheitä tässä istunnossa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune erreur pendant cette session"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun errore in questa sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでエラーはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에 오류 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen fouten in deze sessie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum erro nesta sessão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话没有错误"
          }
        }
      }
    },
    "Bu sürüm cihaz doğrulaması istiyor; uygulamayı güncelle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version erfordert eine Geräteverifizierung; aktualisiere die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version requires device verification; update the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión requiere la verificación del dispositivo; actualiza la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä versio vaatii laitevarmennuksen; päivitä sovellus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version nécessite la vérification de l’appareil ; mettez à jour l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione richiede la verifica del dispositivo; aggiorna l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンではデバイス確認が必要です。アプリをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전은 기기 확인이 필요합니다. 앱을 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie vereist apparaatverificatie; werk de app bij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão requer verificação do dispositivo; atualize o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本需要设备验证；请更新 App。"
          }
        }
      }
    },
    "Bu sürüm sunucuyla uyuşmuyor. Uygulamayı güncelleyip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version passt nicht zum Server. Aktualisiere die App und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version doesn't match the server. Update the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no coincide con el servidor. Actualiza la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä versio ei vastaa palvelinta. Päivitä sovellus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne correspond pas au serveur. Mettez à jour l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non corrisponde al server. Aggiorna l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンはサーバと一致しません。アプリをアップデートして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전이 서버와 일치하지 않습니다. 앱을 업데이트하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie past niet bij de server. Werk de app bij en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não corresponde ao servidor. Atualize o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本与服务器不匹配。请更新 App 后重试。"
          }
        }
      }
    },
    "Bu toplantı artık yok (silinmiş ya da taşınmış); listeyi yenileyip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting existiert nicht mehr (gelöscht oder verschoben); aktualisiere die Liste und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting no longer exists (deleted or moved); refresh the list and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión ya no existe (se ha eliminado o movido); actualiza la lista e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei enää ole (poistettu tai siirretty); päivitä lista ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’existe plus (supprimée ou déplacée) ; actualisez la liste et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione non esiste più (eliminata o spostata); aggiorna l’elenco e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議は存在しません（削除または移動されました）。リストを更新して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의가 더 이상 존재하지 않습니다(삭제되었거나 이동됨). 목록을 새로 고치고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering bestaat niet meer (verwijderd of verplaatst); vernieuw de lijst en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião não existe mais (apagada ou movida); atualize a lista e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议已不存在（已删除或移动）；请刷新列表后重试。"
          }
        }
      }
    },
    "Bu toplantı en çok iki kez yeniden işlenebilir; mevcut metin ve not korunur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting kann höchstens zweimal neu verarbeitet werden; das aktuelle Transkript und die Notiz bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting can be reprocessed at most twice; the current transcript and note are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión puede reprocesarse como máximo dos veces; se conservan la transcripción y la nota actuales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kokouksen voi käsitellä uudelleen enintään kahdesti; nykyinen litterointi ja muistiinpano säilytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion peut être retraitée deux fois au maximum ; la transcription et la note actuelles sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione può essere rielaborata al massimo due volte; la trascrizione e la nota attuali vengono mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議の再処理は最大2回までです。現在の文字起こしとノートは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의는 최대 두 번까지 다시 처리할 수 있습니다. 현재 녹취록과 노트는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kan maximaal twee keer opnieuw worden verwerkt; het huidige transcript en de notitie blijven behouden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião pode ser reprocessada no máximo duas vezes; a transcrição e a nota atuais são mantidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议最多可重新处理两次；当前的文字稿和笔记会保留。"
          }
        }
      }
    },
    "Bu toplantı için katılımcılara gönderilecek kısa bir takip e-postası taslağı yaz: teşekkür, alınan kararlar, kim neyi ne zamana yapacak ve sonraki adım. Konu satırıyla başla. E-postayı toplantının konuşulduğu dilde yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwirf eine kurze Follow-up-E-Mail an die Teilnehmenden dieses Meetings: Dank, getroffene Entscheidungen, wer was bis wann erledigt und der nächste Schritt. Beginne mit einer Betreffzeile. Schreibe die E-Mail in der Sprache, in der das Meeting abgehalten wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft a short follow-up email to the participants of this meeting: thanks, decisions made, who does what by when, and the next step. Start with a subject line. Write the email in the language the meeting was held in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta un breve correo de seguimiento para los participantes de esta reunión: agradecimiento, decisiones tomadas, quién hace qué y para cuándo, y el siguiente paso. Empieza con una línea de asunto. Escribe el correo en el idioma en que se celebró la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadi lyhyt jatkosähköposti tämän kokouksen osallistujille: kiitokset, tehdyt päätökset, kuka tekee mitä ja mihin mennessä sekä seuraava askel. Aloita aiherivillä. Kirjoita sähköposti sillä kielellä, jolla kokous pidettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige un court e-mail de suivi aux participants de cette réunion : remerciements, décisions prises, qui fait quoi et pour quand, et la prochaine étape. Commence par une ligne d’objet. Rédige l’e-mail dans la langue dans laquelle la réunion s’est tenue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una breve email di follow-up ai partecipanti di questa riunione: ringraziamenti, decisioni prese, chi fa cosa ed entro quando, e il passo successivo. Inizia con una riga dell’oggetto. Scrivi l’email nella lingua in cui si è svolta la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議の参加者に送る短いフォローアップメールの下書きを作成してください：お礼、決定事項、誰がいつまでに何をするか、次のステップ。件名から始めてください。メールは会議で使われた言語で書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의 참석자에게 보낼 짧은 후속 이메일 초안을 작성하세요: 감사 인사, 결정 사항, 누가 언제까지 무엇을 할지, 다음 단계. 제목 줄로 시작하세요. 이메일은 회의에서 사용된 언어로 작성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een korte follow-up-e-mail op aan de deelnemers van deze vergadering: bedankje, genomen besluiten, wie wat doet en wanneer, en de volgende stap. Begin met een onderwerpregel. Schrijf de e-mail in de taal waarin de vergadering werd gehouden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunhe um e-mail curto de acompanhamento para os participantes desta reunião: agradecimento, decisões tomadas, quem faz o quê até quando e o próximo passo. Comece com uma linha de assunto. Escreva o e-mail no idioma em que a reunião foi realizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此会议的参与者起草一封简短的跟进邮件：致谢、做出的决策、谁在何时之前做什么，以及下一步。以主题行开头。请使用会议所用的语言撰写邮件。"
          }
        }
      }
    },
    "Bu toplantı silindi": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting wurde gelöscht"
