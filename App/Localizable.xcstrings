            "state": "translated",
            "value": "会議をタグ付けすると、その会議にのみ質問します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 태그하세요 — 질문은 해당 회의에만 전달됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag een vergadering — de vraag gaat alleen naar die vergadering"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma reunião — a pergunta vai só para ela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记一个会议——问题只针对该会议"
          }
        }
      }
    },
