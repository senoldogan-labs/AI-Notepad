    "Bu ekrandayken konuşma yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand hat gesprochen, während dies auf dem Bildschirm war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody spoke while this was on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie habló mientras esto estaba en pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei puhunut, kun tämä oli näytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’a parlé pendant que ceci était à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha parlato mentre questo era sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが画面に表示されている間、誰も話しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면이 표시되는 동안 아무도 말하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand sprak terwijl dit op het scherm stond."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém falou enquanto isto estava na tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容显示在屏幕上时没有人说话。"
          }
        }
      }
    },
    "Bu ekrandayken konuşulanları dinle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhören, was gesagt wurde, während dies auf dem Bildschirm war"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to what was said while this was on screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha lo que se dijo mientras esto estaba en pantalla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntele, mitä sanottiin, kun tämä oli näytöllä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez ce qui a été dit pendant que ceci était à l’écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta ciò che è stato detto mentre questo era sullo schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが画面に表示されていた間に話された内容を聞く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면이 표시되는 동안 나온 말 듣기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luister naar wat er werd gezegd terwijl dit op het scherm stond"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça o que foi dito enquanto isto estava na tela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收听此内容显示在屏幕上时所说的话"
          }
        }
      }
    },
    "Bu görüntüyü kalıcı siler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dieses Bildschirmfoto endgültig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this snapshot"
          }
