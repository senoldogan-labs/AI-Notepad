    "Kayıtlı ses yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gespeicherten Stimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved voices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay voces guardadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tallennettuja ääniä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された声はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 음성이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bewaarde stemmen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma voz salva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已存储的声音。"
          }
        }
      }
    },
    "Kayıtlı sesler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Stimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices"
          }
        },
        "es": {
