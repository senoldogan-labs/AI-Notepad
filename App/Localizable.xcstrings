    "Adın notta sana düşen görevleri ayırır; ana dil canlı metnin hangi dille başlayacağını belirler.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name kennzeichnet deine Aufgaben in der Notiz; die Hauptsprache legt fest, in welcher Sprache der Live-Text beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name marks your tasks in the note; the main language sets which language live text starts in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre identifica tus tareas en la nota; el idioma principal determina en qué idioma empieza el texto en directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi merkitsee tehtäväsi muistiinpanossa; pääkieli määrää, millä kielellä reaaliaikainen teksti alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom permet de repérer vos tâches dans la note ; la langue principale définit la langue de départ du texte en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome contrassegna le tue attività nella nota; la lingua principale determina in quale lingua inizia il testo dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はノート内であなたのタスクを示すのに使われます。メイン言語はライブ文字起こしを開始する言語を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 이름은 노트에서 내 할 일을 표시하는 데 사용됩니다. 주 회의 언어는 실시간 텍스트가 어떤 언어로 시작될지 결정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam markeert je taken in de notitie; de hoofdtaal bepaalt in welke taal de live tekst begint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome marca suas tarefas na nota; o idioma principal define em qual idioma o texto ao vivo começa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字用于在笔记中标记你的任务；主要语言决定实时文字以哪种语言开始。"
          }
        }
      }
    },
    "Adın notta sana düşen görevleri ayırır; canlı metni bulutta ya da bu Mac'te yazdırırsın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name kennzeichnet deine Aufgaben in der Notiz; der Live-Text läuft in der Cloud oder auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name marks your tasks in the note; live text runs in the cloud or on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre identifica tus tareas en la nota; el texto en directo funciona en la nube o en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi merkitsee tehtäväsi muistiinpanossa; reaaliaikainen teksti toimii pilvessä tai tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom permet de repérer vos tâches dans la note ; le texte en direct est produit dans le cloud ou sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome contrassegna le tue attività nella nota; il testo dal vivo funziona nel cloud o su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はノート内であなたのタスクを示すのに使われます。ライブ文字起こしはクラウドまたはこのMac上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 이름은 노트에서 내 할 일을 표시하는 데 사용됩니다. 실시간 텍스트는 클라우드 또는 이 Mac에서 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam markeert je taken in de notitie; live tekst draait in de cloud of op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome marca suas tarefas na nota; o texto ao vivo roda na nuvem ou neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字用于在笔记中标记你的任务；实时文字在云端或在这台 Mac 上运行。"
          }
        }
      }
    },
    "Adın ve canlı metin motoru": {
