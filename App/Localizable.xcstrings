    "Bugün başlatılabilecek toplantı sayısına ulaştın; yarın yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das heutige Meeting-Limit erreicht; versuche es morgen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached today's meeting limit; try again tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de reuniones de hoy; inténtalo de nuevo mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut tämän päivän kokousrajan; yritä huomenna uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite de réunions du jour ; réessayez demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di riunioni di oggi; riprova domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の会議数の上限に達しました。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 회의 한도에 도달했습니다. 내일 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de vergaderlimiet van vandaag bereikt; probeer het morgen opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de reuniões de hoje; tente de novo amanhã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到今天的会议限额；请明天再试。"
          }
        }
      }
    },
    "Bugün biten toplantılar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früher heute"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, más temprano"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemmin tänään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tôt aujourd’hui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi, prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の早い時間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 이전"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerder vandaag"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais cedo hoje"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天早些时候"
          }
        }
      }
    },
    "Bugün ve yarın için hazırlan: son toplantılarda verdiğim sözler ve bana düşen açık işler, bekleyen kararlar ve takip etmem gereken kişiler. Kısa maddeler halinde, önceliğe göre.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite mich auf heute und morgen vor: Zusagen, die ich in den letzten Meetings gemacht habe, meine offenen Aufgaben, ausstehende Entscheidungen und Personen, bei denen ich nachhaken sollte. Kurze Stichpunkte, nach Priorität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare me for today and tomorrow: promises I made in recent meetings, my open tasks, pending decisions and people I should follow up with. Short bullets, by priority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárame para hoy y mañana: las promesas que hice en reuniones recientes, mis tareas abiertas, las decisiones pendientes y las personas a las que debo hacer seguimiento. Viñetas breves, por prioridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistele minut tähän päivään ja huomiseen: lupaukset, jotka tein viimeaikaisissa kokouksissa, avoimet tehtäväni, odottavat päätökset ja ihmiset, joihin minun pitäisi olla yhteydessä. Lyhyet luettelokohdat tärkeysjärjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare-moi pour aujourd’hui et demain : les promesses que j’ai faites lors des dernières réunions, mes tâches ouvertes, les décisions en attente et les personnes que je dois relancer. Points courts, par priorité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparami per oggi e domani: promesse che ho fatto nelle ultime riunioni, le mie attività aperte, decisioni in sospeso e persone che dovrei ricontattare. Punti brevi, per priorità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日と明日の準備を手伝ってください：最近の会議で私が約束したこと、未完了のタスク、保留中の決定事項、フォローアップすべき人。優先度順に短い箇条書きで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘과 내일을 준비할 수 있게 도와주세요: 최근 회의에서 내가 한 약속, 남은 할 일, 보류 중인 결정 사항, 후속 연락이 필요한 사람. 우선순위별로 짧은 글머리 기호로 정리해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid me voor op vandaag en morgen: beloftes die ik in recente vergaderingen heb gedaan, mijn open taken, openstaande besluiten en mensen bij wie ik moet nahaken. Korte opsommingstekens, op prioriteit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-me para hoje e amanhã: promessas que fiz em reuniões recentes, minhas tarefas em aberto, decisões pendentes e pessoas com quem devo retomar contato. Tópicos curtos, por prioridade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我为今天和明天做准备：我在最近会议中做出的承诺、我未完成的任务、待定的决策，以及我需要跟进的人。用简短的要点，按优先级排列。"
          }
        }
      }
    },
    "Bugün çok fazla rapor gönderildi; yarın yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute wurden zu viele Berichte gesendet; versuche es morgen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many reports were sent today; try again tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy se han enviado demasiados informes; inténtalo de nuevo mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänään on lähetetty liian monta raporttia; yritä huomenna uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de rapports ont été envoyés aujourd’hui ; réessayez demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi sono stati inviati troppi rapporti; riprova domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日送信されたレポートが多すぎます。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 너무 많은 보고서가 전송되었습니다. 내일 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn vandaag te veel rapporten verstuurd; probeer het morgen opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos relatórios foram enviados hoje; tente de novo amanhã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天发送的报告过多；请明天再试。"
          }
        }
      }
    },
