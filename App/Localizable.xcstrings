    "Toplantıların ve notların bu Mac'te kalır. Yeni toplantıları kaydetmek için abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meetings und Notizen bleiben auf diesem Mac. Schließe ein Abo ab, um neue Meetings aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meetings and notes stay on this Mac. Subscribe to record new meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones y notas se quedan en este Mac. Suscríbete para grabar reuniones nuevas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksesi ja muistiinpanosi säilyvät tässä Macissa. Tilaa, niin voit nauhoittaa uusia kokouksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions et notes restent sur ce Mac. Abonnez-vous pour enregistrer de nouvelles réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni e le note restano su questo Mac. Abbonati per registrare nuove riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議とノートはこのMacに残ります。新しい会議を録音するには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의와 노트는 이 Mac에 보관됩니다. 새 회의를 녹음하려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vergaderingen en notities blijven op deze Mac. Neem een abonnement om nieuwe vergaderingen op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões e notas continuam neste Mac. Assine para gravar novas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会议和笔记保留在这台 Mac 上。订阅即可录制新会议。"
          }
        }
      }
    },
