    "Bu iPhone'da çıkış yapıldı. Sunucuya ulaşılamadı; sunucudaki oturum en geç 60 gün içinde kendiliğinden kapanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone abgemeldet. Der Server war nicht erreichbar; die Sitzung auf dem Server endet von selbst innerhalb von 60 Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this iPhone. The server couldn't be reached; the session on the server ends on its own within 60 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada en este iPhone. No se ha podido acceder al servidor; la sesión en el servidor finalizará sola en un plazo de 60 días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduttu ulos tässä iPhonessa. Palvelimeen ei saatu yhteyttä; istunto palvelimella päättyy itsestään 60 päivän kuluessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté sur cet iPhone. Le serveur était injoignable ; la session sur le serveur se fermera d’elle-même d’ici 60 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnesso su questo iPhone. Il server non è raggiungibile; la sessione sul server terminerà da sola entro 60 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでサインアウトしました。サーバに接続できませんでしたが、サーバ上のセッションは60日以内に自動的に終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 로그아웃했습니다. 서버에 연결할 수 없었습니다. 서버의 세션은 60일 이내에 자동으로 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgelogd op deze iPhone. De server was niet bereikbaar; de sessie op de server eindigt vanzelf binnen 60 dagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão encerrada neste iPhone. Não foi possível acessar o servidor; a sessão no servidor se encerra sozinha em até 60 dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在这部 iPhone 上退出登录。无法连接服务器；服务器上的会话会在 60 天内自动结束。"
          }
        }
      }
    },
    "Bu iPhone'da ücretsiz deneme başka bir hesapla kullanıldı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Test auf diesem iPhone wurde mit einem anderen Account genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial on this iPhone was used with another account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita de este iPhone se usó con otra cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPhonen ilmainen kokeilujakso käytettiin toisella tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit de cet iPhone a été utilisé avec un autre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita su questo iPhone è stata usata con un altro account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの無料トライアルは別のアカウントで使用されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 무료 체험은 다른 계정에서 사용되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis proefperiode op deze iPhone is met een ander account gebruikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis neste iPhone foi usado com outra conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 上的免费试用已被另一个账户使用。"
          }
        }
      }
    },
    "Bu iPhone'da ücretsiz deneme daha önce başka bir hesapla kullanıldı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Test auf diesem iPhone wurde bereits mit einem anderen Account genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial on this iPhone was already used with another account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita de este iPhone ya se usó con otra cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPhonen ilmainen kokeilujakso on jo käytetty toisella tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit de cet iPhone a déjà été utilisé avec un autre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita su questo iPhone è già stata usata con un altro account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの無料トライアルは別のアカウントですでに使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 무료 체험은 이미 다른 계정에서 사용되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis proefperiode op deze iPhone is al met een ander account gebruikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis neste iPhone já foi usado com outra conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 上的免费试用已被另一个账户使用过。"
          }
        }
      }
    },
    "Bu işlem için abonelik gerekiyor. Ayarlar › Hesap'tan abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür ist ein Abo nötig. Schließe es unter „Einstellungen“ › „Account“ ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requires a subscription. Subscribe in Settings › Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto requiere una suscripción. Suscríbete en Ajustes › Cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vaatii tilauksen. Tilaa kohdassa Asetukset › Tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement est nécessaire. Abonnez-vous dans Réglages › Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un abbonamento. Abbonati in Impostazioni › Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが必要です。「設定」›「アカウント」で登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 필요합니다. 설정 › 계정에서 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is een abonnement nodig. Neem een abonnement in Instellingen › Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto requer uma assinatura. Assine em Ajustes › Conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能需要订阅。请在“设置 › 账户”中订阅。"
          }
        }
      }
    },
    "Bu işlem için hesabında etkin bir plan gerekiyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür ist ein aktiver Tarif in deinem Account nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs an active plan on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto requiere un plan activo en tu cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vaatii tililtäsi voimassa olevan tilauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un forfait actif est nécessaire sur votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un piano attivo sul tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントで有効なプランが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 활성 플랜이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is een actief abonnement op je account nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto requer um plano ativo na sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能需要你的账户有有效的方案。"
          }
        }
      }
    },
    "Bu işleme izin yok.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist nicht erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action isn't allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no está permitida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto ei ole sallittu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action n’est pas autorisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non è consentita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は許可されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 허용되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie is niet toegestaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não é permitida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许此操作。"
          }
        }
      }
    },
    "Bu kayıt başka bir hesapla yapıldı; o hesapla giriş yapınca işlenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme wurde mit einem anderen Account erstellt; sie wird verarbeitet, wenn du dich mit diesem Account anmeldest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording was made with another account; it will be processed when you sign in with that account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación se hizo con otra cuenta; se procesará cuando inicies sesión con esa cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä nauhoite tehtiin toisella tilillä; se käsitellään, kun kirjaudut kyseisellä tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement a été fait avec un autre compte ; il sera traité lorsque vous vous connecterez avec ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione è stata fatta con un altro account; verrà elaborata quando accederai con quell’account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音は別のアカウントで行われました。そのアカウントでサインインすると処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음은 다른 계정으로 만들어졌습니다. 해당 계정으로 로그인하면 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opname is met een ander account gemaakt; hij wordt verwerkt als je met dat account inlogt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação foi feita com outra conta; ela será processada quando você iniciar sessão com essa conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音是用另一个账户录制的；使用该账户登录后会进行处理。"
          }
        }
      }
    },
    "Bu kayıt yalnızca bilgisayardan gelen sesi alıyor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme erfasst nur Audio vom Computer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording only captures audio from the computer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación solo capta el audio del ordenador"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä nauhoitus tallentaa vain tietokoneen äänen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement ne capte que l’audio de l’ordinateur"
