    "~%lld MB; bir kez indirilir, kayıtlar bu iPhone'da işlenir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. %lld MB; wird einmal geladen, Aufnahmen werden auf diesem iPhone verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld MB; downloaded once, recordings are processed on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld MB; se descarga una vez y las grabaciones se procesan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld Mt; ladataan kerran, nauhoitteet käsitellään tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld Mo ; téléchargé une seule fois, les enregistrements sont traités sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld MB; scaricato una volta, le registrazioni vengono elaborate su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%lld MB。一度ダウンロードすれば、録音はこのiPhoneで処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %lldMB. 한 번만 다운로드하면 녹음이 이 iPhone에서 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld MB; wordt één keer gedownload, opnamen worden op deze iPhone verwerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lld MB; baixado uma vez, as gravações são processadas neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %lld MB；只需下载一次，录音会在这部 iPhone 上处理。"
          }
        }
      }
    },
