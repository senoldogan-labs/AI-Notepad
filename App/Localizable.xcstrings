            "value": "Envía el audio a Gistsmith"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä ääni Gistsmithiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez l’audio à Gistsmith"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia l’audio a Gistsmith"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオをGistsmithに送る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 Gistsmith로 보내기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur de audio naar Gistsmith"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie o áudio ao Gistsmith"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将音频发送到 Gistsmith"
          }
        }
      }
    },
    "Görüşme bitince kaydı Notlar'da aç, sesi paylaş ve Gistsmith'i seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne nach dem Gespräch die Aufnahme in Notizen, teile das Audio und wähle Gistsmith."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the call ends, open the recording in Notes, share the audio and choose Gistsmith."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termine la llamada, abre la grabación en Notas, comparte el audio y elige Gistsmith."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun puhelu päättyy, avaa nauhoitus Muistiinpanoissa, jaa ääni ja valitse Gistsmith."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin de l’appel, ouvrez l’enregistrement dans Notes, partagez l’audio et choisissez Gistsmith."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine della chiamata, apri la registrazione in Note, condividi l’audio e scegli Gistsmith."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話が終わったら「メモ」で録音を開き、オーディオを共有してGistsmithを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화가 끝나면 메모에서 녹음을 열고 오디오를 공유한 다음 Gistsmith를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open na het gesprek de opname in Notities, deel de audio en kies Gistsmith."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a ligação terminar, abra a gravação no Notas, compartilhe o áudio e escolha o Gistsmith."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话结束后，在“备忘录”中打开录音，共享音频并选择 Gistsmith。"
          }
        }
      }
    },
    "Not hazır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notiz ist fertig"
          }
        },
        "en": {
