    "Deneme bitti; yeni toplantılar için abone ol. Toplantıların ve notların bu Mac'te kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist beendet; schließe für neue Meetings ein Abo ab. Deine Meetings und Notizen bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended; subscribe for new meetings. Your meetings and notes stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha finalizado; suscríbete para tener reuniones nuevas. Tus reuniones y notas se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujaksosi on päättynyt; tilaa uusia kokouksia varten. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé ; abonnez-vous pour de nouvelles réunions. Vos réunions et notes restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova è terminata; abbonati per nuove riunioni. Le riunioni e le note restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了しました。新しい会議には登録が必要です。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되었습니다. 새 회의를 녹음하려면 구독하세요. 회의와 노트는 이 Mac에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode is afgelopen; neem een abonnement voor nieuwe vergaderingen. Je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou; assine para novas reuniões. Suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的试用已结束；订阅后即可录制新会议。你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
    "Deneme ilk toplantınla başlar ve %lld gün sürer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase beginnt mit deinem ersten Meeting und dauert %lld Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial starts with your first meeting and lasts %lld days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba empieza con tu primera reunión y dura %lld días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujakso alkaa ensimmäisestä kokouksestasi ja kestää %lld päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai commence avec votre première réunion et dure %lld jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova inizia con la tua prima riunione e dura %lld giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルは最初の会議から始まり、%lld日間続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험은 첫 회의부터 시작되며 %lld일 동안 지속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proefperiode begint bij je eerste vergadering en duurt %lld dagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste começa com sua primeira reunião e dura %lld dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用从你的第一个会议开始，持续 %lld 天。"
          }
        }
      }
    },
    "Deneme ilk toplantıyla başlar: %@, hangisi önce dolarsa.": {
