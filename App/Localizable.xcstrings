    "\"%@\" toplantısı öncesi brifing: Bu konuda önceki toplantılarda neler konuşuldu, hangi kararlar alındı, hangi görevler hâlâ açık? Kısa maddelerle, en yeniden başlayarak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing für „%@“: Was wurde in früheren Meetings zu diesem Thema besprochen, was wurde entschieden und welche Aufgaben sind noch offen? Kurze Stichpunkte, neueste zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing for \"%@\" : what was discussed in earlier meetings on this topic, what was decided and which tasks are still open? Short bullet points, newest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe previo de “%@”: ¿qué se trató en reuniones anteriores sobre este tema, qué se decidió y qué tareas siguen abiertas? Viñetas breves, de la más reciente a la más antigua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustakatsaus aiheesta ”%@”: mitä aiemmissa tätä aihetta käsitelleissä kokouksissa keskusteltiin, mitä päätettiin ja mitkä tehtävät ovat yhä avoinna? Lyhyet luettelokohdat, uusimmat ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing pour « %@ » : qu’est-ce qui a été abordé lors des réunions précédentes sur ce sujet, qu’est-ce qui a été décidé et quelles tâches sont encore ouvertes ? Points courts, du plus récent au plus ancien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing per “%@”: cosa è stato discusso nelle riunioni precedenti su questo argomento, cosa è stato deciso e quali attività sono ancora aperte? Punti elenco brevi, dal più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のブリーフィング：このトピックについて過去の会議で話し合われたこと、決定事項、まだ未完了のタスクは？ 短い箇条書きで、新しい順に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 브리핑: 이 주제에 관한 이전 회의에서 무엇이 논의되었고, 무엇이 결정되었으며, 어떤 할 일이 아직 남아 있나요? 최신 항목부터 짧은 글머리 기호로 정리해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing voor \"%@\": wat is er in eerdere vergaderingen over dit onderwerp besproken, wat is er besloten en welke taken staan nog open? Korte opsommingstekens, nieuwste eerst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing para \"%@\" : o que foi discutido em reuniões anteriores sobre este tema, o que foi decidido e quais tarefas ainda estão em aberto? Tópicos curtos, os mais recentes primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”简报：之前关于这个主题的会议讨论了什么、做出了哪些决策、哪些任务仍未完成？请用简短的要点列出，最新的在前。"
          }
        }
      }
    },
    "\"Başlat\"a bas; konuşmalar burada canlı yazıya dökülür, bitince toplantının notu hazırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Starten“: Das Gespräch wird hier live transkribiert, und am Ende wird die Meeting-Notiz erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press \"Start\" : the conversation is transcribed here live, and the meeting note is prepared when it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa “Iniciar”: la conversación se transcribe aquí en directo y la nota de la reunión se prepara al terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ”Aloita”: keskustelu litteroidaan tähän reaaliajassa, ja kokousmuistiinpano laaditaan, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Démarrer » : la conversation est transcrite ici en direct, et la note de réunion est préparée à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi “Avvia”: la conversazione viene trascritta qui dal vivo e la nota della riunione viene preparata al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「開始」を押すと、会話がここにリアルタイムで文字起こしされ、終了すると会議ノートが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"시작\"을 누르세요. 대화가 여기에서 실시간으로 텍스트로 변환되고, 회의가 끝나면 회의 노트가 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op \"Start\": het gesprek wordt hier live uitgeschreven en de vergadernotitie wordt gemaakt als het afgelopen is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Iniciar\" : a conversa é transcrita aqui ao vivo e a nota da reunião é preparada quando ela termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下“开始”：对话会在这里实时转写成文字，结束后会生成会议笔记。"
          }
        }
      }
    },
    "\"Klasöre yaz\" açıkken not hazır olunca ve her değişince bu klasöre yazılır; eski notları toplantının ⋯ menüsünden kaydet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „In Ordner schreiben“ an, wird die Notiz in diesen Ordner geschrieben, sobald sie fertig ist und bei jeder Änderung; ältere Notizen speicherst du über das ⋯-Menü des Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With \"Write to folder\" on, the note is written to this folder when it's ready and whenever it changes; save older notes from the meeting's ⋯ menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Escribir en una carpeta» activado, la nota se escribe en esta carpeta cuando está lista y cada vez que cambia; guarda las notas anteriores desde el menú ⋯ de la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ”Kirjoita kansioon” on päällä, muistiinpano kirjoitetaan tähän kansioon, kun se on valmis, ja aina kun se muuttuu; tallenna vanhemmat muistiinpanot kokouksen ⋯-valikosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Écrire dans un dossier » activé, la note est écrite dans ce dossier dès qu’elle est prête et à chaque modification ; enregistrez les notes plus anciennes depuis le menu ⋯ de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con “Scrivi nella cartella” attivo, la nota viene scritta in questa cartella quando è pronta e a ogni modifica; salva le note precedenti dal menu ⋯ della riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フォルダに書き込む」がオンのとき、ノートは準備ができた時点と変更のたびにこのフォルダに書き込まれます。以前のノートは会議の⋯メニューから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"폴더에 쓰기\"가 켜져 있으면 노트가 준비될 때와 변경될 때마다 이 폴더에 기록됩니다. 이전 노트는 회의의 ⋯ 메뉴에서 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met \"Schrijf naar map\" aan wordt de notitie naar deze map geschreven zodra ze klaar is en bij elke wijziging; bewaar oudere notities via het ⋯-menu van de vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com \"Gravar na pasta\" ativado, a nota é gravada nesta pasta quando fica pronta e sempre que muda; salve notas anteriores pelo menu ⋯ da reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“写入文件夹”后，笔记在准备好时以及每次更改时都会写入此文件夹；较早的笔记请从会议的 ⋯ 菜单中保存。"
          }
        }
      }
    },
    "\"Ne kaçırdım?\" son %lld dakikayı özetler": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "„Was habe ich verpasst?“ fasst die letzte %lld Minute zusammen"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "„Was habe ich verpasst?“ fasst die letzten %lld Minuten zusammen"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"What did I miss?\" summarizes the last %lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"What did I miss?\" summarizes the last %lld minutes"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“¿Qué me he perdido?” resume el último %lld minuto"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“¿Qué me he perdido?” resume los últimos %lld minutos"
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "”Mitä jäi välistä?” tiivistää viimeisen %lld minuutin"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "”Mitä jäi välistä?” tiivistää viimeiset %lld minuuttia"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« Qu’ai-je manqué ? » résume la période récente : %lld min"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« Qu’ai-je manqué ? » résume les %lld dernières minutes"
