    "Arayüz dili iPhone Ayarları › %@ › Dil bölümünden değişir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Sprache der Oberfläche in den iPhone-Einstellungen unter „%@“ › „Sprache“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the interface language in iPhone Settings › %@ › Language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el idioma de la interfaz en Ajustes del iPhone › %@ › Idioma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda käyttöliittymän kieli iPhonen kohdassa Asetukset › %@ › Kieli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez la langue de l’interface dans Réglages de l’iPhone › %@ › Langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la lingua dell’interfaccia in Impostazioni di iPhone › %@ › Lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスの言語は、iPhoneの「設定」›「%@」›「言語」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정 › %@ › 언어에서 인터페이스 언어를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig de interfacetaal in Instellingen › %@ › Taal op de iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o idioma da interface em Ajustes do iPhone › %@ › Idioma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone“设置 › %@ › 语言”中更改界面语言。"
          }
        }
      }
    },
    "Arayüz dili iPhone Ayarları › %@ › Dil'den değişir. Dil satırı yoksa önce iPhone Ayarları › Genel › Dil ve Bölge'ye ikinci bir dil ekle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Sprache der Oberfläche in den iPhone-Einstellungen unter „%@“ › „Sprache“. Fehlt die Zeile „Sprache“, füge zuerst unter „Allgemein“ › „Sprache & Region“ eine zweite Sprache hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the interface language in iPhone Settings › %@ › Language. If there's no Language row, first add a second language in iPhone Settings › General › Language & Region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el idioma de la interfaz en Ajustes del iPhone › %@ › Idioma. Si no aparece la fila Idioma, añade primero un segundo idioma en Ajustes › General › Idioma y región."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda käyttöliittymän kieli iPhonen kohdassa Asetukset › %@ › Kieli. Jos Kieli-riviä ei ole, lisää ensin toinen kieli kohdassa Asetukset › Yleiset › Kieli ja alue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez la langue de l’interface dans Réglages de l’iPhone › %@ › Langue. S’il n’y a pas de ligne Langue, ajoutez d’abord une deuxième langue dans Réglages › Général › Langue et région."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la lingua dell’interfaccia in Impostazioni di iPhone › %@ › Lingua. Se la riga Lingua non c’è, aggiungi prima una seconda lingua in Impostazioni › Generali › Lingua e zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスの言語は、iPhoneの「設定」›「%@」›「言語」で変更できます。「言語」の項目がない場合は、先に「設定」›「一般」›「言語と地域」で2つ目の言語を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정 › %@ › 언어에서 인터페이스 언어를 변경하세요. 언어 항목이 없으면 먼저 설정 › 일반 › 언어 및 지역에서 두 번째 언어를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig de interfacetaal in Instellingen › %@ › Taal op de iPhone. Staat er geen rij Taal, voeg dan eerst een tweede taal toe in Instellingen › Algemeen › Taal en regio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o idioma da interface em Ajustes do iPhone › %@ › Idioma. Se não houver a linha Idioma, adicione antes um segundo idioma em Ajustes › Geral › Idioma e Região."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone“设置 › %@ › 语言”中更改界面语言。如果没有“语言”一行，请先在“设置 › 通用 › 语言与地区”中添加第二种语言。"
          }
        }
      }
    },
    "Arayüz dilini, tanıma motorunu, görünümü, yapay zekâ modellerini, anahtarları, sesle yazmayı ve kısayolları yönet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Sprache der Oberfläche, Erkennungs-Engine, Erscheinungsbild, KI-Modelle, Schlüssel, Spracheingabe und Kurzbefehle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage the interface language, recognition engine, appearance, AI models, keys, voice typing and shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona el idioma de la interfaz, el motor de reconocimiento, el aspecto, los modelos de IA, las claves, la escritura por voz y los atajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse käyttöliittymän kieltä, tunnistusmoottoria, ulkoasua, tekoälymalleja, avaimia, puhekirjoitusta ja pikanäppäimiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez la langue de l’interface, le moteur de reconnaissance, l’apparence, les modèles d’IA, les clés, la saisie vocale et les raccourcis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci lingua dell’interfaccia, motore di riconoscimento, aspetto, modelli AI, chiavi, scrittura vocale e abbreviazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスの言語、認識エンジン、外観、AIモデル、キー、音声入力、ショートカットを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 언어, 인식 엔진, 외관, AI 모델, 키, 음성 입력 및 단축키를 관리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer de interfacetaal, herkenningsengine, weergave, AI-modellen, sleutels, spraaktypen en toetscombinaties."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie o idioma da interface, o mecanismo de reconhecimento, a aparência, os modelos de IA, as chaves, a digitação por voz e os atalhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理界面语言、识别引擎、外观、AI 模型、密钥、语音输入和快捷键。"
          }
        }
      }
    },
    "Arayüz yazısı düğmeleri ve listeleri, okuma metni notu ve transkripti değiştirir; alt boşluk kayıttaki canlı metnin altında kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text der Oberfläche ändert die Größe von Tasten und Listen, der Lesetext die von Notizen und Transkripten; der Abstand unten bleibt bei der Aufnahme unter dem Live-Transkript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface text resizes buttons and lists; reading text resizes notes and transcripts; bottom spacing stays below the live transcript while recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de la interfaz cambia el tamaño de botones y listas, el texto de lectura el de notas y transcripciones; el espacio inferior queda debajo de la transcripción en directo al grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöliittymän teksti muuttaa painikkeiden ja listojen kokoa, lukuteksti muistiinpanojen ja litterointien kokoa; alareunan väli jää tallennuksen aikana reaaliaikaisen litteroinnin alle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte de l’interface redimensionne les boutons et les listes, le texte de lecture les notes et les transcriptions ; la marge inférieure reste sous la transcription en direct pendant l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo dell’interfaccia ridimensiona pulsanti ed elenchi, il testo di lettura note e trascrizioni; la spaziatura inferiore resta sotto la trascrizione dal vivo durante la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスのテキストはボタンとリストのサイズを、読み物のテキストはノートと文字起こしのサイズを変更します。下部の余白は録音中のライブ文字起こしの下に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 텍스트는 버튼과 목록의 크기를, 읽기 텍스트는 노트와 녹취록의 크기를 조절합니다. 아래쪽 여백은 녹음 중 실시간 녹취록 아래에 들어갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfacetekst wijzigt de grootte van knoppen en lijsten, leestekst die van notities en transcripten; de ruimte onderaan blijft tijdens het opnemen onder het live transcript."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto da interface redimensiona botões e listas, o texto de leitura redimensiona notas e transcrições; o espaçamento inferior fica abaixo da transcrição ao vivo durante a gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面文字调整按钮和列表的大小，阅读文字调整笔记和文字稿的大小；底部间距在录制时位于实时文字稿下方。"
          }
        }
      }
    },
