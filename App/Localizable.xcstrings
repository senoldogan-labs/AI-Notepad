    },
    "Örnek toplantı Toplantılar'a saklanamadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel-Meeting konnte nicht unter „Meetings“ gesichert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the sample meeting to Meetings: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la reunión de ejemplo en Reuniones: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkkikokouksen tallentaminen Kokouksiin epäonnistui: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
