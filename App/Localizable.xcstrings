    "Bu kişi kaldırılmış olabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person wurde möglicherweise entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person may have been removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que esta persona se haya eliminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä henkilö on ehkä poistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne a peut-être été retirée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona potrebbe essere stata rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物は削除された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람이 제거되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon is mogelijk verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pessoa pode ter sido removida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此人可能已被移除。"
          }
        }
      }
    },
    "Kişiler'den kaldırılsın mı? Toplantılardaki adı kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus „Personen“ entfernen? Der Name bleibt in deinen Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from People? Their name stays in your meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar de Personas? Su nombre se mantiene en tus reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko henkilöistä? Nimi säilyy kokouksissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer de Personnes ? Son nom reste dans vos réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere da Persone? Il suo nome resta nelle tue riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」から削除しますか？ 名前は会議に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람에서 제거하겠습니까? 회의에는 이름이 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen uit Personen? De naam blijft in je vergaderingen staan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover de Pessoas? O nome continua nas suas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从“人员”中移除吗？其名字会保留在你的会议中。"
          }
        }
      }
    },
    "Kayıt için önce uygulamayı aç ve yapay zekâ kullanımını onayla.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App und akzeptiere den KI-Hinweis, bevor du aufnimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app and accept the AI notice before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app y acepta el aviso sobre la IA antes de grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa sovellus ja hyväksy tekoälyilmoitus ennen nauhoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app et acceptez l’avis sur l’IA avant d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’app e accetta l’avviso sull’AI prima di registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音する前に、アプリを開いてAIに関するお知らせに同意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하기 전에 앱을 열고 AI 안내에 동의하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app en accepteer de AI-melding voordat je opneemt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app e aceite o aviso de IA antes de gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制前请打开 App 并接受 AI 声明。"
          }
        }
      }
    },
    "Bir ekran görüntüsü okunamadı ya da küçültülemedi. Ekranlar sekmesinden o görüntüyü nottan çıkarıp ya da silip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bildschirmfoto konnte nicht gelesen oder verkleinert werden. Wähle es für die Notiz ab oder lösche es im Tab „Bildschirme“ des Meetings und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen snapshot couldn't be read or downscaled. Untick it for the note or delete it on the meeting's Screens tab, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer o reducir una captura de pantalla. Desmárcala para la nota o elimínala en la pestaña Pantallas de la reunión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttökuvaa ei voitu lukea tai pienentää. Poista sen valinta muistiinpanoa varten tai poista se kokouksen Näytöt-välilehdellä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture d’écran n’a pas pu être lue ou réduite. Décochez-la pour la note ou supprimez-la dans l’onglet Écrans de la réunion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere o ridimensionare un’istantanea dello schermo. Deselezionala per la nota o eliminala nella scheda Schermate della riunione, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面スナップショットを読み取れないか、縮小できませんでした。ノート用のチェックを外すか、会議の「画面」タブで削除してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 스냅샷을 읽거나 축소할 수 없습니다. 노트용 선택을 해제하거나 회의의 화면 탭에서 삭제한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schermafbeelding kon niet worden gelezen of verkleind. Vink hem uit voor de notitie of verwijder hem op het tabblad Schermen van de vergadering en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler ou reduzir uma captura de tela. Desmarque-a para a nota ou apague-a na aba Telas da reunião e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取或缩小某张屏幕快照。请在会议的“屏幕”标签页中取消勾选它用于笔记，或将其删除，然后重试。"
          }
        }
      }
    },
    "Notlarda ekran görüntülerini kullan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos in Notizen verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use screen snapshots in notes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar capturas de pantalla en las notas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä näyttökuvia muistiinpanoissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les captures d’écran dans les notes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le istantanee dello schermo nelle note"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートで画面スナップショットを使用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에 화면 스냅샷 사용"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik schermafbeeldingen in notities"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar capturas de tela nas notas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在笔记中使用屏幕快照"
          }
        }
      }
    },
    "Görüntü alınması için \"Paylaşılan ekranın görüntülerini al\" da açık olmalı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos werden nur aufgenommen, wenn auch „Bildschirmfotos des geteilten Bildschirms aufnehmen“ aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots are only taken when \"Take snapshots of the shared screen\" is on too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas solo se hacen si “Capturar la pantalla compartida” también está activado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttökuvia otetaan vain, kun myös ”Ota kuvia jaetusta näytöstä” on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures ne sont prises que si « Prendre des captures de l’écran partagé » est aussi activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istantanee vengono acquisite solo se è attivo anche “Acquisisci istantanee dello schermo condiviso”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットは、「共有画面のスナップショットを撮る」もオンの場合にのみ撮影されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷은 \"공유된 화면의 스냅샷 찍기\"도 켜져 있을 때만 찍힙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen worden alleen gemaakt als \"Maak schermafbeeldingen van het gedeelde scherm\" ook aanstaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas só são feitas quando \"Fazer capturas da tela compartilhada\" também está ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在“为共享屏幕拍摄快照”也打开时才会拍摄快照。"
          }
        }
      }
    },
    "Notta": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Notiz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In note"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la nota"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanossa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la note"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella nota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートに使用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에 포함"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In notitie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na nota"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于笔记"
          }
        }
      }
    },
    "Not yazılırken bu görüntü gönderilebilir; kaldırınca gönderilmez": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bildschirmfoto wird eventuell beim Schreiben der Notiz gesendet; abwählen, um es auszuschließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This snapshot may be sent when the note is written; untick to keep it out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura puede enviarse al escribir la nota; desmárcala para excluirla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näyttökuva voidaan lähettää, kun muistiinpano kirjoitetaan; poista valinta, jos haluat jättää sen pois"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette capture peut être envoyée lors de la rédaction de la note ; décochez-la pour l’exclure"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa istantanea potrebbe essere inviata quando viene scritta la nota; deselezionala per escluderla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスナップショットはノートの作成時に送信されることがあります。除外するにはチェックを外してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 작성할 때 이 스냅샷이 전송될 수 있습니다. 제외하려면 선택을 해제하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schermafbeelding kan worden verstuurd als de notitie wordt geschreven; vink uit om hem buiten te houden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura pode ser enviada quando a nota for escrita; desmarque para deixá-la de fora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写笔记时可能会发送此快照；取消勾选可将其排除"
          }
        }
      }
    },
    "Bu görüntü nota gönderilmez": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bildschirmfoto wird nicht mit der Notiz gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This snapshot isn't sent with the note"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura no se envía con la nota"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä näyttökuvaa ei lähetetä muistiinpanon mukana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette capture n’est pas envoyée avec la note"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa istantanea non viene inviata con la nota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスナップショットはノートと一緒に送信されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스냅샷은 노트와 함께 전송되지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schermafbeelding wordt niet met de notitie verstuurd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura não é enviada com a nota"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快照不会随笔记发送"
          }
        }
      }
    },
    "Not yazılırken değiştirilemez": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht geändert werden, während die Notiz geschrieben wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be changed while the note is being written"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar mientras se escribe la nota"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voi muuttaa, kun muistiinpanoa kirjoitetaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification impossible pendant la rédaction de la note"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non modificabile mentre la nota viene scritta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートの作成中は変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 작성하는 동안에는 변경할 수 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet worden gewijzigd terwijl de notitie wordt geschreven"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser alterado enquanto a nota está sendo escrita"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写笔记期间无法更改"
          }
        }
      }
    },
    "Seçim kaydedilemedi: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl konnte nicht gesichert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the choice: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la elección: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintaa ei voitu tallentaa: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le choix : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la scelta: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択を保存できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항을 저장할 수 없습니다: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de keuze niet bewaren: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a escolha: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储选择：%@"
          }
        }
      }
    },
    "Kayıttan önce katılımcılara haber vermek çoğu yerde yasal zorunluluktur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Teilnehmenden vor der Aufnahme zu informieren, ist an vielen Orten gesetzlich vorgeschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telling participants before recording is a legal requirement in many places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En muchos lugares es obligatorio por ley avisar a los participantes antes de grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monissa paikoissa laki edellyttää, että osallistujille kerrotaan ennen nauhoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans de nombreux pays, la loi impose de prévenir les participants avant d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In molti luoghi la legge richiede di avvisare i partecipanti prima di registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの地域では、録音前に参加者に伝えることが法律で義務付けられています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 지역에서 녹음 전에 참석자에게 알리는 것이 법적 의무입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelnemers inlichten vóór de opname is op veel plaatsen wettelijk verplicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar os participantes antes de gravar é uma exigência legal em muitos lugares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在许多地区，法律要求在录制前告知参与者。"
          }
        }
      }
    },
    "Süre dolunca ses silinir, not kalır; Teams/Zoom görüşmeleri için Mac'i kullan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird nach diesem Zeitraum gelöscht, Notizen bleiben; verwende für Teams-/Zoom-Calls den Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is deleted after this period, notes stay; use the Mac for Teams/Zoom calls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se elimina tras este periodo y las notas se conservan; usa el Mac para las llamadas de Teams/Zoom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni poistetaan tämän ajan jälkeen, muistiinpanot säilyvät; käytä Teams- ja Zoom-puheluihin Macia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est supprimé après cette période, les notes sont conservées ; utilisez le Mac pour les appels Teams/Zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio viene eliminato dopo questo periodo, le note restano; usa il Mac per le chiamate Teams/Zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間が過ぎると音声は削除され、ノートは残ります。Teams/Zoomの通話にはMacを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간이 지나면 오디오는 삭제되고 노트는 남습니다. Teams/Zoom 통화는 Mac을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt na deze periode verwijderd, notities blijven; gebruik de Mac voor Teams-/Zoom-gesprekken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio é apagado após este período, as notas continuam; use o Mac para chamadas do Teams/Zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频会在此期限后删除，笔记会保留；Teams/Zoom 通话请使用 Mac。"
          }
        }
      }
    },
    "Notta sana düşen görevleri ayırmak için kullanılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um deine Aufgaben in Notizen zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to pick out your tasks in notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para identificar tus tareas en las notas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään tehtäviesi poimimiseen muistiinpanoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à repérer vos tâches dans les notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a individuare le tue attività nelle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート内であなたのタスクを見つけるために使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에서 내 할 일을 추리는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt om je taken uit notities te halen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para identificar suas tarefas nas notas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在笔记中找出你的任务。"
          }
        }
      }
    },
    "Notlar, canlı çeviri ve Sor cevapları not ve çeviri dilinde yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, Live-Übersetzung und Antworten in „Fragen“ verwenden die Sprache für Notiz und Übersetzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, live translation and Ask answers use the note and translation language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas, la traducción en directo y las respuestas de Preguntar usan el idioma de las notas y la traducción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot, reaaliaikainen käännös ja Kysy-vastaukset käyttävät muistiinpanon ja käännöksen kieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes, la traduction en direct et les réponses de Demander utilisent la langue des notes et de la traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note, traduzione dal vivo e risposte di Chiedi usano la lingua della nota e della traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、ライブ翻訳、「質問」の回答には、ノートと翻訳の言語が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트, 실시간 번역, 질문하기 답변에는 노트 및 번역 언어가 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities, live vertaling en antwoorden in Vraag gebruiken de taal voor notities en vertaling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, tradução ao vivo e respostas de Perguntar usam o idioma da nota e da tradução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记、实时翻译和“提问”的回答使用笔记和翻译语言。"
          }
        }
      }
    },
    "Cümleler kayıt sırasında %@ diline çevrilir; ✦ özetler ve soruları yanıtlar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden während der Aufnahme auf %@ übersetzt; ✦ fasst zusammen und beantwortet Fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentences are translated into %@ while recording; ✦ summarizes and answers questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frases se traducen al %@ durante la grabación; ✦ resume y responde preguntas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauseet käännetään nauhoituksen aikana kielelle %@; ✦ tekee yhteenvedon ja vastaa kysymyksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les phrases sont traduites en %@ pendant l’enregistrement ; ✦ résume et répond aux questions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frasi vengono tradotte in %@ durante la registrazione; ✦ riassume e risponde alle domande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中、文は%@に翻訳されます。✦で要約と質問への回答ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하는 동안 문장이 %@(으)로 번역됩니다. ✦는 요약하고 질문에 답변합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinnen worden tijdens de opname naar het %@ vertaald; ✦ vat samen en beantwoordt vragen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As frases são traduzidas para %@ durante a gravação; ✦ resume e responde perguntas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时句子会被翻译成%@；✦ 可总结内容并回答问题。"
          }
        }
      }
    },
    "Kayıtta yalnız orijinal metin görünür; %@ not yine yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Aufnahme wird nur der Originaltext angezeigt; die Notiz auf %@ wird trotzdem geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the original text shows while recording; the %@ note is still written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la grabación solo se muestra el texto original; aun así, se escribe la nota en %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoituksen aikana näytetään vain alkuperäinen teksti; muistiinpano kielellä %@ kirjoitetaan silti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le texte original s’affiche pendant l’enregistrement ; la note en %@ est tout de même rédigée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la registrazione viene mostrato solo il testo originale; la nota in %@ viene comunque scritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中は元のテキストのみ表示されます。%@のノートは引き続き作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하는 동안 원문만 표시됩니다. %@ 노트는 그대로 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens de opname wordt alleen de originele tekst getoond; de notitie in het %@ wordt toch geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o texto original aparece durante a gravação; a nota em %@ ainda é escrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时只显示原文；仍会撰写%@笔记。"
          }
        }
      }
    },
    "Notta neyin öne çıkacağını yaz; ör. “Riskleri ayrı say, kararların gerekçesini yaz.”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was die Notiz hervorheben soll, z. B. „Risiken separat auflisten, jede Entscheidung begründen.“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what the note should highlight, e.g. “List risks separately, explain each decision.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qué debe destacar la nota, p. ej., “Enumera los riesgos aparte y explica cada decisión”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, mitä muistiinpanon pitäisi korostaa, esim. ”Listaa riskit erikseen, perustele jokainen päätös.”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ce que la note doit mettre en avant, p. ex. « Liste les risques à part, explique chaque décision. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cosa deve mettere in evidenza la nota, ad es. “Elenca i rischi a parte, spiega ogni decisione.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートで重視すべき点を書いてください。例：「リスクを別に挙げ、各決定事項の理由を説明する。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에서 강조할 내용을 입력하세요. 예: “위험 요소는 따로 나열하고 각 결정 사항을 설명할 것.”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat de notitie moet benadrukken, bijv. “Zet risico's apart, licht elk besluit toe.”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que a nota deve destacar, ex.: “Liste os riscos separadamente, explique cada decisão.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明笔记应突出的内容，例如“将风险单独列出，解释每项决策。”"
          }
        }
      }
    },
    "Doğru yazılması gereken adlar ve terimler; satır başına bir tane, en fazla 30.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Begriffe, die richtig geschrieben werden sollen; einer pro Zeile, bis zu 30."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and terms to spell correctly; one per line, up to 30."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres y términos que deben escribirse correctamente; uno por línea, hasta 30."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikein kirjoitettavat nimet ja termit; yksi riviä kohden, enintään 30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms et termes à écrire correctement ; un par ligne, jusqu’à 30."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi e termini da scrivere correttamente; uno per riga, fino a 30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しく表記させたい名前や用語。1行に1つ、最大30個。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확하게 표기할 이름과 용어. 한 줄에 하나씩, 최대 30개."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen en termen die correct gespeld moeten worden; één per regel, maximaal 30."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e termos para escrever corretamente; um por linha, até 30."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要正确拼写的名字和术语；每行一个，最多 30 个。"
          }
        }
      }
    },
    "Yeni notlar bu şablonla yazılır; eski bir notu ⋯ menüsünden yeniden yazabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Notizen verwenden diese Vorlage; schreibe eine ältere Notiz über das Menü ⋯ neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New notes use this template; rewrite an older note from the ⋯ menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas nuevas usan esta plantilla; reescribe una nota anterior desde el menú ⋯."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet muistiinpanot käyttävät tätä pohjaa; kirjoita vanhempi muistiinpano uudelleen ⋯-valikosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles notes utilisent ce modèle ; réécrivez une note plus ancienne depuis le menu ⋯."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove note usano questo modello; riscrivi una nota precedente dal menu ⋯."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいノートにはこのテンプレートが使われます。以前のノートは⋯メニューから書き直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 노트에 이 템플릿이 사용됩니다. 이전 노트는 ⋯ 메뉴에서 다시 작성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe notities gebruiken dit sjabloon; herschrijf een oudere notitie via het ⋯-menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As novas notas usam este modelo; reescreva uma nota antiga pelo menu ⋯."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新笔记使用此模板；可从 ⋯ 菜单重写较早的笔记。"
          }
        }
      }
    },
    "Yalnızca kullanım sayıları paylaşılır; toplantı içeriği, ses ya da metin paylaşılmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Nutzungszahlen geteilt, nie Meeting-Inhalte, Audio oder Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only usage counts are shared, never meeting content, audio or text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparten recuentos de uso, nunca contenido, audio ni texto de las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain käyttömäärät jaetaan, ei koskaan kokousten sisältöä, ääntä tai tekstiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des compteurs d’utilisation sont partagés, jamais le contenu des réunions, l’audio ou le texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono condivisi solo conteggi di utilizzo, mai contenuti delle riunioni, audio o testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されるのは使用回数のみで、会議の内容、音声、テキストは一切共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 횟수만 공유되며, 회의 내용, 오디오 또는 텍스트는 절대 공유되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gebruiksaantallen worden gedeeld, nooit vergaderinhoud, audio of tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contagens de uso são compartilhadas, nunca conteúdo, áudio ou texto das reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只共享使用次数，绝不共享会议内容、音频或文字。"
          }
        }
      }
    },
    "Sıradaki toplantılar ana ekranda görünür; kayıt toplantının adını ve kişilerini alır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstehende Meetings erscheinen auf dem Startbildschirm; eine Aufnahme übernimmt Name und Teilnehmende des Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming meetings show on the home screen; a recording takes the meeting's name and attendees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las próximas reuniones aparecen en la pantalla de inicio; una grabación toma el nombre y los asistentes de la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevat kokoukset näkyvät aloitusnäkymässä; nauhoitus saa kokouksen nimen ja osallistujat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions à venir s’affichent sur l’écran d’accueil ; un enregistrement reprend le nom et les participants de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prossime riunioni appaiono nella schermata principale; una registrazione prende il nome e i partecipanti della riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の会議はホーム画面に表示されます。録音には会議の名前と参加者が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 회의가 홈 화면에 표시됩니다. 녹음에는 회의 이름과 참석자가 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komende vergaderingen staan op het startscherm; een opname neemt de naam en deelnemers van de vergadering over."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As próximas reuniões aparecem na tela inicial; uma gravação recebe o nome e os participantes da reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将开始的会议会显示在主屏幕上；录音会采用会议的名称和参与者。"
          }
        }
      }
    },
    "Ad transkriptte, notta ve görevlerde \"Konuşmacı N\" yerine görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name ersetzt „Sprecher N“ in Transkript, Notiz und Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name replaces \"Speaker N\" in the transcript, note and tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre sustituye a “Interlocutor N” en la transcripción, la nota y las tareas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi korvaa merkinnän ”Puhuja N” litteroinnissa, muistiinpanossa ja tehtävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom remplace « Intervenant N » dans la transcription, la note et les tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome sostituisce “Interlocutore N” nella trascrizione, nella nota e nelle attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前は、文字起こし、ノート、タスク内の「話者 N」を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름이 녹취록, 노트, 할 일에서 \"화자 N\"을 대체합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam vervangt \"Spreker N\" in het transcript, de notitie en taken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome substitui \"Falante N\" na transcrição, na nota e nas tarefas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名字会替换文字稿、笔记和任务中的“说话人 N”。"
          }
        }
      }
    },
    "Mesajın, varsa e-postan ve sürüm bilgisi hesabınla birlikte gider; toplantı içeriği gitmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht, eine eventuelle E-Mail-Adresse und Versionsinfos werden mit deinem Account gesendet; nie Meeting-Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message, any email and version info are sent with your account; never meeting content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje, tu correo si lo hay y la información de versión se envían con tu cuenta; nunca el contenido de las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi, mahdollinen sähköpostiosoite ja versiotiedot lähetetään tiliisi yhdistettynä; ei koskaan kokousten sisältöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message, l’éventuel e-mail et les informations de version sont envoyés avec votre compte ; jamais le contenu des réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio, l’eventuale email e le informazioni sulla versione vengono inviati con il tuo account; mai contenuti delle riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、メールアドレス（入力した場合）、バージョン情報がアカウントとともに送信されます。会議の内容は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 이메일(입력한 경우) 및 버전 정보가 계정과 함께 전송됩니다. 회의 내용은 절대 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht, een eventueel e-mailadres en versie-informatie worden met je account verstuurd; nooit vergaderinhoud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem, um eventual e-mail e as informações da versão são enviados com sua conta; nunca o conteúdo das reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的消息、电子邮件地址（如有）和版本信息会随你的账户发送；绝不包含会议内容。"
          }
        }
      }
    },
    "Bu ad toplantılarda verildi; toplantının Transkript sekmesinden değiştir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name wurde in Meetings vergeben; ändere ihn im Tab „Transkript“ des Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name was given in meetings; change it in the meeting's Transcript tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nombre se asignó en las reuniones; cámbialo en la pestaña Transcripción de la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä nimi annettiin kokouksissa; muuta sitä kokouksen Litterointi-välilehdellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom a été attribué dans des réunions ; modifiez-le dans l’onglet Transcription de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome è stato assegnato nelle riunioni; cambialo nella scheda Trascrizione della riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前は会議で付けられたものです。会議の「文字起こし」タブで変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 회의에서 지정되었습니다. 회의의 녹취록 탭에서 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze naam is in vergaderingen gegeven; wijzig hem op het tabblad Transcript van de vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome foi dado nas reuniões; altere-o na aba Transcrição da reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名字是在会议中设定的；请在会议的“文字稿”标签页中更改。"
          }
        }
      }
    },
    "Ad konuşma tanımaya verilir; kişinin toplantıları ve görevleri burada toplanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name hilft der Spracherkennung; die Meetings und Aufgaben dieser Person werden hier gesammelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name helps speech recognition; this person's meetings and tasks gather here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre ayuda al reconocimiento de voz; las reuniones y tareas de esta persona se reúnen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi auttaa puheentunnistusta; tämän henkilön kokoukset ja tehtävät kootaan tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom aide la reconnaissance vocale ; les réunions et tâches de cette personne sont regroupées ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome aiuta il riconoscimento vocale; le riunioni e le attività di questa persona si raccolgono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は音声認識に役立ちます。この人の会議とタスクがここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 음성 인식에 도움이 됩니다. 이 사람의 회의와 할 일이 여기에 모입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam helpt de spraakherkenning; de vergaderingen en taken van deze persoon worden hier verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome ajuda o reconhecimento de fala; as reuniões e tarefas desta pessoa se reúnem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名字有助于语音识别；此人的会议和任务会汇集在这里。"
          }
        }
      }
    },
    "Önemli gördüğünü yaz; toplantı notu bunlara öncelik verir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere, was wichtig ist; die Meeting-Notiz stellt es an den Anfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down what matters; the meeting note will put it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta lo importante; la nota de la reunión le dará prioridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa tärkeät asiat; kokousmuistiinpano nostaa ne etusijalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez l’essentiel ; la note de réunion le mettra en avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ciò che conta; la nota della riunione lo metterà al primo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大事なことを書き留めておくと、会議ノートで優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 내용을 적어 두세요. 회의 노트에 가장 먼저 반영됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer wat belangrijk is; de vergadernotitie zet het voorop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote o que importa; a nota da reunião vai colocar isso em primeiro lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下重点；会议笔记会优先列出这些内容。"
          }
        }
      }
    },
    "Arayüz yazısı düğmeleri ve listeleri, okuma metni notu ve transkripti değiştirir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text der Oberfläche ändert die Größe von Tasten und Listen; der Lesetext die von Notizen und Transkripten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface text resizes buttons and lists; reading text resizes notes and transcripts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de la interfaz cambia el tamaño de botones y listas; el texto de lectura, el de notas y transcripciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöliittymän teksti muuttaa painikkeiden ja listojen kokoa; lukuteksti muuttaa muistiinpanojen ja litterointien kokoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte de l’interface redimensionne les boutons et les listes ; le texte de lecture redimensionne les notes et les transcriptions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo dell’interfaccia ridimensiona pulsanti ed elenchi; il testo di lettura ridimensiona note e trascrizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスのテキストはボタンとリストのサイズを、読み物のテキストはノートと文字起こしのサイズを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 텍스트는 버튼과 목록의 크기를, 읽기 텍스트는 노트와 녹취록의 크기를 조절합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfacetekst wijzigt de grootte van knoppen en lijsten; leestekst die van notities en transcripten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto da interface redimensiona botões e listas; o texto de leitura redimensiona notas e transcrições."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面文字调整按钮和列表的大小；阅读文字调整笔记和文字稿的大小。"
          }
        }
      }
    },
    "Raporlar bu iPhone'da kalır; \"Gönder\" toplantı içeriği olmadan geliştiriciye yollar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichte bleiben auf diesem iPhone; „Senden“ teilt einen mit dem Entwickler, ohne Meeting-Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports stay on this iPhone; \"Send\" shares one with the developer, without meeting content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes se quedan en este iPhone; “Enviar” comparte uno con el desarrollador, sin contenido de las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportit pysyvät tässä iPhonessa; ”Lähetä” jakaa yhden kehittäjälle ilman kokousten sisältöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports restent sur cet iPhone ; « Envoyer » en partage un avec le développeur, sans contenu de réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rapporti restano su questo iPhone; “Invia” ne condivide uno con lo sviluppatore, senza contenuti delle riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートはこのiPhoneに保存されます。「送信」を押すと、会議の内容を含めずに開発者と共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서는 이 iPhone에 남습니다. \"보내기\"를 누르면 회의 내용 없이 하나를 개발자와 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten blijven op deze iPhone; \"Stuur\" deelt er een met de ontwikkelaar, zonder vergaderinhoud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relatórios ficam neste iPhone; \"Enviar\" compartilha um com o desenvolvedor, sem conteúdo de reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告保留在这部 iPhone 上；“发送”会与开发者共享一份报告，不含会议内容。"
          }
        }
      }
    },
    "Planı değiştirmek ya da iptal etmek için \"Aboneliği yönet\"e dokun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Abo verwalten“, um deinen Tarif zu ändern oder zu kündigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Manage subscription\" to change or cancel your plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca “Gestionar suscripción” para cambiar o cancelar tu plan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta tai peru tilauksesi napauttamalla ”Hallitse tilausta”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Gérer l’abonnement » pour modifier ou résilier votre forfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “Gestisci abbonamento” per cambiare o annullare il piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを変更またはキャンセルするには、「サブスクリプションを管理」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜을 변경하거나 취소하려면 \"구독 관리\"를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op \"Beheer abonnement\" om je abonnement te wijzigen of op te zeggen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Gerenciar assinatura\" para alterar ou cancelar seu plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“管理订阅”以更改或取消你的方案。"
          }
        }
      }
    },
    "Toplantıların ve notların bu iPhone'da kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meetings und Notizen bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meetings and notes stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones y notas se quedan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksesi ja muistiinpanosi säilyvät tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions et notes restent sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni e le note restano su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議とノートはこのiPhoneに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의와 노트는 이 iPhone에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vergaderingen en notities blijven op deze iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões e notas continuam neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会议和笔记保留在这部 iPhone 上。"
          }
        }
      }
    },
    "Adil kullanım sınırı: bu ay kaydedilen toplantıların toplam süresi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair-Use-Limit: Gesamtlänge der in diesem Monat aufgenommenen Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair-use limit: total length of meetings recorded this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de uso razonable: duración total de las reuniones grabadas este mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohtuullisen käytön raja: tässä kuussa nauhoitettujen kokousten kokonaispituus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’utilisation raisonnable : durée totale des réunions enregistrées ce mois-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di utilizzo equo: durata totale delle riunioni registrate questo mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェアユース上限：今月録音した会議の合計時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공정 사용 한도: 이번 달에 녹음한 회의의 총 길이."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiet voor redelijk gebruik: totale duur van de vergaderingen die deze maand zijn opgenomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de uso justo: duração total das reuniões gravadas neste mês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合理使用限额：本月录制会议的总时长。"
          }
        }
      }
    },
    "Not yazılırken toplantının en çok konuşulan en fazla 6 ekran görüntüsü küçültülüp notla birlikte sunucumuza, oradan da Anthropic'e (Claude) gönderilir; not ekrana atıf yapabilir (ör. \"Fiyatlandırma slaytında, 12:40\"). Sor'da da okunan transkript parçaları konuşulurken ekranda olan en fazla 3 görüntü soruyla aynı yoldan gider; cevabın altında kaç görüntü okunduğu yazar. Sunucumuz görüntüleri saklamaz ve loglamaz; Anthropic onları transkriptle aynı koşullarla işler. Bir görüntüyü toplantının Ekranlar sekmesinden nottan çıkarabilirsin (Sor'a da gitmez). Kapalıyken görüntüler bu Mac'ten çıkmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schreiben der Notiz werden bis zu 6 der meistbesprochenen Bildschirmfotos des Meetings verkleinert und mit ihr an unseren Server und von dort an Anthropic (Claude) gesendet, damit die Notiz darauf verweisen kann (z. B. „auf der Folie ‚Preise‘, 12:40“). In „Fragen“ gehen bis zu 3 Bildschirmfotos, die zu sehen waren, während die gelesenen Transkriptpassagen gesprochen wurden, auf demselben Weg mit deiner Frage mit; die Antwort zeigt, wie viele gelesen wurden. Unser Server speichert und protokolliert die Bilder nicht; Anthropic behandelt sie zu denselben Bedingungen wie das Transkript. Du kannst ein Bildschirmfoto im Tab „Bildschirme“ des Meetings für Notizen abwählen (dann geht es auch nicht an „Fragen“). Wenn diese Option deaktiviert ist, verlassen Bildschirmfotos nie diesen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the note is written, up to 6 of the meeting's most-discussed screen snapshots are downscaled and sent with it to our server and from there to Anthropic (Claude), so the note can refer to them (e.g. \"on the Pricing slide, 12:40\"). In Ask, up to 3 snapshots that were on screen while the read transcript passages were spoken go the same way with your question; the answer shows how many it read. Our server doesn't store or log the images; Anthropic handles them on the same terms as the transcript. You can untick a snapshot for notes on the meeting's Screens tab (it then doesn't go to Ask either). With this off, snapshots never leave this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al escribir la nota, hasta 6 de las capturas de pantalla más comentadas de la reunión se reducen y se envían con ella a nuestro servidor y desde allí a Anthropic (Claude), para que la nota pueda hacer referencia a ellas (p. ej., “en la diapositiva de Precios, 12:40”). En Preguntar, hasta 3 capturas que estaban en pantalla mientras se pronunciaban los fragmentos de transcripción leídos se envían del mismo modo con tu pregunta; la respuesta indica cuántas ha leído. Nuestro servidor no guarda ni registra las imágenes; Anthropic las trata en las mismas condiciones que la transcripción. Puedes desmarcar una captura para las notas en la pestaña Pantallas de la reunión (entonces tampoco va a Preguntar). Si está desactivado, las capturas nunca salen de este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistiinpano kirjoitetaan, enintään 6 kokouksen eniten käsitellyistä näyttökuvista pienennetään ja lähetetään sen mukana palvelimellemme ja sieltä Anthropicille (Claude), jotta muistiinpano voi viitata niihin (esim. ”Hinnoittelu-dialla, 12:40”). Kysy-toiminnossa enintään 3 näyttökuvaa, jotka olivat näytöllä luettujen litterointikohtien aikana, lähetetään samaa reittiä kysymyksesi mukana; vastaus näyttää, kuinka monta niistä luettiin. Palvelimemme ei tallenna tai kirjaa kuvia; Anthropic käsittelee niitä samoin ehdoin kuin litterointia. Voit poistaa näyttökuvan valinnan muistiinpanoja varten kokouksen Näytöt-välilehdellä (silloin se ei mene myöskään Kysy-toimintoon). Kun tämä on pois päältä, näyttökuvat eivät koskaan poistu tästä Macista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la rédaction de la note, jusqu’à 6 des captures d’écran les plus discutées de la réunion sont réduites et envoyées avec elle à notre serveur, puis de là à Anthropic (Claude), afin que la note puisse y faire référence (p. ex. « sur la diapositive Tarifs, 12:40 »). Dans Demander, jusqu’à 3 captures affichées pendant que les passages de transcription lus étaient prononcés suivent le même chemin avec votre question ; la réponse indique combien ont été lues. Notre serveur ne stocke ni ne journalise les images ; Anthropic les traite selon les mêmes conditions que la transcription. Vous pouvez décocher une capture pour les notes dans l’onglet Écrans de la réunion (elle n’est alors pas non plus envoyée à Demander). Si cette option est désactivée, les captures ne quittent jamais ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando viene scritta la nota, fino a 6 delle istantanee dello schermo più discusse della riunione vengono ridimensionate e inviate con essa al nostro server e da lì ad Anthropic (Claude), così la nota può farvi riferimento (ad es. “sulla slide Prezzi, 12:40”). In Chiedi, fino a 3 istantanee che erano sullo schermo mentre venivano pronunciati i passaggi della trascrizione letti seguono la stessa strada insieme alla tua domanda; la risposta indica quante ne ha lette. Il nostro server non conserva né registra le immagini; Anthropic le tratta alle stesse condizioni della trascrizione. Puoi deselezionare un’istantanea per le note nella scheda Schermate della riunione (in quel caso non va nemmeno a Chiedi). Con questa opzione disattivata, le istantanee non lasciano mai questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートの作成時、会議で最もよく話題になった画面スナップショットを最大6枚まで縮小し、ノートと一緒に当社サーバへ、そこからAnthropic（Claude）へ送信します。これにより、ノートでスナップショットに言及できます（例：「料金プランのスライド、12:40」）。「質問」では、読み取った文字起こしの箇所が話されていた間に画面に表示されていたスナップショットを最大3枚まで、質問と一緒に同じ経路で送信します。回答には読み取った枚数が表示されます。当社サーバは画像を保存も記録もしません。Anthropicは文字起こしと同じ条件で画像を扱います。会議の「画面」タブでスナップショットのノート用チェックを外すことができます（その場合「質問」にも送信されません）。この設定がオフの場合、スナップショットがこのMacの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 작성할 때 회의에서 가장 많이 논의된 화면 스냅샷 최대 6개가 축소되어 노트와 함께 서버로, 그리고 서버에서 Anthropic(Claude)으로 전송되므로 노트에서 이를 참조할 수 있습니다(예: \"가격 슬라이드, 12:40\"). 질문하기에서는 읽은 녹취록 구간이 발언되는 동안 화면에 있던 스냅샷 최대 3개가 같은 방식으로 질문과 함께 전송되며, 답변에 읽은 개수가 표시됩니다. 서버는 이미지를 저장하거나 기록하지 않으며, Anthropic은 녹취록과 동일한 조건으로 이미지를 처리합니다. 회의의 화면 탭에서 스냅샷을 노트용으로 선택 해제할 수 있습니다(그러면 질문하기에도 전송되지 않음). 이 옵션을 끄면 스냅샷은 절대 이 Mac 밖으로 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de notitie wordt geschreven, worden maximaal 6 van de meest besproken schermafbeeldingen van de vergadering verkleind en samen met de notitie naar onze server gestuurd en van daaruit naar Anthropic (Claude), zodat de notitie ernaar kan verwijzen (bijv. \"op de dia Prijzen, 12:40\"). In Vraag gaan maximaal 3 schermafbeeldingen die in beeld waren terwijl de gelezen transcriptfragmenten werden uitgesproken op dezelfde manier mee met je vraag; het antwoord toont hoeveel er zijn gelezen. Onze server bewaart of logt de afbeeldingen niet; Anthropic behandelt ze onder dezelfde voorwaarden als het transcript. Je kunt een schermafbeelding voor notities uitvinken op het tabblad Schermen van de vergadering (dan gaat hij ook niet naar Vraag). Als dit uitstaat, verlaten schermafbeeldingen deze Mac nooit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a nota é escrita, até 6 das capturas de tela mais discutidas da reunião são reduzidas e enviadas com ela ao nosso servidor e de lá à Anthropic (Claude), para que a nota possa se referir a elas (ex.: \"no slide de Preços, 12:40\"). Em Perguntar, até 3 capturas que estavam na tela enquanto os trechos lidos da transcrição eram falados seguem o mesmo caminho com sua pergunta; a resposta mostra quantas foram lidas. Nosso servidor não guarda nem registra as imagens; a Anthropic as trata nos mesmos termos da transcrição. Você pode desmarcar uma captura para as notas na aba Telas da reunião (assim ela também não vai para Perguntar). Com isto desativado, as capturas nunca saem deste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写笔记时，会议中讨论最多的最多 6 张屏幕快照会被缩小，并随笔记发送到我们的服务器，再从那里发送给 Anthropic（Claude），以便笔记引用它们（例如“在定价幻灯片上，12:40”）。在“提问”中，读取的文字稿段落被说出时显示在屏幕上的最多 3 张快照会以同样方式随你的问题发送；回答会显示读取了多少张。我们的服务器不会存储或记录这些图像；Anthropic 按照与文字稿相同的条款处理它们。你可以在会议的“屏幕”标签页中取消勾选某张快照用于笔记（之后它也不会发送到“提问”）。关闭此选项后，快照绝不会离开这台 Mac。"
          }
        }
      }
    },
    "Notla ya da soruyla gönderilen ekran görüntüleri sunucunun sınırını aşıyor. Ayarlar › Genel'de \"Notlarda ekran görüntülerini kullan\"ı kapatıp ya da Ekranlar sekmesinden bazılarını nottan çıkarıp yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die mit der Notiz oder Frage gesendeten Bildschirmfotos überschreiten das Limit des Servers. Deaktiviere „Bildschirmfotos in Notizen verwenden“ unter „Einstellungen“ › „Allgemein“ oder wähle im Tab „Bildschirme“ einige ab und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen snapshots sent with the note or question are over the server's limit. Turn off \"Use screen snapshots in notes\" in Settings › General, or untick some on the Screens tab, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla enviadas con la nota o la pregunta superan el límite del servidor. Desactiva “Usar capturas de pantalla en las notas” en Ajustes › General o desmarca algunas en la pestaña Pantallas e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanon tai kysymyksen mukana lähetetyt näyttökuvat ylittävät palvelimen rajan. Laita ”Käytä näyttökuvia muistiinpanoissa” pois päältä kohdassa Asetukset › Yleiset tai poista joidenkin valinta Näytöt-välilehdellä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran envoyées avec la note ou la question dépassent la limite du serveur. Désactivez « Utiliser les captures d’écran dans les notes » dans Réglages › Général, ou décochez-en quelques-unes dans l’onglet Écrans, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istantanee dello schermo inviate con la nota o la domanda superano il limite del server. Disattiva “Usa le istantanee dello schermo nelle note” in Impostazioni › Generali o deselezionane alcune nella scheda Schermate, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートまたは質問と一緒に送信される画面スナップショットがサーバの上限を超えています。「設定」›「一般」で「ノートで画面スナップショットを使用」をオフにするか、「画面」タブでいくつかのチェックを外してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 또는 질문과 함께 전송된 화면 스냅샷이 서버 한도를 초과했습니다. 설정 › 일반에서 \"노트에 화면 스냅샷 사용\"을 끄거나 화면 탭에서 일부를 선택 해제한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermafbeeldingen die met de notitie of vraag worden verstuurd, overschrijden de limiet van de server. Zet \"Gebruik schermafbeeldingen in notities\" uit in Instellingen › Algemeen, of vink er een paar uit op het tabblad Schermen, en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela enviadas com a nota ou a pergunta excedem o limite do servidor. Desative \"Usar capturas de tela nas notas\" em Ajustes › Geral ou desmarque algumas na aba Telas e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随笔记或问题发送的屏幕快照超出了服务器的限制。请在“设置 › 通用”中关闭“在笔记中使用屏幕快照”，或在“屏幕”标签页中取消勾选一些快照，然后重试。"
          }
        }
      }
    },
    "Not yazılırken \"Notta\" işaretli görüntülerden en çok konuşulan en fazla 6'sı sunucumuza ve Anthropic'e gönderilir; Sor da okuduğu parçalar konuşulurken ekranda olan en fazla 3'ünü gönderir. İşaretini kaldırdığın görüntü ikisine de gönderilmez. Seçim bir sonraki notta ve soruda geçerli olur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schreiben der Notiz werden bis zu 6 der mit „In Notiz“ ausgewählten Bildschirmfotos (die meistbesprochenen) an unseren Server und Anthropic gesendet; „Fragen“ sendet außerdem bis zu 3, die zu sehen waren, während die gelesenen Passagen gesprochen wurden. Ein abgewähltes Bildschirmfoto geht an keinen von beiden. Deine Auswahl gilt für die nächste Notiz und Frage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the note is written, up to 6 of the snapshots ticked \"In note\" (the most-discussed ones) are sent to our server and Anthropic; Ask also sends up to 3 that were on screen while the passages it read were spoken. A snapshot you untick goes to neither. Your choice applies to the next note and question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al escribir la nota, hasta 6 de las capturas marcadas “En la nota” (las más comentadas) se envían a nuestro servidor y a Anthropic; Preguntar también envía hasta 3 que estaban en pantalla mientras se pronunciaban los fragmentos que leyó. Una captura que desmarques no va a ninguno de los dos. Tu elección se aplica a la siguiente nota y pregunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistiinpano kirjoitetaan, enintään 6 ”Muistiinpanossa”-valituista näyttökuvista (eniten käsitellyt) lähetetään palvelimellemme ja Anthropicille; Kysy lähettää lisäksi enintään 3, jotka olivat näytöllä sen lukemien kohtien aikana. Näyttökuva, jonka valinnan poistat, ei mene kumpaankaan. Valintasi koskee seuraavaa muistiinpanoa ja kysymystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la rédaction de la note, jusqu’à 6 des captures cochées « Dans la note » (les plus discutées) sont envoyées à notre serveur et à Anthropic ; Demander envoie aussi jusqu’à 3 captures affichées pendant que les passages lus étaient prononcés. Une capture décochée n’est envoyée ni à l’un ni à l’autre. Votre choix s’applique à la prochaine note et à la prochaine question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando viene scritta la nota, fino a 6 delle istantanee selezionate “Nella nota” (le più discusse) vengono inviate al nostro server e ad Anthropic; Chiedi invia anche fino a 3 istantanee che erano sullo schermo mentre venivano pronunciati i passaggi letti. Un’istantanea deselezionata non va a nessuno dei due. La tua scelta vale per la prossima nota e la prossima domanda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートの作成時、「ノートに使用」にチェックが付いたスナップショットのうち最大6枚（最もよく話題になったもの）が当社サーバとAnthropicに送信されます。「質問」でも、読み取った箇所が話されていた間に画面に表示されていたものを最大3枚送信します。チェックを外したスナップショットはどちらにも送信されません。選択内容は次のノートと質問から適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 작성할 때 \"노트에 포함\"으로 선택된 스냅샷 중 최대 6개(가장 많이 논의된 항목)가 서버와 Anthropic으로 전송됩니다. 질문하기는 읽은 구간이 발언되는 동안 화면에 있던 스냅샷도 최대 3개 전송합니다. 선택 해제한 스냅샷은 어디에도 전송되지 않습니다. 선택 사항은 다음 노트와 질문에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de notitie wordt geschreven, worden maximaal 6 van de schermafbeeldingen met een vinkje bij \"In notitie\" (de meest besproken) naar onze server en Anthropic gestuurd; Vraag stuurt ook maximaal 3 die in beeld waren terwijl de gelezen fragmenten werden uitgesproken. Een schermafbeelding die je uitvinkt, gaat naar geen van beide. Je keuze geldt voor de volgende notitie en vraag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a nota é escrita, até 6 das capturas marcadas \"Na nota\" (as mais discutidas) são enviadas ao nosso servidor e à Anthropic; Perguntar também envia até 3 que estavam na tela enquanto os trechos lidos eram falados. Uma captura desmarcada não vai para nenhum dos dois. Sua escolha vale para a próxima nota e a próxima pergunta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写笔记时，勾选了“用于笔记”的快照中最多 6 张（讨论最多的）会发送到我们的服务器和 Anthropic；“提问”还会发送在其读取的段落被说出时显示在屏幕上的最多 3 张。你取消勾选的快照两者都不会发送。你的选择适用于下一次笔记和提问。"
          }
        }
      }
    },
    "Kayıt sırasında çeviri yapılmaz, yalnızca orijinal metin görünür; toplantı bitince %@ not yine hazırlanır. Kayıtta ✦ düğmesi son dakikaları özetler ve toplantıya soru sordurur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Aufnahme wird nichts übersetzt; nur der Originaltext wird angezeigt. Nach dem Meeting wird trotzdem eine Notiz auf %@ erstellt. Während der Aufnahme fasst die Taste ✦ die letzten Minuten zusammen und du kannst Fragen zum Meeting stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is translated while recording; only the original text is shown. A note in %@ is still prepared after the meeting. While recording, the ✦ button summarises the last minutes and lets you ask about the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se traduce nada durante la grabación; solo se muestra el texto original. Aun así, tras la reunión se prepara una nota en %@. Durante la grabación, el botón ✦ resume los últimos minutos y te permite preguntar sobre la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoituksen aikana mitään ei käännetä; vain alkuperäinen teksti näytetään. Muistiinpano kielellä %@ laaditaan silti kokouksen jälkeen. Nauhoituksen aikana ✦-painike tekee yhteenvedon viime minuuteista ja antaa sinun kysyä kokouksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est traduit pendant l’enregistrement ; seul le texte original est affiché. Une note en %@ est tout de même préparée après la réunion. Pendant l’enregistrement, le bouton ✦ résume les dernières minutes et vous permet de poser des questions sur la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la registrazione non viene tradotto nulla; viene mostrato solo il testo originale. Dopo la riunione viene comunque preparata una nota in %@. Durante la registrazione, il pulsante ✦ riassume gli ultimi minuti e ti permette di fare domande sulla riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中は何も翻訳されず、元のテキストのみが表示されます。会議後には%@のノートが引き続き作成されます。録音中は✦ボタンで直近数分間を要約したり、会議について質問したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하는 동안에는 아무것도 번역되지 않고 원문만 표시됩니다. 회의가 끝나면 %@ 노트는 그대로 준비됩니다. 녹음하는 동안 ✦ 버튼으로 최근 몇 분을 요약하고 회의에 대해 질문할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het opnemen wordt niets vertaald; alleen de originele tekst wordt getoond. Na de vergadering wordt toch een notitie in het %@ gemaakt. Tijdens het opnemen vat de knop ✦ de laatste minuten samen en kun je ermee vragen stellen over de vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é traduzido durante a gravação; só o texto original é exibido. Uma nota em %@ ainda é preparada após a reunião. Durante a gravação, o botão ✦ resume os últimos minutos e permite perguntar sobre a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时不进行翻译；只显示原文。会议结束后仍会准备一份%@笔记。录制时，✦ 按钮可总结最近几分钟的内容，并让你询问有关会议的问题。"
          }
        }
      }
    },
    "Adil kullanım sınırı: bu ay kaydedilen toplantıların toplam süresi. Ay başında sıfırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair-Use-Limit: die Gesamtlänge der in diesem Monat aufgenommenen Meetings. Wird zu Beginn jedes Monats zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair-use limit: the total length of meetings recorded this month. Resets at the start of each month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de uso razonable: la duración total de las reuniones grabadas este mes. Se restablece a principios de cada mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohtuullisen käytön raja: tässä kuussa nauhoitettujen kokousten kokonaispituus. Nollautuu jokaisen kuun alussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’utilisation raisonnable : la durée totale des réunions enregistrées ce mois-ci. Réinitialisée au début de chaque mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di utilizzo equo: la durata totale delle riunioni registrate questo mese. Si azzera all’inizio di ogni mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェアユース上限：今月録音した会議の合計時間です。毎月初めにリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공정 사용 한도: 이번 달에 녹음한 회의의 총 길이입니다. 매월 초에 초기화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiet voor redelijk gebruik: de totale duur van de vergaderingen die deze maand zijn opgenomen. Wordt aan het begin van elke maand gereset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de uso justo: a duração total das reuniões gravadas neste mês. É redefinido no início de cada mês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合理使用限额：本月录制会议的总时长。每月初重置。"
          }
        }
      }
    },
    "Mesajın, yazdıysan e-postan ve işaretliyse sürüm bilgisi Gistsmith'in geliştiricisinin sunucusuna gider ve hesabınla ilişkilendirilir. Toplantı içeriği gönderilmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht, deine E-Mail-Adresse (falls angegeben) und die Versionsinfos (falls ausgewählt) gehen an den Server des Entwicklers von Gistsmith und werden mit deinem Account verknüpft. Es werden keine Meeting-Inhalte gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message, your email if you entered one, and the version info if checked go to the Gistsmith developer's server and are linked to your account. No meeting content is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje, tu correo si lo has introducido y la información de versión si la has marcado van al servidor del desarrollador de Gistsmith y se vinculan a tu cuenta. No se envía ningún contenido de las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi, sähköpostiosoitteesi (jos annoit sen) ja versiotiedot (jos valittu) menevät Gistsmithin kehittäjän palvelimelle ja yhdistetään tiliisi. Kokousten sisältöä ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message, votre e-mail si vous l’avez saisi et les informations de version si elles sont cochées sont envoyés au serveur du développeur de Gistsmith et liés à votre compte. Aucun contenu de réunion n’est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio, la tua email se l’hai inserita e le informazioni sulla versione se selezionate vanno al server dello sviluppatore di Gistsmith e sono collegati al tuo account. Nessun contenuto delle riunioni viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、入力した場合はメールアドレス、チェックした場合はバージョン情報が、Gistsmithの開発者のサーバに送られ、アカウントに紐付けられます。会議の内容は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 이메일(입력한 경우), 버전 정보(선택한 경우)가 Gistsmith 개발자의 서버로 전송되며 계정에 연결됩니다. 회의 내용은 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht, je e-mailadres als je dat hebt ingevuld, en de versie-informatie als die is aangevinkt, gaan naar de server van de ontwikkelaar van Gistsmith en worden aan je account gekoppeld. Er wordt geen vergaderinhoud verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem, seu e-mail (se você digitou um) e as informações da versão (se marcadas) vão para o servidor do desenvolvedor do Gistsmith e ficam vinculados à sua conta. Nenhum conteúdo de reunião é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的消息、你输入的电子邮件地址（如有）以及勾选的版本信息会发送到 Gistsmith 开发者的服务器，并与你的账户关联。不会发送任何会议内容。"
          }
        }
      }
    },
    "Kayıttan önce katılımcılara haber vermek çoğu yerde yasal zorunluluktur. Süre dolunca ses dosyaları silinir, metin ve not kalır; yarıda kalan ya da başarısız toplantının sesi iki kat süre saklanır. Telefondaki Teams/Zoom görüşmeleri kaydedilemez (iOS izin vermez); onlar için Mac'i kullan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An vielen Orten bist du gesetzlich verpflichtet, die Teilnehmenden vor der Aufnahme zu informieren. Nach Ablauf des Zeitraums werden Audiodateien gelöscht, Transkript und Notiz bleiben erhalten; Audio unterbrochener oder fehlgeschlagener Meetings wird doppelt so lange aufbewahrt. Teams-/Zoom-Calls auf dem iPhone können nicht aufgenommen werden (iOS erlaubt das nicht); verwende dafür deinen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In many places you are legally required to tell participants before recording. When the period ends, audio files are deleted and the transcript and note stay; audio of interrupted or failed meetings is kept twice as long. Teams/Zoom calls on the phone can't be recorded (iOS doesn't allow it); use your Mac for those."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En muchos lugares la ley te obliga a avisar a los participantes antes de grabar. Cuando termina el periodo, los archivos de audio se eliminan y la transcripción y la nota se conservan; el audio de las reuniones interrumpidas o fallidas se conserva el doble de tiempo. Las llamadas de Teams/Zoom en el teléfono no se pueden grabar (iOS no lo permite); usa tu Mac para ellas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monissa paikoissa laki edellyttää, että osallistujille kerrotaan ennen nauhoitusta. Kun aika päättyy, äänitiedostot poistetaan ja litterointi ja muistiinpano säilyvät; keskeytyneiden tai epäonnistuneiden kokousten ääni säilytetään kaksi kertaa pidempään. Teams- ja Zoom-puheluita ei voi nauhoittaa puhelimella (iOS ei salli sitä); käytä niihin Macia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans de nombreux pays, la loi vous oblige à prévenir les participants avant d’enregistrer. À la fin de la période, les fichiers audio sont supprimés, et la transcription et la note sont conservées ; l’audio des réunions interrompues ou en échec est conservé deux fois plus longtemps. Les appels Teams/Zoom passés sur le téléphone ne peuvent pas être enregistrés (iOS ne le permet pas) ; utilisez votre Mac pour ceux-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In molti luoghi la legge richiede di avvisare i partecipanti prima di registrare. Al termine del periodo, i file audio vengono eliminati e trascrizione e nota restano; l’audio delle riunioni interrotte o non riuscite viene conservato il doppio del tempo. Le chiamate Teams/Zoom sul telefono non possono essere registrate (iOS non lo consente); per quelle usa il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの地域では、録音前に参加者に伝えることが法律で義務付けられています。期間が終了すると音声ファイルは削除され、文字起こしとノートは残ります。中断または失敗した会議の音声は2倍の期間保存されます。iPhoneではTeams/Zoomの通話は録音できません（iOSが許可していません）。それらにはMacを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 지역에서 녹음 전에 참석자에게 알리는 것이 법적 의무입니다. 기간이 끝나면 오디오 파일은 삭제되고 녹취록과 노트는 남습니다. 중단되거나 실패한 회의의 오디오는 두 배 더 오래 보관됩니다. 휴대폰에서는 Teams/Zoom 통화를 녹음할 수 없으므로(iOS에서 허용하지 않음) 이러한 통화에는 Mac을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op veel plaatsen ben je wettelijk verplicht deelnemers in te lichten vóór de opname. Als de periode afloopt, worden audiobestanden verwijderd en blijven het transcript en de notitie; audio van onderbroken of mislukte vergaderingen wordt twee keer zo lang bewaard. Teams-/Zoom-gesprekken op de telefoon kunnen niet worden opgenomen (iOS staat dat niet toe); gebruik daarvoor je Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em muitos lugares, a lei exige que você avise os participantes antes de gravar. Quando o período termina, os arquivos de áudio são apagados e a transcrição e a nota continuam; o áudio de reuniões interrompidas ou com falha é mantido pelo dobro do tempo. Chamadas do Teams/Zoom no telefone não podem ser gravadas (o iOS não permite); use seu Mac para elas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在许多地区，法律要求你在录制前告知参与者。期限结束后，音频文件会被删除，文字稿和笔记会保留；中断或失败的会议的音频会保留两倍时长。无法在手机上录制 Teams/Zoom 通话（iOS 不允许）；请使用你的 Mac 录制这类通话。"
          }
        }
      }
    },
    "Çevrimiçi görüşme kaydında ekrana birkaç saniyede bir bakılır; içerik anlamlı değişince (slayt, tasarım, sayfa) bir görüntü saklanır ve o sırada konuşulanlarla eşlenir. Görüşme penceresi (Zoom, Meet, Teams…) bulunursa yalnızca o, yoksa ana ekran alınır; bu uygulamanın pencereleri hiç alınmaz. Görüntüler bu Mac'te toplantının klasöründe saklanır. \"Notlarda ekran görüntülerini kullan\" açık olduğu için not yazılırken ve Sor'da birkaçı küçültülüp sunucumuza, oradan da Anthropic'e (Claude) gönderilir; bağladığın MCP istemcisi (ör. Claude, Cursor) de okuyabilir. Toplantı silinince görüntüleri de silinir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während ein Online-Call aufgenommen wird, schaut die App alle paar Sekunden auf den Bildschirm. Ändert sich der Inhalt deutlich (eine Folie, ein Design, eine Seite), behält sie ein Bildschirmfoto und ordnet es dem zu, was in der Zeit gesagt wurde. Findet sie das Fenster des Calls (Zoom, Meet, Teams …), erfasst sie nur dieses Fenster, sonst das Hauptdisplay; die Fenster dieser App werden nie erfasst. Bildschirmfotos werden auf diesem Mac im Ordner des Meetings aufbewahrt. Da „Bildschirmfotos in Notizen verwenden“ aktiviert ist, werden einige davon beim Schreiben einer Notiz und in „Fragen“ verkleinert und an unseren Server und von dort an Anthropic (Claude) gesendet; auch eine verbundene MCP-App (z. B. Claude oder Cursor) kann sie lesen. Wenn du das Meeting löschst, werden seine Bildschirmfotos gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While an online call is recorded, the app looks at the screen every few seconds. When the content changes meaningfully (a slide, a design, a page), it keeps a snapshot and matches it to what was said meanwhile. If it finds the call's window (Zoom, Meet, Teams…), it captures only that window, otherwise the main display; this app's windows are never captured. Snapshots are kept on this Mac in the meeting's folder. Because \"Use screen snapshots in notes\" is on, a few of them are downsized and sent to our server and from there to Anthropic (Claude) when a note is written and in Ask; an MCP app you connect (such as Claude or Cursor) can read them too. Deleting the meeting deletes its snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se graba una llamada en línea, la app mira la pantalla cada pocos segundos. Cuando el contenido cambia de forma significativa (una diapositiva, un diseño, una página), guarda una captura y la asocia a lo que se dijo mientras tanto. Si encuentra la ventana de la llamada (Zoom, Meet, Teams…), captura solo esa ventana; si no, la pantalla principal. Las ventanas de esta app nunca se capturan. Las capturas se guardan en este Mac, en la carpeta de la reunión. Como “Usar capturas de pantalla en las notas” está activado, algunas se reducen y se envían a nuestro servidor y desde allí a Anthropic (Claude) al escribir una nota y en Preguntar; una app MCP que conectes (como Claude o Cursor) también puede leerlas. Al eliminar la reunión se eliminan sus capturas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun verkkopuhelua nauhoitetaan, sovellus katsoo näyttöä muutaman sekunnin välein. Kun sisältö muuttuu merkittävästi (dia, suunnitelma, sivu), se tallentaa näyttökuvan ja yhdistää sen siihen, mitä sillä välin sanottiin. Jos se löytää puhelun ikkunan (Zoom, Meet, Teams…), se kaappaa vain sen ikkunan, muuten päänäytön; tämän sovelluksen ikkunoita ei koskaan kaapata. Näyttökuvat säilytetään tässä Macissa kokouksen kansiossa. Koska ”Käytä näyttökuvia muistiinpanoissa” on päällä, muutama niistä pienennetään ja lähetetään palvelimellemme ja sieltä Anthropicille (Claude), kun muistiinpano kirjoitetaan ja Kysy-toiminnossa; myös yhdistämäsi MCP-sovellus (kuten Claude tai Cursor) voi lukea niitä. Kokouksen poistaminen poistaa sen näyttökuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant l’enregistrement d’un appel en ligne, l’app regarde l’écran toutes les quelques secondes. Quand le contenu change de manière significative (une diapositive, une maquette, une page), elle conserve une capture et l’associe à ce qui a été dit entre-temps. Si elle trouve la fenêtre de l’appel (Zoom, Meet, Teams…), elle ne capture que cette fenêtre, sinon l’écran principal ; les fenêtres de cette app ne sont jamais capturées. Les captures sont conservées sur ce Mac dans le dossier de la réunion. Comme « Utiliser les captures d’écran dans les notes » est activé, quelques-unes sont réduites et envoyées à notre serveur, puis de là à Anthropic (Claude), lors de la rédaction d’une note et dans Demander ; une app MCP que vous connectez (comme Claude ou Cursor) peut aussi les lire. Supprimer la réunion supprime ses captures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la registrazione di una chiamata online, l’app guarda lo schermo ogni pochi secondi. Quando il contenuto cambia in modo significativo (una slide, un design, una pagina), conserva un’istantanea e la abbina a ciò che è stato detto nel frattempo. Se trova la finestra della chiamata (Zoom, Meet, Teams…), acquisisce solo quella finestra, altrimenti il display principale; le finestre di questa app non vengono mai acquisite. Le istantanee vengono conservate su questo Mac nella cartella della riunione. Poiché “Usa le istantanee dello schermo nelle note” è attivo, alcune di esse vengono ridimensionate e inviate al nostro server e da lì ad Anthropic (Claude) quando viene scritta una nota e in Chiedi; anche un’app MCP che connetti (come Claude o Cursor) può leggerle. Eliminando la riunione se ne eliminano le istantanee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン通話の録音中、アプリは数秒ごとに画面を確認します。内容が大きく変わると（スライド、デザイン、ページなど）、スナップショットを保存し、その間に話された内容と対応付けます。通話のウインドウ（Zoom、Meet、Teamsなど）が見つかればそのウインドウだけを、見つからなければメインディスプレイを撮影します。このアプリのウインドウが撮影されることはありません。スナップショットはこのMacの会議フォルダに保存されます。「ノートで画面スナップショットを使用」がオンのため、ノートの作成時と「質問」で、その一部が縮小されて当社サーバへ、そこからAnthropic（Claude）へ送信されます。接続したMCPアプリ（ClaudeやCursorなど）も読み取れます。会議を削除すると、そのスナップショットも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 통화를 녹음하는 동안 앱은 몇 초마다 화면을 확인합니다. 내용이 의미 있게 바뀌면(슬라이드, 디자인, 페이지) 스냅샷을 저장하고 그동안 발언된 내용과 연결합니다. 통화 윈도우(Zoom, Meet, Teams…)를 찾으면 해당 윈도우만 캡처하고, 그렇지 않으면 주 디스플레이를 캡처합니다. 이 앱의 윈도우는 절대 캡처되지 않습니다. 스냅샷은 이 Mac의 회의 폴더에 보관됩니다. \"노트에 화면 스냅샷 사용\"이 켜져 있으므로 노트를 작성할 때와 질문하기에서 그중 일부가 축소되어 서버로, 그리고 서버에서 Anthropic(Claude)으로 전송됩니다. 연결한 MCP 앱(예: Claude 또는 Cursor)도 이를 읽을 수 있습니다. 회의를 삭제하면 스냅샷도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl een online gesprek wordt opgenomen, kijkt de app om de paar seconden naar het scherm. Als de inhoud wezenlijk verandert (een dia, een ontwerp, een pagina), bewaart hij een schermafbeelding en koppelt die aan wat er intussen werd gezegd. Als hij het venster van het gesprek vindt (Zoom, Meet, Teams…), legt hij alleen dat venster vast, anders het hoofdscherm; de vensters van deze app worden nooit vastgelegd. Schermafbeeldingen worden op deze Mac in de map van de vergadering bewaard. Omdat \"Gebruik schermafbeeldingen in notities\" aanstaat, worden er een paar verkleind en naar onze server en van daaruit naar Anthropic (Claude) gestuurd als een notitie wordt geschreven en in Vraag; een MCP-app die je koppelt (zoals Claude of Cursor) kan ze ook lezen. Als je de vergadering verwijdert, worden de schermafbeeldingen ook verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto uma chamada online é gravada, o app observa a tela a cada poucos segundos. Quando o conteúdo muda de forma significativa (um slide, um design, uma página), ele guarda uma captura e a associa ao que foi dito nesse intervalo. Se encontrar a janela da chamada (Zoom, Meet, Teams…), captura só essa janela; caso contrário, a tela principal. As janelas deste app nunca são capturadas. As capturas ficam neste Mac, na pasta da reunião. Como \"Usar capturas de tela nas notas\" está ativado, algumas delas são reduzidas e enviadas ao nosso servidor e de lá à Anthropic (Claude) quando uma nota é escrita e em Perguntar; um app MCP que você conectar (como Claude ou Cursor) também pode lê-las. Apagar a reunião apaga as capturas dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制在线通话时，App 每隔几秒查看一次屏幕。当内容发生有意义的变化（幻灯片、设计稿、页面）时，会保留一张快照，并将其与期间所说的内容对应起来。如果找到通话窗口（Zoom、Meet、Teams…），则只捕获该窗口，否则捕获主显示器；绝不会捕获本 App 的窗口。快照保留在这台 Mac 上的会议文件夹中。由于“在笔记中使用屏幕快照”已打开，在撰写笔记和使用“提问”时，其中少量快照会被缩小并发送到我们的服务器，再从那里发送给 Anthropic（Claude）；你连接的 MCP App（例如 Claude 或 Cursor）也可以读取它们。删除会议会同时删除其快照。"
          }
        }
      }
    },
    "Varsayılan kısayol atanmadı: %@ Sesle yazmak için bir kısayol seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standard-Kurzbefehl wurde nicht zugewiesen: %@ Wähle einen Kurzbefehl für die Spracheingabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default shortcut wasn't assigned: %@ Choose a shortcut for voice typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha asignado el atajo predeterminado: %@ Elige un atajo para la escritura por voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuspikanäppäintä ei määritetty: %@ Valitse puhekirjoitukselle pikanäppäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci par défaut n’a pas été attribué : %@ Choisissez un raccourci pour la saisie vocale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbreviazione predefinita non è stata assegnata: %@ Scegli un’abbreviazione per la scrittura vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのショートカットを割り当てられませんでした：%@ 音声入力のショートカットを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 단축키가 지정되지 않았습니다: %@ 음성 입력용 단축키를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaardtoetscombinatie is niet toegewezen: %@ Kies een toetscombinatie voor spraaktypen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho padrão não foi atribuído: %@ Escolha um atalho para a digitação por voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未分配默认快捷键：%@ 请为语音输入选择快捷键。"
          }
        }
      }
    },
    "Kısayol seç": {
