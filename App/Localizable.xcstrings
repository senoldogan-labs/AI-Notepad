    "\"%@\" klasörüne, hesap gerekmez": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einen Ordner „%@“, kein Account nötig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into a \"%@\" folder, no account needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una carpeta “%@”, sin necesidad de cuenta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansioon ”%@”, tiliä ei tarvita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un dossier « %@ », sans compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una cartella “%@”, senza account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」フォルダへ（アカウント不要）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 폴더에 저장, 계정 필요 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In een map \"%@\", geen account nodig"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma pasta \"%@\", sem precisar de conta"
