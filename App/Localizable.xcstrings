    "Mesaj boş; ne olduğunu birkaç cümleyle yaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht ist leer; beschreibe in ein paar Sätzen, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is empty; describe what happened in a few sentences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje está vacío; describe lo que ha pasado en unas pocas frases."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viesti on tyhjä; kuvaile muutamalla lauseella, mitä tapahtui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est vide ; décrivez ce qui s’est passé en quelques phrases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio è vuoto; descrivi cosa è successo in poche frasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが空です。何が起きたかを数文で説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 비어 있습니다. 무슨 일이 있었는지 몇 문장으로 설명하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht is leeg; beschrijf in een paar zinnen wat er gebeurde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem está vazia; descreva o que aconteceu em algumas frases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息为空；请用几句话描述发生了什么。"
          }
        }
      }
    },
    "Mesaj çok uzun (%lld / %lld karakter); kısaltıp yeniden gönder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht ist zu lang (%lld / %lld Zeichen); kürze sie und sende sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is too long (%lld / %lld characters); shorten it and send again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje es demasiado largo (%lld/%lld caracteres); acórtalo y vuelve a enviarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viesti on liian pitkä (%lld / %lld merkkiä); lyhennä sitä ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est trop long (%lld / %lld caractères) ; raccourcissez-le et renvoyez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio è troppo lungo (%lld / %lld caratteri); accorcialo e invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが長すぎます（%lld/%lld文字）。短くしてからもう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 너무 깁니다(%lld / %lld자). 줄여서 다시 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht is te lang (%lld / %lld tekens); maak het korter en verstuur het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem é longa demais (%lld / %lld caracteres); encurte-a e envie de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息过长（%lld / %lld 个字符）；请缩短后再发送。"
          }
        }
      }
    },
    "Mesajın, yazdıysan e-postan ve işaretliyse tanılama bilgisi Gistsmith'in geliştiricisinin sunucusuna gider ve hesabınla ilişkilendirilir; göndermek için giriş yapmış olmalısın. Toplantı içeriği gönderilmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht, deine E-Mail-Adresse (falls angegeben) und die Diagnoseinfos (falls ausgewählt) gehen an den Server des Entwicklers von Gistsmith und werden mit deinem Account verknüpft; zum Senden musst du angemeldet sein. Es werden keine Meeting-Inhalte gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message, your email if you entered one, and the diagnostic info if checked go to the server of Gistsmith's developer and are linked to your account; you need to be signed in to send. No meeting content is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje, tu correo si lo has introducido y la información de diagnóstico si la has marcado van al servidor del desarrollador de Gistsmith y se vinculan a tu cuenta; necesitas haber iniciado sesión para enviarlo. No se envía ningún contenido de las reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi, sähköpostiosoitteesi (jos annoit sen) ja diagnostiikkatiedot (jos valittu) menevät Gistsmithin kehittäjän palvelimelle ja yhdistetään tiliisi; lähettäminen vaatii kirjautumisen. Kokousten sisältöä ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message, votre e-mail si vous l’avez saisi et les informations de diagnostic si elles sont cochées sont envoyés au serveur du développeur de Gistsmith et liés à votre compte ; vous devez être connecté pour envoyer. Aucun contenu de réunion n’est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio, la tua email se l’hai inserita e le informazioni diagnostiche se selezionate vanno al server dello sviluppatore di Gistsmith e sono collegati al tuo account; devi aver eseguito l’accesso per inviare. Nessun contenuto delle riunioni viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、入力した場合はメールアドレス、チェックした場合は診断情報が、Gistsmithの開発者のサーバに送られ、アカウントに紐付けられます。送信するにはサインインが必要です。会議の内容は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 입력한 경우 이메일, 선택한 경우 진단 정보가 Gistsmith 개발자의 서버로 전송되며 계정에 연결됩니다. 보내려면 로그인해야 합니다. 회의 내용은 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht, je e-mailadres als je dat hebt ingevuld, en de diagnose-informatie als die is aangevinkt, gaan naar de server van de ontwikkelaar van Gistsmith en worden aan je account gekoppeld; je moet ingelogd zijn om te versturen. Er wordt geen vergaderinhoud verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem, seu e-mail (se você digitou um) e as informações de diagnóstico (se marcadas) vão para o servidor do desenvolvedor do Gistsmith e ficam vinculados à sua conta; é preciso ter sessão iniciada para enviar. Nenhum conteúdo de reunião é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的消息、你输入的电子邮件地址（如有）以及勾选的诊断信息会发送到 Gistsmith 开发者的服务器，并与你的账户关联；你需要登录才能发送。不会发送任何会议内容。"
          }
        }
      }
    },
    "Mesajın, yazdıysan e-postan ve işaretliyse tanılama bilgisi Gistsmith'in geliştiricisinin sunucusuna gider. Toplantı içeriği ve anahtarlar gönderilmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht, deine E-Mail-Adresse (falls angegeben) und die Diagnoseinfos (falls ausgewählt) gehen an den Server des Entwicklers von Gistsmith. Es werden keine Meeting-Inhalte und keine Schlüssel gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message, your email if you entered one, and the diagnostic info if checked go to the server of Gistsmith's developer. No meeting content and no keys are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje, tu correo si lo has introducido y la información de diagnóstico si la has marcado van al servidor del desarrollador de Gistsmith. No se envía ningún contenido de las reuniones ni ninguna clave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi, sähköpostiosoitteesi (jos annoit sen) ja diagnostiikkatiedot (jos valittu) menevät Gistsmithin kehittäjän palvelimelle. Kokousten sisältöä tai avaimia ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message, votre e-mail si vous l’avez saisi et les informations de diagnostic si elles sont cochées sont envoyés au serveur du développeur de Gistsmith. Aucun contenu de réunion ni aucune clé ne sont envoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio, la tua email se l’hai inserita e le informazioni diagnostiche se selezionate vanno al server dello sviluppatore di Gistsmith. Non vengono inviati né contenuti delle riunioni né chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、入力した場合はメールアドレス、チェックした場合は診断情報が、Gistsmithの開発者のサーバに送られます。会議の内容やキーは送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 입력한 경우 이메일, 선택한 경우 진단 정보가 Gistsmith 개발자의 서버로 전송됩니다. 회의 내용과 키는 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht, je e-mailadres als je dat hebt ingevuld, en de diagnose-informatie als die is aangevinkt, gaan naar de server van de ontwikkelaar van Gistsmith. Er worden geen vergaderinhoud en geen sleutels verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem, seu e-mail (se você digitou um) e as informações de diagnóstico (se marcadas) vão para o servidor do desenvolvedor do Gistsmith. Nenhum conteúdo de reunião e nenhuma chave são enviados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的消息、你输入的电子邮件地址（如有）以及勾选的诊断信息会发送到 Gistsmith 开发者的服务器。不会发送任何会议内容和密钥。"
          }
        }
      }
    },
