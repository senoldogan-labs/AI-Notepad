    "Hazır şablon: kendi şablonun olarak kaydedilir ve şimdiki metninin yerine geçer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertige Vorlage: Sie wird als deine Vorlage gespeichert und ersetzt deinen aktuellen Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready-made template: it's saved as your template and replaces your current text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantilla lista para usar: se guarda como tu plantilla y sustituye tu texto actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis pohja: se tallennetaan omaksi pohjaksesi ja korvaa nykyisen tekstisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle prêt à l'emploi : il est enregistré comme ton modèle et remplace ton texte actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello pronto: viene salvato come il tuo modello e sostituisce il testo attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既製のテンプレート：独自のテンプレートとして保存され、今のテキストは置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 템플릿: 나만의 템플릿으로 저장되며 현재 텍스트를 대체합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kant-en-klaar sjabloon: het wordt opgeslagen als jouw sjabloon en vervangt je huidige tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo pronto: é salvo como seu modelo e substitui seu texto atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现成模板：会保存为你的模板，并替换你当前的文本。"
          }
        }
      }
    },
