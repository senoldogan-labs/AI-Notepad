    "Önemli anı işaretle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige Momente hervorheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight key moments"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca los momentos clave"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korosta tärkeät hetket"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les moments clés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenzia i momenti chiave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要な瞬間をマーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 순간 하이라이트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer belangrijke momenten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque os momentos-chave"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记关键时刻"
          }
        }
      }
    },
    "Kayıtta “İşaretle”ye dokun; o an notta öne çıkar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe während der Aufnahme auf „Hervorheben“; dieser Moment wird in der Notiz hervorgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Highlight” while recording; that moment stands out in the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca “Destacar” mientras grabas; ese momento resaltará en la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta nauhoituksen aikana ”Korosta”; se hetki erottuu muistiinpanossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Marquer » pendant l’enregistrement ; ce moment ressort dans la note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “Evidenzia” durante la registrazione; quel momento risalta nella nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中に「マーク」をタップすると、その瞬間がノートで目立つように表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에 “하이라이트”를 탭하세요. 그 순간이 노트에서 강조됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik tijdens het opnemen op “Markeer”; dat moment valt op in de notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Destacar” durante a gravação; esse momento se destaca na nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时轻点“标记”；那一刻会在笔记中突出显示。"
          }
        }
      }
    },
    "Kayıtta “Notlarım”a yazdıklarını not öncelik sayar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz stellt an den Anfang, was du während der Aufnahme in „Meine Notizen“ schreibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note puts what you write in “My notes” during recording first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota da prioridad a lo que escribas en “Mis notas” durante la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpano nostaa etusijalle sen, mitä kirjoitat nauhoituksen aikana kohtaan ”Omat muistiinpanot”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note met en avant ce que vous écrivez dans « Mes notes » pendant l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota mette al primo posto ciò che scrivi in “Le mie note” durante la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中に「自分のメモ」に書いた内容は、ノートで優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에 “내 메모”에 작성한 내용이 노트에 가장 먼저 반영됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie zet wat je tijdens de opname in “Mijn notities” schrijft voorop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota coloca em primeiro lugar o que você escrever em “Minhas anotações” durante a gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记会优先采用你在录制期间写在“我的笔记”中的内容。"
          }
        }
      }
    },
    "Tek dokunuşla başlat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Tippen starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one tap"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un toque"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita yhdellä napautuksella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez d’un simple toucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con un tocco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 한 번으로 시작"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start met één tik"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um toque"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可开始"
          }
        }
      }
    },
    "Denetim Merkezi'ne ya da Kısayollar'a Gistsmith kaydını ekle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Gistsmith-Aufnahme zum Kontrollzentrum oder zu Kurzbefehlen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Gistsmith recording to Control Center or Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la grabación de Gistsmith al centro de control o a Atajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Gistsmith-nauhoitus Ohjauskeskukseen tai Pikakomentoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l’enregistrement Gistsmith au centre de contrôle ou à Raccourcis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la registrazione di Gistsmith a Centro di Controllo o a Comandi Rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmithの録音をコントロールセンターやショートカットに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 센터 또는 단축어에 Gistsmith 녹음을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg Gistsmith-opname toe aan het bedieningspaneel of Opdrachten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a gravação do Gistsmith à Central de Controle ou aos Atalhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Gistsmith 录制添加到控制中心或“快捷指令”。"
          }
        }
      }
    },
    "Notta sana düşen görevler ayrılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben werden in der Notiz hervorgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks are picked out in the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas se identifican en la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtäväsi poimitaan muistiinpanosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches sont repérées dans la note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività vengono individuate nella nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートからあなたのタスクが抽出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에서 내 할 일이 추려집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken worden uit de notitie gehaald."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas são identificadas na nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任务会在笔记中被找出。"
          }
        }
      }
    },
    "İlk toplantını kaydet; not, görevler ve transkript burada hazır olur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dein erstes Meeting auf; Notiz, Aufgaben und Transkript sind dann hier bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your first meeting; the note, tasks and transcript will be ready here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu primera reunión; la nota, las tareas y la transcripción estarán listas aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita ensimmäinen kokouksesi; muistiinpano, tehtävät ja litterointi ovat täällä valmiina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre première réunion ; la note, les tâches et la transcription seront prêtes ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua prima riunione; nota, attività e trascrizione saranno pronte qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の会議を録音すると、ノート、タスク、文字起こしがここに用意されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 회의를 녹음하세요. 노트, 할 일, 녹취록이 여기에 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je eerste vergadering op; de notitie, taken en het transcript staan hier dan klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave sua primeira reunião; a nota, as tarefas e a transcrição ficarão prontas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制你的第一个会议；笔记、任务和文字稿会在这里准备好。"
          }
        }
      }
    },
    "İlk toplantını kaydet; sonra notlarına buradan soru sor, cevap kaynağıyla gelsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dein erstes Meeting auf; stelle dann hier Fragen zu deinen Notizen und erhalte Antworten mit Quellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your first meeting; then ask your notes here and get answers with sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu primera reunión; luego pregunta a tus notas aquí y obtén respuestas con fuentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita ensimmäinen kokouksesi; sen jälkeen voit kysyä muistiinpanoiltasi täällä ja saada vastaukset lähteineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre première réunion ; ensuite, interrogez vos notes ici et obtenez des réponses avec leurs sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua prima riunione; poi interroga qui le tue note e ottieni risposte con fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の会議を録音すると、ここでノートに質問して、出典付きの回答を得られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 회의를 녹음하세요. 그런 다음 여기에서 노트에 질문하고 출처가 포함된 답변을 받으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je eerste vergadering op; stel daarna hier vragen aan je notities en krijg antwoorden met bronnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave sua primeira reunião; depois, pergunte às suas notas aqui e receba respostas com fontes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制你的第一个会议；然后在这里向你的笔记提问，获得附带来源的回答。"
          }
        }
      }
    },
    "Toplantılarda sana düşen işler burada toplanır; bitirdiklerini işaretle, ilerlemen üstte görünsün.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, die dir in Meetings zugewiesen werden, sammeln sich hier; hake Erledigtes ab und sieh oben deinen Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks assigned to you in meetings collect here; tick off what you finish and see your progress at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas que se te asignan en las reuniones se reúnen aquí; marca las que termines y consulta tu progreso arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksissa sinulle annetut tehtävät kerääntyvät tänne; rastita suorittamasi ja näe edistymisesi ylhäällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches qui vous sont attribuées en réunion sont regroupées ici ; cochez ce que vous terminez et suivez votre progression en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività assegnate a te nelle riunioni si raccolgono qui; spunta ciò che completi e vedi i tuoi progressi in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議であなたに割り当てられたタスクがここに集まります。完了したものにチェックを付けると、上部で進捗を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의에서 나에게 할당된 할 일이 여기에 모입니다. 완료한 항목을 체크하고 맨 위에서 진행 상황을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die in vergaderingen aan jou zijn toegewezen, worden hier verzameld; vink af wat je afrondt en zie bovenaan je voortgang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas atribuídas a você nas reuniões se reúnem aqui; marque o que concluir e veja seu progresso no topo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议中分配给你的任务会汇集在这里；勾选你完成的任务，并在顶部查看进度。"
          }
        }
      }
    },
