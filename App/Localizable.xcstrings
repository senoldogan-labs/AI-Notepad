    "Numarayı buradan ara; görüşme kaydedilir, not ve görevler yüz yüze kayıttaki gibi hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dial the number here; the call is recorded and the note and tasks are prepared like an in-person recording."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Nummer hier; der Anruf wird aufgezeichnet, Notiz und Aufgaben entstehen wie bei einer Aufnahme vor Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose le numéro ici ; l'appel est enregistré, et la note et les tâches sont préparées comme pour un enregistrement en personne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el número aquí; la llamada se graba y la nota y las tareas se preparan como en una grabación en persona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Componi il numero qui; la chiamata viene registrata e la nota e le attività vengono preparate come per una registrazione di persona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disque o número aqui; a chamada é gravada e a nota e as tarefas são preparadas como numa gravação presencial."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel het nummer hier; het gesprek wordt opgenomen en de notitie en taken worden gemaakt zoals bij een opname ter plekke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから番号に発信します。通話は録音され、対面の録音と同じようにメモとタスクが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 번호로 전화를 겁니다. 통화가 녹음되고 대면 녹음처럼 노트와 할 일이 준비됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里拨打号码；通话会被录音，并像面对面录音一样生成笔记和任务。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soita numeroon täältä; puhelu tallennetaan, ja muistiinpano ja tehtävät valmistellaan kuten kasvokkaisessa tallenteessa."
          }
        }
      }
    },
    "Tuş takımını aç": {
