    "Bir görevin dairesine dokununca buraya taşınır; bitirdiklerin burada birikir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Kreis einer Aufgabe, um sie hierher zu verschieben; erledigte Aufgaben sammeln sich hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a task's circle to move it here; finished tasks collect here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el círculo de una tarea para moverla aquí; las tareas terminadas se reúnen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä tehtävä tänne napauttamalla sen ympyrää; valmiit tehtävät kerääntyvät tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cercle d’une tâche pour la déplacer ici ; les tâches terminées sont regroupées ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cerchio di un’attività per spostarla qui; le attività completate si raccolgono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの丸をタップするとここに移動します。完了したタスクはここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일의 원을 탭하면 여기로 이동합니다. 완료된 할 일은 여기에 모입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het rondje van een taak om hem hierheen te verplaatsen; voltooide taken worden hier verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no círculo de uma tarefa para movê-la para cá; as tarefas concluídas se reúnem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点任务的圆圈即可将其移到这里；已完成的任务会汇集在这里。"
          }
        }
      }
    },
    "Bir görevin dairesine tıklayınca buraya taşınır; bitirdiklerin burada birikir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Kreis einer Aufgabe, um sie hierher zu verschieben; erledigte Aufgaben sammeln sich hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a task's circle to move it here; finished tasks collect here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el círculo de una tarea para moverla aquí; las tareas terminadas se reúnen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä tehtävä tänne klikkaamalla sen ympyrää; valmiit tehtävät kerääntyvät tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le cercle d’une tâche pour la déplacer ici ; les tâches terminées sont regroupées ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul cerchio di un’attività per spostarla qui; le attività completate si raccolgono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの丸をクリックするとここに移動します。完了したタスクはここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일의 원을 클릭하면 여기로 이동합니다. 완료된 할 일은 여기에 모입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op het rondje van een taak om hem hierheen te verplaatsen; voltooide taken worden hier verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no círculo de uma tarefa para movê-la para cá; as tarefas concluídas se reúnem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按任务的圆圈即可将其移到这里；已完成的任务会汇集在这里。"
          }
        }
      }
    },
