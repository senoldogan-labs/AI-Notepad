    "Deneme bitti; yeni toplantılar için abone ol. Toplantıların ve notların bu iPhone'da kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist beendet; schließe für neue Meetings ein Abo ab. Deine Meetings und Notizen bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended; subscribe for new meetings. Your meetings and notes stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha finalizado; suscríbete para tener reuniones nuevas. Tus reuniones y notas se quedan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujaksosi on päättynyt; tilaa uusia kokouksia varten. Kokouksesi ja muistiinpanosi säilyvät tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé ; abonnez-vous pour de nouvelles réunions. Vos réunions et notes restent sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova è terminata; abbonati per nuove riunioni. Le riunioni e le note restano su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了しました。新しい会議には登録が必要です。会議とノートはこのiPhoneに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 종료되었습니다. 새 회의를 하려면 구독하세요. 회의와 노트는 이 iPhone에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode is afgelopen; neem een abonnement voor nieuwe vergaderingen. Je vergaderingen en notities blijven op deze iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou; assine para novas reuniões. Suas reuniões e notas continuam neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的试用已结束；订阅后即可录制新会议。你的会议和笔记保留在这部 iPhone 上。"
          }
        }
      }
    },
    "Deneme ilk toplantınla başlar: %@, hangisi önce dolarsa.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase beginnt mit deinem ersten Meeting: %@, je nachdem, was zuerst eintritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial starts with your first meeting: %@, whichever comes first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba empieza con tu primera reunión: %@, lo que ocurra primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujakso alkaa ensimmäisestä kokouksestasi: %@ sen mukaan, kumpi täyttyy ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai commence avec votre première réunion : %@, selon ce qui arrive en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova inizia con la tua prima riunione: %@, a seconda di cosa avviene prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルは最初の会議から始まります：%@のいずれか早いほうまで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험은 첫 회의부터 시작됩니다: %@ 중 먼저 도래하는 기준이 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proefperiode begint bij je eerste vergadering: %@, wat het eerst komt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste começa com sua primeira reunião: %@, o que acontecer primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用从你的第一个会议开始：%@，以先到者为准。"
          }
        }
      }
    },
