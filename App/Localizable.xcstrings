    "Aşağıdaki \"Nasıl bağlanır\" adımlarıyla bir asistan bağladığında burada görünür.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten, die du mit den Schritten unter „So verbindest du“ verbindest, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistants you connect with the \"How to connect\" steps below appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los asistentes que conectes con los pasos de \"Cómo conectar\" de abajo aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla olevilla ”Näin yhdistät” -vaiheilla yhdistämäsi avustajat näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assistants que vous connectez avec les étapes « Comment se connecter » ci-dessous apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli assistenti che colleghi con i passaggi \"Come collegare\" qui sotto appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「接続方法」の手順でつないだアシスタントがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 '연결 방법' 단계로 연결한 어시스턴트가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten die je koppelt met de stappen onder \"Zo koppel je\" verschijnen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os assistentes que você conectar com os passos \"Como conectar\" abaixo aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照下方“如何连接”步骤连接的助手会显示在这里。"
          }
        }
      }
    },
