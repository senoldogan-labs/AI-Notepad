            "value": "Espandi tutto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 펼치기"
          }
        },
        "nl": {
