    "Sistem sesi yakalanamadı (%@, kod %lld). Çıkış cihazını kontrol edip kaydı yeniden başlat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaudio konnte nicht aufgenommen werden (%@, Code %lld). Prüfe das Ausgabegerät und starte die Aufnahme neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't capture system audio (%@, code %lld). Check the output device and restart the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido capturar el audio del sistema (%@, código %lld). Revisa el dispositivo de salida y reinicia la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmän ääntä ei voitu kaapata (%@, koodi %lld). Tarkista lähtölaite ja aloita nauhoitus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de capter l’audio du système (%@, code %lld). Vérifiez le périphérique de sortie et relancez l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile acquisire l’audio di sistema (%@, codice %lld). Controlla il dispositivo di output e riavvia la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムオーディオを取り込めませんでした（%@、コード %lld）。出力デバイスを確認して、録音をやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오를 캡처할 수 없습니다(%@, 코드 %lld). 출력 장치를 확인하고 녹음을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan systeemaudio niet opnemen (%@, code %lld). Controleer het uitvoerapparaat en start de opname opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível captar o áudio do sistema (%@, código %lld). Verifique o dispositivo de saída e reinicie a gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法捕获系统音频（%@，代码 %lld）。请检查输出设备并重新开始录制。"
          }
        }
      }
    },
