    "Bu toplantı sunucuda bir kayıt oturumuna bağlı değil; konuşmacılar canlı metinden kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting ist mit keiner Aufnahmesitzung auf dem Server verknüpft; die Sprecher bleiben wie im Live-Transkript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting isn't linked to a recording session on the server; speakers stay as in the live transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión no está vinculada a una sesión de grabación en el servidor; los interlocutores se quedan como en la transcripción en directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei ole linkitetty palvelimen nauhoitusistuntoon; puhujat pysyvät kuten reaaliaikaisessa litteroinnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’est liée à aucune session d’enregistrement sur le serveur ; les intervenants restent tels que dans la transcription en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione non è collegata a una sessione di registrazione sul server; gli interlocutori restano come nella trascrizione dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議はサーバ上の録音セッションに紐付いていません。話者はライブ文字起こしのままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의는 서버의 녹음 세션과 연결되어 있지 않습니다. 화자는 실시간 녹취록 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering is niet gekoppeld aan een opnamesessie op de server; sprekers blijven zoals in het live transcript."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião não está vinculada a uma sessão de gravação no servidor; os falantes ficam como na transcrição ao vivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议未关联服务器上的录制会话；说话人保持与实时文字稿中一致。"
          }
        }
      }
    },
    "Bu toplantı şimdilik işlenemedi; kendiliğinden yeniden denenecek.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting konnte noch nicht verarbeitet werden; es wird automatisch erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting couldn't be processed yet; it will be retried automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión aún no se ha podido procesar; se volverá a intentar automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei voitu vielä käsitellä; sitä yritetään automaattisesti uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas encore pu être traitée ; une nouvelle tentative sera faite automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora stato possibile elaborare questa riunione; verrà ritentato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議はまだ処理できていません。自動的に再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의를 아직 처리할 수 없습니다. 자동으로 다시 시도됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kon nog niet worden verwerkt; het wordt automatisch opnieuw geprobeerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi possível processar esta reunião; uma nova tentativa será feita automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议尚无法处理；将自动重试。"
          }
        }
      }
    },
    "Bu toplantıda ekran görüntüsü yok": {
