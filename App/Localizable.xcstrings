            "state": "translated",
            "value": "Acceso total gratuito: nada que pagar y nada que se renueve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen täysi käyttöoikeus: ei maksettavaa, mikään ei uusiudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès complet gratuit : rien à payer, aucun renouvellement."
          }
