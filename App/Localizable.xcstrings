    "Güvenli bir giriş penceresi açılır; parolan Apple'da ya da Google'da kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sicheres Anmeldefenster öffnet sich; dein Passwort bleibt bei Apple oder Google."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A secure sign-in window opens; your password stays with Apple or Google."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre una ventana de inicio de sesión segura; tu contraseña se queda en Apple o Google."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu kirjautumisikkuna avautuu; salasanasi pysyy Applella tai Googlella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre de connexion sécurisée s’ouvre ; votre mot de passe reste chez Apple ou Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre una finestra di accesso sicura; la tua password resta ad Apple o Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なサインインウインドウが開きます。パスワードはAppleまたはGoogleにのみ保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 로그인 윈도우가 열립니다. 암호는 Apple 또는 Google에만 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er opent een beveiligd inlogvenster; je wachtwoord blijft bij Apple of Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela segura de início de sessão se abre; sua senha fica com a Apple ou o Google."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开一个安全的登录窗口；你的密码由 Apple 或 Google 保管。"
          }
        }
      }
    },
    "Güvenli bir giriş sayfası açılır; parolan Apple'da ya da Google'da kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sichere Anmeldeseite öffnet sich; dein Passwort bleibt bei Apple oder Google."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A secure sign-in page opens; your password stays with Apple or Google."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre una página de inicio de sesión segura; tu contraseña se queda en Apple o Google."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu kirjautumissivu avautuu; salasanasi pysyy Applella tai Googlella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page de connexion sécurisée s’ouvre ; votre mot de passe reste chez Apple ou Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre una pagina di accesso sicura; la tua password resta ad Apple o Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なサインインページが開きます。パスワードはAppleまたはGoogleにのみ保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 로그인 페이지가 열립니다. 암호는 Apple 또는 Google에만 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er opent een beveiligde inlogpagina; je wachtwoord blijft bij Apple of Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
