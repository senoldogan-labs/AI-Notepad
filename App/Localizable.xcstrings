          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua nota está pronta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记已就绪"
          }
        }
      }
    },
    "Gistsmith konuşmacıları ayırır; notu, kararları ve görevleri yazar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith trennt die Sprecher und schreibt Notiz, Entscheidungen und Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith separates the speakers and writes the note, decisions and tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith separa a los hablantes y escribe la nota, las decisiones y las tareas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith erottaa puhujat ja kirjoittaa muistiinpanot, päätökset ja tehtävät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith distingue les intervenants et rédige la note, les décisions et les tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith separa i parlanti e scrive la nota, le decisioni e le attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmithが話者を分け、ノート、決定事項、タスクを書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith가 화자를 구분하고 노트, 결정 사항, 할 일을 작성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith scheidt de sprekers en schrijft de notitie, besluiten en taken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gistsmith separa quem falou e escreve a nota, as decisões e as tarefas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith 会区分说话人，并写出笔记、决策和任务。"
          }
        }
      }
    },
