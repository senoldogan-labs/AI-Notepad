    "Toplantıdaki diğer kişiler (Teams, Zoom). macOS izni ilk denemede sorar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Personen im Meeting (Teams, Zoom). macOS fragt beim ersten Versuch nach der Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other people in the meeting (Teams, Zoom). macOS asks for permission on the first try."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás personas de la reunión (Teams, Zoom). macOS pide permiso la primera vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut kokouksen osallistujat (Teams, Zoom). macOS kysyy lupaa ensimmäisellä kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres participants de la réunion (Teams, Zoom). macOS demande l’autorisation lors du premier essai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le altre persone nella riunione (Teams, Zoom). macOS chiede l’autorizzazione al primo tentativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の他の参加者（Teams、Zoom）。初回はmacOSが許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의의 다른 참석자(Teams, Zoom). 처음 시도할 때 macOS가 권한을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere mensen in de vergadering (Teams, Zoom). macOS vraagt de eerste keer om toestemming."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras pessoas na reunião (Teams, Zoom). O macOS pede permissão na primeira tentativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议中的其他人（Teams、Zoom）。首次尝试时 macOS 会请求权限。"
          }
        }
      }
    },
