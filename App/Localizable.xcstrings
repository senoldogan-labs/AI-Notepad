            "value": "Voces guardadas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetut äänet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix enregistrées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voci salvate"
          }
        },
        "ja": {
          "stringUnit": {
