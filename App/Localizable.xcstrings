    "Kod 32 karakter olmalı; diğer cihazda gösterildiği gibi yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code hat 32 Zeichen; gib ihn so ein, wie er auf deinem anderen Gerät angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has 32 characters; type it as shown on your other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código tiene 32 caracteres; escríbelo tal como aparece en tu otro dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodissa on 32 merkkiä; kirjoita se niin kuin se näkyy toisella laitteellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code comporte 32 caractères ; saisissez-le tel qu’il apparaît sur votre autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice ha 32 caratteri; scrivilo come appare sull’altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは32文字です。別のデバイスに表示されているとおりに入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 32자입니다. 다른 기기에 표시된 대로 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code heeft 32 tekens; typ hem zoals hij op je andere apparaat staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código tem 32 caracteres; digite-o como aparece no seu outro dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码为 32 个字符；请按另一台设备上显示的样子输入。"
          }
        }
      }
    },
    "Kod bu hesabın kodu değil. Diğer cihazda Ayarlar'daki kodu yeniden kontrol et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code gehört nicht zu diesem Account. Prüfe den Code in den Einstellungen deines anderen Geräts noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code isn't this account's. Check the code in Settings on your other device again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es de esta cuenta. Vuelve a comprobar el código en Ajustes en tu otro dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ei kuulu tälle tilille. Tarkista koodi uudelleen toisen laitteesi asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n’est pas celui de ce compte. Vérifiez à nouveau le code dans les Réglages de votre autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice non è di questo account. Ricontrolla il codice nelle Impostazioni dell’altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはこのアカウントのものではありません。別のデバイスの設定にあるコードをもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 이 계정의 코드가 아닙니다. 다른 기기의 설정에 있는 코드를 다시 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die code hoort niet bij dit account. Controleer de code in Instellingen op je andere apparaat nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não é desta conta. Confira de novo o código nos Ajustes do seu outro dispositivo."
          }
