    "Önümüzdeki gün takviminde toplantı yok; eklenince burada ve Ana sayfada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Meetings in deinem Kalender für den nächsten Tag; neue erscheinen hier und unter „Start“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meetings on your calendar for the next day; new ones appear here and on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay reuniones en tu calendario para el próximo día; las nuevas aparecen aquí y en Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterissasi ei ole kokouksia seuraavan vuorokauden aikana; uudet näkyvät täällä ja Koti-näkymässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réunion dans votre calendrier pour le jour à venir ; les nouvelles apparaissent ici et dans Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna riunione nel tuo calendario per il prossimo giorno; quelle nuove compaiono qui e in Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後1日、カレンダーに会議はありません。新しい会議はここと「ホーム」に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 하루 동안 캘린더에 회의가 없습니다. 새 회의는 여기와 홈에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vergaderingen in je agenda voor de komende dag; nieuwe verschijnen hier en in Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma reunião no seu calendário para o próximo dia; as novas aparecem aqui e no Início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来一天你的日历中没有会议；新会议会显示在这里和“主页”中。"
          }
        }
      }
    },
    "Google, Outlook ya da iCloud takvimin mi var? Sistem Ayarları › İnternet Hesapları'na eklediğin takvimler burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Google, Outlook oder iCloud? Kalender, die du unter „Systemeinstellungen“ › „Internetaccounts“ hinzufügst, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using Google, Outlook or iCloud? Calendars you add in System Settings › Internet Accounts appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usas Google, Outlook o iCloud? Los calendarios que añadas en Ajustes del Sistema › Cuentas de internet aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytätkö Googlea, Outlookia tai iCloudia? Kalenterit, jotka lisäät kohdassa Järjestelmäasetukset › Internet-tilit, näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez Google, Outlook ou iCloud ? Les calendriers que vous ajoutez dans Réglages Système › Comptes Internet apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usi Google, Outlook o iCloud? I calendari che aggiungi in Impostazioni di Sistema › Account Internet compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google、Outlook、iCloudをお使いですか？「システム設定」›「インターネットアカウント」で追加したカレンダーがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google, Outlook 또는 iCloud를 사용하시나요? 시스템 설정 › 인터넷 계정에서 추가한 캘린더가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je Google, Outlook of iCloud? Agenda's die je toevoegt in Systeeminstellingen › Internetaccounts verschijnen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Google, Outlook ou iCloud? Os calendários que você adicionar em Ajustes do Sistema › Contas de Internet aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google、Outlook 或 iCloud？在“系统设置 › 互联网账户”中添加的日历会显示在这里。"
          }
        }
      }
    },
