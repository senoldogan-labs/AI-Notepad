    "Başka bir hesapla giriş yaptın. Önceki hesabın kaydı ya da işlenen toplantısı bitince uygulama yeniden başlar ve bu hesabın toplantılarını açar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich mit einem anderen Account angemeldet. Sobald Aufnahme oder Verarbeitung des vorherigen Accounts abgeschlossen ist, startet die App neu und öffnet die Meetings dieses Accounts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in with another account. Once the previous account's recording or processing finishes, the app restarts and opens this account's meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has iniciado sesión con otra cuenta. Cuando termine la grabación o el procesamiento de la cuenta anterior, la app se reiniciará y abrirá las reuniones de esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduit toisella tilillä. Kun edellisen tilin nauhoitus tai käsittely päättyy, sovellus käynnistyy uudelleen ja avaa tämän tilin kokoukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes connecté avec un autre compte. Une fois l’enregistrement ou le traitement du compte précédent terminé, l’app redémarre et ouvre les réunions de ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai eseguito l’accesso con un altro account. Al termine della registrazione o dell’elaborazione dell’account precedente, l’app si riavvia e apre le riunioni di questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントでサインインしました。前のアカウントの録音または処理が完了すると、アプリが再起動してこのアカウントの会議を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정으로 로그인했습니다. 이전 계정의 녹음이나 처리가 끝나면 앱이 재시작되고 이 계정의 회의가 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent met een ander account ingelogd. Zodra de opname of verwerking van het vorige account klaar is, herstart de app en opent hij de vergaderingen van dit account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você iniciou sessão com outra conta. Quando a gravação ou o processamento da conta anterior terminar, o app reinicia e abre as reuniões desta conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已使用另一个账户登录。上一个账户的录制或处理完成后，App 会重新启动并打开此账户的会议。"
          }
        }
      }
    },
    "Başka bir hesapla giriş yapıldı; o hesabın toplantıları için uygulama yeniden başlamalı.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich mit einem anderen Account angemeldet; die App muss neu starten, um die Meetings dieses Accounts zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in with another account; the app needs to restart to open that account's meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has iniciado sesión con otra cuenta; la app debe reiniciarse para abrir las reuniones de esa cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduit toisella tilillä; sovelluksen täytyy käynnistyä uudelleen, jotta tilin kokoukset voidaan avata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes connecté avec un autre compte ; l’app doit redémarrer pour ouvrir les réunions de ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai eseguito l’accesso con un altro account; l’app deve riavviarsi per aprire le riunioni di quell’account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントでサインインしました。そのアカウントの会議を開くにはアプリの再起動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정으로 로그인했습니다. 해당 계정의 회의를 열려면 앱을 재시작해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent met een ander account ingelogd; de app moet herstarten om de vergaderingen van dat account te openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você iniciou sessão com outra conta; o app precisa reiniciar para abrir as reuniões dessa conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已使用另一个账户登录；App 需要重新启动才能打开该账户的会议。"
          }
        }
      }
    },
    "Başka bir kanal ya da hesap ekle": {
      "localizations": {
