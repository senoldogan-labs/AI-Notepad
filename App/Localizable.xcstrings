    "Apple Notlar'a yazılamadı: %@. Sistem Ayarları › Gizlilik ve Güvenlik › Otomasyon'da %@ için Notlar'a izin ver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Notizen konnte nicht geschrieben werden: %@. Erlaube „Notizen“ für %@ unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Automation“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't write to Apple Notes: %@. Allow Notes for %@ in System Settings › Privacy & Security › Automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido escribir en Notas de Apple: %@. Permite Notas para %@ en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen Muistiinpanoihin kirjoittaminen epäonnistui: %@. Salli Muistiinpanot sovellukselle %@ kohdassa Järjestelmäasetukset › Tietosuoja ja suojaus › Automaatio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire dans Notes : %@. Autorisez Notes pour %@ dans Réglages Système › Confidentialité et sécurité › Automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere in Note: %@. Consenti Note per %@ in Impostazioni di Sistema › Privacy e sicurezza › Automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メモ」に書き込めませんでした：%@。「システム設定」›「プライバシーとセキュリティ」›「オートメーション」で%@に「メモ」を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 메모에 기록할 수 없습니다: %@. 시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 %@에 대해 메모를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet naar Apple Notities schrijven: %@. Sta Notities toe voor %@ in Systeeminstellingen › Privacy en beveiliging › Automatisering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar no Notas: %@. Permita o Notas para %@ em Ajustes do Sistema › Privacidade e Segurança › Automação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入 Apple 备忘录：%1$@。请在“系统设置 › 隐私与安全性 › 自动化”中为 %2$@ 允许“备忘录”。"
          }
        }
      }
    },
