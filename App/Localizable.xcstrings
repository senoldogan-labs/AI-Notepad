    "Süre dolunca ses dosyaları silinir; metin ve not kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiodateien werden nach diesem Zeitraum gelöscht; Transkript und Notiz bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio files are deleted after this period; the transcript and note remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de audio se eliminan tras este periodo; la transcripción y la nota se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitiedostot poistetaan tämän ajan jälkeen; litterointi ja muistiinpano säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers audio sont supprimés après cette durée ; la transcription et la note sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file audio vengono eliminati dopo questo periodo; trascrizione e nota restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間が過ぎると音声ファイルは削除されます。文字起こしとノートは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간이 지나면 오디오 파일이 삭제되며, 녹취록과 노트는 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiobestanden worden na deze periode verwijderd; het transcript en de notitie blijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de áudio são apagados após este período; a transcrição e a nota continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频文件会在此期限后删除；文字稿和笔记仍保留。"
          }
        }
      }
    },
    "Süren AI-Notepad kaydını bitirir; not hazırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die aktuelle AI-Notepad-Aufnahme; die Notiz wird vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishes the current AI-Notepad recording; the note is prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la grabación actual de AI-Notepad; se prepara la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopettaa käynnissä olevan AI-Notepad-nauhoituksen; muistiinpano valmistellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine l’enregistrement AI-Notepad en cours ; la note est préparée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la registrazione in corso di AI-Notepad; la nota viene preparata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のAI-Notepadの録音を終了し、ノートを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 AI-Notepad 녹음을 종료하고 노트를 준비합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondt de huidige AI-Notepad-opname af; de notitie wordt voorbereid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a gravação atual do AI-Notepad; a nota é preparada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束当前的 AI-Notepad 录制；会准备笔记。"
          }
        }
      }
    },
