            "state": "translated",
            "value": "Kokousta käsitellään; voit tallentaa, kun se on valmis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion est en cours de traitement ; vous pourrez enregistrer une fois terminé"
          }
        },
        "it": {
