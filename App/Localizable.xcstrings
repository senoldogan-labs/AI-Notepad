            "value": "La registrazione potrebbe essersi interrotta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が停止した可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 멈췄을 수 있음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is mogelijk gestopt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação pode ter parado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制可能已停止"
          }
        }
      }
    },
    "Uygulama kaydı sürdüremedi. Açıp kaydın durumuna bak; o ana kadarki ses saklandı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte die Aufnahme nicht fortsetzen. Öffne sie und prüfe die Aufnahme; der Ton bis dahin ist gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't keep recording. Open it to check the recording; the audio up to that point is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no pudo seguir grabando. Ábrela para revisar la grabación; el audio hasta ese momento está guardado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei voinut jatkaa nauhoitusta. Avaa se ja tarkista nauhoitus; siihen asti tallentunut ääni on tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas pu poursuivre l’enregistrement. Ouvrez-la pour vérifier ; l’audio jusqu’à ce moment est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non è riuscita a continuare la registrazione. Aprila per controllare; l’audio fino a quel momento è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが録音を続けられませんでした。開いて録音の状態を確認してください。その時点までの音声は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 녹음을 계속하지 못했습니다. 앱을 열어 녹음 상태를 확인하세요. 그때까지의 오디오는 저장되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app kon de opname niet voortzetten. Open de app om te controleren; de audio tot dat moment is bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não conseguiu continuar gravando. Abra-o para verificar; o áudio até aquele momento foi salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法继续录制。打开应用查看录制状态；在此之前的音频已保存。"
          }
        }
      }
    },
    "Toplantı bitti mi?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Meeting vorbei?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the meeting over?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Terminó la reunión?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättyikö kokous?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion est-elle terminée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è finita?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議は終わりましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 끝났나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is de vergadering voorbij?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reunião terminou?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议结束了吗？"
          }
        }
      }
    },
    "Takvimdeki toplantının süresi doldu ama kayıt sürüyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kalendermeeting ist vorbei, aber die Aufnahme läuft noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar meeting has ended but the recording is still running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión del calendario terminó, pero la grabación sigue."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterin kokous on päättynyt, mutta nauhoitus jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion du calendrier est terminée mais l’enregistrement continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione in calendario è finita ma la registrazione continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの会議は終了しましたが、録音はまだ続いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 회의는 끝났지만 녹음은 아직 진행 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De agendavergadering is voorbij, maar de opname loopt nog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reunião da agenda terminou, mas a gravação continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历中的会议已结束，但录制仍在进行。"
          }
        }
      }
    },
    "10 dakikadır konuşma duyulmadı ama kayıt sürüyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit 10 Minuten spricht niemand, aber die Aufnahme läuft noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one has spoken for 10 minutes but the recording is still running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie ha hablado en 10 minutos, pero la grabación sigue."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei ole puhunut 10 minuuttiin, mutta nauhoitus jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’a parlé depuis 10 minutes mais l’enregistrement continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno parla da 10 minuti ma la registrazione continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10分間話し声がありませんが、録音はまだ続いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10분 동안 아무도 말하지 않았지만 녹음은 아직 진행 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al 10 minuten niets gezegd, maar de opname loopt nog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém falou nos últimos 10 minutos, mas a gravação continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 10 分钟没有人说话，但录制仍在进行。"
          }
        }
      }
    },
    "Kayıt sürüyor": {
      "localizations": {
