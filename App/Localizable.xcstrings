    "Bir toplantının transkriptinde konuşmacıya bu şirketten birinin adını verince toplantıları burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einem Sprecher im Transkript eines Meetings den Namen einer Person aus diesem Unternehmen gibst, erscheint das Meeting hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give a speaker the name of someone from this company in a meeting's transcript, the meeting shows up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando das a un hablante el nombre de alguien de esta empresa en la transcripción de una reunión, la reunión aparece aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun annat kokouksen litteroinnissa puhujalle tämän yrityksen henkilön nimen, kokous näkyy täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu donnes à un intervenant le nom d’une personne de cette entreprise dans la transcription d’une réunion, la réunion apparaît ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai a un interlocutore il nome di qualcuno di questa azienda nella trascrizione di una riunione, la riunione compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の文字起こしで話者にこの会社の人の名前を付けると、その会議がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 전사본에서 화자에게 이 회사 사람의 이름을 지정하면 그 회의가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een spreker in het transcript van een vergadering de naam geeft van iemand van dit bedrijf, verschijnt de vergadering hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você dá a um participante o nome de alguém desta empresa na transcrição de uma reunião, a reunião aparece aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在会议转写中给发言人指定这家公司某人的名字后，该会议就会显示在这里。"
          }
        }
      }
    },
