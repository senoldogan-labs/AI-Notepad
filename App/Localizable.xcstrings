    "Bu Mac Apple ile doğrulanamadı (DeviceCheck). İnternet bağlantını kontrol edip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac konnte nicht bei Apple verifiziert werden (DeviceCheck). Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac couldn't be verified with Apple (DeviceCheck). Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar este Mac con Apple (DeviceCheck). Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä Macia ei voitu varmentaa Applen kanssa (DeviceCheck). Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas pu être vérifié auprès d’Apple (DeviceCheck). Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare questo Mac con Apple (DeviceCheck). Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacをAppleで確認できませんでした（DeviceCheck）。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 이 Mac을 확인할 수 없습니다(DeviceCheck). 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kon niet bij Apple worden geverifieerd (DeviceCheck). Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar este Mac com a Apple (DeviceCheck). Verifique sua conexão com a internet e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Apple 验证这台 Mac（DeviceCheck）。请检查你的互联网连接后重试。"
          }
        }
      }
    },
    "Bu Mac Apple tarafından doğrulanamadı; uygulamayı yeniden açıp tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte diesen Mac nicht verifizieren; öffne die App erneut und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't verify this Mac; reopen the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha podido verificar este Mac; vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ei voinut varmentaa tätä Macia; avaa sovellus uudelleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas pu vérifier ce Mac ; rouvrez l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non è riuscita a verificare questo Mac; riapri l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleがこのMacを確認できませんでした。アプリを開き直して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 이 Mac을 확인할 수 없습니다. 앱을 다시 열고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple kon deze Mac niet verifiëren; open de app opnieuw en probeer het nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não conseguiu verificar este Mac; reabra o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 无法验证这台 Mac；请重新打开 App 后重试。"
          }
        }
      }
    },
    "Bu Mac Apple'ın cihaz doğrulamasını (DeviceCheck) desteklemiyor; ücretsiz deneme başlatılamıyor. Abone olarak devam edebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt Apples Geräteverifizierung (DeviceCheck) nicht, daher kann kein kostenloser Test starten. Du kannst mit einem Abo fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't support Apple's device verification (DeviceCheck), so a free trial can't start. You can continue by subscribing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no admite la verificación de dispositivos de Apple (DeviceCheck), así que no se puede iniciar una prueba gratuita. Puedes continuar suscribiéndote."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei tue Applen laitevarmennusta (DeviceCheck), joten ilmaista kokeilujaksoa ei voi aloittaa. Voit jatkaa tilaamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge la vérification d’appareil d’Apple (DeviceCheck) ; un essai gratuit ne peut donc pas commencer. Vous pouvez continuer en vous abonnant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non supporta la verifica del dispositivo di Apple (DeviceCheck), quindi la prova gratuita non può iniziare. Puoi continuare abbonandoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはAppleのデバイス確認（DeviceCheck）に対応していないため、無料トライアルを開始できません。登録すると引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 Apple의 기기 확인(DeviceCheck)을 지원하지 않아 무료 체험을 시작할 수 없습니다. 구독하면 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac ondersteunt Apples apparaatverificatie (DeviceCheck) niet, dus er kan geen gratis proefperiode starten. Je kunt doorgaan door een abonnement te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não é compatível com a verificação de dispositivo da Apple (DeviceCheck), então não é possível iniciar um teste grátis. Você pode continuar assinando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不支持 Apple 的设备验证（DeviceCheck），因此无法开始免费试用。你可以订阅以继续使用。"
          }
        }
      }
    },
