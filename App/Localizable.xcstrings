    "Yapılandırmayı istemcinin MCP ayarlarına ekle; istemci yalnızca okur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diese Konfiguration in die MCP-Einstellungen des Clients ein; der Client liest nur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this configuration to the client's MCP settings; the client only reads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade esta configuración a los ajustes MCP del cliente; el cliente solo lee."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä määritys asiakkaan MCP-asetuksiin; asiakas vain lukee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute cette configuration aux réglages MCP du client ; le client ne fait que lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questa configurazione alle impostazioni MCP del client; il client legge soltanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この構成をクライアントのMCP設定に追加してください。クライアントは読み取るだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구성을 클라이언트의 MCP 설정에 추가하세요. 클라이언트는 읽기만 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg deze configuratie toe aan de MCP-instellingen van de client; de client leest alleen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione esta configuração aos ajustes de MCP do cliente; o cliente apenas lê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此配置添加到客户端的 MCP 设置中；客户端只会读取。"
          }
        }
      }
    },
