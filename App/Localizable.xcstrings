    },
    "Bitince toplantının sayfası": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meeting-Seite am Ende"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting page when it ends"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página de la reunión al terminar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoussivu, kun se päättyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page de la réunion à la fin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
