    "%@: %@ Bu toplantı artık kendiliğinden gönderilmeyecek; hedefi Ayarlar'da kontrol edip notu toplantı sayfasından yeniden gönder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Dieses Meeting wird nicht mehr automatisch gesendet; prüfe das Ziel in den Einstellungen und sende die Notiz dann erneut von der Meeting-Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ This meeting won’t be sent automatically again; check the destination in Settings, then resend the note from the meeting page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Esta reunión ya no se enviará automáticamente; revisa el destino en Ajustes y vuelve a enviar la nota desde la página de la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Tätä kokousta ei enää lähetetä automaattisesti; tarkista kohde Asetuksista ja lähetä muistiinpano uudelleen kokouksen sivulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %@ Cette réunion ne sera plus envoyée automatiquement ; vérifiez la destination dans les Réglages, puis renvoyez la note depuis la page de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Questa riunione non verrà più inviata automaticamente; controlla la destinazione nelle Impostazioni, poi invia di nuovo la nota dalla pagina della riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ この会議は今後自動送信されません。設定で送信先を確認してから、会議ページからノートを再送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ 이 회의는 더 이상 자동으로 전송되지 않습니다. 설정에서 대상을 확인한 후 회의 페이지에서 노트를 다시 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Deze vergadering wordt niet meer automatisch verstuurd; controleer de bestemming in Instellingen en verstuur de notitie opnieuw vanaf de vergaderpagina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ Esta reunião não será mais enviada automaticamente; verifique o destino nos Ajustes e reenvie a nota pela página da reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ 此会议将不再自动发送；请在设置中检查目标，然后在会议页面重新发送笔记。"
          }
        }
      }
    },
    "Bu deneme iOS 27'nin ScreenCaptureKit'ini kullanır; iOS 27 gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Experiment nutzt ScreenCaptureKit aus iOS 27; dafür ist iOS 27 erforderlich."
          }
        },
