          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't be used: pick a letter or digit together with ⌃, ⌥ or ⌘."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar %@: elige una letra o un número junto con ⌃, ⌥ o ⌘."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei kelpaa: valitse kirjain tai numero yhdessä näppäimen ⌃, ⌥ tai ⌘ kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être utilisé : choisissez une lettre ou un chiffre avec ⌃, ⌥ ou ⌘."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere usato: scegli una lettera o una cifra insieme a ⌃, ⌥ o ⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は使用できません：⌃、⌥、⌘のいずれかと文字または数字を組み合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 사용할 수 없습니다: ⌃, ⌥ 또는 ⌘와 함께 문자나 숫자를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
