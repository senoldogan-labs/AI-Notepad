    "Bir sonraki toplantını kaydetmeyi unutma": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht, dein nächstes Meeting aufzunehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget to record your next meeting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No olvides grabar tu próxima reunión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muista nauhoittaa seuraava kokouksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’oubliez pas d’enregistrer votre prochaine réunion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare di registrare la prossima riunione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の会議の録音をお忘れなく"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 회의 녹음을 잊지 마세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet je volgende vergadering niet op te nemen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se esqueça de gravar sua próxima reunião"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别忘了录制你的下一场会议"
          }
        }
