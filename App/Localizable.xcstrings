    "Giriş yapıldı, durum bilinmiyor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet, Status unbekannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in, status unknown"
          }
        },
        "es": {
          "stringUnit": {
