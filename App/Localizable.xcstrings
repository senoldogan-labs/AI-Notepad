    "Ad konuşma tanımaya verilir; bir toplantıda konuşmacıya bu adı verince toplantıları ve görevleri burada toplanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird an die Spracherkennung übergeben; wenn du einem Sprecher in einem Meeting diesen Namen gibst, werden seine Meetings und Aufgaben hier gesammelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is given to speech recognition; when you give a speaker this name in a meeting, their meetings and tasks gather here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se proporciona al reconocimiento de voz; cuando das este nombre a un interlocutor en una reunión, sus reuniones y tareas se reúnen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi annetaan puheentunnistukselle; kun annat puhujalle tämän nimen kokouksessa, hänen kokouksensa ja tehtävänsä kootaan tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom est transmis à la reconnaissance vocale ; quand vous donnez ce nom à un intervenant dans une réunion, ses réunions et tâches sont regroupées ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome viene fornito al riconoscimento vocale; quando assegni questo nome a un interlocutore in una riunione, le sue riunioni e attività si raccolgono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前は音声認識に渡されます。会議で話者にこの名前を付けると、その人の会議とタスクがここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 음성 인식에 전달됩니다. 회의에서 화자에게 이 이름을 지정하면 해당 화자의 회의와 할 일이 여기에 모입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam wordt aan de spraakherkenning doorgegeven; als je een spreker in een vergadering deze naam geeft, worden diens vergaderingen en taken hier verzameld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome é passado ao reconhecimento de fala; quando você der este nome a um falante em uma reunião, as reuniões e tarefas dele se reúnem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名字会提供给语音识别；当你在会议中给说话人起这个名字时，其会议和任务会汇集到这里。"
          }
        }
      }
    },
    "Ad toplantılarda verildi; değiştirmek için toplantının Transkript sekmesini kullan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wurde in Meetings vergeben; ändere ihn im Tab „Transkript“ des Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name was given in meetings; to change it, use the meeting's Transcript tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se asignó en las reuniones; para cambiarlo, usa la pestaña Transcripción de la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi annettiin kokouksissa; muuta sitä kokouksen Litterointi-välilehdellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom a été attribué dans des réunions ; pour le modifier, utilisez l’onglet Transcription de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome è stato assegnato nelle riunioni; per cambiarlo, usa la scheda Trascrizione della riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前は会議で付けられたものです。変更するには、会議の「文字起こし」タブを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 회의에서 지정되었습니다. 변경하려면 회의의 녹취록 탭을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam is in vergaderingen gegeven; gebruik het tabblad Transcript van de vergadering om hem te wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome foi dado nas reuniões; para alterá-lo, use a aba Transcrição da reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名字是在会议中设定的；要更改，请使用会议的“文字稿”标签页。"
          }
        }
      }
    },
