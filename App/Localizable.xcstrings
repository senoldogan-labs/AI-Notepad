    "%@ kotası doldu. Hesabından kota ekle ya da Ayarlar'dan Mac'te motorunu seç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent bei %@ ist aufgebraucht. Lade dort Guthaben auf oder wähle in den Einstellungen die Engine „Auf diesem Mac“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quota is used up. Add quota to your account or choose the On-Mac engine in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado la cuota de %@. Añade cuota a tu cuenta o elige el motor En el Mac en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kiintiö on käytetty loppuun. Lisää kiintiötä tilillesi tai valitse Asetuksissa Macissa toimiva moottori."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota %@ est épuisé. Ajoutez du quota à votre compte ou choisissez le moteur sur le Mac dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota di %@ è esaurita. Aggiungi quota al tuo account o scegli il motore Sul Mac in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の利用枠を使い切りました。アカウントに利用枠を追加するか、設定で「Mac上」エンジンを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 할당량을 모두 사용했습니다. 계정에 할당량을 추가하거나 설정에서 '이 Mac에서' 엔진을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het %@-tegoed is op. Vul het tegoed in je account aan of kies in Instellingen de engine Op de Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota de %@ acabou. Adicione cota à sua conta ou escolha o mecanismo no Mac em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 额度已用完。请为你的账户增加额度，或在设置中选择“Mac 本机”引擎。"
          }
        }
      }
    },
    "%@ kullanılamaz: ⌃, ⌥ ya da ⌘ ile birlikte bir harf/rakam seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
