    "Gistsmith seni tanıdıkça notlarda sana düşen işleri doğru ayırır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr Gistsmith über dich weiß, desto besser erkennt es, welche Aufgaben deine sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more Gistsmith knows about you, the better it sorts out which tasks are yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más sabe Gistsmith de ti, mejor distingue qué tareas son tuyas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä paremmin Gistsmith tuntee sinut, sitä paremmin se erottaa, mitkä tehtävät ovat sinun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus Gistsmith vous connaît, mieux il repère les tâches qui sont les vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più Gistsmith ti conosce, meglio capisce quali attività sono tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith があなたのことを知るほど、どのタスクがあなたのものかを正しく分けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith가 당신을 더 잘 알수록 어떤 할 일이 당신의 것인지 더 정확히 구분합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe meer Gistsmith over je weet, hoe beter het ziet welke taken van jou zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais o Gistsmith sabe sobre você, melhor ele separa as tarefas que são suas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith 越了解你，就越能准确分出哪些任务是你的。"
          }
        }
      }
    },
