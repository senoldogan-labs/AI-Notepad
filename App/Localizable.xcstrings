            "state": "translated",
            "value": "Mikrofonista ei tule ääntä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun son du micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suono dal microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクから音声が届いていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크에서 소리가 들어오지 않음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen geluid van de microfoon"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem som do microfone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风没有声音"
          }
        }
      }
    },
    "Kayıt sürüyor ama mikrofon kesildi; yeniden bağlanmaya çalışılıyor. Mikrofonu ya da kulaklığı kontrol et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme läuft weiter, aber das Mikrofon ist ausgefallen; es wird neu verbunden. Prüfe Mikrofon oder Headset."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is still running but the microphone dropped out; trying to reconnect. Check your microphone or headset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación sigue, pero el micrófono se cortó; intentando reconectar. Revisa el micrófono o los auriculares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus jatkuu, mutta mikrofoni katkesi; yhdistetään uudelleen. Tarkista mikrofoni tai kuulokkeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement continue mais le micro a décroché ; reconnexion en cours. Vérifiez votre micro ou votre casque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione continua ma il microfono si è interrotto; tentativo di riconnessione. Controlla il microfono o le cuffie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は続いていますが、マイクが途切れました。再接続を試みています。マイクやヘッドセットを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 계속되지만 마이크가 끊겼습니다. 다시 연결하는 중입니다. 마이크나 헤드셋을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname loopt nog, maar de microfoon viel weg; er wordt opnieuw verbonden. Controleer je microfoon of headset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação continua, mas o microfone caiu; tentando reconectar. Verifique o microfone ou o fone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制仍在进行，但麦克风已中断，正在尝试重新连接。请检查麦克风或耳机。"
          }
        }
      }
    },
