    "Çevrimdışı kaydedildi; bağlantı gelince konuşmacılar ve not hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline aufgenommen; Sprecher und Notiz werden erstellt, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded offline; speakers and the note are prepared when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabado sin conexión; los interlocutores y la nota se prepararán cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitettu offline-tilassa; puhujat ja muistiinpano valmistellaan, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré hors ligne ; les intervenants et la note seront préparés lorsque vous serez de nouveau en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrata offline; interlocutori e nota vengono preparati quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで録音しました。話者とノートはオンラインに戻ったときに作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인으로 녹음했습니다. 다시 온라인 상태가 되면 화자와 노트가 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline opgenomen; sprekers en de notitie worden gemaakt zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada offline; os falantes e a nota são preparados quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已离线录制；恢复联网后会准备说话人和笔记。"
          }
        }
      }
    },
    "Çevrimdışı kaydediliyor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
