    "Bağlantıya sahip olan herkes notu görebilir; biz göremeyiz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle mit dem Link können die Notiz sehen; wir nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can see the note; we can't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con el enlace puede ver la nota; nosotros no."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa, jolla on linkki, näkee muistiinpanon; me emme näe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut voir la note ; nous, non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia il link può vedere la nota; noi no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを知っている人は誰でもメモを見られます。私たちには見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 있는 사람은 누구나 노트를 볼 수 있지만 저희는 볼 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met de link kan de notitie zien; wij niet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com o link pode ver a nota; nós não."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有链接的人都能查看这条笔记；我们看不到。"
          }
        }
      }
