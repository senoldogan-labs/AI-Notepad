            "value": "No se pudo crear el enlace; vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkkiä ei voitu luoda; yritä uudelleen."
          }
        },
        "fr": {
