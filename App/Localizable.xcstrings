        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier sélectionné ; les notes y seront écrites dès qu’elles seront prêtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella selezionata; le note verranno scritte qui quando sono pronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択しました。ノートの準備ができると、ここに書き込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택했습니다. 노트가 준비되면 여기에 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Map geselecteerd; notities worden hier geschreven als ze klaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta selecionada; as notas serão gravadas aqui quando ficarem prontas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择文件夹；笔记准备好后会写入这里。"
          }
        }
      }
    },
