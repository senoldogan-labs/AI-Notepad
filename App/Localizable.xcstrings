    },
    "Bu toplantıda hangisi sendin?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Sprecher warst du in diesem Meeting?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which speaker were you in this meeting?"
          }
        },
        "es": {
          "stringUnit": {
