            "value": "Prova gratuita: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアル：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험: %@."
          }
        },
        "nl": {
