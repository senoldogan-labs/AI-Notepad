    "Bu davet kodu bulunamadı. Kodu kontrol edip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Einladungscode wurde nicht gefunden. Prüfe ihn und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find this invite code. Check it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos encontrado este código de invitación. Revísalo e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kutsukoodia ei löytynyt. Tarkista se ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d’invitation est introuvable. Vérifiez-le et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato questo codice invito. Controllalo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待コードが見つかりませんでした。確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초대 코드를 찾을 수 없습니다. 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden deze uitnodigingscode niet vinden. Controleer hem en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos este código de convite. Verifique-o e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此邀请码。请检查后重试。"
          }
        }
      }
    },
    "Kendi davet kodunu kullanamazsın.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deinen eigenen Einladungscode nicht verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't use your own invite code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes usar tu propio código de invitación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi käyttää omaa kutsukoodiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas utiliser votre propre code d’invitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi usare il tuo codice invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の招待コードは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 초대 코드는 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt je eigen uitnodigingscode niet gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode usar seu próprio código de convite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能使用自己的邀请码。"
          }
        }
      }
    },
    "Davet kodu yalnızca ilk aboneliğinde kullanılabilir; bu hesap için geçerli değil.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungscodes gelten nur für ein erstes Abo, daher gilt dieser nicht für diesen Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite codes only work for a first subscription, so this one doesn't apply to this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos de invitación solo sirven para una primera suscripción, así que este no se aplica a esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsukoodit toimivat vain ensimmäiseen tilaukseen, joten tämä ei koske tätä tiliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes d’invitation ne fonctionnent que pour un premier abonnement ; celui-ci ne s’applique donc pas à ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici invito valgono solo per il primo abbonamento, quindi questo non si applica a questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードは初回のサブスクリプションにのみ有効なため、このアカウントには適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드는 첫 구독에만 적용되므로 이 계정에는 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigingscodes werken alleen voor een eerste abonnement, dus deze geldt niet voor dit account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de convite só valem para uma primeira assinatura, então este não se aplica a esta conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请码仅适用于首次订阅，因此不适用于此账户。"
          }
        }
      }
    },
    "Davet programı şu an kapalı; davet kodu olmadan abone olabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Einladungsprogramm ist gerade pausiert. Du kannst trotzdem ohne Code ein Abo abschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invite program is paused right now. You can still subscribe without a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa de invitaciones está en pausa ahora mismo. Puedes suscribirte igualmente sin código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsuohjelma on juuri nyt tauolla. Voit silti tilata ilman koodia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme d’invitation est suspendu pour le moment. Vous pouvez toujours vous abonner sans code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma inviti è sospeso al momento. Puoi comunque abbonarti senza codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待プログラムは現在一時停止中です。コードなしでも登録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 프로그램이 현재 일시 중단되었습니다. 코드 없이도 구독할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitnodigingsprogramma is momenteel gepauzeerd. Je kunt nog steeds zonder code een abonnement nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa de convites está pausado no momento. Você ainda pode assinar sem um código."
