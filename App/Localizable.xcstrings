    "Yarın onda kısa bir toplantı yapalım, sunumu ben getiririm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's have a quick meeting at ten tomorrow, I'll bring the slides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns morgen um zehn kurz treffen, ich bringe die Folien mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faisons une courte réunion demain à dix heures, j'apporte les slides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagamos una reunión breve mañana a las diez, yo llevo la presentación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facciamo una breve riunione domani alle dieci, porto io le slide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos fazer uma reunião rápida amanhã às dez, eu levo os slides."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten we morgen om tien kort vergaderen, ik neem de slides mee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日10時に短い打ち合わせをしましょう。資料は私が持っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
