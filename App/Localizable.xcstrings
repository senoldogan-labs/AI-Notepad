    "Şirketler kişilerin e-posta adreslerinden gelir; bir kişiye iş e-postası ekleyince şirketi burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unternehmen ergeben sich aus den E-Mail-Adressen deiner Personen; füge einer Person eine geschäftliche E-Mail hinzu, dann erscheint ihr Unternehmen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Companies come from people's email addresses; add a work email to someone and their company shows up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las empresas salen de las direcciones de correo de las personas; añade un correo de trabajo a alguien y su empresa aparecerá aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritykset muodostuvat henkilöiden sähköpostiosoitteista; lisää jollekulle työsähköposti, niin hänen yrityksensä näkyy täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entreprises proviennent des adresses e-mail des personnes ; ajoute un e-mail professionnel à quelqu’un et son entreprise apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le aziende derivano dagli indirizzi email delle persone; aggiungi un’email di lavoro a qualcuno e la sua azienda comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社は人物のメールアドレスから作られます。人物に仕事用のメールを追加すると、その会社がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사는 사람의 이메일 주소에서 만들어집니다. 사람에게 업무용 이메일을 추가하면 그 회사가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrijven komen uit de e-mailadressen van personen; geef iemand een zakelijk e-mailadres en het bedrijf verschijnt hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As empresas vêm dos endereços de e-mail das pessoas; adicione um e-mail de trabalho a alguém e a empresa dessa pessoa aparece aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公司来自人员的电子邮件地址；为某人添加工作邮箱后，其公司就会显示在这里。"
          }
        }
      }
    },
