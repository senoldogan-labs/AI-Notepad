          "stringUnit": {
            "state": "translated",
            "value": "Only the note is sent; audio, transcripts and screenshots never are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía la nota; nunca el audio, las transcripciones ni las capturas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain muistiinpano lähetetään; ääntä, litterointeja tai kuvakaappauksia ei koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la note est envoyée ; jamais l’audio, les transcriptions ou les captures d’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene inviata solo la nota; mai audio, trascrizioni o screenshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送られるのはメモだけです。音声、文字起こし、スクリーンショットは送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트만 전송되며 오디오, 녹취록, 스크린샷은 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de notitie wordt verstuurd; nooit audio, transcripten of schermafbeeldingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a nota é enviada; nunca áudio, transcrições ou capturas de tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发送笔记；绝不发送音频、文字稿或截图。"
          }
        }
      }
    },
    "İzni servisin kendi giriş sayfasında verirsin; şifren bize gelmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erteilst den Zugriff auf der Anmeldeseite des Dienstes; dein Passwort erreicht uns nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You grant access on the service's own sign-in page; your password never reaches us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Das el permiso en la página de inicio de sesión del servicio; tu contraseña nunca nos llega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annat luvan palvelun omalla kirjautumissivulla; salasanasi ei koskaan tule meille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous donnez l’accès sur la page de connexion du service ; votre mot de passe ne nous parvient jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l’accesso nella pagina di accesso del servizio; la tua password non arriva mai a noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスはサービス自身のサインインページで許可します。パスワードが私たちに届くことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 자체 로그인 페이지에서 권한을 부여하며, 비밀번호는 저희에게 전달되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geeft toegang op de inlogpagina van de dienst zelf; je wachtwoord komt nooit bij ons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você dá a permissão na página de login do próprio serviço; sua senha nunca chega até nós."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在服务自己的登录页面上授权；你的密码绝不会传给我们。"
          }
        }
      }
    },
    "Yapıştırdığın adres yalnızca not göndermek için kullanılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eingefügte Adresse wird nur zum Senden von Notizen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address you paste is used only to send notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección que pegas solo se usa para enviar notas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittämääsi osoitetta käytetään vain muistiinpanojen lähettämiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse collée sert uniquement à envoyer les notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo incollato serve solo per inviare le note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたアドレスはメモの送信にのみ使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣은 주소는 노트를 보내는 데만 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres dat je plakt, wordt alleen gebruikt om notities te versturen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço que você cola é usado só para enviar notas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你粘贴的地址仅用于发送笔记。"
          }
        }
      }
    },
    "Otomatik gönderim kapalıyken yalnızca senin gönderdiğin notlar gider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist automatisches Senden aus, gehen nur die Notizen raus, die du sendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With automatic sending off, only the notes you send go out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el envío automático desactivado, solo salen las notas que envías tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun automaattinen lähetys on pois, lähtevät vain itse lähettämäsi muistiinpanot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi automatique désactivé, seules les notes que vous envoyez partent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’invio automatico disattivato, partono solo le note che invii tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動送信がオフのときは、あなたが送ったメモだけが送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 보내기가 꺼져 있으면 직접 보낸 노트만 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met automatisch versturen uit gaan alleen de notities die jij verstuurt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o envio automático desligado, só vão as notas que você enviar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭自动发送时，只会发送你手动发送的笔记。"
          }
        }
      }
    },
    "İstediğin an kaldırabilirsin; bağlantı uygulamadan silinir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit entfernbar; die Verbindung wird aus der App gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove it any time; the connection is deleted from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quítala cuando quieras; la conexión se borra de la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit poistaa sen milloin tahansa; yhteys poistetaan sovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez-la quand vous voulez ; la connexion est effacée de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi rimuoverla quando vuoi; la connessione viene eliminata dall’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも削除できます。接続はアプリから消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 제거할 수 있으며 연결은 앱에서 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het altijd verwijderen; de koppeling wordt uit de app gewist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova quando quiser; a conexão é apagada do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时移除；连接会从应用中删除。"
          }
        }
      }
    },
    "Notlar uygulamasına bu Mac'te yazılır; hesap gerekmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf diesem Mac in die Notizen-App geschrieben; kein Account nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written to the Notes app on this Mac; no account needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escriben en la app Notas de este Mac; no hace falta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitetaan tämän Macin Muistiinpanot-appiin; tiliä ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrites dans l’app Notes sur ce Mac ; aucun compte nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritte nell’app Note su questo Mac; non serve un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのメモアプリに書き込まれます。アカウントは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 메모 앱에 기록되며 계정이 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt op deze Mac naar de Notities-app geschreven; geen account nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravadas no app Notas deste Mac; não precisa de conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入这台 Mac 上的备忘录应用；无需账户。"
          }
        }
      }
    },
    "Yalnızca seçtiğin klasöre yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur in den gewählten Ordner geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written only to the folder you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escriben solo en la carpeta que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitetaan vain valitsemaasi kansioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrites uniquement dans le dossier choisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritte solo nella cartella che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだフォルダにのみ書き込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에만 기록됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt alleen naar de gekozen map geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravadas só na pasta que você escolher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只写入你选择的文件夹。"
          }
        }
      }
    },
    "Kapatınca yeni notlar yazılmaz; yazılanlar yerinde kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet werden keine neuen Notizen geschrieben; vorhandene bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off and new notes stop; existing ones stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo no se escriben notas nuevas; las existentes se quedan donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun se on pois, uusia muistiinpanoja ei kirjoiteta; vanhat jäävät paikoilleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois désactivé, plus aucune nouvelle note n’est écrite ; les existantes restent en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivandolo non vengono scritte nuove note; quelle esistenti restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると新しいメモは書き込まれません。既存のものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 새 노트는 기록되지 않으며 기존 노트는 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld worden geen nieuwe notities geschreven; bestaande blijven staan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao desligar, novas notas não são gravadas; as existentes ficam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后不再写入新笔记；已写入的保持原样。"
          }
        }
      }
    },
    "Resmi bağlantıyla, tarayıcıda izin vererek kurulur; API anahtarı gerekmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird über die offizielle Verbindung eingerichtet, indem du im Browser zustimmst; kein API-Schlüssel nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up through the official connection by granting access in your browser; no API key needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se configura con la conexión oficial dando permiso en el navegador; no hace falta clave API."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otetaan käyttöön virallisella yhteydellä antamalla lupa selaimessa; API-avainta ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuré via la connexion officielle en autorisant l’accès dans le navigateur ; aucune clé API nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si configura con la connessione ufficiale autorizzando nel browser; non serve una chiave API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式の接続でブラウザから許可して設定します。APIキーは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 연결로 브라우저에서 권한을 부여해 설정하며 API 키가 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingesteld via de officiële koppeling door toegang te geven in je browser; geen API-sleutel nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurado pela conexão oficial, autorizando no navegador; não precisa de chave de API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过官方连接在浏览器中授权完成设置；无需 API 密钥。"
          }
        }
      }
    },
    "İşleri yapay zekâ sağlayıcın açar; görev metinleri ona gider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein KI-Anbieter legt die Issues an; der Aufgabentext geht an ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI provider creates the issues, so task text is sent to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor de IA crea las incidencias; el texto de las tareas se le envía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälypalveluntarjoajasi luo tiketit; tehtävien teksti lähetetään sille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fournisseur d’IA crée les tickets ; le texte des tâches lui est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo fornitore di AI a creare le issue; il testo delle attività gli viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課題はAIプロバイダが作成するため、タスクのテキストはプロバイダに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 제공업체가 이슈를 만들기 때문에 작업 내용이 제공업체로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je AI-aanbieder maakt de issues aan; de taaktekst gaat naar hem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu provedor de IA cria as issues; o texto das tarefas é enviado a ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题由你的 AI 提供商创建，因此任务文本会发送给它。"
          }
        }
      }
    },
    "Yalnızca sen gönderince iş açılır; kendiliğinden bir şey açılmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Issues werden nur angelegt, wenn du sie sendest; nichts passiert automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issues are created only when you send them; nothing is created on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las incidencias solo se crean cuando las envías; nada se crea solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiketit luodaan vain, kun lähetät ne; mitään ei luoda itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tickets ne sont créés que lorsque vous les envoyez ; rien n’est créé tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le issue vengono create solo quando le invii; nulla viene creato da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課題はあなたが送ったときだけ作成され、自動では何も作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이슈는 직접 보낼 때만 만들어지며 자동으로 만들어지는 것은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Issues worden alleen aangemaakt als jij ze verstuurt; er gebeurt niets vanzelf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As issues só são criadas quando você as envia; nada é criado sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你发送时才会创建问题；不会自动创建任何内容。"
          }
        }
      }
    },
    "Yalnızca okur, hiçbir şey değiştirmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur und ändert nie etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only; it never changes anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee; nunca cambia nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain lukee eikä koskaan muuta mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule ; ne modifie jamais rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lettura; non modifica mai nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用で、何も変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기만 하며 아무것도 변경하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest alleen en verandert nooit iets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só lê; nunca altera nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读取，从不更改任何内容。"
          }
        }
      }
    },
    "Okuduğunu kendi yapay zekâ sağlayıcısına gönderir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet, was sie liest, an ihren eigenen KI-Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends what it reads to its own AI provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía lo que lee a su propio proveedor de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää lukemansa omalle tekoälypalveluntarjoajalleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ce qu’elle lit à son propre fournisseur d’IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia ciò che legge al proprio fornitore di AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った内容を自身のAIプロバイダに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽은 내용을 자체 AI 제공업체로 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt wat het leest naar zijn eigen AI-aanbieder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o que lê ao seu próprio provedor de IA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会将读取的内容发送给它自己的 AI 提供商。"
          }
        }
      }
    },
    "Bu Mac'te çalışır; Kaldır ile yapılandırmasından çıkar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf diesem Mac; „Entfernen“ nimmt es aus den Einstellungen dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on this Mac; Remove takes it out of that app's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en este Mac; «Quitar» la saca de los ajustes de esa app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii tällä Macilla; Poista ottaa sen pois sovelluksen asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur ce Mac ; « Supprimer » la retire des réglages de cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona su questo Mac; «Rimuovi» la toglie dalle impostazioni di quell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで動作します。「削除」でそのアプリの設定から外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 실행되며, '제거'를 누르면 해당 앱 설정에서 빠집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait op deze Mac; ‘Verwijder’ haalt het uit de instellingen van die app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda neste Mac; “Remover” tira das configurações daquele app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上运行；“移除”会将其从该应用的设置中删除。"
          }
        }
      }
    },
