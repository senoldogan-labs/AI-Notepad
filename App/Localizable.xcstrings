    "Takvim izni istenemedi: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff konnte nicht angefordert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't request calendar access: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido solicitar acceso al calendario: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterin käyttöoikeutta ei voitu pyytää: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l’accès au calendrier : %@"
          }
        },
        "it": {
