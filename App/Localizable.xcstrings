          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Hesap değiştirilirken yüklü hesap değişti. Yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geladene Account hat sich beim Wechseln geändert. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The loaded account changed while switching accounts. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta cargada cambió al cambiar de cuenta. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladattu tili muuttui tilinvaihdon aikana. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte chargé a changé pendant le changement de compte. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account caricato è cambiato durante il cambio di account. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの切り替え中に読み込まれたアカウントが変わりました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 전환하는 동안 로드된 계정이 변경되었습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geladen account is tijdens het wisselen van account veranderd. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta carregada mudou durante a troca de contas. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换账户时已载入的账户发生了变化。请重试。"
          }
        }
      }
    },
    "Hesap durumu şu an okunamıyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Account-Status kann gerade nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account status can't be read right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede leer el estado de la cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin tilaa ei voi lukea juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état du compte ne peut pas être lu pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato dell’account non può essere letto al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在アカウントの状況を読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 계정 상태를 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De accountstatus kan nu niet worden gelezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado da conta não pode ser lido agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法读取账户状态。"
          }
        }
      }
    },
    "Hesap durumu şu an okunamıyor; bağlantı gelince kendiliğinden yenilenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Account-Status kann gerade nicht gelesen werden; er wird automatisch aktualisiert, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account status can't be read right now; it refreshes on its own when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede leer el estado de tu cuenta; se actualizará solo cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi tilaa ei voi lukea juuri nyt; se päivittyy itsestään, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de votre compte ne peut pas être lu pour le moment ; il s’actualisera de lui-même lorsque vous serez de nouveau en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato del tuo account non può essere letto al momento; si aggiorna da solo quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在アカウントの状況を読み込めません。オンラインに戻ると自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 계정 상태를 읽을 수 없습니다. 다시 온라인에 연결되면 자동으로 새로 고쳐집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je accountstatus kan nu niet worden gelezen; hij wordt vanzelf vernieuwd zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado da sua conta não pode ser lido agora; ele se atualiza sozinho quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法读取你的账户状态；恢复联网后会自动刷新。"
          }
        }
      }
    },
    "Hesap durumu, izinler, bağlantı ve son hatalar; ses, metin, not ve anahtar eklenmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account-Status, Berechtigungen, Verbindung und letzte Fehler; kein Audio, keine Transkripte, Notizen oder Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account status, permissions, connection and recent errors; no audio, transcripts, notes or keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de la cuenta, permisos, conexión y errores recientes; sin audio, transcripciones, notas ni claves."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin tila, luvat, yhteys ja viimeaikaiset virheet; ei ääntä, litterointeja, muistiinpanoja tai avaimia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État du compte, autorisations, connexion et erreurs récentes ; aucun audio, aucune transcription, note ni clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato dell’account, autorizzazioni, connessione ed errori recenti; nessun audio, trascrizione, nota o chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの状況、アクセス許可、接続、最近のエラー。音声、文字起こし、ノート、キーは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 상태, 권한, 연결 및 최근 오류. 오디오, 녹취록, 노트, 키는 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountstatus, toestemmingen, verbinding en recente fouten; geen audio, transcripten, notities of sleutels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado da conta, permissões, conexão e erros recentes; sem áudio, transcrições, notas ou chaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户状态、权限、连接和最近的错误；不含音频、文字稿、笔记或密钥。"
          }
        }
      }
    },
    "Hesap klasörü tanınmadı. Uygulamayı yeniden başlat; sürerse geri bildirim gönder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account-Ordner nicht erkannt. Starte die App neu; falls das weiterhin passiert, sende Feedback."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account folder not recognized. Restart the app; if this keeps happening, send feedback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoce la carpeta de la cuenta. Reinicia la app; si sigue ocurriendo, envía comentarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilikansiota ei tunnistettu. Käynnistä sovellus uudelleen; jos tämä toistuu, lähetä palautetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier du compte non reconnu. Redémarrez l’app ; si le problème persiste, envoyez un commentaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella dell’account non riconosciuta. Riavvia l’app; se continua a succedere, invia un feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントフォルダを認識できません。アプリを再起動してください。繰り返し発生する場合は、フィードバックを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 폴더를 인식할 수 없습니다. 앱을 재시작하세요. 문제가 계속되면 피드백을 보내 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountmap niet herkend. Herstart de app; blijft dit gebeuren, stuur dan feedback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta da conta não reconhecida. Reinicie o app; se continuar acontecendo, envie feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别账户文件夹。请重新启动 App；如果问题持续，请发送反馈。"
          }
        }
      }
    },
