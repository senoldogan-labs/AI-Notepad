    "Ana ekrandaki büyük mikrofon düğmesi, Denetim Merkezi ya da Eylem düğmesi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die große Mikrofontaste auf dem Startbildschirm, das Kontrollzentrum oder die Aktionstaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The big microphone button on the home screen, Control Center or the Action button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón grande del micrófono en la pantalla de inicio, el centro de control o el botón de acción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitusnäkymän iso mikrofonipainike, Ohjauskeskus tai Toimintopainike."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le grand bouton micro de l’écran d’accueil, le centre de contrôle ou le bouton Action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il grande pulsante del microfono nella schermata principale, Centro di Controllo o il tasto Azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の大きなマイクボタン、コントロールセンター、またはアクションボタン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면의 큰 마이크 버튼, 제어 센터 또는 동작 버튼."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grote microfoonknop op het startscherm, het bedieningspaneel of de actieknop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão grande de microfone na tela inicial, a Central de Controle ou o botão de Ação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主屏幕上的大麦克风按钮、控制中心或操作按钮。"
          }
        }
      }
    },
