    "Effort `reasoning_effort` olarak gönderilir; desteklemeyen sunucularda \"Gönderme\"yi seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufwand wird als `reasoning_effort` gesendet; wähle „Nicht senden“ für Server, die das nicht unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effort is sent as `reasoning_effort`; choose \"Don't send\" for servers that don't support it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esfuerzo se envía como `reasoning_effort`; elige “No enviar” para servidores que no lo admitan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työmäärä lähetetään nimellä `reasoning_effort`; valitse ”Älä lähetä” palvelimille, jotka eivät tue sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’effort est envoyé en tant que `reasoning_effort` ; choisissez « Ne pas envoyer » pour les serveurs qui ne le prennent pas en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sforzo viene inviato come `reasoning_effort`; scegli “Non inviare” per i server che non lo supportano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Effortは`reasoning_effort`として送信されます。対応していないサーバでは「送信しない」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추론 강도는 `reasoning_effort`로 전송됩니다. 이를 지원하지 않는 서버에서는 \"보내지 않음\"을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspanning wordt verstuurd als `reasoning_effort`; kies \"Niet versturen\" voor servers die dit niet ondersteunen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O esforço é enviado como `reasoning_effort`; escolha \"Não enviar\" para servidores que não são compatíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推理强度以 `reasoning_effort` 发送；对于不支持它的服务器，请选择“不发送”。"
          }
        }
      }
    },
