    "Kayıttaki ya da işlenen toplantı silinemez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meeting, das gerade aufgenommen oder verarbeitet wird, kann nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting that is recording or being processed can't be deleted."
