            "value": "Esta reunión no tiene nota; crea primero la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kokouksella ei ole muistiinpanoa; luo muistiinpano ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas de note ; créez d’abord la note."
