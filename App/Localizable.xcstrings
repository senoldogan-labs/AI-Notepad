    "Toplantı (metin, not ve ses) Çöp Sepeti'ne taşınsın mı?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting (Text, Notiz und Audio) in den Papierkorb legen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the meeting (text, note and audio) to the Trash?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover la reunión (texto, nota y audio) a la Papelera?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirretäänkö kokous (teksti, muistiinpano ja ääni) roskakoriin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer la réunion (texte, note et audio) dans la Corbeille ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare la riunione (testo, nota e audio) nel Cestino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議（テキスト、ノート、音声）をゴミ箱に移動しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의(텍스트, 노트 및 오디오)를 휴지통으로 이동하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergadering (tekst, notitie en audio) naar de prullenmand verplaatsen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a reunião (texto, nota e áudio) para a Lixeira?"
          }
