    },
    "%@ ses akışı beklenmedik şekilde durdu. Cihazı kontrol edip kaydı yeniden başlat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Audiostream von %@ wurde unerwartet beendet. Prüfe das Gerät und starte die Aufnahme neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio stream stopped unexpectedly. Check the device and restart the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión de audio de %@ se ha detenido inesperadamente. Revisa el dispositivo y reinicia la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-äänivirta pysähtyi odottamatta. Tarkista laite ja aloita nauhoitus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux audio %@ s’est arrêté de manière inattendue. Vérifiez l’appareil et relancez l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso audio di %@ si è interrotto inaspettatamente. Controlla il dispositivo e riavvia la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の音声ストリームが予期せず停止しました。デバイスを確認して、録音をやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 오디오 스트림이 예기치 않게 중지되었습니다. 기기를 확인하고 녹음을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audiostream van %@ is onverwacht gestopt. Controleer het apparaat en start de opname opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transmissão de áudio de %@ parou inesperadamente. Verifique o dispositivo e reinicie a gravação."
