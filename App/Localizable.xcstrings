          }
        }
      }
    },
    "Eşitleme alanı doldu; yeni değişiklikler yüklenemiyor. Eski toplantıları silerek yer açabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsspeicher ist voll; neue Änderungen können nicht hochgeladen werden. Lösche alte Meetings, um Platz zu schaffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync storage is full; new changes can't be uploaded. Delete old meetings to make room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de sincronización está lleno; no se pueden subir los cambios nuevos. Elimina reuniones antiguas para liberar espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointitila on täynnä; uusia muutoksia ei voi lähettää. Poista vanhoja kokouksia tehdäksesi tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de synchronisation est plein ; les nouvelles modifications ne peuvent pas être envoyées. Supprimez d’anciennes réunions pour libérer de la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di sincronizzazione è pieno; le nuove modifiche non possono essere caricate. Elimina vecchie riunioni per fare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の保存容量がいっぱいです。新しい変更をアップロードできません。古い会議を削除して空きを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 저장 공간이 가득 찼습니다. 새 변경 사항을 업로드할 수 없습니다. 오래된 회의를 삭제해 공간을 확보하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatieruimte is vol; nieuwe wijzigingen kunnen niet worden geüpload. Verwijder oude vergaderingen om ruimte te maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de sincronização está cheio; as novas alterações não podem ser enviadas. Apague reuniões antigas para liberar espaço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步空间已满；无法上传新的更改。删除旧会议以腾出空间。"
          }
        }
      }
    },
    "Eşitleme başka bir cihazda kapatıldı. Bu cihazdaki toplantılar yerinde kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung wurde auf einem anderen Gerät ausgeschaltet. Die Meetings auf diesem Gerät bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync was turned off on another device. The meetings on this device stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización se desactivó en otro dispositivo. Las reuniones de este dispositivo se quedan donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi poistettiin käytöstä toisella laitteella. Tämän laitteen kokoukset pysyvät paikallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation a été désactivée sur un autre appareil. Les réunions de cet appareil restent en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è stata disattivata su un altro dispositivo. Le riunioni su questo dispositivo restano al loro posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで同期がオフにされました。このデバイスの会議はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 동기화가 꺼졌습니다. 이 기기의 회의는 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is op een ander apparaat uitgezet. De vergaderingen op dit apparaat blijven staan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização foi desativada em outro dispositivo. As reuniões deste dispositivo continuam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已在另一台设备上关闭。此设备上的会议保持不变。"
          }
        }
      }
    },
    "Eşitleme bu hesapta kapalı. Bu cihazda açarak başlatabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist für diesen Account aus. Schalte sie hier ein, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off for this account. Turn it on here to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada para esta cuenta. Actívala aquí para empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi on pois päältä tällä tilillä. Ota se käyttöön täällä aloittaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est désactivée pour ce compte. Activez-la ici pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è disattivata per questo account. Attivala qui per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの同期はオフです。ここでオンにすると始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 동기화가 꺼져 있습니다. 여기서 켜면 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie staat uit voor dit account. Zet het hier aan om te beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está desativada nesta conta. Ative-a aqui para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的同步已关闭。在这里打开即可开始。"
          }
        }
      }
    },
    "Eşitleme şu an kullanılamıyor; yeniden açılınca kaldığı yerden sürer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist gerade nicht verfügbar; sie macht weiter, sobald sie wieder da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync isn't available right now; it picks up where it left off when it's back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización no está disponible ahora; continuará donde se quedó cuando vuelva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi ei ole juuri nyt käytettävissä; se jatkaa siitä, mihin jäi, kun se palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n’est pas disponible pour le moment ; elle reprendra là où elle s’était arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione non è disponibile al momento; riprenderà da dove si era fermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、同期を利用できません。再開すると中断したところから続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 동기화를 사용할 수 없습니다. 다시 사용할 수 있게 되면 멈춘 곳부터 이어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is nu niet beschikbaar; ze gaat verder waar ze was zodra ze terug is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização não está disponível agora; ela continua de onde parou quando voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步暂时不可用；恢复后会从中断处继续。"
          }
        }
      }
    },
    "Eşitlemeyi başka bir cihaz açtı. O cihazın Ayarlar'ındaki bağlantı kodunu yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät hat die Synchronisierung eingeschaltet. Gib den Verbindungscode aus dessen Einstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device turned on sync. Type the link code from its Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo activó la sincronización. Escribe el código de vinculación de sus Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen laite otti synkronoinnin käyttöön. Kirjoita sen asetuksissa näkyvä linkityskoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil a activé la synchronisation. Saisissez le code de liaison affiché dans ses Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo ha attivato la sincronizzazione. Scrivi il codice di collegamento delle sue Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで同期がオンにされました。そのデバイスの設定にあるリンクコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 동기화를 켰습니다. 그 기기의 설정에 있는 연결 코드를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander apparaat heeft synchronisatie aangezet. Typ de koppelcode uit de Instellingen van dat apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo ativou a sincronização. Digite o código de vínculo dos Ajustes dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备已打开同步。请输入那台设备“设置”中的关联码。"
          }
        }
      }
    },
    "Eşitlemeyi kapat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off sync"
          }
        },
        "es": {
