    "Uygulama geçici bir konumdan çalışıyor. Uygulamalar klasörüne taşıyıp yeniden aç, sonra yeniden bağla.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App läuft von einem temporären Ort. Bewege sie in den Ordner „Programme“, öffne sie erneut und verbinde dich dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is running from a temporary location. Move it to the Applications folder, reopen it, then connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se está ejecutando desde una ubicación temporal. Muévela a la carpeta Aplicaciones, vuelve a abrirla y vuelve a conectarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus toimii väliaikaisesta sijainnista. Siirrä se Ohjelmat-kansioon, avaa se uudelleen ja yhdistä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app s’exécute depuis un emplacement temporaire. Déplacez-la dans le dossier Applications, rouvrez-la, puis reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è in esecuzione da una posizione temporanea. Spostala nella cartella Applicazioni, riaprila, poi connettiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが一時的な場所から実行されています。「アプリケーション」フォルダに移動し、開き直してから、もう一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 임시 위치에서 실행되고 있습니다. 응용 프로그램 폴더로 옮긴 다음 다시 열고 다시 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app draait vanaf een tijdelijke locatie. Verplaats hem naar de map Apps, open hem opnieuw en koppel dan opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app está sendo executado de um local temporário. Mova-o para a pasta Aplicativos, reabra-o e conecte de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 正从临时位置运行。请将其移到“应用程序”文件夹，重新打开，然后再次连接。"
          }
        }
      }
    },
    "Uygulama kayıt ya da işleme sırasında kapandı.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde während einer Aufnahme oder Verarbeitung geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app closed during recording or processing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cerró durante la grabación o el procesamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus sulkeutui nauhoituksen tai käsittelyn aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app s’est fermée pendant un enregistrement ou un traitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app si è chiusa durante la registrazione o l’elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中または処理中にアプリが終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 처리 중에 앱이 종료되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app is gesloten tijdens het opnemen of verwerken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app foi fechado durante a gravação ou o processamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 在录制或处理期间关闭了。"
          }
        }
      }
    },
    "Uygulamada başka bir hesapla giriş yapıldı. O hesabın toplantıları için MCP istemcisini yeniden başlat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App ist jetzt ein anderer Account angemeldet. Starte deinen MCP-Client neu, um die Meetings dieses Accounts zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account is now signed in to the app. Restart your MCP client to use that account's meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora hay otra cuenta con la sesión iniciada en la app. Reinicia tu cliente MCP para usar las reuniones de esa cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellukseen on nyt kirjautunut toinen tili. Käynnistä MCP-asiakasohjelmasi uudelleen käyttääksesi tämän tilin kokouksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte est maintenant connecté à l’app. Redémarrez votre client MCP pour utiliser les réunions de ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell’app ha ora eseguito l’accesso un altro account. Riavvia il client MCP per usare le riunioni di quell’account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、別のアカウントでアプリにサインインしています。そのアカウントの会議を使うには、MCPクライアントを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 다른 계정이 앱에 로그인되어 있습니다. 해당 계정의 회의를 사용하려면 MCP 클라이언트를 재시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nu een ander account ingelogd in de app. Herstart je MCP-client om de vergaderingen van dat account te gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta está com a sessão iniciada no app agora. Reinicie seu cliente MCP para usar as reuniões dessa conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 现在登录的是另一个账户。请重新启动你的 MCP 客户端以使用该账户的会议。"
          }
        }
      }
    },
    "Uygulamanın Anahtar Zinciri ayarı eksik; uygulamayı yeniden kur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsselbund-Einstellung der App fehlt; installiere die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's Keychain setting is missing; reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el ajuste del Llavero de la app; vuelve a instalar la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen Avainnippu-asetus puuttuu; asenna sovellus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage du trousseau de l’app est manquant ; réinstallez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca l’impostazione Portachiavi dell’app; reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキーチェーン設定がありません。アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 키체인 설정이 없습니다. 앱을 다시 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutelhangerinstelling van de app ontbreekt; installeer de app opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta o ajuste de Chaves do app; reinstale o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 App 的钥匙串设置；请重新安装 App。"
          }
        }
      }
    },
    "Uygulamanın sunucu ayarı eksik ya da bozuk; uygulamayı yeniden kur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Einstellung der App fehlt oder ist beschädigt; installiere die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's server setting is missing or broken; reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste del servidor de la app falta o está dañado; vuelve a instalar la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen palvelinasetus puuttuu tai on rikki; asenna sovellus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage du serveur de l’app est manquant ou endommagé ; réinstallez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impostazione del server dell’app manca o è danneggiata; reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのサーバ設定がないか、壊れています。アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 서버 설정이 없거나 손상되었습니다. 앱을 다시 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serverinstelling van de app ontbreekt of is beschadigd; installeer de app opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ajuste de servidor do app está faltando ou corrompido; reinstale o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 的服务器设置缺失或已损坏；请重新安装 App。"
          }
        }
      }
    },
    "Uygulamanın sunucu ayarı güvenli değil; uygulamayı güncelle ya da yeniden kur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Einstellung der App ist nicht sicher; aktualisiere die App oder installiere sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's server setting isn't secure; update or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste del servidor de la app no es seguro; actualiza o vuelve a instalar la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen palvelinasetus ei ole suojattu; päivitä tai asenna sovellus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage du serveur de l’app n’est pas sécurisé ; mettez à jour ou réinstallez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impostazione del server dell’app non è sicura; aggiorna o reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのサーバ設定が安全ではありません。アプリをアップデートするか、再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 서버 설정이 안전하지 않습니다. 앱을 업데이트하거나 다시 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serverinstelling van de app is niet veilig; werk de app bij of installeer hem opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ajuste de servidor do app não é seguro; atualize ou reinstale o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 的服务器设置不安全；请更新或重新安装 App。"
          }
        }
      }
    },
    "Uygulamanın tamamında; Mac'te yüklü her yazı tipi seçilebilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die gesamte App; jede auf deinem Mac installierte Schrift kann gewählt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the whole app; any font installed on your Mac can be chosen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a toda la app; puedes elegir cualquier fuente instalada en tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee koko sovellusta; voit valita minkä tahansa Maciisi asennetun fontin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à toute l’app ; vous pouvez choisir n’importe quelle police installée sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per tutta l’app; puoi scegliere qualsiasi font installato sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ全体に適用されます。Macにインストールされている任意のフォントを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체에 적용되며, Mac에 설치된 모든 서체를 선택할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor de hele app; je kunt elk lettertype kiezen dat op je Mac is geïnstalleerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para o app inteiro; qualquer fonte instalada no seu Mac pode ser escolhida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于整个 App；可以选择你 Mac 上安装的任何字体。"
          }
        }
      }
    },
    "Uygulamanın veri klasörü tanımlı değil (%@ Info.plist'inde %@ yok). Uygulamayı yeniden kur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenordner der App ist nicht definiert (%@ Info.plist enthält kein %@). Installiere die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's data folder isn't defined (%@ Info.plist has no %@). Reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de datos de la app no está definida (el Info.plist de %@ no tiene %@). Vuelve a instalar la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen datakansiota ei ole määritetty (%@ Info.plist ei sisällä avainta %@). Asenna sovellus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de données de l’app n’est pas défini (le Info.plist de %@ n’a pas de %@). Réinstallez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella dei dati dell’app non è definita (%@ Info.plist non ha %@). Reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータフォルダが定義されていません（%@のInfo.plistに%@がありません）。アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 데이터 폴더가 정의되지 않았습니다(%1$@ Info.plist에 %2$@ 항목 없음). 앱을 다시 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevensmap van de app is niet gedefinieerd (%@ Info.plist heeft geen %@). Installeer de app opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de dados do app não está definida (o Info.plist de %@ não tem %@). Reinstale o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未定义 App 的数据文件夹（%1$@ Info.plist 中没有 %2$@）。请重新安装 App。"
          }
        }
      }
    },
    "Uygulamanın yapabildikleri": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die App kann"
          }
