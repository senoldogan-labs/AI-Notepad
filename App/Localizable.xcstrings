        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「聞き逃したことは？」は直近%lld分間を要約します"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"무엇을 놓쳤나요?\"는 최근 %lld분을 요약합니다"
                }
              }
            }
          }
        },
