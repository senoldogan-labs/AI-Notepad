    "%@ (toplantı adından)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aus dem Meeting-Titel)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (from the meeting title)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (según el título de la reunión)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (kokouksen otsikosta)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (d’après le titre de la réunion)"
          }
        },
        "it": {
