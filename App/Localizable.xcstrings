    "Alınan kararları gerekçeleri ve kimin önerdiğiyle listele; ertelenen ya da tartışmalı kalan konuları ayrıca yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste die Entscheidungen mit Begründung und Urheber auf; notiere vertagte oder umstrittene Themen separat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List the decisions with their rationale and who proposed them; note postponed or disputed topics separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera las decisiones con su justificación y quién las propuso; anota aparte los temas aplazados o en disputa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listaa päätökset perusteluineen ja niiden ehdottajat; merkitse lykätyt tai kiistanalaiset aiheet erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les décisions avec leur justification et qui les a proposées ; indique séparément les sujets reportés ou contestés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le decisioni con la loro motivazione e chi le ha proposte; annota a parte gli argomenti rimandati o controversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決定事項を、その理由と提案者とともに一覧にしてください。延期された話題や意見が分かれた話題は別に記載してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정 사항을 근거 및 제안자와 함께 나열하고, 연기되었거나 논쟁 중인 주제는 따로 정리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem de besluiten met hun onderbouwing en wie ze voorstelde; vermeld uitgestelde of betwiste onderwerpen apart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste as decisões com a justificativa e quem as propôs; anote separadamente os temas adiados ou em disputa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出各项决策及其理由和提出人；将推迟或有争议的话题单独列出。"
          }
        }
      }
    },
