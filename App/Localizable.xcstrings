    "İndirilenler'de bu adla 999 dosya var; eskilerini silip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Downloads“ enthält bereits 999 Dateien mit diesem Namen; lösche einige davon und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads already has 999 files with this name; delete some of them and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargas ya tiene 999 archivos con este nombre; elimina algunos e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataukset-kansiossa on jo 999 tämännimistä tiedostoa; poista osa niistä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements contient déjà 999 fichiers portant ce nom ; supprimez-en quelques-uns et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Download ci sono già 999 file con questo nome; eliminane alcuni e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」にはこの名前のファイルがすでに999個あります。いくつか削除してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더에 이 이름의 파일이 이미 999개 있습니다. 일부를 삭제하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads bevat al 999 bestanden met deze naam; verwijder er een paar en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads já tem 999 arquivos com este nome; apague alguns e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下载”中已有 999 个同名文件；请删除其中一些后重试。"
          }
        }
      }
    },
