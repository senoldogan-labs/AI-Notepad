    "Konuşma başlayınca metin burada akar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text erscheint hier, sobald jemand spricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text appears here as soon as someone speaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto aparecerá aquí en cuanto alguien hable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti näkyy tässä heti, kun joku puhuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte apparaît ici dès que quelqu’un parle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo appare qui appena qualcuno parla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが話し始めると、すぐにここにテキストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 말하는 즉시 텍스트가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst verschijnt hier zodra iemand spreekt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto aparece aqui assim que alguém falar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人说话时，文字会立即显示在这里。"
          }
        }
      }
    },
