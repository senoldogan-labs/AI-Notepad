    "Hata, öneri ya da soru: doğrudan Gistsmith'in geliştiricisine yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler, eine Idee oder eine Frage: Schreib direkt an den Entwickler von Gistsmith."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bug, an idea or a question: write directly to Gistsmith's developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fallo, una idea o una pregunta: escribe directamente al desarrollador de Gistsmith."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virhe, idea tai kysymys: kirjoita suoraan Gistsmithin kehittäjälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug, une idée ou une question : écrivez directement au développeur de Gistsmith."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug, un’idea o una domanda: scrivi direttamente allo sviluppatore di Gistsmith."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグ、アイデア、質問など：Gistsmithの開発者に直接お送りください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그, 아이디어 또는 질문이 있다면 Gistsmith 개발자에게 직접 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bug, een idee of een vraag: schrijf rechtstreeks naar de ontwikkelaar van Gistsmith."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bug, uma ideia ou uma pergunta: escreva diretamente ao desenvolvedor do Gistsmith."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误、想法或问题：直接写信给 Gistsmith 的开发者。"
          }
        }
      }
    },
