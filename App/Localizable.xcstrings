        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일이 삭제되었습니다. 녹취록과 노트는 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
