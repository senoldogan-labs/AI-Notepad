        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram ed ElevenLabs; interlocutori separati dal vivo. Servono due chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepgramとElevenLabs。話者をリアルタイムで分離します。キーが2つ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram 및 ElevenLabs. 화자가 실시간으로 구분됩니다. 키 두 개가 필요합니다."
          }
        },
        "nl": {
