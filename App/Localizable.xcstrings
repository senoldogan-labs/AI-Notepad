    "Toplantılarda dile getirilen riskleri, kaygıları ve yanıtsız kalan soruları listele; her biri için kimin gündeme getirdiğini yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste die in den Meetings angesprochenen Risiken, Bedenken und offenen Fragen auf, jeweils mit der Person, die sie angesprochen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List the risks, concerns and unanswered questions raised in the meetings, with who raised each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera los riesgos, las preocupaciones y las preguntas sin responder que surgieron en las reuniones, con quién planteó cada uno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listaa kokouksissa esiin tulleet riskit, huolet ja vastaamattomat kysymykset sekä kunkin esittäjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les risques, préoccupations et questions sans réponse soulevés lors des réunions, avec qui a soulevé chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca i rischi, le preoccupazioni e le domande senza risposta emersi nelle riunioni, con chi li ha sollevati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議で挙がったリスク、懸念事項、未解決の質問を、それぞれ誰が挙げたかとともに一覧にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의에서 제기된 위험, 우려 사항 및 답변되지 않은 질문을 각각 누가 제기했는지와 함께 나열하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem de risico's, zorgen en onbeantwoorde vragen die in de vergaderingen naar voren kwamen, met wie ze telkens aankaartte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste os riscos, as preocupações e as perguntas sem resposta levantadas nas reuniões, com quem levantou cada uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出会议中提出的风险、顾虑和未解答的问题，并注明各由谁提出。"
          }
        }
      }
    },
    "Toplantılarıma sor": {
