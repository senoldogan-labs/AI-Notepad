    "Mikrofon yeniden bağlandı; kayıt sürüyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon wieder verbunden; die Aufnahme läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone reconnected; recording continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrófono reconectado; la grabación continúa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni yhdistetty uudelleen; nauhoitus jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro reconnecté ; l’enregistrement continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono riconnesso; la registrazione continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが再接続されました。録音を続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 다시 연결되었습니다. 녹음이 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon opnieuw verbonden; de opname gaat door."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfone reconectado; a gravação continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已重新连接；录制继续。"
          }
        }
      }
    },
    "Mikrofon yeniden bağlanıyor… Kayıt açık; ses gelince kendiliğinden sürer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon wird neu verbunden … Die Aufnahme bleibt aktiv und läuft weiter, sobald wieder Audio ankommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting the microphone… The recording stays on and continues as soon as audio returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectando el micrófono… La grabación sigue activa y continuará en cuanto vuelva el audio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään mikrofonia uudelleen… Nauhoitus pysyy päällä ja jatkuu heti, kun ääni palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnexion du micro… L’enregistrement reste actif et reprend dès que l’audio revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnessione del microfono… La registrazione resta attiva e continua appena l’audio ritorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを再接続中… 録音はオンのままで、音声が戻るとすぐに続行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 다시 연결 중… 녹음은 계속 켜져 있으며 오디오가 돌아오는 즉시 이어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon opnieuw verbinden… De opname blijft aan en gaat verder zodra er weer audio is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectando o microfone… A gravação continua ativa e prossegue assim que o áudio voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新连接麦克风… 录制保持开启，音频恢复后立即继续。"
          }
        }
      }
    },
