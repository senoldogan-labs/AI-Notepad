        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다. 잠시 기다린 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken; wacht even en probeer het opnieuw."
          }
        },
        "pt-BR": {
