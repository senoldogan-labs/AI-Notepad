          }
        }
      }
    },
    "Not kayıt bitince hazırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz wird geschrieben, wenn die Aufnahme endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note is written when the recording ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota se escribe cuando termina la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpano kirjoitetaan, kun nauhoitus päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note est rédigée à la fin de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota viene scritta al termine della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートは録音の終了後に作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 녹음이 끝나면 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie wordt geschreven als de opname klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota é escrita quando a gravação termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制结束后会写好笔记。"
          }
        }
      }
    },
    "Bağlantı gelince hazırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vorbereitet, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's prepared when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prepara cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistellaan, kun yhteys palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sera préparée dès que vous serez en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene preparata quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインに戻ると準備されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 온라인이 되면 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt voorbereid zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preparada quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复联网后会准备好。"
          }
        }
      }
    },
    "Kayıt silinsin mi?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this recording?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta grabación?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko tämä nauhoitus?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet enregistrement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questa registrazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음을 삭제할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opname verwijderen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta gravação?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此录制？"
          }
        }
      }
    },
    "Kaydı sil": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar grabación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista nauhoitus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l’enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina registrazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 삭제"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname verwijderen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar gravação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除录制"
          }
        }
      }
    },
    "Kaydedilen ses ve metin silinir, not yazılmaz. Geçen süre aylık kullanımına sayılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgenommener Ton und Transkript werden gelöscht, es wird keine Notiz geschrieben. Die bisherige Zeit zählt trotzdem zu deiner monatlichen Nutzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded audio and transcript are deleted and no note is written. The time so far still counts toward your monthly usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan el audio y la transcripción, y no se escribe ninguna nota. El tiempo transcurrido cuenta igualmente para tu uso mensual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitettu ääni ja litterointi poistetaan, eikä muistiinpanoa kirjoiteta. Tähänastinen aika lasketaan silti kuukausikäyttöösi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et la transcription sont supprimés et aucune note n’est rédigée. Le temps écoulé compte quand même dans votre utilisation mensuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio e trascrizione vengono eliminati e non viene scritta alcuna nota. Il tempo trascorso conta comunque nel tuo utilizzo mensile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音した音声と文字起こしは削除され、ノートは作成されません。ここまでの時間は月間の利用時間に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음된 오디오와 녹취록이 삭제되고 노트는 작성되지 않습니다. 지금까지의 시간은 월간 사용량에 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgenomen audio en het transcript worden verwijderd en er wordt geen notitie geschreven. De tijd tot nu telt wel mee voor je maandelijkse gebruik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e a transcrição são apagados e nenhuma nota é escrita. O tempo até agora conta no seu uso mensal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制的音频和文字记录将被删除，不会写笔记。已录制的时间仍计入你的每月用量。"
          }
        }
      }
    },
