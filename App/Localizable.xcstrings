    "Panoya kopyalandı; ⌘V ile yapıştır. Doğrudan yazması için Erişilebilirlik izni ver (tıkla).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert; setze es mit ⌘V ein. Um direkt zu schreiben, erlaube „Bedienungshilfen“ (hier klicken)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied to the clipboard; paste with ⌘V. To type it in directly, allow Accessibility (click here)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado al portapapeles; pega con ⌘V. Para escribirlo directamente, permite Accesibilidad (haz clic aquí)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioitu leikepöydälle; liitä näppäinyhdistelmällä ⌘V. Jos haluat tekstin kirjoitettavan suoraan, salli Käyttöapu (klikkaa tästä)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié dans le presse-papiers ; collez avec ⌘V. Pour le saisir directement, autorisez l’accessibilité (cliquez ici)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiato negli appunti; incolla con ⌘V. Per scriverlo direttamente, consenti Accessibilità (fai clic qui)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにコピーしました。⌘Vでペーストしてください。直接入力するには、アクセシビリティを許可してください（ここをクリック）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 복사되었습니다. ⌘V로 붙여넣으세요. 직접 입력되게 하려면 손쉬운 사용을 허용하세요(여기를 클릭)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar het klembord gekopieerd; plak met ⌘V. Sta Toegankelijkheid toe om direct te typen (klik hier)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado para a área de transferência; cole com ⌘V. Para digitar diretamente, permita a Acessibilidade (clique aqui)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拷贝到剪贴板；用 ⌘V 粘贴。要直接输入，请允许辅助功能（点按此处）。"
          }
        }
      }
    },
    "Parola alanına sesle yazılmaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe schreibt nicht in Passwortfelder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice typing doesn't type into password fields."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura por voz no escribe en campos de contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhekirjoitus ei kirjoita salasanakenttiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie vocale n’écrit pas dans les champs de mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura vocale non scrive nei campi password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力はパスワードフィールドには入力しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력은 암호 필드에 입력하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraaktypen typt niet in wachtwoordvelden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação por voz não digita em campos de senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入不会在密码栏中输入。"
          }
        }
      }
    },
