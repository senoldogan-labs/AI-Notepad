            "value": "Teste grátis: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用：%@。"
          }
        }
      }
    },
    "Ücretsiz denemeler bugün kapasitede. Yarın yeniden dene ya da Ayarlar › Hesap'tan abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlosen Tests sind heute ausgelastet. Versuche es morgen erneut oder schließe unter „Einstellungen“ › „Account“ ein Abo ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trials are at capacity today. Try again tomorrow or subscribe in Settings › Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pruebas gratuitas están completas por hoy. Inténtalo de nuevo mañana o suscríbete en Ajustes › Cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisia kokeilujaksoja ei tänään ole enää saatavilla. Yritä huomenna uudelleen tai tilaa kohdassa Asetukset › Tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les essais gratuits sont complets aujourd’hui. Réessayez demain ou abonnez-vous dans Réglages › Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prove gratuite di oggi sono esaurite. Riprova domani o abbonati in Impostazioni › Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の無料トライアルは定員に達しました。明日もう一度お試しいただくか、「設定」›「アカウント」で登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 무료 체험 인원이 모두 찼습니다. 내일 다시 시도하거나 설정 › 계정에서 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis proefperiodes zitten vandaag vol. Probeer het morgen opnieuw of neem een abonnement in Instellingen › Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os testes grátis atingiram a capacidade hoje. Tente de novo amanhã ou assine em Ajustes › Conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的免费试用名额已满。请明天再试，或在“设置 › 账户”中订阅。"
          }
        }
      }
    },
