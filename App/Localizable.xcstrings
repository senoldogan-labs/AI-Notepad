        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“Cosa mi sono perso?” riassume l’ultimo %lld minuto"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“Cosa mi sono perso?” riassume gli ultimi %lld minuti"
