            "state": "translated",
            "value": "%@ (dal titolo della riunione)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（会議名から）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(회의 제목 기준)"
          }
        },
        "nl": {
          "stringUnit": {
