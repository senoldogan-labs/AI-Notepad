    "İçe aktarıldı; sunucuda işlenmeyi bekliyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert; wartet auf die Verarbeitung auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported; waiting to be processed on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado; esperando a procesarse en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuotu; odottaa käsittelyä palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé ; en attente de traitement sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importata; in attesa di elaborazione sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みました。サーバでの処理を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져왔습니다. 서버에서 처리되기를 기다리는 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïmporteerd; wacht op verwerking op de server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importada; aguardando processamento no servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入；正在等待服务器处理。"
          }
        }
      }
    },
    "İçe aktarılıyor… Bitince sunucuda işlenir; not hazır olunca burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird importiert … Danach wird es auf dem Server verarbeitet; die Notiz erscheint hier, wenn sie fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing… It is then processed on the server; the note appears here when it's ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando… Después se procesa en el servidor; la nota aparecerá aquí cuando esté lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuodaan… Sen jälkeen se käsitellään palvelimella; muistiinpano näkyy tässä, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importation… Le fichier est ensuite traité sur le serveur ; la note apparaît ici lorsqu’elle est prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione… Verrà poi elaborata sul server; la nota appare qui quando è pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中… その後サーバで処理され、準備ができるとノートがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오는 중… 이후 서버에서 처리되며, 준비되면 노트가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren… Daarna wordt het op de server verwerkt; de notitie verschijnt hier als ze klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando… Depois ela é processada no servidor; a nota aparece aqui quando estiver pronta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入… 随后会在服务器上处理；笔记准备好后会显示在这里。"
          }
        }
      }
    },
