          }
        }
      }
    },
    "Bu toplantının ses işleme hakkı kapandı (gönderilen ses toplantının süresini aştı). Canlı metin kullanılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audioverarbeitung für dieses Meeting ist geschlossen (das gesendete Audio hat die Länge des Meetings überschritten). Der Live-Text wird verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio processing for this meeting is closed (the audio sent exceeded the meeting's length). The live text is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento de audio de esta reunión está cerrado (el audio enviado superó la duración de la reunión). Se usará el texto en directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kokouksen äänen käsittely on suljettu (lähetetty ääni ylitti kokouksen pituuden). Käytetään reaaliaikaista tekstiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement audio de cette réunion est fermé (l’audio envoyé a dépassé la durée de la réunion). Le texte en direct est utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elaborazione audio di questa riunione è chiusa (l’audio inviato ha superato la durata della riunione). Viene usato il testo dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議の音声処理は終了しました（送信された音声が会議の長さを超えました）。ライブ文字起こしが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의의 오디오 처리가 종료되었습니다(전송된 오디오가 회의 길이를 초과함). 실시간 텍스트가 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioverwerking voor deze vergadering is gesloten (de verstuurde audio was langer dan de vergadering). De live tekst wordt gebruikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento de áudio desta reunião foi encerrado (o áudio enviado excedeu a duração da reunião). Será usado o texto ao vivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议的音频处理已关闭（发送的音频超过了会议时长）。将使用实时文字。"
          }
        }
      }
    },
    "Bu toplantının ses kaydı yok.": {
