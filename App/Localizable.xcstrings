            "state": "translated",
            "value": "Haz clic en \"Connect\", inicia sesión con tu cuenta de %@ y permite el acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse \"Connect\", kirjaudu %@-tililläsi ja salli pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
