            "value": "サブスクリプションが終了しました。録音するには再度登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 종료되었습니다. 녹음하려면 다시 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
