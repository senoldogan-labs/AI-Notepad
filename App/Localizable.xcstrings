    "Toplantı işlenirken görev işaretlenemez; işleme bitince yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben können nicht abgehakt werden, während das Meeting verarbeitet wird; versuche es erneut, wenn es fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks can't be checked off while the meeting is being processed; try again when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden marcar tareas mientras se procesa la reunión; inténtalo de nuevo cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtäviä ei voi merkitä tehdyiksi, kun kokousta käsitellään; yritä uudelleen, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches ne peuvent pas être cochées pendant le traitement de la réunion ; réessayez une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività non possono essere spuntate mentre la riunione è in elaborazione; riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の処理中はタスクにチェックを付けられません。完了してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 처리하는 동안에는 할 일을 완료로 표시할 수 없습니다. 처리가 끝나면 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken kunnen niet worden afgevinkt terwijl de vergadering wordt verwerkt; probeer het opnieuw als dat klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível marcar tarefas enquanto a reunião está sendo processada; tente de novo quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理会议期间无法勾选任务；请在处理完成后再试。"
          }
        }
      }
    },
    "Kişi bulunamadı": {
      "localizations": {
