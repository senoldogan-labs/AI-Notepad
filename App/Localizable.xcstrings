    "Arama bağlanamadı. İnternet bağlantını denetleyip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call couldn't connect. Check your internet connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf konnte nicht verbunden werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appel n'a pas pu aboutir. Vérifie ta connexion Internet et réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar la llamada. Comprueba tu conexión a internet y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettere la chiamata. Controlla la connessione a Internet e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar a chamada. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gesprek kon niet worden verbonden. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話をつなげませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화를 연결하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法接通电话。请检查网络连接后重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelua ei voitu yhdistää. Tarkista internetyhteys ja yritä uudelleen."
          }
        }
      }
    },
    "Arama koptu.": {
