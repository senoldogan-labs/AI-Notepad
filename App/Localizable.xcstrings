            "value": "저장된 음성"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde stemmen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozes salvas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的声音"
          }
        }
      }
    },
    "Kayıtlı sesler okunamadığı için değişiklik kaydedilmedi; Tümünü unut ile sıfırlayabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Stimmen konnten nicht gelesen werden, daher wurde die Änderung nicht gesichert; du kannst sie mit „Alle vergessen“ zurücksetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved voices couldn't be read, so the change wasn't saved; you can reset them with Forget all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer las voces guardadas, así que el cambio no se ha guardado; puedes restablecerlas con Olvidar todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettuja ääniä ei voitu lukea, joten muutosta ei tallennettu; voit nollata ne valinnalla Unohda kaikki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix enregistrées n’ont pas pu être lues ; la modification n’a donc pas été enregistrée. Vous pouvez les réinitialiser avec Tout oublier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le voci salvate, quindi la modifica non è stata salvata; puoi reimpostarle con Dimentica tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された声を読み取れなかったため、変更は保存されませんでした。「すべて忘れる」でリセットできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 음성을 읽을 수 없어 변경 사항이 저장되지 않았습니다. 모두 지우기로 초기화할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde stemmen konden niet worden gelezen, dus de wijziging is niet bewaard; je kunt ze resetten met Vergeet alles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as vozes salvas, então a alteração não foi salva; você pode redefini-las com Esquecer todas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已存储的声音，因此更改未存储；你可以用“全部忘记”将其重置。"
          }
        }
      }
    },
    "Kişiler'den kaldırılsın mı? Toplantılardaki adı kalır, sesi unutulur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus „Personen“ entfernen? Der Name bleibt in den Meetings und die Stimme wird vergessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from People? Their name stays in meetings and their voice is forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar de Personas? Su nombre se mantiene en las reuniones y su voz se olvida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko henkilöistä? Nimi säilyy kokouksissa, ja ääni unohdetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer de Personnes ? Son nom reste dans les réunions et sa voix est oubliée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere da Persone? Il suo nome resta nelle riunioni e la sua voce viene dimenticata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」から削除しますか？ 名前は会議に残り、声は忘れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람에서 제거하겠습니까? 회의에는 이름이 그대로 남고 음성은 지워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen uit Personen? De naam blijft in vergaderingen staan en de stem wordt vergeten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover de Pessoas? O nome continua nas reuniões e a voz é esquecida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从“人员”中移除吗？其名字会保留在会议中，其声音会被忘记。"
          }
        }
      }
    },
