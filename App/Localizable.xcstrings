    "Bu Apple Hesabı'nda geri yüklenecek etkin abonelik yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Apple Account gibt es kein aktives Abo zum Wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no active subscription to restore on this Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna suscripción activa que restaurar en esta cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä Apple-tilillä ei ole palautettavaa voimassa olevaa tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement actif à restaurer sur ce compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nessun abbonamento attivo da ripristinare su questo Account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppleアカウントには復元できる有効なサブスクリプションがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에 복원할 활성 구독이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen actief abonnement om te herstellen op dit Apple-account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma assinatura ativa para restaurar nesta Conta Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 账户没有可恢复的有效订阅。"
          }
        }
      }
    },
    "Satın Alımları Geri Yükle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe wiederherstellen"
          }
        },
        "en": {
