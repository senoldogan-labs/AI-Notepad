    "Arkadaşın davet bağlantınla web'den abone olunca aylık planda ilk ayı ücretsiz olur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Freund über deinen Einladungslink im Web ein Abo abschließt, ist sein erster Monat im Monatstarif gratis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a friend subscribes on the web with your invite link, their first month on the monthly plan is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un amigo se suscribe en la web con tu enlace de invitación, su primer mes del plan mensual es gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ystävä tilaa verkossa kutsulinkilläsi, hänen ensimmäinen kuukautensa kuukausitilauksella on ilmainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un ami s’abonne sur le web avec votre lien d’invitation, son premier mois avec le forfait mensuel est gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un amico si abbona sul web con il tuo link di invito, il suo primo mese con il piano mensile è gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちがあなたの招待リンクからWebで登録すると、その友だちは月額プランの最初の1か月が無料になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 내 초대 링크로 웹에서 구독하면 월간 플랜의 첫 달이 무료입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een vriend via het web een abonnement neemt met jouw uitnodigingslink, is diens eerste maand bij het maandabonnement gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um amigo assina pela web com seu link de convite, o primeiro mês dele no plano mensal é grátis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当好友通过你的邀请链接在网页上订阅时，其月度方案的第一个月免费。"
          }
        }
      }
    },
