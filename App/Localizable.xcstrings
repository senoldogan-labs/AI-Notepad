            "state": "translated",
            "value": "Sulje kaikki"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout réduire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimi tutto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 접기"
          }
        },
        "nl": {
