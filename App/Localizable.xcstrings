    "Toplantı kaydedilemedi: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting konnte nicht gesichert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
