    "LLM ayarı eksik: %@. Ayarlar'dan tamamla.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM-Einstellung fehlt: %@. Vervollständige sie in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
