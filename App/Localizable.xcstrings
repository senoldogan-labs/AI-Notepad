    "Basılı tut: konuştuğun sürece dinler, bırakınca yazar. Kısa dokun: eller serbest dinler.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten: hört zu, solange du sprichst, und schreibt beim Loslassen. Tippen: hört freihändig zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold: listens while you speak and types when you let go. Tap: listens hands-free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado: escucha mientras hablas y escribe al soltar. Toca: escucha con manos libres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painettuna: kuuntelee, kun puhut, ja kirjoittaa, kun päästät irti. Napauta: kuuntelee kädet vapaina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens : écoute tant que tu parles et écrit quand tu relâches. Appuie brièvement : écoute mains libres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto: ascolta mentre parli e scrive quando rilasci. Tocca: ascolta a mani libere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押し：話している間聞き取り、離すと入力します。タップ：ハンズフリーで聞き取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르기: 말하는 동안 듣고, 손을 떼면 입력합니다. 탭: 핸즈프리로 듣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingedrukt houden: luistert zolang je praat en typt als je loslaat. Tikken: luistert handsfree."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure: ouve enquanto você fala e digita ao soltar. Toque: ouve com as mãos livres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住：说话时持续聆听，松开后输入。短按：免提聆听。"
          }
        }
      }
    },
    "Sesle yazma kapalı; Sesle yazma sekmesinden açabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracheingabe ist aus; du kannst sie im Tab „Spracheingabe“ einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice typing is off; you can turn it on in the Voice typing tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura por voz está desactivada; puedes activarla en la pestaña Escritura por voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhekirjoitus on pois päältä; voit ottaa sen käyttöön Puhekirjoitus-välilehdellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie vocale est désactivée ; tu peux l’activer dans l’onglet Saisie vocale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura vocale è disattivata; puoi attivarla nella scheda Scrittura vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力はオフです。「音声入力」タブでオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력이 꺼져 있습니다. 음성 입력 탭에서 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraaktypen staat uit; je kunt het aanzetten op het tabblad Spraaktypen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação por voz está desativada; você pode ativá-la na aba Digitação por voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入已关闭；可在“语音输入”标签页中开启。"
          }
        }
      }
    },
