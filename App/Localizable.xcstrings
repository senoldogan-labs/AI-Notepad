    "Bildirimdeki \"Kaydı başlat\" ile kayıt hemen başlar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aufnahme starten“ in der Mitteilung startet die Aufnahme sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Start recording\" in the notification starts recording right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Empezar a grabar\" en la notificación inicia la grabación al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksen ”Aloita tallennus” aloittaa tallennuksen heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Démarrer l’enregistrement » dans la notification lance aussitôt l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Avvia registrazione\" nella notifica avvia subito la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の「録音を開始」ですぐに録音が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림의 '녹음 시작'을 누르면 바로 녹음이 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Opname starten\" in de melding start de opname meteen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Começar a gravar\" na notificação inicia a gravação na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按通知中的“开始录音”即可立即开始录音。"
          }
        }
      }
    },
