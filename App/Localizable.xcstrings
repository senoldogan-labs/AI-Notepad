    "Aramalar kaydedilir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls are recorded"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe werden aufgezeichnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels sont enregistrés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas se graban"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate vengono registrate"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas são gravadas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprekken worden opgenomen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話は録音されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화는 녹음됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话会被录音"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelut tallennetaan"
          }
        }
      }
    },
    "Gistsmith'ten yaptığın aramalar iki taraflı kaydedilir, yazıya dökülür ve not olur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls you make from Gistsmith are recorded on both sides, transcribed and turned into a note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe, die du über Gistsmith führst, werden beidseitig aufgezeichnet, transkribiert und zu einer Notiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels que tu passes depuis Gistsmith sont enregistrés des deux côtés, transcrits et transformés en note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas que haces desde Gistsmith se graban por ambas partes, se transcriben y se convierten en una nota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate che fai da Gistsmith vengono registrate da entrambe le parti, trascritte e trasformate in una nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas que você faz pelo Gistsmith são gravadas dos dois lados, transcritas e viram uma nota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprekken die je via Gistsmith voert, worden aan beide kanten opgenomen, uitgeschreven en omgezet in een notitie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith からの通話は双方とも録音され、文字起こしされてメモになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith에서 건 통화는 양쪽 모두 녹음되고 전사되어 노트가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你通过 Gistsmith 拨打的电话会双方录音、转写并生成笔记。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmithistä soittamasi puhelut tallennetaan molemmilta osapuolilta, litteroidaan ja niistä tulee muistiinpano."
          }
        }
      }
    },
    "Karşı taraf bağlanmadan önce görüşmenin kaydedildiğini söyleyen bir duyuru duyar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before being connected, the other person hears an announcement that the call is recorded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor die Verbindung steht, hört die andere Person eine Ansage, dass der Anruf aufgezeichnet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'être mise en relation, l'autre personne entend une annonce indiquant que l'appel est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de conectarse, la otra persona escucha un aviso de que la llamada se graba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di essere collegata, l'altra persona sente un annuncio che la chiamata è registrata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de ser conectada, a outra pessoa ouve um aviso de que a chamada é gravada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat de verbinding er is, hoort de ander een melding dat het gesprek wordt opgenomen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手はつながる前に、通話が録音されることを知らせるアナウンスを聞きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방은 연결되기 전에 통화가 녹음된다는 안내를 듣습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通前，对方会听到通话正在录音的提示。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennen yhdistämistä toinen osapuoli kuulee ilmoituksen, että puhelu tallennetaan."
          }
        }
      }
    },
    "Arama %@ üzerinden yapılır: %@ görüşmeyi taşır ve kaydı not hazırlanana dek (en çok bir gün) saklar, sonra silinir. Kayıt diğer kayıtların gibi yazıya dökülür.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls go through %@: %@ carries the call and keeps the recording until the note is ready (at most a day), then it's deleted. The recording is transcribed like your other recordings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe laufen über %@: %@ überträgt den Anruf und speichert die Aufnahme, bis die Notiz fertig ist (höchstens einen Tag), danach wird sie gelöscht. Die Aufnahme wird wie deine anderen Aufnahmen transkribiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels passent par %@ : %@ achemine l'appel et conserve l'enregistrement jusqu'à ce que la note soit prête (un jour au plus), puis il est supprimé. L'enregistrement est transcrit comme tes autres enregistrements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas pasan por %@: %@ transporta la llamada y guarda la grabación hasta que la nota está lista (como mucho un día); después se elimina. La grabación se transcribe como tus otras grabaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate passano tramite %@: %@ trasporta la chiamata e conserva la registrazione finché la nota è pronta (al massimo un giorno), poi viene eliminata. La registrazione viene trascritta come le altre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas passam pela %@: a %@ transporta a chamada e guarda a gravação até a nota ficar pronta (no máximo um dia); depois ela é excluída. A gravação é transcrita como suas outras gravações."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprekken lopen via %@: %@ verzorgt het gesprek en bewaart de opname tot de notitie klaar is (hoogstens een dag), daarna wordt die verwijderd. De opname wordt uitgeschreven zoals je andere opnamen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話は %@ を経由します。%@ が通話を中継し、メモができるまで（最長 1 日）録音を保存した後、削除されます。録音は他の録音と同じように文字起こしされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화는 %@를 통해 이루어집니다. %@가 통화를 전달하고 노트가 준비될 때까지(최대 하루) 녹음을 보관한 뒤 삭제합니다. 녹음은 다른 녹음처럼 전사됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话经由 %@ 进行：%@ 负责传输通话，并在笔记生成前（最多一天）保存录音，之后删除。录音会像你的其他录音一样被转写。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelut kulkevat %@-palvelun kautta: %@ välittää puhelun ja säilyttää tallenteen, kunnes muistiinpano on valmis (enintään päivän), minkä jälkeen se poistetaan. Tallenne litteroidaan kuten muutkin tallenteesi."
          }
        }
      }
    },
    "Arayan numara olarak yalnızca kendi numaran görünür; numaranı seni arayarak doğrularız.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your own number is shown as caller ID; we verify it by calling you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Anrufer-ID wird nur deine eigene Nummer angezeigt; wir bestätigen sie, indem wir dich anrufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ton propre numéro s'affiche comme appelant ; nous le vérifions en t'appelant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra tu propio número como identificador de llamada; lo verificamos llamándote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come ID chiamante viene mostrato solo il tuo numero; lo verifichiamo chiamandoti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas seu próprio número aparece como identificador de chamada; nós o verificamos ligando para você."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen je eigen nummer wordt als beller getoond; we verifiëren het door je te bellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発信者番号にはご自身の番号だけが表示されます。お電話して番号を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발신자 번호로는 내 번호만 표시됩니다. 전화를 걸어 번호를 인증합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来电显示只会显示你自己的号码；我们会打电话给你来验证。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittajan numerona näytetään vain oma numerosi; vahvistamme sen soittamalla sinulle."
          }
        }
      }
    },
    "Acil aramalar Gistsmith'ten yapılamaz; acil numaralar Telefon uygulamasında açılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency calls can't be made from Gistsmith; emergency numbers open in the Phone app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notrufe sind über Gistsmith nicht möglich; Notrufnummern werden in der Telefon-App geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels d'urgence ne peuvent pas être passés depuis Gistsmith ; les numéros d'urgence s'ouvrent dans l'app Téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden hacer llamadas de emergencia desde Gistsmith; los números de emergencia se abren en la app Teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate di emergenza non si possono fare da Gistsmith; i numeri di emergenza si aprono nell'app Telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível fazer chamadas de emergência pelo Gistsmith; números de emergência abrem no app Telefone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noodoproepen kunnen niet via Gistsmith; noodnummers worden geopend in de Telefoon-app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急通報は Gistsmith からはできません。緊急番号は電話アプリで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴급 전화는 Gistsmith에서 걸 수 없습니다. 긴급 번호는 전화 앱에서 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Gistsmith 拨打紧急电话；紧急号码会在“电话” App 中打开。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hätäpuheluita ei voi soittaa Gistsmithistä; hätänumerot avautuvat Puhelin-apissa."
          }
        }
      }
    },
    "Aramalarımın kaydedileceğini ve karşı tarafın onayını alacağımı kabul ediyorum.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand my calls are recorded, and I'll get the other person's consent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass meine Anrufe aufgezeichnet werden, und hole die Zustimmung der anderen Person ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que mes appels sont enregistrés et j'obtiendrai le consentement de l'autre personne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que mis llamadas se graban y obtendré el consentimiento de la otra persona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capisco che le mie chiamate vengono registrate e otterrò il consenso dell'altra persona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que minhas chamadas são gravadas e vou obter o consentimento da outra pessoa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat mijn gesprekken worden opgenomen en ik vraag de ander om toestemming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話が録音されることを理解し、相手の同意を得ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화가 녹음된다는 것을 이해하며 상대방의 동의를 받겠습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解我的通话会被录音，并会征得对方同意。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymmärrän, että puheluni tallennetaan, ja pyydän toiselta osapuolelta suostumuksen."
          }
        }
      }
    },
