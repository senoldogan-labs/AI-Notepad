            "value": "회의가 끝나면: 할 일, 결정 사항, 요약 및 용어집."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na afloop: taken, besluiten, samenvatting en woordenlijst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando terminar: tarefas, decisões, resumo e glossário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
