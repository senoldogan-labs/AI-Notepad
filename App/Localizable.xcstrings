    "Konuşma tanıma modeli (%@) yüklenemedi. İnternet bağlantını ve disk alanını kontrol edip uygulamayı yeniden aç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spracherkennungsmodell (%@) konnte nicht geladen werden. Prüfe Internetverbindung und Speicherplatz und öffne die App dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition model (%@) couldn't be loaded. Check your internet connection and disk space, then reopen the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar el modelo de reconocimiento de voz (%@). Comprueba tu conexión a internet y el espacio en disco, y vuelve a abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistusmallia (%@) ei voitu ladata. Tarkista internetyhteys ja levytila ja avaa sovellus sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de reconnaissance vocale (%@) n’a pas pu être chargé. Vérifiez votre connexion Internet et l’espace disque, puis rouvrez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il modello di riconoscimento vocale (%@). Controlla la connessione a internet e lo spazio su disco, poi riapri l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識モデル（%@）を読み込めませんでした。インターネット接続とディスクの空き容量を確認してから、アプリを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식 모델(%@)을 불러올 수 없습니다. 인터넷 연결과 디스크 공간을 확인한 다음 앱을 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het spraakherkenningsmodel (%@) kon niet worden geladen. Controleer je internetverbinding en schijfruimte en open de app opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o modelo de reconhecimento de fala (%@). Verifique sua conexão com a internet e o espaço em disco e reabra o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入语音识别模型（%@）。请检查你的互联网连接和磁盘空间，然后重新打开 App。"
          }
        }
      }
    },
    "Konuşma tanıma modeli hazır değil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spracherkennungsmodell ist nicht bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition model isn't ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de reconocimiento de voz no está listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistusmalli ei ole valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
