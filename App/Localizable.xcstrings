    "İlk toplantını kaydet ya da bir kaydı içe aktar; not, görevler ve transkript burada hazır olur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dein erstes Meeting auf oder importiere eine Aufnahme; Notiz, Aufgaben und Transkript sind dann hier bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your first meeting or import a recording; the note, tasks and transcript will be ready here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu primera reunión o importa una grabación; la nota, las tareas y la transcripción estarán listas aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita ensimmäinen kokouksesi tai tuo nauhoite; muistiinpano, tehtävät ja litterointi ovat täällä valmiina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre première réunion ou importez un enregistrement ; la note, les tâches et la transcription seront prêtes ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua prima riunione o importa una registrazione; nota, attività e trascrizione saranno pronte qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の会議を録音するか録音を読み込むと、ノート、タスク、文字起こしがここに用意されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 회의를 녹음하거나 녹음 파일을 가져오세요. 노트, 할 일 및 녹취록이 여기에 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je eerste vergadering op of importeer een opname; de notitie, taken en het transcript staan hier dan klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave sua primeira reunião ou importe uma gravação; a nota, as tarefas e a transcrição ficarão prontas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制你的第一个会议或导入一段录音；笔记、任务和文字稿会在这里准备好。"
          }
        }
      }
    },
    "İlk toplantını kaydet ya da içe aktar; sonra burada sorarsın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dein erstes Meeting auf oder importiere es und stelle dann hier Fragen dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import your first meeting, then ask about it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o importa tu primera reunión y luego pregunta sobre ella aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita tai tuo ensimmäinen kokouksesi ja kysy siitä sitten täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou importez votre première réunion, puis posez vos questions ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o importa la tua prima riunione, poi fai domande qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の会議を録音するか読み込んでから、ここで質問してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 회의를 녹음하거나 가져온 다음 여기에서 질문하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je eerste vergadering op of importeer hem, en stel er hier vragen over."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou importe sua primeira reunião e depois pergunte sobre ela aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或导入你的第一个会议，然后在这里提问。"
          }
        }
      }
    },
