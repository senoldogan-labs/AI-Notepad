    "Notu değiştir: \"özeti kısalt\", \"görevlere tarih ekle\"…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiz ändern: „Zusammenfassung kürzen“, „Aufgaben mit Terminen versehen“ …"
          }
        },
        "en": {
