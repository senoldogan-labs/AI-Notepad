    "%@ webhook'u kabul etmedi. Adresin doğru ve etkin olduğunu kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Webhook nicht akzeptiert. Prüfe, ob die Adresse korrekt und aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the webhook. Check that the address is correct and active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha aceptado el webhook. Comprueba que la dirección sea correcta y esté activa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei hyväksynyt webhookia. Tarkista, että osoite on oikea ja käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté le webhook. Vérifiez que l’adresse est correcte et active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha accettato il webhook. Controlla che l’indirizzo sia corretto e attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がWebhookを受け付けませんでした。アドレスが正しく有効であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 Webhook을 허용하지 않았습니다. 주소가 올바르고 활성 상태인지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft de webhook niet geaccepteerd. Controleer of het adres klopt en actief is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceitou o webhook. Verifique se o endereço está correto e ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受该 Webhook。请检查地址是否正确且有效。"
          }
        }
      }
    },
    "%@ yanıt vermedi (%@); not gitmiş olabilir. Kontrol et, gitmediyse elle yeniden gönder. Kendiliğinden yeniden gönderilmeyecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht geantwortet (%@); die Notiz wurde eventuell zugestellt. Prüfe es und sende sie manuell erneut, falls sie nicht angekommen ist. Sie wird nicht automatisch erneut gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not respond (%@); the note may have been delivered. Check, and send it again manually if it did not arrive. It will not be resent automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha respondido (%@); puede que la nota se haya entregado. Compruébalo y vuelve a enviarla manualmente si no ha llegado. No se reenviará automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei vastannut (%@); muistiinpano on ehkä toimitettu. Tarkista, ja lähetä se uudelleen käsin, jos se ei saapunut. Sitä ei lähetetä uudelleen automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu (%@) ; la note a peut-être été livrée. Vérifiez, et renvoyez-la manuellement si elle n’est pas arrivée. Elle ne sera pas renvoyée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha risposto (%@); la nota potrebbe essere stata consegnata. Controlla e, se non è arrivata, inviala di nuovo manualmente. Non verrà reinviata automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から応答がありませんでした（%@）。ノートは届いている可能性があります。確認して、届いていなければ手動で再送信してください。自動では再送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 응답하지 않았습니다(%@). 노트가 전달되었을 수 있습니다. 확인한 후 도착하지 않았다면 직접 다시 보내세요. 자동으로 다시 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reageerde niet (%@); de notitie is mogelijk wel afgeleverd. Controleer het en stuur hem handmatig opnieuw als hij niet is aangekomen. Hij wordt niet automatisch opnieuw verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu (%@); a nota pode ter sido entregue. Verifique e, se não chegou, envie de novo manualmente. Ela não será reenviada automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应（%@）；笔记可能已送达。请检查，如果未送达请手动重新发送。笔记不会自动重新发送。"
          }
        }
      }
    },
    "%@ yanıtı anlaşılamadı; yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort von %@ war unverständlich; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't understand the %@ response; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido interpretar la respuesta de %@; inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelun %@ vastausta ei ymmärretty; yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de comprendre la réponse de %@ ; réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile interpretare la risposta di %@; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の応答を解釈できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 응답을 이해할 수 없습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het antwoord van %@ niet begrijpen; probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entender a resposta de %@; tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法理解 %@ 的响应；请重试。"
          }
        }
      }
    },
    "%@ yanıtı yarıda kesildi. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat mittendrin aufgehört zu antworten. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped responding midway. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha dejado de responder a mitad del proceso. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lakkasi vastaamasta kesken. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a cessé de répondre en cours de route. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha smesso di rispondere a metà. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が途中で応答しなくなりました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 도중에 응답을 멈췄습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reageerde halverwege niet meer. Probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parou de responder no meio do caminho. Tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中途停止响应。请稍后再试。"
          }
        }
      }
    },
    "%@ yeniden bağlandı; eski bağlantının izni %@ tarafında geri alınamadı (%@). Eski erişimi %@ ayarlarından kaldırabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist neu verbunden, aber der Zugriff der alten Verbindung konnte auf Seiten von %@ nicht widerrufen werden (%@). Du kannst den alten Zugriff in deinen Einstellungen bei %@ entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reconnected, but the old connection's access couldn't be revoked on the %@ side (%@). You can remove the old access in your %@ settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha vuelto a conectar, pero no se ha podido revocar el acceso de la conexión anterior en %@ (%@). Puedes retirar el acceso anterior en los ajustes de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yhdistettiin uudelleen, mutta vanhan yhteyden käyttöoikeutta ei voitu perua palvelun %@ puolella (%@). Voit poistaa vanhan käyttöoikeuden %@-asetuksistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est reconnecté, mais l’accès de l’ancienne connexion n’a pas pu être révoqué du côté de %@ (%@). Vous pouvez retirer l’ancien accès dans vos réglages %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è riconnesso, ma non è stato possibile revocare l’accesso della vecchia connessione dal lato di %@ (%@). Puoi rimuovere il vecchio accesso nelle impostazioni di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に再接続しましたが、%@側で古い接続のアクセス権を取り消せませんでした（%@）。古いアクセス権は%@の設定で削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 다시 연결되었지만 %2$@ 측에서 이전 연결의 접근 권한을 취소하지 못했습니다(%3$@). %4$@ 설정에서 이전 접근 권한을 제거할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is opnieuw gekoppeld, maar de toegang van de oude koppeling kon aan de kant van %@ niet worden ingetrokken (%@). Je kunt de oude toegang verwijderen in je %@-instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi reconectado, mas o acesso da conexão antiga não pôde ser revogado do lado de %@ (%@). Você pode remover o acesso antigo nos ajustes de %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已重新连接，但无法在 %2$@ 端撤销旧连接的访问权限（%3$@）。你可以在 %4$@ 设置中移除旧的访问权限。"
          }
        }
      }
    },
    "%@ yorum satırları içeriyor; yorumlar kaybolmasın diye üzerine yazılmadı. Toplantı sunucusunu o uygulamanın ayarından elle ekle (komut: bu uygulama, --mcp argümanıyla).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält Kommentare; die Datei wurde nicht überschrieben, damit sie nicht verloren gehen. Füge den Meeting-Server manuell in den Einstellungen dieser App hinzu (Befehl: diese App mit dem Argument --mcp)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contains comments; it wasn't overwritten so they aren't lost. Add the meetings server by hand in that app's settings (command: this app, with the --mcp argument)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contiene comentarios; no se ha sobrescrito para no perderlos. Añade el servidor de reuniones manualmente en los ajustes de esa app (comando: esta app, con el argumento --mcp)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sisältää kommentteja; sitä ei korvattu, jotta ne eivät katoa. Lisää kokouspalvelin käsin kyseisen sovelluksen asetuksissa (komento: tämä sovellus argumentilla --mcp)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient des commentaires ; il n’a pas été écrasé pour ne pas les perdre. Ajoutez le serveur de réunions à la main dans les réglages de cette app (commande : cette app, avec l’argument --mcp)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contiene commenti; non è stato sovrascritto per non perderli. Aggiungi manualmente il server delle riunioni nelle impostazioni di quell’app (comando: questa app, con l’argomento --mcp)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはコメントが含まれているため、失われないよう上書きしませんでした。そのアプリの設定で会議サーバを手動で追加してください（コマンド：このアプリ、引数は --mcp）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 주석이 포함되어 있어 주석이 사라지지 않도록 덮어쓰지 않았습니다. 해당 앱의 설정에서 회의 서버를 직접 추가하세요(명령: 이 앱, --mcp 인수 사용)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bevat opmerkingen; het bestand is niet overschreven zodat ze niet verloren gaan. Voeg de vergaderserver handmatig toe in de instellingen van die app (opdracht: deze app, met het argument --mcp)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contém comentários; não foi sobrescrito para que eles não se percam. Adicione o servidor de reuniões manualmente nos ajustes desse app (comando: este app, com o argumento --mcp)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含注释；为避免注释丢失，未覆盖该文件。请在该 App 的设置中手动添加会议服务器（命令：本 App，参数为 --mcp）。"
          }
        }
