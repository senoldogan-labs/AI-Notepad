            "state": "translated",
            "value": "In Fragen wird gerade eine andere Frage beantwortet; versuche es danach erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another question is being answered in Ask; try again when it's done."
          }
        },
        "es": {
