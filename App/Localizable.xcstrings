    "Not, transkript ve ses silinir; geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiz, Transkript und Audio werden gelöscht; das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note, transcript and audio are deleted; this can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán la nota, la transcripción y el audio; esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpano, litterointi ja ääni poistetaan; tätä ei voi kumota."
