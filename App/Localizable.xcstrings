    "Mail açılamadı: bu iPhone'da e-posta uygulaması yok. \"Paylaş\" ya da \"Kopyala\" ile gönderebilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail konnte nicht geöffnet werden: Auf diesem iPhone gibt es keine E-Mail-App. Sende sie stattdessen mit „Teilen“ oder „Kopieren“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Mail: there's no email app on this iPhone. Send it with \"Share\" or \"Copy\" instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir Mail: no hay ninguna app de correo en este iPhone. Envíalo con “Compartir” o “Copiar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailia ei voitu avata: tässä iPhonessa ei ole sähköpostisovellusta. Lähetä se sen sijaan valinnalla ”Jaa” tai ”Kopioi”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Mail : aucune app de messagerie sur cet iPhone. Envoyez-le plutôt avec « Partager » ou « Copier »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Mail: non c’è nessuna app email su questo iPhone. Inviala con “Condividi” o “Copia”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メール」を開けませんでした：このiPhoneにメールアプリがありません。代わりに「共有」または「コピー」で送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail을 열 수 없습니다: 이 iPhone에 이메일 앱이 없습니다. 대신 \"공유\" 또는 \"복사\"로 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan Mail niet openen: er is geen e-mailapp op deze iPhone. Verstuur hem in plaats daarvan met \"Deel\" of \"Kopieer\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Mail: não há nenhum app de e-mail neste iPhone. Envie com \"Compartilhar\" ou \"Copiar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开“邮件”：这部 iPhone 上没有电子邮件 App。请改用“共享”或“拷贝”发送。"
          }
        }
      }
    },
    "Şimdi bitir": {
