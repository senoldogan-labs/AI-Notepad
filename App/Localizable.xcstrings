        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione acquisisce solo l’audio del computer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音ではコンピュータの音声のみを収録します"
