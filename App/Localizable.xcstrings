    "Claude ve diğer yapay zekâ araçları için yazılmış beceriler Sor'da \"/\" ile tarif olarak çalışır (ör. haftalık özet, takip e-postası).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Claude und andere KI-Tools geschriebene Skills funktionieren in „Fragen“ mit „/“ als Rezepte (z. B. Wochenrückblick, Follow-up-E-Mail)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills written for Claude and other AI tools work as recipes in Ask with \"/\" (e.g. weekly review, follow-up email)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las habilidades escritas para Claude y otras herramientas de IA funcionan como recetas en Preguntar con “/” (p. ej., revisión semanal, correo de seguimiento)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudelle ja muille tekoälytyökaluille kirjoitetut taidot toimivat Kysy-toiminnossa resepteinä ”/”-merkillä (esim. viikkokatsaus, jatkosähköposti)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences écrites pour Claude et d’autres outils d’IA fonctionnent comme des recettes dans Demander avec « / » (p. ex. bilan hebdomadaire, e-mail de suivi)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le skill scritte per Claude e altri strumenti AI funzionano come ricette in Chiedi con “/” (ad es. revisione settimanale, email di follow-up)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeやその他のAIツール向けに書かれたスキルは、「質問」で「/」を使ってレシピとして使えます（例：週次レビュー、フォローアップメール）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 및 기타 AI 도구용으로 작성된 스킬은 질문하기에서 \"/\"로 레시피처럼 사용할 수 있습니다(예: 주간 검토, 후속 이메일)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills die voor Claude en andere AI-tools zijn geschreven, werken als recepten in Vraag met \"/\" (bijv. weekoverzicht, follow-up-e-mail)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilidades escritas para o Claude e outras ferramentas de IA funcionam como receitas em Perguntar com \"/\" (ex.: revisão semanal, e-mail de acompanhamento)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Claude 和其他 AI 工具编写的技能可在“提问”中通过“/”作为预设使用（例如每周回顾、跟进邮件）。"
          }
        }
      }
    },
    "Claude, Cursor ve VS Code toplantılarını arayıp okuyabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor und VS Code können deine Meetings durchsuchen und lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor and VS Code can search and read your meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor y VS Code pueden buscar y leer tus reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor ja VS Code voivat hakea ja lukea kokouksiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor et VS Code peuvent rechercher et lire vos réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor e VS Code possono cercare e leggere le tue riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、Cursor、VS Codeで会議を検索・読み取りできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor 및 VS Code에서 회의를 검색하고 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor en VS Code kunnen je vergaderingen doorzoeken en lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor e VS Code podem buscar e ler suas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、Cursor 和 VS Code 可以搜索和读取你的会议。"
          }
        }
      }
    },
    "Daha resmi yaz": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Förmlicher formulieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it more formal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlo más formal"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee siitä muodollisempi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre plus formel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendila più formale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりフォーマルに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 격식 있게"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak het formeler"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar mais formal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写得更正式些"
          }
        }
      }
    },
    "Daha yüksek kalite: Claude ile not, konuşmacılar ayrılır. Sonraki adımda anahtarları girersin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Qualität: Notizen von Claude, Sprecher getrennt. Die Schlüssel gibst du im nächsten Schritt ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher quality: notes by Claude, speakers separated. You'll enter the keys in the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más calidad: notas de Claude e interlocutores separados. Introducirás las claves en el siguiente paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parempi laatu: Claude kirjoittaa muistiinpanot, puhujat erotellaan. Syötät avaimet seuraavassa vaiheessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure qualité : notes rédigées par Claude, intervenants séparés. Vous saisirez les clés à l’étape suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualità superiore: note scritte da Claude, interlocutori separati. Inserirai le chiavi nel passaggio successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より高品質：Claudeがノートを作成し、話者を分離します。キーは次のステップで入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 높은 품질: Claude가 노트를 작성하고 화자를 구분합니다. 다음 단계에서 키를 입력합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogere kwaliteit: notities door Claude, sprekers gescheiden. Je voert de sleutels in de volgende stap in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais qualidade: notas pelo Claude, falantes separados. Você vai digitar as chaves no próximo passo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更高质量：由 Claude 撰写笔记，区分说话人。你将在下一步输入密钥。"
          }
        }
      }
    },
    "Daha yüksek kalite: konuşmacılar ayrılır, Claude notu yazar. Anahtarlar Mac'ten gelir ya da burada girilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Qualität: Sprecher werden getrennt und Claude schreibt die Notiz. Die Schlüssel kommen von deinem Mac oder werden hier eingegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher quality: speakers are separated and Claude writes the note. Keys come from your Mac or are entered here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más calidad: los interlocutores se separan y Claude escribe la nota. Las claves vienen de tu Mac o se introducen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parempi laatu: puhujat erotellaan ja Claude kirjoittaa muistiinpanon. Avaimet tulevat Macistasi tai syötetään tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure qualité : les intervenants sont séparés et Claude rédige la note. Les clés proviennent de votre Mac ou sont saisies ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualità superiore: gli interlocutori vengono separati e Claude scrive la nota. Le chiavi arrivano dal Mac o si inseriscono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より高品質：話者が分離され、Claudeがノートを作成します。キーはMacから取得するか、ここで入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 높은 품질: 화자가 구분되고 Claude가 노트를 작성합니다. 키는 Mac에서 가져오거나 여기에서 입력합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogere kwaliteit: sprekers worden gescheiden en Claude schrijft de notitie. Sleutels komen van je Mac of worden hier ingevoerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais qualidade: os falantes são separados e o Claude escreve a nota. As chaves vêm do seu Mac ou são digitadas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更高质量：区分说话人，由 Claude 撰写笔记。密钥来自你的 Mac 或在此输入。"
          }
        }
      }
    },
