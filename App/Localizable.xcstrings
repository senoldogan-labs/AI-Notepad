    "Ana toplantı dilinle (%@) yazar; Ayarlar › Genel'den değişir. Apple'ın cihaz içi diktesi kullanılır; dil modeli gerekirse ilk kullanımda indirilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt in deiner Hauptsprache für Meetings (%@); ändere sie unter „Einstellungen“ › „Allgemein“. Verwendet Apples Diktierfunktion auf dem Gerät; das Sprachmodell wird bei Bedarf bei der ersten Verwendung geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Types in your primary meeting language (%@); change it in Settings › General. Uses Apple's on-device dictation; the language model is downloaded on first use if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en tu idioma principal de las reuniones (%@); cámbialo en Ajustes › General. Usa el dictado en el dispositivo de Apple; si hace falta, el modelo de idioma se descarga la primera vez que se usa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaa kokousten pääkielellä (%@); muuta sitä kohdassa Asetukset › Yleiset. Käyttää Applen laitteella toimivaa sanelua; kielimalli ladataan tarvittaessa ensimmäisellä käyttökerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisit dans la langue principale de vos réunions (%@) ; modifiez-la dans Réglages › Général. Utilise la dictée sur l’appareil d’Apple ; le modèle de langue est téléchargé à la première utilisation si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive nella lingua principale delle riunioni (%@); puoi cambiarla in Impostazioni › Generali. Usa la dettatura di Apple sul dispositivo; il modello linguistico viene scaricato al primo utilizzo, se necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議のメイン言語（%@）で入力します。「設定」›「一般」で変更できます。Appleのオンデバイス音声入力を使用し、必要に応じて初回使用時に言語モデルがダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 회의 언어(%@)로 입력합니다. 설정 › 일반에서 변경할 수 있습니다. Apple의 온디바이스 받아쓰기를 사용하며, 필요한 경우 처음 사용할 때 언어 모델이 다운로드됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typt in je hoofdtaal voor vergaderingen (%@); wijzig dit in Instellingen › Algemeen. Gebruikt Apples dicteerfunctie op het apparaat; het taalmodel wordt zo nodig bij het eerste gebruik gedownload."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita no idioma principal das suas reuniões (%@); altere em Ajustes › Geral. Usa o ditado no dispositivo da Apple; o modelo do idioma é baixado no primeiro uso, se necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的主要会议语言（%@）输入；可在“设置 › 通用”中更改。使用 Apple 设备端听写；如有需要，首次使用时会下载语言模型。"
          }
        }
      }
    },
    "Ana toplantı dilinle (%@) yazar; Ayarlar › Genel'den değişir. Bu Mac'te WhisperKit modeliyle çalışır (~630 MB; yoksa ilk kullanımda indirilir).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt in deiner Hauptsprache für Meetings (%@); ändere sie unter „Einstellungen“ › „Allgemein“. Auf diesem Mac wird das WhisperKit-Modell verwendet (ca. 630 MB; wird bei der ersten Verwendung geladen, falls es fehlt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Types in your primary meeting language (%@); change it in Settings › General. On this Mac it uses the WhisperKit model (~630 MB; downloaded on first use if missing)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en tu idioma principal de las reuniones (%@); cámbialo en Ajustes › General. En este Mac usa el modelo WhisperKit (~630 MB; se descarga la primera vez si no está)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaa kokousten pääkielellä (%@); muuta sitä kohdassa Asetukset › Yleiset. Tässä Macissa käytetään WhisperKit-mallia (~630 Mt; ladataan ensimmäisellä käyttökerralla, jos se puuttuu)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisit dans la langue principale de vos réunions (%@) ; modifiez-la dans Réglages › Général. Sur ce Mac, utilise le modèle WhisperKit (~630 Mo ; téléchargé à la première utilisation s’il manque)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive nella lingua principale delle riunioni (%@); puoi cambiarla in Impostazioni › Generali. Su questo Mac usa il modello WhisperKit (~630 MB; scaricato al primo utilizzo se manca)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議のメイン言語（%@）で入力します。「設定」›「一般」で変更できます。このMacではWhisperKitモデル（約630 MB、未取得の場合は初回使用時にダウンロード）を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 회의 언어(%@)로 입력합니다. 설정 › 일반에서 변경할 수 있습니다. 이 Mac에서는 WhisperKit 모델(약 630MB, 없으면 처음 사용할 때 다운로드됨)을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typt in je hoofdtaal voor vergaderingen (%@); wijzig dit in Instellingen › Algemeen. Op deze Mac wordt het WhisperKit-model gebruikt (~630 MB; wordt bij het eerste gebruik gedownload als het ontbreekt)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita no idioma principal das suas reuniões (%@); altere em Ajustes › Geral. Neste Mac, usa o modelo WhisperKit (~630 MB; baixado no primeiro uso, se faltar)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的主要会议语言（%@）输入；可在“设置 › 通用”中更改。在这台 Mac 上使用 WhisperKit 模型（约 630 MB；如未安装，首次使用时下载）。"
          }
        }
      }
    },
    "Anahtar (Ollama'da gerekmez)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel (für Ollama nicht nötig)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key (not needed for Ollama)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave (no necesaria para Ollama)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avain (ei tarvita Ollamalle)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé (inutile pour Ollama)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave (non necessaria per Ollama)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー（Ollamaでは不要）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키(Ollama에는 필요 없음)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutel (niet nodig voor Ollama)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave (não necessária para o Ollama)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥（Ollama 不需要）"
          }
        }
      }
    },
    "Anahtar Keychain'den okunamadı (%@, kod %lld). İzin penceresinde \"Her Zaman İzin Ver\"i seç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel konnte nicht aus dem Schlüsselbund gelesen werden (%@, Code %lld). Wähle im Berechtigungsdialog „Immer erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the key from the Keychain (%@, code %lld). Choose \"Always Allow\" in the permission dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la clave del Llavero (%@, código %lld). Elige “Permitir siempre” en el cuadro de diálogo de permisos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avainta ei voitu lukea Avainnipusta (%@, koodi %lld). Valitse lupaikkunassa ”Salli aina”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la clé dans le trousseau (%@, code %lld). Choisissez « Toujours autoriser » dans la fenêtre d’autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la chiave dal Portachiavi (%@, codice %lld). Scegli “Consenti sempre” nella finestra di autorizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンからキーを読み取れませんでした（%@、コード %lld）。許可ダイアログで「常に許可」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에서 키를 읽을 수 없습니다(%@, 코드 %lld). 권한 대화상자에서 \"항상 허용\"을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de sleutel niet uit de Sleutelhanger lezen (%@, code %lld). Kies \"Altijd toestaan\" in het toestemmingsvenster."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a chave nas Chaves (%@, código %lld). Escolha \"Permitir Sempre\" na caixa de permissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取密钥（%@，代码 %lld）。请在权限对话框中选择“总是允许”。"
          }
        }
      }
    },
    "Anahtar gerekmez: not, çeviri ve konuşmacı ayırma %@ sunucusundan. 3 toplantı ya da ilk toplantından itibaren 7 gün ücretsiz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Schlüssel nötig: Notizen, Übersetzung und Sprechertrennung kommen vom %@-Server. Gratis für 3 Meetings oder 7 Tage ab deinem ersten Meeting."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No keys needed: notes, translation and speaker separation come from the %@ server. Free for 3 meetings or 7 days from your first meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas claves: las notas, la traducción y la separación de interlocutores vienen del servidor de %@. Gratis durante 3 reuniones o 7 días desde tu primera reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimia ei tarvita: muistiinpanot, käännös ja puhujien erottelu tulevat %@-palvelimelta. Ilmainen 3 kokouksen tai 7 päivän ajan ensimmäisestä kokouksestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé nécessaire : les notes, la traduction et la séparation des intervenants proviennent du serveur %@. Gratuit pour 3 réunions ou 7 jours à partir de votre première réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave necessaria: note, traduzione e separazione degli interlocutori arrivano dal server di %@. Gratis per 3 riunioni o 7 giorni dalla tua prima riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは不要です：ノート、翻訳、話者分離は%@サーバから提供されます。最初の会議から3件の会議または7日間無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 필요 없습니다. 노트, 번역 및 화자 구분은 %@ 서버에서 제공됩니다. 첫 회의부터 회의 3개 또는 7일 동안 무료입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen sleutels nodig: notities, vertaling en sprekerscheiding komen van de %@-server. Gratis voor 3 vergaderingen of 7 dagen vanaf je eerste vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave necessária: notas, tradução e separação de falantes vêm do servidor de %@. Grátis por 3 reuniões ou 7 dias a partir da sua primeira reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需密钥：笔记、翻译和说话人区分由 %@ 服务器提供。从第一个会议起，3 个会议或 7 天内免费。"
          }
        }
      }
    },
    "Anahtarlar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel"
          }
        },
