    "Başka bir cihazda değiştirildi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät geändert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed on another device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificado en otro dispositivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutettu toisella laitteella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié sur un autre appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificato su un altro dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで変更されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 변경됨"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewijzigd op een ander apparaat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterado em outro dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在另一台设备上更改"
          }
        }
      }
    },
    "Başka bir cihazında kaydedildi; sesi o cihazda kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen deiner Geräte aufgenommen; der Ton bleibt dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded on another of your devices; its audio stays there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabada en otro de tus dispositivos; su audio se queda allí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu toisella laitteellasi; sen ääni jää sinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur un autre de vos appareils ; l’audio y reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrata su un altro tuo dispositivo; l’audio resta lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの別のデバイスで録音されました。音声はそのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 녹음되었습니다. 오디오는 그 기기에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgenomen op een ander apparaat van je; de audio blijft daar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada em outro dispositivo seu; o áudio fica nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的另一台设备上录制；音频保留在那台设备上。"
          }
        }
      }
    },
    "Bu hesapta eşitlemeyi başka bir cihaz açtı. Katılmak için o cihazda Ayarlar'da gösterilen bağlantı kodunu aşağıya yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät hat die Synchronisierung für diesen Account eingeschaltet. Gib zum Beitreten unten den Verbindungscode ein, der dort in den Einstellungen angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device turned on sync for this account. To join, type the link code shown in Settings on that device below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo activó la sincronización para esta cuenta. Para unirte, escribe abajo el código de vinculación que aparece en Ajustes en ese dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen laite otti synkronoinnin käyttöön tälle tilille. Liity kirjoittamalla alle linkityskoodi, joka näkyy sen laitteen asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil a activé la synchronisation pour ce compte. Pour la rejoindre, saisissez ci-dessous le code de liaison affiché dans les Réglages de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo ha attivato la sincronizzazione per questo account. Per unirti, scrivi qui sotto il codice di collegamento mostrato nelle Impostazioni di quel dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの同期は別のデバイスでオンにされました。参加するには、そのデバイスの設定に表示されているリンクコードを下に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이 계정의 동기화를 켰습니다. 참여하려면 그 기기의 설정에 표시된 연결 코드를 아래에 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander apparaat heeft synchronisatie voor dit account aangezet. Typ om mee te doen hieronder de koppelcode die op dat apparaat in Instellingen staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo ativou a sincronização nesta conta. Para entrar, digite abaixo o código de vínculo mostrado nos Ajustes desse dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备已为此账户打开同步。要加入，请在下方输入那台设备“设置”中显示的关联码。"
          }
        }
      }
    },
    "Bu kod eski: eşitleme o günden beri yeniden açılmış. Diğer cihazdaki güncel kodu yaz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist veraltet: Die Synchronisierung wurde inzwischen neu eingeschaltet. Gib den aktuellen Code von deinem anderen Gerät ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is out of date: sync was turned on again since. Type the current code from your other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código está desactualizado: la sincronización se volvió a activar desde entonces. Escribe el código actual de tu otro dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä koodi on vanhentunut: synkronointi on sen jälkeen otettu uudelleen käyttöön. Kirjoita toisen laitteesi nykyinen koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est périmé : la synchronisation a été réactivée depuis. Saisissez le code actuel de votre autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è vecchio: da allora la sincronizzazione è stata riattivata. Scrivi il codice attuale dell’altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは古くなっています。その後、同期がもう一度オンにされました。別のデバイスに表示されている最新のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 오래되었습니다. 그 후 동기화가 다시 켜졌습니다. 다른 기기에 표시된 최신 코드를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code is verouderd: synchronisatie is sindsdien opnieuw aangezet. Typ de huidige code van je andere apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código está desatualizado: a sincronização foi ativada de novo desde então. Digite o código atual do seu outro dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码已过期：同步之后已重新打开。请输入另一台设备上的当前代码。"
          }
        }
      }
    },
    "Diğer cihaz eşitlemeyi açmayı bitirmedi. O cihazda uygulamayı açıp yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein anderes Gerät hat das Einschalten der Synchronisierung noch nicht abgeschlossen. Öffne dort die App und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other device hasn't finished turning on sync. Open the app there and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu otro dispositivo no ha terminado de activar la sincronización. Abre la app allí e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen laitteesi ei ole vielä saanut synkronoinnin käyttöönottoa valmiiksi. Avaa sovellus siellä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre autre appareil n’a pas fini d’activer la synchronisation. Ouvrez l’app sur cet appareil et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altro dispositivo non ha finito di attivare la sincronizzazione. Apri l’app lì e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで同期のオンがまだ完了していません。そのデバイスでアプリを開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 동기화 켜기가 아직 끝나지 않았습니다. 그 기기에서 앱을 열고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je andere apparaat is nog niet klaar met het aanzetten van synchronisatie. Open de app daar en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu outro dispositivo não terminou de ativar a sincronização. Abra o app nele e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台设备尚未完成打开同步。请在那台设备上打开 App 后重试。"
          }
        }
      }
    },
    "Diğer cihazda Ayarlar › Mac ile iPhone arasında eşitle altında gösterilen 32 karakterlik kod.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 32-stellige Code, der auf deinem anderen Gerät unter Einstellungen › Zwischen Mac und iPhone synchronisieren angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 32-character code shown on your other device under Settings › Sync between Mac and iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de 32 caracteres que aparece en tu otro dispositivo en Ajustes › Sincronizar entre Mac y iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "32 merkin koodi, joka näkyy toisella laitteellasi kohdassa Asetukset › Synkronoi Macin ja iPhonen välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de 32 caractères affiché sur votre autre appareil dans Réglages › Synchroniser entre Mac et iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di 32 caratteri mostrato sull’altro dispositivo in Impostazioni › Sincronizza tra Mac e iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスの「設定」›「MacとiPhone間で同期」に表示される32文字のコード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 설정 › Mac과 iPhone 간 동기화에 표시되는 32자 코드입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code van 32 tekens die op je andere apparaat staat onder Instellingen › Synchroniseren tussen Mac en iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de 32 caracteres mostrado no seu outro dispositivo em Ajustes › Sincronizar entre Mac e iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台设备的“设置”›“在 Mac 和 iPhone 之间同步”下显示的 32 位代码。"
          }
        }
      }
    },
    "Diğer cihazın için bağlantı kodu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungscode für dein anderes Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link code for your other device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de vinculación para tu otro dispositivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkityskoodi toiselle laitteellesi"
          }
        },
        "fr": {
          "stringUnit": {
