    "Etiketlenen toplantılardan biri artık yok (silinmiş ya da taşınmış); etiketleri kaldırıp yeniden seç.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines der markierten Meetings existiert nicht mehr (gelöscht oder verschoben); entferne die Markierungen und wähle erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the tagged meetings no longer exists (deleted or moved); remove the tags and pick again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de las reuniones etiquetadas ya no existe (se ha eliminado o movido); quita las etiquetas y vuelve a elegir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhtä merkityistä kokouksista ei enää ole (poistettu tai siirretty); poista merkinnät ja valitse uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’une des réunions taguées n’existe plus (supprimée ou déplacée) ; retirez les tags et choisissez de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una delle riunioni taggate non esiste più (eliminata o spostata); rimuovi i tag e scegli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグ付けした会議の1つが存在しません（削除または移動されました）。タグを外して、もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그된 회의 중 하나가 더 이상 존재하지 않습니다(삭제되거나 이동됨). 태그를 제거하고 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de getagde vergaderingen bestaat niet meer (verwijderd of verplaatst); verwijder de tags en kies opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma das reuniões marcadas não existe mais (apagada ou movida); remova as marcações e escolha de novo."
          }
        },
        "zh-Hans": {
