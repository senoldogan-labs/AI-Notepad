        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido transcribir el audio: el repaso final no ha generado texto. Puedes volver a intentarlo con “Reprocesar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääntä ei voitu litteroida: viimeistely ei tuottanut tekstiä. Voit yrittää uudelleen valinnalla ”Käsittele uudelleen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de transcrire l’audio : la passe finale n’a produit aucun texte. Vous pouvez réessayer avec « Retraiter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere l’audio: il passaggio finale non ha prodotto testo. Puoi riprovare con “Rielabora”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を文字起こしできませんでした：最終処理でテキストが生成されませんでした。「再処理」でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 텍스트로 변환할 수 없습니다: 최종 처리에서 텍스트가 생성되지 않았습니다. \"다시 처리\"로 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de audio niet uitschrijven: de laatste ronde leverde geen tekst op. Je kunt het opnieuw proberen met \"Opnieuw verwerken\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível transcrever o áudio: a passada final não produziu texto. Você pode tentar de novo com \"Reprocessar\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转写音频：最终处理未生成任何文字。你可以用“重新处理”再试一次。"
          }
        }
      }
    },
    "Ses yeniden yazıya dökülemedi: %@ Önceki son geçiş metni korundu, not ondan yazıldı.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio konnte nicht erneut transkribiert werden: %@ Das vorherige endgültige Transkript wurde beibehalten und die Notiz daraus geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio could not be transcribed again: %@ The previous final transcript was kept and the note was written from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido volver a transcribir el audio: %@ Se ha conservado la transcripción final anterior y la nota se ha escrito a partir de ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääntä ei voitu litteroida uudelleen: %@ Edellinen lopullinen litterointi säilytettiin, ja muistiinpano kirjoitettiin sen pohjalta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio n’a pas pu être retranscrit : %@ La transcription finale précédente a été conservée et la note a été rédigée à partir de celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere di nuovo l’audio: %@ La trascrizione finale precedente è stata mantenuta e la nota è stata scritta a partire da essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を再度文字起こしできませんでした：%@ 以前の最終文字起こしを保持し、それをもとにノートを作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 다시 텍스트로 변환할 수 없습니다: %@ 이전 최종 녹취록을 유지하고 이를 바탕으로 노트를 작성했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio kon niet opnieuw worden uitgeschreven: %@ Het vorige definitieve transcript is behouden en de notitie is daarop gebaseerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível transcrever o áudio de novo: %@ A transcrição final anterior foi mantida e a nota foi escrita a partir dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新转写音频：%@ 已保留之前的最终文字稿，并据此撰写了笔记。"
          }
        }
      }
    },
