          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa linkillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager avec un lien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi con link"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクで共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크로 공유"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel met link"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar com link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过链接共享"
          }
        }
      }
    },
    "Yapay zekâ asistanı erişimi başka bir cihazda kapatıldı; kopya silindi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Assistentenzugriff wurde auf einem anderen Gerät ausgeschaltet; die Kopie wurde gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant access was turned off on another device; the copy was deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de asistentes de IA se desactivó en otro dispositivo; se eliminó la copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyavustajien pääsy poistettiin käytöstä toisella laitteella; kopio poistettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès des assistants IA a été désactivé sur un autre appareil ; la copie a été supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso degli assistenti AI è stato disattivato su un altro dispositivo; la copia è stata eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントのアクセスが別のデバイスでオフにされました。コピーは削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 AI 어시스턴트 접근이 꺼졌습니다. 사본이 삭제되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang voor AI-assistenten is op een ander apparaat uitgezet; de kopie is verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de assistentes de IA foi desativado em outro dispositivo; a cópia foi apagada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手访问已在另一台设备上关闭；副本已删除。"
          }
        }
      }
    },
    "%@ artık toplantılarını okuyabilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann jetzt deine Meetings lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can now read your meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya puede leer tus reuniones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voi nyt lukea kokouksiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut maintenant lire vos réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora può leggere le tue riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が会議を読めるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 %@에서 회의를 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan nu je vergaderingen lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ agora pode ler suas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在可以读取你的会议了。"
          }
        }
      }
    },
    "Yapay zekâ asistanı erişimi şu an kullanılamıyor; biraz sonra yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Assistentenzugriff ist gerade nicht verfügbar; versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant access isn't available right now; try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de asistentes de IA no está disponible ahora; inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyavustajien pääsy ei ole juuri nyt käytettävissä; yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès des assistants IA n’est pas disponible pour le moment ; réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso degli assistenti AI non è disponibile in questo momento; riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントのアクセスは現在利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 AI 어시스턴트 접근을 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang voor AI-assistenten is nu niet beschikbaar; probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de assistentes de IA não está disponível agora; tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手访问目前不可用；请稍后再试。"
          }
        }
      }
    },
    "Yapay zekâ asistanı erişimi başka bir cihazda değişti; yeniden denenecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Assistentenzugriff wurde auf einem anderen Gerät geändert; es wird erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant access changed on another device; it will retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de asistentes de IA cambió en otro dispositivo; se volverá a intentar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyavustajien pääsy muuttui toisella laitteella; yritetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès des assistants IA a changé sur un autre appareil ; une nouvelle tentative sera faite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso degli assistenti AI è cambiato su un altro dispositivo; verrà ritentato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントのアクセスが別のデバイスで変更されました。再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 AI 어시스턴트 접근이 변경되었습니다. 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang voor AI-assistenten is op een ander apparaat gewijzigd; het wordt opnieuw geprobeerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de assistentes de IA mudou em outro dispositivo; uma nova tentativa será feita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手访问已在另一台设备上更改；将重试。"
          }
        }
      }
    },
    "Asistan kopyasının yeri doldu; eski toplantıları silerek yer açabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Assistentenkopie ist voll; lösche alte Meetings, um Platz zu schaffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant copy is full; delete old meetings to make room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia para asistentes está llena; elimina reuniones antiguas para liberar espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avustajakopio on täynnä; poista vanhoja kokouksia vapauttaaksesi tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie pour les assistants est pleine ; supprimez d’anciennes réunions pour libérer de la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia per gli assistenti è piena; elimina le riunioni vecchie per liberare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタント用コピーの容量がいっぱいです。古い会議を削除して空きを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트용 사본이 가득 찼습니다. 오래된 회의를 삭제해 공간을 확보하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistentkopie is vol; verwijder oude vergaderingen om ruimte te maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia para assistentes está cheia; apague reuniões antigas para liberar espaço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手副本已满；删除旧会议以腾出空间。"
          }
        }
      }
    },
    "Bir toplantının notu asistan kopyası için çok büyük; o toplantı atlandı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz eines Meetings ist zu groß für die Assistentenkopie; dieses Meeting wurde übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting's note is too large for the assistant copy; that meeting was skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota de una reunión es demasiado grande para la copia para asistentes; se omitió esa reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhden kokouksen muistiinpano on liian suuri avustajakopiolle; se kokous ohitettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note d’une réunion est trop volumineuse pour la copie pour les assistants ; cette réunion a été ignorée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota di una riunione è troppo grande per la copia per gli assistenti; quella riunione è stata saltata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ある会議のノートがアシスタント用コピーには大きすぎるため、その会議はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 회의의 노트가 어시스턴트용 사본에 비해 너무 커서 해당 회의를 건너뛰었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie van een vergadering is te groot voor de assistentkopie; die vergadering is overgeslagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota de uma reunião é grande demais para a cópia para assistentes; essa reunião foi ignorada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个会议的笔记对助手副本来说太大；已跳过该会议。"
          }
        }
      }
    },
    "Yapay zekâ asistanı erişimi için etkin abonelik ya da deneme gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Assistentenzugriff erfordert ein aktives Abonnement oder eine Testphase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant access needs an active subscription or trial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de asistentes de IA requiere una suscripción o una prueba activa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyavustajien pääsy edellyttää voimassa olevaa tilausta tai kokeilujaksoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès des assistants IA nécessite un abonnement ou un essai actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso degli assistenti AI richiede un abbonamento o una prova attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントのアクセスには、有効なサブスクリプションまたはトライアルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 어시스턴트 접근을 사용하려면 활성 구독 또는 무료 체험이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang voor AI-assistenten vereist een actief abonnement of een actieve proefperiode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de assistentes de IA exige uma assinatura ou um teste ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手访问需要有效的订阅或试用。"
          }
        }
      }
    },
