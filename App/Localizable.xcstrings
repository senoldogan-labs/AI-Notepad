    "Toplantı bitince not hazır, görevler en üstte": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notiz ist am Ende des Meetings fertig, Aufgaben oben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note is ready when the meeting ends, tasks on top"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota está lista al terminar la reunión, con las tareas arriba"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi on valmis, kun kokous päättyy, tehtävät ylimpänä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre note est prête à la fin de la réunion, avec les tâches en haut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota è pronta al termine della riunione, con le attività in cima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議が終わるとノートが完成。タスクは上部に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 끝나면 할 일이 맨 위에 정리된 노트가 준비됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notitie is klaar als de vergadering eindigt, taken bovenaan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua nota fica pronta quando a reunião termina, com as tarefas no topo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议结束时笔记就已准备好，任务在顶部"
          }
        }
      }
    },
    "Toplantı bitince not yazılır; içinde senin adına yazılan işler burada toplanır, tamamlayınca işaretlersin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Meeting wird die Notiz geschrieben; dir zugewiesene Aufgaben sammeln sich hier, und du hakst sie ab, wenn sie erledigt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a meeting the note is written; tasks assigned to you collect here, and you tick them off when done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una reunión se escribe la nota; las tareas que se te asignan se reúnen aquí y las marcas cuando las terminas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen jälkeen muistiinpano kirjoitetaan; sinulle annetut tehtävät kerääntyvät tänne, ja rastit ne, kun ne ovat valmiita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une réunion, la note est rédigée ; les tâches qui vous sont attribuées sont regroupées ici, et vous les cochez une fois terminées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una riunione viene scritta la nota; le attività assegnate a te si raccolgono qui e le spunti quando sono fatte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議のあとにノートが作成されます。あなたに割り当てられたタスクはここに集まり、完了したらチェックを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 끝나면 노트가 작성되고, 사용자에게 할당된 할 일이 여기에 모입니다. 완료하면 체크하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een vergadering wordt de notitie geschreven; taken die aan jou zijn toegewezen, worden hier verzameld en je vinkt ze af als ze klaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após uma reunião, a nota é escrita; as tarefas atribuídas a você se reúnem aqui, e você as marca quando concluir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议结束后会撰写笔记；分配给你的任务会汇集在这里，完成后你可以将其勾选。"
          }
        }
      }
    },
    "Toplantı bitince not yazılır; içinde senin adına yazılan işler burada toplanır.": {
      "localizations": {
