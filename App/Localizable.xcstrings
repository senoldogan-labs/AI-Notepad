    "Mail açılamadı: taslak e-posta bağlantısına çevrilemedi. \"Kopyala\" ile yapıştırabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail konnte nicht geöffnet werden: Der Entwurf konnte nicht in einen E-Mail-Link umgewandelt werden. Verwende stattdessen „Kopieren“ und füge ihn ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Mail: the draft couldn't be turned into an email link. Use \"Copy\" and paste it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir Mail: el borrador no se ha podido convertir en un enlace de correo. Usa “Copiar” y pégalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailia ei voitu avata: luonnosta ei voitu muuttaa sähköpostilinkiksi. Käytä sen sijaan ”Kopioi” ja liitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Mail : le brouillon n’a pas pu être converti en lien e-mail. Utilisez plutôt « Copier » et collez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Mail: non è stato possibile trasformare la bozza in un link email. Usa “Copia” e incollala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メール」を開けませんでした：下書きをメールリンクに変換できませんでした。代わりに「コピー」を使ってペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail을 열 수 없습니다: 초안을 이메일 링크로 변환할 수 없습니다. 대신 \"복사\"를 사용하여 붙여 넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan Mail niet openen: het concept kon niet in een e-maillink worden omgezet. Gebruik in plaats daarvan \"Kopieer\" en plak het."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Mail: o rascunho não pôde ser convertido em um link de e-mail. Use \"Copiar\" e cole-o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开“邮件”：无法将草稿转换为电子邮件链接。请改用“拷贝”并粘贴。"
          }
        }
      }
    },
    "Mail açılamadı: Mac'te ayarlı bir e-posta uygulaması yok. \"Kopyala\" ile yapıştırabilirsin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail konnte nicht geöffnet werden: Auf diesem Mac ist keine E-Mail-App eingerichtet. Verwende stattdessen „Kopieren“ und füge ihn ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Mail: no email app is set up on this Mac. Use \"Copy\" and paste it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir Mail: no hay ninguna app de correo configurada en este Mac. Usa “Copiar” y pégalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailia ei voitu avata: tähän Maciin ei ole määritetty sähköpostisovellusta. Käytä sen sijaan ”Kopioi” ja liitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Mail : aucune app de messagerie n’est configurée sur ce Mac. Utilisez plutôt « Copier » et collez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Mail: nessuna app email configurata su questo Mac. Usa “Copia” e incollala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メール」を開けませんでした：このMacにメールアプリが設定されていません。代わりに「コピー」を使ってペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail을 열 수 없습니다: 이 Mac에 설정된 이메일 앱이 없습니다. 대신 \"복사\"를 사용하여 붙여 넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan Mail niet openen: er is geen e-mailapp ingesteld op deze Mac. Gebruik in plaats daarvan \"Kopieer\" en plak het."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Mail: nenhum app de e-mail está configurado neste Mac. Use \"Copiar\" e cole-o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开“邮件”：这台 Mac 上未设置电子邮件 App。请改用“拷贝”并粘贴。"
          }
        }
      }
    },
    "Bu toplantının notu yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting hat keine Notiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting has no note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión no tiene nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kokouksella ei ole muistiinpanoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas de note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione non ha una nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議にはノートがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의에는 노트가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering heeft geen notitie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião não tem nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议没有笔记。"
          }
        }
      }
    },
    "Nottan kısa bir takip e-postası; göndermeden önce düzenle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Follow-up-E-Mail aus der Notiz; bearbeite sie vor dem Senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short follow-up email from the note; edit it before you send it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un breve correo de seguimiento a partir de la nota; edítalo antes de enviarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyhyt jatkosähköposti muistiinpanosta; muokkaa sitä ennen lähettämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un court e-mail de suivi à partir de la note ; modifiez-le avant de l’envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve email di follow-up dalla nota; modificala prima di inviarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートから作成した短いフォローアップメール。送信する前に編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 바탕으로 작성한 짧은 후속 이메일입니다. 보내기 전에 편집하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte follow-up-e-mail op basis van de notitie; pas hem aan voordat je hem verstuurt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um e-mail curto de acompanhamento a partir da nota; edite-o antes de enviar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据笔记撰写的简短跟进邮件；发送前请编辑。"
          }
        }
      }
    },
