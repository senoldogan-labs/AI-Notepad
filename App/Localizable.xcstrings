    "Yeni kayıt başlatılamaz. Bu, aylık adil kullanım sınırıdır ve %@ tarihinde sıfırlanır; notların ve toplantıların erişilebilir kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Aufnahmen können nicht starten. Das ist das monatliche Fair-Use-Limit; es wird am %@ zurückgesetzt. Deine Notizen und Meetings bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New recordings can't start. This is the monthly fair-use limit and it resets on %@; your notes and meetings stay available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden iniciar grabaciones nuevas. Es el límite mensual de uso razonable y se restablece el %@; tus notas y reuniones siguen disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusia nauhoituksia ei voi aloittaa. Tämä on kuukausittainen kohtuullisen käytön raja, ja se nollautuu %@; muistiinpanosi ja kokouksesi pysyvät käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer de nouveaux enregistrements. Il s’agit de la limite mensuelle d’utilisation raisonnable ; elle sera réinitialisée le %@. Vos notes et réunions restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile avviare nuove registrazioni. È il limite mensile di utilizzo equo e si azzera il %@; le note e le riunioni restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい録音を開始できません。これは月間のフェアユース上限で、%@にリセットされます。ノートと会議は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 녹음을 시작할 수 없습니다. 월간 공정 사용 한도에 도달했으며 %@에 재설정됩니다. 노트와 회의는 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe opnamen kunnen niet starten. Dit is de maandelijkse limiet voor redelijk gebruik en die wordt gereset op %@; je notities en vergaderingen blijven beschikbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível iniciar novas gravações. Este é o limite mensal de uso justo e ele é redefinido em %@; suas notas e reuniões continuam disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始新的录制。这是每月合理使用限额，将于 %@ 重置；你的笔记和会议仍可使用。"
          }
        }
      }
    },
