    "%@ oturumunun süresi doldu. Ayarlar › Bağlantılar'dan yeniden bağlan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung bei %@ ist abgelaufen. Verbinde dich erneut unter „Einstellungen“ › „Verbindungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ session expired. Connect again in Settings › Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de %@ ha caducado. Vuelve a conectarte en Ajustes › Conexiones."
