    "Kayıt sürüyor; bitince toplantı burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft; das Meeting erscheint hier, wenn sie endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording; the meeting appears here when it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando; la reunión aparecerá aquí cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitetaan; kokous näkyy tässä, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement en cours ; la réunion apparaîtra ici à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione in corso; la riunione appare qui al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中です。終了すると会議がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중입니다. 회의는 끝나면 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen; de vergadering verschijnt hier als ze is afgelopen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando; a reunião aparece aqui quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制；会议结束后会显示在这里。"
          }
        }
      }
    },
