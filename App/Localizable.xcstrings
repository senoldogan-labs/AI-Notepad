            "state": "translated",
            "value": "%@に接続できませんでした。インターネット接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. 인터넷 연결을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %@ niet bereiken; controleer je internetverbinding."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar %@; verifique sua conexão com a internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@；请检查你的互联网连接。"
          }
        }
      }
    },
    "%@ anahtarı kabul edilmedi. Ayarlar'dan anahtarı kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Schlüssel nicht akzeptiert. Prüfe den Schlüssel in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the key. Check the key in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha aceptado la clave. Revisa la clave en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei hyväksynyt avainta. Tarkista avain Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté la clé. Vérifiez la clé dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha accettato la chiave. Controlla la chiave in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がキーを受け付けませんでした。設定でキーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 키를 허용하지 않았습니다. 설정에서 키를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft de sleutel niet geaccepteerd. Controleer de sleutel in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceitou a chave. Verifique a chave em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受该密钥。请在设置中检查密钥。"
          }
        }
      }
    },
    "%@ anahtarı kayıtlı değil. Ayarlar'dan ekle.": {
