    "Bu davet kodu şu an yeni arkadaş kabul etmiyor; daha sonra yeniden dene ya da kodsuz abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Einladungscode kann gerade keine neuen Freunde aufnehmen. Versuche es später erneut oder schließe ohne Code ein Abo ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invite code can't take new friends right now. Try again later, or subscribe without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de invitación no admite amigos nuevos ahora mismo. Inténtalo más tarde o suscríbete sin él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kutsukoodilla ei voi juuri nyt kutsua uusia ystäviä. Yritä myöhemmin uudelleen tai tilaa ilman sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d’invitation ne peut pas accueillir de nouveaux amis pour le moment. Réessayez plus tard, ou abonnez-vous sans code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice invito non può accettare nuovi amici al momento. Riprova più tardi o abbonati senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待コードは現在新しい友だちを受け付けられません。あとでもう一度お試しいただくか、コードなしで登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초대 코드는 현재 새 친구를 받을 수 없습니다. 나중에 다시 시도하거나 코드 없이 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze uitnodigingscode kan nu geen nieuwe vrienden aannemen. Probeer het later opnieuw of neem een abonnement zonder code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de convite não pode receber novos amigos agora. Tente de novo mais tarde ou assine sem ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请码目前无法接纳新好友。请稍后再试，或不使用邀请码直接订阅。"
          }
        }
      }
    },
