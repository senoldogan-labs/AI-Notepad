    "%@ adresine ulaşılamadı; internet bağlantını kontrol et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht erreichbar; prüfe deine Internetverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %@; check your internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido acceder a %@; comprueba tu conexión a internet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palveluun %@ ei saatu yhteyttä; tarkista internetyhteys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@ ; vérifiez votre connexion Internet."
          }
