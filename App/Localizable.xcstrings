          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de áudio foram apagados; a transcrição e a nota continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频文件已删除；文字稿和笔记仍保留。"
          }
        }
      }
    },
    "Ses dosyası işlenemedi: %@. Disk alanını kontrol et.": {
