    "Anımsatıcılar'a erişim izni yok: iPhone Ayarları › Gizlilik ve Güvenlik › Anımsatıcılar'dan %@'e tam erişim ver.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Erinnerungen: Gib %@ in den iPhone-Einstellungen unter „Datenschutz & Sicherheit“ › „Erinnerungen“ vollen Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to Reminders: give %@ full access in iPhone Settings › Privacy & Security › Reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Recordatorios: concede acceso total a %@ en Ajustes del iPhone › Privacidad y seguridad › Recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei pääsyä Muistutuksiin: anna sovellukselle %@ täysi pääsy iPhonen kohdassa Asetukset › Tietosuoja ja suojaus › Muistutukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès aux Rappels : accordez à %@ l’accès complet dans Réglages de l’iPhone › Confidentialité et sécurité › Rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso a Promemoria: concedi accesso completo a %@ in Impostazioni di iPhone › Privacy e sicurezza › Promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーへのアクセス権がありません：iPhoneの「設定」›「プライバシーとセキュリティ」›「リマインダー」で%@にフルアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에 접근할 수 없습니다. iPhone 설정 › 개인정보 보호 및 보안 › 미리 알림에서 %@에 전체 접근 권한을 부여하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot Herinneringen: geef %@ volledige toegang in Instellingen › Privacy en beveiliging › Herinneringen op de iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso aos Lembretes: dê a %@ acesso total em Ajustes do iPhone › Privacidade e Segurança › Lembretes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权访问提醒事项：请在 iPhone“设置 › 隐私与安全性 › 提醒事项”中为 %@ 授予完全访问权限。"
          }
        }
      }
    },
