    "Unutulan kişi bundan sonra sesinden tanınmaz; toplantılarda verilmiş adı kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vergessene Person wird nicht mehr an der Stimme erkannt; der in Meetings vergebene Name bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgotten person is no longer recognized by voice; the name given in meetings stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona olvidada ya no se reconoce por la voz; el nombre asignado en las reuniones se mantiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unohdettua henkilöä ei enää tunnisteta äänestä; kokouksissa annettu nimi säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne oubliée n’est plus reconnue à sa voix ; le nom attribué dans les réunions est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona dimenticata non viene più riconosciuta dalla voce; il nome assegnato nelle riunioni resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "忘れた人は今後、声で認識されなくなります。会議で付けた名前は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지운 사람은 더 이상 음성으로 인식되지 않습니다. 회의에서 지정한 이름은 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vergeten persoon wordt niet meer aan de stem herkend; de naam die in vergaderingen is gegeven, blijft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa esquecida não é mais reconhecida pela voz; o nome dado nas reuniões continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被忘记的人将不再通过声音被识别；会议中设定的名字会保留。"
          }
        }
      }
    },
