            "state": "translated",
            "value": "El texto en directo se ha detenido: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikainen teksti pysähtyi: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte en direct s’est arrêté : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo dal vivo interrotto: %@"
          }
        },
        "ja": {
