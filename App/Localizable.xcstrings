    "Yapay zekâ ya da konuşma tanıma servisi isteği reddetti. Sorun sürerse bize yaz.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI- oder Spracherkennungsdienst hat die Anfrage abgelehnt. Falls das weiterhin passiert, kontaktiere uns."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI or speech recognition service rejected the request. If it keeps happening, contact us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de IA o de reconocimiento de voz ha rechazado la solicitud. Si sigue ocurriendo, ponte en contacto con nosotros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly- tai puheentunnistuspalvelu hylkäsi pyynnön. Jos tämä toistuu, ota meihin yhteyttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’IA ou de reconnaissance vocale a refusé la requête. Si le problème persiste, contactez-nous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio AI o di riconoscimento vocale ha rifiutato la richiesta. Se continua a succedere, contattaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIまたは音声認識サービスがリクエストを拒否しました。繰り返し発生する場合は、お問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 또는 음성 인식 서비스가 요청을 거부했습니다. 문제가 계속되면 문의하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI- of spraakherkenningsdienst heeft het verzoek geweigerd. Neem contact met ons op als het blijft gebeuren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de IA ou de reconhecimento de fala recusou a solicitação. Se continuar acontecendo, fale conosco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 或语音识别服务拒绝了该请求。如果问题持续，请联系我们。"
          }
        }
      }
    },
    "Yapay zekâ ya da konuşma tanıma servisi şu an yanıt vermiyor; biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI- oder Spracherkennungsdienst antwortet gerade nicht; versuche es etwas später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI or speech recognition service isn't responding right now; try again a bit later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de IA o de reconocimiento de voz no responde ahora mismo; inténtalo de nuevo un poco más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly- tai puheentunnistuspalvelu ei vastaa juuri nyt; yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’IA ou de reconnaissance vocale ne répond pas pour le moment ; réessayez un peu plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio AI o di riconoscimento vocale non risponde al momento; riprova un po’ più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIまたは音声認識サービスが現在応答していません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 또는 음성 인식 서비스가 현재 응답하지 않습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI- of spraakherkenningsdienst reageert nu niet; probeer het iets later opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de IA ou de reconhecimento de fala não está respondendo agora; tente de novo um pouco mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 或语音识别服务目前没有响应；请稍后再试。"
          }
        }
      }
    },
    "Yapay zekâ özellikleri bir toplantı sırasında ve bittikten kısa süre sonrasına kadar kullanılabilir; önce bir toplantı başlat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Funktionen sind während eines Meetings und kurz nach seinem Ende verfügbar; starte zuerst ein Meeting."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI features are available during a meeting and for a short time after it ends; start a meeting first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA están disponibles durante una reunión y poco tiempo después de que termine; empieza primero una reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyominaisuudet ovat käytettävissä kokouksen aikana ja hetken sen päättymisen jälkeen; aloita ensin kokous."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités d’IA sont disponibles pendant une réunion et peu de temps après sa fin ; démarrez d’abord une réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni AI sono disponibili durante una riunione e per poco tempo dopo la sua fine; avvia prima una riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI機能は会議中と、会議終了後の短い時間だけ利用できます。先に会議を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능은 회의 중과 회의 종료 후 잠시 동안 사용할 수 있습니다. 먼저 회의를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-functies zijn beschikbaar tijdens een vergadering en kort na afloop; start eerst een vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos de IA ficam disponíveis durante uma reunião e por pouco tempo depois que ela termina; comece uma reunião primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 功能可在会议期间以及会议结束后的短时间内使用；请先开始会议。"
          }
        }
      }
    },
    "Yapılandırma yazılamadı: %@. Klasör izinlerini kontrol et.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration konnte nicht geschrieben werden: %@. Prüfe die Ordnerberechtigungen."
          }
        },
        "en": {
          "stringUnit": {
