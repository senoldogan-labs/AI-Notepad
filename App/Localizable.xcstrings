          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 국가의 번호로는 아직 전화를 걸 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
