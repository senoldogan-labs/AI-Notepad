    "Silinen toplantılar %lld gün burada kalır, sonra kalıcı olarak silinir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Meetings bleiben %lld Tage hier und werden dann endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted meetings stay here for %lld days, then they're deleted permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones eliminadas se quedan aquí %lld días y luego se eliminan de forma permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetut kokoukset pysyvät täällä %lld päivää, minkä jälkeen ne poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions supprimées restent ici %lld jours, puis sont supprimées définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni eliminate restano qui per %lld giorni, poi vengono eliminate definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した会議はここに%lld日間保存され、その後完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 회의는 %lld일 동안 여기에 보관된 후 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde vergaderingen blijven hier %lld dagen staan en worden daarna permanent verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões apagadas ficam aqui por %lld dias e depois são apagadas permanentemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的会议会在这里保留 %lld 天，之后将被永久删除。"
          }
        }
      }
    },
