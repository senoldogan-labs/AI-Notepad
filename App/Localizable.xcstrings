    "Odadaki toplantıyı dinler; bitince notu yazar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört dem Meeting im Raum zu und schreibt die Notiz, wenn es endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens to the meeting in the room and writes the note when it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha la reunión en la sala y escribe la nota cuando termina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelee huoneen kokousta ja kirjoittaa muistiinpanon, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute la réunion dans la pièce et rédige la note à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta la riunione nella stanza e scrive la nota quando finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋の会議を聞き取り、終わるとノートを書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방 안의 회의를 듣고 끝나면 노트를 작성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luistert naar de vergadering in de ruimte en schrijft de notitie als die klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve a reunião na sala e escreve a nota quando termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聆听房间里的会议，结束后写好笔记。"
          }
        }
      }
    },
    "Takvim izni sorulur": {
      "localizations": {
        "de": {
