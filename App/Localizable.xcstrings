    "Son görüldü": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt gesehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto por última vez"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi nähty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vu pour la dernière fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto l’ultima volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終参加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 참석"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst gezien"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto por último"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近出现"
          }
        }
      }
    },
    "Son kaydının üzerinden bir hafta geçti; toplantı başlarken kayda başlaman yeterli.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Aufnahme ist eine Woche her; starte einfach die Aufnahme, wenn dein Meeting beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been a week since your last recording; just start recording when your meeting begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha pasado una semana desde tu última grabación; solo tienes que empezar a grabar cuando empiece la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisestä nauhoituksestasi on viikko; aloita vain nauhoitus, kun kokous alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernier enregistrement date d’une semaine ; lancez simplement l’enregistrement au début de votre réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È passata una settimana dalla tua ultima registrazione; avvia la registrazione quando inizia la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の録音から1週間が経ちました。会議が始まったら録音を開始するだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 녹음 후 일주일이 지났습니다. 회의가 시작되면 녹음만 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste opname is een week geleden; start gewoon de opname als je vergadering begint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já faz uma semana desde sua última gravação; basta começar a gravar quando a reunião começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距你上次录制已过去一周；会议开始时开始录制即可。"
          }
        }
      }
    },
    "Son kayıttan 7 gün sonra 10:00'da bir kez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal, um 10:00 sieben Tage nach der letzten Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once, at 10:00 seven days after your last recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez, a las 10:00 siete días después de la última grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerran, klo 10:00 seitsemän päivää viimeisestä nauhoituksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois, à 10:00 sept jours après le dernier enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta, alle 10:00 sette giorni dopo l’ultima registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の録音から7日後の10:00に一度だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 녹음 7일 후 10:00에 한 번."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer, om 10:00 zeven dagen na de laatste opname."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez, às 10:00 sete dias após a última gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次录制 7 天后的 10:00 提醒一次。"
          }
        }
      }
    },
    "Son kayıttan 7 gün sonra saat 10:00'da bir kez, bir sonraki toplantını kaydetmeyi hatırlatır; takvim açıksa o günün toplantısı yazar. Yeni bir kayıtla yeniden kurulur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal, um 10:00 sieben Tage nach deiner letzten Aufnahme, eine Erinnerung, dein nächstes Meeting aufzunehmen; ist der Kalender an, nennt sie das Meeting des Tages. Eine neue Aufnahme setzt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once, at 10:00 seven days after your last recording, a reminder to record your next meeting; with the calendar on, it names that day's meeting. A new recording resets it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola vez, a las 10:00 siete días después de tu última grabación, un recordatorio para grabar tu próxima reunión; con el calendario activado, indica la reunión de ese día. Una nueva grabación lo reinicia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerran, klo 10:00 seitsemän päivää viimeisestä nauhoituksesta, muistutus nauhoittaa seuraava kokous; jos kalenteri on käytössä, siinä mainitaan päivän kokous. Uusi nauhoitus nollaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule fois, à 10:00 sept jours après votre dernier enregistrement, un rappel pour enregistrer votre prochaine réunion ; si le calendrier est activé, il indique la réunion du jour. Un nouvel enregistrement le réinitialise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola volta, alle 10:00 sette giorni dopo l’ultima registrazione, un promemoria per registrare la prossima riunione; con il calendario attivo indica la riunione di quel giorno. Una nuova registrazione lo reimposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の録音から7日後の10:00に一度だけ、次の会議を録音するよう通知します。カレンダーがオンならその日の会議名も表示します。新しく録音するとリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 녹음 7일 후 10:00에 한 번, 다음 회의를 녹음하라고 알려 줍니다. 캘린더가 켜져 있으면 그날 회의를 함께 표시합니다. 새로 녹음하면 다시 설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer, om 10:00 zeven dagen na je laatste opname, een herinnering om je volgende vergadering op te nemen; staat de agenda aan, dan noemt hij de vergadering van die dag. Een nieuwe opname zet hem opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única vez, às 10:00 sete dias após sua última gravação, um lembrete para gravar sua próxima reunião; com o calendário ativado, ele mostra a reunião daquele dia. Uma nova gravação o reinicia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你上次录制 7 天后的 10:00 提醒一次，提醒你录制下一场会议；如果开启了日历，会写出当天的会议。新的录制会重新计时。"
          }
        }
      }
    },
    "Tamamlandı": {
      "localizations": {
        "de": {
          "stringUnit": {
