          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis proefperiode"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste grátis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用"
          }
        }
      }
    },
    "Ücretsiz deneme ilk toplantıyla başlar; önce bir toplantı başlat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Test beginnt mit deinem ersten Meeting; starte zuerst ein Meeting."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial starts with your first meeting; start a meeting first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita empieza con tu primera reunión; empieza primero una reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujaksosi alkaa ensimmäisestä kokouksestasi; aloita ensin kokous."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit commence avec votre première réunion ; démarrez d’abord une réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita inizia con la tua prima riunione; avvia prima una riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルは最初の会議から始まります。先に会議を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험은 첫 회의와 함께 시작됩니다. 먼저 회의를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis proefperiode begint bij je eerste vergadering; start eerst een vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis começa com sua primeira reunião; comece uma reunião primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用从第一个会议开始；请先开始一个会议。"
          }
        }
      }
    },
    "Ücretsiz deneme için bu Mac'in Apple doğrulaması gerekiyor; uygulamayı güncelleyip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den kostenlosen Test muss Apple diesen Mac verifizieren; aktualisiere die App und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial needs Apple to verify this Mac; update the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita necesita que Apple verifique este Mac; actualiza la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujakso edellyttää, että Apple varmentaa tämän Macin; päivitä sovellus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit nécessite qu’Apple vérifie ce Mac ; mettez à jour l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la prova gratuita Apple deve verificare questo Mac; aggiorna l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルには、AppleによるこのMacの確認が必要です。アプリをアップデートして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험을 사용하려면 Apple이 이 Mac을 확인해야 합니다. 앱을 업데이트하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de gratis proefperiode moet Apple deze Mac verifiëren; werk de app bij en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis precisa que a Apple verifique este Mac; atualize o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用需要 Apple 验证这台 Mac；请更新 App 后重试。"
          }
        }
      }
    },
    "Ücretsiz deneme için bu iPhone'un Apple doğrulaması gerekiyor; uygulamayı güncelleyip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den kostenlosen Test muss Apple dieses iPhone verifizieren; aktualisiere die App und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free trial needs Apple to verify this iPhone; update the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratuita necesita que Apple verifique este iPhone; actualiza la app e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujakso edellyttää, että Apple varmentaa tämän iPhonen; päivitä sovellus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai gratuit nécessite qu’Apple vérifie cet iPhone ; mettez à jour l’app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la prova gratuita Apple deve verificare questo iPhone; aggiorna l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルには、AppleによるこのiPhoneの確認が必要です。アプリをアップデートして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험을 사용하려면 Apple이 이 iPhone을 확인해야 합니다. 앱을 업데이트하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de gratis proefperiode moet Apple deze iPhone verifiëren; werk de app bij en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste grátis precisa que a Apple verifique este iPhone; atualize o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用需要 Apple 验证这部 iPhone；请更新 App 后重试。"
          }
        }
      }
    },
    "Ücretsiz deneme: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Test: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratuita: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilujakso: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit : %@."
          }
        },
        "it": {
