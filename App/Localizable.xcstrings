    "En üstte senin görevlerin; özet, kararlar, konuşmacılı transkript ve çalma.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben oben; Zusammenfassung, Entscheidungen, Transkript mit Sprechern und Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks on top; summary, decisions, speaker transcript and playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas arriba; resumen, decisiones, transcripción por interlocutor y reproducción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtäväsi ylimpänä; yhteenveto, päätökset, puhujittainen litterointi ja toisto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches en haut ; résumé, décisions, transcription par intervenant et lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività in cima; riepilogo, decisioni, trascrizione per interlocutore e riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのタスクが上部に。要約、決定事項、話者付きの文字起こし、再生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일이 맨 위에 표시되고, 요약, 결정 사항, 화자별 녹취록 및 재생이 이어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken bovenaan; samenvatting, besluiten, transcript per spreker en afspelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas no topo; resumo, decisões, transcrição por falante e reprodução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任务在顶部；摘要、决策、说话人文字稿和播放。"
          }
        }
      }
    },
