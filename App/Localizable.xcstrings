    "İnsan doğrulaması başarısız; giriş sayfasını yenileyip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung, ob du ein Mensch bist, ist fehlgeschlagen; lade die Anmeldeseite neu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Human verification failed; reload the sign-in page and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación humana ha fallado; vuelve a cargar la página de inicio de sesión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmiseksi varmennus epäonnistui; lataa kirjautumissivu uudelleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification humaine a échoué ; rechargez la page de connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica umana non riuscita; ricarica la pagina di accesso e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人間であることの確認に失敗しました。サインインページを再読み込みして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람 확인에 실패했습니다. 로그인 페이지를 새로 고친 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menselijke verificatie mislukt; laad de inlogpagina opnieuw en probeer het nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação humana falhou; recarregue a página de início de sessão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人机验证失败；请重新载入登录页面后重试。"
          }
        }
      }
    },
