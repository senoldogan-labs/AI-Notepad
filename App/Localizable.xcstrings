                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“我错过了什么？”会总结最近 %lld 分钟"
                }
              }
            }
          }
        }
      }
    },
    "\"Ne kaçırdım?\", soru ve toplantı notu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Was habe ich verpasst?“, Fragen und Meeting-Notizen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"What did I miss?\", questions and meeting notes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“¿Qué me he perdido?”, preguntas y notas de reunión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Mitä jäi välistä?”, kysymykset ja kokousmuistiinpanot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Qu’ai-je manqué ? », questions et notes de réunion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Cosa mi sono perso?”, domande e note delle riunioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「聞き逃したことは？」、質問、会議ノート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"무엇을 놓쳤나요?\", 질문 및 회의 노트"
          }
        },
        "nl": {
