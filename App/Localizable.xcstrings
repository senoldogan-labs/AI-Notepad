            "state": "translated",
            "value": "Choose shortcut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir atajo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse pikanäppäin"
          }
        },
        "fr": {
          "stringUnit": {
