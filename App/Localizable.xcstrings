    "Seçtiğin beceriler Sor'da \"/\" ile tarif olarak çalışır (ör. haftalık özet, takip e-postası).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Skills laufen in „Fragen“ mit „/“ als Rezepte (z. B. Wochenzusammenfassung, Follow-up-E-Mail)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skills you pick run as recipes in Ask with \"/\" (e.g. weekly summary, follow-up email)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las habilidades que elijas funcionan como recetas en Preguntar con “/” (p. ej., resumen semanal, correo de seguimiento)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemasi taidot toimivat Kysy-toiminnossa resepteinä ”/”-merkillä (esim. viikkoyhteenveto, jatkosähköposti)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences que vous choisissez s’exécutent comme des recettes dans Demander avec « / » (p. ex. résumé hebdomadaire, e-mail de suivi)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le skill che scegli funzionano come ricette in Chiedi con “/” (ad es. riepilogo settimanale, email di follow-up)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したスキルは、「質問」で「/」を使ってレシピとして実行できます（例：週次サマリー、フォローアップメール）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스킬은 질문하기에서 \"/\"로 레시피처럼 실행됩니다(예: 주간 요약, 후속 이메일)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De skills die je kiest, werken als recepten in Vraag met \"/\" (bijv. weekoverzicht, follow-up-e-mail)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As habilidades que você escolher funcionam como receitas em Perguntar com \"/\" (ex.: resumo semanal, e-mail de acompanhamento)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的技能可在“提问”中通过“/”作为预设运行（例如每周总结、跟进邮件）。"
          }
        }
      }
    },
    "Sorun bildirirken işe yarar; ses, metin, not ve anahtar yok, kopyalamadıkça hiçbir yere gitmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfreich beim Melden eines Problems; kein Audio, kein Text, keine Notizen oder Schlüssel, und nichts geht irgendwohin, außer du kopierst es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful when reporting a problem; no audio, text, notes or keys, and it goes nowhere unless you copy it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil al informar de un problema; sin audio, texto, notas ni claves, y no va a ningún sitio a menos que lo copies."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyödyllinen ongelmasta ilmoitettaessa; ei ääntä, tekstiä, muistiinpanoja tai avaimia, eikä se mene minnekään, ellet kopioi sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile pour signaler un problème ; aucun audio, texte, note ni clé, et rien ne part nulle part sauf si vous le copiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile per segnalare un problema; nessun audio, testo, nota o chiave, e non va da nessuna parte se non lo copi tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を報告するときに役立ちます。音声、テキスト、ノート、キーは含まれず、コピーしない限りどこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 보고할 때 유용합니다. 오디오, 텍스트, 노트 또는 키는 포함되지 않으며, 직접 복사하지 않는 한 어디에도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig bij het melden van een probleem; geen audio, tekst, notities of sleutels, en het gaat nergens heen tenzij je het kopieert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil para relatar um problema; sem áudio, texto, notas ou chaves, e não vai para lugar nenhum a menos que você copie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题时很有用；不含音频、文字、笔记或密钥，除非你拷贝，否则不会发送到任何地方。"
          }
        }
      }
    },
    "Toplantıların boyutu": {
      "localizations": {
        "de": {
