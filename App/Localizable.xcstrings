      }
    },
    "Ses cihaz içi konuşma tanımaya uygun biçime çevrilemedi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio konnte nicht in ein Format konvertiert werden, das die Spracherkennung auf dem Gerät akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't convert the audio to a format on-device speech recognition accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido convertir el audio a un formato que acepte el reconocimiento de voz en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
