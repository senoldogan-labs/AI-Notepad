            "state": "translated",
            "value": "此会议没有笔记"
          }
        }
      }
    },
    "Bu toplantının notu yok; önce notu oluştur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting hat keine Notiz; erstelle zuerst die Notiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting has no note; create the note first."
          }
        },
        "es": {
