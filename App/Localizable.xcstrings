            "value": "Napauta lyhyesti"
          }
        }
      }
    },
    "Kısa dokun, konuş; bitirmek için yeniden dokun ya da Esc'ye bas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once and speak; tap again or press Esc to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz tippen und sprechen; zum Beenden erneut tippen oder Esc drücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une fois et parlez ; touchez à nouveau ou appuyez sur Échap pour terminer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una vez y habla; toca de nuevo o pulsa Esc para terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una volta e parla; tocca di nuovo o premi Esc per terminare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque uma vez e fale; toque de novo ou pressione Esc para terminar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik één keer en praat; tik opnieuw of druk op Esc om te stoppen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度タップして話します。終了するにはもう一度タップするか Esc を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하고 말하세요. 끝내려면 다시 탭하거나 Esc를 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一次后说话;再次轻点或按 Esc 结束。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kerran ja puhu; lopeta napauttamalla uudelleen tai painamalla Esc."
          }
        }
      }
    },
    "Kısayol yok": {
