          }
        }
      }
    },
    "Not hazırlanınca bildirir; tıklayınca toplantı açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet sich, wenn eine Notiz fertig ist; ein Klick öffnet das Meeting."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you know when a note is ready; clicking opens the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa cuando una nota está lista; al hacer clic se abre la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoittaa, kun muistiinpano on valmis; napsautus avaa kokouksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévient quand une note est prête ; un clic ouvre la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa quando una nota è pronta; facendo clic si apre la riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートの準備ができたら知らせます。クリックで会議が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트가 준비되면 알려 줍니다. 클릭하면 회의가 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het weten als een notitie klaar is; klikken opent de vergadering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando uma nota fica pronta; clicar abre a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记准备好时通知你；点按即可打开会议。"
          }
        }
      }
    },
    "Ekran anlamlı değişince bir görüntü saklanır; birkaçı nota ve Sor'a gider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert sich der Bildschirm deutlich, wird ein Bild gespeichert; einige gehen an Notizen und Fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snapshot is kept when the screen changes meaningfully; a few go to notes and Ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda una captura cuando la pantalla cambia de verdad; algunas van a las notas y a Preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun näyttö muuttuu selvästi, kuva tallennetaan; muutama menee muistiinpanoihin ja Kysy-toimintoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture est gardée quand l'écran change vraiment ; quelques-unes vont aux notes et à Demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando lo schermo cambia davvero viene salvata un'istantanea; alcune vanno alle note e a Chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が大きく変わるとスナップショットを保存し、一部はノートと「質問」に使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 의미 있게 바뀌면 스냅샷을 저장하며, 일부는 노트와 '질문'에 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een duidelijke schermwijziging wordt een momentopname bewaard; enkele gaan naar notities en Vraag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura é guardada quando a tela muda de verdade; algumas vão para as notas e o Perguntar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有实质变化时保存一张截图；其中几张会用于笔记和“提问”。"
          }
        }
      }
    },
    "Ekran anlamlı değişince bir görüntü saklanır; yapay zekâya gönderilmez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert sich der Bildschirm deutlich, wird ein Bild gespeichert; nie an eine KI gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snapshot is kept when the screen changes meaningfully; never sent to AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda una captura cuando la pantalla cambia de verdad; nunca se envía a la IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun näyttö muuttuu selvästi, kuva tallennetaan; sitä ei lähetetä tekoälylle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture est gardée quand l'écran change vraiment ; jamais envoyée à l'IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando lo schermo cambia davvero viene salvata un'istantanea; mai inviata all'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が大きく変わるとスナップショットを保存します。AIには送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 의미 있게 바뀌면 스냅샷을 저장합니다. AI로 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een duidelijke schermwijziging wordt een momentopname bewaard; nooit naar AI gestuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura é guardada quando a tela muda de verdade; nunca é enviada à IA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕有实质变化时保存一张截图；不会发送给 AI。"
          }
        }
      }
    },
    "Notta ve Sor'da birkaç ekran görüntüsü Anthropic'e (Claude) gönderilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Notizen und Fragen werden einige Bildschirmbilder an Anthropic (Claude) gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few screen snapshots are sent to Anthropic (Claude) for notes and Ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas capturas de pantalla se envían a Anthropic (Claude) para las notas y Preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoja ja Kysy-toimintoa varten muutama näyttökuva lähetetään Anthropicille (Claude)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques captures d'écran sont envoyées à Anthropic (Claude) pour les notes et Demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune istantanee dello schermo vengono inviate ad Anthropic (Claude) per note e Chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートと「質問」のために、いくつかの画面スナップショットがAnthropic（Claude）に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트와 '질문'을 위해 일부 화면 스냅샷이 Anthropic(Claude)으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkele schermafbeeldingen worden voor notities en Vraag naar Anthropic (Claude) gestuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas capturas de tela são enviadas à Anthropic (Claude) para notas e Perguntar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为笔记和“提问”，会将几张屏幕截图发送给 Anthropic（Claude）。"
          }
        }
      }
    },
    "Notlar, çeviri ve Sor cevapları bu dilde yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, Übersetzung und Antworten von Fragen werden in dieser Sprache geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, translation and Ask answers are written in this language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas, la traducción y las respuestas de Preguntar se escriben en este idioma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot, käännös ja Kysy-vastaukset kirjoitetaan tällä kielellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes, la traduction et les réponses de Demander sont rédigées dans cette langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note, traduzione e risposte di Chiedi vengono scritte in questa lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート、翻訳、「質問」の回答はこの言語で書かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트, 번역, '질문' 답변이 이 언어로 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities, vertaling en antwoorden van Vraag worden in deze taal geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, tradução e respostas do Perguntar são escritas neste idioma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记、翻译和“提问”的回答都用这种语言撰写。"
          }
        }
      }
    },
    "Canlı metin bu dilde başlar; konuşulan dil sonra bulunur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Live-Transkript beginnt in dieser Sprache; die gesprochene Sprache wird danach erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live transcript starts in this language; the spoken language is detected afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en directo empieza en este idioma; el idioma hablado se detecta después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikainen litterointi alkaa tällä kielellä; puhuttu kieli tunnistetaan myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct commence dans cette langue ; la langue parlée est détectée ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione dal vivo inizia in questa lingua; la lingua parlata viene rilevata dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしはこの言語で始まり、話されている言語は後で検出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 녹취록은 이 언어로 시작하고, 말한 언어는 나중에 감지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het live transcript begint in deze taal; de gesproken taal wordt daarna herkend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ao vivo começa neste idioma; o idioma falado é detectado depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时文字稿以此语言开始；之后会检测实际所说的语言。"
          }
        }
      }
    },
    "Ad verdiğin kişi sonraki toplantılarda sesinden tanınır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen, denen du einen Namen gibst, werden in späteren Meetings an der Stimme erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you name are recognised by voice in later meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas a las que pones nombre se reconocen por la voz en reuniones posteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeämäsi henkilöt tunnistetaan äänestä myöhemmissä kokouksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes que tu nommes sont reconnues à la voix lors des réunions suivantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone a cui dai un nome vengono riconosciute dalla voce nelle riunioni successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を付けた人は、以降の会議で声から認識されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 붙인 사람은 이후 회의에서 목소리로 인식됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die je een naam geeft, worden in latere vergaderingen aan hun stem herkend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas que você nomeia são reconhecidas pela voz nas próximas reuniões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你命名的人会在之后的会议中通过声音被识别。"
          }
        }
      }
    },
    "Yaklaşan toplantılar Ana sayfada görünür; kayıt toplantıya bağlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstehende Meetings erscheinen unter Start; Aufnahmen werden dem Meeting zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming meetings appear on Home; recordings are linked to the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las próximas reuniones aparecen en Inicio; las grabaciones se vinculan a la reunión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevat kokoukset näkyvät Kodissa; tallenteet liitetään kokoukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions à venir apparaissent sur l'Accueil ; les enregistrements sont liés à la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prossime riunioni compaiono nella Home; le registrazioni vengono collegate alla riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の会議がホームに表示され、録音は会議に関連付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 회의가 홈에 표시되고 녹음은 회의에 연결됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komende vergaderingen verschijnen op Start; opnames worden aan de vergadering gekoppeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As próximas reuniões aparecem no Início; as gravações são vinculadas à reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将进行的会议显示在主页；录音会关联到该会议。"
          }
        }
      }
    },
    "Bir uygulama mikrofonu açınca dinlemeye başlamayı önerir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt das Zuhören vor, wenn eine App das Mikrofon einschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggests listening when an app turns on the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere empezar a escuchar cuando una app activa el micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdottaa kuuntelun aloittamista, kun sovellus avaa mikrofonin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose d'écouter quand une app active le micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Propone di iniziare l'ascolto quando un'app attiva il microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがマイクをオンにすると、聞き取りの開始を提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 마이크를 켜면 듣기를 시작하도록 제안합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt voor te gaan luisteren als een app de microfoon aanzet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere começar a ouvir quando um app liga o microfone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某个 App 打开麦克风时，建议开始收听。"
          }
        }
      }
    },
    "Görüşme bağlantılı toplantılar kendiliğinden kaydedilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings mit Anruflink werden automatisch aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings with a call link are recorded automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones con enlace de llamada se graban automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoukset, joissa on puhelulinkki, tallennetaan automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions avec un lien d'appel sont enregistrées automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni con un link di chiamata vengono registrate automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話リンクのある会議は自動で録音されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 링크가 있는 회의는 자동으로 녹음됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergaderingen met een gesprekslink worden automatisch opgenomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuniões com link de chamada são gravadas automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有通话链接的会议会自动录音。"
          }
        }
      }
    },
    "Kapalıyken yalnızca bilgisayardan gelen ses kaydedilir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, wird nur der Ton vom Computer aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only audio coming from the computer is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, solo se graba el audio que sale del ordenador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun asetus on pois, vain tietokoneesta tuleva ääni tallennetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, seul le son provenant de l'ordinateur est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, viene registrato solo l'audio proveniente dal computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは、コンピュータから出る音声だけが録音されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 컴퓨터에서 나오는 오디오만 녹음됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit uit staat, wordt alleen geluid van de computer opgenomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, só o áudio vindo do computador é gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，只录制来自电脑的音频。"
          }
        }
      }
    },
    "Görüşme bitip mikrofon boş kalınca kayıt kendiliğinden biter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme endet von selbst, wenn der Anruf vorbei ist und das Mikrofon frei wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording ends on its own when the call is over and the mic goes quiet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación termina sola cuando acaba la llamada y el micrófono queda libre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus päättyy itsestään, kun puhelu loppuu ja mikrofoni vapautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement s'arrête seul quand l'appel est fini et que le micro n'est plus utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione termina da sola quando la chiamata finisce e il microfono resta libero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話が終わってマイクが使われなくなると、録音は自動で終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화가 끝나고 마이크가 비면 녹음이 자동으로 끝납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname stopt vanzelf als het gesprek voorbij is en de microfoon vrij is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação termina sozinha quando a chamada acaba e o microfone fica livre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话结束、麦克风空闲后，录音会自动结束。"
          }
        }
      }
    },
