    "Salı önizlemeler kapalı yayın; bir hafta sonra açılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Dienstag mit ausgeschalteten Vorschauen veröffentlichen; eine Woche später einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ship on Tuesday with previews off; turn them on a week later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzar el martes con las vistas previas desactivadas; activarlas una semana después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaisu tiistaina esikatselut pois päältä; ne otetaan käyttöön viikkoa myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie mardi avec les aperçus désactivés ; activation une semaine plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascio martedì con le anteprime disattivate; attivarle una settimana dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "火曜日にプレビューをオフにしてリリースし、1週間後にオンにする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화요일에 미리보기를 끈 채 출시하고, 일주일 뒤에 켭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinsdag uitbrengen met voorbeelden uit; een week later aanzetten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lançar na terça com as prévias desativadas; ativá-las uma semana depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周二发布，预览保持关闭；一周后打开。"
          }
        }
      }
    },
