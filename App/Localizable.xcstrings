    "Kayıt hemen başlayabilir; canlı metin model hazır olunca gelir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jetzt mit der Aufnahme beginnen; das Live-Transkript erscheint, sobald das Modell bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start recording now; the live transcript appears once the model is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes empezar a grabar; la transcripción en directo aparecerá cuando el modelo esté listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit aloittaa nauhoituksen nyt; reaaliaikainen litterointi näkyy, kun malli on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez commencer à enregistrer maintenant ; la transcription en direct apparaîtra dès que le modèle sera prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi iniziare a registrare ora; la trascrizione dal vivo appare quando il modello è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ録音を開始できます。モデルの準備ができると、ライブ文字起こしが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 녹음을 시작할 수 있습니다. 모델이 준비되면 실시간 녹취록이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu beginnen met opnemen; het live transcript verschijnt zodra het model klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já pode começar a gravar; a transcrição ao vivo aparece quando o modelo estiver pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在就可以开始录制；模型准备好后会显示实时文字稿。"
          }
        }
      }
    },
    "Kayıt için önce giriş yap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zuerst an, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in first to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión primero para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu ensin sisään nauhoittaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d’abord pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi prima di registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するには、先にサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 먼저 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log eerst in om op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão primeiro para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录才能录制。"
          }
        }
      }
    },
    "Kayıt klasörü oluşturulamadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmeordner konnte nicht erstellt werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the recording folder: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido crear la carpeta de grabación: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoituskansiota ei voitu luoda: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le dossier d’enregistrement : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare la cartella della registrazione: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音フォルダを作成できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 폴더를 만들 수 없습니다: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de opnamemap niet aanmaken: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar a pasta de gravação: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建录制文件夹：%@"
          }
        }
      }
    },
    "Kayıt saatlerin %@ tarihinde sıfırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmestunden werden am %@ zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recording hours reset on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus horas de grabación se restablecen el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitustuntisi nollautuvat %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos heures d’enregistrement seront réinitialisées le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue ore di registrazione si azzerano il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音時間は%@にリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시간은 %@에 재설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opname-uren worden gereset op %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas horas de gravação são redefinidas em %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的录制时长将于 %@ 重置。"
          }
        }
      }
    },
    "Kayıt sekmesinden yüz yüze bir toplantıyı kaydet; Mac'teki toplantıların da iCloud eşitlemesiyle burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm im Tab „Aufnehmen“ ein Meeting vor Ort auf; mit iCloud-Synchronisierung erscheinen hier auch die Meetings deines Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record an in-person meeting from the Record tab; your Mac's meetings also appear here with iCloud sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una reunión presencial desde la pestaña Grabar; las reuniones de tu Mac también aparecen aquí con la sincronización de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita kasvokkainen kokous Nauhoita-välilehdeltä; Macisi kokoukset näkyvät täällä myös iCloud-synkronoinnin avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une réunion en présentiel depuis l’onglet Enregistrer ; les réunions de votre Mac apparaissent aussi ici avec la synchronisation iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una riunione di persona dalla scheda Registra; con la sincronizzazione iCloud anche le riunioni del Mac appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「録音」タブで対面の会議を録音できます。iCloud同期を使うと、Macの会議もここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 탭에서 대면 회의를 녹음하세요. iCloud 동기화를 사용하면 Mac의 회의도 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een fysieke vergadering op via het tabblad Opnemen; met iCloud-synchronisatie verschijnen de vergaderingen van je Mac hier ook."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião presencial na aba Gravar; as reuniões do seu Mac também aparecem aqui com a sincronização do iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“录制”标签页录制面对面会议；打开 iCloud 同步后，你 Mac 上的会议也会显示在这里。"
          }
        }
      }
    },
    "Kayıt sekmesinden yüz yüze bir toplantıyı kaydet; bitince notu, görevleri ve konuşmacılı metni burada.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm im Tab „Aufnehmen“ ein Meeting vor Ort auf; wenn es endet, findest du hier Notiz, Aufgaben und Transkript mit Sprechern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record an in-person meeting from the Record tab; when it ends, its note, tasks and speaker transcript are here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una reunión presencial desde la pestaña Grabar; cuando termine, aquí tendrás su nota, sus tareas y la transcripción por interlocutor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoita kasvokkainen kokous Nauhoita-välilehdeltä; kun se päättyy, sen muistiinpano, tehtävät ja puhujittainen litterointi ovat täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une réunion en présentiel depuis l’onglet Enregistrer ; à la fin, sa note, ses tâches et sa transcription par intervenant sont ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una riunione di persona dalla scheda Registra; al termine, qui trovi nota, attività e trascrizione per interlocutore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「録音」タブで対面の会議を録音できます。終了すると、ノート、タスク、話者付きの文字起こしがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 탭에서 대면 회의를 녹음하세요. 회의가 끝나면 노트, 할 일, 화자별 녹취록이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een fysieke vergadering op via het tabblad Opnemen; als die afgelopen is, staan de notitie, taken en het transcript per spreker hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião presencial na aba Gravar; quando ela terminar, a nota, as tarefas e a transcrição por falante estarão aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“录制”标签页录制面对面会议；会议结束后，其笔记、任务和说话人文字稿都在这里。"
          }
        }
      }
    },
    "Kayıt sürüyor — konuşmalar canlı panelde": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft – das Gespräch ist im Live-Panel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording — the conversation is in the live panel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando: la conversación está en el panel en directo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitetaan — keskustelu on live-paneelissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement — la conversation est dans le panneau en direct"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione: la conversazione è nel pannello dal vivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中 — 会話はライブパネルに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중 — 대화는 실시간 패널에 표시됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen — het gesprek staat in het livepaneel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando — a conversa está no painel ao vivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制——对话显示在实时面板中"
          }
        }
      }
    },
    "Kayıt sürüyor. Şimdi çıkarsan toplantı yarıda kalır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufnahme läuft. Wenn du jetzt beendest, wird das Meeting abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is in progress. If you quit now the meeting will be cut off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una grabación en curso. Si sales ahora, la reunión se cortará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus on käynnissä. Jos lopetat nyt, kokous katkeaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement est en cours. Si vous quittez maintenant, la réunion sera coupée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione in corso. Se esci ora, la riunione verrà interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中です。今終了すると、会議が途中で途切れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 진행 중입니다. 지금 종료하면 회의가 중간에 끊깁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt een opname. Als je nu stopt, wordt de vergadering afgebroken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma gravação em andamento. Se você sair agora, a reunião será cortada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制。如果现在退出，会议将被中断。"
          }
        }
      }
    },
    "Kayıt sırasında %@ diline çevir": {
      "localizations": {
        "de": {
          "stringUnit": {
