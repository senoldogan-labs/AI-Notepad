    "Bir toplantının transkriptinde konuşmacıya bu adı verince toplantıları burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einem Sprecher im Transkript eines Meetings diesen Namen, dann erscheinen seine Meetings hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a speaker this name in a meeting's transcript and their meetings appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da este nombre a un interlocutor en la transcripción de una reunión y sus reuniones aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna puhujalle tämä nimi kokouksen litteroinnissa, niin hänen kokouksensa näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez ce nom à un intervenant dans la transcription d’une réunion et ses réunions apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna questo nome a un interlocutore nella trascrizione di una riunione e le sue riunioni appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の文字起こしで話者にこの名前を付けると、その人の会議がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 녹취록에서 화자에게 이 이름을 지정하면 해당 화자의 회의가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een spreker deze naam in het transcript van een vergadering en diens vergaderingen verschijnen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê este nome a um falante na transcrição de uma reunião e as reuniões dele aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在会议文字稿中给说话人起这个名字，其会议就会显示在这里。"
          }
        }
      }
    },
