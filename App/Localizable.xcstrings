    },
    "Tarifler — @ ile toplantı seçersen yalnız ona uygulanır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezepte – markiere ein Meeting mit @, um es nur dort anzuwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes — tag a meeting with @ to apply it only there"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recetas: etiqueta una reunión con @ para aplicarla solo a ella"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reseptit — merkitse kokous @-merkillä, niin resepti koskee vain sitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recettes — taguez une réunion avec @ pour l’appliquer uniquement à celle-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricette: tagga una riunione con @ per applicarla solo lì"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピ — @で会議をタグ付けすると、その会議にのみ適用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피 — 특정 회의에만 적용하려면 @로 회의를 태그하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recepten — tag een vergadering met @ om het alleen daar toe te passen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receitas — marque uma reunião com @ para aplicá-la só nela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设——用 @ 标记会议，可仅应用于该会议"
          }
        }
      }
    },
