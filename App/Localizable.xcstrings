    "Diğer cihazdaki işaretler okunamadı, not onlarsız kaydedildi: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierungen vom anderen Gerät konnten nicht gelesen werden; die Notiz wurde ohne sie gesichert: %@"
