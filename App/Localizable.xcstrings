    "Hızlı model ve düşük effort önerilir: çeviri 1–2 sn'de gelir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schnelles Modell und niedriger Aufwand werden empfohlen: Übersetzungen kommen in 1–2 s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fast model and low effort are recommended: translations arrive in 1–2 s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomiendan un modelo rápido y esfuerzo bajo: la traducción llega en 1–2 s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeaa mallia ja matalaa työmäärää suositellaan: käännös tulee 1–2 sekunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle rapide et un effort faible sont recommandés : la traduction arrive en 1 à 2 s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si consigliano un modello veloce e uno sforzo basso: la traduzione arriva in 1–2 s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速モデルと低いEffortを推奨します。翻訳は1〜2秒で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 모델과 낮은 추론 강도를 권장합니다. 번역이 1~2초 안에 도착합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snel model en lage inspanning worden aanbevolen: vertalingen komen binnen 1–2 s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomenda-se um modelo rápido e esforço baixo: a tradução chega em 1–2 s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议使用快速模型和低推理强度：翻译 1–2 秒内送达。"
          }
        }
      }
    },
