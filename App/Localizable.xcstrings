            "value": "Vrienden aangemeld: %lld · Maanden verdiend: %lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amigos que entraram: %lld · Meses ganhos: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入的好友：%lld · 已获得的月数：%lld"
          }
        }
      }
    },
    "3 toplantı ya da ilk toplantından itibaren 7 gün ücretsiz; anahtar gerekmez. Sonrası aylık ya da yıllık abonelikle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis für 3 Meetings oder 7 Tage ab deinem ersten Meeting, keine Schlüssel nötig. Danach ein Monats- oder Jahresabo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for 3 meetings or 7 days from your first meeting, no keys needed. After that, a monthly or yearly subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante 3 reuniones o 7 días desde tu primera reunión, sin necesidad de claves. Después, una suscripción mensual o anual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen 3 kokouksen tai 7 päivän ajan ensimmäisestä kokouksestasi, avaimia ei tarvita. Sen jälkeen kuukausi- tai vuositilaus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour 3 réunions ou 7 jours à partir de votre première réunion, sans clé. Ensuite, un abonnement mensuel ou annuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per 3 riunioni o 7 giorni dalla tua prima riunione, senza chiavi. Poi un abbonamento mensile o annuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の会議から3件の会議または7日間無料、キーは不要です。その後は月額または年額のサブスクリプションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 회의부터 3회 또는 7일 동안 무료이며 키가 필요 없습니다. 이후에는 월간 또는 연간 구독이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis voor 3 vergaderingen of 7 dagen vanaf je eerste vergadering, geen sleutels nodig. Daarna een maand- of jaarabonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por 3 reuniões ou 7 dias a partir da sua primeira reunião, sem precisar de chaves. Depois disso, uma assinatura mensal ou anual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从第一个会议起，3 个会议或 7 天内免费，无需密钥。之后为月度或年度订阅。"
          }
        }
      }
    },
    "Cihaz içi konuşma tanıma macOS 26 gerektirir.": {
