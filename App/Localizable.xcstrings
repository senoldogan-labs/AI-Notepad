          }
        }
      }
    },
    "Kayıt sırasında çeviri yapılmaz, yalnızca orijinal metin görünür. Toplantı bitince %@ not (görevler, kararlar, özet) yine hazırlanır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Aufnahme wird nichts übersetzt; nur der Originaltext wird angezeigt. Nach dem Meeting wird trotzdem eine Notiz auf %@ (Aufgaben, Entscheidungen, Zusammenfassung) erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is translated while recording; only the original text is shown. A note in %@ (tasks, decisions, summary) is still prepared after the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se traduce nada durante la grabación; solo se muestra el texto original. Aun así, tras la reunión se prepara una nota en %@ (tareas, decisiones, resumen)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoituksen aikana mitään ei käännetä; vain alkuperäinen teksti näytetään. Muistiinpano kielellä %@ (tehtävät, päätökset, yhteenveto) laaditaan silti kokouksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est traduit pendant l’enregistrement ; seul le texte original est affiché. Une note en %@ (tâches, décisions, résumé) est tout de même préparée après la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la registrazione non viene tradotto nulla; viene mostrato solo il testo originale. Dopo la riunione viene comunque preparata una nota in %@ (attività, decisioni, riepilogo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中は何も翻訳されず、元のテキストのみが表示されます。会議後には%@のノート（タスク、決定事項、要約）が引き続き作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에는 아무것도 번역되지 않고 원문만 표시됩니다. 회의가 끝난 후에는 %@ 노트(할 일, 결정 사항, 요약)가 그대로 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het opnemen wordt niets vertaald; alleen de originele tekst wordt getoond. Na de vergadering wordt toch een notitie in het %@ (taken, besluiten, samenvatting) gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é traduzido durante a gravação; só o texto original é exibido. Uma nota em %@ (tarefas, decisões, resumo) ainda é preparada após a reunião."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时不进行翻译；只显示原文。会议结束后仍会准备一份%@笔记（任务、决策、摘要）。"
          }
        }
      }
    },
    "Kayıt ve işleme bitince uygulama yeniden açılıp güncellenecek.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet neu und wird aktualisiert, wenn Aufnahme und Verarbeitung abgeschlossen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will restart and update when recording and processing finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se reiniciará y se actualizará cuando terminen la grabación y el procesamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus käynnistyy uudelleen ja päivittyy, kun nauhoitus ja käsittely päättyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app redémarrera et se mettra à jour une fois l’enregistrement et le traitement terminés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app si riavvierà e si aggiornerà al termine di registrazione ed elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音と処理が完了すると、アプリが再起動してアップデートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음과 처리가 끝나면 앱이 재시작되고 업데이트됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app herstart en werkt bij als opnemen en verwerken klaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app vai reiniciar e atualizar quando a gravação e o processamento terminarem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制和处理完成后，App 将重新启动并更新。"
          }
        }
      }
    },
    "Kayıt ve işleme bitince yeniden başlatılabilir": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst neu starten, sobald Aufnahme und Verarbeitung abgeschlossen sind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restart once recording and processing finish"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás reiniciar cuando terminen la grabación y el procesamiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit käynnistää uudelleen, kun nauhoitus ja käsittely päättyvät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez redémarrer une fois l’enregistrement et le traitement terminés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi riavviare al termine di registrazione ed elaborazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音と処理が完了すると再起動できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음과 처리가 끝나면 재시작할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt herstarten zodra opnemen en verwerken klaar zijn"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode reiniciar quando a gravação e o processamento terminarem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制和处理完成后即可重新启动"
          }
        }
      }
    },
    "Kayıt ya da işleme sürerken yeniden başlatılmaz; bitince güncelleyebilirsin. Çıkışta da kendiliğinden kurulur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet während einer Aufnahme oder Verarbeitung nicht neu; du kannst aktualisieren, wenn sie abgeschlossen ist. Das Update wird außerdem beim Beenden automatisch installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app won't restart while recording or processing; you can update when it's done. It also installs on its own when you quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se reiniciará mientras haya una grabación o un procesamiento en curso; podrás actualizar cuando termine. También se instala sola al salir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei käynnisty uudelleen nauhoituksen tai käsittelyn aikana; voit päivittää, kun se on valmis. Päivitys asentuu myös itsestään, kun lopetat sovelluksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne redémarre pas pendant un enregistrement ou un traitement ; vous pourrez mettre à jour une fois terminé. La mise à jour s’installe aussi d’elle-même quand vous quittez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non si riavvia durante la registrazione o l’elaborazione; puoi aggiornare al termine. L’aggiornamento si installa anche da solo quando esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中や処理中はアプリは再起動しません。完了したらアップデートできます。終了時にも自動的にインストールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 처리 중에는 앱이 재시작되지 않습니다. 완료되면 업데이트할 수 있습니다. 앱을 종료하면 자동으로 설치되기도 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app herstart niet tijdens het opnemen of verwerken; je kunt bijwerken als dat klaar is. De update wordt ook vanzelf geïnstalleerd als je stopt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não reinicia durante a gravação ou o processamento; você pode atualizar quando terminar. A atualização também é instalada sozinha quando você sai do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或处理期间 App 不会重新启动；完成后即可更新。退出 App 时也会自动安装更新。"
          }
        }
      }
    },
    "Kayıt ya da işleme sürüyor; bitince hesabı silebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufnahme oder Verarbeitung läuft; du kannst den Account löschen, wenn sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recording or processing is in progress; you can delete the account when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una grabación o un procesamiento en curso; podrás eliminar la cuenta cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus tai käsittely on käynnissä; voit poistaa tilin, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement ou un traitement est en cours ; vous pourrez supprimer le compte une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso una registrazione o un’elaborazione; potrai eliminare l’account al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音または処理が進行中です。完了するとアカウントを削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 처리가 진행 중입니다. 완료되면 계정을 삭제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt een opname of verwerking; je kunt het account verwijderen als die klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma gravação ou um processamento em andamento; você pode apagar a conta quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制或处理；完成后即可删除账户。"
          }
        }
      }
    },
    "Kayıt ya da işleme sürüyor; bitince çıkış yapabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufnahme oder Verarbeitung läuft; du kannst dich abmelden, wenn sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recording or processing is in progress; you can sign out when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una grabación o un procesamiento en curso; podrás cerrar sesión cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus tai käsittely on käynnissä; voit kirjautua ulos, kun se päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement ou un traitement est en cours ; vous pourrez vous déconnecter une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso una registrazione o un’elaborazione; potrai uscire dall’account al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音または処理が進行中です。完了するとサインアウトできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 처리가 진행 중입니다. 완료되면 로그아웃할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt een opname of verwerking; je kunt uitloggen als die klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma gravação ou um processamento em andamento; você pode encerrar a sessão quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制或处理；完成后即可退出登录。"
          }
        }
      }
    },
    "Kayıt yapıyorsun: katılımcılara haber ver.": {
