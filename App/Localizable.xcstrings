            "value": "No se ha podido abrir la reunión de ejemplo: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkkikokouksen avaaminen epäonnistui: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir la réunion d’exemple : %@"
          }
        },
        "it": {
