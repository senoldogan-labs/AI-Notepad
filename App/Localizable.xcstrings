    "Ekran görüntüleri kaydedilemedi, bu kayıtta durduruldu. Disk alanını kontrol et; kayıt sürüyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos konnten nicht gesichert werden und wurden für diese Aufnahme gestoppt. Prüfe deinen Speicherplatz; die Aufnahme läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen snapshots couldn't be saved and are stopped for this recording. Check your disk space; recording continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar las capturas de pantalla y se han detenido para esta grabación. Revisa el espacio en disco; la grabación continúa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttökuvia ei voitu tallentaa, ja ne on pysäytetty tämän nauhoituksen ajaksi. Tarkista levytila; nauhoitus jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran n’ont pas pu être enregistrées et sont arrêtées pour cet enregistrement. Vérifiez l’espace disque ; l’enregistrement continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le istantanee dello schermo, che sono state interrotte per questa registrazione. Controlla lo spazio su disco; la registrazione continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面スナップショットを保存できなかったため、この録音では停止しました。ディスクの空き容量を確認してください。録音は続行中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 스냅샷을 저장할 수 없어 이 녹음에서는 중지되었습니다. 디스크 공간을 확인하세요. 녹음은 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen konden niet worden bewaard en zijn voor deze opname gestopt. Controleer je schijfruimte; de opname gaat door."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as capturas de tela, e elas foram interrompidas nesta gravação. Verifique o espaço em disco; a gravação continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储屏幕快照，已在本次录制中停止。请检查磁盘空间；录制会继续。"
          }
        }
      }
    },
