            "value": "이 iPhone의 통화 녹음(실험적)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprek op deze iPhone opnemen (experimenteel)"
          }
        },
        "pt-BR": {
