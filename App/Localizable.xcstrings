    "ChatGPT'de Ayarlar › Uygulamalar ve Bağlayıcılar › Gelişmiş ayarlar'da geliştirici modunu aç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in ChatGPT „Settings › Apps & Connectors › Advanced settings“ und schalte den Entwicklermodus („developer mode“) ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In ChatGPT, open Settings › Apps & Connectors › Advanced settings and turn on developer mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ChatGPT, abre \"Settings › Apps & Connectors › Advanced settings\" y activa el modo de desarrollador (\"developer mode\")."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ChatGPT:ssä \"Settings › Apps & Connectors › Advanced settings\" ja ota kehittäjätila (\"developer mode\") käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ChatGPT, ouvrez « Settings › Apps & Connectors › Advanced settings » et activez le mode développeur (« developer mode »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ChatGPT, apri “Settings › Apps & Connectors › Advanced settings” e attiva la modalità sviluppatore (“developer mode”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTで「Settings › Apps & Connectors › Advanced settings」を開き、開発者モード（「developer mode」）をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT에서 \"Settings › Apps & Connectors › Advanced settings\"를 열고 개발자 모드(\"developer mode\")를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in ChatGPT \"Settings › Apps & Connectors › Advanced settings\" en zet de ontwikkelaarsmodus (\"developer mode\") aan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No ChatGPT, abra \"Settings › Apps & Connectors › Advanced settings\" e ative o modo de desenvolvedor (\"developer mode\")."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ChatGPT 中打开“Settings › Apps & Connectors › Advanced settings”，然后开启开发者模式（“developer mode”）。"
          }
        }
      }
    },
    "\"Oluştur\"a bas, ad olarak %@ yaz, adresi yapıştır ve kimlik doğrulamada OAuth'u seç.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Create“, nenne ihn %@, füge die Adresse ein und wähle OAuth als Authentifizierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Create\", name it %@, paste the address and pick OAuth for authentication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige \"Create\", ponle el nombre %@, pega la dirección y elige OAuth para la autenticación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse \"Create\", anna nimeksi %@, liitä osoite ja valitse todennukseksi OAuth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Create », nommez-le %@, collez l’adresse et choisissez OAuth pour l’authentification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli “Create”, chiamalo %@, incolla l’indirizzo e scegli OAuth per l’autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Create」を選び、名前を%@にし、アドレスを貼り付けて、認証にOAuthを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Create\"를 선택하고 이름을 %@(으)로 입력한 다음 주소를 붙여넣고 인증 방식으로 OAuth를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies \"Create\", noem hem %@, plak het adres en kies OAuth voor authenticatie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha \"Create\", dê o nome %@, cole o endereço e escolha OAuth para a autenticação."
          }
        },
        "zh-Hans": {
