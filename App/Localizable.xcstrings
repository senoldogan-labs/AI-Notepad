    "Bu toplantılar asistanlara açık değil. Toplantı değişince kendiliğinden yeniden denenir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten können diese Meetings nicht lesen. Sie werden automatisch erneut versucht, wenn sich ein Meeting ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistants can't read these meetings. They're retried on their own when a meeting changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los asistentes no pueden leer estas reuniones. Se reintentan solas cuando una reunión cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avustajat eivät voi lukea näitä kokouksia. Niitä yritetään uudelleen itsestään, kun kokous muuttuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assistants ne peuvent pas lire ces réunions. Elles sont renvoyées automatiquement quand une réunion change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli assistenti non possono leggere queste riunioni. Vengono ritentate da sole quando una riunione cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはこれらのミーティングを読めません。ミーティングが変わると自動で再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트는 이 회의를 읽을 수 없습니다. 회의가 바뀌면 자동으로 다시 시도됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten kunnen deze meetings niet lezen. Ze worden vanzelf opnieuw geprobeerd als een meeting verandert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os assistentes não podem ler estas reuniões. Elas são tentadas de novo sozinhas quando uma reunião muda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手无法读取这些会议。会议更改后会自动重试。"
          }
        }
      }
    },
