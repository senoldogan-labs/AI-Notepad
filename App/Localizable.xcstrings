    "Aboneliğin %@ tarihinde sona erdi. Toplantıların ve notların bu Mac'te; yeni kayıt için yeniden abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist am %@ abgelaufen. Deine Meetings und Notizen bleiben auf diesem Mac; schließe erneut ein Abo ab, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription ended on %@. Your meetings and notes stay on this Mac; subscribe again to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción finalizó el %@. Tus reuniones y notas se quedan en este Mac; vuelve a suscribirte para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi päättyi %@. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa; tilaa uudelleen, niin voit nauhoittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a pris fin le %@. Vos réunions et notes restent sur ce Mac ; abonnez-vous de nouveau pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è terminato il %@. Le riunioni e le note restano su questo Mac; abbonati di nuovo per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは%@に終了しました。会議とノートはこのMacに残ります。録音するには再度登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 %@에 종료되었습니다. 회의와 노트는 이 Mac에 그대로 남아 있습니다. 녹음하려면 다시 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is beëindigd op %@. Je vergaderingen en notities blijven op deze Mac; abonneer opnieuw om op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou em %@. Suas reuniões e notas continuam neste Mac; assine de novo para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已于 %@ 结束。你的会议和笔记保留在这台 Mac 上；重新订阅即可录制。"
          }
        }
      }
    },
