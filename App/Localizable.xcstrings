    "Sunucuya ulaşılamıyor ve son bilinen hesap durumun çevrimdışı kayda izin vermiyor (7 günden eski ya da kayıt hakkın kalmamış). Kayıt için internete bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar, und dein letzter bekannter Account-Status erlaubt keine Offline-Aufnahme (er ist älter als 7 Tage oder du hast kein Aufnahmekontingent mehr). Stelle eine Internetverbindung her, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the server, and your last known account status doesn't allow offline recording (it's older than 7 days or you have no recording allowance left). Connect to the internet to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servidor y el último estado conocido de tu cuenta no permite grabar sin conexión (tiene más de 7 días o no te queda tiempo de grabación). Conéctate a internet para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimeen ei saada yhteyttä, eikä viimeisin tunnettu tilisi tila salli offline-nauhoitusta (se on yli 7 päivää vanha tai nauhoitusaikaa ei ole jäljellä). Muodosta internetyhteys nauhoittaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur, et le dernier état connu de votre compte ne permet pas l’enregistrement hors ligne (il date de plus de 7 jours ou il ne vous reste plus de temps d’enregistrement). Connectez-vous à Internet pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server, e l’ultimo stato noto del tuo account non consente la registrazione offline (risale a più di 7 giorni fa o non hai più ore di registrazione). Connettiti a internet per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できず、最後に確認したアカウントの状況ではオフラインでの録音が許可されていません（7日以上前のものか、録音の利用枠が残っていません）。録音するにはインターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없으며, 마지막으로 확인된 계정 상태로는 오프라인 녹음을 할 수 없습니다(7일이 지났거나 남은 녹음 허용량이 없음). 녹음하려면 인터넷에 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de server niet bereiken en je laatst bekende accountstatus staat offline opnemen niet toe (die is ouder dan 7 dagen of je hebt geen opnametegoed meer). Maak verbinding met internet om op te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o servidor, e o último estado conhecido da sua conta não permite gravar offline (tem mais de 7 dias ou você não tem mais cota de gravação). Conecte-se à internet para gravar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器，并且你最后已知的账户状态不允许离线录制（超过 7 天或你已没有剩余的录制额度）。请连接互联网以录制。"
          }
        }
      }
    },
    "Cihaz içi model bu toplantının dilini desteklemiyor (ör. Fince); Ayarlar'da kendi anahtarınla bir sağlayıcı seçip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell auf dem Gerät unterstützt die Sprache dieses Meetings nicht (z. B. Finnisch). Wähle in den Einstellungen einen Anbieter mit eigenem Schlüssel und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model doesn't support this meeting's language (e.g. Finnish). Choose a provider with your own key in Settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo en el dispositivo no admite el idioma de esta reunión (p. ej., finés). Elige un proveedor con tu propia clave en Ajustes e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteella toimiva malli ei tue tämän kokouksen kieltä (esim. suomea). Valitse Asetuksissa palveluntarjoaja omalla avaimellasi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sur l’appareil ne prend pas en charge la langue de cette réunion (p. ex. le finnois). Choisissez un fournisseur avec votre propre clé dans les Réglages et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sul dispositivo non supporta la lingua di questa riunione (ad es. finlandese). Scegli un fornitore con la tua chiave in Impostazioni e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルはこの会議の言語（例：フィンランド語）に対応していません。設定で独自のキーを使うプロバイダを選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 모델은 이 회의의 언어(예: 핀란드어)를 지원하지 않습니다. 설정에서 자신의 키를 사용하는 제공업체를 선택한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model op het apparaat ondersteunt de taal van deze vergadering niet (bijv. Fins). Kies in Instellingen een aanbieder met je eigen sleutel en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo no dispositivo não é compatível com o idioma desta reunião (ex.: finlandês). Escolha um provedor com sua própria chave em Ajustes e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型不支持此会议的语言（例如芬兰语）。请在设置中选择使用你自己密钥的提供商后重试。"
          }
        }
      }
    },
    "Cihaz içi model %@ desteklemiyor; Ayarlar'da kendi anahtarınla bir model seç (Mac'te anahtarsız Ollama da olur) ve yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell auf dem Gerät unterstützt %@ nicht. Wähle in den Einstellungen ein Modell mit eigenem Schlüssel (auf einem Mac geht Ollama ohne Schlüssel) und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model doesn't support %@. Choose a model with your own key in Settings (on a Mac, Ollama works without a key) and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo en el dispositivo no admite el %@. Elige un modelo con tu propia clave en Ajustes (en un Mac, Ollama funciona sin clave) e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteella toimiva malli ei tue kieltä %@. Valitse Asetuksissa malli omalla avaimellasi (Macissa Ollama toimii ilman avainta) ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sur l’appareil ne prend pas en charge le %@. Choisissez un modèle avec votre propre clé dans les Réglages (sur un Mac, Ollama fonctionne sans clé) et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sul dispositivo non supporta %@. Scegli un modello con la tua chiave in Impostazioni (su Mac, Ollama funziona senza chiave) e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは%@に対応していません。設定で独自のキーを使うモデルを選択して（MacではOllamaならキーなしで動作します）、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 모델은 %@을(를) 지원하지 않습니다. 설정에서 자신의 키를 사용하는 모델을 선택한 후 다시 시도하세요(Mac에서는 Ollama를 키 없이 사용할 수 있음)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model op het apparaat ondersteunt %@ niet. Kies in Instellingen een model met je eigen sleutel (op een Mac werkt Ollama zonder sleutel) en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo no dispositivo não é compatível com %@. Escolha um modelo com sua própria chave em Ajustes (no Mac, o Ollama funciona sem chave) e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型不支持%@。请在设置中选择使用你自己密钥的模型（在 Mac 上，Ollama 无需密钥）后重试。"
          }
        }
      }
    },
