          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het klaar is, opent de vergaderpagina met je taken bovenaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
