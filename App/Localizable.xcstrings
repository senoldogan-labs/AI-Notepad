    "Seçili dildeki not henüz hazır değil; bağlantı notu asıl diliyle paylaşır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz in der gewählten Sprache ist noch nicht fertig; der Link teilt die Notiz in ihrer Originalsprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note in the selected language isn't ready yet; the link shares the note in its original language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
