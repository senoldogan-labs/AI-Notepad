    "%@ şu an yanıt veremedi. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte gerade nicht antworten. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't respond right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha podido responder ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei voinut vastata juuri nyt. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu répondre pour le moment. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può rispondere in questo momento. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は現在応答できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 지금은 응답할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kon nu niet reageren. Probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não conseguiu responder agora. Tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暂时无法响应。请稍后再试。"
          }
        }
      }
    },
