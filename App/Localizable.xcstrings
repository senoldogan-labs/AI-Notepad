    "Ses dosyaları silindi; metin ve not duruyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiodateien wurden gelöscht; Transkript und Notiz bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio files were deleted; the transcript and note remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado los archivos de audio; la transcripción y la nota se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitiedostot poistettiin; litterointi ja muistiinpano säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers audio ont été supprimés ; la transcription et la note sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file audio sono stati eliminati; trascrizione e nota restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルは削除されました。文字起こしとノートは残っています。"
