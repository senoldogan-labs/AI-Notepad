    "Onun ilk ödemesinden %lld gün sonra sana da bir ay bedava: sonraki ödemenden %@ düşülür (yılda en çok %lld).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage nach seiner ersten Zahlung bekommst auch du einen Gratismonat: %@ werden von deiner nächsten Zahlung abgezogen (bis zu %lld pro Jahr)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days after their first payment you get a free month too: %@ comes off your next payment (up to %lld a year)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld días después de su primer pago, tú también consigues un mes gratis: se descuentan %@ de tu siguiente pago (hasta %lld al año)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld päivää hänen ensimmäisen maksunsa jälkeen saat myös ilmaisen kuukauden: %@ vähennetään seuraavasta maksustasi (enintään %lld vuodessa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jours après son premier paiement, vous obtenez vous aussi un mois gratuit : %@ est déduit de votre prochain paiement (jusqu’à %lld par an)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giorni dopo il suo primo pagamento ricevi anche tu un mese gratis: %@ in meno sul tuo prossimo pagamento (fino a %lld all’anno)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちの初回支払いから%lld日後、あなたにも1か月分の特典があります：次回の支払いから%@が差し引かれます（年間最大%lld回）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 첫 결제를 하고 %1$lld일이 지나면 나도 한 달 무료 혜택을 받습니다: 다음 결제에서 %2$@이(가) 차감됩니다(연간 최대 %3$lld회)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dagen na diens eerste betaling krijg jij ook een gratis maand: %@ gaat van je volgende betaling af (maximaal %lld per jaar)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dias após o primeiro pagamento dele, você também ganha um mês grátis: %@ é descontado do seu próximo pagamento (até %lld por ano)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其首次付款 %lld 天后，你也会获得一个月免费：下次付款将减免 %@（每年最多 %lld 次）。"
          }
        }
      }
    },
