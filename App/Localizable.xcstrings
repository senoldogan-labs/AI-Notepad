    "Ekran görüntülerini kalıcı siler; metin, not ve ses kalır": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Bildschirmfotos endgültig; Transkript, Notiz und Audio bleiben erhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the screen snapshots; the transcript, note and audio stay"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de forma permanente las capturas de pantalla; la transcripción, la nota y el audio se conservan"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa näyttökuvat pysyvästi; litterointi, muistiinpano ja ääni säilyvät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement les captures d’écran ; la transcription, la note et l’audio sont conservés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente le istantanee dello schermo; trascrizione, nota e audio restano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面スナップショットを完全に削除します。文字起こし、ノート、音声は残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 스냅샷을 영구적으로 삭제합니다. 녹취록, 노트 및 오디오는 유지됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de schermafbeeldingen permanent; het transcript, de notitie en de audio blijven"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga as capturas de tela permanentemente; a transcrição, a nota e o áudio continuam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除屏幕快照；文字稿、笔记和音频保留"
          }
        }
      }
    },
