          "stringUnit": {
            "state": "translated",
            "value": "Sprekers"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人"
          }
        }
      }
    },
    "Konuşmacılar ElevenLabs ile dakikada bir ayrılır; kayıt bitince ElevenLabs son geçişi yapılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprecher werden jede Minute mit ElevenLabs getrennt; am Ende der Aufnahme läuft ein abschließender Durchgang mit ElevenLabs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakers are separated with ElevenLabs every minute; an ElevenLabs final pass runs when the recording ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los interlocutores se separan con ElevenLabs cada minuto; al terminar la grabación se hace un repaso final con ElevenLabs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhujat erotellaan ElevenLabsilla minuutin välein; ElevenLabsin viimeistely tehdään, kun nauhoitus päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intervenants sont séparés avec ElevenLabs chaque minute ; une passe finale ElevenLabs a lieu à la fin de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interlocutori vengono separati con ElevenLabs ogni minuto; al termine della registrazione viene eseguito un passaggio finale con ElevenLabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者はElevenLabsで1分ごとに分離されます。録音終了時にElevenLabsによる最終処理が行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs로 1분마다 화자를 구분합니다. 녹음이 끝나면 ElevenLabs 최종 처리가 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekers worden elke minuut met ElevenLabs gescheiden; als de opname eindigt, volgt een laatste ronde met ElevenLabs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os falantes são separados com o ElevenLabs a cada minuto; uma passada final do ElevenLabs é feita quando a gravação termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每分钟使用 ElevenLabs 区分一次说话人；录制结束时会运行 ElevenLabs 最终处理。"
          }
        }
      }
    },
    "Konuşmacılar Mac'te ayrılıyor": {
