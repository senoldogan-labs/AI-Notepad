    "Gönderilecek açık görev yok (hepsi gönderilmiş ya da tamamlanmış).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine offenen Aufgaben zum Senden (alle gesendet oder erledigt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No open tasks to send (all sent or completed)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tareas abiertas que enviar (todas enviadas o completadas)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei lähetettäviä avoimia tehtäviä (kaikki lähetetty tai suoritettu)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ouverte à envoyer (toutes envoyées ou terminées)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività aperta da inviare (tutte inviate o completate)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信する未完了のタスクはありません（すべて送信済みまたは完了済み）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 미완료 할 일이 없습니다(모두 보냈거나 완료됨)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen open taken om te versturen (alles verstuurd of voltooid)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa em aberto para enviar (todas enviadas ou concluídas)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可发送的未完成任务（全部已发送或已完成）。"
          }
        }
      }
    },
