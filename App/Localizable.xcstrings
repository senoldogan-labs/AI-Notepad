    "Akış hazır; önizlemeler büyük toplantılarda bozuluyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flow ist fertig; Vorschauen funktionieren bei großen Meetings nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flow is done; previews break on large meetings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo está listo; las vistas previas fallan en reuniones grandes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminto on valmis; esikatselut eivät toimi suurissa kokouksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux est prêt ; les aperçus ne fonctionnent pas sur les grandes réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso è pronto; le anteprime non funzionano nelle riunioni grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローは完成。大規模な会議ではプレビューが正しく動作しない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐름은 완성됨. 대규모 회의에서는 미리보기가 작동하지 않음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De flow is klaar; voorbeelden werken niet bij grote vergaderingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo está pronto; as prévias falham em reuniões grandes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流程已完成；预览在大型会议中出错。"
          }
        }
      }
    },
