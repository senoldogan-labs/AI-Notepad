    "Bu ülkedeki numaralar henüz aranamıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers in this country can't be called yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummern in diesem Land können noch nicht angerufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros de ce pays ne peuvent pas encore être appelés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se puede llamar a números de este país."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora possibile chiamare numeri di questo paese."
          }
        },
