    "Ses ya da video olmayan dosya içe aktarılmadı: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht importiert, weil es kein Audio oder Video ist: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not imported because it isn't audio or video: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha importado porque no es audio ni vídeo: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tuotu, koska se ei ole ääntä tai videota: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importé, car ce n’est ni de l’audio ni de la vidéo : %@"
          }
        },
