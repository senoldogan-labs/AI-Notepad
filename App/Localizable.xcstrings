    "Toplantı dili %@ seçildi: başka dildeki konuşma transkripte, nota ve Sor'a girmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Sprache auf %@ gesetzt: Gesprochenes in anderen Sprachen wird aus Transkript, Notiz und „Fragen“ ausgelassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting language set to %@: speech in other languages is left out of the transcript, the note and Ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma de la reunión establecido en %@: lo que se diga en otros idiomas queda fuera de la transcripción, la nota y Preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen kieleksi asetettu %@: muunkielinen puhe jätetään pois litteroinnista, muistiinpanosta ja Kysy-toiminnosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de la réunion réglée sur %@ : la parole dans d’autres langues est exclue de la transcription, de la note et de Demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingua della riunione impostata su %@: il parlato in altre lingue viene escluso da trascrizione, nota e Chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の言語が%@に設定されています：他の言語の発話は、文字起こし、ノート、「質問」から除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 언어가 %@(으)로 설정되었습니다. 다른 언어로 된 발언은 녹취록, 노트, 질문하기에서 제외됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergadertaal ingesteld op %@: spraak in andere talen wordt weggelaten uit het transcript, de notitie en Vraag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma da reunião definido como %@: a fala em outros idiomas fica fora da transcrição, da nota e de Perguntar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议语言已设为%@：其他语言的发言不会包含在文字稿、笔记和“提问”中。"
          }
        }
      }
    },
