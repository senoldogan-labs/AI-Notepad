      }
    },
    "Ses Mac'ten çıkmaz; kayıt bitince konuşmacılar Mac'te (SpeakerKit) ayrılır. Not için LLM gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio verlässt nie deinen Mac; Sprecher werden am Ende der Aufnahme auf dem Mac getrennt (SpeakerKit). Für Notizen ist ein LLM nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio never leaves your Mac; speakers are separated on the Mac (SpeakerKit) when the recording ends. Notes need an LLM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio nunca sale de tu Mac; los interlocutores se separan en el Mac (SpeakerKit) al terminar la grabación. Las notas necesitan un LLM."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni ei koskaan poistu Macistasi; puhujat erotellaan Macissa (SpeakerKit), kun nauhoitus päättyy. Muistiinpanot vaativat kielimallin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio ne quitte jamais votre Mac ; les intervenants sont séparés sur le Mac (SpeakerKit) à la fin de l’enregistrement. Les notes nécessitent un LLM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio non lascia mai il Mac; gli interlocutori vengono separati sul Mac (SpeakerKit) al termine della registrazione. Le note richiedono un LLM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声がMacの外に出ることはありません。録音終了時にMac上（SpeakerKit）で話者が分離されます。ノートにはLLMが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 Mac 밖으로 나가지 않습니다. 녹음이 끝나면 Mac에서 화자가 구분됩니다(SpeakerKit). 노트를 작성하려면 LLM이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio verlaat je Mac nooit; sprekers worden op de Mac gescheiden (SpeakerKit) als de opname eindigt. Notities vereisen een LLM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio nunca sai do seu Mac; os falantes são separados no Mac (SpeakerKit) quando a gravação termina. As notas precisam de um LLM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频绝不会离开你的 Mac；录制结束时会在 Mac 上区分说话人（SpeakerKit）。笔记需要 LLM。"
          }
        }
      }
    },
    "Ses biçimi dönüştürülemedi. Çıkış/giriş cihazını değiştirip kaydı yeniden başlat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audioformat konnte nicht konvertiert werden. Wechsle das Aus-/Eingabegerät und starte die Aufnahme neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio format couldn't be converted. Change the output/input device and restart the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido convertir el formato de audio. Cambia el dispositivo de salida o entrada y reinicia la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänimuotoa ei voitu muuntaa. Vaihda lähtö- tai syöttölaitetta ja aloita nauhoitus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format audio n’a pas pu être converti. Changez de périphérique de sortie/d’entrée et relancez l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convertire il formato audio. Cambia il dispositivo di output/input e riavvia la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声フォーマットを変換できませんでした。出力／入力デバイスを変更して、録音をやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 형식을 변환할 수 없습니다. 출력/입력 장치를 변경하고 녹음을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het audioformaat kon niet worden omgezet. Wijzig het uitvoer-/invoerapparaat en start de opname opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível converter o formato de áudio. Troque o dispositivo de saída/entrada e reinicie a gravação."
          }
        },
        "zh-Hans": {
