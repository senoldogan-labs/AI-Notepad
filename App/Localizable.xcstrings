    "Hemen başla (cihaz içi)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt starten (auf dem Gerät)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start now (on-device)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar ya (en el dispositivo)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita nyt (laitteella)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer maintenant (sur l’appareil)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia ora (sul dispositivo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ開始（オンデバイス）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 시작(기기 내)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin nu (op het apparaat)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar agora (no dispositivo)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即开始（设备端）"
          }
        }
      }
    },
    "Hemen cihaz içi başla ya da kendi anahtarlarınla daha yüksek kalite al; sonra Ayarlar'dan değişir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte sofort auf dem Gerät oder erhalte höhere Qualität mit eigenen Schlüsseln; du kannst das später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start right away on-device, or get higher quality with your own keys; you can change this later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza ya en el dispositivo u obtén más calidad con tus propias claves; puedes cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita heti laitteella tai saa parempi laatu omilla avaimillasi; voit muuttaa tätä myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez tout de suite sur l’appareil, ou obtenez une meilleure qualité avec vos propres clés ; vous pourrez changer cela plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia subito sul dispositivo o ottieni una qualità superiore con le tue chiavi; puoi cambiarlo più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスですぐに開始するか、独自のキーでより高い品質を得られます。あとで設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내에서 바로 시작하거나 본인의 키로 더 높은 품질을 이용하세요. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin meteen op het apparaat, of krijg een hogere kwaliteit met je eigen sleutels; je kunt dit later wijzigen in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece agora no dispositivo ou tenha mais qualidade com suas próprias chaves; você pode alterar isso depois em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即在设备端开始，或使用你自己的密钥获得更高质量；你可以稍后在设置中更改。"
          }
        }
      }
    },
