    "Sor, notu yeniden yazma, paylaşım çevirisi ve görev araçları bu paydan düşer; toplantı sırasındakiler düşmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fragen“, Notizen neu schreiben, übersetztes Teilen und Aufgaben-Tools nutzen dieses Kontingent; KI während Meetings nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask, rewriting notes, share translations and task tools use this allowance; AI during meetings doesn't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar, reescribir notas, compartir traducciones y las herramientas de tareas usan esta asignación; la IA durante las reuniones no."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy, muistiinpanojen uudelleenkirjoitus, käännösten jakaminen ja tehtävätyökalut käyttävät tätä kiintiötä; kokousten aikainen tekoäly ei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander, la réécriture des notes, les traductions partagées et les outils de tâches utilisent ce quota ; l’IA pendant les réunions ne l’utilise pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi, riscrittura delle note, traduzioni condivise e strumenti per le attività usano questa quota; l’AI durante le riunioni no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「質問」、ノートの書き直し、翻訳の共有、タスクツールはこの利用枠を使用します。会議中のAIは使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하기, 노트 다시 작성, 번역 공유, 할 일 도구에 이 사용 한도가 적용됩니다. 회의 중 AI에는 적용되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag, notities herschrijven, vertalingen delen en taaktools gebruiken dit tegoed; AI tijdens vergaderingen niet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar, reescrever notas, traduções compartilhadas e ferramentas de tarefas usam esta cota; a IA durante as reuniões não."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问、重写笔记、共享翻译和任务工具会使用此额度；会议期间的 AI 不会使用。"
          }
        }
      }
    },
    "Sor… (@ toplantı, / tarif)": {
      "localizations": {
