    "Not bağlantı için fazla uzun; transkripti eklemeden yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz ist für einen Link zu lang; versuche es ohne Transkript erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note is too long for a link; try again without the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota es demasiado larga para un enlace; vuelve a intentarlo sin la transcripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpano on liian pitkä linkille; yritä uudelleen ilman litterointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note est trop longue pour un lien ; réessaie sans la transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa nota è troppo lunga per un link; riprova senza la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモはリンクで共有するには長すぎます。文字起こしを含めずにもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트는 링크로 공유하기에 너무 깁니다. 녹취록 없이 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie is te lang voor een link; probeer het opnieuw zonder het transcript."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota é longa demais para um link; tente de novo sem a transcrição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条笔记太长，无法通过链接共享；请不包含文字稿再试。"
          }
        }
      }
    },
