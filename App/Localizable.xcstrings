    "İçinde kayıttaki ya da işlenen toplantı olan klasör silinemez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner mit einem Meeting, das gerade aufgenommen oder verarbeitet wird, kann nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder with a meeting that is recording or being processed can't be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar una carpeta con una reunión que se está grabando o procesando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiota, jossa on nauhoitettava tai käsiteltävä kokous, ei voi poistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier contenant une réunion en cours d’enregistrement ou de traitement ne peut pas être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile eliminare una cartella con una riunione in registrazione o in elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中または処理中の会議を含むフォルダは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중이거나 처리 중인 회의가 있는 폴더는 삭제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een map met een vergadering die wordt opgenomen of verwerkt, kan niet worden verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta com uma reunião sendo gravada ou processada não pode ser apagada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除包含正在录制或处理中的会议的文件夹。"
          }
        }
      }
    },
    "Kalıcı olarak sil": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen"
          }
        },
        "en": {
