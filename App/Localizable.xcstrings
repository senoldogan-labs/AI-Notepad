    "E-posta adresi geçersiz; düzelt ya da boş bırak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse ist ungültig; korrigiere sie oder lass das Feld leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email address is invalid; fix it or leave it empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de correo no es válida; corrígela o déjala vacía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostiosoite on virheellinen; korjaa se tai jätä kenttä tyhjäksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse e-mail n’est pas valide ; corrigez-la ou laissez le champ vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo email non è valido; correggilo o lascialo vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスが無効です。修正するか、空のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소가 올바르지 않습니다. 수정하거나 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het e-mailadres is ongeldig; corrigeer het of laat het leeg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço de e-mail é inválido; corrija-o ou deixe-o vazio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件地址无效；请修改或留空。"
          }
        }
      }
    },
