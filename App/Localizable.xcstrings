          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’acquisto; riprova. Se succede ancora, comunica questo codice di errore all’assistenza: %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。もう一度お試しください。続く場合は、このエラーコードをサポートに伝えてください：%lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 완료하지 못했습니다. 다시 시도하세요. 계속되면 이 오류 코드를 지원팀에 알려 주세요: %lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
