    "Ses çalınamadı (kod %lld). Başka bir uygulama sesi kullanıyor olabilir; biraz sonra yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio konnte nicht abgespielt werden (Code %lld). Eventuell verwendet eine andere App das Audio; versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't play audio (code %lld). Another app may be using audio; try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido reproducir el audio (código %lld). Puede que otra app esté usando el audio; inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääntä ei voitu toistaa (koodi %lld). Toinen sovellus saattaa käyttää ääntä; yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’audio (code %lld). Une autre app utilise peut-être l’audio ; réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riprodurre l’audio (codice %lld). Un’altra app potrebbe usare l’audio; riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を再生できませんでした（コード %lld）。別のアプリがオーディオを使用している可能性があります。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 재생할 수 없습니다(코드 %lld). 다른 앱이 오디오를 사용 중일 수 있습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan audio niet afspelen (code %lld). Een andere app gebruikt mogelijk de audio; probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reproduzir o áudio (código %lld). Outro app pode estar usando o áudio; tente de novo em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放音频（代码 %lld）。可能有其他 App 正在使用音频；请稍后再试。"
          }
        }
      }
    },
    "Ses, toplantının süresinden ya da bu ay kalan süreden uzun; gönderilemedi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio ist länger als das Meeting oder die verbleibende Zeit in diesem Monat; es konnte nicht gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio is longer than the meeting or than the time left this month; it couldn't be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio es más largo que la reunión o que el tiempo que queda este mes; no se ha podido enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni on pidempi kuin kokous tai tämän kuun jäljellä oleva aika; sitä ei voitu lähettää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est plus long que la réunion ou que le temps restant ce mois-ci ; il n’a pas pu être envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio è più lungo della riunione o del tempo rimasto questo mese; non è stato possibile inviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が会議の長さ、または今月の残り時間より長いため、送信できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 회의 길이 또는 이번 달 남은 시간보다 길어 보낼 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio is langer dan de vergadering of dan de resterende tijd deze maand; hij kon niet worden verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio é mais longo que a reunião ou que o tempo restante deste mês; não foi possível enviá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频长于会议时长或本月剩余时长；无法发送。"
          }
        }
      }
    },
