    "Canlı metin bu Mac'te yazılıyor; konuşmacılar ve not bağlantı gelince hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Live-Transkript wird auf diesem Mac geschrieben; Sprecher und Notiz werden erstellt, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live transcript is written on this Mac; speakers and the note are prepared when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en directo se escribe en este Mac; los interlocutores y la nota se prepararán cuando vuelvas a tener conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikainen litterointi kirjoitetaan tässä Macissa; puhujat ja muistiinpano valmistellaan, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct est rédigée sur ce Mac ; les intervenants et la note seront préparés lorsque vous serez de nouveau en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione dal vivo viene scritta su questo Mac; interlocutori e nota vengono preparati quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしはこのMacで作成されます。話者とノートは、オンラインに戻ったときに作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 녹취록은 이 Mac에서 작성됩니다. 화자와 노트는 다시 온라인에 연결되면 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het live transcript wordt op deze Mac geschreven; sprekers en de notitie worden gemaakt zodra je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ao vivo é escrita neste Mac; os falantes e a nota são preparados quando você voltar a ficar online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时文字稿在这台 Mac 上撰写；恢复联网后会准备说话人和笔记。"
          }
        }
      }
    },
    "Canlı metin bu iPhone'da yazılıyor; konuşmacılar ve not bağlantı gelince hazırlanır.": {
