        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは%@に終了しました。会議とノートはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 %@에 종료되었습니다. 회의와 노트는 이 Mac에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is beëindigd op %@; je vergaderingen en notities blijven op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou em %@; suas reuniões e notas continuam neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已于 %@ 结束；你的会议和笔记保留在这台 Mac 上。"
          }
        }
      }
    },
    "Aboneliğin etkin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción está activa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi on voimassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 활성 상태입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is actief."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura está ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅有效。"
          }
        }
      }
    },
    "Aboneliğin sona erdi. Kayda devam etmek için yeniden abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist abgelaufen. Schließe erneut ein Abo ab, um weiter aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription has ended. Subscribe again to keep recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción ha finalizado. Vuelve a suscribirte para seguir grabando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi on päättynyt. Tilaa uudelleen, niin voit jatkaa nauhoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a pris fin. Abonnez-vous de nouveau pour continuer à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è terminato. Abbonati di nuovo per continuare a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが終了しました。録音を続けるには再度登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 종료되었습니다. 계속 녹음하려면 다시 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is beëindigd. Abonneer opnieuw om te blijven opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou. Assine de novo para continuar gravando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已结束。重新订阅即可继续录制。"
          }
        }
      }
    },
    "Aboneliğin sona erdi. Toplantıların ve notların bu Mac'te kalır; yeniden abone olunca kaldığın yerden devam edersin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist abgelaufen. Deine Meetings und Notizen bleiben auf diesem Mac; schließe erneut ein Abo ab, um dort weiterzumachen, wo du aufgehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription has ended. Your meetings and notes stay on this Mac; subscribe again to pick up where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción ha finalizado. Tus reuniones y notas se quedan en este Mac; vuelve a suscribirte para continuar donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi on päättynyt. Kokouksesi ja muistiinpanosi säilyvät tässä Macissa; tilaa uudelleen ja jatka siitä, mihin jäit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a pris fin. Vos réunions et notes restent sur ce Mac ; abonnez-vous de nouveau pour reprendre là où vous en étiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è terminato. Le riunioni e le note restano su questo Mac; abbonati di nuovo per riprendere da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが終了しました。会議とノートはこのMacに残ります。再度登録すると、中断したところから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 종료되었습니다. 회의와 노트는 이 Mac에 그대로 남아 있습니다. 다시 구독하면 중단한 곳부터 이어서 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement is beëindigd. Je vergaderingen en notities blijven op deze Mac; abonneer opnieuw om verder te gaan waar je gebleven was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura terminou. Suas reuniões e notas continuam neste Mac; assine de novo para continuar de onde parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的订阅已结束。你的会议和笔记保留在这台 Mac 上；重新订阅即可从中断处继续。"
          }
        }
      }
    },
    "Aboneliğin sona erdi; yeni kayıt için yeniden abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo ist abgelaufen; schließe erneut ein Abo ab, um aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription has ended; subscribe again to record."
          }
        },
        "es": {
