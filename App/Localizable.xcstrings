    "Kilit ekranında görünebilir: yalnız toplantı adı, sayılar ve görev metni; konuşma metni yok.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann auf dem Sperrbildschirm erscheinen: nur Meeting-Titel, Anzahlen und Aufgabentext, nie das Transkript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May appear on the lock screen: only meeting titles, counts and task text, never the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede aparecer en la pantalla bloqueada: solo títulos de reuniones, recuentos y texto de tareas, nunca la transcripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voi näkyä lukitusnäytöllä: vain kokouksen nimi, lukumäärät ja tehtävän teksti, ei koskaan litterointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut apparaître sur l’écran verrouillé : seulement les titres de réunion, des nombres et le texte des tâches, jamais la transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può comparire sulla schermata di blocco: solo titoli delle riunioni, conteggi e testo delle attività, mai la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に表示されることがあります：会議名、件数、タスクの内容のみで、文字起こしは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 표시될 수 있습니다: 회의 제목, 개수, 할 일 내용만 표시되며 녹취록은 표시되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan op het toegangsscherm verschijnen: alleen vergadertitels, aantallen en taaktekst, nooit het transcript."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode aparecer na tela bloqueada: apenas títulos de reuniões, contagens e texto das tarefas, nunca a transcrição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能显示在锁定屏幕上：仅显示会议标题、数量和任务内容，绝不显示文字稿。"
          }
        }
      }
    },
