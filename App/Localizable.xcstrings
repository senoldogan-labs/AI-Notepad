          }
        }
      }
    },
    "Bu ayki kullanım sınırın doldu; %@ tarihinde sıfırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Limit dieses Monats erreicht; es wird am %@ zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this month's limit; it resets on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado el límite de este mes; se restablece el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet käyttänyt tämän kuun rajan; se nollautuu %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite de ce mois-ci ; elle sera réinitialisée le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai usato il limite di questo mese; si azzera il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の上限に達しました。%@にリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 한도를 모두 사용했습니다. %@에 재설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de limiet van deze maand bereikt; die wordt gereset op %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou o limite deste mês; ele é redefinido em %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已用完本月限额；将于 %@ 重置。"
          }
        }
      }
    },
    "Bu ayki kullanım sınırın dolduğu için bu toplantı işlenemedi. Ses bu Mac'te kalır; sınır sıfırlanınca kendiliğinden işlenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting konnte nicht verarbeitet werden, weil das Limit dieses Monats aufgebraucht ist. Das Audio bleibt auf diesem Mac; es wird automatisch verarbeitet, sobald das Limit zurückgesetzt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting couldn't be processed because this month's limit is used up. The audio stays on this Mac; it's processed automatically when the limit resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar esta reunión porque se ha agotado el límite de este mes. El audio se queda en este Mac; se procesará automáticamente cuando se restablezca el límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei voitu käsitellä, koska tämän kuun raja on käytetty. Ääni säilyy tässä Macissa; se käsitellään automaattisesti, kun raja nollautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas pu être traitée car la limite de ce mois-ci est atteinte. L’audio reste sur ce Mac ; il sera traité automatiquement à la réinitialisation de la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare questa riunione perché il limite di questo mese è esaurito. L’audio resta su questo Mac; verrà elaborato automaticamente quando il limite si azzera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の上限に達したため、この会議を処理できませんでした。音声はこのMacに残り、上限がリセットされると自動的に処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 한도를 모두 사용하여 이 회의를 처리할 수 없습니다. 오디오는 이 Mac에 그대로 남아 있으며 한도가 재설정되면 자동으로 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kon niet worden verwerkt omdat de limiet van deze maand op is. De audio blijft op deze Mac; hij wordt automatisch verwerkt als de limiet wordt gereset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível processar esta reunião porque o limite deste mês acabou. O áudio continua neste Mac; ele será processado automaticamente quando o limite for redefinido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于本月限额已用完，无法处理此会议。音频保留在这台 Mac 上；限额重置后会自动处理。"
          }
        }
      }
    },
    "Bu ayki kullanım sınırın dolduğu için bu toplantı işlenemedi. Ses bu iPhone'da kalır; sınır sıfırlanınca kendiliğinden işlenir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting konnte nicht verarbeitet werden, weil das Nutzungslimit dieses Monats erreicht ist. Das Audio bleibt auf diesem iPhone und wird automatisch verarbeitet, sobald das Limit zurückgesetzt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting couldn't be processed because this month's usage limit is reached. The audio stays on this iPhone and is processed automatically when the limit resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar esta reunión porque se ha alcanzado el límite de uso de este mes. El audio se queda en este iPhone y se procesará automáticamente cuando se restablezca el límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kokousta ei voitu käsitellä, koska tämän kuun käyttöraja on täynnä. Ääni säilyy tässä iPhonessa ja käsitellään automaattisesti, kun raja nollautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion n’a pas pu être traitée car la limite d’utilisation de ce mois-ci est atteinte. L’audio reste sur cet iPhone et sera traité automatiquement à la réinitialisation de la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare questa riunione perché è stato raggiunto il limite di utilizzo di questo mese. L’audio resta su questo iPhone e verrà elaborato automaticamente quando il limite si azzera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の使用上限に達したため、この会議を処理できませんでした。音声はこのiPhoneに残り、上限がリセットされると自動的に処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 사용 한도에 도달하여 이 회의를 처리할 수 없습니다. 오디오는 이 iPhone에 그대로 남아 있으며 한도가 재설정되면 자동으로 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering kon niet worden verwerkt omdat de gebruikslimiet van deze maand is bereikt. De audio blijft op deze iPhone en wordt automatisch verwerkt als de limiet wordt gereset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível processar esta reunião porque o limite de uso deste mês foi atingido. O áudio continua neste iPhone e será processado automaticamente quando o limite for redefinido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于已达到本月用量限额，无法处理此会议。音频保留在这部 iPhone 上，限额重置后会自动处理。"
          }
        }
      }
    },
    "Bu ayki kullanım sınırına ulaştın": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Nutzungslimit dieses Monats erreicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached this month's usage limit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de uso de este mes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut tämän kuun käyttörajan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite d’utilisation de ce mois-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di utilizzo di questo mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の使用上限に達しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 사용 한도에 도달했습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de gebruikslimiet van deze maand bereikt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de uso deste mês"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到本月用量限额"
          }
        }
      }
    },
    "Bu ayki kullanım sınırına ulaştın; sınır ay başında sıfırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Nutzungslimit dieses Monats erreicht; es wird zu Monatsbeginn zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached this month's usage limit; it resets at the start of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de uso de este mes; se restablece a principios de mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut tämän kuun käyttörajan; se nollautuu kuun alussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite d’utilisation de ce mois-ci ; elle sera réinitialisée au début du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di utilizzo di questo mese; si azzera all’inizio del mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の使用上限に達しました。月初めにリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 사용 한도에 도달했습니다. 매월 초에 재설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de gebruikslimiet van deze maand bereikt; die wordt aan het begin van de maand gereset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de uso deste mês; ele é redefinido no início do mês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到本月用量限额；将在月初重置。"
          }
        }
      }
    },
    "Bu ayki sınır doldu: yeni kayıt başlatılamaz. Notların ve toplantıların erişilebilir kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit dieses Monats ist aufgebraucht: Neue Aufnahmen können nicht starten. Deine Notizen und Meetings bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's limit is used up: new recordings can't start. Your notes and meetings stay available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el límite de este mes: no se pueden iniciar grabaciones nuevas. Tus notas y reuniones siguen disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun raja on käytetty: uusia nauhoituksia ei voi aloittaa. Muistiinpanosi ja kokouksesi pysyvät käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de ce mois-ci est atteinte : impossible de démarrer de nouveaux enregistrements. Vos notes et réunions restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite di questo mese è esaurito: non è possibile avviare nuove registrazioni. Le note e le riunioni restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の上限に達しました：新しい録音を開始できません。ノートと会議は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 한도를 모두 사용했습니다: 새 녹음을 시작할 수 없습니다. 노트와 회의는 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet van deze maand is op: nieuwe opnamen kunnen niet starten. Je notities en vergaderingen blijven beschikbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite deste mês acabou: não é possível iniciar novas gravações. Suas notas e reuniões continuam disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月限额已用完：无法开始新的录制。你的笔记和会议仍可使用。"
          }
        }
      }
    },
    "Bu ayki yapay zekâ payın doldu (Sor, notu yeniden yazma…); ay başında sıfırlanır. Kayıt yapmaya devam edebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Kontingent dieses Monats ist aufgebraucht (Fragen, Notizen neu schreiben …); es wird zu Monatsbeginn zurückgesetzt. Du kannst weiter aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's AI allowance is used up (Ask, rewriting notes…); it resets at the start of the month. You can keep recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado la asignación de IA de este mes (Preguntar, reescribir notas…); se restablece a principios de mes. Puedes seguir grabando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun tekoälykiintiö on käytetty (Kysy, muistiinpanojen uudelleenkirjoitus…); se nollautuu kuun alussa. Voit jatkaa nauhoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota d’IA de ce mois-ci est épuisé (Demander, réécriture des notes…) ; il sera réinitialisé au début du mois. Vous pouvez continuer à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota AI di questo mese è esaurita (Chiedi, riscrittura delle note…); si azzera all’inizio del mese. Puoi continuare a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のAI利用枠（質問、ノートの書き直しなど）を使い切りました。月初めにリセットされます。録音は引き続き可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 AI 사용량(질문하기, 노트 다시 작성…)을 모두 사용했습니다. 매월 초에 재설정됩니다. 녹음은 계속할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-tegoed van deze maand is op (Vraag, notities herschrijven…); het wordt aan het begin van de maand gereset. Je kunt blijven opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota de IA deste mês acabou (Perguntar, reescrever notas…); ela é redefinida no início do mês. Você pode continuar gravando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的 AI 额度已用完（提问、重写笔记…）；将在月初重置。你仍可继续录制。"
          }
        }
      }
    },
    "Bu ağdan bugün çok fazla yeni deneme başlatıldı. Yarın yeniden dene ya da abone ol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute wurden zu viele neue Tests aus diesem Netzwerk gestartet. Versuche es morgen erneut oder schließe ein Abo ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many new trials were started from this network today. Try again tomorrow or subscribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy se han iniciado demasiadas pruebas nuevas desde esta red. Inténtalo de nuevo mañana o suscríbete."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä verkosta aloitettiin tänään liian monta uutta kokeilujaksoa. Yritä huomenna uudelleen tai tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de nouveaux essais ont été lancés depuis ce réseau aujourd’hui. Réessayez demain ou abonnez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi sono state avviate troppe nuove prove da questa rete. Riprova domani o abbonati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日このネットワークから開始された新規トライアルが多すぎます。明日もう一度お試しいただくか、登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 이 네트워크에서 너무 많은 새 체험이 시작되었습니다. 내일 다시 시도하거나 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn vandaag te veel nieuwe proefperiodes vanaf dit netwerk gestart. Probeer het morgen opnieuw of neem een abonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos testes novos foram iniciados a partir desta rede hoje. Tente de novo amanhã ou assine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天从此网络开始的新试用过多。请明天再试或订阅。"
          }
        }
      }
    },
    "Bu ağdan bugün çok fazla yeni deneme başlatıldı. Yarın yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
