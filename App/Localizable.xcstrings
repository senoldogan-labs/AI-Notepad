    "Kaydı başlatınca toplantıların ve notların burada görünür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meetings und Notizen erscheinen hier, sobald du mit der Aufnahme beginnst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meetings and notes appear here once you start recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones y notas aparecerán aquí cuando empieces a grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksesi ja muistiinpanosi näkyvät tässä, kun aloitat nauhoittamisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions et notes apparaissent ici dès que vous commencez à enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue riunioni e note appaiono qui quando inizi a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始すると、会議とノートがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 시작하면 회의와 노트가 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vergaderingen en notities verschijnen hier zodra je begint met opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões e notas aparecem aqui assim que você começar a gravar."
