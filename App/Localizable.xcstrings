    },
    "Deepgram canlı metni, ElevenLabs konuşmacıları, Claude notu yazar; aşağıdaki anahtarlar gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram schreibt den Live-Text, ElevenLabs trennt die Sprecher und Claude schreibt die Notiz; die Schlüssel unten sind erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram writes the live text, ElevenLabs separates speakers and Claude writes the note; the keys below are required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram escribe el texto en directo, ElevenLabs separa a los interlocutores y Claude escribe la nota; se necesitan las claves de abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram kirjoittaa reaaliaikaisen tekstin, ElevenLabs erottelee puhujat ja Claude kirjoittaa muistiinpanon; alla olevat avaimet vaaditaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram rédige le texte en direct, ElevenLabs sépare les intervenants et Claude rédige la note ; les clés ci-dessous sont requises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram scrive il testo dal vivo, ElevenLabs separa gli interlocutori e Claude scrive la nota; le chiavi qui sotto sono obbligatorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgramがライブ文字起こしを、ElevenLabsが話者分離を、Claudeがノートを担当します。以下のキーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram이 실시간 텍스트를 작성하고 ElevenLabs가 화자를 구분하며 Claude가 노트를 작성합니다. 아래 키가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram schrijft de live tekst, ElevenLabs scheidt sprekers en Claude schrijft de notitie; de sleutels hieronder zijn vereist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Deepgram escreve o texto ao vivo, o ElevenLabs separa os falantes e o Claude escreve a nota; as chaves abaixo são obrigatórias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram 撰写实时文字，ElevenLabs 区分说话人，Claude 撰写笔记；需要以下密钥。"
          }
        }
      }
    },
    "Deepgram ve ElevenLabs; konuşmacılar canlı ayrılır. İki anahtar gerekir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram und ElevenLabs; Sprecher werden live getrennt. Benötigt zwei Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram and ElevenLabs; speakers separated live. Needs two keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram y ElevenLabs; interlocutores separados en directo. Necesita dos claves."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepgram ja ElevenLabs; puhujat erotellaan reaaliajassa. Vaatii kaksi avainta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
