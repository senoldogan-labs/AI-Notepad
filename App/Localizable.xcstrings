    "Vergiler dahil. İstediğin zaman iptal edebilirsin; ödeme Stripe ile güvenle yapılır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inklusive Steuern. Jederzeit kündbar; die Zahlung wird sicher über Stripe abgewickelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes included. Cancel anytime; payment is handled securely by Stripe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impuestos incluidos. Cancela cuando quieras; Stripe gestiona el pago de forma segura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää verot. Peru milloin tahansa; maksun käsittelee turvallisesti Stripe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes incluses. Résiliable à tout moment ; le paiement est traité de manière sécurisée par Stripe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasse incluse. Annulla quando vuoi; il pagamento è gestito in modo sicuro da Stripe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税込み。いつでもキャンセルできます。支払いはStripeによって安全に処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금 포함. 언제든지 취소할 수 있으며, 결제는 Stripe를 통해 안전하게 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclusief belastingen. Altijd opzegbaar; de betaling wordt veilig afgehandeld door Stripe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostos incluídos. Cancele quando quiser; o pagamento é processado com segurança pela Stripe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已含税。可随时取消；付款由 Stripe 安全处理。"
          }
        }
      }
    },
