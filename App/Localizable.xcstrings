    "Önceki hesabın bir notu yazılıyor. Bitince bu hesabın toplantıları kendiliğinden açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz für deinen vorherigen Account wird geschrieben. Sobald sie fertig ist, öffnen sich die Meetings dieses Accounts automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note for your previous account is being written. Once it's done, this account's meetings open automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está escribiendo una nota de tu cuenta anterior. Cuando termine, se abrirán automáticamente las reuniones de esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellisen tilisi muistiinpanoa kirjoitetaan. Kun se on valmis, tämän tilin kokoukset avautuvat automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note de votre compte précédent est en cours de rédaction. Une fois terminée, les réunions de ce compte s’ouvriront automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in scrittura una nota per l’account precedente. Al termine, le riunioni di questo account si aprono automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のアカウントのノートを作成中です。完了すると、このアカウントの会議が自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 계정의 노트를 작성하는 중입니다. 완료되면 이 계정의 회의가 자동으로 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een notitie voor je vorige account geschreven. Zodra die klaar is, worden de vergaderingen van dit account automatisch geopend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nota da sua conta anterior está sendo escrita. Quando terminar, as reuniões desta conta se abrem automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在为你之前的账户撰写笔记。完成后，会自动打开此账户的会议。"
          }
        }
      }
    },
    "Önceki hesabın kaydı sürüyor. Kayıt bitip toplantı işlenince bu hesabın toplantıları kendiliğinden açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme deines vorherigen Accounts läuft noch. Sobald sie endet und das Meeting verarbeitet ist, öffnen sich die Meetings dieses Accounts automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous account's recording is still running. Once it ends and the meeting is processed, this account's meetings open automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de tu cuenta anterior sigue en curso. Cuando termine y se procese la reunión, se abrirán automáticamente las reuniones de esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellisen tilisi nauhoitus on yhä käynnissä. Kun se päättyy ja kokous on käsitelty, tämän tilin kokoukset avautuvat automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de votre compte précédent est toujours en cours. Une fois terminé et la réunion traitée, les réunions de ce compte s’ouvriront automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione dell’account precedente è ancora in corso. Quando termina e la riunione è elaborata, le riunioni di questo account si aprono automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のアカウントの録音がまだ続いています。録音が終了して会議が処理されると、このアカウントの会議が自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 계정의 녹음이 아직 진행 중입니다. 녹음이 끝나고 회의가 처리되면 이 계정의 회의가 자동으로 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname van je vorige account loopt nog. Zodra die eindigt en de vergadering is verwerkt, worden de vergaderingen van dit account automatisch geopend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação da sua conta anterior ainda está em andamento. Quando ela terminar e a reunião for processada, as reuniões desta conta se abrem automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前账户的录制仍在进行。录制结束且会议处理完成后，会自动打开此账户的会议。"
          }
        }
      }
    },
    "Önceki hesabın Sor cevabı yazılıyor. Bitince bu hesabın toplantıları kendiliğinden açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Antwort in „Fragen“ für deinen vorherigen Account wird geschrieben. Sobald sie fertig ist, öffnen sich die Meetings dieses Accounts automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Ask answer for your previous account is being written. Once it's done, this account's meetings open automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está escribiendo una respuesta de Preguntar para tu cuenta anterior. Cuando termine, se abrirán automáticamente las reuniones de esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellisen tilisi Kysy-vastausta kirjoitetaan. Kun se on valmis, tämän tilin kokoukset avautuvat automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse de Demander pour votre compte précédent est en cours de rédaction. Une fois terminée, les réunions de ce compte s’ouvriront automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in scrittura una risposta di Chiedi per l’account precedente. Al termine, le riunioni di questo account si aprono automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のアカウントの「質問」の回答を作成中です。完了すると、このアカウントの会議が自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 계정의 질문하기 답변을 작성하는 중입니다. 완료되면 이 계정의 회의가 자동으로 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een antwoord in Vraag voor je vorige account geschreven. Zodra dat klaar is, worden de vergaderingen van dit account automatisch geopend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma resposta de Perguntar da sua conta anterior está sendo escrita. Quando terminar, as reuniões desta conta se abrem automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在为你之前的账户撰写“提问”的回答。完成后，会自动打开此账户的会议。"
          }
        }
      }
    },
    "Önceki hesabın toplantısı işleniyor. Bitince bu hesabın toplantıları kendiliğinden açılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meeting deines vorherigen Accounts wird verarbeitet. Sobald es fertig ist, öffnen sich die Meetings dieses Accounts automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting from your previous account is being processed. Once it's done, this account's meetings open automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está procesando una reunión de tu cuenta anterior. Cuando termine, se abrirán automáticamente las reuniones de esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
