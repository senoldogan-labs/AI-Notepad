          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 기능은 화요일에 링크 미리보기를 끈 상태로 출시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
