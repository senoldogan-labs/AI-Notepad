    "Adres şifresiz (http); güvenlik gereği bağlanılmadı. https adresi kullan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse ist nicht verschlüsselt (http) und wurde daher aus Sicherheitsgründen blockiert. Verwende eine https-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address isn't encrypted (http), so it was blocked for security. Use an https address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección no está cifrada (http), así que se ha bloqueado por seguridad. Usa una dirección https."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoite ei ole salattu (http), joten se estettiin turvallisuussyistä. Käytä https-osoitetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse n’est pas chiffrée (http) ; elle a donc été bloquée par sécurité. Utilisez une adresse https."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo non è cifrato (http), quindi è stato bloccato per sicurezza. Usa un indirizzo https."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは暗号化されていない（http）ため、セキュリティ上ブロックされました。httpsのアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소가 암호화되지 않아(http) 보안을 위해 차단되었습니다. https 주소를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres is niet versleuteld (http) en is daarom om veiligheidsredenen geblokkeerd. Gebruik een https-adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço não é criptografado (http), por isso foi bloqueado por segurança. Use um endereço https."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址未加密（http），出于安全原因已被阻止。请使用 https 地址。"
          }
        }
      }
    },
