            "value": "Gravar uma chamada neste iPhone (experimental)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制此 iPhone 上的通话（实验性）"
          }
        }
      }
    },
    "Kayıt, uygulama kapandığı için yarıda kesildi; o ana kadar kaydedilen kısım hazırlanıyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde unterbrochen, weil die App geschlossen wurde; der bis dahin aufgenommene Teil wird vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was cut short because the app closed; the part recorded until then is being prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se cortó porque la app se cerró; se está preparando la parte grabada hasta ese momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus katkesi, koska sovellus sulkeutui; siihen asti nauhoitettua osaa valmistellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a été interrompu car l’app s’est fermée ; la partie enregistrée jusque-là est en cours de préparation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata interrotta perché l’app si è chiusa; la parte registrata fino a quel momento è in preparazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが終了したため録音が途中で止まりました。それまでに録音された部分を準備しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 종료되어 녹음이 중간에 끊겼습니다. 그때까지 녹음된 부분을 준비하고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is afgebroken omdat de app werd gesloten; het deel dat tot dan is opgenomen, wordt voorbereid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida porque o app foi fechado; a parte gravada até então está sendo preparada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 App 关闭，录制中途中断；正在准备此前已录制的部分。"
          }
        }
      }
    },
    "Kayıt, uygulama kapandığı için yarıda kesildi; o ana kadar kaydedilen kısım işlendi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde unterbrochen, weil die App geschlossen wurde; der bis dahin aufgenommene Teil wurde verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was cut short because the app closed; the part recorded until then was processed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se cortó porque la app se cerró; se procesó la parte grabada hasta ese momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus katkesi, koska sovellus sulkeutui; siihen asti nauhoitettu osa käsiteltiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a été interrompu car l’app s’est fermée ; la partie enregistrée jusque-là a été traitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata interrotta perché l’app si è chiusa; la parte registrata fino a quel momento è stata elaborata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが終了したため録音が途中で止まりました。それまでに録音された部分は処理済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 종료되어 녹음이 중간에 끊겼습니다. 그때까지 녹음된 부분은 처리되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is afgebroken omdat de app werd gesloten; het deel dat tot dan is opgenomen, is verwerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida porque o app foi fechado; a parte gravada até então foi processada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 App 关闭，录制中途中断；此前已录制的部分已处理。"
          }
        }
      }
    },
    "Diskte yaklaşık %lld dakikalık kayıt için yer var. Uzun bir toplantıdan önce yer aç: yer biterse kayıt o ana kadar kaydedilenle bitirilir ve not hazırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherplatz reicht für etwa %lld Minuten Aufnahme. Gib vor einem langen Meeting Speicherplatz frei: Wird der Platz knapp, endet die Aufnahme mit dem bis dahin Aufgenommenen und die Notiz wird erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is disk space for about %lld minutes of recording. Free up space before a long meeting: if space runs out, the recording ends with what was recorded so far and the note is prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay espacio en disco para unos %lld minutos de grabación. Libera espacio antes de una reunión larga: si se acaba, la grabación termina con lo grabado hasta ese momento y se prepara la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levytilaa on noin %lld minuutin tallennukseen. Vapauta tilaa ennen pitkää kokousta: jos tila loppuu, tallennus päättyy siihen mennessä tallennettuun ja muistiinpano valmistellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace disque suffit pour environ %lld minutes d’enregistrement. Libère de l’espace avant une longue réunion : si l’espace vient à manquer, l’enregistrement s’arrête avec ce qui a été enregistré et la note est préparée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è spazio su disco per circa %lld minuti di registrazione. Libera spazio prima di una riunione lunga: se lo spazio finisce, la registrazione si chiude con quanto registrato fino a quel momento e la nota viene preparata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量は約%lld分の録音分です。長い会議の前に空き容量を確保してください。容量がなくなると、それまでの録音で録音を終了し、ノートを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 공간이 약 %lld분 녹음 분량 남아 있습니다. 긴 회의 전에 공간을 확보하세요. 공간이 부족해지면 그때까지 녹음된 내용으로 녹음이 끝나고 노트가 준비됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is schijfruimte voor ongeveer %lld minuten opname. Maak ruimte vrij vóór een lange vergadering: raakt de ruimte op, dan stopt de opname met wat tot dan is opgenomen en wordt de notitie gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há espaço em disco para cerca de %lld minutos de gravação. Libere espaço antes de uma reunião longa: se o espaço acabar, a gravação termina com o que foi gravado até então e a nota é preparada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间约够录制 %lld 分钟。长会议前请释放空间：空间用尽时，录制会以已录内容结束，并生成笔记。"
          }
        }
      }
    },
    "Diskte kayıt için yer yok. Kayda başlamadan önce yer aç: kayıt ve notu için birkaç yüz MB boş yer gerekir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Speicherplatz für eine Aufnahme. Gib vor dem Start Speicherplatz frei: Aufnahme und Notiz brauchen einige hundert MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no disk space for a recording. Free up space before you start: a recording and its note need a few hundred MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio en disco para grabar. Libera espacio antes de empezar: una grabación y su nota necesitan unos cientos de MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levytilaa ei ole tallennukselle. Vapauta tilaa ennen aloittamista: tallennus ja sen muistiinpano tarvitsevat muutaman sata Mt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’espace disque pour un enregistrement. Libère de l’espace avant de commencer : un enregistrement et sa note nécessitent quelques centaines de Mo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è spazio su disco per una registrazione. Libera spazio prima di iniziare: una registrazione e la sua nota richiedono alcune centinaia di MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音に必要なディスク容量がありません。開始する前に空き容量を確保してください。録音とノートには数百MBが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 디스크 공간이 없습니다. 시작하기 전에 공간을 확보하세요. 녹음과 노트에는 수백 MB가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen schijfruimte voor een opname. Maak ruimte vrij voordat je begint: een opname en de notitie hebben een paar honderd MB nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço em disco para gravar. Libere espaço antes de começar: uma gravação e sua nota precisam de algumas centenas de MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用于录制的磁盘空间。开始前请释放空间：录制及其笔记需要几百 MB。"
          }
        }
      }
    },
    "Diskte yer kalmadığı için kayıt bitirildi; o ana kadar kaydedilenler saklandı ve not hazırlanıyor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde beendet, weil der Speicher voll ist. Alles bis dahin Aufgenommene wurde gesichert und die Notiz wird erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording ended because storage is full; everything recorded so far was kept and the note is being prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación terminó porque el almacenamiento está lleno; se guardó todo lo grabado hasta ese momento y se está preparando la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus päättyi, koska tallennustila on täynnä; kaikki siihen mennessä tallennettu säilytettiin ja muistiinpanoa valmistellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté car le stockage est plein ; tout ce qui a été enregistré a été conservé et la note est en préparation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è terminata perché lo spazio è esaurito; quanto registrato finora è stato salvato e la nota è in preparazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージがいっぱいになったため録音を終了しました。それまでの録音はすべて保存され、ノートを作成しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 가득 차서 녹음이 끝났습니다. 그때까지 녹음된 내용은 모두 보관되었고 노트를 준비하고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is gestopt omdat de opslag vol is; alles wat tot dan is opgenomen is bewaard en de notitie wordt gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação terminou porque o armazenamento está cheio; tudo o que foi gravado até então foi mantido e a nota está sendo preparada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
