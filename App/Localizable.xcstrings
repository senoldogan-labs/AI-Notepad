    "Sesle yazma her uygulamada çalışır. Ayarlar › Sesle yazma'dan kısayolu, sesleri ve dili değiştirebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice typing works in every app. Change the shortcut, sounds and language in Settings › Voice typing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe funktioniert in jeder App. Kürzel, Töne und Sprache änderst du unter Einstellungen › Spracheingabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie vocale fonctionne dans toutes les apps. Modifiez le raccourci, les sons et la langue dans Réglages › Saisie vocale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura por voz funciona en cualquier app. Cambia el atajo, los sonidos y el idioma en Ajustes › Escritura por voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura vocale funziona in ogni app. Cambia abbreviazione, suoni e lingua in Impostazioni › Scrittura vocale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação por voz funciona em qualquer app. Altere o atalho, os sons e o idioma em Ajustes › Digitação por voz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraaktypen werkt in elke app. Wijzig de sneltoets, geluiden en taal in Instellingen › Spraaktypen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力はどのアプリでも使えます。ショートカット、サウンド、言語は「設定」›「音声入力」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력은 모든 앱에서 작동합니다. 단축키, 사운드, 언어는 설정 › 음성 입력에서 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入在任何 App 中都可用。可在“设置”›“语音输入”中更改快捷键、声音和语言。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhekirjoitus toimii kaikissa sovelluksissa. Vaihda pikanäppäin, äänet ja kieli kohdassa Asetukset › Puhekirjoitus."
          }
        }
      }
    },
    "Sesle yazmanın kısayolu yok. Aşağıdan bir kısayol seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice typing has no shortcut. Choose one below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe hat kein Kürzel. Wähle unten eines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie vocale n'a pas de raccourci. Choisissez-en un ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura por voz no tiene atajo. Elige uno abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura vocale non ha un'abbreviazione. Scegline una qui sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação por voz não tem atalho. Escolha um abaixo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraaktypen heeft geen sneltoets. Kies er hieronder een."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力にショートカットがありません。下で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력에 단축키가 없습니다. 아래에서 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入没有快捷键。请在下方选择一个。"
