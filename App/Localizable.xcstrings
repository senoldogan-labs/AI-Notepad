    "Bu ayki kayıt saatlerin bu kaydı işlemeye yetmiyor; canlı metin kullanılır. Sınır ay başında sıfırlanır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahmestunden dieses Monats reichen nicht aus, um diese Aufnahme zu verarbeiten; das Live-Transkript wird verwendet. Das Limit wird zu Monatsbeginn zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's recording hours aren't enough to process this recording; the live transcript is used. The limit resets at the start of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de grabación de este mes no bastan para procesar esta grabación; se usará la transcripción en directo. El límite se restablece a principios de mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun nauhoitustunnit eivät riitä tämän nauhoitteen käsittelyyn; käytetään reaaliaikaista litterointia. Raja nollautuu kuun alussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures d’enregistrement de ce mois-ci ne suffisent pas pour traiter cet enregistrement ; la transcription en direct est utilisée. La limite est réinitialisée au début du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di registrazione di questo mese non bastano per elaborare questa registrazione; viene usata la trascrizione dal vivo. Il limite si azzera all’inizio del mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の録音時間が足りないため、この録音を処理できません。ライブ文字起こしが使用されます。上限は月初めにリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 녹음 시간이 부족하여 이 녹음을 처리할 수 없습니다. 실시간 녹취록이 사용됩니다. 한도는 매월 초에 재설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname-uren van deze maand zijn niet genoeg om deze opname te verwerken; het live transcript wordt gebruikt. De limiet wordt aan het begin van de maand gereset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de gravação deste mês não são suficientes para processar esta gravação; será usada a transcrição ao vivo. O limite é redefinido no início do mês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月剩余的录制时长不足以处理此录音；将使用实时文字稿。限额会在月初重置。"
          }
        }
      }
    },
    "Bu ayki kayıt saatlerin doldu; yeni kayıt ay başında açılır. Notların ve toplantıların kullanılabilir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahmestunden dieses Monats sind aufgebraucht; neue Aufnahmen sind ab Monatsbeginn wieder möglich. Deine Notizen und Meetings bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's recording hours are used up; new recordings open at the start of the month. Your notes and meetings stay available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han agotado las horas de grabación de este mes; las nuevas grabaciones se habilitan a principios de mes. Tus notas y reuniones siguen disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun nauhoitustunnit on käytetty; uudet nauhoitukset avautuvat kuun alussa. Muistiinpanosi ja kokouksesi pysyvät käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures d’enregistrement de ce mois-ci sont épuisées ; les nouveaux enregistrements seront de nouveau possibles au début du mois. Vos notes et réunions restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di registrazione di questo mese sono esaurite; le nuove registrazioni saranno disponibili all’inizio del mese. Le note e le riunioni restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の録音時間を使い切りました。新しい録音は月初めから可能になります。ノートと会議は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 녹음 시간을 모두 사용했습니다. 새 녹음은 다음 달 초에 가능합니다. 노트와 회의는 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname-uren van deze maand zijn op; nieuwe opnamen zijn weer mogelijk aan het begin van de maand. Je notities en vergaderingen blijven beschikbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de gravação deste mês acabaram; novas gravações liberam no início do mês. Suas notas e reuniões continuam disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月的录制时长已用完；月初即可开始新的录制。你的笔记和会议仍可使用。"
          }
        }
      }
    },
    "Bu ayki kullanım": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung in diesem Monat"
          }
        },
