    "Paylaşım penceresi açılamadı; PDF iCloud Drive'da: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen-Fenster konnte nicht geöffnet werden; das PDF ist in iCloud Drive: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the share window; the PDF is in iCloud Drive: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir la ventana para compartir; el PDF está en iCloud Drive: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakoikkunaa ei voitu avata; PDF on iCloud Drivessa: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir la fenêtre de partage ; le PDF se trouve dans iCloud Drive : %@"
          }
        },
        "it": {
