    "Yapay zekâ bu kayıtta kullanılamıyor; not kayıt bitince yazılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI ist für diese Aufnahme nicht verfügbar; die Notiz wird am Ende der Aufnahme geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI isn't available for this recording; the note is written when the recording ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no está disponible para esta grabación; la nota se escribirá cuando termine la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly ei ole käytettävissä tälle nauhoitukselle; muistiinpano kirjoitetaan, kun nauhoitus päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA n’est pas disponible pour cet enregistrement ; la note sera rédigée à la fin de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’AI non è disponibile per questa registrazione; la nota viene scritta al termine della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音ではAIを利用できません。録音の終了時にノートが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음에서는 AI를 사용할 수 없습니다. 노트는 녹음이 끝나면 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is niet beschikbaar voor deze opname; de notitie wordt geschreven als de opname eindigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA não está disponível para esta gravação; a nota é escrita quando a gravação terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音无法使用 AI；录制结束时会撰写笔记。"
          }
        }
      }
    },
