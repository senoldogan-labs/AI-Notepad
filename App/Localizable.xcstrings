          "stringUnit": {
            "state": "translated",
            "value": "Keskeyttää käynnissä olevan Gistsmith-nauhoituksen; keskeytysaikaa ei nauhoiteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause l’enregistrement Gistsmith en cours ; le temps de pause n’est pas enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa la registrazione in corso di Gistsmith; il tempo in pausa non viene registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のGistsmithの録音を一時停止します。一時停止中の時間は録音されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Gistsmith 녹음을 일시 정지합니다. 일시 정지된 시간은 녹음되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeert de huidige Gistsmith-opname; de gepauzeerde tijd wordt niet opgenomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa a gravação atual do Gistsmith; o tempo em pausa não é gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停当前的 Gistsmith 录制；暂停期间不会录制。"
          }
        }
      }
    },
    "Duraklatılan Gistsmith kaydını sürdürür.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die pausierte Gistsmith-Aufnahme fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes the paused Gistsmith recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda la grabación de Gistsmith en pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkaa keskeytettyä Gistsmith-nauhoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend l’enregistrement Gistsmith en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprende la registrazione in pausa di Gistsmith."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中のGistsmithの録音を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지된 Gistsmith 녹음을 재개합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervat de gepauzeerde Gistsmith-opname."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma a gravação pausada do Gistsmith."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续已暂停的 Gistsmith 录制。"
          }
        }
      }
    },
    "Eşitleme şu an kullanılamıyor; biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist gerade nicht verfügbar; versuche es in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync isn't available right now; try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización no está disponible ahora mismo; inténtalo de nuevo en breve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi ei ole juuri nyt käytettävissä; yritä pian uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n’est pas disponible pour le moment ; réessayez sous peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione non è disponibile al momento; riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在同期を利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 동기화를 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is nu niet beschikbaar; probeer het zo opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização não está disponível agora; tente de novo em breve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步目前不可用；请稍后再试。"
          }
        }
      }
    },
    "Bu hesapta eşitleme kapalı; Ayarlar › Eşitleme'den açabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist für diesen Account deaktiviert; du kannst sie unter „Einstellungen“ › „Synchronisierung“ aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off for this account; you can turn it on in Settings › Sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada para esta cuenta; puedes activarla en Ajustes › Sincronización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi on pois päältä tällä tilillä; voit laittaa sen päälle kohdassa Asetukset › Synkronointi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est désactivée pour ce compte ; vous pouvez l’activer dans Réglages › Synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è disattivata per questo account; puoi attivarla in Impostazioni › Sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは同期がオフです。「設定」›「同期」でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 동기화가 꺼져 있습니다. 설정 › 동기화에서 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie staat uit voor dit account; je kunt het aanzetten in Instellingen › Synchronisatie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está desativada para esta conta; você pode ativá-la em Ajustes › Sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的同步已关闭；你可以在“设置 › 同步”中打开。"
          }
        }
      }
    },
    "Bu cihazdaki eşitleme anahtarı hesabınkiyle uyuşmuyor. Diğer cihazında Ayarlar › Eşitleme › Cihaz ekle'yi kullan ya da kurtarma kodunu gir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsschlüssel auf diesem Gerät passt nicht zu dem deines Accounts. Verwende auf deinem anderen Gerät „Einstellungen“ › „Synchronisierung“ › „Gerät hinzufügen“ oder gib deinen Wiederherstellungscode ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync key on this device doesn't match your account's. Use Settings › Sync › Add a device on your other device, or enter your recovery code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de sincronización de este dispositivo no coincide con la de tu cuenta. Usa Ajustes › Sincronización › Añadir un dispositivo en tu otro dispositivo o introduce tu código de recuperación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän laitteen synkronointiavain ei vastaa tilisi avainta. Valitse toisella laitteellasi Asetukset › Synkronointi › Lisää laite tai syötä palautuskoodisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de synchronisation de cet appareil ne correspond pas à celle de votre compte. Utilisez Réglages › Synchronisation › Ajouter un appareil sur votre autre appareil, ou saisissez votre code de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sincronizzazione su questo dispositivo non corrisponde a quella del tuo account. Usa Impostazioni › Sincronizzazione › Aggiungi un dispositivo sull’altro dispositivo o inserisci il codice di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの同期キーがアカウントのものと一致しません。もう一方のデバイスで「設定」›「同期」›「デバイスを追加」を使用するか、復旧コードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 동기화 키가 계정의 키와 일치하지 않습니다. 다른 기기에서 설정 › 동기화 › 기기 추가를 사용하거나 복구 코드를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatiesleutel op dit apparaat komt niet overeen met die van je account. Gebruik Instellingen › Synchronisatie › Voeg een apparaat toe op je andere apparaat, of voer je herstelcode in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de sincronização deste dispositivo não corresponde à da sua conta. Use Ajustes › Sincronização › Adicionar um dispositivo no seu outro dispositivo ou digite seu código de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的同步密钥与你账户的不匹配。请在你的另一台设备上使用“设置 › 同步 › 添加设备”，或输入你的恢复码。"
          }
        }
      }
    },
    "Bu toplantı diğer cihazda da değişti; değişiklikler birleştirilip yeniden gönderilecek.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Meeting wurde auch auf deinem anderen Gerät geändert; die Änderungen werden zusammengeführt und erneut gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting also changed on your other device; the changes will be merged and sent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión también ha cambiado en tu otro dispositivo; los cambios se combinarán y se volverán a enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kokous muuttui myös toisella laitteellasi; muutokset yhdistetään ja lähetetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réunion a aussi été modifiée sur votre autre appareil ; les modifications seront fusionnées et renvoyées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riunione è stata modificata anche sull’altro dispositivo; le modifiche verranno unite e inviate di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会議はもう一方のデバイスでも変更されました。変更内容は統合されて再送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의는 다른 기기에서도 변경되었습니다. 변경 사항이 병합되어 다시 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vergadering is ook op je andere apparaat gewijzigd; de wijzigingen worden samengevoegd en opnieuw verstuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunião também mudou no seu outro dispositivo; as alterações serão mescladas e enviadas de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会议在你的另一台设备上也有更改；更改将被合并并重新发送。"
          }
        }
      }
    },
    "Eşitlenen kopyanın yeri doldu; eski toplantıları ya da Sor sohbetlerini silip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine synchronisierte Kopie ist voll; lösche alte Meetings oder Chats in „Fragen“ und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your synced copy is full; delete old meetings or Ask chats and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia sincronizada está llena; elimina reuniones antiguas o chats de Preguntar e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoitu kopiosi on täynnä; poista vanhoja kokouksia tai Kysy-keskusteluja ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre copie synchronisée est pleine ; supprimez d’anciennes réunions ou conversations Demander et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua copia sincronizzata è piena; elimina vecchie riunioni o chat di Chiedi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期されたコピーの容量がいっぱいです。古い会議や「質問」のチャットを削除して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 사본이 가득 찼습니다. 오래된 회의나 질문하기 대화를 삭제한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gesynchroniseerde kopie is vol; verwijder oude vergaderingen of chats in Vraag en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cópia sincronizada está cheia; apague reuniões antigas ou conversas de Perguntar e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的同步副本已满；请删除旧会议或“提问”对话后重试。"
          }
        }
      }
    },
    "Eşitleme baştan yapılıyor; toplantıların yerinde kalır.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung beginnt von vorn; deine Meetings bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is starting over; your meetings stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización vuelve a empezar; tus reuniones se quedan donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi aloitetaan alusta; kokouksesi pysyvät paikallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation recommence depuis le début ; vos réunions restent où elles sont."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione sta ricominciando da capo; le tue riunioni restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をやり直しています。会議はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 처음부터 다시 시작합니다. 회의는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie begint opnieuw; je vergaderingen blijven waar ze zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está recomeçando; suas reuniões ficam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步正在重新开始；你的会议保持原样。"
          }
        }
      }
    },
