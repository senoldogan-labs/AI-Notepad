          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kokouksia kokoussivun valinnalla ”Siirrä kansioon”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des réunions avec « Déplacer vers un dossier » sur la page d’une réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi riunioni con “Sposta nella cartella” nella pagina di una riunione."
