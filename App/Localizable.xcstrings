    "Sor, notu değiştirme ve notu yenileme bu paydan düşer; toplantı sırasındakiler düşmez.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fragen“, Notiz bearbeiten und Notiz aktualisieren nutzen dieses Kontingent; alles während eines Meetings nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask, editing a note and refreshing a note use this allowance; anything during a meeting doesn't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar, editar una nota y actualizar una nota usan esta asignación; nada de lo que ocurre durante una reunión la usa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy, muistiinpanon muokkaus ja päivitys käyttävät tätä kiintiötä; mikään kokouksen aikana ei käytä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander, la modification et l’actualisation des notes utilisent ce quota ; rien de ce qui se passe pendant une réunion ne l’utilise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi, modifica e aggiornamento delle note usano questa quota; tutto ciò che avviene durante una riunione no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「質問」、ノートの編集、ノートの更新はこの利用枠を使用します。会議中の処理は使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하기, 노트 편집, 노트 새로 고침에는 이 허용량이 사용되며, 회의 중에 하는 작업에는 사용되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag, een notitie wijzigen en een notitie vernieuwen gebruiken dit tegoed; alles tijdens een vergadering niet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar, editar uma nota e atualizar uma nota usam esta cota; nada do que acontece durante uma reunião a usa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问、编辑笔记和刷新笔记会使用此额度；会议期间的任何操作都不会使用。"
          }
        }
      }
    },
