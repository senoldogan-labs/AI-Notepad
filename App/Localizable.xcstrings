    "Ses tanıma modeli denetlenemedi; modeli yeniden indir.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell zur Stimmerkennung konnte nicht geprüft werden; lade es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check the voice recognition model; download it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar el modelo de reconocimiento de voces; vuelve a descargarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänentunnistusmallia ei voitu tarkistaa; lataa se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le modèle de reconnaissance des voix ; téléchargez-le de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il modello di riconoscimento della voce; scaricalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の認識モデルを確認できませんでした。もう一度ダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식 모델을 확인할 수 없습니다. 다시 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het stemherkenningsmodel niet controleren; download het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o modelo de reconhecimento de voz; baixe-o de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查声音识别模型；请重新下载。"
          }
        }
      }
    },
    "Ses tanıma modeli indirilemedi. İnternet bağlantını ve boş alanı kontrol edip yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell zur Stimmerkennung konnte nicht geladen werden. Prüfe Internetverbindung und freien Speicher und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't download the voice recognition model. Check your internet connection and free space, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido descargar el modelo de reconocimiento de voces. Comprueba tu conexión a internet y el espacio libre, e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänentunnistusmallia ei voitu ladata. Tarkista internetyhteys ja vapaa tila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger le modèle de reconnaissance des voix. Vérifiez votre connexion Internet et l’espace libre, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello di riconoscimento della voce. Controlla la connessione a internet e lo spazio libero, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の認識モデルをダウンロードできませんでした。インターネット接続と空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식 모델을 다운로드할 수 없습니다. 인터넷 연결과 여유 공간을 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het stemherkenningsmodel niet downloaden. Controleer je internetverbinding en vrije ruimte en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar o modelo de reconhecimento de voz. Verifique sua conexão com a internet e o espaço livre e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载声音识别模型。请检查你的互联网连接和可用空间，然后重试。"
          }
        }
      }
    },
