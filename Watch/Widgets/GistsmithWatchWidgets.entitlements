<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Watch app and its widgets share only the glance state (no task text). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.senoldogan.AINotepad.hosted.watch</string>
	</array>
</dict>
</plist>
