    "Kaydı sil?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete recording?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l'enregistrement ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la grabación?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la registrazione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar a gravação?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname verwijderen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除录音？"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko nauhoitus?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı sil?"
          }
        }
      }
    },
    "Ses silinir; geri alınamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio is deleted and can't be recovered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird gelöscht und kann nicht wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio sera supprimé définitivement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se eliminará y no se podrá recuperar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio viene eliminato e non si può recuperare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será apagado e não poderá ser recuperado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio wordt verwijderd en kan niet worden hersteld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は削除され、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 삭제되며 되돌릴 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被删除且无法恢复。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni poistetaan, eikä sitä voi palauttaa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses silinir; geri alınamaz."
          }
        }
      }
    },
    "Pil azaldığı için kayıt bitirildi; kaydedilen kısım iPhone'a gidecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde wegen niedrigen Akkus beendet; das Aufgenommene wird an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording ended because the battery is low; what was recorded will go to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación terminó porque queda poca batería; lo grabado se enviará a tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus lopetettiin, koska akku on vähissä; tallennettu osa lähetetään iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement arrêté, batterie faible ; ce qui a été enregistré sera envoyé à ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione terminata per batteria scarica; quanto registrato andrà al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が少ないため録音を終了しました。録音した部分は iPhone に送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 부족해 녹음을 끝냈습니다. 녹음된 부분은 iPhone으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname gestopt omdat de batterij bijna leeg is; wat is opgenomen gaat naar je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação terminou porque a bateria está fraca; o que foi gravado irá para o seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量不足，录音已结束；已录制的部分将发送到你的 iPhone。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil azaldığı için kayıt bitirildi; kaydedilen kısım iPhone'a gidecek."
          }
        }
      }
    },
    "Kayıt beklenmedik biçimde durdu; kaydedilen kısım iPhone'a gidecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde unerwartet beendet; das Aufgenommene wird an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped unexpectedly; what was recorded will go to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo inesperadamente; lo grabado se enviará a tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus pysähtyi odottamatta; tallennettu osa lähetetään iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement s'est arrêté de façon inattendue ; ce qui a été enregistré sera envoyé à ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è interrotta inaspettatamente; quanto registrato andrà al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が予期せず停止しました。録音した部分は iPhone に送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 예기치 않게 멈췄습니다. 녹음된 부분은 iPhone으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname stopte onverwacht; wat is opgenomen gaat naar je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou inesperadamente; o que foi gravado irá para o seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音意外停止；已录制的部分将发送到你的 iPhone。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt beklenmedik biçimde durdu; kaydedilen kısım iPhone'a gidecek."
          }
        }
      }
    },
    "Önceki saat kaydı yarıda kesildi ve kaydedilemedi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Aufnahme auf der Watch wurde abgebrochen und konnte nicht gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last watch recording was cut off and couldn't be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última grabación del reloj se interrumpió y no se pudo guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellinen kellon tallennus katkesi eikä sitä voitu tallentaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier enregistrement sur la montre a été interrompu et n'a pas pu être enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima registrazione sull'orologio si è interrotta e non è stato possibile salvarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のウォッチでの録音は途中で中断され、保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 워치 녹음이 중간에 끊겨 저장하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste opname op de watch is afgebroken en kon niet worden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última gravação no relógio foi interrompida e não pôde ser salva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次手表录音被中断，未能保存。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki saat kaydı yarıda kesildi ve kaydedilemedi."
          }
        }
      }
    },
    "Saatte kayıt henüz açılmadı. Şimdilik iPhone'da kaydet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnehmen auf der Watch ist noch nicht verfügbar. Nimm vorerst auf dem iPhone auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording on the watch isn't available yet. Record on your iPhone for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar en el reloj aún no está disponible. Por ahora, graba en tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellolla tallentaminen ei ole vielä käytettävissä. Tallenna toistaiseksi iPhonella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement sur la montre n'est pas encore disponible. Enregistre sur ton iPhone pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione sull'orologio non è ancora disponibile. Per ora registra sull'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチでの録音はまだ利用できません。今は iPhone で録音してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치 녹음은 아직 사용할 수 없습니다. 지금은 iPhone에서 녹음하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen op de watch is nog niet beschikbaar. Neem voorlopig op met je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar no relógio ainda não está disponível. Por enquanto, grave no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表录音暂不可用。请先在 iPhone 上录音。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatte kayıt henüz açılmadı. Şimdilik iPhone'da kaydet."
          }
        }
      }
    },
    "Saatte yer kalmadı. Yer açıp yeniden dene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deiner Watch ist kein Platz mehr. Gib Speicher frei und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your watch is out of space. Free up some space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj no tiene espacio. Libera espacio y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellossa ei ole tilaa. Vapauta tilaa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta montre n'a plus d'espace. Libère de l'espace et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio non ha più spazio. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチの空き容量がありません。容量を空けてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에 저장 공간이 없습니다. 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je watch heeft geen ruimte meer. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio está sem espaço. Libere espaço e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表空间不足。请释放空间后重试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatte yer kalmadı. Yer açıp yeniden dene."
          }
        }
      }
    },
    "iPhone yakındayken gönderilir. iPhone'da Gistsmith'i açmak gönderimi hızlandırır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gesendet, wenn dein iPhone in der Nähe ist. Gistsmith auf dem iPhone zu öffnen, beschleunigt das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent when your iPhone is nearby. Opening Gistsmith on your iPhone speeds it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía cuando tu iPhone está cerca. Abrir Gistsmith en el iPhone lo acelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetään, kun iPhone on lähellä. Gistsmithin avaaminen iPhonessa nopeuttaa lähetystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé quand ton iPhone est à proximité. Ouvrir Gistsmith sur l'iPhone accélère l'envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene inviato quando l'iPhone è vicino. Aprire Gistsmith sull'iPhone velocizza l'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone が近くにあると送信されます。iPhone で Gistsmith を開くと早く届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 가까이 있으면 전송됩니다. iPhone에서 Gistsmith를 열면 더 빨리 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt verstuurd als je iPhone in de buurt is. Gistsmith openen op je iPhone maakt het sneller."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado quando o iPhone está por perto. Abrir o Gistsmith no iPhone acelera o envio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 在附近时发送。在 iPhone 上打开 Gistsmith 可加快发送。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yakındayken gönderilir. iPhone'da Gistsmith'i açmak gönderimi hızlandırır."
          }
        }
      }
    },
    "Bu ay için toplantı süren bitti; kayıt başlamadı.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Besprechungszeit für diesen Monat ist aufgebraucht; die Aufnahme wurde nicht gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this month's meeting time; recording didn't start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado el tiempo de reuniones de este mes; la grabación no se inició."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kuun kokousaika on käytetty; tallennus ei alkanut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as utilisé le temps de réunion de ce mois ; l'enregistrement n'a pas démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai esaurito il tempo di riunione di questo mese; la registrazione non è partita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の会議時間を使い切りました。録音は開始されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 회의 시간을 모두 사용했습니다. 녹음이 시작되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vergadertijd voor deze maand is op; de opname is niet gestart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou todo o tempo de reuniões deste mês; a gravação não começou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月会议时长已用完，录音未开始。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay için toplantı süren bitti; kayıt başlamadı."
          }
        }
      }
    },
    "Toplantı süre hakkına ulaşıldı; kayıt bitirildi ve iPhone'a gidecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeitlimit der Besprechung ist erreicht; die Aufnahme wurde beendet und wird an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting time limit was reached; the recording ended and will go to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de tiempo de la reunión; la grabación terminó y se enviará a tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokouksen aikaraja tuli täyteen; tallennus lopetettiin ja se lähetetään iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée maximale de la réunion est atteinte ; l'enregistrement est terminé et sera envoyé à ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato raggiunto il limite di tempo della riunione; la registrazione è terminata e andrà al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の時間上限に達したため録音を終了しました。iPhone に送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 시간 한도에 도달해 녹음을 끝냈습니다. iPhone으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdslimiet van de vergadering is bereikt; de opname is gestopt en gaat naar je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de tempo da reunião foi atingido; a gravação terminou e irá para o seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到会议时长上限，录音已结束，将发送到你的 iPhone。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı süre hakkına ulaşıldı; kayıt bitirildi ve iPhone'a gidecek."
          }
        }
      }
    },
    "Kayıt bir arama ya da Siri yüzünden bitti; kaydedilen kısım iPhone'a gidecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde wegen eines Anrufs oder Siri beendet; das Aufgenommene wird an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording ended because of a call or Siri; what was recorded will go to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación terminó por una llamada o Siri; lo grabado se enviará a tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus päättyi puhelun tai Sirin takia; tallennettu osa lähetetään iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement s'est arrêté à cause d'un appel ou de Siri ; ce qui a été enregistré sera envoyé à ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è terminata per una chiamata o Siri; quanto registrato andrà al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話または Siri のため録音が終了しました。録音した部分は iPhone に送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화나 Siri 때문에 녹음이 끝났습니다. 녹음된 부분은 iPhone으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname stopte door een gesprek of Siri; wat is opgenomen gaat naar je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação terminou por causa de uma ligação ou da Siri; o que foi gravado irá para o seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因来电或 Siri，录音已结束；已录制的部分将发送到你的 iPhone。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bir arama ya da Siri yüzünden bitti; kaydedilen kısım iPhone'a gidecek."
          }
        }
      }
    },
    "Önceki saat kaydı yarıda kesildi; kaydedilen kısım iPhone'a gidecek.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Aufnahme auf der Watch wurde abgebrochen; das Aufgenommene wird an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last watch recording was cut off; what was recorded will go to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última grabación del reloj se interrumpió; lo grabado se enviará a tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellinen kellon tallennus katkesi; tallennettu osa lähetetään iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier enregistrement sur la montre a été interrompu ; ce qui a été enregistré sera envoyé à ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima registrazione sull'orologio si è interrotta; quanto registrato andrà al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のウォッチでの録音は途中で中断されました。録音した部分は iPhone に送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 워치 녹음이 중간에 끊겼습니다. 녹음된 부분은 iPhone으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste opname op de watch is afgebroken; wat is opgenomen gaat naar je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última gravação no relógio foi interrompida; o que foi gravado irá para o seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次手表录音被中断；已录制的部分将发送到你的 iPhone。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki saat kaydı yarıda kesildi; kaydedilen kısım iPhone'a gidecek."
          }
        }
      }
    },
    "Hazırlanıyor": {
