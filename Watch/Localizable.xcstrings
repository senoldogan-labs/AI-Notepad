          }
        }
      }
    },
    "Gistsmith'i açar ve toplantıyı saatin mikrofonuyla kaydetmeye başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Gistsmith and starts recording the meeting with your watch's microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Gistsmith und nimmt das Meeting mit dem Mikrofon deiner Uhr auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Gistsmith et enregistre la réunion avec le micro de votre montre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gistsmith y empieza a grabar la reunión con el micrófono del reloj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Gistsmith e inizia a registrare la riunione con il microfono dell'orologio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Gistsmith e começa a gravar a reunião com o microfone do relógio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Gistsmith en neemt de vergadering op met de microfoon van je horloge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmithを開き、ウォッチのマイクで会議の録音を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith를 열고 워치 마이크로 회의 녹음을 시작해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Gistsmith，并用手表的麦克风开始录制会议。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Gistsmithin ja aloittaa kokouksen nauhoituksen kellon mikrofonilla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith'i açar ve toplantıyı saatin mikrofonuyla kaydetmeye başlar."
          }
        }
      }
    },
