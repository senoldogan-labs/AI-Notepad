          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith'i açar ve toplantıyı saatte kaydetmeye başlar."
          }
        }
      }
    },
    "iPhone'da içe aktarılamadı": {
