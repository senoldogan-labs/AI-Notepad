          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar no iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen op iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで録音"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 녹음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上录制"
          }
        },
