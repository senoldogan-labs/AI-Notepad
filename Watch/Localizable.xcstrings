    "iPhone'da Gistsmith'i aç ve giriş yap; saat ondan sonra kayıt yapar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gistsmith on your iPhone and sign in; then your watch can record."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Gistsmith auf deinem iPhone und melde dich an; danach kann deine Watch aufnehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Gistsmith sur votre iPhone et connectez-vous ; votre montre pourra ensuite enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gistsmith en tu iPhone e inicia sesión; después tu reloj podrá grabar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Gistsmith sull'iPhone e accedi; poi l'orologio potrà registrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Gistsmith no iPhone e entre na sua conta; depois o relógio poderá gravar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gistsmith op je iPhone en log in; daarna kan je horloge opnemen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでGistsmithを開いてサインインすると、Apple Watchで録音できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Gistsmith를 열고 로그인하면 Apple Watch로 녹음할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 Gistsmith 并登录，之后手表即可录制。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Gistsmith iPhonessa ja kirjaudu sisään; sen jälkeen kello voi nauhoittaa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da Gistsmith'i aç ve giriş yap; saat ondan sonra kayıt yapar."
          }
        }
      }
    },
    "iPhone'da kaydet": {
      "localizations": {
        "en": {
