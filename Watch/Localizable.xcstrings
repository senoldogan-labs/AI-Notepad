    "iPhone'da Gistsmith'i aç ya da kaydı saatte başlat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gistsmith on your iPhone, or start recording on your watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Gistsmith auf dem iPhone oder starte die Aufnahme auf der Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Gistsmith sur l'iPhone ou lancez l'enregistrement sur la montre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gistsmith en el iPhone o empieza a grabar en el reloj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Gistsmith sull'iPhone oppure avvia la registrazione sull'orologio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Gistsmith no iPhone ou comece a gravar no relógio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gistsmith op je iPhone of start de opname op je horloge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでGistsmithを開くか、Apple Watchで録音を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Gistsmith를 열거나 Apple Watch에서 녹음을 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Gistsmith，或在手表上开始录制。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Gistsmith iPhonessa tai aloita nauhoitus kellolla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da Gistsmith'i aç ya da kaydı saatte başlat."
          }
        }
      }
    },
    "iPhone'daki kayıt değişti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording on your iPhone has changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme auf dem iPhone hat sich geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement sur l'iPhone a changé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación del iPhone ha cambiado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione sull'iPhone è cambiata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação no iPhone mudou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname op je iPhone is veranderd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの録音が変わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 녹음이 바뀌었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的录制已变更。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonen nauhoitus on vaihtunut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'daki kayıt değişti."
          }
        }
      }
    },
    "Kaydı ve sıradaki toplantıyı gösterir; dokununca Gistsmith açılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the recording and your next meeting; tap to open Gistsmith."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Aufnahme und dein nächstes Meeting; tippe, um Gistsmith zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l'enregistrement et votre prochaine réunion ; touchez pour ouvrir Gistsmith."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la grabación y tu próxima reunión; toca para abrir Gistsmith."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la registrazione e la prossima riunione; tocca per aprire Gistsmith."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a gravação e sua próxima reunião; toque para abrir o Gistsmith."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de opname en je volgende vergadering; tik om Gistsmith te openen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音と次の会議を表示します。タップするとGistsmithが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음과 다음 회의를 보여 줘요. 탭하면 Gistsmith가 열려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示录制和下一个会议；轻点即可打开 Gistsmith。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää nauhoituksen ja seuraavan kokouksesi; avaa Gistsmith napauttamalla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı ve sıradaki toplantıyı gösterir; dokununca Gistsmith açılır."
          }
        }
      }
    },
