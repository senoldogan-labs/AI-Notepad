    },
    "Kaydettiğini katılımcılara söyle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people know you're recording."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag den Teilnehmenden, dass du aufnimmst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez les participants que vous enregistrez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa a los participantes de que estás grabando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa i partecipanti che stai registrando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise os participantes de que você está gravando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat deelnemers weten dat je opneemt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音していることを参加者に伝えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참가자에게 녹음 중임을 알려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告知参会者你正在录制。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro osallistujille, että nauhoitat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğini katılımcılara söyle."
          }
        }
      }
    },
