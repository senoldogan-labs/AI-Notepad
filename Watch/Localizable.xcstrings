            "value": "Primeiro abra o Gistsmith no iPhone e entre na sua conta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open eerst Gistsmith op je iPhone en log in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずiPhoneでGistsmithを開いてサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 iPhone에서 Gistsmith를 열고 로그인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 iPhone 上打开 Gistsmith 并登录。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ensin Gistsmith iPhonessa ja kirjaudu sisään."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce iPhone'da Gistsmith'i aç ve giriş yap."
          }
        }
      }
    },
    "Mikrofon izni yok. Saatte Ayarlar › Gizlilik › Mikrofon'dan Gistsmith'e izin ver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone access. On your watch, allow Gistsmith in Settings › Privacy › Microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofonzugriff. Erlaube Gistsmith auf der Watch unter Einstellungen › Datenschutz › Mikrofon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'accès au micro. Sur la montre, autorisez Gistsmith dans Réglages › Confidentialité › Micro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono. En el reloj, permite Gistsmith en Ajustes › Privacidad › Micrófono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al microfono. Sull'orologio consenti Gistsmith in Impostazioni › Privacy › Microfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao microfone. No relógio, permita o Gistsmith em Ajustes › Privacidade › Microfone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de microfoon. Sta Gistsmith toe op je horloge via Instellingen › Privacy › Microfoon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがありません。Apple Watchの設定 › プライバシー › マイクでGistsmithを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 없어요. Apple Watch의 설정 › 개인정보 보호 › 마이크에서 Gistsmith를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请在手表的“设置 › 隐私 › 麦克风”中允许 Gistsmith。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mikrofonin käyttöoikeutta. Salli Gistsmith kellon kohdassa Asetukset › Tietosuoja › Mikrofoni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon izni yok. Saatte Ayarlar › Gizlilik › Mikrofon'dan Gistsmith'e izin ver."
          }
        }
      }
    },
    "Kayıt başlamadı. Başka bir uygulama mikrofonu kullanıyor olabilir; yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording didn't start. Another app may be using the microphone; try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme hat nicht begonnen. Eine andere App nutzt vielleicht das Mikrofon; versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'a pas démarré. Une autre app utilise peut-être le micro ; réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no empezó. Puede que otra app esté usando el micrófono; vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non è partita. Forse un'altra app sta usando il microfono; riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não começou. Outro app pode estar usando o microfone; tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is niet gestart. Misschien gebruikt een andere app de microfoon; probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始できませんでした。ほかのアプリがマイクを使用している可能性があります。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 시작하지 못했어요. 다른 앱이 마이크를 사용 중일 수 있어요. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制未能开始。可能有其他 App 正在使用麦克风，请重试。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus ei alkanut. Jokin toinen sovellus saattaa käyttää mikrofonia; yritä uudelleen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt başlamadı. Başka bir uygulama mikrofonu kullanıyor olabilir; yeniden dene."
          }
        }
      }
    },
    "iPhone'a ulaşılamıyor. Yakında ve açık olduğundan emin ol.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your iPhone. Make sure it's nearby and turned on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone ist nicht erreichbar. Achte darauf, dass es in der Nähe und eingeschaltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l'iPhone. Vérifiez qu'il est à proximité et allumé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el iPhone. Asegúrate de que esté cerca y encendido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l'iPhone. Assicurati che sia vicino e acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o iPhone. Verifique se ele está por perto e ligado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone is niet bereikbaar. Zorg dat hij in de buurt en aan staat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに接続できません。近くにあり、電源が入っていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 연결할 수 없어요. 가까이 있고 켜져 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 iPhone。请确认它在附近且已开机。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneen ei saada yhteyttä. Varmista, että se on lähellä ja päällä."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'a ulaşılamıyor. Yakında ve açık olduğundan emin ol."
          }
        }
      }
    },
    "iPhone'daki Gistsmith'i güncelle.": {
      "localizations": {
