    "Gistsmith'i açar ve toplantıyı saatte kaydetmeye başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Gistsmith and starts recording the meeting on your watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Gistsmith und startet die Aufnahme des Meetings auf der Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Gistsmith et lance l'enregistrement de la réunion sur la montre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gistsmith y empieza a grabar la reunión en el reloj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Gistsmith e avvia la registrazione della riunione sull'orologio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Gistsmith e começa a gravar a reunião no relógio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Gistsmith en start de opname van de vergadering op je horloge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmithを開き、ウォッチで会議の録音を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gistsmith를 열고 워치에서 회의 녹음을 시작해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
